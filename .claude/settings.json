      "Bash(godot:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(tools/shots.sh:*)",
      "Bash(tools/publish_web.sh:*)",
      "Bash(tools/setup_godot.sh:*)",
      "Bash(tools/menu_shot.sh:*)",
      "Bash(xvfb-run:*)"
