; GamePlatform - a clone-and-prompt 2D game kit for Godot 4.
; Renderer is gl_compatibility so that web export works. Do not change it.
;
; Open this project with the STANDARD Godot build, not the .NET/mono one. The mono editor
; cannot export to Web at all, and it adds a [dotnet] section to this file that has no
; business in a GDScript-only project.

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="GamePlatform"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Bus="*res://shell/autoload/bus.gd"
Controls="*res://shell/autoload/controls.gd"
Palette="*res://shell/autoload/palette.gd"
SaveData="*res://shell/autoload/save_data.gd"
Probe="*res://shell/autoload/probe.gd"
PInput="*res://shell/autoload/pinput.gd"
Audio="*res://shell/autoload/audio.gd"
Juice="*res://shell/autoload/juice.gd"
Flow="*res://shell/autoload/flow.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043, 0.035, 0.098, 1)

[physics]

common/physics_ticks_per_second=60
