func _init() -> void:
	play_area = Rect2(0, 0, 640, 360)
	world_area = Rect2(-1500, -1300, 3000, 2600)   ## replaced by the city's real bounds

func _ready() -> void:
	title = "streets"
	# Before super(): the shell's own per-frame hook puts camera shake on top of where
	# _frame() leaves the camera, so _frame() has to run first.
	get_tree().process_frame.connect(_frame)
	_gl_count_on()   # before super() makes the first materials (LIGHT_STRIP_JS)
	super()
	Bus.palette_changed.connect(_retint_city)

func start(_config: Dictionary) -> void:
	_sfx_was = SaveData.data.get("volume_sfx", 0.8)
	SaveData.data["volume_sfx"] = SFX_SCALE
	set_lives(0)
	_touch_seen = DisplayServer.is_touchscreen_available()   # phones get the stick hint at once
	_keep_screen_on(true)
	_make_font()
	_tones()
	_place = LEVELS[clampi(int(_config.get("level", 1)), 1, LEVELS.size()) - 1]
	_gl_count_on()
	if _place.get("routes", false):
		_route_page = String(_config.get("page", "set"))
		_route_list_open()   # no city: the list of drives, each starting its own city
		return
	if _place.get("walks", false):
		_walk_list_open()   # no city: the list of walks, each starting its own city
		return
	if _place.get("cities", false):
		_walk_list_open("cities")   # no city: the list of cities
		return
	if _place.get("scenarios", false):
		_walk_list_open("scenarios")   # no city: the list of scenarios
		return
	# how autodrive drives and the time of day, as chosen on the list it came from (_list_settings);
	# with none, a test drive keeps the rules (it is there to test autodrive) and a city is the racer
	_ap_style = String(_config.get("style", "rules" if _config.has("route") or _config.get("make_route", false) else "racer"))
	_start_time = String(_config.get("time", "day"))
	if _config.has("route"):
		_route = _route_by_id(int(_config["route"]))
	if _config.get("make_route", false):
		_making = "from"   # (the picker opens once the city is up)
	SIGNAL_CYCLE = SIGNAL_CYCLE_NORTH if String(_place.get("look", "")) == "north" else SIGNAL_CYCLE_MED
	var dev := OS.get_environment("STREETS_CAM").split(",", false)
	if dev.size() >= 5:
		for i in 5:
			_dev_cam.append(dev[i].to_float())
	# a big city takes seconds to build: say so, and build in steps a frame apart, so the
	# screen shows progress instead of hanging (a phone takes two or three times as long)
	_loading = UIKit.label("", 16, "ink")
	_loading.add_theme_font_override("font", _font)
	_loading.position = Vector2(120, 160)
	_loading.size = Vector2(400, 40)
	# readable over whatever the city shows behind it while it builds (pale ground, sky, a
	# white block): a dark rounded panel under the text and the bar, the letters outlined.
	# (Light letters straight on the scene: "make a better font that we can see during load")
	var panel := StyleBoxFlat.new()
	panel.bg_color = Color(Palette.col("bg"), 0.82)
	panel.set_corner_radius_all(10)
	panel.expand_margin_left = 16.0
	panel.expand_margin_right = 16.0
	panel.expand_margin_top = 10.0
	panel.expand_margin_bottom = 46.0   # (down over the bar and the time left, the label's children)
	_loading.add_theme_stylebox_override("normal", panel)
	_loading.add_theme_color_override("font_outline_color", Palette.col("bg"))
	_loading.add_theme_constant_override("outline_size", 5)
	_loading.z_index = 100
	add_child(_loading)
	_load_bar_begin()
	if not await _step("loading " + String(_place["name"])):
		return
	var t0 := Time.get_ticks_msec()
	var gl0 := _gl_count()
	if not await _load_city(String(_place["city"])):
		_loading.queue_free()
		_build_hud()
		_show_banner("no city file -- see GAME.md", 30.0)
		return
	var t1 := Time.get_ticks_msec()
	_stage_ms["city file (parse, roads fitted, buildings cut)"] = t1 - t0
	print("[streets] city file read in %d ms" % (t1 - t0))   # (marks for a browser's log: tests/web_load.js)
	_load_into("setup")
	world_area = _bounds
	_find_start()   # (the squares round it are built first)
	if not await _build_world():
		return
	var tw := Time.get_ticks_msec()
	print("[streets] the squares round the start built in %d ms; stages %s" % [tw - t1, _stage_ms])
	print("[streets] warm-up begins")   # (marks for a browser's log: tests/web_shaders.js counts the shaders compiled between)
	if not await _warm_up():
		return
	_stage_ms["warm up (shaders compiled, 4 frames)"] = Time.get_ticks_msec() - tw
	print("[streets] warm-up done in %d ms, frames %s" % [Time.get_ticks_msec() - tw, _warm_ms])
	if _qwalk > 0.0:
		_quality_walk()
	_load_ms = Time.get_ticks_msec() - t0
	_load_split = [t1 - t0, tw - t1, Time.get_ticks_msec() - tw]
	_load_gl = _gl_count() - gl0 if gl0.x >= 0.0 else Vector2(-1, 0)
	_gl_at_car = _gl_count()
	_load_save()
	_loading.queue_free()
	var tm := Time.get_ticks_msec()
	_map_build_cells()
	_stage("minimap", tm)
	_build_car()
	_place_start()
	_build_hud()
	_show_load_line()
	_no_local_lights()
	_far_ahead()
	_retint_city()
	_spawn_people()
	_spawn_crossers()
	_traffic = Traffic.new()
	_traffic.setup(self)
	_build_engine()
	_build_street_sounds()
	_build_signal_sounds()
	if _place.has("walk"):
		_film_begin(String(_place["walk"]))
	_dressing["traffic"] = _traffic.alive_count()
	_loaded = true
	if not _route.is_empty():
		_route_begin()
	elif _making != "":
		_open_picker()
	if _start_time != "day":
		_set_time_of_day(_start_time)   # (as chosen on the list; it steps through evening)
	track3d(_car, "@")
	Probe.event("city", {"name": _city_name, "roads": _roads.size(), "buildings": _blds.size(),
		"trees": _posts.size(), "streets": _streets.size(), "dressing": _dressing, "stage_ms": _stage_ms,
		"parse_ms": t1 - t0, "build_ms": Time.get_ticks_msec() - t1})
	if not _inferred.is_empty():
		Probe.event("decks_inferred", _inferred)
	_show_banner(_city_name, 3.0)
	var dev_cam := OS.get_environment("STREETS_CAM").split(",", false)
	if dev_cam.size() >= 6 and dev_cam[5] == "1":
		_set_night(true)
	elif dev_cam.size() >= 6 and dev_cam[5] == "2":
		await _set_evening(true)
	for k: String in _part_us:   # (the parts of the stages, for tests/load_stages.gd)
		_stage_ms[k] = int(_part_us[k]) / 1000
	if Opening.wanted(self):   # (over the town while the squares round the car go up: opening.gd)
		_opening = Opening.new(self)
		_opening.start()
	if _place.has("scenario"):   # (a tour or a story: scenario.gd, after the opening)
		_scenario = Scenario.new(self)
		_scenario.setup(String(_place["scenario"]))
		_scenario.start()
	_build_rest()   # the rest of the city, while you drive

var _loading: Label

## Draw the city once looking each way from above the start, while the loading text is
## still up. A browser compiles each shader the first time something uses it, and that
## stalls the frame: better here than as each kind of thing first comes into view.
func _warm_up() -> bool:
	# (on screen first: the frames below are the slow ones, and the text set with them showed
	# only when they were done -- "8 of 8" stood there seconds)
	_loading.text = "building %s…\ngetting the graphics ready" % _city_name
	_load_into("warm", 12)
	await get_tree().process_frame
	await get_tree().process_frame
	if not is_inside_tree():
		return false
	var mid := _bounds.get_center()
	var spot := _pos if _pos != Vector2.ZERO else mid
	var gy := _h(spot)
	# The city's kinds of surface a few at a time, a frame each, so the shaders compile in
	# steps the text can count (all at once, one frame took the lot: a long freeze)
	look_from(Vector3(spot.x - 20.0, gy + 12.0, spot.y), Vector3(spot.x + 40.0, gy, spot.y))
	_sky_follow()
	# the night's glow -- the lamps' pools, the headlight beams -- is drawn by day by nothing:
	# a pool and one beam here for the warm-up, as the real ones are made (a plain mesh; a
	# multimesh like the traffic's beams), so the night button finds the shader compiled
	var stand_ins: Array = []
	var gb := Buf.new()
	_pool(gb, spot + Vector2(30.0, 0.0), 2.0)
	var pm := ArrayMesh.new()
	pm.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, gb.arrays())
	var pool_in := MeshInstance3D.new()
	pool_in.mesh = pm
	pool_in.material_override = _glow_mat("lamplight", POOL_STRENGTH)
	pool_in.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	world.add_child(pool_in)
	stand_ins.append(pool_in)
	var bm := MultiMesh.new()
	bm.transform_format = MultiMesh.TRANSFORM_3D
	bm.mesh = _beam_mesh()
	bm.instance_count = 1
	bm.set_instance_transform(0, Transform3D(Basis(), Vector3(spot.x + 30.0, gy, spot.y)))
	var beam_in := MultiMeshInstance3D.new()
	beam_in.multimesh = bm
	beam_in.material_override = _glow_mat("lamplight", 0.4)
	beam_in.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	world.add_child(beam_in)
	stand_ins.append(beam_in)
	var kinds := {}   # material (and whether instanced) -> its nodes
	var shown: Array = []
	for n: Node in world.find_children("*", "GeometryInstance3D", true, false):
		var gi := n as GeometryInstance3D
		if not gi.visible:
			continue   # (hidden on purpose: night's beams, the beacon)
		gi.visible = false
		shown.append(gi)
		var key := _shader_key(gi)
		if not kinds.has(key):
			kinds[key] = []
		(kinds[key] as Array).append(gi)
	world.visible = true
	var keys: Array = kinds.keys()
	# (in steps only on a real graphics chip: under a software renderer -- the tests' -- every
	# frame of the town costs seconds to draw, and there is no compiling worth spreading)
	var adapter := RenderingServer.get_video_adapter_name().to_lower()
	var soft := adapter.contains("llvmpipe") or adapter.contains("swiftshader") or adapter.contains("software")
	var steps := 0 if soft else mini(8, keys.size())
	_load_n = steps + 4
	for k in range(steps):
		for key in keys.slice(k * keys.size() / steps, (k + 1) * keys.size() / steps):
			for gi: GeometryInstance3D in kinds[key]:
				gi.visible = true
		_loading.text = "building %s…\ngetting the graphics ready (%d of %d)" % [_city_name, k + 1, steps + 4]
		_load_sub(k)
		var ts := Time.get_ticks_msec()
		await get_tree().process_frame
		_warm_ms.append(Time.get_ticks_msec() - ts)
		if not is_inside_tree():
			return false
	for gi: GeometryInstance3D in shown:
		gi.visible = true   # (the few not reached above: none, but to be sure)
	for k in range(4):
		_loading.text = "building %s…\ngetting the graphics ready (%d of %d)" % [_city_name, steps + k + 1, steps + 4]
		_load_sub(steps + k)
		var d := Vector2(cos(k * PI * 0.5), sin(k * PI * 0.5))
		look_from(Vector3(spot.x - d.x * 20.0, gy + 12.0, spot.y - d.y * 20.0), Vector3(spot.x + d.x * 40.0, gy, spot.y + d.y * 40.0))
		_sky_follow()
		var tk := Time.get_ticks_msec()
		await get_tree().process_frame
		_warm_ms.append(Time.get_ticks_msec() - tk)   # (each view's frame: the perf view shows them)
		if not is_inside_tree():
			return false
	for n: Node in stand_ins:
		n.queue_free()
	return true

var _warm_ms: Array = []             ## each warm-up frame, ms: the kinds of surface a few at a time, then the four views

## what a mesh is drawn with, as far as compiling it goes: its material(s), and whether it is
## instanced (a multimesh is another shader variant)
func _shader_key(gi: GeometryInstance3D) -> String:
	var m: Material = gi.material_override
	var mesh: Mesh = null
	if gi is MeshInstance3D:
		mesh = (gi as MeshInstance3D).mesh
	elif gi is MultiMeshInstance3D and (gi as MultiMeshInstance3D).multimesh != null:
		mesh = (gi as MultiMeshInstance3D).multimesh.mesh
	if m == null and mesh != null and mesh.get_surface_count() > 0:
		m = mesh.surface_get_material(0)
		if m == null and gi is MeshInstance3D:
			m = (gi as MeshInstance3D).get_surface_override_material(0)
	# what compiles is a shader's CODE, not a material: a ShaderMaterial's Shader, and for a
	# standard material its set of switches (Godot makes one shader per set and shares it, a
	# colour or a number is only a uniform). Tel Aviv: 77 materials, 25 codes, 43 programs
	# (tests/warm_census.gd) -- grouped by material, one step of the warm-up got the 38
	# people's materials (one shader) and another a dozen shaders.
	var shadow := "+shadow" if gi.cast_shadow != GeometryInstance3D.SHADOW_CASTING_SETTING_OFF else ""
	return "%s:%s%s" % [gi.get_class(), _code_key(m), shadow]

var _code_keys := {}                 ## material id -> _code_key
func _code_key(m: Material) -> String:
	if m == null:
		return "none"
	if m is ShaderMaterial:
		var sh := (m as ShaderMaterial).shader
		return "shader:%d" % (sh.get_instance_id() if sh != null else 0)
	if _code_keys.has(m.get_instance_id()):
		return _code_keys[m.get_instance_id()]
	var parts: Array = [m.get_class()]
	for p: Dictionary in m.get_property_list():   # its switches: every stored bool and enum, which textures are set
		if not (int(p["usage"]) & PROPERTY_USAGE_STORAGE):
			continue
		var t := int(p["type"])
		var v = m.get(p["name"])
		if t == TYPE_BOOL and v:
			parts.append(p["name"])
		elif t == TYPE_INT and int(v) != 0 and not String(p["name"]).begins_with("render_priority"):
			parts.append("%s=%d" % [p["name"], v])
		elif t == TYPE_OBJECT and v != null and String(p["name"]) != "next_pass":
			parts.append(p["name"] + "+")
	var key := " ".join(parts)
	_code_keys[m.get_instance_id()] = key
	return key
var _load_ms := 0                    ## from the city file to the car shown, ms
var _load_split: Array = []          ## that load's parts, ms: city file, start area, graphics warm-up
var _load_lbl: Label                 ## the load's parts, over the build line for a while after it

## How long the page took before the engine ran (downloading the build, starting the wasm), ms,
## or -1 where there is no page: a browser's clock counts from the page opening, the engine's
## from its own start. Only the first city of a visit pays it.
func _page_ms() -> int:
	if not OS.has_feature("web"):
		return -1
	var now = JavaScriptBridge.eval("performance.now()", true)
	if now == null:
		return -1
	return maxi(0, int(float(now)) - Time.get_ticks_msec())

## "loaded in 9.4 s: page 2.1 · city file 1.0 · start area 2.4 · graphics 3.9" -- this
## device's own load, split, so a player's screenshot from a phone gives the real numbers (a
## test machine's software renderer says nothing about a phone's graphics warm-up).
func _load_line() -> String:
	if _load_split.size() < 3:
		return ""
	var s := "loaded in %.1f s:" % (_load_ms / 1000.0)
	var page := _page_ms() if _first_load else -1
	if page >= 0:
		s = "loaded in %.1f s (+ page %.1f s):" % [_load_ms / 1000.0, page / 1000.0]
	s += " city file %.1f · start area %.1f · graphics %.1f" % [
		_load_split[0] / 1000.0, _load_split[1] / 1000.0, _load_split[2] / 1000.0]
	if _load_gl.x >= 0.0:
		s += " (%d shaders, %.1f s compiling%s)" % [int(_load_gl.x), _load_gl.y / 1000.0, _lstrip_note()]
	return s

## ", N skipped" -- the never-drawn programs LIGHT_STRIP_JS swapped for a placeholder -- and
## loudly if one was ever drawn with (it should not be: see LIGHT_STRIP_JS)
static func _lstrip_note() -> String:
	if not OS.has_feature("web"):
		return ""
	var v = JavaScriptBridge.eval("window.__lstrip ? window.__lstrip.n + ',' + window.__lstrip.used : ''", true)
	var t := str(v) if v != null else ""
	if t == "":
		return ""
	var used := int(t.get_slice(",", 1))
	return ", %s skipped%s" % [t.get_slice(",", 0), ", PLACEHOLDER DRAWN %d" % used if used > 0 else ""]
static var _loads_this_visit := 0
var _first_load := false

## the line above, by the map for 8 s after the car is shown, then gone (still in the "more"
## drawer and the perf view's load lines). (20 s once; the user, 22 Nov: the notes took room)
func _show_load_line() -> void:
	_loads_this_visit += 1
	_first_load = _loads_this_visit == 1
	var t := _load_line()
	if t == "" or _hud == null:
		return
	print("[streets] " + t)
	_load_lbl = _label(8, "ink")
	_load_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	_load_lbl.position = Vector2(8, 190)   # (over the map)
	_load_lbl.size = Vector2(320, 12)
	_load_lbl.text = t
	_load_lbl.modulate.a = 0.8
	var tw := create_tween()
	tw.tween_interval(8.0)
	tw.tween_property(_load_lbl, "modulate:a", 0.0, 1.0)
	tw.tween_callback(_load_lbl.queue_free)

## the loading, for the perf view: how long, its biggest stages, the warm-up's four views
func _load_text() -> String:
	var parts: Array = []
	for k: String in _stage_ms:
		parts.append([k, int(_stage_ms[k])])
	parts.sort_custom(func(a, b): return a[1] > b[1])
	var top: Array = []
	for p: Array in parts.slice(0, 4):
		top.append("%s %.1f s" % [String(p[0]).get_slice(" (", 0), p[1] / 1000.0])
	var since := ""
	if _gl_at_car.x >= 0.0:
		var d := _gl_count() - _gl_at_car
		since = "\nshaders compiled since the car: %d, %.1f s" % [int(d.x), d.y / 1000.0]
	if _tod_line != "":
		since += "\nlast time-of-day switch " + _tod_line
	return "%s\nslowest parts: %s\nwarm-up frames (ms): %s%s" % [_load_line(), ", ".join(top), ", ".join(_warm_ms.map(func(x): return str(x))), since]

## which graphics chip and driver path (a browser on Windows names Direct3D: every shader
## translated and compiled again there) and what a frame asks of it: draw calls and triangles,
## the view and the shadow pass together. In a browser each draw call costs the main thread a
## trip through WebGL's checks, so many draws hold a frame back whatever the quality level.
func _gpu_line() -> String:
	return "graphics: %s · %d draws · %d k triangles" % [_gpu_name(),
		RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_DRAW_CALLS_IN_FRAME),
		RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_PRIMITIVES_IN_FRAME) / 1000]

## The graphics chip's own name. A browser tells WebGL only "WebKit WebGL"; the real one
## (and on Windows "Direct3D11") comes from the debug-renderer extension, asked of a context
## made for it and dropped again.
static var _gpu_name_got := ""
static func _gpu_name() -> String:
	if _gpu_name_got != "":
		return _gpu_name_got
	_gpu_name_got = RenderingServer.get_video_adapter_name()
	if OS.has_feature("web"):
		var v = JavaScriptBridge.eval("""(() => { try {
			const gl = document.createElement('canvas').getContext('webgl2');
			const e = gl && gl.getExtension('WEBGL_debug_renderer_info');
			const r = e ? String(gl.getParameter(e.UNMASKED_RENDERER_WEBGL)) : '';
			const l = gl && gl.getExtension('WEBGL_lose_context');
			if (l) l.loseContext();
			return r;
		} catch (x) { return ''; } })()""", true)
		if v != null and str(v) != "":
			_gpu_name_got = str(v)
	return _gpu_name_got

## ---- the browser's shader compiling, counted (web only) ----------------------------------
## A browser compiles a shader program the first time something is drawn with it (the
## warm-up's steps) and may keep what it compiled for the next visit (its program cache), when
## the same calls come back at once. Timed from the page itself, a phone's load line tells which
## it was: 200 programs in 50 s is compiling, 200 in 0.3 s the cache. The calls are wrapped on
## WebGL2's prototype, so the engine's context (made long before) goes through them too.
const GL_COUNT_JS := """(() => {
	if (window.__glc || typeof WebGL2RenderingContext === 'undefined') return;
	const c = window.__glc = { n: 0, ms: 0 };
	const P = WebGL2RenderingContext.prototype;
	for (const name of ['compileShader', 'linkProgram', 'getShaderParameter', 'getProgramParameter']) {
		const f = P[name];
		P[name] = function (...a) {
			const t = performance.now();
			const r = f.apply(this, a);
			c.ms += performance.now() - t;
			if (name === 'linkProgram') c.n += 1;
			return r;
		};
	}
})()"""
## ---- the lit shaders Godot compiles and never draws with (web only) ---------------------
## When a material's shader is set up, Godot's Compatibility renderer compiles its "default"
## specialization of every variant at once (shader_gles3.cpp `_initialize_version`,
## `specialization_default_mask`): for the lit pass, plain and instanced, with the omni, spot
## and AREA light code all switched on. Draws never use it -- the base pass switches each of
## those off when no such light touches the instance (rasterizer_scene_gles3.cpp), and this
## game has only the sun. But Chrome/Edge on Windows hand every program to Direct3D's compiler,
## and those two cost ~2.4-7.7 s each: 44 of them were ~85% of a cold load (user's PC, 22 Nov
## 2026: Givatayim's graphics 63 s; area lights alone 2.45 -> 0.47 s a program, omni + spot +
## area 0.16 s). First the three were defined off in those sources (graphics 63 -> 22 s); even
## so the 42 never-drawn programs were 7.9 s of the 21 s left. Now they are swapped for a
## placeholder -- the source's own `#version` line and an empty main -- which costs nothing to
## compile. Picked out exactly: the base pass, not additive, no DISABLE_LIGHT_OMNI of their
## own (every draw of the base pass has it here: no omni light). Godot still links them, finds
## no uniforms in them (locations -1, which it skips) and never draws with them. If one ever
## IS drawn, `used` counts it and the console says so -- that draw would come out empty;
## `tests/web_shaders.js` / the load line show it (`window.__lstrip.used`).
## **Only right while the game has no OmniLight3D, SpotLight3D or AreaLight3D** --
## `_no_local_lights` warns at load if one appears; drop LIGHT_STRIP_JS before adding one.
const LIGHT_STRIP_JS := """(() => {
	if (window.__lstrip || typeof WebGL2RenderingContext === 'undefined') return;
	const c = window.__lstrip = { n: 0, used: 0 };
	const P = WebGL2RenderingContext.prototype;
	const types = new WeakMap(), fake = new WeakSet(), fakeProg = new WeakSet();
	const cs = P.createShader, ss = P.shaderSource, as = P.attachShader, up = P.useProgram;
	P.createShader = function (t) { const s = cs.call(this, t); if (s) types.set(s, t); return s; };
	P.shaderSource = function (s, src) {
		if (typeof src === 'string' && src.indexOf('#define BASE_PASS') >= 0
				&& src.indexOf('#define USE_ADDITIVE_LIGHTING') < 0 && src.indexOf('#define DISABLE_LIGHT_OMNI') < 0) {
			const v = src.slice(0, src.indexOf('\\n'));
			src = types.get(s) === this.VERTEX_SHADER
				? v + '\\nvoid main() { gl_Position = vec4(0.0); }\\n'
				: v + '\\nprecision mediump float;\\nout vec4 frag_color;\\nvoid main() { frag_color = vec4(1.0, 0.0, 1.0, 1.0); }\\n';
			fake.add(s);
			if (types.get(s) !== this.VERTEX_SHADER) c.n += 1;   // programs, not halves
		}
		return ss.call(this, s, src);
	};
	P.attachShader = function (p, s) { if (fake.has(s)) fakeProg.add(p); return as.call(this, p, s); };
	let cur = null;
	P.useProgram = function (p) { cur = p; return up.call(this, p); };
	for (const name of ['drawArrays', 'drawElements', 'drawArraysInstanced', 'drawElementsInstanced', 'drawRangeElements']) {
		const d = P[name];
		P[name] = function (...a) {
			if (cur && fakeProg.has(cur)) {
				if (c.used++ === 0) console.warn('[streets] LIGHT_STRIP_JS: a placeholder program was drawn with');
			}
			return d.apply(this, a);
		};
	}
})()"""

## warn if a light the strip above assumes away is in the scene
func _no_local_lights() -> void:
	for n in get_tree().root.find_children("*", "Light3D", true, false):
		if not (n is DirectionalLight3D):
			push_warning("[streets] %s is a %s: LIGHT_STRIP_JS assumes the game has none" % [n.name, n.get_class()])
			return

var _load_gl := Vector2(-1, 0)       ## the load's programs linked and ms in the compile calls (-1: not a browser)
var _gl_at_car := Vector2(-1, 0)     ## the count when the car was shown

static func _gl_count_on() -> void:
	if OS.has_feature("web"):
		JavaScriptBridge.eval(LIGHT_STRIP_JS, true)
		JavaScriptBridge.eval(GL_COUNT_JS, true)

## (programs linked, ms spent in the compile and link calls) so far; x -1 where not counted
static func _gl_count() -> Vector2:
	if not OS.has_feature("web"):
		return Vector2(-1, 0)
	var v = JavaScriptBridge.eval("window.__glc ? window.__glc.n + ',' + Math.round(window.__glc.ms) : ''", true)
	var t := str(v) if v != null else ""
	if t == "":
		return Vector2(-1, 0)
	return Vector2(float(t.get_slice(",", 0)), float(t.get_slice(",", 1)))

## show what is being built and let a frame be drawn; false if the game was left meanwhile
func _step(what: String) -> bool:
	if not is_inside_tree():
		return false
	_loading.text = "building %s…\n%s" % [_city_name if _city_name != "" else String(_place["name"]), what]
	_load_tick()
	await get_tree().process_frame
	await get_tree().process_frame
	return is_inside_tree()

## ---- the loading bar ----------------------------------------------------------------------
## A bar under the loading text and "about N s" (user: "those steps where I don't know how long
## I have to wait -- sometimes 3 seconds, sometimes 20"). The estimate is this device's own last
## load of the city (LOAD_LOG): the city file, the set-up, one square, the warm-up -- the last
## kept twice, as it was on the same build (the browser kept its compiled shaders) and on the
## first load of a new build (it compiles them again: the slow case). No load of this city
## yet: another city's, its file scaled by size. None at all: the bar by phase, no seconds.
## Slower or quicker than last time so far, the rest is taken to be so too (`pace`).
const LOAD_LOG := "user://streets_load.json"
const LOAD_PHASES := ["file", "setup", "squares", "warm"]
const LOAD_W := 400.0                ## the bar's width (the loading text's)
var _load_est := {}                  ## ms: file, setup, square (each), n (squares), warm; empty: no history
var _load_at := {}                   ## phase -> ms it began
var _load_phase := "file"
var _load_n := 1                     ## steps in the phase (squares; the warm-up's frames)
var _load_i := 0                     ## the step it is on
var _load_i_at := 0                  ## ms that step began
var _load_squares := 1.0             ## squares built behind the text this time
var _load_fill: ColorRect
var _load_eta: Label
var _build_id := ""                  ## res://build.txt: which build this is

func _load_bar_begin() -> void:
	var track := ColorRect.new()
	track.color = Palette.col("bg_alt")
	track.position = Vector2(0, 50)
	track.size = Vector2(LOAD_W, 6)
	_loading.add_child(track)
	_load_fill = ColorRect.new()
	_load_fill.color = Palette.col("accent")
	_load_fill.position = track.position
	_load_fill.size = Vector2(0, 6)
	_loading.add_child(_load_fill)
	_load_eta = UIKit.label("", 13, "ink")
	_load_eta.add_theme_font_override("font", _font)
	_load_eta.add_theme_color_override("font_outline_color", Palette.col("bg"))
	_load_eta.add_theme_constant_override("outline_size", 4)
	_load_eta.position = Vector2(0, 60)
	_load_eta.size = Vector2(LOAD_W, 20)
	_load_eta.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	_load_eta.modulate.a = 0.8
	_loading.add_child(_load_eta)
	if FileAccess.file_exists("res://build.txt"):
		_build_id = FileAccess.get_file_as_string("res://build.txt").strip_edges()
	_load_est = _load_guess()
	_load_into("file")

func _load_log() -> Dictionary:
	if not FileAccess.file_exists(LOAD_LOG):
		return {}
	var d = JSON.parse_string(FileAccess.get_file_as_string(LOAD_LOG))
	return d if d is Dictionary else {}

func _city_kb(id: String) -> float:
	var f := FileAccess.open(get_script().resource_path.get_base_dir() + "/cities/" + id + ".json", FileAccess.READ)
	return f.get_length() / 1024.0 if f != null else 0.0

## what this load should take, from the log
func _load_guess() -> Dictionary:
	var log := _load_log()
	var city := String(_place["city"])
	var mine: Dictionary = log.get(city, {})
	var src := mine
	var scale := 1.0
	if not src.has("square"):   # this city never loaded here: another one's, the file scaled
		src = {}
		for k: String in log:
			if (log[k] as Dictionary).has("square") and float((log[k] as Dictionary).get("file_kb", 0.0)) > 0.0:
				src = log[k]
				break
		if src.is_empty():
			return {}
		scale = _city_kb(city) / float(src["file_kb"])
	var new_build := String(mine.get("build", "")) != _build_id
	return {"file": float(src["file"]) * scale, "setup": float(src["setup"]), "square": float(src["square"]),
		"n": float(src["n"]), "warm": float(src["warm_new"] if new_build else src["warm"])}

func _load_into(phase: String, n: int = 1) -> void:
	_load_phase = phase
	_load_at[phase] = Time.get_ticks_msec()
	_load_n = maxi(n, 1)
	_load_i = 0
	_load_i_at = _load_at[phase]
	if phase == "squares":
		_load_squares = float(maxi(n, 1))
		if not _load_est.is_empty():
			_load_est["n"] = _load_squares
	_load_tick()

func _load_sub(i: int) -> void:
	_load_i = i
	_load_i_at = Time.get_ticks_msec()
	_load_tick()

func _load_phase_ms(phase: String) -> float:
	return float(_load_est["square"]) * float(_load_est["n"]) if phase == "squares" else float(_load_est[phase])

func _load_tick() -> void:
	if _load_fill == null or not is_instance_valid(_load_fill):
		return
	var idx := LOAD_PHASES.find(_load_phase)
	var through := clampf(float(_load_i) / _load_n, 0.0, 1.0)
	if _load_est.is_empty():   # the first load on this device: the bar by phase alone
		var w := [0.15, 0.1, 0.5, 0.25]
		var f := 0.0
		for i in range(idx):
			f += w[i]
		_load_fill.size.x = LOAD_W * (f + w[idx] * through)
		_load_eta.text = "timing it, for next time"
		return
	var now := Time.get_ticks_msec()
	var total := 0.0
	var done := 0.0
	for i in range(LOAD_PHASES.size()):
		var ms := _load_phase_ms(LOAD_PHASES[i])
		total += ms
		if i < idx:
			done += ms
	var step := _load_phase_ms(_load_phase) / _load_n
	done += step * _load_i + minf(float(now - _load_i_at), step * 0.9)
	var spent := float(now - int(_load_at["file"]))
	var pace := clampf(spent / done, 0.5, 3.0) if done > 1500.0 else 1.0
	var left := (total - done) * pace / 1000.0
	_load_fill.size.x = LOAD_W * clampf(done / maxf(total, 1.0), 0.0, 1.0)
	_load_eta.text = "almost there" if left < 1.5 else "about %d s" % ceili(left)

## what this load took, for the next one's estimate
func _load_save() -> void:
	if not _load_at.has("warm") or not _load_at.has("squares"):
		return
	var now := Time.get_ticks_msec()
	var log := _load_log()
	var city := String(_place["city"])
	var old: Dictionary = log.get(city, {})
	var squares := float(int(_load_at["warm"]) - int(_load_at["squares"]))
	var warm := float(now - int(_load_at["warm"]))
	var same := old.has("warm") and String(old.get("build", "")) == _build_id
	var rec := {"file": float(int(_load_at["setup"]) - int(_load_at["file"])),
		"setup": float(int(_load_at["squares"]) - int(_load_at["setup"])),
		"square": squares / maxf(_load_squares, 1.0), "n": _load_squares, "file_kb": _city_kb(city), "build": _build_id,
		"warm": warm if same or not old.has("warm") else float(old["warm"]),
		"warm_new": float(old.get("warm_new", warm)) if same else warm}
	log[city] = rec
	var f := FileAccess.open(LOAD_LOG, FileAccess.WRITE)
	if f != null:
		f.store_string(JSON.stringify(log))

func _exit_tree() -> void:
	SaveData.data["volume_sfx"] = _sfx_was
	if _walk_speed != 1.0:
		Engine.time_scale = 1.0   # (the menu after a sped-up walk)
	if _shadow_web:   # put the project's own shadow settings back for the next game
		RenderingServer.directional_shadow_atlas_set_size(
			int(ProjectSettings.get_setting("rendering/lights_and_shadows/directional_shadow/size", 4096)), true)
		RenderingServer.directional_soft_shadow_filter_set_quality(
			int(ProjectSettings.get_setting("rendering/lights_and_shadows/directional_shadow/soft_shadow_filter_quality", 2)))
	_keep_screen_on(false)

## Watching autodrive means nobody touches the phone, and phones dim and lock. Natively
## Godot can hold the screen on; in a browser that is the Screen Wake Lock API, which the
## page must ask for while visible, again after the tab comes back (the browser drops the
## lock when it is hidden), and on some browsers only after a tap.
const WAKE_JS := """
window.__streetsWake = window.__streetsWake || (function () {
  var lock = null, want = false;
  function grab() {
    if (!want || lock || document.visibilityState !== 'visible' || !('wakeLock' in navigator)) return;
    navigator.wakeLock.request('screen').then(function (l) {
      lock = l;
      l.addEventListener('release', function () { lock = null; });
    }).catch(function () {});
  }
  document.addEventListener('visibilitychange', grab);
  return {
    start: function () { want = true; grab(); },
    stop: function () { want = false; if (lock) { lock.release(); lock = null; } }
  };
})();
"""

func _keep_screen_on(on: bool) -> void:
	DisplayServer.screen_set_keep_on(on)
	if OS.has_feature("web"):
		JavaScriptBridge.eval(WAKE_JS + ("window.__streetsWake.start();" if on else "window.__streetsWake.stop();"), true)

## Divided roads: OSM maps each carriageway as a road of its own, one-way, and with no width
## given the bake guesses the class's -- 10 m for a secondary -- for each half. Ben Gurion's
## halves are 7-10 m apart centre to centre, so they overlapped, and each one's kerb and
## pavement ran down the other's lanes. Each half is made as wide as its lanes (3.3 m a lane),
## never so wide it reaches the other, and remembers the gap left between them: its inner
## side gets a kerb and half the median, not a pavement.
func _fit_dual_carriageways() -> void:
	var fitted := 0
	for ri in range(_roads.size()):
		var r: Dictionary = _roads[ri]
		var o := int(r["o"])
		if not r["drive"] or o == 0 or r.get("ring", false) or r["k"] == "service" or r.has("ys"):
			continue
		var pts: PackedVector2Array = r["pts"]
		var hw: float = float(r["w"]) * 0.5
		var acr: Array = []
		var mates := {}   # the other half's road -> pieces beside it
		for j in range(pts.size() - 1):
			var c := (pts[j] + pts[j + 1]) * 0.5
			var d := (pts[j + 1] - pts[j]).normalized()
			var pair := _partner(c, d, ri, hw, o)
			if not pair.is_empty():
				acr.append((pair[1] as Vector2).distance_to(c))
				mates[pair[0]] = int(mates.get(pair[0], 0)) + 1
		if acr.is_empty() or acr.size() * 2 < pts.size() - 1:
			continue   # beside another carriageway along less than half of it
		acr.sort()
		var across: float = acr[acr.size() / 2]
		if across > 40.0:
			continue
		var lanes := int(r["l"]) if int(r["l"]) > 0 else maxi(1, roundi(float(r["w"]) / 3.5))
		var w := minf(float(r["w"]), lanes * 3.3 + 0.5)
		w = minf(w, maxf(3.0, across - 0.5))
		r["w"] = w
		r["median"] = maxf(0.0, across - w)
		var mate := -1
		for rj: int in mates:
			if mate < 0 or int(mates[rj]) > int(mates[mate]):
				mate = rj
		r["mate"] = mate   # (the median's paving: _median_pave_key)
		fitted += 1
	if fitted == 0:
		return
	_recompute_node_r()
	_dressing["dual_halves"] = fitted

func _recompute_node_r() -> void:
	for i in range(_node_r.size()):
		_node_r[i] = 0.0
	for r: Dictionary in _roads:
		if r["drive"]:
			for id: int in r["ids"]:
				_node_r[id] = maxf(_node_r[id], float(r["w"]) * 0.5)

## Road widths are guesses too (8 m a residential street, 10 m a secondary), and in the old
## streets the buildings stand closer than that: drawn at the guess, the road ran under
## them ("buildings halfway into the street"). Each road is narrowed, to no less than two
## lanes (one for a one-way), where over most of its length a wall stands within its
## asphalt and a strip of pavement. Only where a wall is near is a narrower width looked for.
func _fit_widths_to_buildings() -> void:
	var narrowed := 0
	for ri in range(_roads.size()):
		var r: Dictionary = _roads[ri]
		if not r["drive"] or HIGHWAYS.has(r["k"]) or r["k"] == "service" or r.has("ys"):
			continue
		var hw := float(r["w"]) * 0.5
		var min_hw := 2.7 if int(r["o"]) == 0 else 1.8
		if hw <= min_hw:
			continue
		var pts: PackedVector2Array = r["pts"]
		var allowed: Array = []
		for j in range(pts.size() - 1):
			var a := pts[j]
			var b := pts[j + 1]
			var L := a.distance_to(b)
			if L < 0.5:
				continue
			var d := (b - a) / L
			var nrm := Vector2(-d.y, d.x)
			var n := maxi(1, int(L / 12.0))
			for k in range(n):
				var q := a + d * (L * (k + 0.5) / n)
				var room := hw
				for sg: float in [-1.0, 1.0]:
					var side := nrm * sg
					if _push_out(q + side * (hw + 0.9), 0.5, false) == Vector2.ZERO:
						continue
					var x := hw
					while x > min_hw:
						x = maxf(min_hw, x - 0.5)
						if _push_out(q + side * (x + 0.9), 0.5, false) == Vector2.ZERO:
							break
					room = minf(room, x)
				allowed.append(room)
		if allowed.is_empty():
			continue
		allowed.sort()
		var fit: float = allowed[int(allowed.size() * 0.3)]   # most of its length, not one corner
		if fit < hw - 0.2:
			r["w"] = fit * 2.0
			narrowed += 1
	if narrowed > 0:
		_recompute_node_r()
	_dressing["narrowed"] = narrowed

## What the narrowing leaves (it fits most of a street's length, not every building on it):
## a building whose front still stands on the road, or so close no pavement is left, has
## that front cut back to the road's edge plus a kerb and a strip of pavement. OSM's
## footprints and centre lines are each a little off and the road's width is a guess, so a
## metre off a facade is the likelier truth than a house standing in the lane. Not a
## building the road runs under (more than half of it would go: a passage through it, or a
## guess far too wide), nor one up on columns over it.
const BLD_CLEAR := 1.5                ## kerb and pavement kept in front of a building (m)

const OVER_ROAD_BASE := 5.5          ## a building over a street with no height to stand on: up this far
var over_road_at: Array = []          ## the middles of those put up over the street (tests)

func _clip_buildings(bdata: Array) -> void:
	var clipped := 0
	var kept := 0
	var raised := 0
	var drop: Array = []
	for bi in range(_blds.size()):
		if _bld_solid[bi] == 0:
			continue
		var ring: PackedVector2Array = _blds[bi]
		var box: Rect2 = _bld_box[bi]
		var n := ring.size()
		var cuts: Array = []
		for code: int in _near(_seg_hash, box.get_center(), box.size.length() * 0.5 + 14.0, SEG_CELL):
			var r: Dictionary = _roads[code / 4096]
			var sj := code % 4096
			if r.has("ys"):
				# a deck: cut back like a street where it runs low (an embankment, a bridge's
				# foot: nothing stands under a deck less than a storey up); never over a
				# tunnel or a cutting (the houses on the hill above it)
				if not (String(r["deck"]) in ["em", "br", "cu"]) or not r["drive"] \
						or maxf(absf(r["ys"][sj] - r["gs"][sj]), absf(r["ys"][sj + 1] - r["gs"][sj + 1])) > 4.0:
					continue   # (a cutting too, where it is shallow: a car came up one into a block)
			elif not _kerbed(r) and not (HIGHWAYS.has(r["k"]) and r["drive"]):
				continue   # (a motorway on the ground too: a block stood 0.8 m into Ayalon South)
			var pts: PackedVector2Array = r["pts"]
			var a := pts[sj]
			var b := pts[sj + 1]
			var c := float(r["w"]) * 0.5 + (BLD_CLEAR if _kerbed(r) or r.has("ys") else 0.5)   # (no pavement beside a motorway)
			if not box.grow(c).intersects(Rect2(a, Vector2.ZERO).expand(b)):
				continue
			for k in range(n):
				var cp := Geometry2D.get_closest_points_between_segments(a, b, ring[k], ring[(k + 1) % n])
				if cp[0].distance_to(cp[1]) < c - 0.05:
					cuts.append([a, b, c])
					break
		if cuts.is_empty():
			continue
		var area0 := _area_signed(ring)
		var cur := ring
		for cut: Array in cuts:
			var a: Vector2 = cut[0]
			var b: Vector2 = cut[1]
			var c: float = cut[2]
			var d := (b - a).normalized()
			if d == Vector2.ZERO:
				continue
			# the road's strip round this piece, rounded at both ends (squared off, the
			# outside of every bend and every junction's middle were left uncut)
			var lane := PackedVector2Array()
			for k in range(7):
				lane.append(b + Vector2(-d.y, d.x).rotated(-PI * k / 6.0) * c)
			for k in range(7):
				lane.append(a + Vector2(d.y, -d.x).rotated(-PI * k / 6.0) * c)
			var best := PackedVector2Array()
			var best_a := 0.0
			for piece: PackedVector2Array in Geometry2D.clip_polygons(cur, lane):
				var pa := _area(piece)   # (the largest: never a hole, smaller than its outline)
				if pa > best_a:
					best_a = pa
					best = piece
			cur = best
			if cur.size() < 3:
				break
		if cur.size() < 3 or _area(cur) < absf(area0) * 0.5:
			# A building a road runs under spans it, past both its edges (a passage). One that
			# only sits in it, small, is a footprint OSM put on the road -- a little house in the
			# middle of a Bedford street, another across one (city_check): left out
			var spans := _spans_a_cut(ring, cuts)
			if absf(area0) < 400.0 and not spans:
				drop.append(bi)
				continue
			if spans and not (bdata[bi] as Dictionary).has("b"):
				# over the street with nothing to say it is up off it (Dizengoff Center's
				# bridges over Dizengoff: OSM maps no min_height) -- it stood on the street from
				# the ground, a wall across it. Up on its columns over the street (_stilts keeps
				# them out of the lanes), or, too low for that, left out
				var bd: Dictionary = bdata[bi]
				if float(bd["_h"]) < OVER_ROAD_BASE + 3.0:
					drop.append(bi)
					continue
				bd["_base"] = OVER_ROAD_BASE
				_bld_solid[bi] = 0
				raised += 1
				over_road_at.append(box.get_center())
			kept += 1
			continue
		if signf(_area_signed(cur)) != signf(area0):
			cur.reverse()
		_blds[bi] = cur
		_bld_box[bi] = _bld_box_of(cur)
		(bdata[bi] as Dictionary)["_ring"] = cur
		clipped += 1
	_dressing["bld_clipped"] = clipped
	_dressing["bld_over_road"] = kept
	_dressing["bld_raised_over_road"] = raised
	_dressing["bld_dropped"] = drop.size()
	if not drop.is_empty():
		_drop_buildings(bdata, drop)

## does the outline reach past both edges of one of the roads it was cut by ([a, b, half
## width + BLD_CLEAR] each): a building over the road, not one standing in it
func _spans_a_cut(ring: PackedVector2Array, cuts: Array) -> bool:
	for cut: Array in cuts:
		var a: Vector2 = cut[0]
		var b: Vector2 = cut[1]
		var hw: float = float(cut[2]) - BLD_CLEAR
		var L := a.distance_to(b)
		if L < 0.01:
			continue
		var d := (b - a) / L
		var nrm := Vector2(-d.y, d.x)
		var lo := INF
		var hi := -INF
		for v: Vector2 in ring:
			var t := (v - a).dot(d)
			if t < -2.0 or t > L + 2.0:
				continue
			var lat := (v - a).dot(nrm)
			lo = minf(lo, lat)
			hi = maxf(hi, lat)
		if lo < -hw - 0.5 and hi > hw + 0.5:
			return true
	return false

## left out at load, before anything else looks at them: the outlines, their boxes, heights,
## solidity, the spatial hash and the city's own list, all kept in step
func _drop_buildings(bdata: Array, drop: Array) -> void:
	var gone := {}
	for bi: int in drop:
		gone[bi] = true
	var keep_b: Array = []
	var blds: Array = []
	var boxes: Array = []
	var solid := PackedByteArray()
	var tops := PackedFloat32Array()
	for bi in range(_blds.size()):
		if gone.has(bi):
			continue
		keep_b.append(bdata[bi])
		blds.append(_blds[bi])
		boxes.append(_bld_box[bi])
		solid.append(_bld_solid[bi])
		tops.append(_bld_top[bi])
	bdata.clear()
	bdata.append_array(keep_b)
	_blds = blds
	_bld_box = boxes
	_bld_solid = solid
	_bld_top = tops
	_bld_hash = {}
	for bi in range(_blds.size()):
		_hash_add(_bld_hash, _bld_box[bi], BLD_CELL, bi)

## ---- loading the city ---------------------------------------------------------------

func _load_city(id: String) -> bool:
	var dir: String = get_script().resource_path.get_base_dir() + "/cities/"
	var path := dir + id + ".json"
	if OS.get_environment("STREETS_CITY_FILE") != "":   # a test's other copy (before and after a re-bake)
		path = OS.get_environment("STREETS_CITY_FILE")
	if not FileAccess.file_exists(path):
		# not baked yet: drive whichever city is there rather than nothing
		var any := ""
		for f in DirAccess.get_files_at(dir):
			if f.ends_with(".json"):
				any = dir + f
				break
		if any == "":
			Probe.note("no city file at %s -- bake one with tools/osm_city.py (GAME.md)" % path)
			return false
		Probe.note("no %s yet, driving %s instead" % [path, any.get_file()])
		path = any
	var tp := await _load_part("the file", 1)
	var text := FileAccess.get_file_as_string(path)
	var data = JSON.parse_string(text)
	tp = _part_next("%sparse", tp)
	tp = await _load_part("the details", 2)
	if not data is Dictionary:
		Probe.note("city file %s did not parse" % path)
		return false
	var k := 1.0 / float(data.get("scale", 10))
	# (another copy of the file, STREETS_CITY_FILE, is still the level's own town: its details,
	# its landmarks)
	_city_id = id if OS.get_environment("STREETS_CITY_FILE") != "" else path.get_file().get_basename()
	var extra := Details.load_for(dir, _city_id)
	if not extra.is_empty():
		_details = Details.new(self, extra)
		_details.edit_city(data)
	tp = _part_next("%sdetails", tp)
	tp = await _load_part("bridges and tunnels", 3)
	# the bridges, tunnels and ramps as worked out when this build was made, if they were
	# (prepublish.gd); else here, as always
	var baked := _bake_use if not _bake_use.is_empty() else (_baked_for(text) if _bake_rec == null else {})
	if _bake_rec != null:
		_bake_rec["key"] = _bake_key(text)
	if not baked.is_empty():
		for key: String in baked["data"]:
			data[key] = (baked["data"][key] as Variant)
		_inferred = (baked["inferred"] as Dictionary).duplicate(true)
		_dressing["decks_baked"] = 1
	elif String(_place.get("decks", "")) == "infer":   # (OSM has no heights: worked out here)
		var before: Dictionary = data.duplicate(true) if _bake_rec != null else {}
		var t_inf := Time.get_ticks_msec()
		_inferred = Decks.infer(data, DRIVE)
		_inferred["ms"] = Time.get_ticks_msec() - t_inf
		if _bake_rec != null:   # what infer changed, whole key by key (it re-cuts the roads)
			var changed := {}
			for key: String in data:
				if not before.has(key) or before[key] != data[key]:
					changed[key] = (data[key] as Variant)
			_bake_rec["data"] = changed.duplicate(true)
			_bake_rec["inferred"] = _inferred.duplicate(true)
	tp = _part_next("%sdecks inferred", tp)
	tp = await _load_part("the roads", 4)
	_city_name = String(data.get("name", id))
	var b: Array = data["bounds"]
	_bounds = Rect2(b[0], b[1], float(b[2]) - float(b[0]), float(b[3]) - float(b[1]))

	var nd: Array = data["nodes"]
	_nodes.resize(nd.size() / 2)
	for i in range(_nodes.size()):
		_nodes[i] = Vector2(nd[i * 2], nd[i * 2 + 1]) * k
	_node_roads.resize(_nodes.size())
	_node_r.resize(_nodes.size())
	for i in range(_nodes.size()):
		_node_roads[i] = []

	_town_ms = _town_limits(data["roads"])
	for rd: Dictionary in data["roads"]:
		var kind := String(rd.get("k", ""))
		if rd.has("tu") and not rd.has("y"):
			continue   # a tunnel the file gives no heights for: it would be drawn on the ground
		var ids := PackedInt32Array()
		var pts := PackedVector2Array()
		for n in rd["n"]:
			ids.append(int(n))
			pts.append(_nodes[int(n)])
		var r := {"pts": pts, "ids": ids, "w": float(rd.get("w", 6.0)), "k": kind,
			"o": int(rd.get("o", 0)), "l": int(rd.get("l", 0)), "name": String(rd.get("name", "")),
			"en": String(rd.get("name_en", "")), "drive": DRIVE.has(kind), "pv": rd.has("pv"), "sv": String(rd.get("sv", "")),
			# OSM's own limit where it has one (`ms`, km/h), else a guess by kind; every driver
			# and the speed signs read this one number
			"speed": float(rd["ms"]) / 3.6 if rd.has("ms") and DRIVE.has(kind) \
				else (float(_town_ms[kind]) / 3.6 if _town_ms.has(kind) and DRIVE.has(kind) \
				else float(DRIVE.get(kind, 5.0)) * (NORTH_FASTER.get(kind, 1.0) if String(_place.get("look", "")) == "north" else 1.0)),
			# a roundabout's ring: marked by the bake, or a one-way way that closes on itself
			"ring": rd.has("rb") or (int(rd.get("o", 0)) != 0 and ids.size() > 3 and ids[0] == ids[ids.size() - 1]),
			# its bus lanes, each way (the bake's bf / bb: a letter a lane, left to right; "b" a bus lane)
			"bf": String(rd.get("bf", "")), "bb": String(rd.get("bb", ""))}
		if rd.has("y") and (rd["y"] as Array).size() == ids.size():
			# off the ground (decks.gd): the height of its surface at each point
			var ys := PackedFloat32Array()
			for v in rd["y"]:
				ys.append(float(v) * k)
			r["ys"] = ys
			r["deck"] = "br" if rd.has("br") else ("tu" if rd.has("tu") else ("em" if rd.has("em") else ("cu" if rd.has("cu") else "")))
		if rd.has("kerb"):
			r["kerb"] = int(rd["kerb"])   # its kerb's paint, set by hand (details.gd)
		if rd.has("kerb_mid"):
			r["kerb_mid"] = int(rd["kerb_mid"])   # the paint along its middle, set by hand
		if rd.has("yard"):
			r["yard"] = bool(rd["yard"])   # front gardens along it or not, set by hand
		if rd.has("pave"):
			r["pave"] = rd["pave"]   # its paving [pattern, colours], set by hand
		if rd.has("setts"):
			r["setts"] = bool(rd["setts"])   # light setts round its trees and between them, as filmed
		var ri := _roads.size()
		_roads.append(r)
		var hw: float = r["w"] * 0.5
		for j in range(ids.size()):
			(_node_roads[ids[j]] as Array).append(Vector2i(ri, j))
			if r["drive"]:
				_node_r[ids[j]] = maxf(_node_r[ids[j]], hw)
		for j in range(pts.size() - 1):
			_hash_add(_seg_hash, Rect2(pts[j], Vector2.ZERO).expand(pts[j + 1]).grow(hw), SEG_CELL, ri * 4096 + j)

	tp = _part_next("%sroads", tp)
	tp = await _load_part("divided roads", 5)
	_fit_dual_carriageways()
	tp = _part_next("%sdivided roads fitted", tp)
	tp = await _load_part("the buildings", 6)

	for ring: Array in data.get("boundary", []):
		var poly := PackedVector2Array()
		for i in range(0, ring.size(), 2):
			poly.append(Vector2(ring[i], ring[i + 1]) * k)
		_boundary.append(poly)
	for r: Dictionary in _roads:
		if r["drive"] and r["name"] != "" and r["k"] != "service":
			for p: Vector2 in r["pts"]:
				if _in_city(p):
					_streets[r["name"]] = true
					break

	for bd: Dictionary in data["buildings"]:
		var flat: Array = bd["p"]
		var ring := PackedVector2Array()
		for i in range(0, flat.size(), 2):
			ring.append(Vector2(flat[i], flat[i + 1]) * k)
		var h := float(bd["h"])
		if bd.has("g"):
			# a guess: vary it a storey either way so a street is not one flat wall
			h += float(posmod(_hash_i(ring[0]), 3) - 1) * 3.0
		var base := float(bd.get("b", 0.0))
		var box := Rect2(ring[0], Vector2.ZERO)
		for p in ring:
			box = box.expand(p)
		var bi := _blds.size()
		_blds.append(ring)
		_bld_box.append(box)
		_bld_solid.append(1 if base < 2.4 else 0)
		_bld_top.append(h)
		_hash_add(_bld_hash, box, BLD_CELL, bi)
		bd["_h"] = h
		bd["_ring"] = ring
		bd["_base"] = base
		if bd.has("addr"):
			_add_address(String(bd["addr"]), box.get_center())
	tp = _part_next("%sbuildings", tp)
	tp = await _load_part("heights", 7)
	var hg: Dictionary = data.get("height", {})
	if not hg.is_empty():
		_hx0 = float(hg["x0"])
		_hz0 = float(hg["z0"])
		_hstep = float(hg["step"])
		_hnx = int(hg["nx"])
		_hnz = int(hg["nz"])
		var raw: Array = hg["h"]
		_hgrid.resize(raw.size())
		for i in range(raw.size()):
			_hgrid[i] = float(raw[i]) * k
		_steep = _any_steep()
	_made_up = data.has("made_up")
	_credits = (data.get("credits", []) as Array).duplicate()
	# the cars' shapes and paints are the shares on Israel's vehicle register (CAR_MIX,
	# _car_paints): credited wherever they drive
	_credits.append("car mix © Israel Ministry of Transport")
	if _made_up and _hnx > 0:
		_mtn_from = _town_top() + 6.0
	tp = _part_next("%sheights", tp)
	tp = await _load_part("bridges and tunnels set up", 8)
	_decks = Decks.new(self)
	if not baked.is_empty():
		for key: String in baked["decks"]:
			_decks.set(key, (baked["decks"][key] as Variant))
		for ri: int in baked["roads"]:
			var r: Dictionary = _roads[ri]
			for key: String in baked["roads"][ri]:
				r[key] = (baked["roads"][ri][key] as Variant)
	else:
		var was: Array = []
		if _bake_rec != null:
			for r: Dictionary in _roads:
				was.append(r.duplicate(true))
		_decks.setup()
		if _bake_rec != null:   # what setup holds, and what it wrote on the roads
			_bake_rec["decks"] = _vars_of(_decks).duplicate(true)
			var roads := {}
			for ri in range(_roads.size()):
				var r: Dictionary = _roads[ri]
				for key: String in r:
					if not (was[ri] as Dictionary).has(key) or was[ri][key] != r[key]:
						if not roads.has(ri):
							roads[ri] = {}
						roads[ri][key] = (r[key] as Variant)
			_bake_rec["roads"] = roads.duplicate(true)
			if not _bake_rec.has("data"):
				_bake_rec["data"] = {}
				_bake_rec["inferred"] = _inferred.duplicate(true)
	tp = _part_next("%sdecks set up", tp)
	tp = await _load_part("road widths", 9)
	for a: Dictionary in data.get("areas", []):
		if a.get("k") == "water" and a.has("y"):   # a river held at its level: too deep to drive into
			var ring := PackedVector2Array()
			var flat: Array = a["p"]
			for i in range(0, flat.size() - 1, 2):
				ring.append(Vector2(flat[i], flat[i + 1]) * k)
			var box := Rect2(ring[0], Vector2.ZERO)
			for q in ring:
				box = box.expand(q)
			_hash_add(_deep_hash, box, BLD_CELL, _deep.size())
			_deep.append([ring, float(a["y"]) * k, box])
	for a: Array in data.get("addrs", []):   # address points that are not on a building
		_add_address("%s %s" % [a[2], a[3]], Vector2(a[0], a[1]) * k)
	_fit_widths_to_buildings()
	tp = _part_next("%swidths fitted", tp)
	tp = await _load_part("buildings off the roads", 10)
	_clip_buildings(data["buildings"])
	tp = _part_next("%sbuildings cut", tp)
	tp = await _load_part("the street network", 11)
	_mark_medians()
	_build_graph()
	_part_next("%sgraph", tp)
	_city_data = data
	return true

## _part_time for one part of the city file's loading ("%s" its prefix); the clock for the next
## the city file's parts on the loading screen, "reading the map: the roads (4 of 11)", a
## frame drawn for each (only while loading on screen: prepublish's loads never wait). Returns
## the clock after it, so a part's time is its own, not the frame's.
const LOAD_PARTS := 11
func _load_part(what: String, i: int) -> int:
	if _loading != null and is_inside_tree():
		_loading.text = "building %s…\nreading the map: %s (%d of %d)" % [_city_name if _city_name != "" else String(_place.get("name", "")), what, i, LOAD_PARTS]
		_load_tick()
		await get_tree().process_frame
	return Time.get_ticks_usec()

func _part_next(name: String, t0_us: int) -> int:
	_part_time(name % "city file: ", t0_us)
	return Time.get_ticks_usec()

## ---- bridges and tunnels worked out when the build is made ----------------------------------
## Working out a town's bridges, tunnels and ramps (Decks.infer, then Decks.setup) was most of
## reading its file: Tel Aviv 2.5 of 3.95 s headless, more in a browser (user: "move the slow
## work out of the wait"). Both follow from the file and the code alone, so the web build ships
## them done: tools/publish_web.sh runs prepublish.gd before exporting, which loads each town
## twice -- working it out (recording what infer changed in the file and what setup made: _bake_rec)
## and from that record (_bake_use) -- and keeps the record in baked/ only when the two loads
## leave the game in the same state. A record is stamped with the build (res://build.txt) and a
## hash of the city file, its details and the level's settings: anything else -- a local run, a
## test, a town re-baked since -- works it out as before. (`decks_baked` in the city event.)
const BAKED := "baked/"
var _bake_rec = null                 ## prepublish.gd: a Dictionary this load records into
var _bake_use := {}                  ## prepublish.gd: a record to load from, checking it

## the record's file for a level, and the stamp it must carry
static func baked_file(place: Dictionary) -> String:
	return "%s_%s.bin" % [String(place["city"]), str([place.get("decks", ""), place.get("look", "")]).md5_text().left(8)]

func _bake_key(text: String) -> String:
	var build := FileAccess.get_file_as_string("res://build.txt").strip_edges() if FileAccess.file_exists("res://build.txt") else ""
	var extra := str(_details.data) if _details != null else ""
	return "%s|%d|%d|%s" % [build, text.hash(), extra.hash(), str([_place.get("decks", ""), _place.get("look", "")])]

## this level's record, if one was made for this very build and file; {} if not
func _baked_for(text: String) -> Dictionary:
	if OS.get_environment("STREETS_CITY_FILE") != "" or OS.get_environment("STREETS_NO_BAKED") == "1":
		return {}
	var path: String = get_script().resource_path.get_base_dir() + "/" + BAKED + baked_file(_place)
	if not FileAccess.file_exists(path):
		return {}
	var f := FileAccess.open_compressed(path, FileAccess.READ, FileAccess.COMPRESSION_ZSTD)
	if f == null:
		return {}
	var rec = f.get_var()
	if not rec is Dictionary or String(rec.get("key", "")) != _bake_key(text):
		return {}
	return rec

## an object's own script variables that are not other objects: what it holds
static func _vars_of(o: Object) -> Dictionary:
	var out := {}
	for p: Dictionary in o.get_property_list():
		if int(p["usage"]) & PROPERTY_USAGE_SCRIPT_VARIABLE and typeof(o.get(p["name"])) != TYPE_OBJECT:
			out[p["name"]] = o.get(p["name"])
	return out

## "Sheinkin 47" -> filed under "Sheinkin" as number "47"
func _add_address(full: String, at: Vector2) -> void:
	var cut := full.rfind(" ")
	if cut <= 0:
		return
	var street := full.substr(0, cut)
	var num := full.substr(cut + 1)
	if not _addr.has(street):
		_addr[street] = []
	for a: Array in _addr[street]:
		if a[0] == num:
			return   # a building and an address point for the same door
	(_addr[street] as Array).append([num, at])

## the drivable roads as a directed graph for routing (Godot's AStar2D, distance-weighted)
func _build_graph() -> void:
	_astar = AStar2D.new()
	# public roads first; then private ones (a compound's way in, a gated close) at six times
	# the cost of each point only they reach -- taken only where there is no other way. Left
	# out, a street whose only ways out are private was cut off: "go to" from Timna in
	# Givatayim, or to a close in Bedford, found no way at all (tests/route_check.gd)
	for pass_pv: bool in [false, true]:
		_graph_roads(pass_pv)
	_find_pockets()

## ---- pockets: streets you can drive into and not out of, or not into at all -----------------
## The bake cuts the town off at its edge, and with it the far ends of some one-way streets. A
## street whose every way out is a one-way running off the map (or a few such streets together)
## is a pocket: drive in, and the only way out is against a one-way. Others can only be got
## into from beyond the edge. Of the real towns' public streets 7-13% were one or the other
## (Givatayim 23 km of 172, Tel Aviv 21 of 173, Bedford 41 of 560, Ashdod 18 of 779; the made-up
## test town none). Found once, on the graph the routes are planned on, inside the map's edge:
## _trap (no way back to the town's main network from there: traffic and autodrive keep out
## unless already in) and _cut_off (no way to it from there: a destination in one is reached
## at the nearest street that has a way, a route's start in a trap moves to the nearest street
## with a way out).
var _trap := {}                      ## node -> true: no way from it back to the main network
var _cut_off := {}                   ## node -> true: no way to it from the main network
var _outside := {}                   ## node -> true: past the map's edge (the barrier), on no way at all

func _find_pockets() -> void:
	_trap = {}
	_cut_off = {}
	_outside = {}
	var rim := _bounds.grow(-EDGE - EDGE_ROOM)
	var fwd := {}
	var bwd := {}
	for key: Vector2i in _edge_of:
		if not rim.has_point(_nodes[key.x]) or not rim.has_point(_nodes[key.y]):
			# (over the map's edge: no way on there. Left unmarked, the nearest street "with a
			# way in" to a pocket's address was found past the barrier, and no way to that)
			for n: int in [key.x, key.y]:
				if not rim.has_point(_nodes[n]):
					_outside[n] = true
			continue
		if not fwd.has(key.x):
			fwd[key.x] = []
		(fwd[key.x] as Array).append(key.y)
		if not bwd.has(key.y):
			bwd[key.y] = []
		(bwd[key.y] as Array).append(key.x)
	var all := {}
	for n: int in fwd:
		all[n] = true
	for n: int in bwd:
		all[n] = true
	if all.is_empty():
		return
	# the main network: what can be got to and back from a busy junction in the middle (the
	# nearest few tried, in case one is itself in a pocket)
	var mid := _bounds.get_center()
	var hubs: Array = all.keys().filter(func(n: int) -> bool: return fwd.has(n) and (fwd[n] as Array).size() >= 2)
	hubs.sort_custom(func(a: int, b: int) -> bool: return _nodes[a].distance_squared_to(mid) < _nodes[b].distance_squared_to(mid))
	for hub: int in hubs.slice(0, 5):
		var reach_f := _graph_reach(hub, fwd)
		var reach_b := _graph_reach(hub, bwd)
		var main := 0
		for n: int in reach_f:
			if reach_b.has(n):
				main += 1
		if main < all.size() * 0.4:
			continue
		for n: int in all:
			if not reach_b.has(n):
				_trap[n] = true
			if not reach_f.has(n):
				_cut_off[n] = true
		break

## a road segment ({road, seg, ...} from _nearest_seg) either end of which is marked: in a
## pocket, or its mouth (where the one end that is not can be the wrong way to arrive by)
func _pocketed(hit: Dictionary, marks: Dictionary) -> bool:
	if marks.is_empty():
		return false
	var ids: PackedInt32Array = (_roads[hit["road"]] as Dictionary)["ids"]
	return marks.has(ids[int(hit["seg"])]) or marks.has(ids[int(hit["seg"]) + 1])

## the public street segment nearest p, within reach, clear of the pockets of `marks` (both
## its ends); q is its middle, not its nearest point, which can be the junction at its end
func _nearest_seg_out(p: Vector2, reach: float, marks: Dictionary) -> Dictionary:
	var best := {}
	var bd := INF
	for code: int in _near(_seg_hash, p, reach, SEG_CELL):
		var ri := code / 4096
		var sj := code % 4096
		var r: Dictionary = _roads[ri]
		if not r["drive"] or r["pv"]:
			continue
		var ids: PackedInt32Array = r["ids"]
		if marks.has(ids[sj]) or marks.has(ids[sj + 1]) or _outside.has(ids[sj]) or _outside.has(ids[sj + 1]):
			continue
		var pts: PackedVector2Array = r["pts"]
		var q := Geometry2D.get_closest_point_to_segment(p, pts[sj], pts[sj + 1])
		var d := q.distance_to(p)
		if d < bd and d < reach:
			bd = d
			best = {"road": ri, "seg": sj, "q": (pts[sj] + pts[sj + 1]) * 0.5, "edge": d - float(r["w"]) * 0.5}
	return best

func _graph_reach(from: int, adj: Dictionary) -> Dictionary:
	var seen := {from: true}
	var todo: Array = [from]
	while not todo.is_empty():
		var n: int = todo.pop_back()
		for m: int in adj.get(n, []):
			if not seen.has(m):
				seen[m] = true
				todo.append(m)
	return seen

func _graph_roads(private: bool) -> void:
	for ri in range(_roads.size()):
		var r: Dictionary = _roads[ri]
		if not r["drive"] or bool(r["pv"]) != private:
			continue
		var ids: PackedInt32Array = r["ids"]
		for j in range(ids.size() - 1):
			var a := ids[j]
			var b := ids[j + 1]
			if a == b:
				continue
			for id: int in [a, b]:
				if not _astar.has_point(id):
					_astar.add_point(id, _nodes[id], 6.0 if private else 1.0)
			if r["o"] != -1:
				_astar.connect_points(a, b, false)
				_edge_of[Vector2i(a, b)] = Vector3i(ri, j, 1)
			if r["o"] != 1:
				_astar.connect_points(b, a, false)
				_edge_of[Vector2i(b, a)] = Vector3i(ri, j + 1, -1)

var _city_data: Dictionary = {}      ## the parsed file, kept only until the meshes exist

## ---- building the world ---------------------------------------------------------------

var _stage_ms := {}

## parts of the stages, timed the same way (microseconds, while loading only): "stage: part"
## in _stage_ms once the squares round the start are built (tests/load_stages.gd lists them)
var _part_us := {}

func _part_time(name: String, t0_us: int) -> void:
	if not _bg_build:
		_part_us[name] = int(_part_us.get(name, 0)) + Time.get_ticks_usec() - t0_us

## a square's stages in the order _build_tile builds them, and what the loading text calls
## each: while the squares round the start go up it names the one under way, "(5 of 13)"
## (user, 22 Nov: "can we show more steps during the loading ... an inner progress")
const TILE_STAGES := [["roads", "the ground and the roads"], ["buildings", "buildings"],
	["facades", "facades"], ["trees", "trees"], ["kerbs", "kerbs and pavements"],
	["passages", "passages"], ["wires", "overhead wires"], ["lamps", "lamps and parks"],
	["parked", "parked cars"], ["signs", "lights, signs and road paint"],
	["places", "shops and bus stops"], ["furniture", "street furniture"],
	["batches", "putting it together"]]
var _fg_part := ""                   ## the stage of the square going up behind the loading text

func _fg_stage(i: int) -> void:
	if not _fg_build or i >= TILE_STAGES.size():
		return
	_fg_part = "%s (%d of %d)" % [TILE_STAGES[i][1], i + 1, TILE_STAGES.size()]
	_loading.text = _fg_text + "\n" + _fg_part

func _stage(name: String, t0: int) -> int:
	var t := Time.get_ticks_msec()
	if _fg_build:
		for i in range(TILE_STAGES.size()):
			if TILE_STAGES[i][0] == name:
				_fg_stage(i + 1)
				break
	if not _bg_build:   # (in the background the clock runs on through the frames between)
		_stage_ms[name] = int(_stage_ms.get(name, 0)) + t - t0
	return t

func _build_world() -> bool:
	if not await _step("laying out the world"):
		return false
	var t0 := Time.get_ticks_msec()
	# one shadow map over the near streets, not the default four cascades: those drew every
	# shadow-casting thing in view four more times a frame, more than the view itself
	sun.directional_shadow_mode = DirectionalLight3D.SHADOW_ORTHOGONAL
	# (the same for every place: a walk once started at the best look in a browser and stepped
	# down only under 28 fps, to be set beside its film; the user, 22 Nov: "render less ... and
	# same rule for all". Tests set a walk's quality themselves.)
	_set_quality(QUALITY_WEB if OS.has_feature("web") else QUALITY.size() - 1)
	sun.rotation_degrees = SKIES["day"]["sun"]
	_build_sky_dome()
	cam.near = 0.3
	cam.far = 2200.0
	# the ground, well past the edges so the horizon is not a cliff
	var ground := MeshInstance3D.new()
	var pm := PlaneMesh.new()
	pm.size = _bounds.size + Vector2(4000, 4000)
	pm.material = _ground_mat()
	ground.mesh = pm
	ground.position = Vector3(_bounds.get_center().x, -0.4 if _hnx > 0 else 0.0, _bounds.get_center().y)
	if _decks.any():   # (under the deepest cutting: it shows through the hole cut for it)
		ground.position.y = minf(ground.position.y, _decks.lowest - 1.0)
	ground.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	world.add_child(ground)
	if _hnx > 0:
		_build_terrain()
	if _mtn_from < 10000.0:
		_build_turbines()
	_build_edge()
	var tw0 := _stage("world", t0)
	# (the loading text through the second or three of the set-up, which said nothing --
	# the street network's step stood on screen the while)
	if not await _step("sorting the town into squares"):
		return false
	_build_setup(tw0)
	# (STREETS_BUILD_ALL=1: all of the city first -- the scene tests look all over it)
	var all_first := OS.get_environment("STREETS_BUILD_ALL") == "1"
	# a city level: the far shadows after the car (_far_now) -- they are the distance, and a
	# browser spent seconds of the wait on them; the grass is made now, growing nowhere until
	# their picture says where (its shader compiled in the warm-up, not while driving)
	_far_later = not all_first and not _whole_first()
	var tf := Time.get_ticks_msec()
	if not _far_later:
		await _build_far_shadows()
	var tgr := Time.get_ticks_usec()
	_build_grass()
	_part_time("far shadows: grass blades", tgr)
	_stage("far shadows", tf)
	# the squares round the start before the car is shown; the rest while it drives
	var near: Array = _first_squares(all_first)
	near.sort_custom(func(a, b): return _tile_dist(a, _pos) < _tile_dist(b, _pos))
	# (nothing of the city drawn while it goes up: each step's frames drew what was built so far,
	# and the browser compiled every kind of material's shader the first time -- seconds on the
	# first square, "1 of 6", which looked stuck. The warm-up does that, in steps it can show.)
	world.visible = false
	_gardens_split = not all_first and OS.get_environment("STREETS_GARDENS_SPLIT") != "0"   # (=0: all while loading, as before: tests/gardens_later.gd)
	_gardens_from = _pos
	_load_into("squares", near.size())
	for i in range(near.size()):
		_load_sub(i)
		if not await _step("the streets round the start (%d of %d)" % [i + 1, near.size()]):
			return false
		_fg_text = _loading.text
		_fg_build = true
		_yield_at = Time.get_ticks_usec() + FG_US
		await _build_tile(near[i])
		_fg_build = false
		_fg_part = ""
	_gardens_split = false
	_tiles_todo = _tiles_todo.filter(func(t): return not _tiles_done.has(t))
	if _details != null:   # what a filmed walk added: built whole, once (details.gd)
		await _details.build()
	return true

## ---- building near-first ------------------------------------------------------------------
## The city is built a 400 m square at a time -- the squares its meshes are merged in anyway,
## so building it in pieces costs no extra draws. The squares round the start go in behind
## the loading text; the rest while you drive, the square nearest where the car is heading
## first, a few milliseconds a frame (_pause) so the driving never stutters.
## Anything laid along a road or a fence (asphalt, paint, kerbs, gardens, wires, fences) is
## worked out in full by every square the line crosses, and each square keeps only the
## triangles that start in it (CBuf.clip). Everything else -- a building, a tree, a sign, a
## shop, a parked car -- belongs to the one square its spot is in (_mine), which builds all
## of it, and records whatever goes with it (posts, parked cars, lights, tables) just once.
const TILE := 400.0                  ## = CHUNK = GROUND_CELL = BATCH_CELL
const NEAR_FIRST := 320.0            ## squares this close to the car are built first: before you drive on a filmed walk or a test route, else in a hurry once you can (CATCH_UP_US)
const NEAR_NOW := 60.0               ## a city level: squares this close to the start are built before you drive...
const AHEAD_NOW := 160.0             ## ...and those the street ahead of the car crosses within this far (what the first view looks at)
const BUILD_US := 6000               ## background building: microseconds a frame (half that when frames run slow)
const CATCH_UP_US := 16000           ## the same while a square within NEAR_FIRST of the car is still bare (the first seconds of a drive)
## Once every square within SEE_M of the car is built, the rest -- out past the haze -- goes on
## at BUILD_FAR_US a frame while you drive (full speed again from above, or paused): nothing
## you can see waits for it, and the frames keep their milliseconds. Tel Aviv's whole city took
## 4-6 ms of every frame for ~11 minutes on a user's PC (21 Nov), most of it squares out of sight.
## SEE_M is at full reach: the weak machine's levels draw less far (QUALITY's reach), and as
## much less of the town needs building first (_see_m).
## On slow frames (_slow_frames: a work laptop's browser at 10-20 fps) the far squares wait
## altogether while you drive (_far_hold): there 1.5 ms a frame built Tel Aviv's 150 squares in
## ~25 minutes ("building the city 30%" after minutes, 22 Nov), every one of those milliseconds
## and the build's overruns taken from a frame that had none to spare, for squares nobody saw.
## They are built when the car comes near them, or from above and paused at full speed.
## tests/build_pace.gd: at 12 fps everything within 900 m was up in 3 minutes, the car never in
## a bare square.
const SEE_M := 900.0
const BUILD_FAR_US := 1500
var _far_held := false               ## the far squares waiting (_far_hold): the perf view says so
var _seen_built := false             ## every square within SEE_M of the car is built (looked at twice a second)
var _seen_at := 0
var _catch_up := false               ## a square within NEAR_FIRST of the car is still bare: building at CATCH_UP_US
var _catch_up_ms := 0                ## when the squares round the car were all built, ms after it was shown (the perf view)
var _tile := Vector2i.ZERO           ## the square being built
var _tiled := false                  ## a square is being built (its builders are at work)
var _tiles_done := {}
var _tiles_todo: Array = []          ## Vector2i: the squares still to build
var _tile_roads := {}                ## square -> roads whose line (15 m either side) reaches it
var _tile_decks := {}                ## the same for the decks (decks.gd), which only it draws
var _tile_nodes := {}                ## square -> the road nodes in it
var _tile_blds := {}                 ## square -> buildings (by the middle of the outline)
var _tile_areas := {}                ## square -> the city file's areas that reach it
var _tile_rings := {}                ## kind -> square -> indices into _area_rings[kind] that reach it
var _tile_trees := {}                ## square -> mapped trees
var _tile_pois := {}                 ## square -> places (shops, schools...)
var _tile_stops := {}                ## square -> bus stops
var _tile_signs := {}                ## square -> stop and give-way signs
var _tile_lit := {}                  ## square -> junctions with traffic lights
var _tile_lamps := {}                ## square -> a town's own lamp posts: [where, look, lamps]
var _lamp_cover := {}                ## LAMP_COVER cell -> true: the town's map has its lamp posts there
var _tile_things := {}               ## square -> a town's own street things: [where, kind, places] (furniture.gd's town_things)
var _hydrant_cover := {}             ## LAMP_COVER cell -> true: the town's map has its hydrants there
var _tile_bars := {}                 ## square -> mapped fences and hedges that reach it
var _crossing_set := {}
var _white_bollards := {}            ## crossing nodes whose bollards are white, as filmed (details.gd)
var _no_park: Array = []             ## [spot, radius]: no car parked at the kerb there (details.gd)
var _keep_clear: Array = []          ## [spot, radius]: none of the city's kerbside things there (details.gd)

## a spot a filmed walk shows bare, where the city's own kerbside things and a front garden's
## greenery over the pavement are not put (details.gd's `clear`)
func _kept_clear(p: Vector2) -> bool:
	for kc: Array in _keep_clear:
		if p.distance_to(kc[0]) <= kc[1]:
			return true
	return false
var _bg_build := false               ## building in the background: stop for the frame when over budget
var _bg_wait := false
## The squares round the start are built behind the loading text, and each used to go up in one
## piece: the biggest, "1 of 6", froze a browser's page for seconds (and looked hung). Now
## they too hand a frame back every FG_US, the text ticking over meanwhile.
var _fg_build := false
const FG_US := 80000
var _fg_text := ""
var _fg_spin := 0
var _yield_at := 0
var _build_us := BUILD_US
var _build_lbl: Label
var _build_total := 0                ## squares to build, all told (for the HUD)
var _schools: Array = []             ## schools and kindergartens: SLOW on the road near them
var _poi_taken := {}                 ## a shopfront spot already used -> how many there
var _mesh_cache := {}
var _shingles: StandardMaterial3D

## a mesh made once and shared by every square
func _cached(key: String, make: Callable) -> Mesh:
	if not _mesh_cache.has(key):
		_mesh_cache[key] = make.call()
	return _mesh_cache[key]
signal _build_tick

func _tile_of(p: Vector2) -> Vector2i:
	return Vector2i(floori(p.x / TILE), floori(p.y / TILE))

func _tile_rect(t: Vector2i) -> Rect2:
	return Rect2(Vector2(t) * TILE, Vector2(TILE, TILE))

## how far p is from square t (0 inside it)
## no square within SEE_M of the car still to be built (looked at twice a second)
func _all_seen_built() -> bool:
	var now := Time.get_ticks_msec()
	if now - _seen_at < 500:
		return _seen_built
	_seen_at = now
	_seen_built = true
	for t: Vector2i in _tiles_todo:
		if _tile_dist(t, _pos) < _see_m():
			_seen_built = false
			break
	return _seen_built

func _see_m() -> float:
	return SEE_M * _reach

## a slow machine, driving: the squares out of sight wait (SEE_M)
func _far_hold() -> bool:
	return _slow_frames and not _paused and _zoom_v <= 0.0 and not _catch_up and _all_seen_built()

## the line under the street count: only while squares within sight are still to build (the
## far ones are nobody's wait: the whole city's percentage read as a load that never ended).
## With the perf view up, the whole city instead (_tick_hud).
var _build_near_txt := ""
func _build_label(now = null) -> void:
	var n := 1 if now != null and _tile_dist(now, _pos) < _see_m() else 0
	for t: Vector2i in _tiles_todo:
		if _tile_dist(t, _pos) < _see_m():
			n += 1
	_build_near_txt = ("building the town round you · %d square%s to go" % [n, "" if n == 1 else "s"]) if n > 0 else ""

func _build_far_txt() -> String:
	if not _bg_build or _build_total <= 0:
		return ""
	return "city %d of %d squares built%s" % [_tiles_done.size(), _build_total,
		" · the far ones wait while frames are slow" if _far_held else ""]

func _tile_dist(t: Vector2i, p: Vector2) -> float:
	var r := _tile_rect(t)
	return p.clamp(r.position, r.end).distance_to(p)

## the squares a box reaches
func _tiles_over(box: Rect2) -> Array:
	var out: Array = []
	for tx in range(floori(box.position.x / TILE), floori(box.end.x / TILE) + 1):
		for tz in range(floori(box.position.y / TILE), floori(box.end.y / TILE) + 1):
			out.append(Vector2i(tx, tz))
	return out

func _bucket(table: Dictionary, t: Vector2i, item) -> void:
	if not table.has(t):
		table[t] = []
	(table[t] as Array).append(item)

## p is in the square being built: what stands there is built (and recorded) by it
func _mine(p: Vector2) -> bool:
	return not _tiled or _tile_of(p) == _tile

## p is within m metres of the square being built
func _near_tile(p: Vector2, m: float) -> bool:
	return not _tiled or _tile_rect(_tile).grow(m).has_point(p)

## the nodes within m metres of the square being built
func _nodes_near(m: float) -> Array:
	var out: Array = []
	for dx in [-1, 0, 1]:
		for dz in [-1, 0, 1]:
			for ni: int in _tile_nodes.get(_tile + Vector2i(dx, dz), []):
				if _near_tile(_nodes[ni], m):
					out.append(ni)
	return out

## the outlines of one kind of area (park, wood, parking...) that reach the square
func _rings_near(kind: String) -> Array:
	var all: Array = _area_rings.get(kind, [])
	var out: Array = []
	for ri: int in (_tile_rings.get(kind, {}) as Dictionary).get(_tile, []):
		out.append(all[ri])
	return out

## an area's outline belongs to the square its box's middle is in
func _ring_mine(ring: PackedVector2Array) -> bool:
	return _mine(_bld_box_of(ring).get_center())

## a CBuf for something every square along it works out (see CBuf.clip)
func _clip_buf(cell: float) -> CBuf:
	var b := CBuf.new(cell)
	b.clip = true
	return b

func _tally(k: String, n: int) -> void:
	_dressing[k] = int(_dressing.get(k, 0)) + n

## Where the background build runs long without handing the frame back (STREETS_SPANS=1,
## a debug run: tests/build_spans.gd). Each pause notes how far past its budget the work
## before it ran, and the call sites that paused: a phone ran single stretches of 1-1.5 s.
var _span_rec := OS.get_environment("STREETS_SPANS") == "1"
var _spans: Array = []               ## [ms past the budget, "func:line < func:line < ..."]

var _bstep := ""                     ## the square-building step under way (named in the hitch line)
var _bstep_slow := ""                ## the step that last ran 30+ ms past the frame's budget, for the next hitch line
var _bstep_slow_us := 0

## one step of building a square: its name kept for a hitch, the frame handed back first if
## its budget is used up
func _build_step(what: String) -> void:
	if _over():
		await _pause()   # (before the name changes: a long stretch is the step that ran it)
	_bstep = what

var _span_last := 0                  ## (STREETS_SPANS) the last budget check: when, and where
var _span_last_at := ""

func _span_gap() -> void:
	var now := Time.get_ticks_usec()
	var st := get_stack()
	var at: Array = []
	for i in range(2, mini(5, st.size())):
		at.append("%s:%d" % [st[i]["function"], st[i]["line"]])
	var here := " < ".join(at)
	if _bg_build and _span_last > 0 and now - _span_last > 20000:
		_spans.append([(now - _span_last) / 1000.0, "from " + _span_last_at + "  TO  " + here])
	_span_last = now
	_span_last_at = here

## the frame's building time is used up
func _over() -> bool:
	if _span_rec:
		_span_gap()
	return (_bg_build or _fg_build) and Time.get_ticks_usec() > _yield_at

## Building in the background: hand the frame back and go on in the next one. Meanwhile
## the game is not building a square, so whatever it makes in between (night's light pools)
## is its own, not that square's.
func _pause() -> void:
	if _fg_build:   # loading: no game frame to wait for -- just let one be drawn
		_fg_spin += 1
		_loading.text = _fg_text + ("\n" + _fg_part if _fg_part != "" else "") + "  " + ["·  ", " · ", "  ·", " · "][_fg_spin % 4]
		_load_tick()
		await get_tree().process_frame
		_yield_at = Time.get_ticks_usec() + FG_US
		return
	var over_us := Time.get_ticks_usec() - _yield_at
	if over_us > 30000 and over_us > _bstep_slow_us:   # ran 30+ ms past the budget: which step (the hitch line)
		_bstep_slow = _bstep if _bstep != "" else "between squares"
		_bstep_slow_us = over_us
	var was := _tiled
	var batching := _batching
	_set_tiling(false)
	_batching = false
	_bg_wait = true
	await _build_tick
	_batching = batching
	_set_tiling(was)
	_yield_at = Time.get_ticks_usec() + _build_us
	_span_last = 0   # (the frame in between is not the build's)

## empty a big table or list a few hundred entries at a time, within the frame's budget
func _release(table) -> void:
	if table is Dictionary:
		var d: Dictionary = table
		var keys: Array = d.keys()
		for i in range(keys.size()):
			d.erase(keys[i])
			if i % 256 == 255 and _over():
				await _pause()
	elif table is Array:
		var a: Array = table
		while not a.is_empty():
			a.resize(maxi(0, a.size() - 256))
			if _over():
				await _pause()

func _set_tiling(on: bool) -> void:
	_tiled = on
	CBuf.tiled = on
	CBuf.tile = _tile

## What every square needs from the whole city, worked out once: which roads, junctions,
## buildings, areas and places reach each square; the outlines of the parks, woods and car
## parks; what traffic needs everywhere at once (which junctions have lights).
func _build_setup(t0: int) -> void:
	var k := 1.0 / float(_city_data.get("scale", 10))
	_furn = Furniture.new(self)
	_build_asph_hash()
	_bld_kind.resize((_city_data["buildings"] as Array).size())
	_bld_kind.fill(0)
	for ni in _city_data.get("crossings", []):
		_crossing_nodes.append(int(ni))
		_crossing_set[int(ni)] = true
	var areas: Array = _city_data.get("areas", [])
	for ai in range(areas.size()):
		var a: Dictionary = areas[ai]
		var kind := String(a["k"])
		var flat: Array = a["p"]
		var ring := PackedVector2Array()
		for i in range(0, flat.size(), 2):
			ring.append(Vector2(flat[i], flat[i + 1]) * k)
		a["_ring"] = ring
		if ring.size() < 3:
			continue
		var over := _tiles_over(_bld_box_of(ring))
		for t: Vector2i in over:
			_bucket(_tile_areas, t, ai)
		if kind in ["park", "grass", "wood", "pitch", "water", "parking", "plaza", "school"]:
			if not _area_rings.has(kind):
				_area_rings[kind] = []
				_tile_rings[kind] = {}
			for t: Vector2i in over:
				_bucket(_tile_rings[kind], t, (_area_rings[kind] as Array).size())
			(_area_rings[kind] as Array).append(ring)
	_find_islands(areas)
	for ri in range(_roads.size()):
		var r: Dictionary = _roads[ri]
		var pts: PackedVector2Array = r["pts"]
		var reach := float(r["w"]) * 0.5 + 15.0
		var seen := {}
		for j in range(pts.size() - 1):
			for t: Vector2i in _tiles_over(Rect2(pts[j], Vector2.ZERO).expand(pts[j + 1]).grow(reach)):
				if not seen.has(t):
					seen[t] = true
					# a deck is drawn by decks.gd: none of the ground's builders see it
					_bucket(_tile_decks if r.has("ys") else _tile_roads, t, ri)
	for ni in range(_nodes.size()):
		if not _decks.deck_only(ni):
			_bucket(_tile_nodes, _tile_of(_nodes[ni]), ni)
	for bi in range(_bld_box.size()):
		_bucket(_tile_blds, _tile_of((_bld_box[bi] as Rect2).get_center()), bi)
	var tr: Array = _city_data.get("trees", [])
	for i in range(0, tr.size() - 1, 2):
		_bucket(_tile_trees, _tile_of(Vector2(tr[i], tr[i + 1]) * k), i)
	# a town's own map of its trees (the city file's tree_surveys): where one maps every tree,
	# from the air, none is made up (2); a list of street trees is not every street tree (Tel
	# Aviv's has 16 along a stretch of Rothschild that has rows of them), so a made-up street
	# tree is only kept off a real one's spot (_tree_near)
	for ts: Dictionary in _city_data.get("tree_surveys", []):
		for t in range(int(ts["from"]), int(ts["to"])):
			var tp := Vector2(tr[2 * t], tr[2 * t + 1]) * k
			if int(ts.get("all", 0)) == 1:
				_tree_cover[_cell(tp, TREE_COVER)] = 2
			else:
				_bucket(_tree_near, _cell(tp, TREE_NEAR), tp)
	var lamps_xz: Array = _city_data.get("lamps", [])   # (a town's own lamp posts: _build_lamps)
	var lamp_info: Array = _city_data.get("lamp_info", [])
	var lamp_looks: Array = _city_data.get("lamp_looks", [])
	for i in range(lamps_xz.size() / 2):
		var lp := Vector2(lamps_xz[i * 2], lamps_xz[i * 2 + 1]) * k
		_bucket(_tile_lamps, _tile_of(lp), [lp, String(lamp_looks[int(lamp_info[i * 2])]), clampi(int(lamp_info[i * 2 + 1]), 1, 2)])
		_lamp_cover[_cell(lp, LAMP_COVER)] = true
	var things: Array = _city_data.get("things", [])   # (a town's own street things: furniture.gd's town_things)
	var thing_kinds: Array = _city_data.get("thing_kinds", [])
	for i in range(things.size() / 4):
		var tp := Vector2(things[i * 4], things[i * 4 + 1]) * k
		var kind := String(thing_kinds[int(things[i * 4 + 2])])
		_bucket(_tile_things, _tile_of(tp), [tp, kind, int(things[i * 4 + 3])])
		if kind == "hydrant":
			_hydrant_cover[_cell(tp, LAMP_COVER)] = true
	var pois: Array = _city_data.get("pois", [])
	for i in range(pois.size()):
		_bucket(_tile_pois, _tile_of(Vector2(pois[i][0], pois[i][1]) * k), i)
		if String(pois[i][2]) in ["school", "kindergarten"]:
			_schools.append(Vector2(pois[i][0], pois[i][1]) * k)
	var stops: Array = _city_data.get("stops", [])
	for i in range(stops.size()):
		_bucket(_tile_stops, _tile_of(Vector2(stops[i][0], stops[i][1]) * k), i)
	var signs: Array = _city_data.get("signs", [])
	for i in range(signs.size()):
		var node := int(signs[i][0])
		if node >= 0 and node < _nodes.size():
			_bucket(_tile_signs, _tile_of(_nodes[node]), i)
	var bars: Array = _city_data.get("barriers", [])
	for i in range(bars.size()):
		var flat: Array = bars[i][0]
		var seen := {}
		for j in range(0, flat.size() - 2, 2):
			var box := Rect2(Vector2(flat[j], flat[j + 1]) * k, Vector2.ZERO).expand(Vector2(flat[j + 2], flat[j + 3]) * k)
			for t: Vector2i in _tiles_over(box.grow(1.0)):
				if not seen.has(t):
					seen[t] = true
					_bucket(_tile_bars, t, i)
	_rails = Rails.new(self)
	_rails.setup(_city_data, k)   # (before the trees: nothing grows on a track's bed)
	_crowd = Crowds.new(self)   # (before the market and the beach: they hand it their lines)
	_marks = Marks.new(self)
	_marks.setup(_city_data, _city_id)
	_beach = Beach.new(self)
	_beach.setup(_city_data)
	_works = Sites.new(self)
	_works.setup(_city_data)
	_models = Models.new(self)
	_places = Places.new(self)
	_places.setup(_city_data)
	_wave = Wave.new(self)
	_racer = Racer.new(self)
	_lights_setup()
	_infer_signs()   # (after the lights: a lit junction has none)
	_parks_setup()
	_trees_setup()
	# every square with anything in it, and every square of the map (open land grows trees)
	var todo := {}
	for table: Dictionary in [_tile_roads, _tile_nodes, _tile_blds, _tile_areas, _tile_trees, _tile_pois]:
		for t: Vector2i in table:
			todo[t] = true
	for t: Vector2i in _tiles_over(_bounds):
		todo[t] = true
	_tiles_todo = todo.keys()
	_build_total = _tiles_todo.size()
	_stage("setup", t0)

## One square of the city, everything in it, each kind keeping clear of what went before
## (trees of buildings, lamps of trees...); the kerbs after the trees, whose leaves lie on
## their pavements.
## In the background each builder stops when the frame's few milliseconds are used up and
## goes on in the next frame.
func _build_tile(t: Vector2i) -> void:
	_fg_stage(0)
	if _over():
		await _pause()
	_tiles_done[t] = true
	_tile = t
	_set_tiling(true)
	_batching = true
	for a: Array in [_stop_lines, _pole_plates, _chimneys, _mall_glass, _lobby_doors, _balcony_flags, _flag_spots, _stop_ads, _cat_spots, _car_flags, _yard_cars]:
		a.clear()   # made by one builder for the next, square by square
	var tk := Time.get_ticks_msec()
	_ao = CBuf.new(GROUND_CELL)
	# every step behind `_step`: the frame handed back between any two of them if it is used up
	# (decks, rails, marks, beach, works and places ran back to back unchecked: 50 ms on a
	# desktop, tests/build_spans.gd), and the step's name kept for the hitch line
	await _build_step("corner fills")
	await _note_corner_fills()   # (before anything is stood anywhere: see _off_road)
	await _build_step("ground")
	await _build_ground()
	await _build_step("decks")
	await _decks.build()
	await _build_step("rails")
	await _rails.build()
	await _build_step("marks")
	_marks.build()
	await _build_step("beach")
	_beach.build()
	await _build_step("works")
	_works.build()
	await _build_step("places")
	await _places.build()
	tk = _stage("roads", tk)
	await _build_step("buildings")
	await _build_buildings()
	tk = _stage("buildings", tk)
	await _build_step("roof kit")
	await _build_roof_kit()
	await _build_step("facade kit")
	await _build_facade_kit()
	tk = _stage("facades", tk)
	await _build_step("trees")
	await _build_trees()
	tk = _stage("trees", tk)
	await _build_step("kerbs")
	await _build_kerbs()   # (after the trees: the leaves on the pavement are under them)
	tk = _stage("kerbs", tk)
	await _build_step("passages")
	await _build_passages()
	tk = _stage("passages", tk)
	await _build_step("wires")
	await _furn.wires()
	tk = _stage("wires", tk)
	await _build_step("lamps")
	await _build_lamps()
	await _build_step("parks")
	await _build_parks()
	tk = _stage("lamps", tk)
	await _build_step("parked")
	await _build_parked()
	await _build_step("lots")
	await _build_lots()
	await _build_step("contact shadows")
	for mi: MeshInstance3D in _add_mesh(_ao, _ao_material(), false, AO_SEEN):   # (after the buildings and the cars)
		mi.extra_cull_margin = 60.0   # (the trees' patches are moved out by the sun, in the shader)
	_ao = null
	tk = _stage("parked", tk)
	await _build_step("signals")
	await _build_signals()
	await _build_step("signs")
	await _build_signs()
	await _build_step("road paint")
	await _build_road_paint()
	await _build_step("speed signs")
	await _build_speed_signs()
	await _build_step("street signs")
	await _build_street_signs()
	tk = _stage("signs", tk)
	await _build_step("pois")
	await _build_pois()
	await _build_step("stops")
	await _build_stops()
	tk = _stage("places", tk)
	var tfu := Time.get_ticks_usec()
	await _build_step("furniture")
	await _furn.build()
	_part_time("furniture: all (furniture.gd)", tfu)
	tk = _stage("furniture", tk)
	await _build_step("batches")
	await _flush_batches()
	if _pools_made:
		await _build_step("light pools")
		_make_pools()   # it is night: this square's light pools too
	_stage("batches", tk)
	_bstep = ""
	_set_tiling(false)
	_batching = false
	if _standins != null:
		_standins.drop(t)

## The squares built before the car is shown. A city level: the one the start is in and any
## within NEAR_NOW of it, and those the street ahead crosses within AHEAD_NOW -- what the
## first view looks at (user: "as close to 0 as possible" -- all of NEAR_FIRST, 6-9 squares,
## was most of the wait). The rest of NEAR_FIRST follows in a hurry once you can drive
## (_catch_up). A filmed walk or a test route keeps all of NEAR_FIRST first: their pictures
## and drives are compared run to run. STREETS_NEAR_FIRST=1: that for every level, as before.
func _first_squares(all_first: bool) -> Array:
	var whole := _whole_first()
	var ahead := {}
	for i in range(int(AHEAD_NOW / 10.0) + 1):
		ahead[_tile_of(_pos + _fwd() * (i * 10.0))] = true
	var out: Array = []
	for t: Vector2i in _tiles_todo:
		var d := _tile_dist(t, _pos)
		if all_first or (whole and d < NEAR_FIRST) or (not whole and (d < NEAR_NOW or ahead.has(t))):
			out.append(t)
	return out

## a filmed walk or a test route (or STREETS_NEAR_FIRST=1): everything round the start, far
## shadows too, before the car, as before -- their pictures and drives are compared run to run
func _whole_first() -> bool:
	return _place.has("walk") or not _route.is_empty() or OS.get_environment("STREETS_NEAR_FIRST") == "1"

var _far_later := false              ## the far shadows are still to come (_far_now)

## the far shadows and the grass's picture, once the squares round the car are up
func _far_now() -> void:
	if not _far_later:
		return
	_far_later = false
	if _fs_cache.has("evening" if _evening else "day") or DisplayServer.get_name() == "headless":
		return   # (the evening drew its own meanwhile; nothing is drawn headless)
	var t := Time.get_ticks_msec()
	await _build_far_shadows(true)
	print("[streets] far shadows drawn after the car, %d ms" % (Time.get_ticks_msec() - t))
	Probe.event("far_shadows", {"ms": Time.get_ticks_msec() - t})

## the other sun's picture too, a while after the car's own -- so the time-of-day button finds
## it drawn: drawn at the click it held the game a second and more (a user, 21 Nov)
func _far_ahead() -> void:
	if DisplayServer.get_name() == "headless":
		return
	await get_tree().create_timer(FAR_AHEAD_S).timeout
	var waited := 0
	while is_inside_tree() and not _fs_cache.has("evening" if _evening else "day") and waited < 120:
		await get_tree().create_timer(1.0).timeout   # (the car's own sun first)
		waited += 1
	var other := "day" if _evening else "evening"
	if not is_inside_tree():
		return
	var t := Time.get_ticks_msec()
	if not _fs_cache.has(other) and not _fs_drawing.has(other):
		await _far_draw(other)
		print("[streets] the %s's far shadows drawn ahead, %d ms" % [other, Time.get_ticks_msec() - t])
	if is_inside_tree() and not _pools_made:   # and the night's light pools, for its button
		t = Time.get_ticks_msec()
		await _make_pools(true)
		print("[streets] the night's light pools made ahead, %d ms" % (Time.get_ticks_msec() - t))
const FAR_AHEAD_S := 8.0

## both suns' pictures drawn (or being drawn: waited for) -- before the city file they are
## drawn from is let go. The evening's, drawn at its button once the city was built, met an
## empty file: no far shadows at all in the evening.
func _far_both() -> void:
	if DisplayServer.get_name() == "headless":
		return
	for key: String in ["day", "evening"]:
		if not _fs_cache.has(key) and not _fs_drawing.has(key):
			await _far_draw(key)
	while is_inside_tree() and not _fs_drawing.is_empty():
		await get_tree().process_frame

## one sun's picture, a few ms a frame, marked as being drawn meanwhile
func _far_draw(key: String) -> void:
	_fs_drawing[key] = true
	await _build_far_shadows(true, key)
	_fs_drawing.erase(key)

## a square within NEAR_FIRST of the car is still to be built
func _bare_near() -> bool:
	for t: Vector2i in _tiles_todo:
		if _tile_dist(t, _pos) < NEAR_FIRST:
			return true
	return false

## the square to build next: the one nearest where the car will be in a few seconds
func _next_tile():
	if _tiles_todo.is_empty():
		return null
	var ahead := _pos + _fwd() * clampf(_v * 4.0, 0.0, 250.0)
	var best := 0
	var bd := INF
	for i in range(_tiles_todo.size()):
		var d := _tile_dist(_tiles_todo[i], ahead)
		if d < bd:
			bd = d
			best = i
	var t: Vector2i = _tiles_todo[best]
	_tiles_todo.remove_at(best)
	return t

## the rest of the city, a square at a time while the game runs
func _build_rest() -> void:
	var t0 := Time.get_ticks_msec()
	var n := 0
	_bg_build = true
	var hurry := _bare_near()   # (only in the first seconds: later the build never costs the drive's frames)
	_catch_up = hurry
	_build_us = CATCH_UP_US if _catch_up else BUILD_US
	_yield_at = Time.get_ticks_usec() + _build_us
	_bstep = "gardens"
	await _build_gardens_later()   # (the start's squares' far gardens, first)
	if not _tiles_todo.is_empty():   # (the rest, as flat stand-ins seen from above, at once)
		_bstep = "stand-ins"
		_standins = Standins.new(self)
		await _standins.build_all()
	if not hurry:
		_bstep = "far shadows"
		await _far_now()
	while is_inside_tree():
		var held := 0
		while _far_hold() and not _tiles_todo.is_empty() and is_inside_tree():
			_far_held = true
			if held % 30 == 0:
				_build_label()
			held += 1
			await get_tree().process_frame
		_far_held = false
		var t = _next_tile()
		if t == null:
			break
		_catch_up = hurry and (_tile_dist(t, _pos) < NEAR_FIRST or _bare_near())
		_build_label(t)
		await _build_tile(t)
		n += 1
		if hurry and not _bare_near():
			hurry = false
			_catch_up = false
			_catch_up_ms = Time.get_ticks_msec() - t0
			print("[streets] the squares round the car built %d ms after it was shown" % _catch_up_ms)
			Probe.event("near_built", {"ms": _catch_up_ms, "squares": n})
			_bstep = "far shadows"
			await _far_now()
		_build_label()
	_bstep = "far shadows"
	await _far_now()   # (if it has not come yet: before the city file below is let go)
	await _far_both()   # (and the other sun's: drawn later, from what is let go, it failed)
	_bstep = "letting go of the city file"
	_build_near_txt = ""
	# what was only for building -- the file, the outlines, the squares' lists -- let go of a
	# little a frame (all at once, it took a frame and a half)
	for key: String in _city_data.keys():
		await _release(_city_data[key])
	_city_data = {}
	for table: Dictionary in [_area_rings, _asph_hash, _tile_roads, _tile_decks, _tile_nodes, _tile_blds, _tile_areas, _tile_rings,
			_tile_trees, _tile_pois, _tile_stops, _tile_signs, _tile_lit, _tile_bars, _tile_lamps, _tile_things]:
		await _release(table)
	_bg_build = false
	Probe.event("city_built", {"squares": n, "ms": Time.get_ticks_msec() - t0, "posts": _posts.size(), "trees": _trees_made, "dressing": _dressing})

## ground height at p: the same two triangles per grid cell as the terrain mesh, so
## anything placed with it sits exactly on the drawn ground. 0 for a flat city.
## how far the road's surface is above the ground: wheels go on it, not in it
func road_top() -> float:
	return Y_ROAD + (0.07 if _hnx > 0 else 0.0)

func _h(p: Vector2) -> float:
	if _hnx == 0:
		return 0.0
	var fx := clampf((p.x - _hx0) / _hstep, 0.0, float(_hnx) - 1.001)
	var fz := clampf((p.y - _hz0) / _hstep, 0.0, float(_hnz) - 1.001)
	var i := int(fx)
	var j := int(fz)
	var ax := fx - i
	var az := fz - j
	var r := j * _hnx + i
	if ax + az <= 1.0:
		return _hgrid[r] + (_hgrid[r + 1] - _hgrid[r]) * ax + (_hgrid[r + _hnx] - _hgrid[r]) * az
	var h11 := _hgrid[r + _hnx + 1]
	return h11 + (_hgrid[r + _hnx] - h11) * (1.0 - ax) + (_hgrid[r + 1] - h11) * (1.0 - az)

## _g3's height (lift 0) for every point of a line, each worked out once
func _ground_line(pts: PackedVector2Array) -> PackedFloat32Array:
	var out := PackedFloat32Array()
	out.resize(pts.size())
	var extra := 0.07 if _hnx > 0 else 0.0
	for i in range(pts.size()):
		out[i] = _hh(pts[i]) + extra
	return out

## the ground's height, or while a deck road is drawn (_on_deck) that road's surface
func _hh(p: Vector2) -> float:
	return _h(p) if _on_deck < 0 else _decks.deck_y(_on_deck, p)

## This square's ground: the parks, lawns, water and car parks, the roads' asphalt and the
## paths, their paint and zebras, the cast iron in them. All of it laid along lines and
## outlines that every square they reach works out in full (each keeping its own triangles).
func _build_ground() -> void:
	var areas := {}
	var all: Array = _city_data.get("areas", [])
	var sq := _tile_rect(_tile)
	var sq_poly := PackedVector2Array([sq.position, Vector2(sq.end.x, sq.position.y), sq.end, Vector2(sq.position.x, sq.end.y)])
	for ai: int in _tile_areas.get(_tile, []):
		if _over():
			await _pause()
		var a: Dictionary = all[ai]
		var kind := String(a["k"])
		# a school's grounds: paved, under whatever pitches and lawns OSM puts in them
		var tone := "grass" if kind in ["park", "grass"] else ("ground" if kind == "land" else ("plaza" if kind == "school" else ("beach" if kind == "sand" else kind)))
		if not areas.has(tone):
			areas[tone] = CBuf.new(CHUNK)   # (each square fills only its own piece: no clipping)
		# islands sit on the sea, parks and car parks on whatever is under them
		var y := Y_AREA + (0.002 if tone in ["parking", "plaza"] else (0.001 if kind == "land" else 0.0))
		if kind == "school":
			y = Y_AREA - 0.001
		var ring: PackedVector2Array = a["_ring"]
		if a.has("_isl"):   # a traffic island: raised, off the asphalt (see _find_islands)
			for isl: PackedVector2Array in a["_isl"]:
				for piece: PackedVector2Array in _pieces_in(isl, sq, sq_poly):
					await _fill(areas[tone], piece, ISLAND_Y)
			continue
		var flat := INF
		if tone == "water" and a.has("y"):   # a river held at its level by weirs
			flat = float(a["y"]) / float(_city_data.get("scale", 10))
		elif tone == "water":   # water lies flat at the lowest point of its whole shore
			for p in ring:
				flat = minf(flat, _h(p))
		for piece: PackedVector2Array in _pieces_in(ring, sq, sq_poly):
			await _fill(areas[tone], piece, y, tone == "water", flat)
	for tone: String in areas:
		if _over():
			await _pause()
		_add_mesh(areas[tone], _surface(tone), false, VIEW_RANGE)
	# roads: asphalt ribbons, with a round patch where roads meet so corners are filled
	var asphalt := _clip_buf(CHUNK)
	var paths := _clip_buf(CHUNK)
	var walks := _clip_buf(CHUNK)   # footpaths in town: paved like the pavements
	var marks := _clip_buf(GROUND_CELL)
	var yellow := _clip_buf(GROUND_CELL)
	var metal := _clip_buf(GROUND_CELL)
	var metal_rim := _clip_buf(GROUND_CELL)
	for ri: int in _tile_roads.get(_tile, []):
		if _over():
			await _pause()
		var r: Dictionary = _roads[ri]
		var part := _near_part(r["pts"], r["w"] * 0.5 + 2.0)
		if part.size() >= 2:
			var under: Buf = asphalt if r["drive"] else (walks if _paved_walk(r) else paths)
			_ribbon(under, part, r["w"] * 0.5, Y_ROAD if r["drive"] else Y_PATH)
		_markings(marks, r, yellow)
		_street_metal(metal, metal_rim, ri)
	for ni: int in _tile_nodes.get(_tile, []):
		if _node_r[ni] > 0.0 and (_node_roads[ni] as Array).size() >= 2:
			_disc(asphalt, _nodes[ni], _node_r[ni] * 1.05, Y_ROAD)
	for ni: int in _nodes_near(30.0):
		if _crossing_set.has(ni):
			_zebra(marks, ni)
	for job: Array in [[metal_rim, "metalrim", DETAIL_RANGE], [metal, "metal", DETAIL_RANGE], [paths, "path", VIEW_RANGE * 0.6], [walks, "pavement", VIEW_RANGE * 0.6],
			[asphalt, "asphalt", VIEW_RANGE], [marks, "mark", DETAIL_RANGE], [yellow, "markyellow", DETAIL_RANGE]]:
		if _over():
			await _pause()
		_add_mesh(job[0], _surface(job[1]), false, job[2])

## the parts of an outline inside square `sq` (the whole outline when it lies inside)
func _pieces_in(ring: PackedVector2Array, sq: Rect2, sq_poly: PackedVector2Array) -> Array:
	if sq.encloses(_bld_box_of(ring)):
		return [ring]
	var cut := Geometry2D.intersect_polygons(ring, sq_poly)
	if cut.size() <= 1:
		return cut
	# an outline that crosses itself can come back with holes: keep the outer pieces (those
	# turning the same way as the biggest)
	var big := 0
	for i in range(cut.size()):
		if absf(_area_signed(cut[i])) > absf(_area_signed(cut[big])):
			big = i
	var way := signf(_area_signed(cut[big]))
	return cut.filter(func(c): return signf(_area_signed(c)) == way)

## how far along a line (cumulative lengths `cum`) its stretch near the square being built
## runs: Vector2(from, to); the whole line when no square is being built, (INF, -INF) when
## none of it is near
func _near_span(pts: PackedVector2Array, cum: PackedFloat32Array, reach: float) -> Vector2:
	if not _tiled:
		return Vector2(0.0, cum[cum.size() - 1])
	var box := _tile_rect(_tile).grow(reach)
	var span := Vector2(INF, -INF)
	for j in range(pts.size() - 1):
		if box.intersects(Rect2(pts[j], Vector2.ZERO).expand(pts[j + 1]).grow(0.01)):
			span.x = minf(span.x, cum[j])
			span.y = maxf(span.y, cum[j + 1])
	return span

## the stretch of a line near the square being built, with two more points each side so its
## bends come out just as the whole line's do (empty: none of it is near)
func _near_part(pts: PackedVector2Array, reach: float) -> PackedVector2Array:
	var box := _tile_rect(_tile).grow(reach)
	var i0 := -1
	var i1 := -1
	for j in range(pts.size() - 1):
		if box.intersects(Rect2(pts[j], Vector2.ZERO).expand(pts[j + 1]).grow(0.01)):
			if i0 < 0:
				i0 = j
			i1 = j
	if i0 < 0:
		return PackedVector2Array()
	return pts.slice(maxi(i0 - 2, 0), mini(i1 + 4, pts.size()))

## a map point on the ground, `lift` above it (a little more on hills: a straight piece
## of road between two points can dip under a bend in the ground)
## Where a person's feet go at p: on top of the pavement beside a kerbed road, on the
## asphalt, or on the ground's own layer -- each a little over the bare ground height, which
## is where people stood, a pavement's height (and on the hills the lift) into the slabs.
func _walk_y(p: Vector2, y := NAN) -> float:
	var base := _h(p) if is_nan(y) else _decks.surf(p, y)   # (on a bridge, in a tunnel: its road)
	var hit := _nearest_seg(p, 5.0, true, true, NAN if is_nan(y) else base)
	var on := Y_AREA
	if not hit.is_empty():
		var edge: float = hit["edge"]
		if edge < 0.0:
			on = Y_ROAD
		elif edge < KERB_W + PAVE_W + 0.1 and _kerbed(_roads[hit["road"]]):
			on = KERB_H
		elif _on_some_pavement(p):
			# (the nearest road has no pavement -- a service lane, a lane without kerbs -- but
			# the next street's is laid here: people stepping over a side street's mouth stood
			# a kerb's height down in it, to the ankle)
			on = KERB_H
	return base + on + (0.07 if _hnx > 0 else 0.0)

## p is on a kerbed street's pavement (its band beside the asphalt), whichever street is nearest
func _on_some_pavement(p: Vector2) -> bool:
	for code: int in _near(_seg_hash, p, KERB_W + PAVE_W + 0.6, SEG_CELL):
		var r: Dictionary = _roads[code / 4096]
		if not r["drive"] or r.has("ys") or not _kerbed(r):
			continue
		var pts: PackedVector2Array = r["pts"]
		var sj := code % 4096
		var edge := p.distance_to(Geometry2D.get_closest_point_to_segment(p, pts[sj], pts[sj + 1])) - float(r["w"]) * 0.5
		if edge >= 0.0 and edge < KERB_W + PAVE_W + 0.1:
			return true
	return false

## a pavement's top over the bare ground
func _pave_top() -> float:
	return KERB_H + (0.07 if _hnx > 0 else 0.0)

func _g3(p: Vector2, lift: float) -> Vector3:
	return Vector3(p.x, _hh(p) + lift + (0.07 if _hnx > 0 else 0.0), p.y)

## the ground itself: one mesh over the city's height grid, smooth-shaded
## ---- the made-up town's wind turbines -------------------------------------------------------
## A row along the highest stretch of the mountains' crest, facing the town, the blades turning
## and a red light on each nacelle blinking (all together, as a wind farm's do): something
## alive on the skyline from anywhere in the valley.
const TURBINES := 5
const TURBINE_H := 55.0              ## the hub's height over the ground
const BLADE_L := 22.0
var _blades: MultiMesh
var _hubs: Array = []                ## [hub, facing (unit, toward the town), phase] per turbine
var _turbine_light: StandardMaterial3D

func _build_turbines() -> void:
	var mid := _bounds.get_center()
	var inside := _bounds.grow(-EDGE - 45.0)
	# the crest on every bearing: the highest ground between the town and the map's edge
	var crest: Array = []
	for a in range(360):
		var dir := Vector2.from_angle(deg_to_rad(a))
		var best := Vector2.ZERO
		var bh := -INF
		var r := 60.0
		while true:
			var p := mid + dir * r
			if not inside.has_point(p):
				break
			if not _in_city(p) and _h(p) > bh:
				bh = _h(p)
				best = p
			r += 8.0
		crest.append([best, bh])
	# the highest stretch (the bearing whose 30 degrees round it stand highest), then the
	# turbines along it, 90 m apart or more
	var top := 0
	var top_v := -INF
	for a in range(360):
		var v := 0.0
		for k in range(-15, 16):
			v += float(crest[(a + k + 360) % 360][1])
		if v > top_v:
			top_v = v
			top = a
	var spots: Array = [crest[top][0]]
	for side: int in [1, -1]:
		var a := top
		for _k in range(60):
			if spots.size() >= TURBINES:
				break
			a = (a + side + 360) % 360
			var p: Vector2 = crest[a][0]
			if float(crest[a][1]) > _mtn_from and spots.all(func(q): return (q as Vector2).distance_to(p) > 90.0):
				if (spots[spots.size() - 1] as Vector2).distance_to(p) > 90.0 or side == -1:
					spots.append(p)
					if side == 1 and spots.size() >= 3:
						break   # (the rest the other way)
	var white := StandardMaterial3D.new()
	white.albedo_color = _tone["mark"]
	white.roughness = 0.5
	var tower := CylinderMesh.new()
	tower.top_radius = 1.0
	tower.bottom_radius = 1.8
	tower.height = TURBINE_H
	tower.radial_segments = 10
	tower.material = white
	var nacelle := BoxMesh.new()
	nacelle.size = Vector3(2.6, 2.6, 7.5)
	nacelle.material = white
	var hub := SphereMesh.new()
	hub.radius = 1.3
	hub.height = 2.6
	hub.radial_segments = 8
	hub.rings = 4
	hub.material = white
	var blade := BoxMesh.new()
	blade.size = Vector3(1.3, BLADE_L, 0.35)
	blade.material = white
	_turbine_light = StandardMaterial3D.new()
	_turbine_light.albedo_color = Palette.col("hazard").lerp(Color.RED, 0.6)
	_turbine_light.emission = _turbine_light.albedo_color
	_turbine_light.emission_energy_multiplier = 1.5
	var beacon := SphereMesh.new()
	beacon.radius = 0.45
	beacon.height = 0.9
	beacon.radial_segments = 6
	beacon.rings = 3
	beacon.material = _turbine_light
	var parts := {"tower": [], "nacelle": [], "hub": [], "beacon": []}
	for i in range(spots.size()):
		var p: Vector2 = spots[i]
		var gy := _h(p)
		var face := (mid - p).normalized()
		var yaw := Basis(Vector3.UP, atan2(face.x, face.y))   # +Z toward the town
		var at := Vector3(p.x, gy, p.y)
		var top3 := at + Vector3(0, TURBINE_H, 0)
		var f3 := Vector3(face.x, 0, face.y)
		(parts["tower"] as Array).append(Transform3D(Basis(), at + Vector3(0, TURBINE_H * 0.5, 0)))
		(parts["nacelle"] as Array).append(Transform3D(yaw, top3 - f3 * 1.2))
		(parts["hub"] as Array).append(Transform3D(Basis(), top3 + f3 * 2.8))
		(parts["beacon"] as Array).append(Transform3D(Basis(), top3 + Vector3(0, 1.75, 0) - f3 * 3.5))
		_hubs.append([top3 + f3 * 3.1, f3, float(i) * 1.7])
		_add_post(p, 2.0)
	for part: String in parts:
		var mesh: Mesh = {"tower": tower, "nacelle": nacelle, "hub": hub, "beacon": beacon}[part]
		var mi := _multi(mesh, parts[part])
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF if part == "beacon" else GeometryInstance3D.SHADOW_CASTING_SETTING_ON
	_blades = MultiMesh.new()
	_blades.transform_format = MultiMesh.TRANSFORM_3D
	_blades.mesh = blade
	_blades.instance_count = _hubs.size() * 3
	var bi := MultiMeshInstance3D.new()
	bi.multimesh = _blades
	bi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	world.add_child(bi)
	_turbines_tick()
	_tally("turbines", _hubs.size())

## the blades round (about 13 turns a minute) and the beacons on for half of every 1.5 s
func _turbines_tick() -> void:
	var t := Time.get_ticks_msec() * 0.001
	for i in range(_hubs.size()):
		var h: Array = _hubs[i]
		var f3: Vector3 = h[1]
		var side := Vector3.UP.cross(f3).normalized()
		for k in range(3):
			var a := t * 1.35 + float(h[2]) + float(k) * TAU / 3.0
			var along := Vector3.UP * cos(a) + side * sin(a)   # the blade's length, in the rotor's plane
			var across := Vector3.UP * -sin(a) + side * cos(a)
			_blades.set_instance_transform(i * 3 + k, Transform3D(Basis(across, along, f3), (h[0] as Vector3) + along * (BLADE_L * 0.5 + 0.9)))
	var lit := fmod(t, 1.5) < 0.5
	if lit != _turbine_light.emission_enabled:
		_turbine_light.emission_enabled = lit
		_turbine_light.albedo_color = (Palette.col("hazard").lerp(Color.RED, 0.6)) * (1.0 if lit else 0.35)

## the highest ground inside the town's boundary (its hill): the mountains are what rises
## above it, whatever the town's own hill looks like
func _town_top() -> float:
	var top := 0.0
	for j in range(0, _hnz, 2):
		for i in range(0, _hnx, 2):
			var p := Vector2(_hx0 + i * _hstep, _hz0 + j * _hstep)
			if _in_city(p):
				top = maxf(top, _hgrid[j * _hnx + i])
	return top

func _build_terrain() -> void:
	var verts := PackedVector3Array()
	var norms := PackedVector3Array()
	var idx := PackedInt32Array()
	for j in range(_hnz):
		for i in range(_hnx):
			var h := _hgrid[j * _hnx + i]
			verts.append(Vector3(_hx0 + i * _hstep, h, _hz0 + j * _hstep))
			var hl := _hgrid[j * _hnx + maxi(i - 1, 0)]
			var hr := _hgrid[j * _hnx + mini(i + 1, _hnx - 1)]
			var hu := _hgrid[maxi(j - 1, 0) * _hnx + i]
			var hd := _hgrid[mini(j + 1, _hnz - 1) * _hnx + i]
			norms.append(Vector3(hl - hr, 2.0 * _hstep, hu - hd).normalized())
	# in blocks about CHUNK across, each its own mesh, so the ground behind the camera and
	# far off is not drawn (the flat plane under it takes over in the haze)
	var blk := maxi(2, int(CHUNK / _hstep))
	for bj in range(0, _hnz - 1, blk):
		for bi in range(0, _hnx - 1, blk):
			var j1 := mini(bj + blk, _hnz - 1)
			var i1 := mini(bi + blk, _hnx - 1)
			var w := i1 - bi + 1
			var bv := PackedVector3Array()
			var bn := PackedVector3Array()
			for j in range(bj, j1 + 1):
				for i in range(bi, i1 + 1):
					bv.append(verts[j * _hnx + i])
					bn.append(norms[j * _hnx + i])
			idx = PackedInt32Array()
			var holes := _decks.any() and not _decks.holes.is_empty()
			var bbox := Rect2(_hx0 + bi * _hstep, _hz0 + bj * _hstep, (i1 - bi) * _hstep, (j1 - bj) * _hstep)
			if holes:
				holes = false
				for hb: Rect2 in _decks.hole_boxes:
					holes = holes or hb.intersects(bbox)
			for j in range(j1 - bj):
				for i in range(i1 - bi):
					var a := j * w + i
					if not holes:
						idx.append_array(PackedInt32Array([a, a + 1, a + w, a + 1, a + w + 1, a + w]))
						continue
					# over a cutting the ground is cut away (decks.gd): a triangle that reaches
					# one is clipped round it
					for t: PackedInt32Array in [PackedInt32Array([a, a + 1, a + w]), PackedInt32Array([a + 1, a + w + 1, a + w])]:
						var pieces: Array = _decks.cut_tri([bv[t[0]], bv[t[1]], bv[t[2]]], [bn[t[0]], bn[t[1]], bn[t[2]]])
						if pieces.size() == 1 and (pieces[0][0] as Array)[0] == bv[t[0]] and (pieces[0][0] as Array)[1] == bv[t[1]]:
							idx.append_array(t)
							continue
						for pc: Array in pieces:
							for m in range(3):
								idx.append(bv.size())
								bv.append(pc[0][m])
								bn.append(pc[1][m])
			var arr := []
			arr.resize(Mesh.ARRAY_MAX)
			arr[Mesh.ARRAY_VERTEX] = bv
			arr[Mesh.ARRAY_NORMAL] = bn
			arr[Mesh.ARRAY_INDEX] = idx
			var am := ArrayMesh.new()
			am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
			am.surface_set_material(0, _ground_mat())
			var mi := MeshInstance3D.new()
			mi.mesh = am
			mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			mi.visibility_range_end = VIEW_RANGE + blk * _hstep * 0.71 + 300.0
			world.add_child(mi)

## A footpath in town -- a passage between blocks, steps, a pedestrian street -- is paved
## like the pavements; in a park, a wood or on grass it stays a path. (A walk filmed in
## Givatayim: its passages are pavers between garden walls, not trails through a lawn.)
const PAVED_WALKS := {"footway": true, "pedestrian": true, "steps": true}

func _paved_walk(r: Dictionary) -> bool:
	if r.has("_paved"):
		return r["_paved"]
	var paved := PAVED_WALKS.has(r["k"])
	if paved:
		var pts: PackedVector2Array = r["pts"]
		var mid := pts[pts.size() / 2].lerp(pts[(pts.size() - 1) / 2], 0.5)
		for kind: String in ["park", "grass", "wood"]:
			for ring: PackedVector2Array in _area_rings.get(kind, []):
				if _bld_box_of(ring).has_point(mid) and Geometry2D.is_point_in_polygon(mid, ring):
					paved = false
					break
	r["_paved"] = paved   # each square asks again: worked out once a road
	return paved

func _surface(tone: String) -> StandardMaterial3D:
	if _smat.has(tone):
		return _smat[tone]
	var m := StandardMaterial3D.new()
	m.roughness = 0.95
	m.metallic_specular = 0.25
	m.albedo_color = _tone.get(tone, Palette.col("warn"))
	_smat[tone] = m
	return m

## a Buf as mesh(es): one per square for a CBuf, each drawn while the camera is within
## `seen` metres of it (0: always)
func _add_mesh(buf: Buf, m: Material, shadows: bool, seen := 0.0) -> Array:
	if _batching and not buf.empty():
		var how := _merge_as(m)
		if not how.is_empty():
			_batch_buf(buf, m, how, shadows, seen)
			return []
	var made: Array = []
	var parts := buf.parts()
	var half := (buf as CBuf).cell * 0.71 if buf is CBuf else 0.0
	for key: Vector2i in parts:
		var part: Buf = parts[key]
		if part.empty():
			continue
		var am := ArrayMesh.new()
		am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, part.arrays())
		am.surface_set_material(0, m)
		var mi := MeshInstance3D.new()
		mi.mesh = am
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON if shadows else GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		if seen > 0.0:   # the range counts to the middle of the square, so add half of it
			mi.visibility_range_end = seen + half
			mi.visibility_range_end_margin = 40.0
		world.add_child(mi)
		made.append(mi)
	return made

## a polygon on the ground
func _fill(buf: Buf, ring: PackedVector2Array, y: float, level := false, flat := INF) -> void:
	var idx := Geometry2D.triangulate_polygon(ring)
	var flat_y := flat
	if level and flat_y == INF:   # water lies flat, at its shore's lowest point
		for p in ring:
			flat_y = minf(flat_y, _h(p))
	var stack: Array = []
	for i in range(0, idx.size(), 3):
		stack.append([ring[idx[i]], ring[idx[i + 1]], ring[idx[i + 2]]])
	# on hills, split triangles until they are small enough to follow the ground
	var most := _hstep * 0.8 if _hnx > 0 and not level else INF
	var n := 0
	while not stack.is_empty():
		n += 1
		if n % 256 == 0 and _over():   # (a lawn on a hillside is thousands of little triangles)
			await _pause()
		var t: Array = stack.pop_back()
		var a: Vector2 = t[0]
		var b: Vector2 = t[1]
		var d: Vector2 = t[2]
		var ab := a.distance_squared_to(b)
		var bd := b.distance_squared_to(d)
		var da := d.distance_squared_to(a)
		var longest := maxf(ab, maxf(bd, da))
		if longest > most * most and stack.size() < 200000:
			if longest == ab:
				var m := (a + b) * 0.5
				stack.append([a, m, d])
				stack.append([m, b, d])
			elif longest == bd:
				var m := (b + d) * 0.5
				stack.append([a, b, m])
				stack.append([a, m, d])
			else:
				var m := (d + a) * 0.5
				stack.append([a, b, m])
				stack.append([m, b, d])
			continue
		if level:
			var lift := y + (0.07 if _hnx > 0 else 0.0)
			buf.tri(Vector3(a.x, flat_y + lift, a.y), Vector3(b.x, flat_y + lift, b.y),
				Vector3(d.x, flat_y + lift, d.y), Vector3.UP, Color.WHITE)
		else:
			var pa := _g3(a, y)
			var pb := _g3(b, y)
			var pd := _g3(d, y)
			var nrm := (pb - pa).cross(pd - pa)
			if nrm.y < 0.0:
				nrm = -nrm
			buf.tri(pa, pb, pd, nrm.normalized() if nrm.length_squared() > 0.0 else Vector3.UP, Color.WHITE)

## Kerbs, pavements and front gardens along the streets. Kerbs are painted the Israeli
## way on some streets (red-white: no stopping, blue-white: paid parking, yellow-black:
## buses) by a shader, so a painted kerb costs no more than a plain one. Front gardens --
## a low stone wall behind the pavement, then a strip of garden with bushes -- go along
## residential streets. Everything stops short of junctions so the corners stay open.
const KERB_SHADER := """
shader_type spatial;
uniform vec4 plain : source_color;
uniform vec4 white : source_color;
uniform vec4 red : source_color;
uniform vec4 blue : source_color;
uniform vec4 yellow : source_color;
uniform vec4 black : source_color;
uniform float textured = 1.0;
uniform sampler2D conc : filter_linear_mipmap_anisotropic, repeat_enable;   // concrete grain
uniform vec3 conc_mean = vec3(0.5);
uniform vec4 pave : source_color;      // the pavement's tone: its pavers are mixed from it
uniform float med = 1.0;               // Israeli streets (else Bedford's poured slabs)
uniform vec4 iron : source_color;      // cast iron: the covers in the paving
varying vec3 wpos;
varying float wup;
void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wup = (MODEL_MATRIX * vec4(NORMAL, 0.0)).y;
}
float h21(vec2 p) {
	vec3 q = fract(vec3(p.xyx) * 0.1031);
	q += dot(q, q.yzx + 33.33);
	return fract((q.x + q.y) * q.z);
}
// One paver under point g (metres: x along the street, y out from the kerb): (distance to
// its nearest joint in metres, the paver's own cell for its colour).
vec3 paver(vec2 g, float pattern) {
	if (pattern < 0.5) {
		// herringbone, 20 x 10 cm, at 45 degrees to the kerb: in brick widths, cell (cx, cy) is
		// the left or right half of a lying brick or the lower or upper half of a standing one,
		// by (cx - cy) and (cx + cy): the staircases of the pattern run along the diagonal
		vec2 r = vec2(g.x + g.y, g.y - g.x) * 0.70710678 / 0.1;
		vec2 c = floor(r);
		vec2 f = r - c;
		float s = mod(c.x + c.y, 4.0);
		vec4 e;   // joints on this cell's (left, right, bottom, top)
		vec2 id = c;
		if (mod(c.x - c.y, 2.0) < 0.5) {
			e = s < 1.0 ? vec4(1.0, 0.0, 1.0, 1.0) : vec4(1.0, 1.0, 1.0, 0.0);
		} else if (s < 2.0) {
			e = vec4(0.0, 1.0, 1.0, 1.0);
			id = c - vec2(1.0, 0.0);
		} else {
			e = vec4(1.0, 1.0, 0.0, 1.0);
			id = c - vec2(0.0, 1.0);
		}
		float jd = min(min(mix(9.0, f.x, e.x), mix(9.0, 1.0 - f.x, e.y)), min(mix(9.0, f.y, e.z), mix(9.0, 1.0 - f.y, e.w)));
		return vec3(jd * 0.1, id);
	}
	vec2 size = pattern < 1.5 ? vec2(0.2, 0.1) : (pattern < 2.5 ? vec2(0.4, 0.4) : vec2(1.5, 1.2));
	vec2 r = g / size;
	if (pattern < 1.5) {
		r.x += mod(floor(r.y), 2.0) * 0.5;   // stretcher bond: every other row half a brick on
	}
	vec2 c = floor(r);
	vec2 f = r - c;
	vec2 d = min(f, 1.0 - f) * size;
	return vec3(min(d.x, d.y), c);
}
void fragment() {
	float fsh = far_shade(wpos, length(VERTEX));   // (before the branches: a texture read)
	float soak = wet * smoothstep(0.6, 0.8, wup);   // after rain: darker, glossy, the sky in it
	vec3 wet_emit = wet > 0.001 ? wet_mirror(normalize((INV_VIEW_MATRIX * vec4(VERTEX, 0.0)).xyz)) * soak * 0.05 : vec3(0.0);
	if (COLOR.b > 0.5) {
		// The pavement: pavers in the street's own pattern and colours (COLOR.r: pattern x 4 +
		// colours), laid square to the kerb (UV: metres along, out from the kerb), a row of
		// them on end along the kerb; fallen leaves under the trees (COLOR.g: how many trees)
		float code = floor(COLOR.r * 16.0);
		float pattern = floor(code / 4.0);
		float mixk = code - pattern * 4.0;
		vec2 g = UV;
		bool border = pattern < 1.5 && g.y < 0.2;
		vec3 pv = border ? paver(vec2(g.x, g.y) * vec2(2.0, 0.5), 1.0) * vec3(0.5, 1.0, 1.0) : paver(g, pattern);
		float h = h21(pv.yz + (border ? 71.3 : 0.0));
		float h2 = h21(pv.yz + 13.7);
		vec3 base = pave.rgb;
		vec3 col;
		if (mixk < 0.5) {          // reds and browns, mixed: muted, as filmed (they were red over green
			// 1.2-1.35 on screen and bright against the film's 1.10 on Sirkin; DEV.md "walk 2's paving")
			vec3 a = base * vec3(0.93, 0.77, 0.69);
			vec3 b = base * vec3(0.85, 0.75, 0.68);
			vec3 cc = base * vec3(0.78, 0.74, 0.72);
			col = h < 0.4 ? a : (h < 0.75 ? b : cc);
		} else if (mixk < 1.5) {   // greys, a darker one here and there
			col = base * (h < 0.15 ? 0.84 : (h < 0.55 ? 0.95 : 1.03));
		} else if (mixk < 2.5) {   // pale sand
			col = base * vec3(1.16, 1.1, 0.96) * (0.94 + 0.08 * h);
		} else {                   // a mix of all of them
			col = h < 0.3 ? base * vec3(1.3, 0.92, 0.8) : (h < 0.5 ? base * vec3(1.1, 0.95, 0.75) : (h < 0.8 ? base * 0.95 : base * vec3(1.05, 0.9, 0.95)));
		}
		if (border) {
			col = base * 0.86;
		}
		col *= 0.92 + 0.12 * h2;
		// further off than a few pixels a paver, the pattern is its average colour
		float fw = length(fwidth(g));
		float far = smoothstep(0.012, 0.05, fw);
		vec3 avg = mixk < 0.5 ? base * vec3(0.86, 0.75, 0.69) : (mixk < 1.5 ? base * 0.93 : (mixk < 2.5 ? base * vec3(1.16, 1.1, 0.96) : base * vec3(1.12, 0.92, 0.84)));
		col = mix(col, avg, far);
		// the joints, sand-filled and dark, and each paver's bevelled edge
		float jw = 0.004;
		float joint = 1.0 - smoothstep(jw, jw + max(fw, 0.0015), pv.x);
		float bevel = smoothstep(jw, jw + 0.012, pv.x);
		col *= mix(1.0, mix(1.0, 0.66, joint) * mix(0.93, 1.0, bevel), 1.0 - far);
		// Covers let into the paving, as a walk finds them every few dozen metres: water, phone,
		// power -- a square concrete frame round a round iron lid, or a square iron plate with
		// a raised grid. One in a 19 m stretch of pavement, two in five stretches, somewhere
		// across it (UV: metres along and out from the kerb). A pavement too narrow for one
		// has none.
		float pw_here = COLOR.a < 0.65 ? COLOR.a * 4.0 : (COLOR.a < 0.99 ? (COLOR.a - 0.7) * 40.0 : 2.4);
		float cell = floor(g.x / 19.0);
		if (h21(vec2(cell, 3.7)) < 0.4 && pw_here > 1.3) {
			float half_s = h21(vec2(cell, 5.1)) < 0.6 ? 0.36 : 0.28;
			vec2 cc = vec2((cell + 0.15 + 0.7 * h21(vec2(cell, 1.3))) * 19.0,
				mix(0.45 + half_s, pw_here - 0.25 - half_s, h21(vec2(cell, 2.9))));
			vec2 q = g - cc;
			vec2 aq = abs(q);
			float box = max(aq.x, aq.y);
			float aa = max(fw, 0.002);
			if (box < half_s + 0.01) {
				float edge = smoothstep(half_s - aa, half_s, box);   // (into the pavers at the rim)
				vec3 ir = iron.rgb * (0.85 + 0.3 * h21(floor(wpos.xz / 0.07)));
				vec3 cv;
				if (half_s > 0.3) {   // a round lid in a square concrete frame
					float r = length(q);
					vec3 frame = pave.rgb * 0.82 * (0.9 + 0.2 * h21(floor(wpos.xz / 0.05)));
					float rings = smoothstep(0.35, 0.65, abs(fract(r * 18.0) - 0.5) * 2.0);
					vec3 lid = ir * mix(0.85, 1.12, rings);
					float in_lid = 1.0 - smoothstep(half_s - 0.07 - aa, half_s - 0.07, r);
					float rim = 1.0 - smoothstep(0.012, 0.012 + aa, abs(r - (half_s - 0.07)));
					cv = mix(frame, lid, in_lid);
					cv *= 1.0 - 0.45 * rim;
				} else {   // a square plate with a raised grid, an iron frame round it
					vec2 gq = abs(fract(q * 14.0) - 0.5);
					float grid = smoothstep(0.3, 0.42, max(gq.x, gq.y));
					cv = ir * mix(0.9, 1.15, grid);
					cv *= 1.0 - 0.35 * (1.0 - smoothstep(0.008, 0.008 + aa, half_s - 0.03 - box));
				}
				col = mix(col, cv, (1.0 - edge) * (1.0 - far * 0.5));
			}
		}
		if (COLOR.a < 0.65) {   // a garden wall at the back (COLOR.a: how far back / 4): darker at its foot
			float back = COLOR.a * 4.0;
			float k = smoothstep(back - 0.6, back, UV.y);
			col *= 1.0 - 0.36 * k * k;
		}
		// the grime of a street: wide soft stains, darker where feet and wheels go
		float st = h21(floor(wpos.xz / 2.3)) * 0.5 + h21(floor(wpos.xz / 0.9) + 4.1) * 0.5;
		col *= 0.9 + 0.1 * smoothstep(0.2, 0.8, st);
		if (textured > 0.5) {
			vec3 t = texture(conc, wpos.xz * 0.9).rgb;
			col *= mix(1.0, clamp(dot(t, vec3(0.333)) / dot(conc_mean, vec3(0.333)), 0.0, 2.0), 0.6);
		}
		// leaves: one in some 18 cm squares, more under the trees, yellow to brown, and in
		// Givatayim the odd bougainvillea petal
		float leafy = COLOR.g;
		vec2 lc = floor(wpos.xz / 0.18);
		float lh = h21(lc);
		if (leafy > 0.01 && lh < leafy * 0.3 && far < 0.99) {
			vec2 lp = fract(wpos.xz / 0.18) - 0.5 + (vec2(h21(lc + 3.1), h21(lc + 5.7)) - 0.5) * 0.4;
			float an = h21(lc + 9.2) * 6.2832;
			lp = vec2(lp.x * cos(an) - lp.y * sin(an), lp.x * sin(an) + lp.y * cos(an));
			float m = 1.0 - smoothstep(0.13, 0.17, length(lp * vec2(1.0, 2.3)));
			float k = h21(lc + 1.7);
			vec3 leaf = mix(vec3(0.62, 0.52, 0.18), vec3(0.42, 0.3, 0.16), k);
			if (med > 0.5 && k > 0.88) {
				leaf = vec3(0.72, 0.16, 0.42);
			}
			col = mix(col, leaf, m * (1.0 - far));
		}
		ALBEDO = col * fsh * mix(1.0, 0.55, soak);
		ROUGHNESS = mix(0.9, 0.7, soak);
		SPECULAR = mix(0.5, 0.3, soak);
		EMISSION = wet_emit;
	} else {   // the kerb
	float pat = floor(COLOR.r * 3.99 + 0.01);
	float stripe = step(0.5, fract(UV.x * 0.5));
	vec3 c = plain.rgb;
	if (pat > 0.5 && pat < 1.5) { c = mix(red.rgb, white.rgb, stripe); }
	else if (pat > 1.5 && pat < 2.5) { c = mix(blue.rgb, white.rgb, stripe); }
	else if (pat > 2.5) { c = mix(yellow.rgb, black.rgb, stripe); }
	if (textured > 0.5) {
		// concrete grain through the paint (laid from above on the top, along on the face),
		// and the face's foot darker: road dirt thrown up against it
		vec2 uv = wup > 0.5 ? wpos.xz : vec2(UV.x, wpos.y);
		vec3 t = texture(conc, uv * 0.8).rgb;
		c *= mix(1.0, clamp(dot(t, vec3(0.333)) / dot(conc_mean, vec3(0.333)), 0.0, 2.0), 0.7);
		if (wup < 0.5) {
			c *= mix(0.7, 1.0, UV.y);
		}
	}
	ALBEDO = c * mix(1.0, fsh, step(0.7, wup)) * mix(1.0, 0.62, wet);
	ROUGHNESS = mix(0.85, 0.7, wet);
	SPECULAR = mix(0.5, 0.3, wet);
	EMISSION = wet_emit;
	}
}
"""

## Flat roofs: tar and gravel -- the asphalt's grit, finer -- with dried-puddle stains
const ROOF_SHADER := """
shader_type spatial;
uniform vec4 tone : source_color;
uniform float textured = 1.0;
uniform sampler2D grit : filter_linear_mipmap_anisotropic, repeat_enable;
uniform vec3 grit_mean = vec3(0.5);
varying vec3 wpos;
float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }
float noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
}
void vertex() { wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz; }
void fragment() {
	vec3 c = tone.rgb * COLOR.rgb;
	if (textured > 0.5) {
		vec3 t = texture(grit, wpos.xz / 1.4).rgb;
		c *= mix(1.0, clamp(dot(t, vec3(0.333)) / dot(grit_mean, vec3(0.333)), 0.0, 2.0), 0.55);
		c *= 1.0 - 0.18 * smoothstep(0.55, 0.85, noise(wpos.xz / 2.3));
	}
	ALBEDO = c;
	ROUGHNESS = 0.92;
}
"""
var _roof_mat: ShaderMaterial
const PAVE_W := 2.4                  ## pavement width (m)
const KERB_CUT := 4.5                ## kerbs stop this far past a junction's road edge: the corner's radius
const SHOP_PAVE := 1.8               ## the pavement this much wider in front of shops (under the building where it stands closer)
## Israeli kerb paint goes by where on the street, as a filmed walk showed: blue-white along
## a residential street's parking (paid), red-white for the last metres before every
## junction (no parking within 12 m of one: the kerb starts KERB_CUT past the corner) and on
## many main roads all along, yellow-black only in front of a bus stop. Not one paint a street.
const KERB_RED := 9.0
const KERB_BUS := 9.0                ## yellow-black this far either side of a bus stop
const KERB_RED_KINDS := ["residential", "unclassified", "tertiary", "secondary", "primary",
	"tertiary_link", "secondary_link", "primary_link"]
var _stops_by_road := {}             ## road -> its bus stops' spots on the pavement (for the kerb paint)
var _stops_mapped := false

## A shop opens onto the pavement: no front garden in front of one. A filmed street that OSM
## calls residential had shops down both sides where the game laid low walls and hedges --
## and, between them, one real front garden behind a low white fence, so this goes piece by
## piece, not by the street: a piece of a run's side is a shop's where OSM has a shop, cafe
## or the like behind it within 6 m along, or where a hand-placed row of shop fronts
## (details.gd lines, kind shopfront) runs behind it.
const SHOP_FRONT_KINDS := ["cafe", "restaurant", "fast_food", "bar", "pub", "ice_cream", "pharmacy", "bank",
	"bakery", "hairdresser", "post_office"]
var _shop_pts := PackedVector2Array()
var _shop_hash := {}
var _shop_rows: Array = []             ## [a, e]: hand-placed shop fronts (details.gd)
var _shops_mapped := false

## per piece of `run` (one byte per point, the piece from it to the next), 1 where shops
## stand behind side `sgn`
func _shop_pieces(run: PackedVector2Array, hw: float, sgn: float) -> PackedByteArray:
	if not _shops_mapped:
		_shops_mapped = true
		var k := 1.0 / float(_city_data.get("scale", 10))
		for p: Array in _city_data.get("pois", []):
			var kind := String(p[2])
			if (kind.begins_with("shop") and not kind in ["shop:vacant", "shop:disused", "shop:no"]) or kind in SHOP_FRONT_KINDS:
				var q := Vector2(p[0], p[1]) * k
				_hash_add(_shop_hash, Rect2(q, Vector2.ZERO), BLD_CELL, _shop_pts.size())
				_shop_pts.append(q)
		if _details != null:
			for ln: Dictionary in _details.data.get("lines", []):
				if String(ln.get("kind", "")) == "shopfront":
					var pts: Array = ln["pts"]
					for i in range(pts.size() - 1):
						_shop_rows.append([Vector2(pts[i][0], pts[i][1]), Vector2(pts[i + 1][0], pts[i + 1][1])])
	var out := PackedByteArray()
	out.resize(run.size())
	var reach := hw + PAVE_W + 14.0
	for i in range(run.size() - 1):
		var a := run[i]
		var b := run[i + 1]
		var seg := a.distance_to(b)
		if seg < 0.01:
			continue
		var t := (b - a) / seg
		var side := Vector2(-t.y, t.x) * sgn   # (the side _offset_line puts a positive offset)
		for j: int in _near(_shop_hash, (a + b) * 0.5, seg * 0.5 + reach, BLD_CELL):
			var q := _shop_pts[j] - a
			var along := q.dot(t)
			if along > -6.0 and along < seg + 6.0 and q.dot(side) > 0.5 and q.dot(side) < reach:
				out[i] = 1
		for row: Array in _shop_rows:
			var ra: Vector2 = row[0] - a
			var re: Vector2 = row[1] - a
			var lo := minf(ra.dot(t), re.dot(t))
			var hi := maxf(ra.dot(t), re.dot(t))
			var off := (ra.dot(side) + re.dot(side)) * 0.5
			if hi > 0.5 and lo < seg - 0.5 and off > 0.5 and off < reach:
				out[i] = 1
	return out

## ---- passages between the blocks ----------------------------------------------------------
## A footway between two blocks is, as a walk finds it, a narrow paved way between the yards'
## walls: rendered and capped, or rough stone, 1-1.5 m high, now and then boards on top of
## one side, now and then a row of bike hoops along one wall near an end. Its walls stop a
## few metres short of the streets at its ends and wherever a building stands at its edge.
## Laid like the garden walls (_garden_wall, CBuf.clip), a passage at a time.
var passages: Array = []   # [middle, along] of each walled one (for tests; once per square it crosses)

func _build_passages() -> void:
	if String(_place.get("look", "")) != "med":
		return
	var fronts := {"plaster": _clip_buf(GROUND_CELL), "coping": _clip_buf(GROUND_CELL), "planks": _clip_buf(GROUND_CELL)}
	var wall := _clip_buf(GROUND_CELL)
	var hoops: Array = []
	var near := _tile_rect(_tile).grow(4.0)
	for ri: int in _tile_roads.get(_tile, []):
		var r: Dictionary = _roads[ri]
		if r["drive"] or r["k"] != "footway" or not _paved_walk(r):
			continue
		var pts: PackedVector2Array = r["pts"]
		var cum := PackedFloat32Array([0.0])
		for i in range(1, pts.size()):
			cum.append(cum[i - 1] + pts[i - 1].distance_to(pts[i]))
		var total := cum[cum.size() - 1]
		if total < 12.0 or total > 250.0 or not near.intersects(_bld_box_of(pts).grow(3.0)):
			continue
		# between buildings: one within 12 m on each side, half way along
		var mid := _along(pts, cum, total * 0.5)
		var md := (_along(pts, cum, minf(total * 0.5 + 1.0, total)) - mid).normalized()
		var sides := [false, false]
		for bi: int in _near(_bld_hash, mid, 12.0, BLD_CELL):
			var c := (_bld_box[bi] as Rect2).get_center()
			sides[0 if Vector2(-md.y, md.x).dot(c - mid) > 0.0 else 1] = true
		if not (sides[0] and sides[1]):
			continue
		if _over():
			await _pause()
		var hsh := posmod(_hash_i(pts[0] + pts[pts.size() - 1]), 1000003)
		var hw := maxf(float(r["w"]) * 0.5, 0.9)
		passages.append([mid, md])
		for sgn: float in [-1.0, 1.0]:
			var lines := {"in": _offset_line(pts, (hw + 0.05) * sgn), "out": _offset_line(pts, (hw + 0.3) * sgn),
				"c_in": _offset_line(pts, (hw + 0.02) * sgn), "c_out": _offset_line(pts, (hw + 0.33) * sgn)}
			var walled := PackedByteArray()
			walled.resize(pts.size())
			for i in range(pts.size() - 1):
				var q: Vector2 = ((lines["in"] as PackedVector2Array)[i] + (lines["in"] as PackedVector2Array)[i + 1]) * 0.5
				var q2: Vector2 = ((lines["out"] as PackedVector2Array)[i] + (lines["out"] as PackedVector2Array)[i + 1]) * 0.5
				walled[i] = 1 if (_off_road(q, 1.0) and _push_out(q2, 0.3, false) == Vector2.ZERO) else 0
				# along all of the piece, not its middle alone: a long piece of a footway that
				# crosses or ends in a street was clear at its middle and walled right through
				# the street (city_check: 318 walls on Givatayim's roads, up to 6 m in)
				if walled[i]:
					var a_in: Vector2 = (lines["in"] as PackedVector2Array)[i]
					var b_in: Vector2 = (lines["in"] as PackedVector2Array)[i + 1]
					var steps := maxi(1, int(ceil(a_in.distance_to(b_in) / 2.0)))
					for k in range(steps + 1):
						if not _off_road(a_in.lerp(b_in, float(k) / steps), 0.3):
							walled[i] = 0
							break
			var plaster := (hsh + int(sgn > 0.0)) % 10 < 6
			var wh := (1.05 + 0.45 * float((hsh / 10) % 10) / 9.0) if plaster else 0.8
			_garden_wall(fronts, wall, lines, cum, walled, 3.0, total - 3.0, wh, plaster, sgn)
			if sgn > 0.0 and (hsh / 100) % 4 == 0:   # boards on top of one side
				var on: PackedVector2Array = _offset_line(pts, (hw + 0.175) * sgn)
				for i in range(pts.size() - 1):
					if walled[i] and cum[i] > 3.0 and cum[i + 1] < total - 3.0:
						_plank_fence(fronts["planks"], on[i], on[i + 1], wh + (0.06 if plaster else 0.0), 0.9)
			if sgn < 0.0 and (hsh / 1000) % 10 < 3:   # a row of bike hoops near one end
				var s0 := 4.0 if (hsh / 10000) % 2 == 0 else total - 9.0
				for k in range(6):
					var s := s0 + 0.8 * k
					var j := _seg_at(cum, s)
					if s < 3.0 or s > total - 3.0 or not walled[j]:
						continue
					var a := _along(pts, cum, s)
					var d := (_along(pts, cum, minf(s + 0.5, total)) - a).normalized()
					var out := Vector2(-d.y, d.x) * sgn   # toward the wall
					var hp := a + out * (hw - 0.4)
					if _mine(hp) and _add_post(hp, 0.3, true):   # (two passages side by side: one hoop)
						hoops.append(Transform3D(Basis(Vector3.UP, atan2(-out.y, out.x)), Vector3(hp.x, _h(hp), hp.y)))
	_add_mesh(wall, _surface("stonewall"), false, DETAIL_RANGE)
	_add_mesh(fronts["plaster"], _surface("gardenwall"), false, DETAIL_RANGE)
	_add_mesh(fronts["coping"], _surface("coping"), false, DETAIL_RANGE)
	_add_mesh(fronts["planks"], _vc_mat(), true, DETAIL_RANGE * 0.8)
	if not hoops.is_empty():
		await _furn._place(_furn._rack_kit(), hoops, _furn.NEAR_SEEN, "passage_hoops")

## the paint along the middle of a street's kerb (0 plain, 1 red-white, 2 blue-white)
func _kerb_paint(r: Dictionary, hsh: int) -> int:
	if r.has("kerb_mid"):
		return int(r["kerb_mid"])   # as filmed (details.gd)
	var h := posmod(hsh / 7, 10)
	match String(r["k"]):
		"residential", "unclassified":
			return [2, 2, 2, 2, 2, 2, 0, 0, 0, 1][h]
		"tertiary", "secondary", "tertiary_link", "secondary_link":
			return [2, 2, 2, 2, 1, 1, 1, 0, 0, 0][h]
		"primary", "primary_link", "trunk":
			return [1, 1, 1, 1, 1, 1, 1, 0, 0, 2][h]
	return 0

## the bus stops along road ri, where _build_stops puts their shelters
func _kerb_stops(ri: int) -> PackedVector2Array:
	if not _stops_mapped:
		_stops_mapped = true
		var k := 1.0 / float(_city_data.get("scale", 10))
		for st: Array in _city_data.get("stops", []):
			var at := Vector2(st[0], st[1]) * k
			var hit := _nearest_seg(at, 30.0, true, true)
			if hit.is_empty():
				continue
			var q: Vector2 = hit["q"]
			var out := (at - q).normalized()
			if out == Vector2.ZERO:
				continue
			var c := q + out * (float(_roads[hit["road"]]["w"]) * 0.5 + 1.9)
			if not _stops_by_road.has(hit["road"]):
				_stops_by_road[hit["road"]] = PackedVector2Array()
			(_stops_by_road[hit["road"]] as PackedVector2Array).append(c)
	return _stops_by_road.get(ri, PackedVector2Array())

## a run's end p meets a junction (rather than the next OSM piece of the same street)
func _kerb_junction_end(r: Dictionary, p: Vector2) -> bool:
	var pts: PackedVector2Array = r["pts"]
	var ids: PackedInt32Array = r["ids"]
	for i in range(ids.size()):
		if pts[i].distance_to(p) < _node_r[ids[i]] + KERB_CUT + 1.5 and _kerb_arms(ids[i]) >= 3:
			return true
	return false

## where one kerb's paint changes: Vector3(from, to, paint) in metres along `run`'s middle,
## later ones over earlier ones. `inner` is the kerb's line on side `sgn`.
func _kerb_marks(r: Dictionary, run: PackedVector2Array, inner: PackedVector2Array, red_ends: bool,
		stops: PackedVector2Array) -> Array:
	var marks: Array = []
	var total := 0.0
	for i in range(run.size() - 1):
		total += run[i].distance_to(run[i + 1])
	if red_ends:
		if _kerb_junction_end(r, run[0]):
			marks.append(Vector3(-1.0, KERB_RED, 1))
		if _kerb_junction_end(r, run[run.size() - 1]):
			marks.append(Vector3(total - KERB_RED, total + 1.0, 1))
	for c: Vector2 in stops:
		var best := INF
		var s_at := 0.0
		var s := 0.0
		for i in range(run.size() - 1):
			var q := Geometry2D.get_closest_point_to_segment(c, inner[i], inner[i + 1])
			var d := q.distance_to(c)
			var seg := run[i].distance_to(run[i + 1])
			if d < best:
				best = d
				s_at = s + seg * clampf(inner[i].distance_to(q) / maxf(inner[i].distance_to(inner[i + 1]), 0.01), 0.0, 1.0)
			s += seg
		if best < 3.5:   # this side's kerb (the other is a road's width further)
			marks.append(Vector3(s_at - KERB_BUS, s_at + KERB_BUS, 3))
	return marks
const KERB_H := 0.14
const KERB_W := 0.2
var _kerb_mat: ShaderMaterial

func _build_kerbs() -> void:
	var kerb := _clip_buf(GROUND_CELL)
	var pave := kerb   # (the pavement is drawn by the kerb's shader, in the kerb's mesh: no extra draw)
	var wall := _clip_buf(GROUND_CELL)
	var garden := _clip_buf(GROUND_CELL)
	var fronts := _new_fronts()
	var bushes: Array = []
	var med := String(_place.get("look", "")) == "med"
	_laid = {}
	for ri: int in _tile_roads.get(_tile, []):
		var r: Dictionary = _roads[ri]
		if not _kerbed(r):
			continue   # motorways and their slip roads have no pavement
		if _over():
			await _pause()
		var hw: float = float(r["w"]) * 0.5
		var hsh := _hash_i((r["pts"] as PackedVector2Array)[0])
		_set_pave_code(hsh, r.get("pave", []))
		# the paint along the middle of the street, and whether its ends are red-white
		# (_kerb_paint); a kerb set by hand (details.gd) is that paint all along
		var pat := _kerb_paint(r, hsh) if med else 0
		var red_ends := med and not r.has("kerb") and String(r["k"]) in KERB_RED_KINDS
		if r.has("kerb"):
			pat = int(r["kerb"])   # (as filmed: 0 plain, 1 red-white, 2 blue-white, 3 yellow-black)
		var stops := _kerb_stops(ri) if med and not r.has("kerb") else PackedVector2Array()
		var yard: bool = r["k"] in ["residential", "living_street"] and bool(r.get("yard", true))
		var dual := r.has("median")
		var inner_sgn := -float(r["o"])   # a divided road's other half is on the left of its traffic
		for run: PackedVector2Array in _street_runs(r, KERB_CUT, true):
			if not _tile_rect(_tile).grow(hw + PAVE_W + 6.0).intersects(_bld_box_of(run)):
				continue   # a stretch nowhere near this square
			if _over():
				await _pause()
			for sgn: float in [-1.0, 1.0]:
				_laid_by = ri * 4 + (0 if sgn < 0.0 else 1)
				var inner_side := dual and sgn == inner_sgn
				var pw := PAVE_W
				if inner_side:
					var m: float = r["median"]
					if m < 0.25:
						continue   # the halves touch: a painted line, no kerb
					pw = clampf(m * 0.5 - KERB_W, 0.0, PAVE_W)   # each half paves its half of the median
					# both halves in one paving (each its own street's, a median came out in two)
					_set_pave_code(_median_pave_key(r, hsh), r.get("pave", []))
				elif _faces_median(run, hw, sgn, ri):
					_tally("kerb_runs_facing_a_median", 1)
					continue   # a street's stretch across a divided road: that side is the median's end
				var inner := _offset_line(run, hw * sgn)
				# the pieces with shops behind them: the pavement runs on to their windows (a
				# filmed shopping street's was ~4 m, to the shop fronts, not 2.4 m and then grass)
				# and no garden is laid in front of them
				var shops := PackedByteArray()
				shops.resize(run.size())
				if not inner_side:
					shops = _shop_pieces(run, hw, sgn)
				_pave_walled = med and yard and not inner_side
				# where the paint changes along this kerb: red-white for KERB_RED at an end that
				# meets a junction, yellow-black along a bus stop on this side
				var marks := _kerb_marks(r, run, inner, red_ends, stops) if not inner_side else []
				var along := 0.0
				for i in range(run.size() - 1):
					var seg := run[i].distance_to(run[i + 1])
					var na := (inner[i] - run[i]).normalized()
					var nb := (inner[i + 1] - run[i + 1]).normalized()
					var cuts: Array = [0.0, seg]
					for m: Vector3 in marks:
						for c: float in [m.x, m.y]:
							if c > along + 0.05 and c < along + seg - 0.05:
								cuts.append(c - along)
					cuts.sort()
					for k in range(cuts.size() - 1):
						var u0: float = cuts[k]
						var u1: float = cuts[k + 1]
						if u1 - u0 < 0.01:
							continue
						var p := 0 if inner_side else pat   # a median's kerb: plain
						var mid := along + (u0 + u1) * 0.5
						for m: Vector3 in marks:
							if mid > m.x and mid < m.y:
								p = int(m.z)
						var t0 := u0 / seg
						var t1 := u1 / seg
						# (a slip road's side too where the fitting took it and the road it leaves for a
						# divided road's halves: its "median" is the triangle)
						if not _link_rings.is_empty():
							var pm := inner[i].lerp(inner[i + 1], (t0 + t1) * 0.5)
							if _in_link_island(pm + na.lerp(nb, (t0 + t1) * 0.5).normalized() * (KERB_W + pw * 0.5)):
								_tally("kerb_on_a_link_island", 1)
								continue   # a slip road's island: kerbed all round on its own
						_kerb_run_piece(kerb, pave, ri, inner[i].lerp(inner[i + 1], t0), inner[i].lerp(inner[i + 1], t1),
							na.lerp(nb, t0).normalized(), na.lerp(nb, t1).normalized(), pw + (SHOP_PAVE if shops[i] else 0.0),
							Color(float(p) / 4.0 + 0.05, 0, 0), along + u0, u1 - u0)
					along += seg
				_pave_walled = false
				if inner_side:
					_set_pave_code(hsh, r.get("pave", []))
					if float(r["median"]) < MEDIAN_ROUND:   # (a wide one's noses are the corners' curves)
						for k: int in [0, run.size() - 1]:
							if _cut_at_junction(r, run[k]) and not _in_link_island(inner[k] + (inner[k] - run[k]).normalized() * (KERB_W + pw * 0.5)):
								var into := (run[k] - run[1 if k == 0 else run.size() - 2]).normalized()
								_kerb_cap(kerb, inner[k], (inner[k] - run[k]).normalized(), KERB_W + pw, into)
					continue
				if not yard:
					continue
				# a low stone wall at the back of the pavement, a garden strip behind it
				var w_in := _offset_line(run, (hw + PAVE_W + 0.05) * sgn)
				var w_out := _offset_line(run, (hw + PAVE_W + 0.3) * sgn)
				var g_out := _offset_line(run, (hw + PAVE_W + 3.4) * sgn)
				var walled := PackedByteArray()   # which pieces of the run have the wall (for the fronts on it)
				walled.resize(run.size())
				# each point of the wall's line off every road by the game's own test (the
				# roads' strips and the rounded corners' asphalt), once a point: the asphalt
				# grid alone let 11 of Givatayim's walls stand 0.3-0.5 m into a road's mouth
				# or a corner (city_check)
				var w_clear := PackedByteArray()
				w_clear.resize(run.size())
				for i in range(run.size()):
					w_clear[i] = 1 if _off_road(w_in[i], 0.05) else 0
				for i in range(run.size() - 1):
					if shops[i]:
						continue
					# (not where it would lie on another road: a garden strip of one street ran
					# over the asphalt of the next where they met at an angle)
					if not w_clear[i] or not w_clear[i + 1] \
							or _asphalt_other((w_out[i] + w_out[i + 1] + g_out[i] + g_out[i + 1]) * 0.25, ri) \
							or _asphalt_other(w_in[i], -1) or _asphalt_other(w_in[i + 1], -1) \
							or _asphalt_other((w_in[i] + w_in[i + 1]) * 0.5, -1) \
							or (not _link_rings.is_empty() and _in_link_island((w_in[i] + w_in[i + 1]) * 0.5)):
						continue   # (nor where the wall itself would, on any road, its own too at
						           # a sharp bend: by the garden's middle alone, a wall stood
						           # across the next street, and autodrive hit it)
					walled[i] = 1
					garden.quad3(_g3(w_out[i], 0.03), _g3(w_out[i + 1], 0.03), _g3(g_out[i + 1], 0.03), _g3(g_out[i], 0.03))
				# (the wall itself is each plot's own, with its gates: _garden_fronts; the
				# northern lawns run open to the pavement)
				var gates: Array = []
				if med:
					var tgf := Time.get_ticks_usec()
					var gkey := _hash_i(run[0]) + int(sgn) * 104729
					var part := 0
					if _gardens_split:   # (loading: the near plots now, the rest just after)
						part = 1
						if not _gardens_later.has(_tile):
							_gardens_later[_tile] = []
						(_gardens_later[_tile] as Array).append([run, hw, sgn, gkey, walled])
					gates = await _garden_fronts(run, hw, sgn, gkey, fronts, walled, wall, part)
					_part_time("kerbs: front gardens (walls, gates, paths, fences, hedges)", tgf)
				var step := 7.0
				var s := 3.0
				var run_at := 0.0
				for i in range(run.size() - 1):
					var L := run[i].distance_to(run[i + 1])
					while s < L:
						var q := (w_out[i].lerp(w_out[i + 1], s / L)).lerp(g_out[i].lerp(g_out[i + 1], s / L), 0.45)
						var by_gate := false   # (not on a path, nor in a yard)
						for gt: Array in gates:
							if absf(run_at + s - float(gt[0])) < float(gt[1]) + 1.2:
								by_gate = true
						if not by_gate and not shops[i] and _mine(q) and not _in_link_island(q) and posmod(_hash_i(q), 3 if med else 6) == 1 and not _asphalt_other(q, ri) and _push_out(q, 0.8, false) == Vector2.ZERO:
							var sc := 0.7 + 0.5 * float(posmod(_hash_i(q), 5)) / 4.0
							bushes.append(Transform3D(Basis.from_scale(Vector3(1.3, 0.9, 1.3) * sc), _g3(q, 0.45 * sc)))
						s += step
					s -= L
					run_at += L
	_island_faces(kerb)
	if med:
		await _build_medians(kerb, pave)
	var corners := _clip_buf(GROUND_CELL)
	var tkc := Time.get_ticks_usec()
	await _kerb_corners(kerb, pave, corners, Color((0.25 if med else 0.0) + 0.05, 0, 0))
	_part_time("kerbs: corners", tkc)
	if _over():
		await _pause()
	_add_mesh(corners, _surface("asphalt"), false, VIEW_RANGE)
	_laid = {}
	_laid_by = -1
	if _kerb_mat == null:
		_kerb_mat = ShaderMaterial.new()
		var sh := Shader.new()
		sh.code = _with_far(KERB_SHADER)
		_kerb_mat.shader = sh
		_far(_kerb_mat)
		_kerb_mat.set_shader_parameter("conc", _tex("concrete_pavement_diff"))
		_kerb_mat.set_shader_parameter("conc_mean", TEX_MEAN["concrete_pavement"])
		_kerb_mat.set_shader_parameter("textured", 1.0 if _quality > 0 else 0.0)
		_retint_kerbs()
	_add_mesh(kerb, _kerb_mat, false, DETAIL_RANGE * 1.6)
	_add_mesh(garden, _surface("grass"), false, DETAIL_RANGE * 1.6)
	await _add_fronts(fronts, wall)
	if not bushes.is_empty():
		# leafy shrubs: the trees' leaf-card crowns, small (a smooth ball read as a toy)
		var shrubs: Array = []
		var cols: Array = []
		for t: Transform3D in bushes:
			shrubs.append(t * Transform3D(Basis.from_scale(Vector3(0.5, 0.55, 0.5)), Vector3.ZERO))
			cols.append(Color(0.8, 0.92, 0.78, 0.125))
		_chunked(_tree_meshes["crown"], shrubs, DETAIL_RANGE, cols, null, false)
	_tally("bushes", bushes.size())

## the front gardens' walls, gates, fences, hedges, flowers... a square's worth, into meshes
func _new_fronts() -> Dictionary:
	return {"hedge": _clip_buf(GROUND_CELL), "bars": _clip_buf(GROUND_CELL), "bar_posts": _clip_buf(GROUND_CELL),
		"chain": _clip_buf(GROUND_CELL), "chain_posts": _clip_buf(GROUND_CELL), "planks": _clip_buf(GROUND_CELL), "flowers": [],
		"plaster": _clip_buf(GROUND_CELL), "coping": _clip_buf(GROUND_CELL), "path": _clip_buf(GROUND_CELL), "spill": [],
		"dropped": []}

func _add_fronts(fronts: Dictionary, wall: CBuf) -> void:
	_add_mesh(wall, _surface("stonewall"), false, DETAIL_RANGE)
	if _over():
		await _pause()
	_add_mesh(fronts["hedge"], _surface("bush"), true, DETAIL_RANGE * 1.2)
	_add_mesh(fronts["bars"], _furn._fence_material("railing", 0.15), false, DETAIL_RANGE * 0.8)
	_add_mesh(fronts["bar_posts"], _surface("railing"), false, DETAIL_RANGE * 0.8)
	_add_mesh(fronts["chain"], _furn._fence_material("fencegreen", 0.12), false, DETAIL_RANGE * 0.8)
	_add_mesh(fronts["chain_posts"], _surface("fencegreen"), false, DETAIL_RANGE * 0.8)
	_add_mesh(fronts["planks"], _vc_mat(), true, DETAIL_RANGE * 0.8)
	_add_mesh(fronts["plaster"], _surface("gardenwall"), false, DETAIL_RANGE)
	_add_mesh(fronts["coping"], _surface("coping"), false, DETAIL_RANGE)
	_add_mesh(fronts["path"], _surface("slabs"), false, DETAIL_RANGE)
	if not (fronts["flowers"] as Array).is_empty():
		# bougainvillea: a leafy green shrub (the trees' leaf cards, small) with a smaller
		# crown of magenta on top of it -- the instance colour turns the leaves into flowers
		var leaves: Array = []
		var blooms: Array = []
		for t: Transform3D in fronts["flowers"]:
			leaves.append(t * Transform3D(Basis.from_scale(Vector3(0.55, 0.5, 0.5)), Vector3.ZERO))
			blooms.append(t * Transform3D(Basis.from_scale(Vector3(0.45, 0.35, 0.42)), Vector3(0.0, 0.18, 0.05)))
		var green: Array = []
		var pink: Array = []
		for i in range(leaves.size()):
			green.append(Color(0.82, 0.95, 0.78, 0.125))   # broad leaves (atlas cell 0)
			pink.append(Color(2.9, 0.55, 1.9, 0.375))      # small ones (cell 1), magenta
		_chunked(_tree_meshes["crown"], leaves, DETAIL_RANGE, green, null, false)
		_chunked(_tree_meshes["crown"], blooms, DETAIL_RANGE, pink, null, false)
		_tally("bougainvillea", leaves.size())
	if not (fronts["dropped"] as Array).is_empty():
		var dcols: Array = []
		for t: Transform3D in fronts["dropped"]:
			dcols.append([_tone["signblue"], _tone["mark"], _tone["cartrim"]][posmod(_hash_i(Vector2(t.origin.x, t.origin.z)), 3)])
		await _furn._place(_furn._bike_kit(), fronts["dropped"], _furn.NEAR_SEEN, "bikes_dropped", false, dcols)
	if not (fronts["spill"] as Array).is_empty():
		# greenery over the garden walls, out over the pavement
		var clumps: Array = []
		var ccols: Array = []
		for t: Transform3D in fronts["spill"]:
			clumps.append(t * Transform3D(Basis.from_scale(Vector3(0.5, 0.55, 0.5)), Vector3.ZERO))
			ccols.append(Color(0.74, 0.9, 0.7, 0.125))
		_chunked(_tree_meshes["crown"], clumps, DETAIL_RANGE, ccols, null, false)
		_tally("spilling_over", clumps.size())

## Front gardens are the biggest single part of loading (~0.7 s in Givatayim: walls, gates,
## paths, fences, hedges, flowers). While loading, only the plots within GARDENS_NOW of the
## start -- what you see first -- are laid; the rest of those squares' plots are laid first
## thing once you are driving, nearest square first, before the rest of the city
## (_build_gardens_later). The same plots, the same keys: nothing different, only later.
const GARDENS_NOW := 120.0
var _gardens_split := false          ## loading the squares round the start: lay only the near plots
var _gardens_from := Vector2.ZERO    ## where "near" is measured from (the start)
var _gardens_later := {}             ## square -> [[run, hw, sgn, key, walled], ...] (their far plots)

func _build_gardens_later() -> void:
	var tiles: Array = _gardens_later.keys()
	tiles.sort_custom(func(a, b): return _tile_dist(a, _pos) < _tile_dist(b, _pos))
	for t: Vector2i in tiles:
		if _over():
			await _pause()
		_tile = t
		_set_tiling(true)
		_batching = true
		_yard_cars.clear()
		var wall := _clip_buf(GROUND_CELL)
		var fronts := _new_fronts()
		for job: Array in _gardens_later[t]:
			await _garden_fronts(job[0], job[1], job[2], job[3], fronts, job[4], wall, 2)
		await _add_fronts(fronts, wall)
		if not _yard_cars.is_empty():   # (their cars, drawn like the street's parked cars)
			var palette := _car_paints()
			var xf_by := {"sedan": [], "hatch": [], "mini": [], "wagon": [], "mpv": [], "suv": [], "van": [], "moto_parked": []}
			var cols_by := {"sedan": [], "hatch": [], "mini": [], "wagon": [], "mpv": [], "suv": [], "van": [], "moto_parked": []}
			for yc: Array in _yard_cars:
				(xf_by[String(yc[1])] as Array).append(yc[0])
				(cols_by[String(yc[1])] as Array).append(palette[int(yc[2]) % palette.size()])
			_tally("yard_cars", _yard_cars.size())
			_draw_parked(xf_by, cols_by)
			_yard_cars.clear()
		await _flush_batches()
		_set_tiling(false)
		_batching = false
	_gardens_later = {}

## Israeli main streets are not open down the middle: a raised island divides the two ways.
## A wide two-way main road (OSM maps many as one road) gets one, MEDIAN_W wide, kerbed both
## sides and paved on top, solid to the car; it stops short of every junction (turning across
## is still possible there) and leaves a gap at each zebra. r["mid"] is its half width.
const MEDIAN_W := 1.2

func _median_road(r: Dictionary) -> bool:
	if not r["drive"] or int(r["o"]) != 0 or r.get("ring", false) or not _kerbed(r) or r.has("ys"):
		return false
	var w := float(r["w"])
	# (secondary streets come out 10 m wide, tertiary 9: the main roads, not the side streets)
	return (r["k"] in ["trunk", "primary", "secondary"] and w >= 9.5) or (r["k"] == "tertiary" and (w >= 12.0 or int(r["l"]) >= 4))

## which roads get one, for the whole city at once (autodrive's turn lane keeps off them
## wherever they are; the islands go up square by square)
func _mark_medians() -> void:
	if String(_place.get("look", "")) != "med":
		return
	for r: Dictionary in _roads:
		if _median_road(r):
			r["mid"] = MEDIAN_W * 0.5

## A median is a kerb's height over the road, not a wall: the car goes over it, with a jolt.
## (It was a wall as high as the sky, which a car looked able to roll straight over, and the
## player could not.) Each axle going up or down it kicks the car on its springs and costs it
## some speed, the faster the harder; while the wheels are on it the car rides that much higher.
var _medians := PackedVector2Array()   ## two points a stretch of median
var _median_r := PackedFloat32Array()  ## half its width
var _median_hash := {}
var _median_on := [false, false]       ## front and back axle on a median now
var _median_lift := 0.0                ## how high the car rides on it (m), eased

func _add_median(a: Vector2, b: Vector2, half: float) -> void:
	var i := _median_r.size()
	_medians.append(a)
	_medians.append(b)
	_median_r.append(half)
	_hash_add(_median_hash, Rect2(a, Vector2.ZERO).expand(b).grow(half), BLD_CELL, i)

func _on_median(p: Vector2) -> bool:
	for i: int in _near(_median_hash, p, 1.0, BLD_CELL):
		var a := _medians[i * 2]
		var b := _medians[i * 2 + 1]
		if Geometry2D.get_closest_point_to_segment(p, a, b).distance_to(p) < _median_r[i] + 0.15:
			return true
	return false

func _median_tick(dt: float) -> void:
	if (_medians.is_empty() and _islands.is_empty()) or _walking or _air:
		return
	var fwd := _fwd()
	var on := 0
	for k in range(2):
		var wheel := _pos + fwd * (WHEELBASE * 0.5 if k == 0 else -WHEELBASE * 0.5)
		var now := _on_median(wheel) or _on_island(wheel)
		if now:
			on += 1
		if now != _median_on[k]:
			_median_on[k] = now
			var j := clampf(absf(_v) / 12.0, 0.08, 1.0)   # (walking pace a nudge, 45 km/h a thump)
			# up the kerb the near end rises, off it it drops onto its springs
			var up_front := (k == 0) == now
			_pitch = clampf(_pitch + (-0.035 if up_front else 0.035) * j * signf(_v if _v != 0.0 else 1.0), -0.12, 0.12)
			_v *= 1.0 - 0.07 * j
			shake3d(0.3 + 1.2 * j)
			Audio.play("impact_soft", 0.1, -10.0 + 6.0 * j)
			if j > 0.5 and k == 0 and now:
				Probe.event("median", {"kmh": int(absf(_v) * 3.6)})
	_median_lift = move_toward(_median_lift, KERB_H * on * 0.5, dt * 1.6)
	_y += _median_lift

## A divided road's median narrower than this ends square, closed by a kerb face across it
## (_kerb_cap), with no corner kerbs on its side and no kerb from the street across it facing
## it. Each was laid apart -- the halves' strips, the corners' curves, the cross street's
## stretch between the halves with its own kerb and pavement -- and a user saw the pieces
## "messy, the geometry doesn't align" (tests/median_ends.gd). Wider, the corners' curves make
## a rounded nose of their own and it is left as it was.
const MEDIAN_ROUND := 10.0

## p is on a divided road's median: beside one of its halves (within the segment's length), on
## that half's inner side, no further out than the median is wide
func _in_median(p: Vector2, skip: int) -> bool:
	for code: int in _near(_seg_hash, p, 16.0, SEG_CELL):
		var rq := code / 4096
		if rq == skip:
			continue
		var q: Dictionary = _roads[rq]
		if not q.has("median") or float(q["median"]) < 0.25 or float(q["median"]) >= MEDIAN_ROUND:
			continue
		var pts: PackedVector2Array = q["pts"]
		var sj := code % 4096
		var t := pts[sj + 1] - pts[sj]
		var u := (p - pts[sj]).dot(t) / maxf(t.length_squared(), 0.0001)
		if u < 0.0 or u > 1.0:
			continue
		var travel := t.normalized() * float(q["o"])
		var off := (p - pts[sj].lerp(pts[sj + 1], u)).dot(Vector2(travel.y, -travel.x))
		var hw := float(q["w"]) * 0.5
		if off > hw - 0.2 and off < hw + float(q["median"]) + 0.3:
			return true
	return false

## a stretch of a street whose side `sgn` looks onto a divided road's median (it crosses the
## road: its side faces the median's end): along its middle, just past where its pavement would be
func _faces_median(run: PackedVector2Array, hw: float, sgn: float, ri: int) -> bool:
	var total := 0.0
	for i in range(run.size() - 1):
		total += run[i].distance_to(run[i + 1])
	if total > 40.0:
		return false   # (a long stretch is a street, not the way across a junction)
	var mid := run[run.size() / 2] if run.size() > 2 else (run[0] + run[1]) * 0.5
	var j := mini(run.size() / 2, run.size() - 2)
	var d := (run[j + 1] - run[j]).normalized()
	return _in_median(mid + Vector2(-d.y, d.x) * sgn * (hw + KERB_W + 1.0), ri)

## the run's end at p was cut short of a junction (not the road's own open end)
func _cut_at_junction(r: Dictionary, p: Vector2) -> bool:
	var pts: PackedVector2Array = r["pts"]
	var ids: PackedInt32Array = r["ids"]
	for i in range(ids.size()):
		if _kerb_arms(ids[i]) >= 3 and pts[i].distance_to(p) < _node_r[ids[i]] + KERB_CUT + 0.6:
			return true
	return false

## a kerb face across the end of a strip of kerb and paving: from `a` (on the road's edge) `w`
## out along `out`, facing `into` (the way out of the strip)
func _kerb_cap(kerb: Buf, a: Vector2, out: Vector2, w: float, into: Vector2) -> void:
	var b := a + out * w
	var face := Vector3(into.x, 0, into.y)
	var col := Color(0.05, 0, 0)
	var a0 := _g3(a, 0.0)
	var b0 := _g3(b, 0.0)
	var a1 := a0 + Vector3(0, KERB_H, 0)
	var b1 := _g3(b, 0.0) + Vector3(0, KERB_H, 0)
	kerb.tri(a0, b0, b1, face, col, Vector2(0, 0), Vector2(w, 0), Vector2(w, 1))
	kerb.tri(a0, b1, a1, face, col, Vector2(0, 0), Vector2(w, 1), Vector2(0, 1))
	_tally("median_caps", 1)

func _build_medians(kerb: Buf, pave: Buf) -> void:
	var zebra := {}
	for ni: int in _crossing_nodes:
		zebra[ni] = true
	var made := 0.0
	var mw := MEDIAN_W * 0.5
	for ri: int in (_tile_roads.get(_tile, []) if _tiled else range(_roads.size())):
		var r: Dictionary = _roads[ri]
		if not r.has("mid"):
			continue
		if _over():
			await _pause()
		# the zebras on it, to leave a gap at
		var gaps: Array = []
		var ids: PackedInt32Array = r["ids"]
		for k in range(ids.size()):
			if zebra.has(ids[k]):
				gaps.append(_nodes[ids[k]])
		for run: PackedVector2Array in _street_runs(r, KERB_CUT, true):
			if _tiled and not _tile_rect(_tile).grow(10.0).intersects(_bld_box_of(run)):
				continue   # a stretch nowhere near this square
			var cum := 0.0
			for i in range(run.size() - 1):
				var a := run[i]
				var b := run[i + 1]
				var seg := a.distance_to(b)
				var gap := false
				for gp: Vector2 in gaps:
					if Geometry2D.get_closest_point_to_segment(gp, a, b).distance_to(gp) < 3.5:
						gap = true
				if not gap:
					var d := (b - a) / maxf(seg, 0.001)
					var rt := Vector2(-d.y, d.x)
					for sgn: float in [1.0, -1.0]:
						_laid_by = ri * 4 + (2 if sgn < 0.0 else 3)
						# a kerb at mw each side, its face out to the lanes, paved behind to the middle
						var na := -rt * sgn
						_kerb_run_piece(kerb, pave, ri, a + rt * mw * sgn, b + rt * mw * sgn, na, na,
								maxf(mw - KERB_W, 0.0), Color(0.05, 0, 0), cum, seg)
					if _mine(a):   # (recorded once, by the square it starts in)
						_add_median(a, b, mw)
						made += seg
				cum += seg
	_tally("median_m", int(made))

## The key both halves of a divided road pave their median with: one name for both -- by its
## own name alone, Ashdod's Sderot Bnei Brit, one half named "בני ברית" and the other
## "שדרות בני ברית", paved its median twice in two pavings, overlapping (flicker; 25 m2 of
## the town's 235 in one stretch, pavings_where.gd)
func _median_pave_key(r: Dictionary, hsh: int) -> int:
	var nm := String(r["name"])
	var mate := int(r.get("mate", -1))
	if mate >= 0:
		var r2: Dictionary = _roads[mate]
		var other := String(r2["name"])
		if nm == "" or (other != "" and other < nm):
			nm = other
		if nm == "":   # (both unnamed: the lower of their own keys, the same from either half)
			hsh = mini(hsh, _hash_i((r2["pts"] as PackedVector2Array)[0]))
	return hash(nm) if nm != "" else hsh

func _kerbed(r: Dictionary) -> bool:
	return r["drive"] and not r["pv"] and r["k"] != "service" and not HIGHWAYS.has(r["k"])

## ways out of node n along roads that have kerbs
func _kerb_arms(n: int) -> int:
	var count := 0
	for e: Vector2i in _node_roads[n]:
		var r: Dictionary = _roads[e.x]
		if not _kerbed(r):
			continue
		if e.y > 0:
			count += 1
		if e.y < (r["pts"] as PackedVector2Array).size() - 1:
			count += 1
	return count

## p lies on the asphalt of some drivable road other than ri. Asked tens of thousands of
## times while the kerbs go in, so against its own fine grid of road surfaces (8 m squares,
## a handful of segments each) rather than the 24 m one everything else uses.
var _asph_hash := {}
const ASPH_CELL := 8.0

func _build_asph_hash() -> void:
	_asph_hash = {}
	for ri in range(_roads.size()):
		var r: Dictionary = _roads[ri]
		if not r["drive"]:
			continue
		var pts: PackedVector2Array = r["pts"]
		var hw: float = float(r["w"]) * 0.5
		for j in range(pts.size() - 1):
			if r.has("ys") and (absf(r["ys"][j] - r["gs"][j]) > 0.5 or absf(r["ys"][j + 1] - r["gs"][j + 1]) > 0.5):
				continue   # (a bridge over a street, a tunnel under one: not in its way)
			_hash_add(_asph_hash, Rect2(pts[j], Vector2.ZERO).expand(pts[j + 1]).grow(hw), ASPH_CELL, ri * 4096 + j)

func _asphalt_other(p: Vector2, ri: int) -> bool:
	for code: int in (_asph_hash.get(_cell(p, ASPH_CELL), []) as Array):
		var rj := code / 4096
		if rj == ri:
			continue
		var r2: Dictionary = _roads[rj]
		if not r2["drive"]:
			continue
		var p2: PackedVector2Array = r2["pts"]
		var sj := code % 4096
		var cp := Geometry2D.get_closest_point_to_segment(p, p2[sj], p2[sj + 1])
		if p.distance_squared_to(cp) < pow(maxf(float(r2["w"]) * 0.5 - 0.25, 0.0), 2.0):
			return true
	return false

## One stretch of kerb (inner edge a-b, outward normals na/nb) and the pavement behind it,
## left out wherever it would lie on another road's asphalt: where two roads overlap (a
## divided road's halves, a slip road) the pavement no longer runs down the lanes, and a
## driveway gets its gap. A clear stretch goes in whole; one that is not, in short pieces.
func _kerb_run_piece(kerb: Buf, pave: Buf, ri: int, a: Vector2, b: Vector2, na: Vector2, nb: Vector2, pw: float,
		col: Color, along: float, seg: float) -> void:
	var ts: Array = [0.5] if seg <= 8.0 else [0.15, 0.5, 0.85]
	var clear := true
	for t: float in ts:
		if _kerb_probe(a, b, na, nb, t, pw, ri) != Vector2.ZERO:
			clear = false
			break
	if clear:
		_kerb_piece(kerb, pave, a, b, na, nb, pw, col, along)
		return
	var n := maxi(2, ceili(seg / 1.5))
	for k in range(n):
		var t0 := float(k) / n
		var t1 := float(k + 1) / n
		var hit: Vector2 = _kerb_probe(a, b, na, nb, (t0 + t1) * 0.5, pw, ri)
		if hit.x > 0.0:
			continue
		_kerb_piece(kerb, pave, a.lerp(b, t0), a.lerp(b, t1), na.lerp(nb, t0).normalized(), na.lerp(nb, t1).normalized(),
			0.0 if hit.y > 0.0 else pw, col, along + seg * t0)

## (kerb on another road's asphalt, pavement on it) at fraction t of a kerb stretch
func _kerb_probe(a: Vector2, b: Vector2, na: Vector2, nb: Vector2, t: float, pw: float, ri: int) -> Vector2:
	var q := a.lerp(b, t)
	var nq := na.lerp(nb, t).normalized()
	return Vector2(1.0 if _asphalt_other(q + nq * KERB_W * 0.5, ri) else 0.0,
		1.0 if pw > 0.05 and _asphalt_other(q + nq * (KERB_W + pw * 0.5), ri) else 0.0)

## a kerb from a to b (its face toward the road, its top KERB_W wide) and pw of pavement behind
func _kerb_piece(kerb: Buf, pave: Buf, a: Vector2, b: Vector2, na: Vector2, nb: Vector2, pw: float, col: Color, along: float) -> void:
	var seg := a.distance_to(b)
	var a0 := _g3(a, 0.0)
	var a1 := _g3(b, 0.0)
	var t0 := a0 + Vector3(0, KERB_H, 0)
	var t1 := a1 + Vector3(0, KERB_H, 0)
	var oa := a + na * KERB_W
	var ob := b + nb * KERB_W
	var o0 := _g3(oa, KERB_H)
	var o1 := _g3(ob, KERB_H)
	var nm := (na + nb).normalized()
	var face := Vector3(-nm.x, 0, -nm.y)
	kerb.tri(a0, a1, t1, face, col, Vector2(along, 0), Vector2(along + seg, 0), Vector2(along + seg, 1))
	kerb.tri(a0, t1, t0, face, col, Vector2(along, 0), Vector2(along + seg, 1), Vector2(along, 1))
	_laid_seq += 1
	var top := PackedVector2Array([a, b, ob, oa])
	var top_cut := _laid_cut(top)
	if top_cut.is_empty():
		kerb.tri(t0, t1, o1, Vector3.UP, col, Vector2(along, 0), Vector2(along + seg, 0), Vector2(along + seg, 1))
		kerb.tri(t0, o1, o0, Vector3.UP, col, Vector2(along, 0), Vector2(along + seg, 1), Vector2(along, 1))
	else:
		for piece: PackedVector2Array in top_cut[0]:
			_flat_piece(kerb, piece, Vector3.UP, col, a, (b - a) / maxf(seg, 0.001), along, 1.0 / KERB_W)
	_laid_add(top)
	if pw > 0.05:
		var c2 := _g3(ob + nb * pw, KERB_H)
		var c3 := _g3(oa + na * pw, KERB_H)
		var nrm := (c2 - o0).cross(o1 - o0)
		if nrm.y < 0.0:
			nrm = -nrm
		nrm = nrm.normalized() if nrm.length_squared() > 0.000001 else Vector3.UP
		# alpha: under 0.65 a garden wall at its back, pw / 4 out; 0.7-0.76 a narrow pavement
		# (a median's), no wall, (a - 0.7) * 40 wide; 1 the usual, no wall
		var pa := pw / 4.0 if _pave_walled else (1.0 if pw >= PAVE_W - 0.05 else 0.7 + pw / 40.0)
		var pc := Color(_pave_code, _leafy((oa + ob) * 0.5 + (na + nb) * pw * 0.25), 1.0, pa)
		var flat := PackedVector2Array([oa, ob, ob + nb * pw, oa + na * pw])
		var cut := _laid_cut(flat)
		if cut.is_empty():
			pave.tri(o0, o1, c2, nrm, pc, Vector2(along, 0), Vector2(along + seg, 0), Vector2(along + seg, pw))
			pave.tri(o0, c2, c3, nrm, pc, Vector2(along, 0), Vector2(along + seg, pw), Vector2(along, pw))
		else:
			for piece: PackedVector2Array in cut[0]:
				_flat_piece(pave, piece, nrm, pc, oa, (ob - oa) / maxf(oa.distance_to(ob), 0.001), along, 1.0)
		_laid_add(flat)

## Where two streets' pavements meet at a corner (or cross, or a junction's corner runs onto
## a street's), each laid whole put pavement over pavement at one height, each patterned along
## its own street: a phone's depth buffer took one or the other pixel by pixel and the corner
## flickered between brick and slabs. So while a square's kerbs go down, what is laid is kept
## (_laid: 4 m cells -> [outline, box, who laid it, id, piece number]) and a later piece is cut
## where an earlier one (another street's, another side's, a corner's, its own strip's folded
## round a tight bend) already paves: first laid stays whole.
## Squares lay roads in the same order (by road, then medians, then corners), so the piece a
## square keeps was cut by the same pieces whichever square works it out.
const LAID_CELL := 4.0
var _laid := {}
var _laid_by := -1                   ## whose pieces are going down now (a road's side, a corner)
var _laid_n := 0
var _laid_seq := 0                   ## pieces laid so far: a strip's next piece only touches the last

func _laid_add(poly: PackedVector2Array) -> void:
	var box := Rect2(poly[0], Vector2.ZERO)
	for q in poly:
		box = box.expand(q)
	_laid_n += 1
	var entry := [poly, box, _laid_by, _laid_n, _laid_seq]
	for cx in range(floori(box.position.x / LAID_CELL), floori(box.end.x / LAID_CELL) + 1):
		for cz in range(floori(box.position.y / LAID_CELL), floori(box.end.y / LAID_CELL) + 1):
			var k := Vector2i(cx, cz)
			if not _laid.has(k):
				_laid[k] = []
			(_laid[k] as Array).append(entry)

## [the parts of poly no one else has paved yet] when someone else's pieces overlap it,
## [] when none do (lay it whole)
func _laid_cut(poly: PackedVector2Array) -> Array:
	var box := Rect2(poly[0], Vector2.ZERO)
	for q in poly:
		box = box.expand(q)
	box = box.grow(-0.02)
	if box.size.x <= 0.0 or box.size.y <= 0.0:
		return []
	var over: Array = []
	var seen := {}
	for cx in range(floori(box.position.x / LAID_CELL), floori(box.end.x / LAID_CELL) + 1):
		for cz in range(floori(box.position.y / LAID_CELL), floori(box.end.y / LAID_CELL) + 1):
			for entry: Array in _laid.get(Vector2i(cx, cz), []):
				# (a strip's own pieces too, where it folds over itself round a tight bend -- but
				# not the piece before, which only touches it)
				var own := int(entry[2]) == _laid_by and absi(int(entry[4]) - _laid_seq) <= 1
				if not own and not seen.has(entry[3]) and (entry[1] as Rect2).intersects(box):
					seen[entry[3]] = true
					over.append(entry)
	if over.is_empty():
		return []
	var pieces: Array = [poly]
	var touched := false
	for entry: Array in over:
		var next: Array = []
		for p: PackedVector2Array in pieces:
			var res := Geometry2D.clip_polygons(p, entry[0])
			if res.size() == 1 and absf(absf(_area_signed(res[0])) - absf(_area_signed(p))) < 0.005:
				next.append(p)   # (only touching)
				continue
			# an outline laid wholly inside this one comes back as a hole (wound the other way
			# from the outside): keep the piece whole -- a little overlap, not a hole in the ground
			var big := 0
			for i in range(res.size()):
				if absf(_area_signed(res[i])) > absf(_area_signed(res[big])):
					big = i
			var holed := false
			for q: PackedVector2Array in res:
				# (not a sliver: cut by a strip whose edge lies on this piece's own, the clip
				# hands back hair-thin leftovers along it wound either way, and one read as a
				# hole kept the piece whole, over the strip -- Ashdod's Hoshea HaNavi, 7 m2
				# of two pavings where one street's pavement crossed the other's at a fork)
				if absf(_area_signed(q)) > 0.01 and Geometry2D.is_polygon_clockwise(q) != Geometry2D.is_polygon_clockwise(res[big]):
					holed = true
			if holed:
				# cut in two across the cutter's middle first, then each half round it: no half
				# holds it wholly, so neither comes back holed. Kept whole, the piece lay over
				# the cutter -- a street's pavement over the corner of another's laid just before
				# inside it (Ashdod (-1258, 3632): 2 m2 of two pavings in one square)
				var halves := _halves_across(p, entry[0])
				var split_ok := not halves.is_empty()
				var got: Array = []
				for h: PackedVector2Array in halves:
					var r2 := Geometry2D.clip_polygons(h, entry[0])
					for q: PackedVector2Array in r2:
						if absf(_area_signed(q)) > 0.01 and Geometry2D.is_polygon_clockwise(q) != Geometry2D.is_polygon_clockwise(h):
							split_ok = false
					for q: PackedVector2Array in r2:
						if absf(_area_signed(q)) > 0.01:
							got.append(q)
				if not split_ok:
					next.append(p)   # (a little overlap, not a hole in the ground)
					continue
				touched = true
				next.append_array(got)
				continue
			touched = true
			for q: PackedVector2Array in res:
				if absf(_area_signed(q)) > 0.01:
					next.append(q)
		pieces = next
	return [pieces] if touched else []

## p cut in two by a line through the middle of `inner` (a shape inside it), across p's
## longer side: [] if that does not give two
func _halves_across(p: PackedVector2Array, inner: PackedVector2Array) -> Array:
	var box := _bld_box_of(p).grow(1.0)
	var c := _bld_box_of(inner).get_center()
	var sides: Array = []
	if box.size.x >= box.size.y:
		sides = [Rect2(box.position, Vector2(c.x - box.position.x, box.size.y)),
			Rect2(Vector2(c.x, box.position.y), Vector2(box.end.x - c.x, box.size.y))]
	else:
		sides = [Rect2(box.position, Vector2(box.size.x, c.y - box.position.y)),
			Rect2(Vector2(box.position.x, c.y), Vector2(box.size.x, box.end.y - c.y))]
	var out: Array = []
	for r: Rect2 in sides:
		var rp := PackedVector2Array([r.position, Vector2(r.end.x, r.position.y), r.end, Vector2(r.position.x, r.end.y)])
		for q: PackedVector2Array in Geometry2D.intersect_polygons(p, rp):
			if absf(_area_signed(q)) > 0.01:
				if Geometry2D.is_polygon_clockwise(q) != Geometry2D.is_polygon_clockwise(p):
					q.reverse()
				out.append(q)
	return out if out.size() >= 2 else []

## a flat piece of kerb top or pavement cut to shape: its texture laid as the whole piece's
## would have been (along the street from `origin` in `dir`, across it in metres * vscale)
func _flat_piece(buf: Buf, piece: PackedVector2Array, nrm: Vector3, col: Color, origin: Vector2, dir: Vector2,
		along: float, vscale: float) -> void:
	var idx := Geometry2D.triangulate_polygon(piece)
	for i in range(0, idx.size(), 3):
		var q: Array = [piece[idx[i]], piece[idx[i + 1]], piece[idx[i + 2]]]
		var uv: Array = []
		for p: Vector2 in q:
			var d := p - origin
			uv.append(Vector2(along + d.dot(dir), absf(d.cross(dir)) * vscale))
		buf.tri(_g3(q[0], KERB_H), _g3(q[1], KERB_H), _g3(q[2], KERB_H), nrm, col, uv[0], uv[1], uv[2])

## The paving a street (or a corner) gets: its pattern -- herringbone, rows of bricks, square
## slabs; Bedford's poured concrete -- and its colours -- reds and browns, greys, sand, all of
## them mixed -- as the red of the pavement's vertex colour (see KERB_SHADER)
var _pave_code := 0.0
var _pave_walled := false            ## the pavement being laid has a garden wall at its back (KERB_SHADER darkens its foot)

func _set_pave_code(hsh: int, filmed: Array = []) -> void:
	var pattern := 3
	var colours := 1
	if filmed.size() == 2:   # as filmed (details.gd "pave": [pattern, colours])
		pattern = int(filmed[0])
		colours = int(filmed[1])
	elif String(_place.get("look", "")) != "north":
		var p := posmod(hsh, 100)
		pattern = 0 if p < 45 else (1 if p < 75 else 2)
		var c := posmod(hsh >> 7, 100)
		colours = 0 if c < 30 else (1 if c < 70 else (2 if c < 85 else 3))
		if pattern == 2 and colours == 0:
			colours = 1   # (slabs come grey or sand)
	_pave_code = (float(pattern * 4 + colours) + 0.5) / 16.0

## A garden's front, plot by plot along one side of a street's run (each 14-22 m), as walks
## down Givatayim's streets have them. The low wall at the back of the pavement is each plot's
## own: rough stones in mortar, or rendered and capped with a slab of pale stone, 0.5-1.2 m
## high (higher where nothing stands on it). On it or behind it: a clipped hedge, wooden
## boards (a second filmed walk: the commonest front down a whole street), white bars, green
## chain-link, or nothing; bougainvillea over one plot in six; greenery spilling out over the
## pavement from some of the hedges and bare walls. Where a building's door faces the street
## the wall opens: a gate between two piers (now and then a bougainvillea arch over it) and a
## paved path through the garden to the door -- or, before a yard deep enough, a wider
## opening and a car parked in the yard. Keyed to the run, so every square along the street
## works out the same plots (the fronts are laid like the kerbs: CBuf.clip). Returns the
## gates: [s along the run, half the opening, ...] (_run_gates).
func _garden_fronts(run: PackedVector2Array, hw: float, sgn: float, key: int, fronts: Dictionary,
		walled: PackedByteArray, wall: CBuf, part := 0) -> Array:
	var on_wall := _offset_line(run, (hw + PAVE_W + 0.175) * sgn)
	var behind := _offset_line(run, (hw + PAVE_W + 0.85) * sgn)
	var cum := PackedFloat32Array([0.0])
	for i in range(1, run.size()):
		cum.append(cum[i - 1] + run[i - 1].distance_to(run[i]))
	var total := cum[cum.size() - 1]
	var lines := {"in": _offset_line(run, (hw + PAVE_W + 0.05) * sgn), "out": _offset_line(run, (hw + PAVE_W + 0.3) * sgn),
		"c_in": _offset_line(run, (hw + PAVE_W + 0.02) * sgn), "c_out": _offset_line(run, (hw + PAVE_W + 0.33) * sgn)}
	var gates := _run_gates(run, cum, hw, sgn, key, walled)
	var near := _tile_rect(_tile).grow(6.0)
	var s := 0.0
	var plot := 0
	var gi := 0
	var trim_s := 0.0
	var kp := float(posmod(key, 100003))
	while s < total - 2.0:
		var h := posmod(key + plot * 7919, 1000003)
		var e := minf(s + 14.0 + float(posmod(h, 9)), total)
		# a gate (a door's path) ahead: the plot ends at it, the next starts from it
		var trim_e := 0.0
		var gate: Array = []
		while gi < gates.size() and float(gates[gi][0]) <= s + 1.5:
			gi += 1
		if gi < gates.size() and float(gates[gi][0]) < e + 4.0:
			gate = gates[gi]
			e = float(gate[0])
			trim_e = float(gate[1])
		var style := posmod(h >> 4, 100)
		var line := behind if style < 36 else on_wall
		var fs0 := s + maxf(0.7, trim_s + 0.5)   # (a hedge or a fence starts back from a gate's pier)
		var fe0 := maxf(e - maxf(0.7, trim_e + 0.5), fs0 + 0.01)
		var pts: Array = [_along(line, cum, fs0)]
		var seg: Array = [_seg_at(cum, fs0)]   # the piece of the run each stretch starts on
		var box := Rect2(pts[0], Vector2.ZERO)
		for i in range(1, line.size() - 1):
			if cum[i] > fs0 and cum[i] < fe0:
				pts.append(line[i])
				seg.append(i)
				box = box.expand(line[i])
		pts.append(_along(line, cum, fe0))
		box = box.expand(pts[pts.size() - 1])
		box = box.expand(_along(line, cum, s)).expand(_along(line, cum, e))
		if (_tiled and not near.intersects(box.grow(1.0))) or \
				(part != 0 and (box.get_center().distance_to(_gardens_from) > GARDENS_NOW) != (part == 2)):
			s = e   # a plot nowhere near this square: its own square lays it (same plots, same key);
			plot += 1   # (or, loading, one for later: _build_gardens_later)
			trim_s = trim_e
			continue
		if _over():
			await _pause()
		# the wall: its kind and height
		var hw2 := posmod(_hash_i(Vector2(kp, float(plot) + 0.25)), 1000003)
		var f := float((hw2 / 100) % 10) / 9.0
		var plaster := (hw2 % 100) < (60 if style >= 78 else 40)
		var wh := 0.48 + 0.15 * f if style < 36 else (0.55 + 0.2 * f if style < 78 else (0.75 + 0.45 * f if plaster else 0.55 + 0.3 * f))
		var top := wh + (0.06 if plaster else 0.0)
		_garden_wall(fronts, wall, lines, cum, walled, s + trim_s, e - trim_e, wh, plaster, sgn)
		if style < 36:
			# a hedge behind the wall, on the garden strip: off the roads where the strip is
			# (looked at already), but it can still run into a house, so it looks for those
			for k in range(pts.size() - 1):
				if walled[int(seg[k])] and (pts[k] as Vector2).distance_to(pts[k + 1]) >= 0.3 \
						and _off_road(pts[k], 0.45) and _off_road(pts[k + 1], 0.45):
					# (its ends clear of the asphalt by its half width: where the strip met
					# another street at a bend, one stood 0.4 m into the road)
					_furn._hedge_line(fronts["hedge"], pts[k], pts[k + 1], false)
		elif style < 56:
			# wooden boards on the wall, its top to about head height, where the wall is
			for k in range(pts.size() - 1):
				var a: Vector2 = pts[k]
				var b: Vector2 = pts[k + 1]
				if walled[int(seg[k])] and a.distance_to(b) >= 0.3:
					_plank_fence(fronts["planks"], a, b, top, 0.95 + 0.25 * float(posmod(h >> 11, 3)) / 2.0)
		elif style < 78:
			# bars or chain-link on the wall: only where the wall is, which was looked at
			# already and is solid already, so no looking again and no walls of its own --
			# and in one panel per piece of the wall, its foot along the wall's top
			var bars := style < 67
			var run_u := 0.0
			for k in range(pts.size() - 1):
				var a: Vector2 = pts[k]
				var b: Vector2 = pts[k + 1]
				if not walled[int(seg[k])] or a.distance_to(b) < 0.3:
					continue
				var A := _g3(a, top - 0.02)
				var B := _g3(b, top - 0.02)
				if bars:
					run_u = _furn.wall_fence(fronts["bars"], fronts["bar_posts"], A, B, 0.95, _tone["railing"], 2.4, true, run_u)
				else:
					run_u = _furn.wall_fence(fronts["chain"], fronts["chain_posts"], A, B, 1.3, _tone["fencegreen"], 2.6, false, run_u)
		# a cat on the wall, where no fence stands on it: one plot in twenty (its own hash: h has
		# too few bits to share out -- the cats' choices taken from it were all "sit")
		var hc := posmod(_hash_i(Vector2(kp, float(plot) + 0.5)), 1000003)
		if (style < 36 or style >= 78) and hc % 100 < 5:
			var sm := lerpf(fs0, fe0, 0.2 + 0.6 * float((hc / 100) % 100) / 100.0)
			var q := _along(on_wall, cum, sm)
			var to_road := (_along(run, cum, sm) - q).normalized()
			if (hc / 10000) % 10 < 6:
				cat_at(q, _g3(q, top).y, to_road.rotated(float((hc / 100000) % 7 - 3) * 0.25), "sit")
			else:
				var along_w := (_along(on_wall, cum, minf(sm + 0.5, total)) - q).normalized()
				cat_at(q, _g3(q, top).y, along_w * (1.0 if (hc / 100000) % 2 == 0 else -1.0), "loaf")
		if posmod(h >> 9, 100) < 16:   # bougainvillea over the wall, a few clumps
			for t: float in [0.25, 0.5, 0.75]:
				var q := _along(on_wall, cum, lerpf(fs0, fe0, t)) - (on_wall[0] - run[0]).normalized() * 0.15
				# only over a wall: in front of shops there is none, and a clump stood on the
				# open pavement in a filmed walk's way
				if not walled[_seg_at(cum, lerpf(fs0, fe0, t))]:
					continue
				if _mine(q) and not _kept_clear(q) and _push_out(q, 0.4, false) == Vector2.ZERO:
					var sc := 0.8 + 0.5 * float(posmod(_hash_i(q), 7)) / 6.0
					(fronts["flowers"] as Array).append(Transform3D(Basis.from_scale(Vector3(1.4, 1.0, 1.1) * sc), _g3(q, top + 0.3 * sc)))
		# greenery spilling out over the pavement: from behind a hedge's wall, a bare wall, now
		# and then over the boards (never through bars or wire)
		var hs := posmod(_hash_i(Vector2(kp + 0.5, float(plot))), 1000003)
		var spill := 30 if style < 36 else (25 if style >= 78 else (12 if style < 56 else 0))
		if hs % 100 < spill:
			var nclump := 2 + (hs / 100) % 3
			for c in range(nclump):
				var u := (float(c) + 0.5 + 0.3 * (float((hs / (1000 + 97 * c)) % 10) / 9.0 - 0.5)) / float(nclump)
				var sm := lerpf(fs0, fe0, u)
				var q := _along(on_wall, cum, sm)
				var to_road := (_along(run, cum, sm) - q).normalized()
				if not _mine(q) or not walled[_seg_at(cum, sm)] or _kept_clear(q):
					continue   # (no wall to spill over: in front of shops, the open pavement; or a film shows none)
				var sc := 0.85 + 0.45 * float(posmod(_hash_i(q * 2.0), 7)) / 6.0
				var over := style >= 36 and style < 56   # (over the boards: above them, head high)
				var cy := top + (1.15 if over else 0.35 * sc)
				if cy < 1.5 and _post_twin(q + to_road * 0.45, 0.22):
					continue   # (laid already: the same wall's front from the street round the corner)
				(fronts["spill"] as Array).append(Transform3D(Basis(Vector3.UP, atan2(to_road.x, to_road.y))
					* Basis.from_scale(Vector3(1.5, 1.0, 1.2) * sc), _g3(q + to_road * 0.22, cy)))
				if cy < 1.5:
					_add_post(q + to_road * 0.45, 0.22)   # (walked round, not through)
		# a bike dropped on the pavement by the wall, one plot in thirty
		if (style < 36 or style >= 78) and (hs / 10000) % 30 == 7:
			var sm := lerpf(fs0, fe0, 0.5)
			var q := _along(lines["in"], cum, sm)
			var to_road := (_along(run, cum, sm) - q).normalized()
			var c := q + to_road * 0.45
			var d := (_along(lines["in"], cum, minf(sm + 1.0, total)) - q).normalized()
			# (off the road: where the wall's line runs into a street the wall is not laid,
			# and a dropped bike there lay 2.9 m into Shapira -- city_check)
			if _mine(c) and _clear_of_posts(c, 1.0) and _off_road(c, 0.45):
				(fronts["dropped"] as Array).append(Transform3D(Basis(Vector3.UP, atan2(-d.y, d.x))
					* Basis(Vector3.RIGHT, PI * 0.5 - 0.12), _g3(c, KERB_H + 0.05)))
				_add_post(c, 0.4)
		if not gate.is_empty():
			await _front_gate(gate, run, cum, hw, fronts)
		s = e
		plot += 1
		trim_s = trim_e
	return gates

## One plot's garden wall from a to b along the run (where the wall is: `walled`), wh high:
## rough stones (the "stonewall" tone, in `wall`), or render with a pale stone coping on top
## (fronts' "plaster" and "coping"). Its street face, its top, its ends; solid to the car.
func _garden_wall(fronts: Dictionary, wall: CBuf, lines: Dictionary, cum: PackedFloat32Array,
		walled: PackedByteArray, a: float, b: float, wh: float, plaster: bool, sgn: float) -> void:
	if b - a < 0.1:
		return
	var faces: CBuf = fronts["plaster"] if plaster else wall
	var cap: CBuf = fronts["coping"]
	var w_in: PackedVector2Array = lines["in"]
	var w_out: PackedVector2Array = lines["out"]
	var c_in: PackedVector2Array = lines["c_in"]
	var c_out: PackedVector2Array = lines["c_out"]
	for j in range(cum.size() - 1):
		if cum[j + 1] <= a or cum[j] >= b or not walled[j]:
			continue
		var L := maxf(cum[j + 1] - cum[j], 0.001)
		var t0 := (maxf(a, cum[j]) - cum[j]) / L
		var t1 := (minf(b, cum[j + 1]) - cum[j]) / L
		var i0 := w_in[j].lerp(w_in[j + 1], t0)
		var i1 := w_in[j].lerp(w_in[j + 1], t1)
		var o0 := w_out[j].lerp(w_out[j + 1], t0)
		var o1 := w_out[j].lerp(w_out[j + 1], t1)
		var e := i1 - i0
		if e.length_squared() < 0.0004:
			continue
		var fn := Vector3(-e.y, 0, e.x).normalized() * -sgn   # (out to the street)
		faces.tri(_g3(i0, 0.0), _g3(i1, 0.0), _g3(i1, wh), fn, Color.WHITE)
		faces.tri(_g3(i0, 0.0), _g3(i1, wh), _g3(i0, wh), fn, Color.WHITE)
		if not plaster:
			faces.quad3(_g3(i0, wh), _g3(i1, wh), _g3(o1, wh), _g3(o0, wh))
		var along := Vector3(e.x, 0, e.y).normalized()
		var start := t0 <= 0.0001 and j > 0 and walled[j - 1] and cum[j] > a + 0.001
		var finish := t1 >= 0.9999 and j + 1 < walled.size() - 1 and walled[j + 1] and cum[j + 1] < b - 0.001
		if not start:   # an end: its face across the wall
			faces.tri(_g3(i0, 0.0), _g3(o0, wh), _g3(o0, 0.0), -along, Color.WHITE)
			faces.tri(_g3(i0, 0.0), _g3(i0, wh), _g3(o0, wh), -along, Color.WHITE)
		if not finish:
			faces.tri(_g3(i1, 0.0), _g3(o1, 0.0), _g3(o1, wh), along, Color.WHITE)
			faces.tri(_g3(i1, 0.0), _g3(o1, wh), _g3(i1, wh), along, Color.WHITE)
		if plaster:   # the coping: a slab of pale stone, 6 cm, a little wider than the wall
			var ci0 := c_in[j].lerp(c_in[j + 1], t0)
			var ci1 := c_in[j].lerp(c_in[j + 1], t1)
			var co0 := c_out[j].lerp(c_out[j + 1], t0)
			var co1 := c_out[j].lerp(c_out[j + 1], t1)
			var y1 := wh + 0.06
			cap.quad3(_g3(ci0, y1), _g3(ci1, y1), _g3(co1, y1), _g3(co0, y1))
			cap.tri(_g3(ci0, wh), _g3(ci1, wh), _g3(ci1, y1), fn, Color.WHITE)
			cap.tri(_g3(ci0, wh), _g3(ci1, y1), _g3(ci0, y1), fn, Color.WHITE)
			if not start:
				cap.tri(_g3(ci0, wh), _g3(co0, y1), _g3(co0, wh), -along, Color.WHITE)
				cap.tri(_g3(ci0, wh), _g3(ci0, y1), _g3(co0, y1), -along, Color.WHITE)
			if not finish:
				cap.tri(_g3(ci1, wh), _g3(co1, wh), _g3(co1, y1), along, Color.WHITE)
				cap.tri(_g3(ci1, wh), _g3(co1, y1), _g3(ci1, y1), along, Color.WHITE)
		if _mine(i0):   # (every square along the street works it out: one records it)
			add_wall((i0 + o0) * 0.5, (i1 + o1) * 0.5, 0.13, false, wh < SMASH_WALL_H)

## A run side's gates: where a building's door faces this street across its garden, as the
## wall shader draws the doors -- a glazed door in the middle bay of every long ground-floor
## wall of a block (not a tower, not one on columns, not one under 10 m: _doors_of) -- the
## nearest door square to the street. [s along the run, half the opening, the door, out of
## the garden to the street (unit), how deep the garden is to the door, a yard, the run's
## piece]. Every square along the street works out the same ones (cached per run side).
var _gate_cache := {}

func _run_gates(run: PackedVector2Array, cum: PackedFloat32Array, hw: float, sgn: float, key: int,
		walled: PackedByteArray) -> Array:
	if _gate_cache.has(key):
		return _gate_cache[key]
	var back := hw + PAVE_W + 0.3   # the wall's garden face, out from the road's middle
	var seen := {}
	var cands: Array = []
	for i in range(run.size() - 1):
		var a := run[i]
		var b := run[i + 1]
		var L := a.distance_to(b)
		if L < 0.5:
			continue
		var d := (b - a) / L
		var nrm := Vector2(-d.y, d.x) * sgn
		for bi: int in _near(_bld_hash, (a + b) * 0.5 + nrm * (back + 7.0), L * 0.5 + 9.0, BLD_CELL):
			if not seen.has(bi):
				seen[bi] = true
				cands.append(bi)
	var res: Array = []
	for bi: int in cands:
		for door: Array in _doors_of(bi):
			var dp: Vector2 = door[0]
			var out: Vector2 = door[1]
			var bj := -1
			var bd := INF
			var q := Vector2.ZERO
			for j in range(run.size() - 1):
				var cp := Geometry2D.get_closest_point_to_segment(dp, run[j], run[j + 1])
				if cp.distance_to(dp) < bd:
					bd = cp.distance_to(dp)
					bj = j
					q = cp
			if bj < 0 or not walled[bj]:
				continue
			var dj := (run[bj + 1] - run[bj]).normalized()
			var nj := Vector2(-dj.y, dj.x) * sgn
			var depth := (dp - q).dot(nj) - back
			var s := cum[bj] + run[bj].distance_to(q)
			if depth < 1.2 or depth > 15.0 or out.dot(-nj) < 0.8 or s < 3.0 or s > cum[cum.size() - 1] - 3.0:
				continue
			if _push_out(q + nj * (back + depth * 0.5), 0.45, false) != Vector2.ZERO:
				continue   # a building between the street and the door
			var yard := depth >= 6.8 and posmod(_hash_i(dp * 3.0), 100) < 30
			res.append([s, 1.6 if yard else 0.75, dp, nj, depth, yard, bj])
	res.sort_custom(func(x: Array, y: Array) -> bool: return float(x[0]) < float(y[0]))
	var kept: Array = []
	for gt: Array in res:   # (one in 5 m: two doors close together share the gate)
		if kept.is_empty() or float(gt[0]) - float(kept[kept.size() - 1][0]) > 5.0:
			kept.append(gt)
	_gate_cache[key] = kept
	return kept

## where a building's ground-floor doors are, as WALL_SHADER draws them: [where, out] for
## every wall long enough for two bays (the door in its middle bay), on a block that has a
## ground floor of flats (style under 3, 10 m and taller, not raised, not on columns -- the
## same choices _build_buildings makes, worked out again here from the city's data, so every
## square finds the same doors whether or not it has built that building)
var _doors := {}

func _doors_of(bi: int) -> Array:
	if _doors.has(bi):
		return _doors[bi]
	var res: Array = []
	var all: Array = _city_data.get("buildings", [])
	if bi < all.size() and bi < _blds.size():
		var bd: Dictionary = all[bi]
		var ring: PackedVector2Array = _blds[bi]
		var n := ring.size()
		var rel := float(bd.get("_h", 0.0))
		var raised := float(bd.get("_base", 0.0))
		var hsh := _hash_i(ring[0])
		var style: int = 3 if rel > 32.0 else (0 if rel < 10.0 else [0, 0, 0, 0, 1, 1, 1, 2, 0, 1][posmod(hsh >> 7, 10)])
		var area := 0.0
		var g_lo := INF
		var g_sum := 0.0
		for i in range(n):
			area += ring[i].x * ring[(i + 1) % n].y - ring[(i + 1) % n].x * ring[i].y
			var gh := _h(ring[i])
			g_lo = minf(g_lo, gh)
			g_sum += gh
		var top := g_sum / maxf(n, 1) + rel - g_lo
		var pilotis := style <= 1 and rel >= 7.0 and rel <= 22.0 and raised == 0.0 \
			and absf(area) * 0.5 > 140.0 and posmod(hsh >> 11, 100) < 35 and not bd.has("shops") and not bd.has("_tile")
		if raised == 0.0 and not pilotis and style < 3 and top >= 10.0 and n >= 3:
			var sg := 1.0 if area > 0.0 else -1.0
			for i in range(n):
				var a := ring[i]
				var b := ring[(i + 1) % n]
				var L := a.distance_to(b)
				var bays := maxf(1.0, floorf(L / 3.3))
				if bays < 2.0:
					continue
				var e := b - a
				res.append([a.lerp(b, (floorf(bays * 0.5) + 0.5) / bays), Vector2(e.y, -e.x).normalized() * sg])
	_doors[bi] = res
	return res

## A gate in the garden wall and what goes through it: two rendered piers capped in stone,
## now and then a metal arch with bougainvillea over it, and a path of pale slabs with a
## border of white stone through the garden to the door -- or, before a deep yard, the yard
## paved and a car parked in it, nose to the building
var _yard_cars: Array = []           ## this square's cars parked in the yards: [transform, kind, key]

func _front_gate(gate: Array, run: PackedVector2Array, cum: PackedFloat32Array, hw: float, fronts: Dictionary) -> void:
	var s: float = gate[0]
	var half: float = gate[1]
	var dp: Vector2 = gate[2]
	var nj: Vector2 = gate[3]
	var depth: float = gate[4]
	var yard: bool = gate[5]
	var q := _along(run, cum, s)
	var t := Vector2(-nj.y, nj.x)
	var wall_mid := q + nj * (hw + PAVE_W + 0.175)
	var cop: CBuf = fronts["coping"]
	# no gate where its piers would stand on a road: where the wall's line crosses another
	# street's mouth or a corner the wall itself is not laid, and the piers stood up to 4 m
	# into the next street (city_check: 15 in Givatayim, 20 in Ashdod)
	for side: float in [-1.0, 1.0]:
		if not _off_road(wall_mid + t * side * (half + 0.18), 0.25):
			return
	# the piers either side
	for side: float in [-1.0, 1.0]:
		var pc := wall_mid + t * side * (half + 0.18)
		var bs := Basis(Vector3.UP, atan2(-t.y, t.x))
		var ph := 1.15 + 0.2 * float(posmod(_hash_i(dp), 3)) / 2.0
		_furn._box(fronts["plaster"], Vector3(pc.x, _h(pc) + ph * 0.5 - 0.1, pc.y), Vector3(0.36, ph + 0.2, 0.36), Color.WHITE, bs)
		_furn._box(cop, Vector3(pc.x, _h(pc) + ph + 0.03, pc.y), Vector3(0.44, 0.06, 0.44), Color.WHITE, bs)
		if _mine(pc):
			_add_post(pc, 0.2)
	# the path, or the yard: pale slabs laid square to it (their way in the vertex green, kept
	# through the batching: _batch_buf), from the pavement's back down to the door
	var w := half - 0.12 if yard else 0.65
	var start := q + nj * (hw + PAVE_W + 0.02)
	var end := q + nj * (hw + PAVE_W + 0.3 + depth)
	var lay := Color(0.0, fposmod(atan2(nj.y, nj.x), PI) / PI, 0.0, 0.0)
	var steps := maxi(1, int(ceil((depth + 0.3) / 2.5)))
	var path: CBuf = fronts["path"]
	_grass_cut((start + end) * 0.5, nj, (depth + 0.28) * 0.5 + 0.1, w + 0.15)
	for k in range(steps):
		var u0 := float(k) / steps
		var u1 := float(k + 1) / steps
		var p0 := start.lerp(end, u0)
		var p1 := start.lerp(end, u1)
		var y0 := lerpf(KERB_H + 0.005, 0.09, u0)
		var y1 := lerpf(KERB_H + 0.005, 0.09, u1)
		path.tri(_g3(p0 - t * w, y0), _g3(p0 + t * w, y0), _g3(p1 + t * w, y1), Vector3.UP, lay)
		path.tri(_g3(p0 - t * w, y0), _g3(p1 + t * w, y1), _g3(p1 - t * w, y1), Vector3.UP, lay)
		for side: float in [-1.0, 1.0]:   # its border, a row of white stones a little proud of it
			var a0 := p0 + t * side * w
			var a1 := p1 + t * side * w
			var b0 := a0 + t * side * 0.12
			var b1 := a1 + t * side * 0.12
			cop.quad3(_g3(a0, y0 + 0.02), _g3(a1, y1 + 0.02), _g3(b1, y1 + 0.02), _g3(b0, y0 + 0.02))
			var fo := Vector3(t.x * side, 0, t.y * side)
			cop.tri(_g3(b0, -0.02), _g3(b1, -0.02), _g3(b1, y1 + 0.02), fo, Color.WHITE)
			cop.tri(_g3(b0, -0.02), _g3(b1, y1 + 0.02), _g3(b0, y0 + 0.02), fo, Color.WHITE)
	var hk := posmod(_hash_i(dp * 7.0), 100)
	if yard:
		# a car in the yard, nose to the building, if it is clear
		var c := q + nj * (hw + PAVE_W + 0.3 + 3.3)
		if _mine(c) and depth >= 6.8 and not _kept_clear(c) and _push_out(c, 1.1, false) == Vector2.ZERO \
				and _push_out(c + nj * 1.4, 1.0, false) == Vector2.ZERO and _clear_of_posts(c, 2.2):
			_yard_cars.append([Transform3D(Basis(Vector3.UP, atan2(nj.x, nj.y)), _g3(c, 0.08)), CAR_MIX[hk % CAR_MIX.size()], hk])
			_add_car_posts(c, nj)
			_ao_car(c, nj, 0.12)
	elif hk < 35 and not _kept_clear(wall_mid):
		# a metal arch over the gate, bougainvillea grown over it
		var col: Color = _tone["railing"]
		var feet: Array = []
		for side: float in [-1.0, 1.0]:
			var f := wall_mid + t * side * (half - 0.05) + nj * 0.25
			feet.append(f)
			_furn._tube(fronts["planks"], _g3(f, 0.0), _g3(f, 2.35), 0.03, 0.03, col, 5)
			if _mine(f):
				_add_post(f, 0.06)
				(fronts["flowers"] as Array).append(Transform3D(Basis.from_scale(Vector3(0.7, 1.3, 0.7)), _g3(f, 1.3)))
		_furn._tube(fronts["planks"], _g3(feet[0], 2.35), _g3(feet[1], 2.35), 0.03, 0.03, col, 5)
		for u: float in [0.2, 0.5, 0.8]:
			var m: Vector2 = (feet[0] as Vector2).lerp(feet[1], u)
			if _mine(m):
				(fronts["flowers"] as Array).append(Transform3D(Basis.from_scale(Vector3(1.0, 0.8, 1.2) * 0.9), _g3(m, 2.45)))
	if _over():
		await _pause()

## horizontal wooden boards with thin gaps between, on posts, from `base` above the ground up
## `h`, from a to b (as details.gd's filmed wooden fences; the boards' tones vary a little)
func _plank_fence(b: CBuf, a: Vector2, e: Vector2, base: float, h: float) -> void:
	var L := a.distance_to(e)
	var d := (e - a) / L
	var gy := minf(_h(a), _h(e))   # (level boards: on a slope the low end's foot is in the wall)
	var bs := Basis(Vector3.UP, atan2(-d.y, d.x))
	var mid := (a + e) * 0.5
	var wood: Color = _tone["woodfence"]
	_plank_at.append(mid)
	var y := base
	var k := 0
	while y + 0.12 <= base + h + 0.01:
		_furn._box(b, Vector3(mid.x, gy + y + 0.06, mid.y), Vector3(L, 0.12, 0.03), wood.darkened(0.08 * float(k % 3)), bs)
		y += 0.145
		k += 1
	var s := 0.0
	while s <= L:
		var p := a + d * s
		_furn._box(b, Vector3(p.x, gy + base + h * 0.5, p.y), Vector3(0.08, h, 0.08), wood.darkened(0.2), bs)
		s += 1.8

## Light grey setts laid in a street's darker paving, as a filmed shopping street has them by
## its cafes: a half-circle fan round each street tree on the building side, three rows of
## small square setts with the paving showing in the joints, and a band two setts wide
## along the line of trees between them. Each sett a little lighter or darker than the next.
func _sett(b: CBuf, c: Vector2, u: Vector2, size: float) -> void:
	var v := Vector2(-u.y, u.x)
	var h := size * 0.5
	var col: Color = _tone["concrete"].lightened(0.28).darkened(0.1 * float(posmod(_hash_i(c * 13.0), 3)))
	var y := KERB_H + 0.004
	b.quad3(_g3(c - u * h - v * h, y), _g3(c + u * h - v * h, y), _g3(c + u * h + v * h, y), _g3(c - u * h + v * h, y), col)

func _sett_fan(b: CBuf, p: Vector2, out: Vector2) -> void:
	for rr: float in [0.8, 0.95, 1.1]:
		var n := int(PI * rr / 0.145)
		for i in range(n + 1):
			var a := -PI * 0.5 + PI * float(i) / float(n)
			var u := out.rotated(a)
			_sett(b, p + u * rr, u, 0.12)

func _sett_band(b: CBuf, a: Vector2, e: Vector2) -> void:
	var d := (e - a).normalized()
	var v := Vector2(-d.y, d.x)
	var L := a.distance_to(e)
	var t := 1.2
	while t < L - 1.2:
		for w: float in [-0.075, 0.075]:
			_sett(b, a + d * t + v * w, d, 0.12)
		t += 0.145

## how many trees overhang a spot on the pavement, 0..1 (for the leaves on it)
func _leafy(p: Vector2) -> float:
	var sum := 0.0
	for i: int in _near(_post_hash, p, 7.0, BLD_CELL):
		if absf(_post_r[i] - 0.3) < 0.001:   # (a tree's post)
			sum += 1.0 - clampf(_posts[i].distance_to(p) / 7.0, 0.0, 1.0)
	return clampf(sum * 0.7, 0.0, 1.0)

## which piece of a line `s` metres along it is on (cum: the distance to each point)
func _seg_at(cum: PackedFloat32Array, s: float) -> int:
	for i in range(1, cum.size()):
		if cum[i] >= s:
			return i - 1
	return cum.size() - 2

## the point `dist` metres along a road's points from index k going `step`, and the way on
func _walk_pts(pts: PackedVector2Array, k: int, step: int, dist: float) -> Array:
	var left := dist
	while k + step >= 0 and k + step < pts.size():
		var seg := pts[k].distance_to(pts[k + step])
		var d := (pts[k + step] - pts[k]) / maxf(seg, 0.001)
		if seg >= left:
			return [pts[k] + d * left, d, true]
		left -= seg
		k += step
	return [pts[k], Vector2.ZERO, false]

## The corners of every junction: between each road coming in and the next one round, a
## kerb that curves from one street's edge to the other's (red and white in Israel: no
## stopping at a corner), its pavement behind it, and the asphalt filled out to it. Across
## the mouth of a T, a straight kerb; between the two halves of a divided road, a flat nose.
var _corner_cut_at: Array = []        ## corners laid piece by piece: [middle, middle clear] (for tests)

## A junction's corners, worked out from its kerbed arms: one per pair of arms next to each
## other round it -- [index, A's road, P (A's right edge at the cut), Q (B's left edge), the
## curve's corner point X (or null), whether it is rounded, A's and B's ways out]. [] when the
## point is not a junction of three kerbed ways or more.
func _corners_at(ni: int, count := false) -> Array:
	var out: Array = []
	if _kerb_arms(ni) < 3:
		return out
	var c := _nodes[ni]
	var cut := _node_r[ni] + KERB_CUT
	var arms: Array = []   # [angle, point at the cut, way out there, half width, road]
	var through: Array = []   # the ways out of pieces too short for a corner of their own
	for e: Vector2i in _node_roads[ni]:
		var r: Dictionary = _roads[e.x]
		if not _kerbed(r):
			continue
		var pts: PackedVector2Array = r["pts"]
		for step: int in [-1, 1]:
			if e.y + step < 0 or e.y + step >= pts.size():
				continue
			var at: Array = _walk_pts(pts, e.y, step, cut)
			if not at[2]:
				var q := pts[e.y + step]
				through.append(atan2(q.y - c.y, q.x - c.x))
				continue   # too short to reach the corner (a piece across a median)
			var p: Vector2 = at[0]
			arms.append([atan2(p.y - c.y, p.x - c.x), p, at[1], float(r["w"]) * 0.5, e.x, step])
	if arms.size() < 2:
		return out
	arms.sort_custom(func(x, y): return x[0] < y[0])
	for i in range(arms.size()):
		var A: Array = arms[i]
		var B: Array = arms[(i + 1) % arms.size()]
		var gap: float = fposmod(float(B[0]) - float(A[0]), TAU)
		if gap > 3.6 or gap < 0.02:
			continue
		# no corner across a road that goes out between the two: on a divided road's median
		# side, the piece of the cross street through the median. (Laid anyway, it ran
		# straight across the opening; cut up where it lay on the asphalt, what was left
		# stood out of the island's end as an arrowhead and spikes.)
		var crossed := false
		for ang: float in through:
			var into := fposmod(ang - float(A[0]), TAU)
			if into > 0.05 and into < gap - 0.05:
				crossed = true
				break
		if crossed:
			if count and _mine(c):
				_tally("corners_across_roads", 1)
			continue
		# none on a narrow median's side: it ends square, closed by its own kerb (_kerb_cap).
		# P is A's inner side when its traffic comes in to the junction, Q B's when it goes out
		var ra: Dictionary = _roads[int(A[4])]
		var rb: Dictionary = _roads[int(B[4])]
		if (_narrow_median(ra) and int(A[5]) * int(ra["o"]) < 0) or (_narrow_median(rb) and int(B[5]) * int(rb["o"]) > 0):
			if count and _mine(c):
				_tally("corners_on_a_median", 1)
			continue
		var ua: Vector2 = A[2]
		var ub: Vector2 = B[2]
		var P: Vector2 = (A[1] as Vector2) + Vector2(-ua.y, ua.x) * float(A[3])   # A's right edge
		var Q: Vector2 = (B[1] as Vector2) + Vector2(ub.y, -ub.x) * float(B[3])   # B's left edge
		if P.distance_to(Q) > 45.0:
			continue
		# none into a slip road's island: it has its own kerb all round (_find_link_islands)
		if not _link_rings.is_empty():
			var mid := (P + Q) * 0.5
			if _in_link_island(mid + (mid - c).normalized() * 1.5):
				if count and _mine(c):
					_tally("corners_on_a_link_island", 1)
				continue
		var X = Geometry2D.line_intersects_line(P, ua, Q, ub)
		var round := X != null and gap > 0.35 and gap < 2.9 and (X as Vector2).distance_to(c) < cut * 2.5 \
			and ((X as Vector2) - P).dot(ua) < 0.0 and ((X as Vector2) - Q).dot(ub) < 0.0
		out.append([i, int(A[4]), P, Q, X, round, ua, ub])
	return out

func _narrow_median(r: Dictionary) -> bool:
	return r.has("median") and float(r["median"]) >= 0.25 and float(r["median"]) < MEDIAN_ROUND

## the rounded corners' curve: from P to Q, bent toward the corner point X
func _corner_curve(P: Vector2, X: Vector2, Q: Vector2) -> PackedVector2Array:
	var curve := PackedVector2Array()
	for k in range(7):
		var t := k / 6.0
		curve.append(P * (1.0 - t) * (1.0 - t) + X * 2.0 * (1.0 - t) * t + Q * t * t)
	return curve

## Before anything stands in a square (trees go in before the kerbs): every rounded corner
## that reaches it noted in _corner_fill, so _off_road keeps all of it off their asphalt
func _note_corner_fills() -> void:
	for ni: int in _nodes_near(60.0):
		if _over():
			await _pause()
		for cn: Array in _corners_at(ni):
			var key: int = ni * 16 + int(cn[0])
			if not cn[5] or _corner_fill.has(key):
				continue
			var poly := PackedVector2Array([cn[4]])
			poly.append_array(_corner_curve(cn[2], cn[4], cn[3]))
			_corner_fill[key] = poly
			_hash_add(_fill_hash, _bld_box_of(poly), BLD_CELL, key)

func _kerb_corners(kerb: Buf, pave: Buf, fill: Buf, col: Color) -> void:
	for ni: int in _nodes_near(60.0):   # (every square a corner reaches works it out)
		if _over():
			await _pause()
		var c := _nodes[ni]
		for cn: Array in _corners_at(ni, true):
			var i: int = cn[0]
			var P: Vector2 = cn[2]
			var Q: Vector2 = cn[3]
			var X = cn[4]
			var round: bool = cn[5]
			_laid_by = -2 - (ni * 16 + i)
			_set_pave_code(_hash_i((_roads[int(cn[1])]["pts"] as PackedVector2Array)[0]), (_roads[int(cn[1])] as Dictionary).get("pave", []))   # (the paving of one of its streets)
			var curve := PackedVector2Array()
			if round:
				curve = _corner_curve(P, X, Q)
				# the asphalt out to the curve (the two streets' edges met in a sharp corner)
				var xg := _g3(X, Y_ROAD)
				for k in range(6):
					fill.tri(xg, _g3(curve[k], Y_ROAD), _g3(curve[k + 1], Y_ROAD), Vector3.UP, Color.WHITE)
			else:
				var n := maxi(1, ceili(P.distance_to(Q) / 3.0))
				for k in range(n + 1):
					curve.append(P.lerp(Q, float(k) / n))
			# a look along the corner: clear (nearly always), it goes in whole; else piece by
			# piece, leaving out what lies on another road. (One look at its middle let a kerb
			# straight across a road's mouth in whole wherever its middle happened to miss
			# the asphalt -- a strip of pavement across the junction.)
			var whole := true
			for k in range(curve.size()):
				var kt := (curve[mini(k + 1, curve.size() - 1)] - curve[maxi(k - 1, 0)]).normalized()
				var kn := Vector2(-kt.y, kt.x)
				if kn.dot(curve[k] - c) < 0.0:
					kn = -kn
				if _asphalt_other(curve[k] + kn * KERB_W * 0.5, -1) \
						or (k == curve.size() / 2 and _asphalt_other(curve[k] + kn * (KERB_W + PAVE_W * 0.5), -1)):
					whole = false
					break
			if not whole and _mine(c):
				# (and whether the one look at its middle would have let it in whole)
				var m := curve.size() / 2
				var mt := (curve[m] - curve[m - 1]).normalized()
				var mn := Vector2(-mt.y, mt.x) * (1.0 if Vector2(-mt.y, mt.x).dot(curve[m] - c) >= 0.0 else -1.0)
				_corner_cut_at.append([curve[m], not _asphalt_other(curve[m] + mn * KERB_W * 0.5, -1) \
					and not _asphalt_other(curve[m] + mn * (KERB_W + PAVE_W * 0.5), -1)])
			var along := 0.0
			for k in range(curve.size() - 1):
				var a := curve[k]
				var b := curve[k + 1]
				var tg := b - a
				if tg.length_squared() < 0.0001:
					continue
				var nrm := Vector2(-tg.y, tg.x).normalized()
				if nrm.dot((a + b) * 0.5 - c) < 0.0:
					nrm = -nrm
				if whole:
					_kerb_piece(kerb, pave, a, b, nrm, nrm, PAVE_W, col, along)
				else:
					_kerb_run_piece(kerb, pave, -1, a, b, nrm, nrm, PAVE_W, col, along, a.distance_to(b))
				along += a.distance_to(b)

## The asphalt a rounded corner adds out to its curve (_kerb_corners), which no road's width
## covers: bollards by a zebra near a junction and sign poles at the corner, checked against
## the roads alone, stood out in it, in front of the kerb. _off_road counts it as road. Noted
## for every corner reaching a square before anything is built in it (_note_corner_fills),
## kept for the whole city: ni * 16 + corner -> [the corner point, the curve...].
var _corner_fill := {}
var _fill_hash := {}

## p is on (or within `margin` of the kerb of) a rounded corner's asphalt
func _in_corner_fill(p: Vector2, margin: float) -> bool:
	for key: int in _near(_fill_hash, p, margin + 0.5, BLD_CELL):
		var poly: PackedVector2Array = _corner_fill[key]
		if Geometry2D.is_point_in_polygon(p, poly):
			return true
		for k in range(1, poly.size() - 1):
			if Geometry2D.get_closest_point_to_segment(p, poly[k], poly[k + 1]).distance_to(p) < margin + KERB_W:
				return true
	return false

## p moved out of any rounded corner's asphalt it is on (or within `margin` of the kerb of):
## from the corner's point through p, across the curve and `margin` past its kerb -- onto the
## corner's pavement. p itself when it is on none.
## p moved off every street's asphalt -- the straight strips and the rounded corners -- far
## enough that a body of half-width r there stays clear of it (as city_check's "on the road"
## measures). For things placed by hand from a film or a survey: the spot is right to a few
## metres, the game's road a guess at its width, and a bin at a corner stood 1.2 m into Sirkin.
func _off_asphalt(p: Vector2, r: float) -> Vector2:
	for _k in range(3):
		p = _out_of_corner(p, r)
		var hit := _nearest_seg(p, 20.0, true, false)
		if hit.is_empty() or float(hit["edge"]) >= r:
			break
		var away := p - (hit["q"] as Vector2)
		if away.length() < 0.01:
			break
		p += away.normalized() * (r - float(hit["edge"]) + 0.05)
	return p

func _out_of_corner(p: Vector2, margin: float) -> Vector2:
	for key: int in _near(_fill_hash, p, margin + 0.5, BLD_CELL):
		var poly: PackedVector2Array = _corner_fill[key]
		var x := poly[0]
		var inside := Geometry2D.is_point_in_polygon(p, poly)
		var near := false
		for k in range(1, poly.size() - 1):
			if Geometry2D.get_closest_point_to_segment(p, poly[k], poly[k + 1]).distance_to(p) < margin + KERB_W:
				near = true
		if not inside and not near:
			continue
		var dir := (p - x).normalized() if p.distance_to(x) > 0.05 else ((poly[1] + poly[poly.size() - 1]) * 0.5 - x).normalized()
		for k in range(1, poly.size() - 1):
			var hit = Geometry2D.segment_intersects_segment(x, x + dir * 200.0, poly[k], poly[k + 1])
			if hit != null:
				return (hit as Vector2) + dir * (KERB_W + margin)
	return p

func _retint_kerbs() -> void:
	if _roof_mat != null:
		_roof_mat.set_shader_parameter("tone", _tone["roof"])
	if _kerb_mat == null:
		return
	_kerb_mat.set_shader_parameter("plain", _tone["kerb"])
	_kerb_mat.set_shader_parameter("white", Palette.col("ink"))
	# the kerb paint is vivid, as it is on the street, but red rather than the palette's pink
	# (its hue pinned too: from the palette's hazard it came out pink-and-white beside a filmed
	# red-and-white kerb)
	var hz := Palette.col("hazard")
	_kerb_mat.set_shader_parameter("red", Color.from_hsv(0.995, clampf(hz.s, 0.65, 0.9), clampf(hz.v * 0.8, 0.5, 0.8)))
	# and the blue a road paint's blue, not the palette's cyan (beside a filmed street the
	# game's blue-white kerb read as turquoise-white): the hue pinned, its strength the palette's
	var pl := Palette.col("player")
	_kerb_mat.set_shader_parameter("blue", Color.from_hsv(0.6, clampf(pl.s, 0.55, 0.8), clampf(pl.v * 0.62, 0.45, 0.68)))
	_kerb_mat.set_shader_parameter("yellow", Palette.col("warn"))
	_kerb_mat.set_shader_parameter("black", Palette.col("bg"))
	_kerb_mat.set_shader_parameter("pave", _tone["pavement"])
	_kerb_mat.set_shader_parameter("iron", _tone["metal"])
	_kerb_mat.set_shader_parameter("med", 0.0 if String(_place.get("look", "")) == "north" else 1.0)

## a street's stretches between junctions, each cut short where it meets one (so kerbs
## and walls leave the corner open), points every few metres
## A road's stretches between the places it meets others, trimmed back from them. For kerbs
## (`kerbs`): only real junctions (three or more kerbed ways) cut them, trimmed `extra` metres
## past the junction's middle road edge, so the corner can be rounded; where two OSM pieces
## of the same street join, or a driveway comes in, the kerb runs on.
func _street_runs(r: Dictionary, extra := 2.0, kerbs := false) -> Array:
	var pts: PackedVector2Array = r["pts"]
	var ids: PackedInt32Array = r["ids"]
	var out: Array = []
	var start := 0
	var cuts := func(n: int) -> bool:
		return _kerb_arms(n) >= 3 if kerbs else (_node_roads[n] as Array).size() >= 2
	for i in range(1, pts.size()):
		var junction: bool = cuts.call(ids[i])
		if junction or i == pts.size() - 1:
			var run := PackedVector2Array()
			for k in range(start, i + 1):
				run.append(pts[k])
			var cut_a := _node_r[ids[start]] + extra if cuts.call(ids[start]) else 0.0
			var cut_b := _node_r[ids[i]] + extra if junction else 0.0
			var trimmed := _trim(run, cut_a, cut_b)
			if trimmed.size() >= 2:
				out.append(trimmed)
			start = i
	return out

## the polyline from `a` metres in to `b` metres short of its end
func _trim(run: PackedVector2Array, a: float, b: float) -> PackedVector2Array:
	var cum := PackedFloat32Array([0.0])
	for i in range(1, run.size()):
		cum.append(cum[i - 1] + run[i - 1].distance_to(run[i]))
	var total := cum[cum.size() - 1]
	var out := PackedVector2Array()
	if total - a - b < 2.0:
		return out
	# the street's own corners, plus points often enough to follow the ground's detail
	var step := maxf(6.0, _hstep * 0.7) if _hnx > 0 else INF
	out.append(_along(run, cum, a))
	var s := a
	for i in range(1, run.size() - 1):
		while s + step < cum[i] and s + step < total - b:
			s += step
			out.append(_along(run, cum, s))
		if cum[i] > a and cum[i] < total - b:
			out.append(run[i])
			s = cum[i]
	while s + step < total - b:
		s += step
		out.append(_along(run, cum, s))
	out.append(_along(run, cum, total - b))
	return out

## a polyline moved sideways by d (right of travel for d > 0), mitred at the bends
func _offset_line(pts: PackedVector2Array, d: float) -> PackedVector2Array:
	var out := PackedVector2Array()
	var n := pts.size()
	for i in range(n):
		var d_in := (pts[i] - pts[i - 1]).normalized() if i > 0 else Vector2.ZERO
		var d_out := (pts[i + 1] - pts[i]).normalized() if i < n - 1 else Vector2.ZERO
		var t := d_in + d_out
		if t.length_squared() < 0.0001:
			t = d_out if d_out != Vector2.ZERO else d_in
		t = t.normalized()
		var side := Vector2(-t.y, t.x)
		var m := 1.0
		if i > 0 and i < n - 1:
			m = 1.0 / maxf(side.dot(Vector2(-d_out.y, d_out.x)), 0.5)
		out.append(pts[i] + side * d * m)
	return out

## a strip of half-width hw along a polyline, mitred at the bends
func _ribbon(buf: Buf, pts: PackedVector2Array, hw: float, y: float) -> void:
	if _hnx > 0:   # on hills: a point every 5 m so the road follows the ground
		var dense := PackedVector2Array([pts[0]])
		for i in range(1, pts.size()):
			var L := pts[i - 1].distance_to(pts[i])
			var parts := maxi(1, ceili(L / 5.0))
			for k in range(1, parts + 1):
				dense.append(pts[i - 1].lerp(pts[i], float(k) / parts))
		pts = dense
	var n := pts.size()
	if n < 2:
		return
	var left := PackedVector2Array()
	var right := PackedVector2Array()
	for i in range(n):
		var d_in := (pts[i] - pts[i - 1]).normalized() if i > 0 else Vector2.ZERO
		var d_out := (pts[i + 1] - pts[i]).normalized() if i < n - 1 else Vector2.ZERO
		var d := d_in + d_out
		if d.length_squared() < 0.0001:
			d = d_out if d_out != Vector2.ZERO else d_in
		d = d.normalized()
		var side := Vector2(-d.y, d.x)
		var m := 1.0
		if i > 0 and i < n - 1:
			m = 1.0 / maxf(side.dot(Vector2(-d_out.y, d_out.x)), 0.5)
		left.append(pts[i] - side * hw * m)
		right.append(pts[i] + side * hw * m)
	var hl := _ground_line(left)
	var hr := _ground_line(right)
	for i in range(n - 1):
		buf.quad3(Vector3(left[i].x, hl[i] + y, left[i].y), Vector3(left[i + 1].x, hl[i + 1] + y, left[i + 1].y),
			Vector3(right[i + 1].x, hr[i + 1] + y, right[i + 1].y), Vector3(right[i].x, hr[i] + y, right[i].y))

func _disc(buf: Buf, c: Vector2, r: float, y: float, seg := 14) -> void:
	var mid := _g3(c, y)
	var rim: Array = []
	for i in range(seg):
		rim.append(_g3(c + Vector2(cos(TAU * i / seg), sin(TAU * i / seg)) * r, y))
	for i in range(seg):
		var p0: Vector3 = rim[i]
		var p1: Vector3 = rim[(i + 1) % seg]
		var nrm := (p0 - mid).cross(p1 - mid)
		if nrm.y < 0.0:
			nrm = -nrm
		buf.tri(mid, p0, p1, nrm.normalized() if nrm.length_squared() > 0.0 else Vector3.UP, Color.WHITE)

## Cast iron in the road: a manhole cover every 55-95 m down a street, somewhere in its
## width, and a drain grate at the kerb every 40-65 m, on alternate sides -- flat on the
## asphalt, clear of the junctions, merged into the ground like the paint. Kept to a few
## triangles each: a big city has thousands.
func _street_metal(metal: Buf, rim: Buf, ri: int) -> void:
	var r: Dictionary = _roads[ri]
	if not r["drive"] or HIGHWAYS.has(r["k"]) or r["k"] == "service":
		return
	var rng := RandomNumberGenerator.new()
	rng.seed = hash(_city_name) + 77 + ri * 7919   # the road's own: every square works it out alike
	var y := Y_MARK + 0.004
	var pts: PackedVector2Array = r["pts"]
	var w: float = r["w"]
	var cum := PackedFloat32Array([0.0])
	for i in range(1, pts.size()):
		cum.append(cum[i - 1] + pts[i - 1].distance_to(pts[i]))
	var total := cum[cum.size() - 1]
	var clear: Array = []   # the junctions along it: (distance along, how far to keep off)
	var ids: PackedInt32Array = r["ids"]
	for i in range(ids.size()):
		if (_node_roads[ids[i]] as Array).size() >= 2:
			clear.append(Vector2(cum[i], _node_r[ids[i]] + 1.5))
	var span := _near_span(pts, cum, 20.0)
	var s := rng.randf_range(10.0, 40.0)
	while s < total - 4.0:
		if _clear_of(clear, s):
			var off := rng.randf_range(-0.25, 0.25)
			if s < span.x - 2.0 or s > span.y + 2.0:
				s += rng.randf_range(55.0, 95.0)
				continue
			var a := _along(pts, cum, s)
			var d := (_along(pts, cum, minf(s + 1.0, total)) - a).normalized()
			var at := a + Vector2(-d.y, d.x) * w * off
			_disc(rim, at, 0.36, y, 8)
			_disc(metal, at, 0.31, y + 0.002, 8)
			_note_cover(at, 0.33)
			if _mine(at):
				_tally("manholes", 1)
		s += rng.randf_range(55.0, 95.0)
	if not _kerbed(r):
		return
	var sg := 1.0 if rng.randf() < 0.5 else -1.0
	s = rng.randf_range(6.0, 25.0)
	while s < total - 3.0:
		if _clear_of(clear, s) and s > span.x - 2.0 and s < span.y + 2.0:
			var a := _along(pts, cum, s)
			var d := (_along(pts, cum, minf(s + 1.0, total)) - a).normalized()
			var side := Vector2(-d.y, d.x) * sg
			var c := a + side * (w * 0.5 - 0.32)
			_flat_rect(rim, c, d, side, 0.9, 0.46, y)
			_flat_rect(metal, c, d, side, 0.78, 0.34, y + 0.002)
			_note_cover(c, 0.38)
			if _mine(c):
				_tally("drains", 1)
		s += rng.randf_range(40.0, 65.0)
		sg = -sg

## The road's cast iron as a wheel feels it: a manhole cover or a drain grate sits a little
## proud of (or sunk in) the asphalt, and a wheel going over it knocks the body -- yours (a
## nudge of the nose and the side it is on, a soft clunk) and the traffic's near you (a dip).
var _covers := {}                     ## COVER_CELL cell -> [Vector3(x, z, radius)]
var _cover_keys := {}                 ## (each once: a square built again would add it again)
var _cover_on := [false, false, false, false]   ## each of your wheels on one now
const COVER_CELL := 4.0

func _note_cover(at: Vector2, r: float) -> void:
	var key := Vector2i(roundi(at.x * 10.0), roundi(at.y * 10.0))
	if _cover_keys.has(key):
		return
	_cover_keys[key] = true
	var c := Vector2i(floori(at.x / COVER_CELL), floori(at.y / COVER_CELL))
	if not _covers.has(c):
		_covers[c] = []
	(_covers[c] as Array).append(Vector3(at.x, at.y, r))

## the cover under p: 1 a manhole (it knocks), 0.6 a grate, 0 none
func cover_under(p: Vector2) -> float:
	var c := Vector2i(floori(p.x / COVER_CELL), floori(p.y / COVER_CELL))
	for dx in range(-1, 2):
		for dy in range(-1, 2):
			for cv: Vector3 in _covers.get(c + Vector2i(dx, dy), []):
				if p.distance_squared_to(Vector2(cv.x, cv.y)) < cv.z * cv.z:
					# most sit flush and are not felt: one manhole in three stands proud or sunk,
					# one grate in four (by its place: the same ones every drive). Every one
					# knocked made Tel Aviv's wide streets "pretty bumpy" -- a knock every 75 m
					# in the kerb lane, 13 a km (tests/drive_bumps.gd, 22 Nov)
					var felt := posmod(hash(Vector2i(roundi(cv.x * 10.0), roundi(cv.y * 10.0))), 12)
					if cv.z < 0.35:
						return 1.0 if felt < 4 else 0.0
					return 0.6 if felt < 3 else 0.0
	return 0.0

func _cover_tick() -> void:
	if _covers.is_empty() or _walking or _air or absf(_v) < 1.0:
		return
	var fwd := _fwd()
	var side := Vector2(-fwd.y, fwd.x)
	for k in range(4):
		var wheel := _pos + fwd * (WHEELBASE * 0.5 if k < 2 else -WHEELBASE * 0.5) + side * (0.78 if k % 2 == 0 else -0.78)
		var on := cover_under(wheel)
		if (on > 0.0) != bool(_cover_on[k]):
			_cover_on[k] = on > 0.0
			if on > 0.0:
				var j := clampf(absf(_v) / 14.0, 0.15, 1.0) * on
				_pitch = clampf(_pitch + (-0.014 if k < 2 else 0.011) * j, -0.12, 0.12)
				_roll = clampf(_roll + (0.012 if k % 2 == 0 else -0.012) * j, -0.1, 0.1)
				shake3d(0.15 + 0.35 * j)
				Audio.play("impact_soft", 0.15, -24.0 + 6.0 * j)
				Probe.event("cover", {"kmh": int(absf(_v) * 3.6)})

## An Israeli town's walls, as a walk through Givatayim films them: the blocks of the 1950s to
## the 70s (most of it) in sand and beige plaster gone dull, the older ones cream, the new
## ones white or clad in stone; OSM's own colour wherever a building has one. Returns (tk,
## stone): WALL_SHADER's plaster pick and its lean toward the stone tone -- under 0.8 a
## render the colour of it, 0.8 and over cut stone in courses.
func _med_plaster(bd: Dictionary, hsh: int, tk: int) -> Vector2:
	var u := float(posmod(hsh >> 5, 97)) / 96.0
	var pick := posmod(hsh >> 13, 100)
	var oc := String(bd.get("col", ""))
	if oc.begins_with("#") and (oc.length() == 7 or oc.length() == 4):
		var c := Color.html(oc)   # (the data's colour, mapped onto the palette's wall tones)
		if c.s < 0.12:
			return Vector2(0, 0.05) if c.v > 0.8 else Vector2(4, 0.0)
		if c.h > 0.05 and c.h < 0.17 and c.s < 0.6:
			return Vector2(0, 0.55 + 0.2 * c.s)   # wheat, tan, beige
		if c.h > 0.1 and c.h < 0.19:
			return Vector2(2, 0.1)                # yellow
		if c.h < 0.1 or c.h > 0.88:
			return Vector2(3, 0.1)                # pink, peach, terracotta
		return Vector2(1, 0.0)                    # blue, green: a pastel
	var yr := int(bd.get("yr", 0))
	if yr >= 2000:
		return Vector2(0, 0.08 * u) if pick < 55 else (Vector2(0, 0.86 + 0.06 * u) if pick < 80 else Vector2(4, 0.0))
	if yr >= 1980:
		return Vector2(0, 0.3 + 0.3 * u) if pick < 50 else (Vector2(0, 0.86 + 0.06 * u) if pick < 70 else Vector2(0, 0.1))
	if yr > 0 and yr < 1950:
		return Vector2(0, 0.12 + 0.2 * u) if pick < 80 else Vector2(2, 0.05)
	if yr > 0:
		return Vector2(0, 0.46 + 0.28 * u) if pick < 75 else (Vector2(2, 0.15) if pick < 85 else Vector2(0, 0.18 + 0.12 * u))
	# (no year: much the same, with the odd colour the old mix had)
	if pick < 55:
		return Vector2(0, 0.42 + 0.32 * u)
	if pick < 75:
		return Vector2(0, 0.1 + 0.2 * u)
	if pick < 83:
		return Vector2(0, 0.88)
	return Vector2(tk, 0.1) if tk > 0 else Vector2(0, 0.04)

func _clear_of(clear: Array, s: float) -> bool:
	for c: Vector2 in clear:
		if absf(s - c.x) < c.y:
			return false
	return true

## a flat rectangle on the ground at c, `along` x `across` metres, along d
func _flat_rect(buf: Buf, c: Vector2, d: Vector2, side: Vector2, along: float, across: float, y: float) -> void:
	var a := d * along * 0.5
	var b := side * across * 0.5
	buf.quad3(_g3(c - a - b, y), _g3(c + a - b, y), _g3(c + a + b, y), _g3(c - a + b, y))

## dashed white lines: down the middle of a two-way street, between lanes of a one-way
## Paint along a road. Two-way: a centre line (white dashes in Givatayim; in Nova Scotia
## yellow -- a solid double line on main roads, dashed on side streets). One-way with
## lanes: white dashes between them. Main roads in the north also get solid white edge
## lines; so do motorways everywhere. No paint across junctions.
const MAIN_ROADS := {"motorway": true, "trunk": true, "primary": true, "secondary": true, "tertiary": true}
const BUS_WORD_STEP := 45.0          ## a bus lane's word, painted down it this often
var _bus_words := 0                  ## how many were painted (for the tests)
var _bus_word_at: Array = []         ## where the first few are, and the way each reads (for the tests)

func _markings(buf: Buf, r: Dictionary, yellow: Buf) -> void:
	if not r["drive"] or r["k"] == "service":
		return
	var w: float = r["w"]
	var pts: PackedVector2Array = r["pts"]
	var north := String(_place.get("look", "")) == "north"
	var main: bool = MAIN_ROADS.has(r["k"])
	var lines: Array = []   # [offset, solid, yellow]
	if r["o"] == 0:
		if w >= 6.5 or north:
			if north and main:
				lines = [[-0.12, true, true], [0.12, true, true]]
			else:
				lines = [[0.0, false, north]]
	else:
		var lanes: int = r["l"]
		for i in range(1, lanes):
			lines.append([-w * 0.5 + w * i / lanes, false, false])
	if (north and main) or r["k"] in ["motorway", "trunk"]:
		for sg: float in [-1.0, 1.0]:
			lines.append([sg * (w * 0.5 - 0.35), true, false])
	# a bus lane: a wide solid line between it and the lanes beside it (no dashes there),
	# and its word painted down it every so often, read the way it runs
	var bus_words: Array = []   # [offset, way]
	if _has_bus_lane(r):
		var n := _lanes_each_way(r)
		var span_w := w if int(r["o"]) != 0 else w * 0.5
		for way: int in ([1, -1] if int(r["o"]) == 0 else [signi(int(r["o"]))]):
			for idx in range(n):
				var here := _bus_lane(r, idx, way)
				if here:
					bus_words.append([way * (w * 0.5 - span_w / n * (idx + 0.5)), way])
				if idx < n - 1 and here != _bus_lane(r, idx + 1, way):
					var off_b := way * (w * 0.5 - span_w / n * (idx + 1))
					lines = lines.filter(func(ln): return absf(float(ln[0]) - off_b) > 0.5)
					lines.append([off_b, true, false, 0.12])
	if lines.is_empty():
		return
	var cum := PackedFloat32Array([0.0])
	for i in range(1, pts.size()):
		cum.append(cum[i - 1] + pts[i - 1].distance_to(pts[i]))
	var clear: Array = []
	var ids: PackedInt32Array = r["ids"]
	for i in range(ids.size()):
		if (_node_roads[ids[i]] as Array).size() >= 2:
			clear.append(Vector2(cum[i], _node_r[ids[i]] + 2.5))
	var total := cum[cum.size() - 1]
	var span := _near_span(pts, cum, 20.0)
	if span.x > span.y:
		return
	for ln: Array in lines:
		var off: float = ln[0]
		var solid: bool = ln[1]
		var target: Buf = yellow if ln[2] else buf
		var dash := 3.0
		var step := 3.0 if solid else 8.0
		var s := 1.5 + maxf(0.0, floorf((span.x - 1.5 - dash) / step)) * step
		while s + dash < minf(total, span.y + step + dash):
			var ok := true
			for c: Vector2 in clear:
				if absf(s + dash * 0.5 - c.x) < c.y + dash * 0.5:
					ok = false
					break
			if ok:
				var a := _along(pts, cum, s)
				var b := _along(pts, cum, s + dash + (0.05 if solid else 0.0))
				var d := (b - a).normalized()
				var side := Vector2(-d.y, d.x)
				var oa := a + side * off
				var ob := b + side * off
				var hw: float = ln[3] if ln.size() > 3 else (0.07 if not solid else 0.06)
				target.quad3(_g3(oa - side * hw, Y_MARK), _g3(ob - side * hw, Y_MARK),
					_g3(ob + side * hw, Y_MARK), _g3(oa + side * hw, Y_MARK))
			s += step
	for bw: Array in bus_words:
		var s2 := ceilf((span.x + 12.0) / BUS_WORD_STEP) * BUS_WORD_STEP - 12.0
		while s2 < minf(total - 6.0, span.y):
			var ok2 := s2 > 6.0
			for c: Vector2 in clear:
				if absf(s2 - c.x) < c.y + 6.0:
					ok2 = false
					break
			if ok2:
				var a2 := _along(pts, cum, s2)
				var d2 := (_along(pts, cum, s2 + 1.0) - a2).normalized()
				if _tiled and not _tile_rect(_tile).has_point(a2):
					s2 += BUS_WORD_STEP
					continue   # (the next square's: each square's stretch overlaps the next)
				_road_word("אוטובוס" if String(_place.get("look", "")) == "med" else "BUS",
					a2 + Vector2(-d2.y, d2.x) * float(bw[0]), d2 * float(bw[1]))
				_bus_words += 1
				if _bus_word_at.size() < 8:
					_bus_word_at.append([a2 + Vector2(-d2.y, d2.x) * float(bw[0]), d2 * float(bw[1])])
			s2 += BUS_WORD_STEP

func _along(pts: PackedVector2Array, cum: PackedFloat32Array, s: float) -> Vector2:
	for i in range(1, pts.size()):
		if cum[i] >= s:
			var seg := cum[i] - cum[i - 1]
			return pts[i - 1].lerp(pts[i], (s - cum[i - 1]) / maxf(seg, 0.001))
	return pts[pts.size() - 1]

## a zebra crossing over every road through a crossing node
func _zebra(buf: Buf, ni: int) -> void:
	if ni < 0 or ni >= _nodes.size():
		return
	var c := _nodes[ni]
	for e: Vector2i in _node_roads[ni]:
		var r: Dictionary = _roads[e.x]
		if not r["drive"]:
			continue
		var pts: PackedVector2Array = r["pts"]
		var a := pts[maxi(e.y - 1, 0)]
		var b := pts[mini(e.y + 1, pts.size() - 1)]
		var d := (b - a).normalized()
		var side := Vector2(-d.y, d.x)
		var hw: float = r["w"] * 0.5 - 0.4
		var o := -hw
		while o < hw:
			var p := c + side * (o + 0.25)
			var yz := Y_MARK + 0.002
			buf.quad3(_g3(p - d * 1.5 - side * 0.25, yz), _g3(p + d * 1.5 - side * 0.25, yz),
				_g3(p + d * 1.5 + side * 0.25, yz), _g3(p - d * 1.5 + side * 0.25, yz))
			o += 1.0
		return   # one road is enough; the others through this node are its continuation

## every building: walls with a window grid (one shader), flat roofs, merged per chunk
func _build_buildings() -> void:
	if _wall_mat == null:
		_wall_mat = ShaderMaterial.new()
		var sh := Shader.new()
		sh.code = WALL_SHADER
		_wall_mat.shader = sh
		_wall_mat.set_shader_parameter("plaster_tex", _tex("painted_plaster_wall_diff"))
		_wall_mat.set_shader_parameter("plaster_nrm", _tex("painted_plaster_wall_nor"))
		_wall_mat.set_shader_parameter("plaster_mean", TEX_MEAN["painted_plaster_wall"])
		_wall_mat.set_shader_parameter("textured", 1.0 if _quality > 0 else 0.0)
		_roof_mat = ShaderMaterial.new()
		var rsh := Shader.new()
		rsh.code = ROOF_SHADER
		_roof_mat.shader = rsh
		_roof_mat.set_shader_parameter("grit", _tex("asphalt_02_diff"))
		_roof_mat.set_shader_parameter("grit_mean", TEX_MEAN["asphalt_02"])
		_roof_mat.set_shader_parameter("tone", _tone["roof"])
		_roof_mat.set_shader_parameter("textured", 1.0 if _quality > 0 else 0.0)
	var roof := _roof_mat
	var chunks := {}
	var north := String(_place.get("look", "")) == "north"
	var med := String(_place.get("look", "")) == "med"
	var dutch := _dutch()
	var gables := {"roof": CBuf.new(CHUNK), "end": CBuf.new(CHUNK)}
	var cores := CBuf.new(CHUNK)   # the walled-in middle of a block lifted on columns
	var all: Array = _city_data["buildings"]
	for bi: int in _tile_blds.get(_tile, []):
		if _over():
			await _pause()
		var bd: Dictionary = all[bi]
		var ring: PackedVector2Array = bd["_ring"]
		# on a slope: walls start below the lowest corner, the roof sits its height above
		# the average ground, and the window rows count from the lowest corner
		var g_lo := INF
		var g_sum := 0.0
		for p in ring:
			var gh := _h(p)
			g_lo = minf(g_lo, gh)
			g_sum += gh
		var g_avg := g_sum / ring.size()
		var raised: float = bd["_base"]
		var h: float = g_avg + float(bd["_h"])
		var base: float = g_lo + raised - (0.6 if raised == 0.0 and _hnx > 0 else 0.0)

		var key := _cell(_bld_box_of(ring).get_center(), CHUNK)
		if not chunks.has(key):
			chunks[key] = [Buf.new(), Buf.new()]
		var walls: Buf = chunks[key][0]
		var roofs: Buf = chunks[key][1]
		var hsh := _hash_i(ring[0])
		var bright := 0.84 + 0.18 * float(posmod(hsh, 7)) / 6.0
		# the plaster: mostly white, cream and stone; some pastel, yellow, peach or grey
		# (Bedford's clapboard comes in more colours)
		var pick := posmod(hsh >> 3, 100)
		var tk := 0
		if north:
			tk = 0 if pick < 34 else (1 if pick < 48 else (2 if pick < 62 else (3 if pick < 76 else 4)))
		else:
			tk = 0 if pick < 54 else (1 if pick < 62 else (2 if pick < 74 else (3 if pick < 84 else 4)))
		if bd.has("_glass"):   # a landmark's own glass (landmarks.gd)
			tk = int(bd["_glass"])
		var stone := float(posmod(hsh >> 5, 5)) * 0.18   # 0 white .. 0.72 beige
		if med and not bd.has("_glass"):
			var ts := _med_plaster(bd, hsh, tk)
			tk = int(ts.x)
			stone = ts.y
		# a Dutch town (_dutch): brick -- red-brown most, then dark, yellow, a mix; a few painted
		# (WALL_SHADER's brick); and where 3DBAG measured a pitched roof, the walls stop at the
		# eaves and the roof rises to the measured ridge (_dutch_pitch)
		var pitch := 0.0
		if dutch and not bd.has("_glass"):
			tk = 0 if pick < 45 else (1 if pick < 70 else (2 if pick < 85 else (3 if pick < 93 else 4)))
			stone = 0.0
			if bd.has("rr") and raised == 0.0:
				pitch = _dutch_pitch(ring, float(bd["rr"]))
		var tint := float(tk) / 4.0
		if bd.has("_glass"):
			stone = 1.0   # (the shader's sign for a landmark's curtain wall)
		var rel := float(bd["_h"])
		if pitch > 0.0:
			rel = float(bd["rr"]) - pitch
			h = g_avg + rel
		var style: int = 3 if rel > 32.0 else (0 if rel < 10.0 or bd.has("_tile") else [0, 0, 0, 0, 1, 1, 1, 2, 0, 1][posmod(hsh >> 7, 10)])
		if dutch and rel < 16.0 and style < 3:
			style = 0   # (a Dutch house or low block: punched windows in the brick, no balconies)
		var col := Color(bright, tint, float(style) / 4.0 + 0.05, stone)
		var n := ring.size()
		var area := 0.0
		for i in range(n):
			area += ring[i].x * ring[(i + 1) % n].y - ring[(i + 1) % n].x * ring[i].y
		var sgn := 1.0 if area > 0.0 else -1.0
		# a pitched roof only on a house that stands on the ground: a raised "building" is a
		# canopy or a carport (OSM: a roof on stilts), and a house roof on it flew
		var gabled := (north and not dutch and rel < 10.0 and absf(area) * 0.5 < 450.0 and raised == 0.0) or bd.has("_tile") or pitch > 0.0
		# "komat amudim": many Givatayim blocks stand on columns, the ground floor open for
		# parking round a walled-in stairwell and lobby
		var pilotis := med and style <= 1 and rel >= 7.0 and rel <= 22.0 and raised == 0.0 \
			and absf(area) * 0.5 > 140.0 and posmod(hsh >> 11, 100) < 35 and not bd.has("shops") and not bd.has("_tile")
		var wall_base := g_lo + 3.0 if pilotis else base
		# flat roofs have a low parapet round them; the facade's window grid still stops
		# at the roof itself (u2.y)
		var lip := 0.7 if not gabled and rel >= 5.0 and raised == 0.0 else 0.0
		var look := {"style": style, "rgb": _wall_rgb(bright, tint, stone), "g_lo": g_lo, "top": h,
			"sgn": sgn, "gabled": gabled, "pilotis": pilotis, "lip": lip}
		bd["_look"] = look
		_bld_kind[bi] = 1 if pilotis else (2 if gabled else 0)
		if raised == 0.0 and _ao != null:
			if pilotis:   # the parking under it (round the lobby, 2.2 m in) in the shade, and a little out past its edge
				var tao := Time.get_ticks_usec()
				_ao_footprint(ring, sqrt(0.55), -2.4, Color(1.0, 0.55, 0.0))
				_ao_footprint(ring, sqrt(0.55), 1.2)
				_part_time("buildings: contact shadows", tao)
			else:
				var tao2 := Time.get_ticks_usec()
				_ao_footprint(ring)
				_part_time("buildings: contact shadows", tao2)
		if pilotis:
			_lift_on_columns(ring, sgn, base, g_lo + 3.0, roofs, cores, look)
		elif raised >= 2.0:
			_stilts(ring, sgn, g_lo, base, roofs, look)
		for i in range(n):
			var a := ring[i]
			var b := ring[(i + 1) % n]
			var e := b - a
			var len := e.length()
			if len < 0.05:
				continue
			var out := Vector2(e.y, -e.x).normalized() * sgn
			var nrm := Vector3(out.x, 0.0, out.y)
			var a0 := Vector3(a.x, wall_base, a.y)
			var b0 := Vector3(b.x, wall_base, b.y)
			var a1 := Vector3(a.x, h + lip, a.y)
			var b1 := Vector3(b.x, h + lip, b.y)
			var u2 := Vector2(len, h - g_lo)
			var y0 := wall_base - g_lo
			var y1 := h + lip - g_lo
			walls.tri(a0, b0, b1, nrm, col, Vector2(0, y0), Vector2(len, y0), Vector2(len, y1), u2)
			walls.tri(a0, b1, a1, nrm, col, Vector2(0, y0), Vector2(len, y1), Vector2(0, y1), u2)
			if lip > 0.0:   # the parapet's inside, seen from the roof
				var ar := Vector3(a.x, h, a.y)
				var br := Vector3(b.x, h, b.y)
				walls.tri(ar, a1, b1, -nrm, col, Vector2(0, h - g_lo), Vector2(0, y1), Vector2(len, y1), u2)
				walls.tri(ar, b1, br, -nrm, col, Vector2(0, h - g_lo), Vector2(len, y1), Vector2(len, h - g_lo), u2)
		if gabled:
			if pitch > 0.0:
				_gable(gables, ring, h, hsh, false, pitch, walls, col, g_lo)
				_tally("roofs_measured", 1)
			else:
				_gable(gables, ring, h, hsh, bd.has("_tile"))
		var idx := Geometry2D.triangulate_polygon(ring)
		var rc := Color(bright * 0.95, bright * 0.95, bright * 0.95)
		for i in range(0, idx.size(), 3):
			var p0 := ring[idx[i]]
			var p1 := ring[idx[i + 1]]
			var p2 := ring[idx[i + 2]]
			roofs.tri(Vector3(p0.x, h, p0.y), Vector3(p1.x, h, p1.y), Vector3(p2.x, h, p2.y), Vector3.UP, rc)
	for key: Vector2i in chunks:
		if _over():
			await _pause()
		var walls: Buf = chunks[key][0]
		var roofs: Buf = chunks[key][1]
		var am := ArrayMesh.new()
		if not walls.empty():
			am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, walls.arrays())
			am.surface_set_material(am.get_surface_count() - 1, _wall_mat)
		if not roofs.empty():
			am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, roofs.arrays())
			am.surface_set_material(am.get_surface_count() - 1, roof)
		var mi := MeshInstance3D.new()
		mi.mesh = am
		mi.visibility_range_end = VIEW_RANGE   # past this the haze has it anyway
		mi.visibility_range_end_margin = 80.0
		world.add_child(mi)
	_add_mesh(cores, _surface("lobby"), true, VIEW_RANGE * 0.5)
	if not (gables["roof"] as Buf).empty():
		if _shingles == null:
			_shingles = StandardMaterial3D.new()
			_shingles.vertex_color_use_as_albedo = true
			_shingles.roughness = 0.9
		_add_mesh(gables["roof"], _shingles, true, VIEW_RANGE)
		_add_mesh(gables["end"], _surface("gable"), true, VIEW_RANGE)

func _area(poly: PackedVector2Array) -> float:
	return absf(_area_signed(poly))

func _area_signed(poly: PackedVector2Array) -> float:
	var a := 0.0
	for i in range(poly.size()):
		a += poly[i].x * poly[(i + 1) % poly.size()].y - poly[(i + 1) % poly.size()].x * poly[i].y
	return a * 0.5

## ---- traffic islands ---------------------------------------------------------------------
## A lawn (or a paved patch) with road nearly all round it -- the island between a
## roundabout's way in and way out, a roundabout's middle, the space where a boulevard's halves
## part -- was drawn flat on the ground like any park, and with no kerb where no street laid
## one it lay level with the asphalt: "grass patches on the road". Such an area is raised
## instead, a kerb's height less a few centimetres (the streets' own pavements, where they
## run over its edge, stay on top), with a kerb face all round it, and cut back off the
## asphalt -- the roads' widths, the junctions' discs -- and off the paths through it (a
## crossing goes through an island at road level). The car goes over one as over a median.
const ISLAND_MAX := 8000.0           ## m2: bigger is a park, not an island
const ISLAND_RING := 0.75            ## the share of its edge that must be within ISLAND_NEAR of asphalt
const ISLAND_NEAR := 3.0
const ISLAND_Y := KERB_H - 0.04
var _islands: Array = []             ## the raised pieces (PackedVector2Array), the whole city
var _island_hash := {}

func _find_islands(areas: Array) -> void:
	for ai in range(areas.size()):
		var a: Dictionary = areas[ai]
		if not String(a["k"]) in ["park", "grass", "plaza"]:
			continue
		var ring: PackedVector2Array = a["_ring"]
		if ring.size() < 3 or absf(_area_signed(ring)) > ISLAND_MAX or absf(_area_signed(ring)) < 6.0:
			continue
		# round its edge every 2 m: how much of it has a street's asphalt close by
		var n := 0
		var near := 0
		for i in range(ring.size()):
			var p0 := ring[i]
			var p1 := ring[(i + 1) % ring.size()]
			var steps := maxi(1, int(p0.distance_to(p1) / 2.0))
			for k in range(steps):
				n += 1
				if _street_gap(p0.lerp(p1, float(k) / steps), ISLAND_NEAR) < ISLAND_NEAR:
					near += 1
		if n == 0 or float(near) / n < ISLAND_RING:
			continue
		var pieces := _island_cut(ring)
		if pieces.is_empty():
			continue
		a["_isl"] = pieces
		for piece: PackedVector2Array in pieces:
			_hash_add(_island_hash, _bld_box_of(piece), BLD_CELL, _islands.size())
			_islands.append(piece)
	_find_link_islands(areas)
	_tally("islands", _islands.size())

## The triangle between a slip road (`*_link`) and the roads it joins is an island in life,
## kerbed all round; OSM rarely maps it as an area, so each road laid its own kerb and paving
## into it and the strips stood loose in the junction, apart and askew ("messy": Moshe Dayan /
## HaShalom, Yigal Alon / Arvey Nahal in Tel Aviv). Found here from the roads themselves: the
## ring a slip road closes with the shortest way back between its ends along the other
## drivable roads, when it is small, holds no building and no island already -- added as a
## made-up lawn area (`"made": "link"`) and cut and kerbed like a mapped one. The roads' own
## kerb runs and corners facing into one are left out (_in_link_island).
const LINK_ISLAND_MAX := 4000.0      ## m2 of ring: bigger is a block between roads, not an island
const LINK_ISLAND_MIN := 12.0        ## m2 left once the asphalt is cut off
var _link_islands: Array = []        ## the made-up islands' pieces (also in _islands)
var _link_rings: Array = []          ## their whole triangles, the roads' asphalt in them too
var _link_island_hash := {}

func _find_link_islands(areas: Array) -> void:
	var seen := {}
	for ri in range(_roads.size()):
		var r: Dictionary = _roads[ri]
		if not String(r["k"]).ends_with("_link") or not r["drive"] or r["pv"] or r.has("ys"):
			continue
		var pts: PackedVector2Array = r["pts"]
		var ids: PackedInt32Array = r["ids"]
		if pts.size() < 2:
			continue
		var link_len := 0.0
		for i in range(pts.size() - 1):
			link_len += pts[i].distance_to(pts[i + 1])
		var back := _short_way(ids[ids.size() - 1], ids[0], ri, link_len * 2.5 + 40.0)
		if back.size() < 2:
			continue
		var ring := PackedVector2Array(pts)
		for i in range(1, back.size() - 1):
			ring.append(back[i])
		if ring.size() < 3:
			continue
		var area := absf(_area_signed(ring))
		if area < LINK_ISLAND_MIN or area > LINK_ISLAND_MAX:
			continue
		if not Geometry2D.triangulate_polygon(ring).size():
			continue   # (crosses itself)
		var box := _bld_box_of(ring)
		var key := Vector2i(roundi(box.get_center().x), roundi(box.get_center().y))
		if seen.has(key):
			continue   # (the same triangle from its other slip road)
		seen[key] = true
		var inside := false
		for bi: int in _near(_bld_hash, box.get_center(), maxf(box.size.x, box.size.y) * 0.5, BLD_CELL):
			if Geometry2D.intersect_polygons(ring, _blds[bi]).size() > 0:
				inside = true
				break
		if not inside:
			for isl: PackedVector2Array in _islands:
				if box.intersects(_bld_box_of(isl)) and Geometry2D.intersect_polygons(ring, isl).size() > 0:
					inside = true
					break
		if inside:
			continue
		var pieces := _island_cut(ring)
		var left := 0.0
		for p: PackedVector2Array in pieces:
			left += absf(_area_signed(p))
		if left < LINK_ISLAND_MIN:
			# all but a sliver of it is the roads' own asphalt (Moshe Dayan's northbound slip road
			# to HaShalom, Tel Aviv: 101 m2, 2.6 left): no island, but still no kerb or paving
			# facing into it -- the slip road's left kerb, cut by its neighbours' asphalt down
			# to one loose 4 m piece, stood alone in the junction
			_hash_add(_link_island_hash, box, BLD_CELL, _link_rings.size())
			_link_rings.append(ring)
			_tally("link_triangles_all_road", 1)
			continue
		var flat: Array = []
		var k := float(_city_data.get("scale", 10))
		for p in ring:
			flat.append(p.x / k)
			flat.append(p.y / k)
		var ai := areas.size()
		areas.append({"k": "grass", "p": flat, "made": "link", "_ring": ring, "_isl": pieces})
		for t: Vector2i in _tiles_over(box):
			_bucket(_tile_areas, t, ai)
		_hash_add(_link_island_hash, box, BLD_CELL, _link_rings.size())
		_link_rings.append(ring)
		for piece: PackedVector2Array in pieces:
			_hash_add(_island_hash, _bld_box_of(piece), BLD_CELL, _islands.size())
			_islands.append(piece)
			_link_islands.append(piece)
	_tally("link_islands", _link_islands.size())

## the shortest way from node a to node b along drivable public roads on the ground, road
## `skip` left out, no longer than `limit`: its points from a to b (empty if none)
func _short_way(a: int, b: int, skip: int, limit: float) -> PackedVector2Array:
	var dist := {a: 0.0}
	var prev := {}   # node -> [the node before it, its point]
	var open: Array = [a]
	while not open.is_empty():
		var bi := 0
		for i in range(open.size()):
			if float(dist[open[i]]) < float(dist[open[bi]]):
				bi = i
		var n: int = open[bi]
		open.remove_at(bi)
		if n == b:
			break
		for e: Vector2i in _node_roads[n]:
			if e.x == skip:
				continue
			var r: Dictionary = _roads[e.x]
			if not r["drive"] or r["pv"] or r.has("ys"):
				continue
			var ids: PackedInt32Array = r["ids"]
			var pts: PackedVector2Array = r["pts"]
			for step: int in [-1, 1]:
				var j := e.y + step
				if j < 0 or j >= ids.size():
					continue
				var m := ids[j]
				var nd := float(dist[n]) + pts[e.y].distance_to(pts[j])
				if nd > limit or (dist.has(m) and float(dist[m]) <= nd):
					continue
				dist[m] = nd
				prev[m] = [n, pts[j]]
				if not open.has(m):
					open.append(m)
	if a == b or not dist.has(b):
		return PackedVector2Array()
	var out := PackedVector2Array()
	var n := b
	while n != a:
		out.append(prev[n][1])
		n = prev[n][0]
	out.append(_nodes[a])
	out.reverse()
	return out

## p is inside a slip road's triangle (a made-up island's: _find_link_islands) -- the island
## itself or the roads' edges round it, where their kerbs and corners would have stood
func _in_link_island(p: Vector2) -> bool:
	for i: int in _near(_link_island_hash, p, 0.5, BLD_CELL):
		if Geometry2D.is_point_in_polygon(p, _link_rings[i]):
			return true
	return false

## how far past the asphalt's edge of the nearest street (a public road with kerbs, or a
## service lane: not a motorway's grass) p is, up to `reach` (INF past that)
func _street_gap(p: Vector2, reach: float) -> float:
	var best := INF
	for code: int in _near(_asph_hash, p, reach, ASPH_CELL):
		var r: Dictionary = _roads[code / 4096]
		if r["pv"] or HIGHWAYS.has(r["k"]):
			continue
		var pts: PackedVector2Array = r["pts"]
		var sj := code % 4096
		best = minf(best, Geometry2D.get_closest_point_to_segment(p, pts[sj], pts[sj + 1]).distance_to(p) - float(r["w"]) * 0.5)
	return best

## an island's outline less every road's asphalt near it (a little more, so its face stands
## behind a street's own kerb), the junctions' discs and the paths through it
func _island_cut(ring: PackedVector2Array) -> Array:
	var box := _bld_box_of(ring).grow(12.0)
	var cutters: Array = []
	var nodes := {}
	for code: int in _near(_seg_hash, box.get_center(), maxf(box.size.x, box.size.y) * 0.5, SEG_CELL):
		var ri := code / 4096
		var r: Dictionary = _roads[ri]
		if r["pv"] or r.has("ys"):
			continue
		var pts: PackedVector2Array = r["pts"]
		var sj := code % 4096
		if not box.intersects(Rect2(pts[sj], Vector2.ZERO).expand(pts[sj + 1])):
			continue
		var hw := float(r["w"]) * 0.5 + (0.1 if r["drive"] else 0.0)
		# (round ends: a bend's outside, which the drawn ribbon fills, is covered too)
		cutters.append_array(Geometry2D.offset_polyline(PackedVector2Array([pts[sj], pts[sj + 1]]), hw,
				Geometry2D.JOIN_ROUND, Geometry2D.END_ROUND))
		if r["drive"]:
			var ids: PackedInt32Array = r["ids"]
			for nd: int in [ids[sj], ids[sj + 1]]:
				if _node_r[nd] > 0.0 and (_node_roads[nd] as Array).size() >= 2:
					nodes[nd] = true
	for nd: int in nodes:
		var disc := PackedVector2Array()
		for k in range(16):
			disc.append(_nodes[nd] + Vector2.from_angle(TAU * k / 16.0) * (_node_r[nd] * 1.05 + 0.1))
		cutters.append(disc)
	var pieces: Array = [ring]
	for cut: PackedVector2Array in cutters:
		var next: Array = []
		for p: PackedVector2Array in pieces:
			var res := Geometry2D.clip_polygons(p, cut)
			var big := 0
			for i in range(res.size()):
				if absf(_area_signed(res[i])) > absf(_area_signed(res[big])):
					big = i
			var holed := false
			for q: PackedVector2Array in res:
				if Geometry2D.is_polygon_clockwise(q) != Geometry2D.is_polygon_clockwise(res[big]):
					holed = true   # (a cutter wholly inside: leave this one out)
			if holed:
				next.append(p)
				continue
			for q: PackedVector2Array in res:
				if absf(_area_signed(q)) > 2.0:
					next.append(q)
		pieces = next
	return pieces

func _on_island(p: Vector2) -> bool:
	for i: int in _near(_island_hash, p, 0.5, BLD_CELL):
		if Geometry2D.is_point_in_polygon(p, _islands[i]):
			return true
	return false

## the kerb face round each island piece reaching this square (into the kerbs' mesh)
func _island_faces(kerb: Buf) -> void:
	var all: Array = _city_data.get("areas", [])
	for ai: int in _tile_areas.get(_tile, []):
		var a: Dictionary = all[ai]
		if not a.has("_isl"):
			continue
		for piece: PackedVector2Array in a["_isl"]:
			var along := 0.0
			var cw := Geometry2D.is_polygon_clockwise(piece)
			for i in range(piece.size()):
				var p0 := piece[i]
				var p1 := piece[(i + 1) % piece.size()]
				var seg := p0.distance_to(p1)
				if seg < 0.01:
					continue
				var d := (p1 - p0) / seg
				var out := Vector2(d.y, -d.x) if not cw else Vector2(-d.y, d.x)   # away from the island
				var face := Vector3(out.x, 0, out.y)
				var b0 := _g3(p0, 0.0)
				var b1 := _g3(p1, 0.0)
				var t0 := _g3(p0, ISLAND_Y)
				var t1 := _g3(p1, ISLAND_Y)
				var col := Color(0.05, 0, 0)
				kerb.tri(b0, b1, t1, face, col, Vector2(along, 0), Vector2(along + seg, 0), Vector2(along + seg, 1))
				kerb.tri(b0, t1, t0, face, col, Vector2(along, 0), Vector2(along + seg, 1), Vector2(along, 1))
				along += seg

var _chimneys: Array = []
var _area_rings := {}                ## "park" / "grass" / "wood" / "pitch" -> outlines, while building
var _landmarks: Array = []           ## [where, "playground" | "pitch"]

## ---- what makes a block look lived in ---------------------------------------------------------
## Givatayim: stacks of balconies on the street side, an AC unit or two on the walls, a
## canopy over the entrance with the blue house-number plate beside it, the columns of the
## blocks that stand on them. Bedford: a porch on the street side of a house, a chimney.
## All of it instanced, in the building's own wall colour.
var wall_things := {}                ## a few of the AC units, washing racks, towels made (for tests)

## many copies of a kit as instances, never merged into the square's batch (see the AC units)
func _instanced(mesh: Mesh, xforms: Array, range_end: float, colours: Array = []) -> void:
	var was := _batching
	_batching = false
	_chunked(mesh, xforms, range_end, colours)
	_batching = was

func _build_facade_kit() -> void:
	var med := String(_place.get("look", "")) == "med"
	var north := String(_place.get("look", "")) == "north"
	var kit := {"balcony": [], "balcony_rail": [], "column": [], "canopy": [], "porch": [], "post": []}
	var kit_col := {"balcony": [], "balcony_rail": [], "column": [], "canopy": [], "porch": [], "post": []}
	var encl: Array = [[], []]   # balconies closed in, shutters a little or a lot down
	var acs: Array = [[], []]    # AC units: on the wall on arms, up on a balcony's back wall
	var washing: Array = [[], [], []]   # racks of washing under windows, three arrangements
	var towels: Array = []       # over the balconies' parapets
	var towel_cols: Array = []
	var laundry: Array = _furn._laundry_cols() if med else []
	var plates: Array = []
	var all: Array = _city_data["buildings"]
	for bi: int in _tile_blds.get(_tile, []):
		if _over():
			await _pause()
		var bd: Dictionary = all[bi]
		if not bd.has("_look"):
			continue
		var look: Dictionary = bd["_look"]
		var wc: Color = look["rgb"]
		for t: Transform3D in look.get("cols", []):
			kit["column"].append(t)
			kit_col["column"].append(wc)
		var rel: float = bd["_h"]
		if rel < 3.0 or float(bd["_base"]) > 0.0:
			continue
		var ring: PackedVector2Array = bd["_ring"]
		var hsh := _hash_i(ring[0])
		var g_lo: float = look["g_lo"]
		var street := _street_edge(ring, float(look["sgn"]))
		var bname := String(bd.get("name", ""))
		if bname != "" and (_area(ring) >= 300.0 or rel >= 20.0):
			var face_edge := street if not street.is_empty() else _longest_edge(ring, float(look["sgn"]))
			var mall := _is_mall(bname)
			_name_on(bname, face_edge, float(look["top"]), g_lo, mall)
			if mall and not street.is_empty():
				_mall_front(face_edge, g_lo, wc, kit, kit_col)
				continue
		var style: int = look["style"]
		if med and rel <= 32.0:
			var floors := int((rel + 0.3) / 3.0)
			# balconies: one or two stacks up the street side
			var balc_bays := {}   # (the street side's bays with a stack: no AC on arms there)
			if not street.is_empty() and style != 1 and floors >= 2:
				var a: Vector2 = street[0]
				var b: Vector2 = street[1]
				var out: Vector2 = street[2]
				var L := a.distance_to(b)
				var n := maxi(1, int(L / 3.3))
				var cw := L / n
				if L >= 7.0:
					# (one, two, or on a wide face three: the film's blocks up the walk show a
					# balcony in most bays, the game's read plain beside them)
					var stacks := 1 if n < 4 else (2 if n < 6 else 3)
					var face := Basis(Vector3.UP, atan2(out.x, out.y))
					for sk in range(stacks):
						var ci := posmod(hsh >> (3 + sk * 4), n)
						if n >= 3:
							ci = 1 + posmod(hsh >> (3 + sk * 4), n - 2)
						if sk == 1 and ci == posmod(hsh >> 3, n):
							ci = (ci + 2) % n
						if sk == 2 and balc_bays.has(ci):
							ci = (ci + 3) % n
							if balc_bays.has(ci):
								continue
						var at := a + (b - a) / L * ((ci + 0.5) * cw)
						balc_bays[ci] = true
						for lv in range(1, floors):
							var p := at + out * 0.62
							var bk := "balcony_rail" if posmod(hsh >> 9, 2) == 0 else "balcony"   # (half the blocks: bars, not a solid parapet)
							kit[bk].append(Transform3D(face, Vector3(p.x, g_lo + lv * 3.0, p.y)))
							kit_col[bk].append(wc)
							var hb := posmod(hsh >> (sk * 3 + lv * 5), 997)
							if hb % 10 < 3:   # an AC up on the balcony's back wall, over the parapet
								var q := at + (b - a) / L * (0.75 if hb % 2 == 0 else -0.75)
								(acs[1] as Array).append(Transform3D(face, Vector3(q.x, g_lo + lv * 3.0 + 1.95, q.y)))
							elif hb % 10 == 4 and hb / 10 % 3 == 0:   # a towel over the parapet
								var tx := (hb / 30 % 5 - 2) * 0.35
								towels.append(Transform3D(face, Vector3(p.x, g_lo + lv * 3.0, p.y)) * Transform3D(Basis(), Vector3(tx, 0, 0)))
								towel_cols.append(laundry[hb / 7 % laundry.size()])
							# a third of them closed in, the Israeli way: glass above the parapet
							# and a roller shutter part-way down
							if med and posmod(hsh >> (sk * 7 + lv * 3 + 2), 100) < 34:
								(encl[posmod(hsh >> (lv + 1), 2)] as Array).append(Transform3D(face, Vector3(p.x, g_lo + lv * 3.0, p.y)))
							# now and then a flag hung over the parapet
							if posmod(hsh >> (sk * 5 + lv), 29) == 0 and String(_place.get("look", "")) == "med":
								_balcony_flags.append(Transform3D(face, Vector3(p.x, g_lo + lv * 3.0 + 1.02, p.y) + face * Vector3(0, 0, 0.67)))
					if _bld_kind[bi] == 0:
						_bld_kind[bi] = 3
			# AC units on their arms beside the windows, any side, the street side's the most
			# (as filmed: most flats have one or two showing); and now and then a rack of
			# washing under a window
			var placed := 0
			var racks := 0
			var cap := mini(6, 1 + floors)   # (4 until 22 Nov: the far blocks read plain beside the film's)
			for i in range(ring.size()):
				if placed >= cap or floors < 1:
					break
				var a := ring[i]
				var b := ring[(i + 1) % ring.size()]
				var L := a.distance_to(b)
				if L < 4.0:
					continue
				var on_st := not street.is_empty() and a.is_equal_approx(street[0]) and b.is_equal_approx(street[1])
				var e := (b - a) / L
				var out := Vector2(e.y, -e.x) * float(look["sgn"])
				var face := Basis(Vector3.UP, atan2(out.x, out.y))
				var n := maxi(1, int(L / 3.3))
				for ci in range(n):
					if placed >= cap:
						break
					if on_st and balc_bays.has(ci):
						continue
					for lv in range(floors):
						if lv == 0 and (floors < 2 or look["pilotis"]):
							continue
						var hh := posmod(hsh + i * 131 + ci * 17 + lv * 7919, 1000)
						if hh % 100 < (17 if on_st else 9) and placed < cap:
							var p := a + e * ((ci + (0.86 if hh % 2 == 0 else 0.14)) * L / n) + out * 0.02
							var y := g_lo + lv * 3.0 + (0.32 if lv > 0 else 2.3)   # (under the sill; on the ground floor, over heads)
							(acs[0] as Array).append(Transform3D(face, Vector3(p.x, y, p.y)))
							placed += 1
						elif lv > 0 and hh % 100 >= 97 and racks < 2 and not look["pilotis"]:
							var p := a + e * ((ci + 0.5) * L / n) + out * 0.02
							(washing[hh / 100 % 3] as Array).append(Transform3D(face, Vector3(p.x, g_lo + lv * 3.0 + 0.75, p.y)))
							racks += 1
			# the entrance: a canopy over the door, the lit blue number plate beside it
			if not street.is_empty() and not look["pilotis"]:
				var a: Vector2 = street[0]
				var b: Vector2 = street[1]
				var out: Vector2 = street[2]
				var mid := (a + b) * 0.5
				var e := (b - a).normalized()
				var face := Basis(Vector3.UP, atan2(out.x, out.y))
				var cp := mid + out * 0.55
				kit["canopy"].append(Transform3D(face, Vector3(cp.x, g_lo + 2.75, cp.y)))
				kit_col["canopy"].append(wc * 0.92)
				var pp := mid + e * 1.7 + out * 0.03
				plates.append(Transform3D(face, Vector3(pp.x, g_lo + 2.2, pp.y)))
		elif north and look["gabled"] and not street.is_empty():
			# a porch: a little roof on two posts in front of the door
			var a: Vector2 = street[0]
			var b: Vector2 = street[1]
			var out: Vector2 = street[2]
			if a.distance_to(b) >= 6.0 and posmod(hsh >> 6, 10) < 7:
				var mid := (a + b) * 0.5 + (b - a).normalized() * float(posmod(hsh, 3) - 1) * 1.5
				var e := (b - a).normalized()
				var face := Basis(Vector3.UP, atan2(out.x, out.y))
				var rp := mid + out * 0.95
				kit["porch"].append(Transform3D(face, Vector3(rp.x, g_lo + 2.6, rp.y)))
				kit_col["porch"].append(wc)
				for sd: float in [-1.4, 1.4]:
					var q := mid + e * sd + out * 1.7
					kit["post"].append(Transform3D(Basis(), Vector3(q.x, g_lo + 1.3, q.y)))
					kit_col["post"].append(wc)
	var tinted := _vc_mat()
	var meshes := {"balcony": _cached("balcony", _balcony_mesh), "balcony_rail": _cached("balcony_rail", _balcony_mesh.bind(true)), "column": _boxm(Vector3.ONE), "canopy": _boxm(Vector3(2.4, 0.14, 1.1)),
		"porch": _boxm(Vector3(3.4, 0.14, 1.9)), "post": _boxm(Vector3(0.14, 2.6, 0.14))}
	var ranges := {"balcony": 230.0, "balcony_rail": 230.0, "column": 260.0, "canopy": 150.0, "porch": 220.0, "post": 160.0}
	for k: String in kit:
		if not (kit[k] as Array).is_empty():
			await _chunked_paced(meshes[k], kit[k], ranges[k], kit_col[k], tinted, k != "post")
	for v in range(2):
		if not (encl[v] as Array).is_empty():
			_chunked(_cached("enclosure%d" % v, _enclosure_mesh.bind(v)), encl[v], 230.0, [], tinted)
	_tally("closed_balconies", (encl[0] as Array).size() + (encl[1] as Array).size())
	if not _mall_glass.is_empty():
		_chunked(_boxm(Vector3.ONE), _mall_glass, 400.0, [], _shop_glass())
	if not _lobby_doors.is_empty():
		_chunked(_boxm(Vector3(1.9, 2.4, 0.05)), _lobby_doors, 160.0, [], _shop_glass())
	# (thousands of AC units and racks: drawn as instances, a draw or two a square near you,
	# not merged into the square's batch -- merged, each copied its vertices into it: some
	# 100 MB of vertices city-wide, and the batches' uploads were frames of 50 ms while
	# building in the background)
	_instanced(_furn.ac_kit(0), (acs[0] as Array) + (acs[1] as Array), 140.0)
	var all_wash: Array = (washing[0] as Array) + (washing[1] as Array) + (washing[2] as Array)
	var wash_tints: Array = []
	for t: Transform3D in all_wash:   # (one arrangement; tinted a little copy by copy)
		wash_tints.append(Color.WHITE.lerp(laundry[posmod(_hash_i(Vector2(t.origin.x, t.origin.z)), laundry.size())], 0.35))
	_instanced(_furn.washing_kit(0), all_wash, 110.0, wash_tints)
	await _chunked_paced(_furn.towel_kit(), towels, 120.0, towel_cols)
	var seen_now := {"ac": acs[0], "ac_balcony": acs[1], "washing": (washing[0] as Array) + (washing[1] as Array) + (washing[2] as Array), "towels": towels}
	for k: String in seen_now:   # (a few of each kept for the tests: tests/wall_things.gd)
		var keep: Array = wall_things.get(k, [])
		keep.append_array((seen_now[k] as Array).slice(0, maxi(0, 200 - keep.size())))
		wall_things[k] = keep
	_tally("ac_units", (acs[0] as Array).size() + (acs[1] as Array).size())
	_tally("washing_racks", (washing[0] as Array).size() + (washing[1] as Array).size() + (washing[2] as Array).size())
	_tally("towels", towels.size())
	if not plates.is_empty():
		var pl := _boxm(Vector3(0.36, 0.24, 0.04))
		pl.material = mat("player", 0.6)
		_chunked(pl, plates, 110.0)
	if not _chimneys.is_empty():
		var ch := _boxm(Vector3(0.7, 2.2, 0.7))
		ch.material = _surface("brick")
		_chunked(ch, _chimneys, 450.0, [], null, true)
	_tally("balconies", (kit["balcony"] as Array).size())
	_tally("columns", (kit["column"] as Array).size())
	_tally("porches", (kit["porch"] as Array).size())
	_tally("chimneys", _chimneys.size())

## the building's name in big letters along the top of its street side: malls, towers,
## the cinema, schools -- the places people give directions by
var _names: Array = []

func _name_on(text: String, edge: Array, top: float, g_lo: float, mall: bool) -> void:
	if edge.is_empty():
		return
	var a: Vector2 = edge[0]
	var b: Vector2 = edge[1]
	var out: Vector2 = edge[2]
	var L := a.distance_to(b)
	var lb := Label3D.new()
	lb.text = text
	lb.font = _font
	lb.font_size = 96
	var w := _font.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, 96).x
	lb.pixel_size = clampf(L * 0.75 / maxf(w, 1.0), 0.008, 0.035)
	lb.outline_size = 12
	var role := "accent" if mall else "ink"
	lb.modulate = Palette.col(role)
	lb.outline_modulate = Palette.col("bg")
	lb.set_meta("role", role)
	var mid := (a + b) * 0.5 + out * 0.25
	var y := (g_lo + 5.9) if mall else maxf(top - 1.6, g_lo + 3.0)
	lb.position = Vector3(mid.x, y, mid.y)
	lb.rotation.y = atan2(out.x, out.y)
	lb.double_sided = false
	lb.visibility_range_end = 520.0
	world.add_child(lb)
	_names.append(lb)

func _is_mall(name: String) -> bool:
	var n := name.to_lower()
	return n.contains("mall") or n.contains("קניון") or n.contains(" מול") or n.begins_with("מול ") \
		or n.contains("plaza") or n.contains("centre") and n.contains("shopping")

## a mall's street side: glass shopfronts all along the ground floor, and a big canopy on
## columns over the way in
func _mall_front(edge: Array, g_lo: float, wc: Color, kit: Dictionary, kit_col: Dictionary) -> void:
	var a: Vector2 = edge[0]
	var b: Vector2 = edge[1]
	var out: Vector2 = edge[2]
	var L := a.distance_to(b)
	var e := (b - a) / L
	var face := Basis(Vector3.UP, atan2(out.x, out.y))
	var mid := (a + b) * 0.5
	var glass := mid + out * 0.08
	_mall_glass.append(Transform3D(face * Basis.from_scale(Vector3(maxf(L - 1.0, 2.0), 3.4, 0.1)),
		Vector3(glass.x, g_lo + 1.8, glass.y)))
	# The canopy and its columns stand on the forecourt, never out over the road: fronts are
	# cut back to the road's edge + 1.5 m, and columns put 3.2 m out stood 1.7 m into the
	# lane (two in Zahal by Ashdod's start; a taxi drove through one -- city_check and the
	# exam's checks found them). The canopy is as deep as the room in front allows; the
	# columns go only where they are off the road, and a shallow canopy needs none.
	var width := minf(12.0, L * 0.5)
	var depth := 3.3
	while depth > 1.2:
		var reach := out * (0.15 + depth + 0.3)
		if _off_road(mid + reach, 0.0) and _off_road(mid + e * width * 0.5 + reach, 0.0) \
				and _off_road(mid - e * width * 0.5 + reach, 0.0):
			break
		depth -= 0.5
	var cp := mid + out * (0.15 + depth * 0.5)
	kit["canopy"].append(Transform3D(face * Basis.from_scale(Vector3(width / 2.4, 2.4, depth)), Vector3(cp.x, g_lo + 4.0, cp.y)))
	kit_col["canopy"].append(wc * 0.9)
	if depth < 2.0:
		return
	for sd: float in [-1.0, 1.0]:
		var q := mid + e * sd * minf(5.0, L * 0.2) + out * (0.15 + depth - 0.25)
		if not _off_road(q, 0.3) or _in_junction(q, 0.3):
			continue
		kit["column"].append(Transform3D(Basis.from_scale(Vector3(0.45, 4.0, 0.45)), Vector3(q.x, g_lo + 2.0, q.y)))
		kit_col["column"].append(wc)
		_add_post(q, 0.25)

var _mall_glass: Array = []
var _lobby_doors: Array = []         ## the glass doors of the lobbies under blocks on columns (this square's)

func _longest_edge(ring: PackedVector2Array, sgn: float) -> Array:
	var best := 0.0
	var pick: Array = []
	for i in range(ring.size()):
		var a := ring[i]
		var b := ring[(i + 1) % ring.size()]
		if a.distance_to(b) > best:
			best = a.distance_to(b)
			pick = [a, b, Vector2(b.y - a.y, a.x - b.x).normalized() * sgn]
	return pick

## a balcony closed in, over the parapet of _balcony_mesh: a band of glass in white frames
## up to the slab above, and a roller shutter down over it -- `v` 0 a little, 1 most of the
## way. Its colours are its own (vertex colours), not the wall's.
func _enclosure_mesh(v: int) -> ArrayMesh:
	var b := Buf.new()
	var glass: Color = _tone["glass"].darkened(0.15)
	var shutter: Color = _tone["shutter"]
	var frame: Color = _tone["mark"]
	var lo := 1.0
	var hi := 2.82
	var drop := 0.28 if v == 0 else 0.72
	var cut := hi - (hi - lo) * drop   # where the shutter's bottom edge is
	var panel := func(a: Vector3, e: Vector3, y0: float, y1: float, n: Vector3, col: Color) -> void:
		b.tri(Vector3(a.x, y0, a.z), Vector3(e.x, y0, e.z), Vector3(e.x, y1, e.z), n, col)
		b.tri(Vector3(a.x, y0, a.z), Vector3(e.x, y1, e.z), Vector3(a.x, y1, a.z), n, col)
	# the front and the two sides
	var faces := [[Vector3(-1.35, 0, 0.62), Vector3(1.35, 0, 0.62), Vector3.BACK],
		[Vector3(-1.35, 0, -0.62), Vector3(-1.35, 0, 0.62), Vector3.LEFT],
		[Vector3(1.35, 0, 0.62), Vector3(1.35, 0, -0.62), Vector3.RIGHT]]
	for f: Array in faces:
		panel.call(f[0], f[1], lo, cut, f[2], glass)
		panel.call(f[0], f[1], cut, hi, f[2], shutter)
		panel.call(f[0] + (f[2] as Vector3) * 0.01, f[1] + (f[2] as Vector3) * 0.01, cut - 0.05, cut, f[2], frame)
		panel.call(f[0] + (f[2] as Vector3) * 0.01, f[1] + (f[2] as Vector3) * 0.01, lo, lo + 0.05, f[2], frame)
	# the window mullions on the front
	for x: float in [-0.45, 0.45]:
		b.tri(Vector3(x - 0.03, lo, 0.635), Vector3(x + 0.03, lo, 0.635), Vector3(x + 0.03, cut, 0.635), Vector3.BACK, frame)
		b.tri(Vector3(x - 0.03, lo, 0.635), Vector3(x + 0.03, cut, 0.635), Vector3(x - 0.03, cut, 0.635), Vector3.BACK, frame)
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, b.arrays())
	return am

## a balcony, local +Z out of the wall: a slab and a solid parapet round its three sides
func _balcony_mesh(railing := false) -> ArrayMesh:
	var b := Buf.new()
	# (the balconies were three boxes the wall's colour, lit like it: they melted into it --
	# the creases and edges make them read as slabs; tried on the look bench)
	var creases := true
	var edges := true
	_box(b, Vector3(0, -0.09, 0), Vector3(2.7, 0.18, 1.24))   # the slab (its back at the wall, z -0.62)
	var slab_end := b.v.size()
	if not railing:
		_box(b, Vector3(0, 0.5, 0.58), Vector3(2.7, 1.0, 0.08))   # a solid parapet
	for sx: float in [-1.0, 1.0]:
		_box(b, Vector3(sx * 1.31, 0.5, 0), Vector3(0.08, 1.0, 1.24))
	if creases:
		# the shade where surfaces meet: the slab's underside, the parapet's and the sides'
		# insides, the floor under the parapet (the vertex colour, times the wall's)
		for i in range(b.v.size()):
			var nn := b.n[i]
			var k := 1.0
			if nn.y < -0.5:
				k = 0.42
			elif i < slab_end and nn.y > 0.5:
				k = 0.72
			elif i >= slab_end and nn.z < -0.5:
				k = 0.6
			elif i >= slab_end and absf(nn.x) > 0.5 and signf(nn.x) != signf(b.v[i].x):
				k = 0.62
			b.c[i] = Color(k, k, k)
		# the wall's own shade under the slab: a band on it, dark at the slab, fading down
		var z := -0.612
		var t0 := Vector3(-1.38, -0.18, z)
		var t1 := Vector3(1.38, -0.18, z)
		var d0 := Vector3(-1.38, -0.62, z)
		var d1 := Vector3(1.38, -0.62, z)
		var band0 := b.v.size()
		b.tri(t0, t1, d1, Vector3.BACK, Color.WHITE)
		b.tri(t0, d1, d0, Vector3.BACK, Color.WHITE)
		for i in range(band0, b.v.size()):   # (by height: tri() may turn the corners round)
			var k := lerpf(0.5, 0.97, clampf((-0.18 - b.v[i].y) / 0.44, 0.0, 1.0))
			b.c[i] = Color(k, k, k)
	if edges:
		# a lip along the slab's front, its top edge catching the light, a drip line under it;
		# a coping along the parapet's top (or the railing's rail), a little wider than it
		var e0 := b.v.size()
		_box(b, Vector3(0, -0.015, 0.632), Vector3(2.74, 0.035, 0.026))
		var e1 := b.v.size()
		_box(b, Vector3(0, -0.168, 0.634), Vector3(2.74, 0.026, 0.03))
		var e2 := b.v.size()
		if not railing:
			_box(b, Vector3(0, 1.015, 0.58), Vector3(2.76, 0.035, 0.13))
		var e3 := b.v.size()
		for i in range(e0, e3):
			var nn := b.n[i]
			var k := 0.45 if i >= e1 and i < e2 else (1.15 if nn.y > 0.5 else (0.55 if nn.y < -0.5 else 0.92))
			b.c[i] = Color(k, k, k)
	if railing:
		# a top rail and bars, dark painted steel: flat bars facing the street (two triangles each)
		var r0 := b.v.size()
		_box(b, Vector3(0, 1.0, 0.6), Vector3(2.7, 0.04, 0.05))
		for i in range(r0, b.v.size()):
			b.c[i] = Color(0.16, 0.16, 0.17)
		var bars := 18
		for i in range(bars):
			var x := -1.25 + 2.5 * float(i) / float(bars - 1)
			var bc := Color(0.15, 0.15, 0.16)
			var q0 := Vector3(x - 0.012, 0.0, 0.6)
			var q1 := Vector3(x + 0.012, 0.0, 0.6)
			var q2 := Vector3(x + 0.012, 0.98, 0.6)
			var q3 := Vector3(x - 0.012, 0.98, 0.6)
			b.tri(q0, q1, q2, Vector3.BACK, bc)
			b.tri(q0, q2, q3, Vector3.BACK, bc)
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, b.arrays())
	return am

## the side of a building facing its street: the longest edge whose outside looks toward
## the nearest road, as [a, b, out], or [] when no road is near
func _street_edge(ring: PackedVector2Array, sgn: float) -> Array:
	var c := Vector2.ZERO
	for p in ring:
		c += p
	c /= ring.size()
	var hit := _nearest_seg(c, 22.0, true, true)
	if hit.is_empty():
		return []
	var to: Vector2 = ((hit["q"] as Vector2) - c).normalized()
	var best := -INF
	var pick: Array = []
	for i in range(ring.size()):
		var a := ring[i]
		var b := ring[(i + 1) % ring.size()]
		var e := b - a
		var L := e.length()
		if L < 3.0:
			continue
		var out := Vector2(e.y, -e.x).normalized() * sgn
		var facing := out.dot(to)
		if facing > 0.5 and facing * minf(L, 14.0) > best:
			best = facing * minf(L, 14.0)
			pick = [a, b, out]
	return pick

## the colour the facade shader gives a building's walls, for things stuck on them
func _wall_rgb(bright: float, tint: float, stone: float) -> Color:
	var tk := int(round(tint * 4.0))
	var plaster: Color = _tone[["wall", "wall2", "wall4", "wall5", "wall6"][clampi(tk, 0, 4)]]
	# (as WALL_SHADER: a lean of 0.4-0.79 is the old blocks' sand render)
	var aged := smoothstep(0.38, 0.5, stone) * (0.0 if stone >= 0.79 else 1.0)
	var w3: Color = _tone["wall3"]
	var st := w3.lerp(_tone["wall7"], aged)
	var c := plaster.lerp(st, lerpf(stone, 1.0, aged * 0.6) * (1.0 if tk == 0 else 0.3))
	c = Color(c.r * bright, c.g * bright, c.b * bright)
	# (as WALL_SHADER's roll_white: the brightest plaster rolled off toward 0.67)
	var bm := maxf(c.r, maxf(c.g, c.b))
	if bm > 0.55:
		var k := (0.55 + 0.12 * (1.0 - exp(-(bm - 0.55) / 0.12))) / bm
		c = Color(c.r * k, c.g * k, c.b * k)
	return c

## a block on columns: the floors above start at `lift`; under them, a walled-in core set
## back from the edge (stairs, lobby, storage), the ceiling of the open floor, and a column
## at every corner and every few metres along the edges
func _lift_on_columns(ring: PackedVector2Array, sgn: float, base: float, lift: float, roofs: Buf,
		cores: Buf, look: Dictionary) -> void:
	var cols: Array = []
	var ceil_c := Color(0.86, 0.86, 0.84)   # (light plaster: dark, it read as a hole)
	var idx := Geometry2D.triangulate_polygon(ring)
	for i in range(0, idx.size(), 3):
		var p0 := ring[idx[i]]
		var p1 := ring[idx[i + 1]]
		var p2 := ring[idx[i + 2]]
		roofs.tri(Vector3(p0.x, lift, p0.y), Vector3(p1.x, lift, p1.y), Vector3(p2.x, lift, p2.y), Vector3.DOWN, ceil_c)
	# set back 2.2 m: whichever way round the outline runs, the smaller of the two offsets
	var inner: Array = Geometry2D.offset_polygon(ring, -2.2)
	var other: Array = Geometry2D.offset_polygon(ring, 2.2)
	if not inner.is_empty() and not other.is_empty() and _area(other[0]) < _area(inner[0]):
		inner = other
	if not inner.is_empty() and _area(inner[0]) < _area(ring) * 0.95:
		var core: PackedVector2Array = inner[0]
		var ca := 0.0
		for i in range(core.size()):
			ca += core[i].x * core[(i + 1) % core.size()].y - core[(i + 1) % core.size()].x * core[i].y
		var cs := 1.0 if ca > 0.0 else -1.0
		# the lobby's glass door, lit, on the side of the core that faces the street
		var street := _street_edge(ring, sgn)
		var to: Vector2 = street[2] if not street.is_empty() else Vector2.ZERO
		var door: Array = []
		var best := 0.3
		for i in range(core.size()):
			var a := core[i]
			var b := core[(i + 1) % core.size()]
			var e := b - a
			if e.length() < 0.05:
				continue
			var out := Vector2(e.y, -e.x).normalized() * cs
			var nrm := Vector3(out.x, 0.0, out.y)
			cores.tri(Vector3(a.x, base, a.y), Vector3(b.x, base, b.y), Vector3(b.x, lift, b.y), nrm, Color.WHITE)
			cores.tri(Vector3(a.x, base, a.y), Vector3(b.x, lift, b.y), Vector3(a.x, lift, a.y), nrm, Color.WHITE)
			if e.length() >= 2.4 and out.dot(to) > best:
				best = out.dot(to)
				door = [(a + b) * 0.5 + out * 0.04, out]
		if not door.is_empty():
			var dp: Vector2 = door[0]
			var dout: Vector2 = door[1]
			_lobby_doors.append(Transform3D(Basis(Vector3.UP, atan2(dout.x, dout.y)), Vector3(dp.x, base + 1.2, dp.y)))
	var hgt := lift - base
	var c := Vector2.ZERO
	for p in ring:
		c += p
	c /= ring.size()
	for i in range(ring.size()):
		var a := ring[i]
		var b := ring[(i + 1) % ring.size()]
		var e := b - a
		var L := e.length()
		if L < 0.5:
			continue
		var d := e / L
		var inward := -Vector2(e.y, -e.x).normalized() * sgn
		var steps := maxi(1, int(L / 4.5))
		for k in range(steps):
			var q := a + d * (L * float(k) / steps) + inward * 0.28 + (d * 0.28 if k == 0 else Vector2.ZERO)
			cols.append(Transform3D(Basis.from_scale(Vector3(0.4, hgt, 0.4)), Vector3(q.x, base + hgt * 0.5, q.y)))
	look["cols"] = cols

## a raised roof (a canopy, a carport, a covered walkway): what holds it up -- a column at
## each corner and every 6 m along the edges, solid to the car -- and its underside
func _stilts(ring: PackedVector2Array, sgn: float, ground: float, under: float, roofs: Buf, look: Dictionary) -> void:
	var cols: Array = []
	var hgt := under - ground
	for i in range(ring.size()):
		var a := ring[i]
		var b := ring[(i + 1) % ring.size()]
		var L := a.distance_to(b)
		if L < 0.5:
			continue
		var d := (b - a) / L
		var inward := -Vector2(b.y - a.y, a.x - b.x).normalized() * sgn
		var steps := maxi(1, int(L / 6.0))
		for k in range(steps):
			var q := a + d * (L * float(k) / steps) + inward * 0.3 + (d * 0.3 if k == 0 else Vector2.ZERO)
			if not _off_road(q, 0.3) or _in_junction(q, 0.3):
				continue   # (a building over a road -- a passage -- has none in the lanes)
			if _post_twin(q, 0.25):
				continue   # (a column there already: a building's parts over one outline each
				           # put theirs up, on the same spots -- Tel Aviv 526, Givatayim 64)
			cols.append(Transform3D(Basis.from_scale(Vector3(0.35, hgt, 0.35)), Vector3(q.x, ground + hgt * 0.5, q.y)))
			_add_post(q, 0.25)
	var idx := Geometry2D.triangulate_polygon(ring)
	var c := Color(0.6, 0.6, 0.6)
	for i in range(0, idx.size(), 3):
		var p0 := ring[idx[i]]
		var p1 := ring[idx[i + 1]]
		var p2 := ring[idx[i + 2]]
		roofs.tri(Vector3(p0.x, under, p0.y), Vector3(p1.x, under, p1.y), Vector3(p2.x, under, p2.y), Vector3.DOWN, c)
	look["cols"] = cols

## A Dutch town: the level's "build" is "nl" (brick walls, measured pitched roofs)
func _dutch() -> bool:
	return String(_place.get("build", "")) == "nl"

## A Dutch house's roof rise (m) for its measured ridge, or 0 for a flat roof: only on a
## footprint that is mostly its tightest rectangle (an L or a block round a yard would have its
## roof float past its walls) and not a hall. The pitch is near 50 degrees, as Dutch roofs are:
## the rise 0.6 of the span, at most half the ridge's height, so the eaves stay over a storey up.
func _dutch_pitch(ring: PackedVector2Array, ridge: float) -> float:
	var r := _min_rect(ring)
	var size: Vector2 = (r[2] as Vector2) - (r[1] as Vector2)
	var span := minf(size.x, size.y)
	var fp := _area(ring)
	if span < 3.0 or fp > 2500.0 or fp < 0.72 * size.x * size.y:
		return 0.0
	var rise := clampf(minf(span * 0.6, ridge * 0.5), 1.2, 10.0)
	return rise if ridge - rise >= 2.6 else 0.0

## the footprint's tightest rectangle: [its long-or-short axis u, its low corner, its high
## corner], the corners in (along u, across u)
func _min_rect(ring: PackedVector2Array) -> Array:
	var best := INF
	var u := Vector2.RIGHT
	var lo := Vector2.ZERO
	var hi := Vector2.ZERO
	for i in range(ring.size()):
		var e := (ring[(i + 1) % ring.size()] - ring[i]).normalized()
		if e == Vector2.ZERO:
			continue
		var v := Vector2(-e.y, e.x)
		var mn := Vector2(INF, INF)
		var mx := Vector2(-INF, -INF)
		for p in ring:
			var q := Vector2(p.dot(e), p.dot(v))
			mn = mn.min(q)
			mx = mx.max(q)
		var area := (mx.x - mn.x) * (mx.y - mn.y)
		if area < best:
			best = area
			u = e
			lo = mn
			hi = mx
	return [u, lo, hi]

## a pitched roof over a house: the footprint's tightest rectangle, the ridge along its
## long side, eaves a little past the walls, shingles grey or red-brown. A Dutch house
## (`rise` given, its measured roof) has orange tiles or dark glazed ones, and its gable ends
## are brick in the walls' own buffer (`wall_buf`, `wcol`, its ground `g_lo`), no windows
func _gable(g: Dictionary, ring: PackedVector2Array, top: float, hsh: int, tiled := false,
		rise_m := 0.0, wall_buf: Buf = null, wcol := Color(), g_lo := 0.0) -> void:
	var rect := _min_rect(ring)
	var u: Vector2 = rect[0]
	var lo: Vector2 = rect[1]
	var hi: Vector2 = rect[2]
	var v := Vector2(-u.y, u.x)
	if hi.y - lo.y > hi.x - lo.x:   # the ridge runs along the long side
		var t := u
		u = v
		v = -t
		var l2 := Vector2(-hi.y, lo.x)
		var h2 := Vector2(-lo.y, hi.x)
		lo = l2
		hi = h2
	lo -= Vector2(0.35, 0.35)
	hi += Vector2(0.35, 0.35)
	var rise := rise_m if rise_m > 0.0 else (hi.y - lo.y) * 0.32
	var cy := (lo.y + hi.y) * 0.5
	var P := func(a: float, b: float, y: float) -> Vector3:
		var q := u * a + v * b
		return Vector3(q.x, y, q.y)
	var shades := [Palette.col("bg").lerp(Palette.col("bg_alt"), 0.6), Palette.col("hazard").lerp(Palette.col("bg"), 0.55),
		Palette.col("warn").lerp(Palette.col("bg"), 0.62), Palette.col("bg_alt").lerp(Palette.col("ink"), 0.25)]
	var col: Color = shades[posmod(hsh >> 9, shades.size())]
	if tiled:   # red clay tiles (Sarona's Templer houses), a little weathered one from the next
		col = Palette.col("hazard").lerp(Palette.col("warn"), 0.4).lerp(Palette.col("bg"), 0.3 + 0.12 * float(posmod(hsh >> 9, 3)))
	if wall_buf != null:   # Dutch: orange-red clay tiles, or dark glazed ones, about half each
		var tiles := Palette.col("hazard").lerp(Palette.col("warn"), 0.55).lerp(Palette.col("bg"), 0.45 + 0.08 * float(posmod(hsh >> 9, 3)))
		var glazed := Palette.col("bg").lerp(Palette.col("bg_alt"), 0.45 + 0.1 * float(posmod(hsh >> 9, 3)))
		col = tiles if posmod(hsh >> 15, 100) < 55 else glazed
	var r0: Vector3 = P.call(lo.x, cy, top + rise)
	var r1: Vector3 = P.call(hi.x, cy, top + rise)
	for side: Array in [[lo.y, 1.0], [hi.y, -1.0]]:
		var e0: Vector3 = P.call(lo.x, side[0], top - 0.15)
		var e1: Vector3 = P.call(hi.x, side[0], top - 0.15)
		var nrm := (e1 - e0).cross(r0 - e0).normalized()
		if nrm.y < 0.0:
			nrm = -nrm
		(g["roof"] as Buf).tri(e0, e1, r1, nrm, col)
		(g["roof"] as Buf).tri(e0, r1, r0, nrm, col)
	for end: Array in [[lo.x + 0.35, -1.0], [hi.x - 0.35, 1.0]]:
		var a: Vector3 = P.call(end[0], lo.y + 0.35, top)
		var b: Vector3 = P.call(end[0], hi.y - 0.35, top)
		var c: Vector3 = P.call(end[0], cy, top + rise - 0.1)
		var out := Vector3(u.x, 0, u.y) * float(end[1])
		if wall_buf != null:   # brick, as the walls (the window grid's top at the eaves: none up here)
			var w := (hi.y - lo.y) - 0.7
			var u2 := Vector2(w, top - g_lo)
			wall_buf.tri(a, b, c, out, wcol, Vector2(0, top - g_lo), Vector2(w, top - g_lo),
					Vector2(w * 0.5, top + rise - 0.1 - g_lo), u2)
		else:
			(g["end"] as Buf).tri(a, b, c, out, Color.WHITE)
	if posmod(hsh >> 13, 10) < 6:   # a chimney up one end, through the slope
		var at: Vector3 = P.call(lo.x + 1.3, cy + (hi.y - lo.y) * 0.18, top + rise * 0.72)
		_chimneys.append(Transform3D(Basis(Vector3.UP, atan2(u.x, u.y)), at))

func _bld_box_of(ring: PackedVector2Array) -> Rect2:
	var box := Rect2(ring[0], Vector2.ZERO)
	for p in ring:
		box = box.expand(p)
	return box

## trees: the ones OSM knows, plus a row along each pavement of a residential street
func _build_trees() -> void:
	var rng := RandomNumberGenerator.new()
	var spots: Array = []   ## [x, z, scale]
	var forest := {}        # index into spots -> true
	var grates: Array = []  # an iron grate round each street tree's trunk, flat on the pavement
	var setts := new_cbuf(BLD_CELL)   # light setts laid in the paving round trees, where filmed
	var pits: Array = []    # or a square of bare earth
	var k := 1.0 / float(_city_data.get("scale", 10))
	var tr: Array = _city_data.get("trees", [])
	var info: Array = _city_data.get("tree_info", [])   # [form, crown dm] a tree, from a town's own map
	var forms: Array = _city_data.get("tree_forms", [])
	var fixed := {}     # index into spots -> the kind its species gives it
	var mapped := 0
	var look := String(_place.get("look", ""))
	for i: int in _tile_trees.get(_tile, []):
		var p := Vector2(tr[i], tr[i + 1]) * k
		var fi := int(info[i]) if i + 1 < info.size() else -1
		var cr := float(info[i + 1]) * 0.1 if i + 1 < info.size() else 0.0
		if fi >= 0 or cr > 0.0:   # (a town's map: moved onto the pavement or off a wall, not lost)
			if not _mapped_tree_ok(p):
				p = _tree_nudge(p, 4.0 if cr > 0.0 else 2.5)
				if p == Vector2.INF:
					_tally("trees_mapped_lost", 1)
					continue
				_tally("trees_mapped_moved", 1)
		elif not _tree_ok(p, 2.0):
			continue
		_add_post(p, 0.3)
		rng.seed = _hash_i(p)
		var sc := rng.randf_range(0.85, 1.3)
		var kind := String(forms[fi]) if fi >= 0 and fi < forms.size() and TREE_KINDS.has(forms[fi]) else ""
		if cr > 0.0:   # a crown mapped from the air: as big as it, and a kind that fits its size
			if kind == "":
				kind = _crown_kind(cr, rng.randf(), look)
			var spec: Array = TREE_KINDS[kind]
			if String(spec[0]) != "ptrunk":
				sc = clampf(cr / (spec[3] as Vector3).x, 0.45, 2.4)
		if kind != "":
			fixed[spots.size()] = kind
		# on the pavement: an iron grate round the trunk, or a square of bare earth, as the
		# made-up street rows have (they are not made where a town's map covers)
		if fi >= 0 or cr > 0.0:
			var hit := _nearest_seg(p, 6.0, true)
			if not hit.is_empty() and float(hit["edge"]) < 3.0 and TREE_ROADS.has(_roads[int(hit["road"])]["k"]):
				var rp: PackedVector2Array = _roads[int(hit["road"])]["pts"]
				var dd := rp[int(hit["seg"]) + 1] - rp[int(hit["seg"])]
				var gxf := Transform3D(Basis(Vector3.UP, atan2(dd.x, dd.y)), Vector3(p.x, _h(p) + KERB_H + 0.006, p.y))
				if look == "med" and posmod(_hash_i(p * 5.0), 10) < 4:
					pits.append(gxf)
				else:
					grates.append(Transform3D(Basis(Vector3.UP, sc * 9.0), gxf.origin))
		spots.append(Vector3(p.x, p.y, sc))
		mapped += 1
	_tally("trees_mapped", mapped)
	_trees_mapped += mapped
	# a row along each pavement of a residential street (the road's own random numbers, so
	# every square it crosses plants it alike, each its own stretch)
	for ri: int in _tile_roads.get(_tile, []):
		var r: Dictionary = _roads[ri]
		if not TREE_ROADS.has(r["k"]) or _trees_made - _trees_mapped + spots.size() - mapped >= MAX_TREES:
			continue
		if _over():
			await _pause()
		rng.seed = hash(_city_name) + ri * 7919
		var pts: PackedVector2Array = r["pts"]
		var ids: PackedInt32Array = r["ids"]
		var off: float = r["w"] * 0.5 + 1.3
		var s := rng.randf() * TREE_GAP
		var last := {}   # side -> the last tree on it (for the setts' band between trees)
		for j in range(pts.size() - 1):
			var a := pts[j]
			var b := pts[j + 1]
			var L := a.distance_to(b)
			var d := (b - a) / maxf(L, 0.001)
			var side := Vector2(-d.y, d.x)
			# real streets keep the corners clear (sight lines); so do we
			var keep_a := _node_r[ids[j]] + 9.0 if (_node_roads[ids[j]] as Array).size() >= 2 else 0.0
			var keep_b := _node_r[ids[j + 1]] + 9.0 if (_node_roads[ids[j + 1]] as Array).size() >= 2 else 0.0
			while s < L:
				if s < keep_a or s > L - keep_b:
					s += TREE_GAP
					continue
				for sgn: float in [-1.0, 1.0]:
					if rng.randf() < 0.22:
						continue
					var p := a + d * s + side * off * sgn
					var sc := rng.randf_range(0.8, 1.25)
					# (and not on a rounded corner's asphalt: a street's trees, spaced along it,
					# landed on the next street's corner -- city_check)
					if _mine(p) and _tree_covered(p) == 0 and not _mapped_near(p) and _tree_ok(p, 5.0) \
							and not _in_corner_fill(p, 0.15):
						_add_post(p, 0.3)
						spots.append(Vector3(p.x, p.y, sc))
						_tally("trees_made_up_rows", 1)
						if r.get("setts", false):
							_sett_fan(setts, p, side * sgn)
							if last.has(sgn) and (last[sgn] as Vector2).distance_to(p) < TREE_GAP * 1.8:
								_sett_band(setts, last[sgn], p)
							last[sgn] = p
						# an iron grate round the trunk, or (four in ten, in Israel) a square of bare
						# earth with a low concrete edge and the drip hose that waters it
						var xf := Transform3D(Basis(Vector3.UP, atan2(d.x, d.y)), Vector3(p.x, _h(p) + KERB_H + 0.006, p.y))
						if String(_place.get("look", "")) == "med" and posmod(_hash_i(p * 5.0), 10) < 4:
							pits.append(xf)
						else:
							grates.append(Transform3D(Basis(Vector3.UP, sc * 9.0), xf.origin))
				s += TREE_GAP + rng.randf_range(-2.5, 2.5)
			s -= L
	# parks get trees where OSM has few; woods are filled (conifers in the north): each
	# square plants its share of an outline, in its own part of it
	var sq := _tile_rect(_tile)
	for kind: String in ["park", "grass", "wood"]:
		for ring: PackedVector2Array in _rings_near(kind):
			var area := _area(ring)
			if area < 500.0 or _trees_made - _trees_mapped + spots.size() - mapped >= MAX_TREES + MAX_FOREST:
				continue
			var box := _bld_box_of(ring)
			var part := box.intersection(sq)
			if part.get_area() <= 0.0:
				continue
			var per := 70.0 if kind == "wood" else 160.0
			var want := roundi(mini(int(area / per), 2500) * part.get_area() / maxf(box.get_area(), 1.0))
			rng.seed = _hash_i(ring[0]) + _tile.x * 92821 + _tile.y * 68917
			for _i in range(want * 2):
				if want <= 0 or _trees_made - _trees_mapped + spots.size() - mapped >= MAX_TREES + MAX_FOREST:
					break
				if _over():
					await _pause()
				var p := Vector2(rng.randf_range(part.position.x, part.end.x), rng.randf_range(part.position.y, part.end.y))
				var sc := rng.randf_range(0.8, 1.35)
				if not _mine(p) or not Geometry2D.is_point_in_polygon(p, ring) or _tree_covered(p) >= 2 \
						or not _tree_ok(p, 4.5 if kind == "wood" else 7.0) or _in_corner_fill(p, 0.15):
					continue
				_add_post(p, 0.3)
				if kind == "wood":
					forest[spots.size()] = true
				spots.append(Vector3(p.x, p.y, sc))
				want -= 1
	# open land: copses and lone trees where the ground is green, and shrubs, clumped by the
	# same kind of noise as the ground's colour. Kept off water, car parks and plazas, and
	# well off the roads; thinned evenly to the city's cap (_trees_setup)
	var north := String(_place.get("look", "")) == "north"
	var wild_cap := 15000 if north else 1800
	var step := 22.0 if north else 16.0
	var thresh := 0.56 if north else 0.7
	var nx := int(_bounds.size.x / step)
	var nz := int(_bounds.size.y / step)
	var gx0 := maxi(0, ceili((sq.position.x - _bounds.position.x) / step - 0.5))
	var gx1 := mini(nx - 1, floori((sq.end.x - _bounds.position.x) / step - 0.5))
	var gz0 := maxi(0, ceili((sq.position.y - _bounds.position.y) / step - 0.5))
	var gz1 := mini(nz - 1, floori((sq.end.y - _bounds.position.y) / step - 0.5))
	var wild := 0
	for gz in range(gz0, gz1 + 1):
		if _over():
			await _pause()
		for gx in range(gx0, gx1 + 1):
			var c := _bounds.position + Vector2(gx + 0.5, gz + 0.5) * step
			if not _mine(c) or _wild_made >= wild_cap:
				continue
			if _vnoise(c / 70.0) * 0.65 + _vnoise(c / 15.0) * 0.35 < thresh:
				continue
			rng.seed = gx * 73856093 + gz * 19349663
			if rng.randf() > _wild_keep:
				continue
			var p := c + Vector2(rng.randf() - 0.5, rng.randf() - 0.5) * step
			var blocked := false
			for ri: int in _near(_no_grow, p, 1.0, 60.0):
				if Geometry2D.is_point_in_polygon(p, _no_rings[ri]):
					blocked = true
					break
			if blocked or _tree_covered(p) >= 2 or not _off_road(p, 5.0) or not _tree_ok(p, 6.0):
				continue
			_add_post(p, 0.3)
			forest[spots.size()] = true
			spots.append(Vector3(p.x, p.y, rng.randf_range(0.7, 1.25)))
			wild += 1
			_wild_made += 1
	_tally("wild_trees", wild)
	# the made-up town's mountains: woods of pine, with cypress and olive, in clumps up the
	# slopes (the noise the ground's scrub follows), thinning toward the crests; not on
	# cliffs, roads or the lookout's road
	var mtn := {}
	if _mtn_from < 10000.0:
		var ms := 11.0
		var mx0 := ceili((sq.position.x - _bounds.position.x) / ms)
		var mx1 := floori((sq.end.x - _bounds.position.x) / ms)
		var mz0 := ceili((sq.position.y - _bounds.position.y) / ms)
		var mz1 := floori((sq.end.y - _bounds.position.y) / ms)
		for gz in range(mz0, mz1 + 1):
			if _over():
				await _pause()
			for gx in range(mx0, mx1 + 1):
				if _mtn_made >= MTN_TREES:
					break
				rng.seed = gx * 83492791 + gz * 2971215073 + 7
				var p := _bounds.position + Vector2(gx + rng.randf(), gz + rng.randf()) * ms
				var hy := _h(p)
				if hy < _mtn_from - 20.0 or not _mine(p) or _in_city(p):
					continue
				var clump := _vnoise(p / 90.0 + Vector2(3.0, 3.0)) * 0.6 + _vnoise(p / 24.0) * 0.4
				if clump < 0.47 + (hy - _mtn_from) / 900.0:
					continue
				var tilt := maxf(absf(_h(p + Vector2(3, 0)) - _h(p - Vector2(3, 0))), absf(_h(p + Vector2(0, 3)) - _h(p - Vector2(0, 3)))) / 6.0
				if tilt > 1.25 or not _tree_ok(p, 4.0):
					continue   # a cliff, a road, another tree
				_add_post(p, 0.3)
				mtn[spots.size()] = true
				spots.append(Vector3(p.x, p.y, rng.randf_range(0.8, 1.3)))
				_mtn_made += 1
		_tally("mountain_trees", mtn.size())
	_trees_made += spots.size()
	for sp: Vector3 in spots:   # (where the birds are: the street sounds)
		var sc := _cell(Vector2(sp.x, sp.y), SND_CELL)
		_snd_trees[sc] = int(_snd_trees.get(sc, 0)) + 1
	if not grates.is_empty():
		_chunked(_furn.grate_kit(), grates, 120.0)
	if not pits.is_empty():
		_chunked(_furn.pit_kit(), pits, 120.0)
		_tally("tree_pits", pits.size())
		_tally("tree_grates", grates.size())
	_add_mesh(setts, _vc_mat(), false, DETAIL_RANGE)
	if spots.is_empty():
		return
	var parts := {"trunk": [], "crown": [], "ptrunk": [], "fronds": [], "ftrunk": [], "cone": []}
	var colours := {"trunk": [], "crown": [], "ptrunk": [], "fronds": [], "ftrunk": [], "cone": []}
	var put := func(part: String, xf: Transform3D, col: Color) -> void:
		(parts[part] as Array).append(xf)
		(colours[part] as Array).append(col)
	for si in range(spots.size()):
		var sp: Vector3 = spots[si]
		var sc := sp.z
		var base := Vector3(sp.x, _h(Vector2(sp.x, sp.y)), sp.y)
		rng.seed = _hash_i(Vector2(sp.x, sp.y)) + 101   # the tree's own look, wherever it was planted from
		var spin := Basis(Vector3.UP, rng.randf() * TAU)
		var g := rng.randf_range(0.85, 1.1)
		var kind := _tree_kind(look, forest.has(si), rng.randf())
		if fixed.has(si):
			kind = fixed[si]
		if mtn.has(si):
			var mr := rng.randf()
			kind = "pine" if mr < 0.66 else ("cypress" if mr < 0.9 else "olive")
		var spec: Array = TREE_KINDS[kind]
		# [trunk part, trunk scale (w, h), crown part, crown scale (w, h, w), crown height,
		#  leaf tint, lean (radians)]
		var lean := Basis(Vector3(rng.randf_range(-1, 1), 0, rng.randf_range(-1, 1)).normalized(), rng.randf() * float(spec[6]))
		var b := lean * spin
		var tw: Vector2 = spec[1]
		var cw: Vector3 = spec[3]
		var tint: Color = spec[5]
		var jitter := Vector3(rng.randf_range(0.85, 1.15), rng.randf_range(0.85, 1.15), rng.randf_range(0.85, 1.15))
		var tpart: String = spec[0]
		var trunk_h := 2.6 if tpart != "ptrunk" else 7.0
		# a street's trees are pruned up over the pavement: branches from STREET_BRANCHES, leaves
		# from STREET_LEAVES (a walk's camera went through an olive's at 1.2-1.6 m). Only those
		# within 3 m of a road's edge: not the parks', woods', mountains', yards' or a footpath's
		# (the filmed passage's low planting closes it in, and lifting it scored 6-9 worse there).
		var lift := 0.0
		var by_road := false
		if tpart == "trunk" and not forest.has(si) and not mtn.has(si):
			var rh: Dictionary = _nearest_seg(Vector2(sp.x, sp.y), 6.0, true)
			by_road = not rh.is_empty() and float(rh["edge"]) < 3.0   # (over a pavement: not a passage's, a yard's)
		if by_road:
			var hb := 1.75 * tw.y * sc   # (the trunk mesh's lowest branch, 0.45 over its middle of 2.6)
			if hb < STREET_BRANCHES:
				var ny := tw.y * STREET_BRANCHES / hb
				lift = trunk_h * (ny - tw.y) * sc
				tw = Vector2(tw.x, ny)
			var bottom := float(spec[4]) * sc + lift - CROWN_LOW * cw.y * jitter.y * sc
			if bottom < STREET_LEAVES:
				lift += STREET_LEAVES - bottom
		var bark := Color(1.9, 1.9, 1.8) if kind == "birch" else (Color(1.6, 1.55, 1.45) if kind == "eucalyptus" else Color(1, 1, 1))
		# the leaves (the atlas cell rides in the colour's alpha); some of the round street
		# trees are feathery, like the melias and jacarandas that line Israeli streets
		var cell: int = LEAF_CELL.get(kind, 0)
		if kind == "round" and rng.randf() < 0.3:
			cell = 2
		put.call(tpart, Transform3D(b * Basis.from_scale(Vector3(tw.x, tw.y, tw.x) * sc), base + b * Vector3(0, trunk_h * 0.5 * tw.y * sc, 0)), bark)
		put.call(spec[2], Transform3D(b * Basis.from_scale(cw * jitter * sc), base + b * Vector3(0, float(spec[4]) * sc + lift, 0)),
			Color(tint.r * g, tint.g * g, tint.b * g, (float(cell) + 0.5) / 4.0))
		var tat := Time.get_ticks_usec()
		_ao_tree(Vector2(sp.x, sp.y), cw.x * jitter.x * sc * (0.55 if tpart == "ptrunk" else 0.85), float(spec[4]) * sc + lift)
		if not forest.has(si) and not mtn.has(si):   # the trunk's foot (the street's trees: not the parks', open land's or mountains')
			_ao_disc(Vector2(sp.x, sp.y), (0.45 if tpart == "ptrunk" else 0.6) * sc, 0.7)
		_part_time("trees: shadows on the ground (far, trunk feet)", tat)
	# a square that is mostly mountain woods: drawn from further off, as they are seen across
	# the valley
	var reach := TREE_RANGE * 1.7 if mtn.size() * 2 > spots.size() else TREE_RANGE
	for part: String in parts:
		await _chunked_paced(_tree_meshes[part], parts[part], reach, colours[part], null, true)

var _tree_meshes := {}
const STREET_BRANCHES := 2.2         ## m: a street tree's lowest branch (pruned over the pavement)
const STREET_LEAVES := 2.5           ## m: its lowest leaves
const CROWN_LOW := 0.75              ## the card crown's reach below its middle, per unit of its height scale
const TREE_COVER := 40.0             ## a town's map of every tree covers within 40-80 m of its trees (cells this big)
var _tree_cover := {}                ## TREE_COVER cell -> 2: every tree there is mapped (from the air)
const TREE_NEAR := 9.0               ## no made-up street tree this near a listed one (a row's gap is 11 m)
var _tree_near := {}                 ## TREE_NEAR cell -> the listed street trees in it (a town's list)

## A tree from a town's list of street trees stands within TREE_NEAR of p
func _mapped_near(p: Vector2) -> bool:
	var c := _cell(p, TREE_NEAR)
	for dz in range(-1, 2):
		for dx in range(-1, 2):
			for q: Vector2 in _tree_near.get(c + Vector2i(dx, dz), []):
				if q.distance_to(p) < TREE_NEAR:
					return true
	return false
var _trees_mapped := 0               ## trees from the city file (they do not count toward the caps)

## How much of p's trees a town's own map has: 0 not all (make up what is missing), 2 every
## tree (mapped from the air: yards and parks too)
func _tree_covered(p: Vector2) -> int:
	var c := _cell(p, TREE_COVER)
	var best := 0
	for dz in range(-1, 2):
		for dx in range(-1, 2):
			best = maxi(best, int(_tree_cover.get(c + Vector2i(dx, dz), 0)))
	return best

## Room for a real tree's trunk (a town's map of its trees): clear of the asphalt by 0.4 m and
## of a wall by 0.6, 1.2 m from the next post. The made-up trees' room (_tree_ok: 0.7 m and
## 1.1 m, 2 m apart) needs a 1.8 m gap between kerb and wall, which narrow pavements lack.
## The asphalt is the road's strip, a rounded corner's and a junction's disc: on the strip
## alone, 40 of Givatayim's and 42 of Tel Aviv's mapped trees stood up to 1.3 m into a
## corner's curve (tests/city_check.gd, "posts on the road").
func _mapped_tree_ok(p: Vector2) -> bool:
	if not _bounds.has_point(p):
		return false
	if not _off_road(p, 0.4) or _in_junction(p, 0.4):
		return false
	if _push_out(p, 0.6, false) != Vector2.ZERO:
		return false
	for i: int in _near(_post_hash, p, 1.2, BLD_CELL):
		if _posts[i].distance_to(p) < 1.2:
			return false
	return true

## A tree a town's map puts in the game's road or in a house -- the maps do not quite agree (a
## road's width is a guess; Tel Aviv plants trees in the parking lane, between the cars; a
## crown traced from the air is centred over the roof it overhangs) -- moved onto the pavement
## beside the road (a metre from the kerb, else 0.6 m) and out to the nearest wall's foot,
## if it is no more than `deep` metres into the house; INF when no such place is clear (a
## boulevard's middle, a courtyard OSM draws as roof). Half of Tel Aviv's surveyed street
## trees and two in five of Givatayim's crowns failed where they stood.
func _tree_nudge(p: Vector2, deep: float) -> Vector2:
	var hit := _nearest_seg(p, 12.0, true)
	var offs: Array = [0.0]
	var n := Vector2.ZERO
	if not hit.is_empty() and float(hit["edge"]) < 0.4:
		if float(hit["edge"]) < -4.5:
			return Vector2.INF
		var q: Vector2 = hit["q"]
		n = p - q
		if n.length() < 0.05:   # on the middle line: off to one side, the same side every time
			var rp: PackedVector2Array = _roads[int(hit["road"])]["pts"]
			var dd := (rp[int(hit["seg"]) + 1] - rp[int(hit["seg"])]).normalized()
			n = Vector2(-dd.y, dd.x) * (1.0 if _hash_i(p) % 2 == 0 else -1.0)
		n = n.normalized()
		offs = [1.0 - float(hit["edge"]), 0.6 - float(hit["edge"])]
	for off: float in offs:
		var c: Vector2 = _out_of_corner(p + n * off, 0.6)   # round a corner: out past its curve
		var push := _push_out(c, 0.6, false)
		if push.length() > deep + 0.6:
			continue
		c += push
		if _mapped_tree_ok(c):
			return c
	return Vector2.INF

## The kind of a tree mapped from the air by its crown's radius alone (m): the big ones the
## old ficus and eucalyptus, the small ones young trees and olives, between them the
## street's usual mix
func _crown_kind(r: float, x: float, look: String) -> String:
	if look == "north":
		return _tree_kind(look, false, x)
	if r >= 5.5:
		return "ficus" if x < 0.7 else "eucalyptus"
	if r < 1.3:
		return "olive" if x < 0.4 else "round"
	return _tree_kind(look, false, x)

const MTN_TREES := 3000              ## the made-up town's mountain woods, all told
var _mtn_made := 0
var _trees_made := 0
var _wild_made := 0
var _wild_keep := 1.0                ## the share of open land's green spots that get a tree
var _no_grow := {}
var _no_rings: Array = []

## What every square's trees share: the meshes, where nothing grows, and how thinly open
## land is planted -- counted over the whole map first (on every third row and column: an
## estimate is enough), then each green spot kept with the same chance, so the city's cap
## thins them evenly (stopping at the cap left the far side of the map bare).
func _trees_setup() -> void:
	var north := String(_place.get("look", "")) == "north"
	for kind: String in ["water", "parking", "plaza", "pitch"]:
		for ring: PackedVector2Array in _area_rings.get(kind, []):
			_hash_add(_no_grow, _bld_box_of(ring), 60.0, _no_rings.size())
			_no_rings.append(ring)
	var step := 22.0 if north else 16.0
	var thresh := 0.56 if north else 0.7
	var wild_cap := 15000 if north else 1800
	var nx := int(_bounds.size.x / step)
	var nz := int(_bounds.size.y / step)
	var green := 0
	for gz in range(0, nz, 3):
		for gx in range(0, nx, 3):
			var c := _bounds.position + Vector2(gx + 0.5, gz + 0.5) * step
			if _vnoise(c / 70.0) * 0.65 + _vnoise(c / 15.0) * 0.35 >= thresh:
				green += 9
	_wild_keep = minf(1.0, float(wild_cap) * 1.4 / maxf(green, 1.0))
	var leaf := _surface("leaf")   # (the hedges and bushes still use it plain)
	leaf.vertex_color_use_as_albedo = true
	_surface("trunk").vertex_color_use_as_albedo = true
	var mats := _make_tree_mats()
	var palm_trunk := CylinderMesh.new()
	palm_trunk.top_radius = 0.15
	palm_trunk.bottom_radius = 0.24
	palm_trunk.height = 7.0
	palm_trunk.radial_segments = 8
	palm_trunk.rings = 1
	palm_trunk.material = mats[3]
	_tree_meshes = {"trunk": _trunk_mesh(3, mats[2]), "crown": _card_crown(CROWN_LUMPS, 28, mats[0]), "ptrunk": palm_trunk,
		"fronds": _frond_mesh(mats[4]), "ftrunk": _trunk_mesh(0, mats[2]), "cone": _card_cone(70, mats[1])}

## Trees by kind, after what the streets really have. Givatayim: big dark ficus, light
## feathery acacias and jacarandas, round street trees, olives, a few cypresses and Aleppo
## pines, date palms and tall thin fan palms, and tall pale eucalyptus (the roadsides' and
## parks' tree). Bedford: maples, oaks, birches, spruce.
## [trunk part, trunk (width, height) scale, crown part, crown (w, h, w) scale, crown
## height, leaf tint, most lean]. All from four meshes, so variety costs no draw calls.
const TREE_KINDS := {
	"ficus":   ["trunk", Vector2(1.7, 0.95), "crown", Vector3(3.3, 2.3, 3.3), 3.9, Color(0.62, 0.8, 0.64), 0.04],
	"acacia":  ["trunk", Vector2(0.9, 1.25), "crown", Vector3(2.9, 1.65, 2.9), 4.4, Color(1.12, 1.2, 0.82), 0.1],
	"round":   ["trunk", Vector2(1.0, 1.0), "crown", Vector3(2.2, 2.0, 2.2), 3.9, Color(0.9, 1.02, 0.88), 0.05],
	"olive":   ["trunk", Vector2(1.2, 0.7), "crown", Vector3(1.6, 1.25, 1.6), 2.6, Color(0.92, 0.98, 0.9), 0.12],
	"cypress": ["ftrunk", Vector2(0.8, 0.4), "cone", Vector3(0.32, 1.55, 0.32), 5.1, Color(0.55, 0.72, 0.6), 0.02],
	"pine":    ["trunk", Vector2(0.95, 2.7), "crown", Vector3(2.5, 1.55, 2.5), 7.7, Color(0.6, 0.76, 0.72), 0.12],
	"eucalyptus": ["trunk", Vector2(0.95, 2.4), "crown", Vector3(2.3, 2.4, 2.3), 8.3, Color(0.8, 0.94, 0.86), 0.12],
	"date":    ["ptrunk", Vector2(1.0, 1.0), "fronds", Vector3(1, 1, 1), 7.0, Color(0.95, 1.0, 0.9), 0.14],
	"fan":     ["ptrunk", Vector2(0.62, 1.75), "fronds", Vector3(0.62, 0.7, 0.62), 12.2, Color(0.95, 1.05, 0.8), 0.05],
	"maple":   ["trunk", Vector2(1.2, 1.1), "crown", Vector3(2.8, 2.5, 2.8), 4.4, Color(0.9, 1.0, 0.8), 0.04],
	"oak":     ["trunk", Vector2(1.6, 1.0), "crown", Vector3(3.4, 2.4, 3.4), 4.3, Color(0.7, 0.86, 0.68), 0.05],
	"birch":   ["trunk", Vector2(0.65, 1.5), "crown", Vector3(1.6, 2.2, 1.6), 4.6, Color(1.1, 1.18, 0.85), 0.08],
	"spruce":  ["ftrunk", Vector2(1.0, 0.6), "cone", Vector3(1.0, 1.25, 1.0), 4.6, Color(0.68, 0.8, 0.72), 0.02],
}

func _tree_kind(look: String, wood: bool, r: float) -> String:
	if look == "north":
		if wood:
			return "spruce" if r < 0.68 else ("birch" if r < 0.82 else ("maple" if r < 0.93 else "oak"))
		# (no spruce along a street: its boughs sweep the ground 4 m across, and a walk's camera went
		# through them on Bedford's pavements -- the north's spruces are the woods' and yards')
		return "maple" if r < 0.5 else ("birch" if r < 0.72 else "oak")
	if wood:
		return "pine" if r < 0.38 else ("eucalyptus" if r < 0.58 else ("cypress" if r < 0.68 else ("olive" if r < 0.84 else "round")))
	var table := [["ficus", 0.22], ["acacia", 0.39], ["round", 0.56], ["olive", 0.63], ["cypress", 0.68],
		["pine", 0.73], ["eucalyptus", 0.79], ["date", 0.9], ["fan", 1.0]]
	for t: Array in table:
		if r < float(t[1]):
			return t[0]
	return "round"

## ---- trees: leaf cards, bark, palm fronds ------------------------------------------------
## A crown is a cloud of cards, each a cluster of leaves from textures/leaves_atlas.png
## (2x2: broad leaves, small narrow ones, feathery fronds, needle sprays; made by
## textures/leaf_atlas.py from Poly Haven's CC0 leaf photos). The vertex shader turns every
## card to face the camera (or the sun, in the shadow pass: dappled shadows), lights it as
## if the crown were a soft ball, and gives every tree its own outline -- cards pushed out
## here and in there, a few left out -- and a little sway in the wind. The leaf kind and the
## colour come in each copy's instance colour (alpha: the atlas cell), so all of this costs
## no more draw calls than the plain balls did. The photos are divided by each cell's average
## colour, so the palette's leaf tone still decides the colour.
const CROWN_SHADER := """
shader_type spatial;
render_mode cull_disabled, skip_vertex_transform;
uniform sampler2D leaves : filter_linear_mipmap, repeat_disable;
uniform vec3 leaf_col : source_color;
uniform vec3 cell_mean[4];
uniform float card_size = 0.5;     // half a card, in the crown's own size
uniform float keep = 1.0;          // the share of cards drawn (fewer at the lowest quality)
varying vec3 tint;
varying vec2 cuv;
varying float shade;
varying float lighter;
varying flat int cell;
varying flat float core;   // 1 on a conifer's solid middle (UV2.y -1): plain geometry, no card
float h1(float n) { return fract(sin(n * 12.9898) * 43758.5453); }
void vertex() {
	core = UV2.y < -0.5 ? 1.0 : 0.0;
	tint = COLOR.rgb;
	cell = int(clamp(floor(COLOR.a * 4.0), 0.0, 3.0));
	if (core > 0.5) {
		VERTEX = (MODELVIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
		NORMAL = normalize((MODELVIEW_MATRIX * vec4(NORMAL, 0.0)).xyz);
		cuv = vec2(0.5);
		shade = 0.4;
		lighter = 0.0;
	} else {
	vec3 o = MODEL_MATRIX[3].xyz;
	float seed = h1(o.x * 0.37 + o.z * 1.13);
	float r = UV2.x;        // the card's own random number
	float out_ = UV2.y;     // 0 deep in the crown .. 1 at its surface
	vec3 n = NORMAL;        // out from the crown's middle
	vec3 p = VERTEX + n * (sin(dot(n, vec3(2.1, 1.3, 1.7)) * 2.0 + seed * 6.28) * 0.16
		+ sin(dot(n, vec3(-1.4, 2.3, 0.9)) * 3.0 + seed * 11.0) * 0.1);
	float sx = length(MODEL_MATRIX[0].xyz);
	float sy = length(MODEL_MATRIX[1].xyz);
	float sz = length(MODEL_MATRIX[2].xyz);
	float sc = mix((sx + sz) * 0.5, sy, 0.25);
	bool alive = fract(r * 13.7 + seed * 7.31) < keep * 0.9;
	float s = alive ? card_size * (0.75 + 0.5 * fract(r * 5.3)) * sc * inversesqrt(keep) : 0.0;
	vec3 c = (MODELVIEW_MATRIX * vec4(p, 1.0)).xyz;
	float t = TIME * 1.1 + seed * 6.28;
	c.x += (sin(t) * 0.035 + sin(t * 2.7 + r * 6.0) * 0.03 * out_) * sc;
	vec2 k = UV * 2.0 - 1.0;
	float a = r * 6.2832 + seed * 3.0;
	VERTEX = c + vec3(k.x * cos(a) - k.y * sin(a), k.x * sin(a) + k.y * cos(a), 0.0) * s;
	vec3 nv = normalize((MODELVIEW_MATRIX * vec4(n, 0.0)).xyz);
	NORMAL = normalize(mix(nv, vec3(0.0, 0.0, 1.0), 0.2));
	cuv = UV;
	// deep in the crown and underneath it darker; some clumps lighter, some darker
	shade = mix(0.58, 1.0, out_) * mix(0.78, 1.05, clamp(p.y * 0.5 + 0.5, 0.0, 1.0)) * (0.88 + 0.24 * h1(r * 3.1 + seed));
	lighter = step(0.82, h1(r * 7.7 + seed * 2.0));
	}
}
void fragment() {
	vec2 uv = (cuv * 0.94 + 0.03 + vec2(float(cell % 2), float(cell / 2))) * 0.5;
	vec4 t = texture(leaves, uv);
	// smaller mipmaps average the leaves' edges away: thicken the alpha with distance, or
	// far trees thin out to nothing
	vec2 ts = uv * 1024.0;
	vec2 dx = dFdx(ts);
	vec2 dy = dFdy(ts);
	float lod = max(0.0, 0.5 * log2(max(dot(dx, dx), dot(dy, dy))));
	vec3 c = leaf_col * tint * clamp(t.rgb / cell_mean[cell], vec3(0.0), vec3(2.5)) * shade;
	c *= mix(vec3(1.0), vec3(1.16, 1.1, 0.78), lighter * 0.8);
	ALBEDO = core > 0.5 ? leaf_col * tint * shade : c;
	ALPHA = core > 0.5 ? 1.0 : clamp(t.a * (1.0 + lod * 0.35), 0.0, 1.0);
	ALPHA_SCISSOR_THRESHOLD = 0.5;
	ROUGHNESS = 0.85;
	SPECULAR = 0.25;
}
"""

## Bark: a photo (textures/) over its average, times the palette's trunk tone and the copy's
## colour (birches and eucalyptus pale), with its bumps
const BARK_SHADER := """
shader_type spatial;
uniform sampler2D bark_tex : filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D bark_nrm : filter_linear_mipmap_anisotropic, repeat_enable;
uniform vec3 bark_mean = vec3(0.5);
uniform vec3 bark_col : source_color;
uniform vec2 uv_scale = vec2(1.0, 1.0);
uniform float textured = 1.0;
void fragment() {
	vec2 uv = UV * uv_scale;
	vec3 c = bark_col * COLOR.rgb;
	if (textured > 0.5) {
		c *= clamp(texture(bark_tex, uv).rgb / bark_mean, vec3(0.0), vec3(2.5));
		NORMAL_MAP = vec3(texture(bark_nrm, uv).rg, 1.0);
	}
	ALBEDO = c;
	ROUGHNESS = 0.92;
}
"""

## A palm frond: a strip along the frond (UV.y 0 at the trunk .. 1 at the tip, UV.x -1..1
## across), cut by the shader into a rib and leaflets slanting out toward the tip, narrow
## at both ends, the tips drying yellow
const FROND_SHADER := """
shader_type spatial;
render_mode cull_disabled;
uniform vec3 leaf_col : source_color;
void fragment() {
	float u = abs(UV.x);
	float v = UV.y;
	float edge = 0.1 + 0.9 * pow(sin(clamp(v, 0.0, 1.0) * 3.14159), 0.6);
	float f = v * 34.0 - u * 1.8;
	float k = fract(f);
	float aa = fwidth(f) + 0.001;
	float leaflet = 1.0 - smoothstep(0.58 - aa, 0.58 + aa, k);
	float inside = 1.0 - smoothstep(edge - 0.04, edge, u);
	float rib = 1.0 - smoothstep(0.03, 0.05, u);
	ALPHA = max(rib, leaflet * inside);
	ALPHA_SCISSOR_THRESHOLD = 0.5;
	vec3 c = leaf_col * COLOR.rgb * (0.78 + 0.35 * u) * mix(1.06, 0.82, k);
	c = mix(c, c * vec3(1.3, 1.18, 0.66), smoothstep(0.72, 1.0, v) * 0.6 * (1.0 - rib));
	ALBEDO = mix(c, leaf_col * COLOR.rgb * vec3(1.1, 1.05, 0.7), rib * 0.6);
	ROUGHNESS = 0.7;
	SPECULAR = 0.3;
}
"""

## a broad-leaved crown's lumps (middle, radius), in the crown's own size: close enough to
## read as one crown, not a bunch of balls
const CROWN_LUMPS := [[Vector3(0, 0, 0), 1.0], [Vector3(0.45, 0.1, 0.25), 0.78], [Vector3(-0.4, 0.15, -0.3), 0.75],
	[Vector3(0.05, 0.45, -0.02), 0.72]]
## the atlas cell each kind's leaves come from: 0 broad, 1 small and narrow, 2 feathery, 3 needles
const LEAF_CELL := {"ficus": 0, "round": 0, "maple": 0, "oak": 0, "acacia": 2, "olive": 1, "birch": 1,
	"eucalyptus": 1, "pine": 3, "cypress": 3, "spruce": 3, "date": 0, "fan": 0}
## each cell's average colour as stored (leaf_atlas.py prints them), for the shader to divide by
const LEAF_MEAN := [Vector3(0.332, 0.355, 0.113), Vector3(0.333, 0.357, 0.116),
	Vector3(0.405, 0.433, 0.230), Vector3(0.200, 0.294, 0.138)]
var _tree_mats: Array = []           ## [crown, cone, bark, palm bark, fronds] materials, for the palette

func _tree_shader_mat(code: String) -> ShaderMaterial:
	var m := ShaderMaterial.new()
	var sh := Shader.new()
	sh.code = code
	m.shader = sh
	return m

## the materials, once per city: cards for crowns and cones (each its own card size), two
## barks, the fronds
func _make_tree_mats() -> Array:
	var atlas := load(TEX_DIR + "leaves_atlas.png") as Texture2D
	var means := PackedVector3Array(LEAF_MEAN)
	var crown := _tree_shader_mat(CROWN_SHADER)
	crown.set_shader_parameter("leaves", atlas)
	crown.set_shader_parameter("cell_mean", means)
	crown.set_shader_parameter("card_size", 0.5)
	var cone := crown.duplicate() as ShaderMaterial
	cone.set_shader_parameter("card_size", 0.75)
	var bark := _tree_shader_mat(BARK_SHADER)
	bark.set_shader_parameter("bark_tex", _tex("bark_brown_02_diff"))
	bark.set_shader_parameter("bark_nrm", _tex("bark_brown_02_nor"))
	bark.set_shader_parameter("bark_mean", TEX_MEAN["bark_brown_02"])
	bark.set_shader_parameter("uv_scale", Vector2(1.0, 1.0))
	var pbark := bark.duplicate() as ShaderMaterial
	pbark.set_shader_parameter("bark_tex", _tex("palm_tree_bark_diff"))
	pbark.set_shader_parameter("bark_nrm", _tex("palm_tree_bark_nor"))
	pbark.set_shader_parameter("bark_mean", TEX_MEAN["palm_tree_bark"])
	pbark.set_shader_parameter("uv_scale", Vector2(1.0, 3.5))
	var fronds := _tree_shader_mat(FROND_SHADER)
	_tree_mats = [crown, cone, bark, pbark, fronds]
	_retint_trees()
	_tree_quality()
	return _tree_mats

func _retint_trees() -> void:
	if _tree_mats.is_empty():
		return
	for i in [0, 1, 4]:
		(_tree_mats[i] as ShaderMaterial).set_shader_parameter("leaf_col", _tone["leaf"])
	for i in [2, 3]:
		(_tree_mats[i] as ShaderMaterial).set_shader_parameter("bark_col", _tone["trunk"])

## the lowest web quality: two cards in three (each bigger), and plain bark
func _tree_quality() -> void:
	if _tree_mats.is_empty():
		return
	for i in [0, 1]:
		(_tree_mats[i] as ShaderMaterial).set_shader_parameter("keep", 1.0 if _quality > 0 else 0.67)
	for i in [2, 3]:
		(_tree_mats[i] as ShaderMaterial).set_shader_parameter("textured", 1.0 if _quality > 0 else 0.0)

## One card per corner set: VERTEX the card's middle (the shader spreads its corners across
## the screen), UV the corner, UV2 (the card's random number, how far out of the crown it
## is), NORMAL out from the crown's middle.
func _cards_mesh(cards: Array, m: Material, core: Array = []) -> ArrayMesh:
	var v := PackedVector3Array()
	var nr := PackedVector3Array()
	var uv := PackedVector2Array()
	var uv2 := PackedVector2Array()
	var col := PackedColorArray()
	var idx := PackedInt32Array()
	for cd: Array in cards:
		var at: Vector3 = cd[0]
		var n: Vector3 = cd[1]
		var r: float = cd[2]
		var o: float = cd[3]
		var b := v.size()
		for corner: Vector2 in [Vector2(0, 0), Vector2(1, 0), Vector2(1, 1), Vector2(0, 1)]:
			v.append(at)
			nr.append(n)
			uv.append(corner)
			uv2.append(Vector2(r, o))
			col.append(Color.WHITE)
		idx.append_array([b, b + 1, b + 2, b, b + 2, b + 3])
	# solid core triangles: [position, normal] per corner, UV2.y -1 so the shader leaves them be
	for i in range(core.size()):
		idx.append(v.size())
		v.append(core[i][0])
		nr.append(core[i][1])
		uv.append(Vector2(0.5, 0.5))
		uv2.append(Vector2(0.0, -1.0))
		col.append(Color.WHITE)
	var a := []
	a.resize(Mesh.ARRAY_MAX)
	a[Mesh.ARRAY_VERTEX] = v
	a[Mesh.ARRAY_NORMAL] = nr
	a[Mesh.ARRAY_TEX_UV] = uv
	a[Mesh.ARRAY_TEX_UV2] = uv2
	a[Mesh.ARRAY_COLOR] = col
	a[Mesh.ARRAY_INDEX] = idx
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, a)
	am.surface_set_material(0, m)
	# the cards reach past their middles: a box round the whole crown, or a copy whose
	# middle is just off screen is culled with its leaves still in view
	am.custom_aabb = AABB(Vector3(-2.6, -2.2, -2.6), Vector3(5.2, 4.6, 5.2))
	return am

## a broad-leaved crown: cards through the same few lumps the plain crown had, most of them
## near the outside so the outline is full
func _card_crown(blobs: Array, n: int, m: Material) -> ArrayMesh:
	var rng := RandomNumberGenerator.new()
	rng.seed = 4242
	var vol := 0.0
	for bl: Array in blobs:
		vol += pow(float(bl[1]), 3.0)
	var cards: Array = []
	for _i in range(n):
		var pick := rng.randf() * vol
		var bl: Array = blobs[0]
		for b2: Array in blobs:
			pick -= pow(float(b2[1]), 3.0)
			bl = b2
			if pick <= 0.0:
				break
		var dir := Vector3(rng.randfn(), rng.randfn(), rng.randfn()).normalized()
		var o := 0.35 + 0.65 * sqrt(rng.randf())
		var at: Vector3 = (bl[0] as Vector3) + dir * float(bl[1]) * o
		cards.append([at, (at + Vector3(0, 0.15, 0)).normalized(), rng.randf(), o])
	return _cards_mesh(cards, m)

## a conifer: cards up a cone (the old cone mesh's shape: 6 high, 1.8 round at the foot,
## centred), more toward the foot, and one on the tip, round a dark solid cone a little
## smaller: a real conifer is dense, and through a gap you see more needles, not sky
func _card_cone(n: int, m: Material) -> ArrayMesh:
	var rng := RandomNumberGenerator.new()
	rng.seed = 777
	var cards: Array = [[Vector3(0, 2.75, 0), Vector3.UP, 0.5, 1.0]]
	for _i in range(n - 1):
		var y := -2.7 + 5.3 * pow(rng.randf(), 0.8)
		var rmax := 1.8 * (3.0 - y) / 6.0
		var o := 0.4 + 0.6 * sqrt(rng.randf())
		var a := rng.randf() * TAU
		var at := Vector3(cos(a) * rmax * o, y, sin(a) * rmax * o)
		cards.append([at, Vector3(cos(a), 0.35, sin(a)).normalized(), rng.randf(), o])
	var core: Array = []
	var sides := 8
	for j in range(sides):
		var a0 := TAU * j / sides
		var a1 := TAU * (j + 1) / sides
		var p0 := Vector3(cos(a0) * 1.15, -2.9, sin(a0) * 1.15)
		var p1 := Vector3(cos(a1) * 1.15, -2.9, sin(a1) * 1.15)
		var tip := Vector3(0, 2.3, 0)
		var n0 := Vector3(cos(a0), 0.25, sin(a0)).normalized()
		var n1 := Vector3(cos(a1), 0.25, sin(a1)).normalized()
		core.append_array([[p0, n0], [p1, n1], [tip, Vector3.UP]])
	var am := _cards_mesh(cards, m, core)
	am.custom_aabb = AABB(Vector3(-2.6, -3.6, -2.6), Vector3(5.2, 7.4, 5.2))
	return am

## A trunk (2.6 high, centred, like the cylinder it replaces) with smooth sides, bark UVs in
## metres and, if asked, branches forking up into the crown from its top half, which show
## through the gaps between the leaves
class Tubes:
	var v := PackedVector3Array()
	var nr := PackedVector3Array()
	var tg := PackedFloat32Array()
	var uv := PackedVector2Array()
	var col := PackedColorArray()
	var idx := PackedInt32Array()

	func tube(a: Vector3, b: Vector3, ra: float, rb: float, sides: int) -> void:
		var axis := (b - a).normalized()
		var side := axis.cross(Vector3.FORWARD if absf(axis.y) < 0.9 else Vector3.RIGHT).normalized()
		var side2 := axis.cross(side)
		var L := a.distance_to(b)
		var base := v.size()
		for j in range(sides + 1):
			var ang := TAU * j / sides
			var out := side * cos(ang) + side2 * sin(ang)
			var along := -side * sin(ang) + side2 * cos(ang)
			for e in range(2):
				v.append(a.lerp(b, float(e)) + out * (ra if e == 0 else rb))
				nr.append(out)
				tg.append_array([along.x, along.y, along.z, 1.0])
				uv.append(Vector2(float(j) / sides * 0.9 * (ra + rb) / 0.27, L * float(e)))
				col.append(Color.WHITE)
		for j in range(sides):
			var i0 := base + j * 2
			idx.append_array([i0, i0 + 2, i0 + 1, i0 + 1, i0 + 2, i0 + 3])

	func mesh(m: Material) -> ArrayMesh:
		var a := []
		a.resize(Mesh.ARRAY_MAX)
		a[Mesh.ARRAY_VERTEX] = v
		a[Mesh.ARRAY_NORMAL] = nr
		a[Mesh.ARRAY_TANGENT] = tg
		a[Mesh.ARRAY_TEX_UV] = uv
		a[Mesh.ARRAY_COLOR] = col
		a[Mesh.ARRAY_INDEX] = idx
		var am := ArrayMesh.new()
		am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, a)
		am.surface_set_material(0, m)
		return am

func _trunk_mesh(branches: int, m: Material) -> ArrayMesh:
	var t := Tubes.new()
	t.tube(Vector3(0, -1.3, 0), Vector3(0, 1.3, 0), 0.16, 0.11, 7)
	for i in range(branches):
		var ang := TAU * i / branches + 0.4
		var d := Vector3(cos(ang) * 0.75, 1.0, sin(ang) * 0.75).normalized()
		var s := Vector3(0, 0.45 + 0.3 * (i % 2), 0)
		t.tube(s, s + d * 1.6, 0.075, 0.03, 5)
	return t.mesh(m)

## Palm fronds as strips the frond shader cuts into leaflets: nine drooping, three young ones
## standing up in the middle. UV.x -1..1 across, UV.y 0 at the trunk .. 1 at the tip; the
## two halves fold up a little from the rib, as real fronds do.
func _frond_mesh(m: Material) -> ArrayMesh:
	var v := PackedVector3Array()
	var nr := PackedVector3Array()
	var uv := PackedVector2Array()
	var col := PackedColorArray()
	var idx := PackedInt32Array()
	for i in range(12):
		var young := i >= 9
		var a := TAU * i / 9.0 + 0.3 * (i % 2) if not young else TAU * (i - 9) / 3.0 + 0.5
		var dir := Vector3(cos(a), 0, sin(a))
		var side := Vector3(-dir.z, 0, dir.x)
		var segs := 7
		var base := v.size()
		for s in range(segs + 1):
			var t := float(s) / segs
			var p := dir * 3.1 * t + Vector3(0, 2.1 * t - 2.8 * t * t, 0) if not young \
				else dir * 1.1 * t + Vector3(0, 2.0 * t - 0.4 * t * t, 0)
			var fwd := (dir * 3.1 + Vector3(0, 2.1 - 5.6 * t, 0)).normalized() if not young \
				else (dir * 1.1 + Vector3(0, 2.0 - 0.8 * t, 0)).normalized()
			var w := 0.48 if not young else 0.32
			var fold := Vector3(0, 0.14, 0)
			var up := side.cross(fwd).normalized()
			if up.y < 0.0:
				up = -up
			for k in [-1.0, 0.0, 1.0]:
				v.append(p + side * w * k + fold * absf(k))
				nr.append(up)
				uv.append(Vector2(k, t))
				col.append(Color.WHITE)
		for s in range(segs):
			var r0 := base + s * 3
			var r1 := r0 + 3
			idx.append_array([r0, r1, r0 + 1, r0 + 1, r1, r1 + 1, r0 + 1, r1 + 1, r0 + 2, r0 + 2, r1 + 1, r1 + 2])
	var arr := []
	arr.resize(Mesh.ARRAY_MAX)
	arr[Mesh.ARRAY_VERTEX] = v
	arr[Mesh.ARRAY_NORMAL] = nr
	arr[Mesh.ARRAY_TEX_UV] = uv
	arr[Mesh.ARRAY_COLOR] = col
	arr[Mesh.ARRAY_INDEX] = idx
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
	am.surface_set_material(0, m)
	return am

## Israeli roofs: solar water heaters ("dud shemesh"), a tilted panel facing south with
## its white tank behind, one to a handful per block depending on its size
func _build_roof_kit() -> void:
	if String(_place.get("look", "")) != "med":
		return
	var panels: Array = []
	var tanks: Array = []
	var rooms: Array = []            ## the stairwell room most blocks have on the roof
	var rng := RandomNumberGenerator.new()
	var all: Array = _city_data["buildings"]
	for bi: int in _tile_blds.get(_tile, []):
		if _over():
			await _pause()
		var bd: Dictionary = all[bi]
		var rel: float = bd["_h"]
		if rel < 6.0 or rel > 45.0:
			continue
		var ring: PackedVector2Array = bd["_ring"]
		var box := _bld_box_of(ring)
		var area := 0.0
		var g_sum := 0.0
		for i in range(ring.size()):
			area += ring[i].x * ring[(i + 1) % ring.size()].y - ring[(i + 1) % ring.size()].x * ring[i].y
			g_sum += _h(ring[i])
		var top := g_sum / ring.size() + rel
		var want := clampi(int(absf(area) * 0.5 / 200.0), 1, 4)
		rng.seed = _hash_i(ring[0])
		if rel > 9.0 and rng.randf() < 0.6:
			for _try in range(8):
				var q := Vector2(rng.randf_range(box.position.x, box.end.x), rng.randf_range(box.position.y, box.end.y))
				var room_fits := true
				for d: Vector2 in [Vector2.ZERO, Vector2(2.2, 0), Vector2(-2.2, 0), Vector2(0, 2.4), Vector2(0, -2.4)]:
					if not Geometry2D.is_point_in_polygon(q + d, ring):
						room_fits = false
						break
				if room_fits:
					rooms.append(Transform3D(Basis(Vector3.UP, rng.randf() * 0.2), Vector3(q.x, top + 1.3, q.y)))
					break
		var placed := 0
		for _try in range(want * 5):
			if placed >= want:
				break
			var p := Vector2(rng.randf_range(box.position.x, box.end.x), rng.randf_range(box.position.y, box.end.y))
			var fits := true
			for d: Vector2 in [Vector2.ZERO, Vector2(1.4, 0), Vector2(-1.4, 0), Vector2(0, 1.2), Vector2(0, -1.2)]:
				if not Geometry2D.is_point_in_polygon(p + d, ring):
					fits = false
					break
			if not fits:
				continue
			placed += 1
			# the panel faces south (+z), tilted ~35 degrees; the tank lies behind, east-west
			panels.append(Transform3D(Basis(Vector3.RIGHT, 0.6), Vector3(p.x, top + 0.55, p.y + 0.15)))
			tanks.append(Transform3D(Basis(Vector3.FORWARD, PI * 0.5), Vector3(p.x, top + 1.05, p.y - 0.55)))
	var panel := BoxMesh.new()
	panel.size = Vector3(2.0, 0.06, 1.15)
	panel.material = _surface("solar")
	var tank := CylinderMesh.new()
	tank.top_radius = 0.3
	tank.bottom_radius = 0.3
	tank.height = 1.8
	tank.radial_segments = 8
	tank.rings = 1
	tank.material = _surface("tank")
	_chunked(panel, panels, 420.0)
	_chunked(tank, tanks, 420.0)
	var room := BoxMesh.new()
	room.size = Vector3(3.0, 2.6, 3.4)
	room.material = _surface("roofroom")
	_chunked(room, rooms, VIEW_RANGE * 0.5)
	_tally("roof_rooms", rooms.size())
	_tally("solar", panels.size())

## street lamps along the pavements, every ~34 m, alternating sides
## Lamp posts down the streets, every 34 m, the sides taking turns. Most are tall and grey
## with one arm out over the road. Givatayim's main roads have the ornate dark-green ones,
## a curved arm and a lantern with a flag on a staff off each, and where a main road is
## split into two carriageways, a double one down the middle (the other carriageway's
## lamps are those same ones). In Bedford a street with power lines has its lamps on the
## power poles instead (furniture.gd's wires).
const FANCY_ROADS := {"primary": true, "secondary": true, "tertiary": true}
func _build_lamps() -> void:
	var med := String(_place.get("look", "")) == "med"
	var poles: Array = []
	var arms: Array = []
	var heads: Array = []
	var ornate: Array = []
	var doubles: Array = []
	var lanterns: Array = []
	for ri: int in _tile_roads.get(_tile, []):
		var r: Dictionary = _roads[ri]
		if not r["drive"] or r["pv"] or r["k"] == "service" or _wired.has(ri):
			continue
		if _over():
			await _pause()
		var flip := posmod(ri, 2) == 0   # (from the road's own start: every square alike)
		var fancy := med and FANCY_ROADS.has(r["k"])
		var o := int(r["o"])
		var dual: bool = o != 0 and (FANCY_ROADS.has(r["k"]) or r["k"] == "trunk") and not r.get("ring", false)
		var pts: PackedVector2Array = r["pts"]
		var ids: PackedInt32Array = r["ids"]
		var hw: float = float(r["w"]) * 0.5
		var s := 10.0
		for j in range(pts.size() - 1):
			var a := pts[j]
			var b := pts[j + 1]
			var L := a.distance_to(b)
			var d := (b - a) / maxf(L, 0.001)
			var side := Vector2(-d.y, d.x)
			var keep_a := _node_r[ids[j]] + 6.0 if (_node_roads[ids[j]] as Array).size() >= 2 else 0.0
			var keep_b := _node_r[ids[j + 1]] + 6.0 if (_node_roads[ids[j + 1]] as Array).size() >= 2 else 0.0
			while s < L:
				if s > keep_a and s < L - keep_b and not _lamps_mapped_at(a + d * s):
					flip = not flip
					var c := a + d * s
					var pair: Array = _partner(c, d, ri, hw, o) if dual else []
					if not pair.is_empty():
						# half of a dual carriageway: the lamps go down the middle, planted by the
						# half with the lower number so they go in once
						var gap: float = pair[2]
						var left: Vector2 = pair[3]
						var m := c + left * (hw + gap * 0.5)
						if ri < int(pair[0]) and gap >= 1.0 and _mine(m) and _off_road(m, 0.25) and _push_out(m, 0.3, false) == Vector2.ZERO \
								and _clear_of_posts(m, 3.0):
							var gy := _h(m)
							var bs := Basis(Vector3.UP, atan2(-left.y, left.x))   # local X across the road
							(doubles if med else poles).append(Transform3D(bs if med else Basis(), Vector3(m.x, gy + (0.0 if med else 3.5), m.y)))
							for sg: float in [-1.0, 1.0]:
								var arm_dir := left * sg
								var lp := m + arm_dir * (1.6 if med else 1.75)
								if med:
									lanterns.append(Transform3D(Basis(), Vector3(lp.x, gy + 6.85, lp.y)))
									var fb := Basis(Vector3.UP, atan2(-arm_dir.y, arm_dir.x))
									var fp := m + arm_dir * 0.08
									_flag_spots.append(Transform3D(fb, Vector3(fp.x, gy + 4.4, fp.y)))
								else:
									var face := Basis(Vector3.UP, atan2(-arm_dir.y, arm_dir.x))
									var am := m + arm_dir * 0.9
									arms.append(Transform3D(face, Vector3(am.x, gy + 6.95, am.y)))
									heads.append(Transform3D(face, Vector3(lp.x, gy + 6.85, lp.y)))
								_pool_at.append(Vector3(lp.x + arm_dir.x * 0.5, lp.y + arm_dir.y * 0.5, LAMP_POOL))
							_add_post(m, 0.18)
						s += 34.0
						continue
					# one-way: on the pavement side (right of the traffic); else the sides take turns
					var sgn := float(o) if o != 0 else (1.0 if flip else -1.0)
					var out := side * sgn
					var p := c + out * (hw + 0.9)
					var ok := _mine(p) and _push_out(p, 0.6, false) == Vector2.ZERO
					var on := _nearest_seg(p, 10.0, true)
					# (and off a rounded corner's asphalt: checked by the straight strips alone, a
					# lamp stood 0.5 m onto a corner -- city_check)
					ok = ok and (on.is_empty() or float(on["edge"]) > 0.4) and _clear_of_posts(p, 2.5) \
							and not _in_corner_fill(p, 0.15)
					if ok:
						var gy := _h(p)
						var toward := -out
						if fancy:
							var bs := Basis(Vector3.UP, atan2(-toward.y, toward.x))   # local X out over the road
							ornate.append(Transform3D(bs, Vector3(p.x, gy, p.y)))
							var lp := p + toward * 1.6
							lanterns.append(Transform3D(Basis(), Vector3(lp.x, gy + 6.85, lp.y)))
							var fp := p + toward * 0.08
							_flag_spots.append(Transform3D(bs, Vector3(fp.x, gy + 4.4, fp.y)))
							_pool_at.append(Vector3(lp.x + toward.x * 0.5, lp.y + toward.y * 0.5, LAMP_POOL - 0.5))
						else:
							var face := Basis(Vector3.UP, atan2(-toward.y, toward.x))
							poles.append(Transform3D(Basis(), Vector3(p.x, gy + 3.5, p.y)))
							var arm := p + toward * 0.9
							arms.append(Transform3D(face, Vector3(arm.x, gy + 6.95, arm.y)))
							var head := p + toward * 1.75
							heads.append(Transform3D(face, Vector3(head.x, gy + 6.85, head.y)))
							_pool_at.append(Vector3(head.x + toward.x * 0.6, head.y + toward.y * 0.6, LAMP_POOL))
						_add_post(p, 0.15)
				s += 34.0
			s -= L
	var woods: Array = []
	var walls: Array = []
	for lm: Array in _tile_lamps.get(_tile, []):
		if _over():
			await _pause()
		_mapped_lamp(lm, poles, woods, arms, heads, ornate, lanterns, walls)
	var pole := CylinderMesh.new()
	pole.top_radius = 0.06
	pole.bottom_radius = 0.09
	pole.height = 7.0
	pole.radial_segments = 6
	pole.rings = 1
	pole.material = _surface("pole")
	if not woods.is_empty():
		var wood := CylinderMesh.new()
		wood.top_radius = 0.09
		wood.bottom_radius = 0.12
		wood.height = 7.0
		wood.radial_segments = 6
		wood.rings = 1
		wood.material = _surface("trunk")
		_chunked(wood, woods, LAMP_RANGE)
	if not walls.is_empty():   # a lamp on a wall: a short bracket and the head out from it
		var bracket := BoxMesh.new()
		bracket.size = Vector3(0.6, 0.06, 0.06)
		bracket.material = _surface("pole")
		_chunked(bracket, walls, LAMP_RANGE)
	var arm_m := BoxMesh.new()
	arm_m.size = Vector3(1.8, 0.07, 0.07)
	arm_m.material = _surface("pole")
	var head_m := BoxMesh.new()
	head_m.size = Vector3(0.6, 0.14, 0.28)
	head_m.material = _surface("lamp")
	_chunked(pole, poles, LAMP_RANGE)
	_chunked(arm_m, arms, LAMP_RANGE)
	_chunked(head_m, heads, LAMP_RANGE)
	if not lanterns.is_empty():
		_chunked(_furn.ornate_kit(false), ornate, LAMP_RANGE)
		_chunked(_furn.ornate_kit(true), doubles, LAMP_RANGE)
		var lantern := CylinderMesh.new()
		lantern.top_radius = 0.13
		lantern.bottom_radius = 0.24
		lantern.height = 0.42
		lantern.radial_segments = 6
		lantern.rings = 1
		lantern.material = _surface("lamp")
		_chunked(lantern, lanterns, LAMP_RANGE)
	_tally("lamps", poles.size() + woods.size() + ornate.size() + doubles.size() + walls.size())
	_tally("lamps_ornate", ornate.size())
	_tally("lamps_median", doubles.size())

## the other half of a dual carriageway beside point c of road ri (heading d along its
## points, one-way `o`): [road, nearest point, the gap between their asphalt, the way to
## it], or [] when there is none
func _partner(c: Vector2, d: Vector2, ri: int, hw: float, o: int) -> Array:
	var travel := d * float(o)
	var left := Vector2(travel.y, -travel.x)   # left of the traffic: where the median is
	var best: Array = []
	var best_across := INF
	for code: int in _near(_seg_hash, c, hw + 18.0, SEG_CELL):
		var rj := code / 4096
		if rj == ri:
			continue
		var r2: Dictionary = _roads[rj]
		if not r2["drive"] or int(r2["o"]) == 0 or r2.has("ys"):
			continue
		var p2: PackedVector2Array = r2["pts"]
		var sj := code % 4096
		var d2 := (p2[sj + 1] - p2[sj]).normalized() * float(r2["o"])
		if d2.dot(travel) > -0.85:
			continue   # not running the other way beside it
		var q := Geometry2D.get_closest_point_to_segment(c, p2[sj], p2[sj + 1])
		var across := (q - c).dot(left)
		if across <= 0.0 or (q - c).length() > across * 1.25 + 2.0:
			continue
		if across < best_across:
			best_across = across
			best = [rj, q, across - hw - float(r2["w"]) * 0.5, left]
	return best

## the pools of light under street and park lamps: built the first time it gets dark (a
## few thousand discs that follow the hills are not worth the wait if it never does)
var _pool_at: Array = []             ## Vector3(x, z, radius)
## A street lamp's pool, and how bright the pools are. Lamps stand every 34 m, the sides
## taking turns, so on a wide main road one side has one every 68 m: at 7.5 m and 0.75 the
## user found the main roads at night too dark between them ("slightly stronger").
## A lamp post from the town's own map (Tel Aviv's 15,000), where it stands: off the asphalt
## onto the pavement if the map's point is on the road (its points and OSM's widths are a
## metre or two apart), out of a wall, its arm out over the nearest road. A plain grey pole,
## a wooden one, the ornate kind, or a lamp on a building's wall; two lamps: an arm each way.
## Where the map has lamps (_lamps_mapped_at) the made-up rows are left out.
const LAMP_COVER := 45.0
func _lamps_mapped_at(p: Vector2) -> bool:
	if _lamp_cover.is_empty():
		return false
	var c := _cell(p, LAMP_COVER)
	for dx in range(-1, 2):
		for dz in range(-1, 2):
			if _lamp_cover.has(c + Vector2i(dx, dz)):
				return true
	return false

## the town's map has its hydrants round p (the made-up ones are left out there)
func hydrants_mapped_at(p: Vector2) -> bool:
	if _hydrant_cover.is_empty():
		return false
	var c := _cell(p, LAMP_COVER)
	for dx in range(-1, 2):
		for dz in range(-1, 2):
			if _hydrant_cover.has(c + Vector2i(dx, dz)):
				return true
	return false

func _mapped_lamp(lm: Array, poles: Array, woods: Array, arms: Array, heads: Array, ornate: Array, lanterns: Array, walls: Array) -> void:
	var p: Vector2 = lm[0]
	var look: String = lm[1]
	var n: int = lm[2]
	var hit := _nearest_seg(p, 25.0, true, true)
	var toward := Vector2.RIGHT
	if not hit.is_empty():
		var q: Vector2 = hit["q"]
		var away := p - q
		if away.length() < 0.05:   # (on the road's middle line: to the right of it)
			var pts: PackedVector2Array = _roads[hit["road"]]["pts"]
			var sj: int = hit["seg"]
			var t := (pts[sj + 1] - pts[sj]).normalized()
			away = Vector2(-t.y, t.x)
		var dist := away.length()
		away /= maxf(dist, 0.001)
		var edge: float = hit["edge"]
		if edge < 0.45 and look != "wall":   # on the asphalt or its kerb: onto the pavement
			p = q + away * (dist - edge + 0.55)
		toward = -away
	if look == "wall":
		p += _push_out(p, 0.35, false, false)
		var gy := _h(p)
		var face := Basis(Vector3.UP, atan2(-toward.y, toward.x))
		var b := p + toward * 0.3
		walls.append(Transform3D(face, Vector3(b.x, gy + 4.6, b.y)))
		var hd := p + toward * 0.65
		heads.append(Transform3D(face, Vector3(hd.x, gy + 4.5, hd.y)))
		_pool_at.append(Vector3(hd.x + toward.x, hd.y + toward.y, LAMP_POOL - 2.5))
		return
	p += _push_out(p, 0.3, false, false)
	if not _off_road(p, 0.2):
		return   # (nowhere off the asphalt near the point: a lamp in the road is worse than none)
	if _post_twin(p, 0.15):
		return   # (one mapped twice, or two moved onto one spot off the asphalt)
	var gy := _h(p)
	if look == "ornate":
		var bs := Basis(Vector3.UP, atan2(-toward.y, toward.x))
		ornate.append(Transform3D(bs, Vector3(p.x, gy, p.y)))
		var lp := p + toward * 1.6
		lanterns.append(Transform3D(Basis(), Vector3(lp.x, gy + 6.85, lp.y)))
		_pool_at.append(Vector3(lp.x + toward.x * 0.5, lp.y + toward.y * 0.5, LAMP_POOL - 0.5))
	else:
		(woods if look == "wood" else poles).append(Transform3D(Basis(), Vector3(p.x, gy + 3.5, p.y)))
		for k in range(n):
			var out := toward if k == 0 else -toward
			var face := Basis(Vector3.UP, atan2(-out.y, out.x))
			var arm := p + out * 0.9
			arms.append(Transform3D(face, Vector3(arm.x, gy + 6.95, arm.y)))
			var head := p + out * 1.75
			heads.append(Transform3D(face, Vector3(head.x, gy + 6.85, head.y)))
			_pool_at.append(Vector3(head.x + out.x * 0.6, head.y + out.y * 0.6, LAMP_POOL))
	_add_post(p, 0.15)

const LAMP_POOL := 8.5
const POOL_STRENGTH := 0.95
var _pools_made := false
var _pools_from := 0                 ## _pool_at before this have theirs
var _shop_lights: Array = []         ## [the window's foot, out to the street, how wide] of every lit shop window
var _shop_lit_from := 0

## The light pools (and halos, and lit shop windows' light on the pavement) for every lamp so
## far. Made a while after the car, a few ms a frame (`chunked`, `_pools_ahead`): made at the
## night button, for every lamp in the city at once, they held the click ~0.4 s here and more
## in a browser. Each square built after that makes its own (`_build_tile`).
var _pools_busy := false
var _pools_abort := false
func _make_pools(chunked := false) -> void:
	if _pools_busy:
		return   # (being made: a square's lamps after those are made next time)
	_pools_busy = true
	_pools_made = true
	if chunked:
		_yield_at = Time.get_ticks_usec() + _build_us
	var pools := CBuf.new(GROUND_CELL)
	var upto := _pool_at.size()
	for i in range(_pools_from, upto):
		if chunked and Time.get_ticks_usec() > _yield_at:
			await _pause()
			if not is_inside_tree() or _pools_abort:
				_pools_abort = false
				return   # (the night button came first and made them all at once)
		var q: Vector3 = _pool_at[i]
		_pool(pools, Vector2(q.x, q.y), q.z)
		# the lamp's halo, at its head (a street lamp's ~7 m up, a park globe's ~3.8 m)
		_halo(pools, _g3(Vector2(q.x, q.y), 3.75 if q.z < 5.0 else 6.9), 0.75 if q.z >= 5.0 else 0.5)
	_pools_from = upto
	# a lit shop window's light on the pavement in front of it
	var shops_upto := _shop_lights.size()
	for i in range(_shop_lit_from, shops_upto):
		var s: Array = _shop_lights[i]
		var at: Vector2 = s[0]
		var n: Vector2 = s[1]
		var w: float = 1.5 * float(s[2])
		var t := Vector2(-n.y, n.x)
		var y := KERB_H + 0.03
		var a0 := _g3(at - t * w, y)
		var a1 := _g3(at + t * w, y)
		var b0 := _g3(at - t * (w + 0.8) + n * 2.6, y)
		var b1 := _g3(at + t * (w + 0.8) + n * 2.6, y)
		var m0 := _g3(at, y)
		pools.tri(m0, a1, b1, Vector3.UP, Color.WHITE, Vector2.ZERO, Vector2(0.35, 0), Vector2(0.6, 0.72))
		pools.tri(m0, b1, b0, Vector3.UP, Color.WHITE, Vector2.ZERO, Vector2(0.6, 0.72), Vector2(-0.6, 0.72))
		pools.tri(m0, b0, a0, Vector3.UP, Color.WHITE, Vector2.ZERO, Vector2(-0.6, 0.72), Vector2(-0.35, 0))
	_shop_lit_from = shops_upto
	for mi: MeshInstance3D in _add_mesh(pools, _glow_mat("lamplight", POOL_STRENGTH), false, LAMP_RANGE):
		mi.visible = _night
		_night_nodes.append(mi)
	_pools_busy = false
	if chunked and (_pool_at.size() > _pools_from or _shop_lights.size() > _shop_lit_from):
		_make_pools()   # (the lamps of squares built meanwhile)

## ---- the bare ground: patches, not one flat colour ------------------------------------------
## Open land drawn in one colour read as empty, a grey plain. A shader breaks it into
## patches of grass, bare earth and darker scrub (two sizes of noise, by world position, so
## it does not swim): nothing more to draw, just a different colour per pixel. The north is
## mostly green; Givatayim's few open lots are mostly dry.
const GROUND_SHADER := """
shader_type spatial;
uniform vec4 base : source_color;
uniform vec4 green : source_color;
uniform vec4 dark : source_color;
uniform float greenness = 0.5;
uniform vec4 rock : source_color;
uniform float textured = 1.0;
// the made-up town's mountains (0: none): limestone in ledges, red soil, dark scrub and the
// shadows of clouds going over, on every steep slope and everything above `mountain_from`
uniform float mountains = 0.0;
uniform float mountain_from = 100000.0;
uniform vec4 scrub : source_color;
uniform vec4 soil : source_color;
uniform sampler2D grass_tex : filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D grass_nrm : filter_linear_mipmap_anisotropic, repeat_enable;
uniform vec3 grass_mean = vec3(0.5);
varying vec3 wpos;
varying float wup;
float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }
float noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
}
void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wup = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz).y;
}
void fragment() {
	float n = noise(wpos.xz / 70.0) * 0.65 + noise(wpos.xz / 15.0) * 0.35;
	float g = smoothstep(0.62 - greenness * 0.45, 0.78 - greenness * 0.4, n);
	vec3 c = mix(base.rgb, green.rgb, g);
	c = mix(c, dark.rgb, smoothstep(0.62, 0.9, noise(wpos.xz / 31.0 + 17.0)) * 0.55);
	// a mountainside steeper than any town street is bare rock, in bands and blotches
	float bare = smoothstep(0.86, 0.74, wup + (noise(wpos.xz / 9.0) - 0.5) * 0.08);
	vec3 stone = rock.rgb * (0.72 + 0.28 * noise(vec2(wpos.y * 0.45, (wpos.x + wpos.z) * 0.03))) * (0.85 + 0.3 * noise(wpos.xz / 6.0));
	c = mix(c, stone, bare);
	float mtn = 0.0;
	if (mountains > 0.5) {
		mtn = max(bare, smoothstep(mountain_from, mountain_from + 30.0, wpos.y + (noise(wpos.xz / 60.0) - 0.5) * 24.0));
		// limestone laid down in beds: a ledge every 5 m or so of height, wavering, its face
		// catching the light and a dark seam under it -- from the town they read as contours
		// (beds 4-12 m thick by where you are, so they break up rather than ruling the slope)
		float thick = mix(4.0, 12.0, noise(wpos.xz / 160.0 + 21.0));
		float bed = fract(wpos.y / thick + (noise(wpos.xz / 34.0) - 0.5) * 1.3 + noise(wpos.xz / 9.0) * 0.12);
		float face = smoothstep(0.0, 0.3, bed) * (1.0 - 0.5 * smoothstep(0.55, 1.0, bed));
		vec3 m = rock.rgb * 0.7 * (0.75 + 0.35 * noise(wpos.xz / 13.0 + 3.0)) * mix(0.45, 1.05, face);
		// red soil in hollows, and dark scrub and pine in the folds and low down, thinning
		// toward the crests
		m = mix(m, soil.rgb * (0.8 + 0.35 * noise(wpos.xz / 6.0)), smoothstep(0.56, 0.72, noise(wpos.xz / 26.0 + 40.0)) * 0.7);
		float fold = noise(wpos.xz / 46.0 + 11.0) * 0.65 + noise(wpos.xz / 12.0 + 5.0) * 0.35;
		float scrubby = smoothstep(0.46, 0.6, fold + (wup - 0.7) * 0.5 - max(wpos.y - mountain_from, 0.0) / 600.0);
		m = mix(m, scrub.rgb * (0.65 + 0.6 * noise(wpos.xz / 3.5)), scrubby);
		// a sprinkle of bushes over the bare rock too, darker dots that thin out with height
		float dots = step(0.64 + max(wpos.y - mountain_from, 0.0) / 900.0, noise(wpos.xz / 2.2 + 9.0));
		m = mix(m, scrub.rgb * 0.8, dots * (1.0 - scrubby) * 0.8);
		// clouds' shadows drifting over
		float cl = noise(wpos.xz / 190.0 + vec2(TIME * 0.011, TIME * 0.004)) * 0.7 + noise(wpos.xz / 75.0 + vec2(TIME * 0.019, 0.3)) * 0.3;
		m *= 1.0 - 0.4 * smoothstep(0.56, 0.7, cl);
		c = mix(c, m, mtn);
	}
	c *= 0.94 + 0.06 * noise(wpos.xz / 2.5);
	if (textured > 0.5) {   // the lawn photo (see TONE_SHADER), over earth and grass alike
		// Its 2 m repeat lines up into a grid further off, so it fades out with distance (the
		// noise above, which never repeats, carries the far ground), and a second copy 7.3 m
		// across, turned, breaks up the repeat nearer in.
		float kd = 1.0 - smoothstep(25.0, 110.0, length(VERTEX));
		vec2 uv = wpos.xz * 0.5;
		vec3 t = texture(grass_tex, uv).rgb;
		vec3 t2 = texture(grass_tex, vec2(wpos.z, -wpos.x) * 0.137 + vec2(0.31, 0.77)).rgb;
		float lawn = (1.0 - bare * 0.6) * (1.0 - mtn * 0.75);   // less of the lawn photo on bare rock
		// the lawn's colours only where it is grass: bare earth (and rock) takes just its light
		// and dark -- its greens and yellows on grey earth came out as speckles of colour
		vec3 lw = vec3(0.2126, 0.7152, 0.0722);
		float gg = g * (1.0 - bare);
		vec3 d1 = mix(vec3(dot(t, lw) / dot(grass_mean, lw)), t / grass_mean, gg);
		vec3 d2 = mix(vec3(dot(t2, lw) / dot(grass_mean, lw)), t2 / grass_mean, gg);
		c *= mix(vec3(1.0), clamp(d1, vec3(0.0), vec3(2.6)), 0.85 * kd * lawn);
		c *= mix(vec3(1.0), clamp(d2, vec3(0.0), vec3(2.6)), 0.3 * lawn * (1.0 - smoothstep(60.0, 260.0, length(VERTEX))));
		vec2 xy = (texture(grass_nrm, uv).rg * 2.0 - 1.0) * 0.8 * kd;
		vec3 b = vec3(xy, sqrt(max(0.0, 1.0 - dot(xy, xy))));
		vec3 tx = (VIEW_MATRIX * vec4(1.0, 0.0, 0.0, 0.0)).xyz;
		tx = normalize(tx - NORMAL * dot(NORMAL, tx));
		NORMAL = normalize(tx * b.x + cross(NORMAL, tx) * b.y + NORMAL * b.z);
	}
	ALBEDO = c * far_shade(wpos, length(VERTEX)) * mix(1.0, 0.82, wet * step(0.7, wup));   // (wet earth, darker)
	ROUGHNESS = mix(0.95, 0.75, wet);
}
"""
var _ground_shader_mat: ShaderMaterial

func _ground_mat() -> ShaderMaterial:
	if _ground_shader_mat == null:
		_ground_shader_mat = ShaderMaterial.new()
		var sh := Shader.new()
		sh.code = _with_far(GROUND_SHADER)
		_ground_shader_mat.shader = sh
		_far(_ground_shader_mat)
		_ground_shader_mat.set_shader_parameter("grass_tex", _tex("leafy_grass_diff"))
		_ground_shader_mat.set_shader_parameter("grass_nrm", _tex("leafy_grass_nor"))
		_ground_shader_mat.set_shader_parameter("grass_mean", TEX_MEAN["leafy_grass"])
		_ground_shader_mat.set_shader_parameter("textured", 1.0 if _quality > 0 else 0.0)
		_retint_ground()
	return _ground_shader_mat

func _retint_ground() -> void:
	if _ground_shader_mat == null:
		return
	var north := String(_place.get("look", "")) == "north"
	var base: Color = _tone["ground"]
	var green: Color = _tone["grass"]
	_ground_shader_mat.set_shader_parameter("base", base)
	_ground_shader_mat.set_shader_parameter("green", green.lerp(base, 0.25))
	_ground_shader_mat.set_shader_parameter("dark", green.lerp(Palette.col("bg"), 0.45))
	_ground_shader_mat.set_shader_parameter("greenness", 0.8 if north else 0.3)
	_ground_shader_mat.set_shader_parameter("rock", _tone["rock"])
	# the made-up town's mountains (see GROUND_SHADER): dark olive scrub, red-brown soil
	_ground_shader_mat.set_shader_parameter("mountains", 1.0 if _made_up and _hnx > 0 else 0.0)
	_ground_shader_mat.set_shader_parameter("mountain_from", _mtn_from)
	var veg := Palette.col("friend").lerp(Palette.col("warn"), 0.35)
	_ground_shader_mat.set_shader_parameter("scrub", _natural(veg.lerp(Palette.col("bg"), 0.66), 0.5))
	# (the palette's warn, its yellow, darkened and a touch of its hazard: an earth brown -- its
	# hazard alone is pink in most palettes)
	_ground_shader_mat.set_shader_parameter("soil", _natural(Palette.col("warn").lerp(Palette.col("hazard"), 0.25).lerp(Palette.col("bg"), 0.55), 0.4))

## the same noise in script, for clumping what grows on open land where the green is
func _vnoise(p: Vector2) -> float:
	var i := p.floor()
	var f := p - i
	var u := f * f * (Vector2(3, 3) - 2.0 * f)
	var a := _hash01(i)
	var b := _hash01(i + Vector2(1, 0))
	var c := _hash01(i + Vector2(0, 1))
	var d := _hash01(i + Vector2(1, 1))
	return lerpf(lerpf(a, b, u.x), lerpf(c, d, u.x), u.y)

func _hash01(p: Vector2) -> float:
	return fposmod(sin(p.dot(Vector2(12.9898, 78.233))) * 43758.5453, 1.0)

## ---- parks and pitches ----------------------------------------------------------------------
## Along the paths through a park: benches facing the path, low park lamps (lit at night,
## with their pools). In a big enough park, a playground: a slide tower, swings and a
## sandpit on a soft floor. On a sports pitch: its lines, and goals or basketball hoops.

var _parks: Array = []               ## [outline, box] of the parks and lawns big enough for benches
var _park_hash := {}

func _parks_setup() -> void:
	for kind: String in ["park", "grass"]:
		for ring: PackedVector2Array in _area_rings.get(kind, []):
			if _area(ring) >= 400.0:
				_hash_add(_park_hash, _bld_box_of(ring), 60.0, _parks.size())
				_parks.append([ring, _bld_box_of(ring)])

func _build_parks() -> void:
	var parks := _parks
	var park_hash := _park_hash
	var benches: Array = []
	var posts: Array = []
	var globes: Array = []
	for ri: int in _tile_roads.get(_tile, []):
		var r: Dictionary = _roads[ri]
		if r["drive"]:
			continue
		if _over():
			await _pause()
		var flip := posmod(ri, 2) == 0
		var pts: PackedVector2Array = r["pts"]
		var hw: float = float(r["w"]) * 0.5
		var s_bench := 6.0
		var s_lamp := 12.0
		for j in range(pts.size() - 1):
			var a := pts[j]
			var b := pts[j + 1]
			var L := a.distance_to(b)
			if L < 0.5:
				continue
			var d := (b - a) / L
			var side := Vector2(-d.y, d.x)
			var mid := (a + b) * 0.5
			var inside := false
			for pi: int in _near(park_hash, mid, 1.0, 60.0):
				var pk: Array = parks[pi]
				if (pk[1] as Rect2).grow(2.0).has_point(mid) and Geometry2D.is_point_in_polygon(mid, pk[0]):
					inside = true
					break
			if not inside:
				s_bench -= L
				s_lamp -= L
				continue
			while s_bench < L:
				flip = not flip
				var out := side * (1.0 if flip else -1.0)
				var q := a + d * s_bench + out * (hw + 0.75)
				if _mine(q) and _push_out(q, 0.9, true) == Vector2.ZERO and _off_road(q, 1.0):
					benches.append(Transform3D(Basis(Vector3.UP, atan2(-out.x, -out.y)), _g3(q, 0.0)))
					_bench_spots.append([q, -out])   # (where someone sits: _place_sitters)
					_add_post(q, 0.5)
				s_bench += 19.0
			s_bench -= L
			while s_lamp < L:
				var q := a + d * s_lamp - side * (hw + 0.6) * (1.0 if flip else -1.0)
				if _mine(q) and _push_out(q, 0.5, true) == Vector2.ZERO and _off_road(q, 1.0):
					var gy := _h(q)
					posts.append(Transform3D(Basis(), Vector3(q.x, gy + 1.8, q.y)))
					globes.append(Transform3D(Basis(), Vector3(q.x, gy + 3.75, q.y)))
					_pool_at.append(Vector3(q.x, q.y, 4.5))
					_add_post(q, 0.1)
				s_lamp += 27.0
			s_lamp -= L
	var bench := _cached("bench", func() -> Mesh:
		# the bench made with Blender (tools/blender/recipes/bench.py: slats, iron ends, arms);
		# the boxes below if its file is missing
		var made: ArrayMesh = _models.mesh("bench") if _models != null else null
		if made != null:
			made.surface_set_material(0, _surface("furniture"))
			return made
		var bench_buf := Buf.new()
		_box(bench_buf, Vector3(0, 0.44, 0), Vector3(1.7, 0.07, 0.46))
		_box(bench_buf, Vector3(0, 0.74, -0.22), Vector3(1.7, 0.36, 0.06))
		for sx: float in [-0.72, 0.72]:
			_box(bench_buf, Vector3(sx, 0.22, 0), Vector3(0.07, 0.44, 0.42))
		var am := ArrayMesh.new()
		am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, bench_buf.arrays())
		am.surface_set_material(0, _surface("furniture"))
		return am)
	_chunked(bench, benches, 160.0, [], null, true)
	var post := CylinderMesh.new()
	post.top_radius = 0.045
	post.bottom_radius = 0.06
	post.height = 3.6
	post.radial_segments = 6
	post.rings = 1
	post.material = _surface("pole")
	var globe := SphereMesh.new()
	globe.radius = 0.22
	globe.height = 0.44
	globe.radial_segments = 8
	globe.rings = 4
	globe.material = _surface("lamp")
	_chunked(post, posts, LAMP_RANGE)
	_chunked(globe, globes, LAMP_RANGE)
	# playgrounds, in the bigger parks
	var play := {"friend": CBuf.new(CHUNK), "warn": CBuf.new(CHUNK), "accent": CBuf.new(CHUNK),
		"player": CBuf.new(CHUNK), "pole": CBuf.new(CHUNK), "soft": CBuf.new(CHUNK), "sand": CBuf.new(CHUNK)}
	var made := 0
	for ring: PackedVector2Array in _rings_near("park") + _rings_near("grass"):
		if _area(ring) < 1500.0 or not _ring_mine(ring):
			continue
		var spot := _clear_spot(ring, 7.0)
		if not spot.is_finite():
			continue
		_playground(play, spot, float(posmod(_hash_i(spot), 360)) * PI / 180.0)
		_landmarks.append([spot, "playground"])
		made += 1
	var mats := {"friend": mat("friend", 0.12), "warn": mat("warn", 0.12), "accent": mat("accent", 0.12),
		"player": mat("player", 0.12), "pole": _surface("pole"), "soft": _surface("rubber"), "sand": _surface("sand")}
	for k: String in play:
		_add_mesh(play[k], mats[k], k != "soft" and k != "sand", 260.0)
	# pitches: lines, and goals or hoops
	var lines := CBuf.new(GROUND_CELL)
	var frames := CBuf.new(CHUNK)
	var pitches := 0
	for ring: PackedVector2Array in _rings_near("pitch"):
		if _ring_mine(ring):
			_sports_pitch(ring, lines, frames)
			pitches += 1
	_add_mesh(lines, _surface("mark"), false, DETAIL_RANGE)
	_add_mesh(frames, _surface("mark"), true, 260.0)
	_tally("benches", benches.size())
	_tally("playgrounds", made)
	_tally("pitches", pitches)

## a point inside `ring` with nothing solid or a path within `r` of it, nearest its middle
func _clear_spot(ring: PackedVector2Array, r: float) -> Vector2:
	var c := Vector2.ZERO
	for p in ring:
		c += p
	c /= ring.size()
	var box := _bld_box_of(ring)
	var best := Vector2.INF
	var bd := INF
	for i in range(40):
		var q := c if i == 0 else Vector2(lerpf(box.position.x, box.end.x, fposmod(i * 0.618, 1.0)),
			lerpf(box.position.y, box.end.y, fposmod(i * 0.382 + 0.17, 1.0)))
		if not Geometry2D.is_point_in_polygon(q, ring):
			continue
		var ok := true
		for k in range(8):
			var e := q + Vector2(cos(k * TAU / 8.0), sin(k * TAU / 8.0)) * r
			if not Geometry2D.is_point_in_polygon(e, ring):
				ok = false
				break
		if not ok or _push_out(q, r, true) != Vector2.ZERO:
			continue
		var hit := _nearest_seg(q, r + 3.0, false)
		if not hit.is_empty() and float(hit["edge"]) < r:
			continue
		if q.distance_to(c) < bd:
			bd = q.distance_to(c)
			best = q
	return best

## a box turned by `yaw` about its own middle, into a Buf
func _obox(buf: Buf, c: Vector3, size: Vector3, yaw: float, tilt := 0.0) -> void:
	var basis := Basis(Vector3.UP, yaw) * Basis(Vector3.RIGHT, tilt)
	var h := size * 0.5
	for ax in range(3):
		for sg: float in [-1.0, 1.0]:
			var n := Vector3.ZERO
			n[ax] = sg
			var u := Vector3.ZERO
			u[(ax + 1) % 3] = h[(ax + 1) % 3]
			var w := Vector3.ZERO
			w[(ax + 2) % 3] = h[(ax + 2) % 3]
			var f := n * h[ax]
			var pts: Array = []
			for q: Vector3 in [f - u - w, f + u - w, f + u + w, f - u + w]:
				pts.append(c + basis * q)
			_poly(buf, pts, basis * n)

## a park's playground on a round soft floor: the slide, the swing set, a climbing dome, a
## see-saw and a picnic table (made with Blender: tools/blender/recipes/, stamped by models.gd into the palette's
## buffers, so a new look recolours them) and a sandpit. Laid out round `at`, `yaw` turning it.
const PLAY_ROLES := {"paint": "warn", "paint2": "player", "paint3": "accent", "plastic": "friend",
	"wood": "friend", "metal": "pole", "rubber": "pole", "dark": "pole", "*": "pole"}
func _playground(b: Dictionary, at: Vector2, yaw: float) -> void:
	var gy := _h(at)
	var fwd := Vector2(sin(yaw), cos(yaw))
	var side := Vector2(fwd.y, -fwd.x)
	var P := func(q: Vector2, y: float) -> Vector3: return Vector3(q.x, gy + y, q.y)
	var floor_buf: Buf = b["soft"]
	var seg := 16
	for i in range(seg):
		var a0 := TAU * i / seg
		var a1 := TAU * (i + 1) / seg
		floor_buf.tri(P.call(at, 0.04), P.call(at + Vector2(cos(a0), sin(a0)) * 7.0, 0.04),
			P.call(at + Vector2(cos(a1), sin(a1)) * 7.0, 0.04), Vector3.UP, Color.WHITE)
	# each model's +X along `along`, its middle at q (the models' own frame: +X ahead, up)
	var put := func(name: String, q: Vector2, along: Vector2) -> void:
		var bs := Basis(Vector3(along.x, 0, along.y), Vector3.UP, Vector3(-along.y, 0, along.x))
		_models.stamp_into(b, PLAY_ROLES, name, Transform3D(bs, P.call(q, 0.04)))
	put.call("slide", at - side * 3.0 - fwd * 0.4, fwd)        # (down the chute along fwd)
	_add_post(at - side * 3.0 - fwd * 1.6, 0.7)
	put.call("swings", at + side * 3.2, side)                   # (the bar along fwd, swinging across)
	_add_post(at + side * 3.2 + fwd * 1.7, 0.2)
	_add_post(at + side * 3.2 - fwd * 1.7, 0.2)
	put.call("climber", at + fwd * 4.2 - side * 1.2, fwd)
	_add_post(at + fwd * 4.2 - side * 1.2, 1.9)
	put.call("seesaw", at + fwd * 4.6 + side * 3.0, side)
	put.call("picnic", at - fwd * 3.6 + side * 3.7, fwd)   # (a picnic table by the sandpit, for the grown-ups)
	_add_post(at - fwd * 3.6 + side * 3.7, 0.9)
	# the sandpit
	var sp := at + fwd * -3.4
	for e: float in [-1.5, 1.5]:
		_obox(b["friend"], P.call(sp + fwd * e, 0.15), Vector3(3.2, 0.3, 0.15), yaw)
		_obox(b["friend"], P.call(sp + side * e, 0.15), Vector3(3.2, 0.3, 0.15), yaw + PI * 0.5)
	_obox(b["sand"], P.call(sp, 0.08), Vector3(2.9, 0.12, 2.9), yaw)

## a pitch: the tightest rectangle round it, its lines (inset a metre), and a goal at each
## end (a basketball hoop on a small court)
func _sports_pitch(ring: PackedVector2Array, lines: Buf, frames: Buf) -> void:
	var best := INF
	var u := Vector2.RIGHT
	var lo := Vector2.ZERO
	var hi := Vector2.ZERO
	for i in range(ring.size()):
		var e := (ring[(i + 1) % ring.size()] - ring[i]).normalized()
		if e == Vector2.ZERO:
			continue
		var v := Vector2(-e.y, e.x)
		var mn := Vector2(INF, INF)
		var mx := Vector2(-INF, -INF)
		for p in ring:
			var q := Vector2(p.dot(e), p.dot(v))
			mn = mn.min(q)
			mx = mx.max(q)
		if (mx.x - mn.x) * (mx.y - mn.y) < best:
			best = (mx.x - mn.x) * (mx.y - mn.y)
			u = e
			lo = mn
			hi = mx
	var v := Vector2(-u.y, u.x)
	if hi.y - lo.y > hi.x - lo.x:   # u along the long side
		var t := u
		u = v
		v = -t
		var l2 := Vector2(-hi.y, lo.x)
		var h2 := Vector2(-lo.y, hi.x)
		lo = l2
		hi = h2
	var L := hi.x - lo.x
	var W := hi.y - lo.y
	if L < 12.0 or W < 7.0 or best > 12000.0:
		return
	_landmarks.append([u * (lo.x + hi.x) * 0.5 + v * (lo.y + hi.y) * 0.5, "pitch"])
	var at := func(a: float, b: float) -> Vector2: return u * a + v * b
	var strip := func(p0: Vector2, p1: Vector2) -> void:
		var d := (p1 - p0).normalized()
		var n := Vector2(-d.y, d.x) * 0.06
		lines.quad3(_g3(p0 - n, 0.05), _g3(p1 - n, 0.05), _g3(p1 + n, 0.05), _g3(p0 + n, 0.05))
	var x0 := lo.x + 1.0
	var x1 := hi.x - 1.0
	var y0 := lo.y + 1.0
	var y1 := hi.y - 1.0
	var cx := (x0 + x1) * 0.5
	var cy := (y0 + y1) * 0.5
	for e: Array in [[x0, y0, x1, y0], [x1, y0, x1, y1], [x1, y1, x0, y1], [x0, y1, x0, y0], [cx, y0, cx, y1]]:
		strip.call(at.call(e[0], e[1]), at.call(e[2], e[3]))
	var cr := minf(3.0, (y1 - y0) * 0.16)
	for i in range(16):
		var a0 := TAU * i / 16.0
		var a1 := TAU * (i + 1) / 16.0
		strip.call(at.call(cx + cos(a0) * cr, cy + sin(a0) * cr), at.call(cx + cos(a1) * cr, cy + sin(a1) * cr))
	var yaw := atan2(u.x, u.y)
	for end: Array in [[x0, 1.0], [x1, -1.0]]:
		var g: Vector2 = at.call(end[0], cy)
		var gy := _h(g)
		if L >= 34.0:   # football: two posts and a bar
			var gw := minf(5.0, (y1 - y0) * 0.3)
			for sd: float in [-0.5, 0.5]:
				var q := g + v * gw * sd
				_obox(frames, Vector3(q.x, gy + 1.1, q.y), Vector3(0.1, 2.2, 0.1), yaw)
			_obox(frames, Vector3(g.x, gy + 2.2, g.y), Vector3(gw + 0.1, 0.1, 0.1), yaw)
		else:   # a hoop: a pole off the end line and a backboard over it
			var q := g - u * 0.6 * float(end[1])
			_obox(frames, Vector3(q.x, gy + 1.6, q.y), Vector3(0.12, 3.2, 0.12), yaw)
			var bb := g + u * 0.3 * float(end[1])
			_obox(frames, Vector3(bb.x, gy + 3.35, bb.y), Vector3(1.6, 1.0, 0.06), yaw)

## ---- night ---------------------------------------------------------------------------------
## The same city after dark: the sun down to a dim blue moon (and no shadows, which also
## makes the night cheaper to draw), a share of the windows lit, the street lamps on with a
## pool of light under each, shop windows bright, headlights and their beams on the road.
## Light that is drawn, not computed: real lights in this renderer redraw everything they
## touch, which a browser cannot afford by the hundred.

var _night := false
var _night_nodes: Array = []          ## shown only at night: light pools, headlight beams

## UV2.y 1: a halo round a light instead -- every vertex of its quad at the light, UV its
## corner (-1..1), COLOR.r its size: turned to face the eye here, at least a few pixels across
## however far, in front of the lamp's own head. It stands in for a glow effect (a bloom over
## the whole frame), which costs a laptop's browser a millisecond or two every frame: these
## are drawn with the pools and the beams, no draws of their own. Not fogged (the night's haze
## added to them turned far pools into cyan blobs); far pools fade out by themselves.
const GLOW_SHADER := """
shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled, skip_vertex_transform;
uniform vec4 col : source_color;
uniform float strength = 0.5;
varying float halo;
varying float fade;
void vertex() {
	halo = UV2.y;
	if (UV2.y > 0.5) {
		vec3 c = (MODELVIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
		float d = max(-c.z, 0.1);
		float s = max(COLOR.r * 1.2, d * 0.009);
		c += normalize(-c) * min(0.7, d * 0.4);
		VERTEX = c + vec3(UV, 0.0) * s;
		fade = 1.0 - smoothstep(450.0, 700.0, d);
	} else {
		VERTEX = (MODELVIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
		fade = 1.0 - smoothstep(220.0, 330.0, length(VERTEX));
	}
}
void fragment() {
	if (halo > 0.5) {   // a bright core and a soft halo round it
		float t = clamp(1.0 - length(UV), 0.0, 1.0);
		ALBEDO = col.rgb * (t * t * 0.3 + pow(t, 12.0) * 1.6) * fade;
	} else {
		// UV: 0 at the light, 1 at the rim (pools); beams fade along their length and to the sides
		float k = UV2.x > 0.5 ? (1.0 - UV.y) * (1.0 - UV.y) * (1.0 - UV.x * UV.x) : clamp(1.0 - length(UV), 0.0, 1.0);
		ALBEDO = col.rgb * k * k * strength * fade;
	}
}
"""
var _glow_mats := {}

var _glow_sh: Shader
func _glow_mat(tone: String, strength: float) -> ShaderMaterial:
	var key := "%s|%.2f" % [tone, strength]
	if _glow_mats.has(key):
		return _glow_mats[key]
	var m := ShaderMaterial.new()
	if _glow_sh == null:   # (one Shader for them all: each its own compiled its own programs, the same code)
		_glow_sh = Shader.new()
		_glow_sh.code = GLOW_SHADER
	m.shader = _glow_sh
	m.set_shader_parameter("col", _tone[tone])
	m.set_shader_parameter("strength", strength)
	m.set_meta("tone", tone)
	_glow_mats[key] = m
	return m

## a disc of light on the ground round p, following the hills: a ring at half the radius
## and one at the rim, each point's height worked out once
func _pool(buf: Buf, p: Vector2, r: float) -> void:
	var seg := 12
	var y := KERB_H + 0.03   # (over the pavement too: at 0.09 it lay under it, lit only the road)
	var mid := _g3(p, y)
	var inner: Array = []
	var outer: Array = []
	var dirs: Array = []
	for i in range(seg):
		var e := Vector2(cos(TAU * i / seg), sin(TAU * i / seg))
		dirs.append(e)
		inner.append(_g3(p + e * r * 0.55, y))
		outer.append(_g3(p + e * r, y))
	for i in range(seg):
		var j := (i + 1) % seg
		var e0: Vector2 = dirs[i]
		var e1: Vector2 = dirs[j]
		buf.tri(mid, inner[i], inner[j], Vector3.UP, Color.WHITE, Vector2.ZERO, e0 * 0.55, e1 * 0.55)
		buf.tri(inner[i], outer[i], outer[j], Vector3.UP, Color.WHITE, e0 * 0.55, e0, e1)
		buf.tri(inner[i], outer[j], inner[j], Vector3.UP, Color.WHITE, e0 * 0.55, e1, e1 * 0.55)

## a halo (see GLOW_SHADER) round a light at `at`, `size` metres across near to
func _halo(b: Buf, at: Vector3, size: float) -> void:
	var col := Color(size, 0, 0)
	var u2 := Vector2(0, 1)
	b.tri(at, at, at, Vector3.BACK, col, Vector2(-1, -1), Vector2(1, -1), Vector2(1, 1), u2)
	b.tri(at, at, at, Vector3.BACK, col, Vector2(-1, -1), Vector2(1, 1), Vector2(-1, 1), u2)

## a headlight beam on the road, local to a car facing +Z: from the bumper, 26 m out and
## widening (UV.x across, UV.y along; UV2.x = 1 marks it as a beam for the shader); and a halo
## round each headlight (the player's car and the traffic's share this mesh)
func _beam_mesh() -> ArrayMesh:
	var b := Buf.new()
	for sx: float in [-0.68, 0.68]:
		_halo(b, Vector3(sx, 0.68, 2.2), 0.32)
	var near := 2.3
	var far := 28.0
	var steps := 6
	for i in range(steps):
		var t0 := float(i) / steps
		var t1 := float(i + 1) / steps
		var z0 := lerpf(near, far, t0)
		var z1 := lerpf(near, far, t1)
		var w0 := lerpf(0.9, 5.5, t0)
		var w1 := lerpf(0.9, 5.5, t1)
		var u2 := Vector2(1, 0)
		b.tri(Vector3(-w0, 0.07, z0), Vector3(w0, 0.07, z0), Vector3(w1, 0.07, z1), Vector3.UP, Color.WHITE,
			Vector2(-1, t0), Vector2(1, t0), Vector2(1, t1), u2)
		b.tri(Vector3(-w0, 0.07, z0), Vector3(w1, 0.07, z1), Vector3(-w1, 0.07, z1), Vector3.UP, Color.WHITE,
			Vector2(-1, t0), Vector2(1, t1), Vector2(-1, t1), u2)
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, b.arrays())
	return am

## After rain, or dry (the "wet" button): faded in and out over a second and a half
var _wet := false
var _wet_k := 0.0                     ## how wet, 0..1 (the shaders' `wet`)
var _wet_tween: Tween

func _set_wet(on: bool) -> void:
	_wet = on
	if _wet_tween != null:
		_wet_tween.kill()
	_wet_tween = create_tween()
	_wet_tween.tween_method(func(k: float) -> void:
		_wet_k = k
		_far_update(), _wet_k, 1.0 if on else 0.0, 1.5)
	_show_banner("after rain" if on else "dry", 1.2)
	Probe.event("wet", {"on": on})

## the time-of-day button: day, then evening, then night, then day again
func _next_time() -> void:
	var t0 := Time.get_ticks_usec()
	var gl0 := _gl_count()
	var to := "day" if _night else ("night" if _evening else "evening")
	if _night:
		_set_night(false)
	elif _evening:
		await _set_evening(false)
		_set_night(true)
	else:
		await _set_evening(true)
	_tod_watch(to, gl0, (Time.get_ticks_usec() - t0) / 1000.0)

## what a time-of-day click cost: its own work, then the slowest of the next frames (where the
## browser compiles what the new light needs) and the shaders compiled -- printed, and in the
## perf view, so a player's screenshot says it
var _tod_line := ""
func _tod_watch(to: String, gl0: Vector2, ms: float) -> void:
	var worst := 0.0
	for i in range(10):
		var tf := Time.get_ticks_usec()
		await get_tree().process_frame
		if not is_inside_tree():
			return
		worst = maxf(worst, (Time.get_ticks_usec() - tf) / 1000.0)
	_tod_line = "to %s: %.0f ms at the click, then the slowest frame %d ms" % [to, ms, int(worst)]
	if gl0.x >= 0.0:
		var d := _gl_count() - gl0
		_tod_line += ", %d shaders compiled (%.1f s)" % [int(d.x), d.y / 1000.0]
	print("[streets] time of day " + _tod_line)

## Golden hour: the evening sky, the sun low in the west-south-west and warm, the long
## shadows (the real ones; the painted far ones redrawn for that sun once, then kept).
func _set_evening(on: bool) -> void:
	if on == _evening:
		return
	_evening = on
	sun.rotation_degrees = _sky_now()["sun"]
	_retint_city()
	var key := "evening" if on else "day"
	if _fs_cache.has(key):
		_fs_tex = _fs_cache[key][0]
		_fs_rect = _fs_cache[key][1]
		_far_update()
	else:
		# (none rather than the other sun's while it draws -- a few ms a frame, a moment after
		# the click, not all at once: drawn whole it held the click a second and more)
		_fs_tex = null
		_far_update()
		if not _fs_drawing.has(key):
			_far_draw(key)
	_show_banner("evening" if on else "day", 1.2)
	Probe.event("evening", {"on": on})

func _set_night(on: bool) -> void:
	_night = on
	if on and (not _pools_made or _pools_busy):
		# not made ahead yet (the first ~40 s), or being made: all at once now, as before
		if _pools_busy:
			_pools_abort = true
			_pools_busy = false
		_make_pools()
	for n: Node3D in _night_nodes:
		n.visible = on
	_lights_on = on   # headlights on with the dark (the lights button still switches them)
	if _beam_node != null:
		_beam_node.visible = _lights_on
	_retint_city()
	# The moon is the day's sun as it is -- there, with its shadows, lighting everything --
	# only dim and blue (_retint_city), its shadows reaching a metre (_set_quality: the shadow
	# pass draws next to nothing). In a browser every material's shader comes in one version
	# for a sun with shadows, another for one without and another for no light (or a light that
	# lights nothing, `light_cull_mask` 0: tried): switching the shadows off at the button made
	# the browser compile 40-odd programs there and then, a hang of seconds on a user's PC
	# (21 Nov; tests/web_shaders.js TIMES=, BOT=idle).
	_set_quality(_quality)
	if _traffic != null:
		_traffic.set_night(on)
	if _furn != null:
		_furn.set_night(on)
	if _rails != null:
		_rails.set_night(on)
	if _marks != null:
		_marks.set_night(on)
	if _car_shader_mat != null:
		_car_material()
	_far_update()
	_show_banner("night" if on else "day", 1.2)
	Probe.event("night", {"on": on})

## Parked cars down Givatayim's streets, half up on the pavement the way they really
## park there: one sedan mesh shared by all of them, each in its own colour. How full the
## kerb is goes by its paint (_kerb_paint): a filmed residential street with blue-white
## kerbs was an unbroken row both sides; red-white stretches (the corners, bus stops, many
## main roads) stay all but empty.
const PARKED_FILL := [0.55, 0.05, 0.72, 0.0]   ## share of the kerb taken: plain, red-white, blue-white, yellow-black
const PARKED_FILL_LIVING := 0.3
const PARKED_MOTO := 0.3             ## a gap between the parked cars that has a motorbike or scooter in it
## A divided road's halves park on their outer side only: the left of each half is the median
## (its other half runs beside it, closer than this from edge to edge), and parked both sides
## a row of cars stood down the middle of the road -- Tel Aviv's Katznelson, "a lot of parked
## cars in the middle of somewhat main roads" (tests/parked_median.gd).
const PARKED_MEDIAN_GAP := 12.0

## A motorbike or scooter parked up on the pavement in a gap between the cars, as they stand
## all along a filmed residential street in Givatayim: on the front half of the pavement (the
## back half is where people walk), along the kerb or at a slant to it, leaning on its stand.
func _park_moto(r: Dictionary, ri: int, run: PackedVector2Array, cum: PackedFloat32Array, s: float, total: float,
		hw: float, sgn: float, rng: RandomNumberGenerator, palette: Array, xf_by: Dictionary, cols_by: Dictionary) -> void:
	var slant := rng.randf_range(-0.7, 0.7) if rng.randf() < 0.4 else rng.randf_range(-0.12, 0.12)
	var colour: Color = palette[rng.randi() % palette.size()]
	var c := _along(run, cum, s + rng.randf_range(-1.5, 1.5))
	var d := (_along(run, cum, minf(s + 1.0, total)) - c).normalized()
	var side := Vector2(-d.y, d.x) * sgn
	var p := c + side * (hw + KERB_W + 0.75)
	var face := (d * sgn).rotated(slant)
	if not _mine(p) or _no_parking(r, ri, p) or _push_out(p, 0.6, false) != Vector2.ZERO or not _clear_of_posts(p, 1.0):
		return
	# (and its middle by the solid circle it gets below: the ends alone let the circle stand
	# half a metre into the next street's lane at a corner -- city_check, Ashdod's Ort)
	if not (_off_road(p + face * 0.95, 0.05) and _off_road(p - face * 0.95, 0.05) and _off_road(p, 0.6)):
		return
	var bs := Basis(Vector3.UP, atan2(face.x, face.y)) * Basis(Vector3.BACK, 0.13 * (1.0 if rng.randf() < 0.5 else -1.0))
	(xf_by["moto_parked"] as Array).append(Transform3D(bs, Vector3(p.x, _walk_y(p), p.y)))   # on the pavement, as people stand
	(cols_by["moto_parked"] as Array).append(colour)
	_add_post(p, 0.55)
	_moto_at.append(p)
	_tally("parked_moto", 1)

## no parking at p beside road ri: its red-white corner or a bus stop's yellow-black
func _no_parking(r: Dictionary, ri: int, p: Vector2) -> bool:
	var pts: PackedVector2Array = r["pts"]
	var ids: PackedInt32Array = r["ids"]
	var best := INF
	var dir := Vector2.ZERO   # the road's way beside p: a car parks along it
	for j in range(pts.size() - 1):
		var q := Geometry2D.get_closest_point_to_segment(p, pts[j], pts[j + 1])
		if q.distance_squared_to(p) < best:
			best = q.distance_squared_to(p)
			dir = (pts[j + 1] - pts[j]).normalized()
	var across := Vector2(-dir.y, dir.x)
	var half := CAR_LEN * 0.5
	# a bus stop: none within BUS_CLEAR of it along its own kerb, on any street (the law's 12 m
	# either side of the sign; held to, as a user says -- 11 m round its spot, on some kinds of
	# street only, left cars "inside bus stations", in the bus's way). The far side parks on.
	for c: Vector2 in _kerb_stops(ri):
		if absf((p - c).dot(dir)) < BUS_CLEAR + half and absf((p - c).dot(across)) < 4.0:
			return true
	# a zebra: no car over its stripes (about 2 m either side of its line), nor within a metre
	# of them -- city_check's "parked on a zebra" found 19 in three towns, on any street
	for z: Array in _zebras_near(p):
		var along: Vector2 = z[1]
		if absf((p - (z[0] as Vector2)).dot(along)) < 3.0 + half * absf(dir.dot(along)) + 0.9 * absf(across.dot(along)) \
				and absf((p - (z[0] as Vector2)).dot(Vector2(-along.y, along.x))) < float(z[2]) + 2.5:
			return true
	# a junction: neither end of the car in its disc -- a driveway's or a lane's too, and one on
	# a road passing close by, not only this street's ("parked in a junction", city_check: 3
	# in Givatayim)
	var seen := {}
	for code: int in _near(_seg_hash, p, 12.0, SEG_CELL):
		var rj := code / 4096
		if seen.has(rj):
			continue
		seen[rj] = true
		var rp: PackedVector2Array = (_roads[rj] as Dictionary)["pts"]
		var rids: PackedInt32Array = (_roads[rj] as Dictionary)["ids"]
		for i in range(rids.size()):
			var n := rids[i]
			if rp[i].distance_to(p) < _node_r[n] + half + 1.0 and _node_ways(n) >= 3 \
					and ((p + dir * half).distance_to(rp[i]) < _node_r[n] or (p - dir * half).distance_to(rp[i]) < _node_r[n]):
				return true
	if r.has("kerb") or not (String(r["k"]) in KERB_RED_KINDS):
		return false
	for i in range(ids.size()):
		if pts[i].distance_to(p) < _node_r[ids[i]] + KERB_CUT + KERB_RED + 1.0 and _kerb_arms(ids[i]) >= 3:
			return true
	return false
const BUS_CLEAR := 12.0              ## m along the kerb either side of a bus stop with no car parked
var _zebra_cells := {}               ## 20 m cell -> [[middle, along its road, half its road's width]] (_zebras_near)

## the zebras whose middles are within about 20-40 m of p (the cells round it), worked out the
## first time a car is parked
func _zebras_near(p: Vector2) -> Array:
	if _zebra_cells.is_empty():
		_zebra_cells[Vector2i(1 << 20, 0)] = []   # (worked out: even a town with no zebras)
		for ni: int in _crossing_nodes:
			var z := _zebra_geom(ni)
			if z.is_empty():
				continue
			var k := Vector2i(((z[0] as Vector2) / 20.0).floor())
			if not _zebra_cells.has(k):
				_zebra_cells[k] = []
			(_zebra_cells[k] as Array).append([z[0], z[3], float(z[2])])
	var out: Array = []
	var k0 := Vector2i((p / 20.0).floor())
	for dx in [-1, 0, 1]:
		for dz in [-1, 0, 1]:
			out.append_array(_zebra_cells.get(k0 + Vector2i(dx, dz), []))
	return out
func _build_parked() -> void:
	if String(_place.get("look", "")) != "med":
		return   # northern suburbs park in driveways
	var xf: Array = []
	var cols: Array = []
	var xf_by := {"sedan": [], "hatch": [], "mini": [], "wagon": [], "mpv": [], "suv": [], "van": [], "moto_parked": []}
	var cols_by := {"sedan": [], "hatch": [], "mini": [], "wagon": [], "mpv": [], "suv": [], "van": [], "moto_parked": []}
	var palette := _car_paints()
	var rng := RandomNumberGenerator.new()
	for ri: int in _tile_roads.get(_tile, []):
		var r: Dictionary = _roads[ri]
		if not r["drive"] or r["pv"] or not (r["k"] in ["residential", "tertiary", "unclassified", "living_street"]):
			continue
		if _over():
			await _pause()
		rng.seed = hash(_city_name) + 11 + ri * 7919   # the road's own: every square parks it alike
		var hw: float = float(r["w"]) * 0.5
		var paint := int(r["kerb"]) if r.has("kerb") else _kerb_paint(r, _hash_i((r["pts"] as PackedVector2Array)[0]))
		var fill: float = PARKED_FILL_LIVING if r["k"] == "living_street" else float(PARKED_FILL[paint])
		if r["k"] == "tertiary":
			fill *= 0.85   # a busier street: more of it kept clear
		for run: PackedVector2Array in _street_runs(r):
			var cum := PackedFloat32Array([0.0])
			for i in range(1, run.size()):
				cum.append(cum[i - 1] + run[i - 1].distance_to(run[i]))
			var total := cum[cum.size() - 1]
			for sgn: float in [-1.0, 1.0]:
				var s := 4.0 + rng.randf() * 3.0
				var inner := int(r["o"]) != 0 and int(sgn) == -int(r["o"])   # the left of its traffic
				while s < total - 4.0:
					if inner:   # beside the other half of a divided road: the median, nobody parks there
						var c0 := _along(run, cum, s)
						var pair := _partner(c0, (_along(run, cum, minf(s + 1.0, total)) - c0).normalized(), ri, hw, int(r["o"]))
						if not pair.is_empty() and float(pair[2]) < PARKED_MEDIAN_GAP:
							s += 5.6
							_tally("parked_median_kept_clear", 1)
							continue
					if rng.randf() < fill:
						var kind: String = CAR_MIX[rng.randi() % CAR_MIX.size()]
						var colour: Color = palette[rng.randi() % palette.size()]
						var c := _along(run, cum, s)
						var d := (_along(run, cum, minf(s + 1.0, total)) - c).normalized()
						var side := Vector2(-d.y, d.x) * sgn
						var p := c + side * (hw + 0.6)   # mostly up on the pavement: a third of a car in the road
						var ok := _mine(p) and not _no_parking(r, ri, p) and _push_out(p, 1.0, false) == Vector2.ZERO
						for np: Array in _no_park:   # kept clear by hand (details.gd): a view a film had
							if p.distance_to(np[0]) < float(np[1]):
								ok = false
						for i: int in _near(_post_hash, p, 1.4, BLD_CELL):
							if _posts[i].distance_to(p) < 1.4:
								ok = false
						var face := d * sgn   # nose with the traffic on its side
						# not poking into the asphalt: near a corner the next street can be
						# right there, and the car stood in its lane
						ok = ok and _off_road(p + face * 1.25, -0.1) and _off_road(p - face * 1.25, -0.1)
						# nor on a strip with another road just past it (a service lane alongside, a
						# boulevard's other half): road both sides of it, it stood in the middle
						ok = ok and _off_road(p + side * 2.6, 0.0)
						if ok:
							var yaw := atan2(face.x, face.y)
							# with the ground: nose up a hill, leaning across a camber (level, on a
							# slope one end floated and the other sank into the road)
							var lx := Vector2(face.y, -face.x)
							var pitch := atan2(_h(p + face * 1.4) - _h(p - face * 1.4), 2.8)
							var roll := atan2(_h(p + lx * 0.8) - _h(p - lx * 0.8), 1.6)
							var lean := Basis(Vector3.UP, yaw) * Basis(Vector3.RIGHT, -pitch) \
								* Basis(Vector3.BACK, roll) * Basis(Vector3.FORWARD, -0.05 * sgn)
							(xf_by[kind] as Array).append(Transform3D(lean, _g3(p, 0.1)))   # half up the kerb
							_ao_car(p, face, KERB_H + 0.025)
							var roll2 := posmod(_hash_i(p * 7.0), 1000)
							if roll2 < 70:   # a flag on a stick at the back window on the road's side
								var win := p - side * 0.86 - face * 0.5
								var fly := Vector3(-face.x, 0, -face.y)
								_car_flags.append(Transform3D(Basis(fly, Vector3.UP, fly.cross(Vector3.UP)),
									_g3(win, 0.1 + float({"sedan": 1.12, "hatch": 1.15, "mini": 1.12, "wagon": 1.12, "mpv": 1.42, "suv": 1.32, "van": 1.45}.get(kind, 1.15)))))
							elif roll2 > 980:   # a cat on the pavement at its nose
								var cq := p + face * 2.7 + side * 0.45
								cat_at(cq, _g3(cq, KERB_H).y, -side.rotated(float(roll2 % 5 - 2) * 0.3), "sit")
							(cols_by[kind] as Array).append(colour)
							xf.append(0)
							_parked_at.append(p)
							_parked_face.append(face)
							_add_car_posts(p, face)
					elif rng.randf() < PARKED_MOTO:
						_park_moto(r, ri, run, cum, s, total, hw, sgn, rng, palette, xf_by, cols_by)
					s += 5.6
	for yc: Array in _yard_cars:   # the cars parked in front yards (_front_gate)
		(xf_by[String(yc[1])] as Array).append(yc[0])
		(cols_by[String(yc[1])] as Array).append(palette[int(yc[2]) % palette.size()])
	_tally("yard_cars", _yard_cars.size())
	_parked_xf = xf_by   # drawn with the car parks' cars, in one set of batches (_build_lots)
	await _furn._place(_furn._flag_kit("car", "il"), _car_flags, _furn.NEAR_SEEN, "flags_on_cars")
	_parked_cols = cols_by
	_tally("parked", xf.size())

## Car parks: OSM's parking areas -- a block's own lot behind its buildings, a supermarket's
## -- laid out in rows of bays along their long side (2.5 m wide, 5 m deep, two rows back to
## front across a 6 m aisle), the bays painted, and about three in four taken. Bays that
## would stick out of the lot, into a building, onto a road or onto a tree are left out.
var _lot_at: Array = []              ## a car in each car park (for tests and tours)
var _moto_at := PackedVector2Array()  ## each motorbike parked on a pavement (for tests: tests/street_fronts.gd)
var _parked_at := PackedVector2Array()  ## each car parked by a street, and the way it faces (tests/parked_median.gd)
var _parked_face := PackedVector2Array()
var _plank_at := PackedVector2Array() ## a point along each piece of wooden board fence on a garden wall (for tests)
var _parked_xf := {}                 ## the street's parked cars by shape, to batch with the car parks'
var _parked_cols := {}
const LOT_CARS := 6000               ## car-park cars in a whole city, at most: they are a lot to draw
var _lot_cars := 0

func _build_lots() -> void:
	var rings: Array = _rings_near("parking").filter(_ring_mine)
	var palette := _car_paints()
	var rng := RandomNumberGenerator.new()
	var xf_by := {"sedan": [], "hatch": [], "mini": [], "wagon": [], "mpv": [], "suv": [], "van": [], "moto_parked": []}
	var cols_by := {"sedan": [], "hatch": [], "mini": [], "wagon": [], "mpv": [], "suv": [], "van": [], "moto_parked": []}
	for kind: String in _parked_xf:   # the street's parked cars go in the same batches
		(xf_by[kind] as Array).append_array(_parked_xf[kind])
		(cols_by[kind] as Array).append_array(_parked_cols[kind])
	_parked_xf = {}
	_parked_cols = {}
	var lines := CBuf.new(GROUND_CELL)
	var cars := 0
	var ly := Y_AREA + 0.012
	for ring: PackedVector2Array in rings:
		var area := _area(ring)
		if area < 120.0 or area > 8000.0:
			continue   # (a mall's or a stadium's acres of tarmac: left empty, it is a lot to draw)
		if _over():
			await _pause()
		rng.seed = _hash_i(ring[0]) + 31
		var n := ring.size()
		var u := Vector2.RIGHT
		var longest := 0.0
		for i in range(n):
			var e := ring[(i + 1) % n] - ring[i]
			if e.length() > longest:
				longest = e.length()
				u = e.normalized()
		var v := Vector2(-u.y, u.x)
		var umin := INF
		var umax := -INF
		var vmin := INF
		var vmax := -INF
		for q in ring:
			umin = minf(umin, q.dot(u))
			umax = maxf(umax, q.dot(u))
			vmin = minf(vmin, q.dot(v))
			vmax = maxf(vmax, q.dot(v))
		var inside := func(q: Vector2) -> bool: return Geometry2D.is_point_in_polygon(q, ring)
		# rows across the lot: [row facing back, aisle, row facing forward], again and again
		var vv := vmin + 0.5
		var row := 0
		var bays := 0
		var taken := 0
		while vv + 5.0 <= vmax - 0.3 and bays < 140:
			if _over():
				await _pause()
			var face := -v if row % 2 == 0 else v   # nose in, away from the aisle
			var uu := umin + 0.6
			var placed_any := false
			while uu + 2.5 <= umax - 0.6 and bays < 140:
				var p := u * (uu + 1.25) + v * (vv + 2.5)
				var ok: bool = inside.call(p + u * 1.15 + v * 2.3) and inside.call(p - u * 1.15 + v * 2.3) \
					and inside.call(p + u * 1.15 - v * 2.3) and inside.call(p - u * 1.15 - v * 2.3)
				ok = ok and _push_out(p, 1.4, false) == Vector2.ZERO and _off_road(p, 1.6) and _clear_of_posts(p, 1.8)
				if ok:
					placed_any = true
					bays += 1
					# the bay's two side lines
					for side: float in [-1.25, 1.25]:
						var a := p + u * side - v * 2.5
						var b := p + u * side + v * 2.5
						lines.quad3(_g3(a - u * 0.05, ly), _g3(b - u * 0.05, ly), _g3(b + u * 0.05, ly), _g3(a + u * 0.05, ly))
					if rng.randf() < 0.66 and taken < 70 and _lot_cars + cars < LOT_CARS:
						taken += 1
						var kind: String = CAR_MIX[rng.randi() % CAR_MIX.size()]
						var f := face.rotated(rng.randf_range(-0.05, 0.05))
						var at := p + u * rng.randf_range(-0.15, 0.15) - face * 0.2
						(xf_by[kind] as Array).append(Transform3D(Basis(Vector3.UP, atan2(f.x, f.y)), _g3(at, 0.02)))
						_ao_car(at, f, Y_AREA + 0.035)
						if taken == 1:
							_lot_at.append(at)
						(cols_by[kind] as Array).append(palette[rng.randi() % palette.size()])
						_add_car_posts(at, f)
						cars += 1
				uu += 2.5
			vv += 5.0 + (6.0 if row % 2 == 0 else 0.4)   # the aisle after the first row of a pair
			row += 1
	# a car park mapped only by its lanes (OSM: service=parking_aisle, as most blocks' own
	# lots are): a row of bays down each side of each lane
	for ri: int in _tile_roads.get(_tile, []):
		var r: Dictionary = _roads[ri]
		if r.get("sv", "") != "parking_aisle":
			continue
		if _over():
			await _pause()
		rng.seed = hash(_city_name) + 31 + ri * 7919
		var pts: PackedVector2Array = r["pts"]
		var hw: float = float(r["w"]) * 0.5
		var taken := 0
		for j in range(pts.size() - 1):
			var a := pts[j]
			var b := pts[j + 1]
			var L := a.distance_to(b)
			if L < 4.0:
				continue
			var d := (b - a) / L
			var nrm := Vector2(-d.y, d.x)
			var s := 2.5
			while s + 1.25 < L - 1.0:
				for sg: float in [-1.0, 1.0]:
					var face := nrm * sg   # nose in, away from the lane
					var p := a + d * s + face * (hw + 2.6)
					if not _mine(p) or _push_out(p, 1.4, false) != Vector2.ZERO or not _off_road(p, 1.2) or not _clear_of_posts(p, 1.8):
						continue
					for side: float in [-1.25, 1.25]:
						var q0 := p + d * side - face * 2.5
						var q1 := p + d * side + face * 2.5
						lines.quad3(_g3(q0 - d * 0.05, ly), _g3(q1 - d * 0.05, ly), _g3(q1 + d * 0.05, ly), _g3(q0 + d * 0.05, ly))
					if rng.randf() < 0.6 and taken < 24 and _lot_cars + cars < LOT_CARS:
						taken += 1
						var kind: String = CAR_MIX[rng.randi() % CAR_MIX.size()]
						var f := face.rotated(rng.randf_range(-0.05, 0.05))
						(xf_by[kind] as Array).append(Transform3D(Basis(Vector3.UP, atan2(f.x, f.y)), _g3(p, 0.02)))
						_ao_car(p, f, Y_AREA + 0.035)
						(cols_by[kind] as Array).append(palette[rng.randi() % palette.size()])
						_add_car_posts(p, f)
						cars += 1
				s += 2.5
	_draw_parked(xf_by, cols_by)
	_add_mesh(lines, _surface("mark"), false, DETAIL_RANGE)
	_lot_cars += cars
	_tally("lot_cars", cars)

## car colours as Israeli streets have them (and Canadian ones are not far off): mostly
## white, silver, grey and black, now and then a blue, a red or a beige
func _car_paints() -> Array:
	var ink := Palette.col("ink")
	var bg := Palette.col("bg")
	var alt := Palette.col("bg_alt")
	var white := ink
	# the greys neutral: mixed from the palette's bg_alt (lavender here) silver and grey cars
	# came out mauve beside the shops (the paving's greys had the same fault)
	var silver := _greyed(ink.lerp(alt, 0.32), 0.92)
	var grey := _greyed(alt.lerp(ink, 0.22), 0.92)
	var black := _greyed(bg.lerp(alt, 0.35), 0.85)
	# a car's red is a car paint's red and its blue a dark blue, whatever the palette: the
	# palette's hazard (pink here) and player (cyan) made pink and teal cars, and a filmed
	# street has none. Their hue pinned, their strength the palette's.
	var hz := Palette.col("hazard")
	var pl := Palette.col("player")
	var red := Color.from_hsv(0.99, clampf(hz.s, 0.55, 0.8), clampf(hz.v * 0.62, 0.35, 0.6))
	var blue := Color.from_hsv(0.61, clampf(pl.s, 0.5, 0.75), clampf(pl.v * 0.42, 0.25, 0.48))
	# (more white and silver at the end: about a third white, a third silver and grey, a tenth
	# black, a twentieth each blue and red, the odd beige -- the film's cars
	# pick a paint by its place in the list, so the first fourteen stay where they are)
	# The fourteen after them bring the whole list to the vehicle register's shares (data_tools/
	# car_mix.py on cities/data/vehicle_mix.json, Israel's licensed cars, 2026): white 44%,
	# silver 17, grey 17, black 13, blue 5, beige 2, red 2 -- in 50: 22, 9, 8, 7, 2, 1, 1.
	# (Green, the odd one here before, is not among the register's 25 commonest colours.)
	var beige := Palette.col("warn").lerp(ink, 0.5).lerp(alt, 0.2)
	var out: Array = [white, white, white, white, silver, silver, silver, grey, grey, black, black,
		blue, red, beige]
	for spec: Array in [[white, 18], [silver, 6], [grey, 6], [black, 5], [blue, 1]]:
		for i in range(int(spec[1])):
			out.append(spec[0])
	return out.map(func(c: Color) -> Color: return _natural(c, 0.6))

## parked cars and traffic as Israel's vehicle register has them (data_tools/car_mix.py:
## each make's commonest models by shape, 2026): crossovers and SUVs 42%, saloons 22,
## hatchbacks 21, city cars 11, work vans and pick-ups 3, a people carrier 1 -- in 40: 17, 9,
## 8, 4, 1, 1. Estates are under half a percent (it was one car in thirteen, and SUVs one in four).
const CAR_MIX := ["suv", "suv", "suv", "suv", "suv", "suv", "suv", "suv", "suv", "suv", "suv", "suv", "suv", "suv", "suv", "suv", "suv",
	"sedan", "sedan", "sedan", "sedan", "sedan", "sedan", "sedan", "sedan", "sedan",
	"hatch", "hatch", "hatch", "hatch", "hatch", "hatch", "hatch", "hatch",
	"mini", "mini", "mini", "mini", "van", "mpv"]

## the shared car mesh for parked cars and traffic: the sedan's body, wheels, lights and
## plates as ONE surface, one draw call a batch (as six surfaces, a patch of parked cars
## cost six). Each part's colour is in its vertex colour, and what it is in the alpha:
## the shader (CAR_SHADER) makes paint take the car's own colour (instance custom data, or
## paint_col on the player's car), and gives every part its own finish: paint a clear coat
## that reflects the sky (more at a glancing look) with dark wheel wells and door seams
## (from the wheels' place in UV2), glass that reflects more, five-spoke rims, number plates
## with their characters, headlights that light at night and tail lights that flare on the
## brake (custom alpha).
const CAR_SHADER := """
shader_type spatial;
uniform float night = 0.0;
uniform sampler2D plate_font : filter_linear_mipmap, repeat_disable;   // digits 0-9, '-', I, L, מונית, T A X (_plate_font)
uniform float plate_style = 0.0;       // 1: an Israeli plate (yellow, black digits, the blue IL strip)
uniform vec4 plate_blue : source_color;
uniform float plate_seed = 0.0;        // the player's car: its own number
uniform vec4 dust : source_color;      // the street's dust on a car that has stood a while
uniform vec4 sign_red : source_color;  // a learner's roof sign
uniform vec4 amber : source_color;     // indicators: the lens
uniform vec4 amber_lit : source_color; // ... and lit (saturated: a bright colour went to white in the sun)
uniform vec4 red_lit : source_color;   // a tail light, lit
uniform vec4 taxi_col : source_color;  // a taxi's roof sign
uniform float taxi_latin = 0.0;         // 1: its sign reads TAXI (Bedford's), not מונית
// a number of the car's own, steady while it drives (flat: interpolated, its last digits
// wandered across a plate and the hashes made of it drew a different digit in each pixel)
varying flat float plate_id;
uniform vec4 lamp : source_color;
uniform vec4 tail : source_color;
uniform vec4 sky_top : source_color;   // what the paint and glass reflect: the sky as it is now,
uniform vec4 sky_hor : source_color;
uniform vec4 street : source_color;    // and the road below the horizon
uniform vec4 well : source_color;      // a wheel well's dark
uniform float fixed_paint = 0.0;       // 1: paint_col (the player's car), not the copy's own colour
uniform vec4 paint_col : source_color;
uniform float occupied = 0.0;          // the player's car: 1 while the player sits in it
uniform float head_turn = 0.0;         // the player's car: where its driver looks (radians, + left)
uniform vec4 skin : source_color;      // the people inside: skin, hair, and two shirts to pick from
uniform vec4 hair : source_color;
uniform vec4 shirt_a : source_color;
uniform vec4 shirt_b : source_color;
uniform vec4 dents[4];                 // the player's car: dents (x, y, z in its frame, depth 0..1; w 0: none)
// A copy's instance data (traffic.gd's _custom; parked cars have only the paint): the paint
// in rgb, each channel carrying a small whole number as twice it added (the paint stays
// 0..1 under it): r the indicators lit (1 its left, 2 its right, 3 both), g and b the front
// wheels' steer (g * 8 + b, 32 straight ahead, 0 no word: a parked car's own). Alpha: the
// brake light 0..1, plus 2 for each person aboard, plus 8 reversing, 16 the front passenger's
// door open, 32 stood at the kerb a while (a parked car's dust and permit, driven off).
varying vec3 paint;
varying flat float blink_k;
varying flat float occ;
varying flat float brake;
varying flat float flags;
varying vec3 lpos;                     // the car's own frame: x across, y up from the road, z forward
varying vec3 lnrm;
varying vec3 lcam;                     // the eye, in that frame
varying float who;                     // a number of the car's own, for its people's looks
varying float dented;                  // how near a dent: the paint scuffed and dull there
void vertex() {
	vec3 kk = floor(INSTANCE_CUSTOM.rgb * 0.5);
	paint = INSTANCE_CUSTOM.rgb - kk * 2.0;
	flags = floor(INSTANCE_CUSTOM.a / 8.0 + 0.001);
	float rest = INSTANCE_CUSTOM.a - flags * 8.0;
	occ = floor(rest * 0.5 + 0.001);
	brake = clamp(rest - occ * 2.0, 0.0, 1.0);
	blink_k = kk.r;
	// (its copy's number and its paint: steady as it moves, unlike where it is)
	plate_id = fixed_paint > 0.5 ? plate_seed : float(INSTANCE_ID) * 0.7548777 + dot(paint, vec3(3.1, 5.7, 7.3));
	bool parked_v = fixed_paint < 0.5 && occ < 0.5;
	// the front wheels turned as it steers (UV2 on a wheel: its middle's x and z); a parked
	// car now and then left with its wheels turned
	if (COLOR.a > 0.2 && COLOR.a < 0.45 && UV2.y > 0.1) {
		float sq = kk.g * 8.0 + kk.b;
		float st = sq > 0.5 ? (sq - 32.0) * 0.016
			: ((parked_v && fract(plate_id * 23.17) < 0.3) ? (fract(plate_id * 5.3) < 0.5 ? -0.3 : 0.3) : 0.0);
		float cs = cos(st);
		float sn = sin(st);
		vec2 d = VERTEX.xz - UV2;
		VERTEX.xz = UV2 + vec2(cs * d.x + sn * d.y, -sn * d.x + cs * d.y);
		NORMAL.xz = vec2(cs * NORMAL.x + sn * NORMAL.z, -sn * NORMAL.x + cs * NORMAL.z);
	}
	lpos = VERTEX;
	lnrm = NORMAL;
	dented = 0.0;
	for (int i = 0; i < 4; i++) {   // pressed in toward the car's middle round each dent, crumpled
		if (dents[i].w > 0.0) {
			float k = dents[i].w * (1.0 - smoothstep(0.0, 0.8, distance(VERTEX, dents[i].xyz)));
			VERTEX -= normalize(vec3(dents[i].x, 0.0, dents[i].z * 0.35) + vec3(0.0001)) * k * 0.3;
			VERTEX.y += k * (0.05 + 0.04 * sin(VERTEX.x * 19.0 + VERTEX.z * 7.0));   // (the bonnet buckles up)
			dented = max(dented, k);
		}
	}
	lcam = transpose(mat3(MODEL_MATRIX)) * (CAMERA_POSITION_WORLD - MODEL_MATRIX[3].xyz);
	who = fract(sin(dot(MODEL_MATRIX[3].xz, vec2(12.9898, 78.233))) * 43758.5453);
	// a few cars' own things, in every car's mesh and folded away on the rest (vertex alpha
	// 0.52 a learner's roof sign, 0.54 a new driver's sign in the back window, 0.56 a
	// parking permit on a parked car's windscreen): no draws of their own
	float code = COLOR.a;
	bool local = parked_v || flags > 3.5;   // (a car parked here, or one that stood here: its permit)
	if ((abs(code - 0.52) < 0.006 && (fixed_paint > 0.5 || fract(plate_id * 13.17) > 0.025))
			|| (abs(code - 0.54) < 0.006 && (fixed_paint > 0.5 || fract(plate_id * 17.31) > 0.07))
			|| (abs(code - 0.56) < 0.006 && !(local && fract(plate_id * 19.7) < 0.55))) {
		VERTEX = vec3(0.0);
	}
}
// where a ray (from o along unit d) first meets an ellipsoid at c with radii r; -1 if not
float ray_blob(vec3 o, vec3 d, vec3 c, vec3 r) {
	vec3 oo = (o - c) / r;
	vec3 dd = d / r;
	float a = dot(dd, dd);
	float b = dot(oo, dd);
	float k = b * b - a * (dot(oo, oo) - 1.0);
	if (k < 0.0) {
		return -1.0;
	}
	return (-b - sqrt(k)) / a;
}
vec3 sky_at(float e) {
	return e > 0.0 ? mix(sky_hor.rgb, sky_top.rgb, smoothstep(0.0, 0.5, e))
		: mix(sky_hor.rgb * 0.8, street.rgb, 1.0 - smoothstep(-0.25, 0.0, e));
}
float line_cover(float d, float w, float aa) {
	return clamp((w - d) / aa + 0.5, 0.0, 1.0);
}
// how much of glyph g covers (x, y) of its cell (both 0..1, y down): the font is a few
// pixels a glyph, smoothed, so up close its edge is taken at the half-way grey; further off,
// where a glyph is a few pixels on screen, its smaller copies average it to grey and that
// grey is the ink (taken at the half-way grey, a plate was blank from the chase view)
float plate_glyph(float g, float x, float y, float far) {
	// (kept inside its own cell's margin: the font's smaller copies bled the next glyph in)
	float a = texture(plate_font, vec2((g + clamp(x, 0.1, 0.9)) / 21.0, clamp(y, 0.06, 0.94))).r;   // (PLATE_GLYPHS' count)
	return mix(smoothstep(0.3, 0.7, a), min(a * 1.8, 1.0), far);
}
// an indicator lamp at x (the car's left is +X) lit now
bool blink_on(float k, float x) {
	return k > 2.5 || (k > 0.5 && k < 1.5 && x > 0.0) || (k > 1.5 && k < 2.5 && x < 0.0);
}
void fragment() {
	float part = COLOR.a;
	vec3 col = COLOR.rgb;
	float rough = 0.6;
	float metal = 0.0;
	float spec = 0.5;
	vec3 emit = vec3(0.0);
	vec3 to_eye = normalize(-VERTEX);
	float ndv = clamp(dot(NORMAL, to_eye), 0.0, 1.0);
	vec3 rw = (INV_VIEW_MATRIX * vec4(reflect(-to_eye, NORMAL), 0.0)).xyz;
	vec3 refl = sky_at(rw.y) * (1.0 - 0.75 * night);
	float aa = fwidth(lpos.z) + 0.001;
	// how long it has stood and how old it is, each car its own: a parked car gathers the
	// street's dust (on top and low down), an older one's paint is faded by the sun
	bool parked = fixed_paint < 0.5 && occ < 0.5;
	float dirt = fixed_paint > 0.5 ? 0.12 : (0.12 + 0.6 * fract(plate_id * 5.17)) * ((parked || flags > 3.5) ? 1.0 : 0.45);
	float old = fixed_paint > 0.5 ? 0.0 : smoothstep(0.7, 1.0, fract(plate_id * 7.31));
	bool driving = fixed_paint < 0.5 && occ > 0.5;
	// the front passenger's door open (its right, -X, on the kerb side): where it was, the way
	// in -- the seat, the sill (the door itself is traffic.gd's _door)
	bool door_open = fixed_paint < 0.5 && mod(floor(flags * 0.5), 2.0) > 0.5 && lpos.x < 0.0 && lnrm.x < -0.3;
	if (part > 0.9 && door_open && UV2.y > 0.0 && lpos.z > -0.19 * UV2.x && lpos.z < UV2.x - UV2.y - 0.14 && lpos.y > 0.3) {
		ALBEDO = lpos.y < 0.4 ? paint * 0.55 : vec3(0.07, 0.07, 0.075) * (lpos.y > 0.55 ? 1.6 : 1.0);
		ROUGHNESS = 0.9;
		SPECULAR = 0.2;
		EMISSION = vec3(0.0);
	} else if (part > 0.7 && part <= 0.9 && door_open && UV2.y > 0.0 && lpos.z > UV2.x - 0.05) {
		ALBEDO = vec3(0.05);   // (the door's window went with it: the cabin, dim)
		ROUGHNESS = 0.9;
		SPECULAR = 0.2;
		EMISSION = vec3(0.0);
	} else {
	if (part > 0.9) {            // paint
		col = fixed_paint > 0.5 ? paint_col.rgb : paint;
		col = mix(col, vec3(dot(col, vec3(0.3, 0.5, 0.2))) * 1.08 + 0.05, old * 0.4);   // sun-faded
		float dust_amt = clamp(dirt * (0.6 * max(lnrm.y, 0.0) + 0.4 * (1.0 - smoothstep(0.15, 0.75, lpos.y))), 0.0, 0.6);
		col = mix(col, dust.rgb, dust_amt);
		// scuffed bumper corners, on some
		if (abs(lnrm.z) > 0.55 && lpos.y > 0.3 && lpos.y < 0.58 && fract(plate_id * 2.37) < 0.4) {
			// thin scratches where a corner met a post: a few, at the bumper's height
			float sc = step(0.92, fract(sin(dot(floor(vec2(lpos.x * 60.0, lpos.y * 160.0)), vec2(12.9898, 78.233))) * 43758.5453))
				* smoothstep(0.6, 0.8, abs(lpos.x));
			col = mix(col, col * 0.6 + 0.08, sc * 0.6);
		}
		col *= mix(0.72, 1.0, smoothstep(0.12, 0.55, lpos.y));   // grime, and less light, low down
		float f = 0.05 + 0.55 * pow(1.0 - ndv, 4.0);
		float side = abs(lnrm.x);
		vec2 wd = vec2(abs(lpos.z) - UV2.x, lpos.y - UV2.y);
		if (UV2.y > 0.0 && side > 0.35 && length(wd) < UV2.y + 0.075) {
			col = well.rgb;   // the wheel well round the tyre
			f = 0.0;
			rough = 0.9;
		} else {
			if (UV2.y > 0.0 && side > 0.55 && lpos.y > 0.3) {
				// door seams: behind the front wheel, at the pillar, ahead of the back wheel
				float d = min(min(abs(lpos.z - (UV2.x - UV2.y - 0.14)), abs(lpos.z + 0.19 * UV2.x)),
					abs(lpos.z + UV2.x - UV2.y - 0.1));
				col *= 1.0 - 0.6 * line_cover(d, 0.006, aa);
			}
			rough = mix(0.3, 0.75, max(old * 0.5, dust_amt * 1.4));
			metal = 0.1;
			spec = 0.6;
			f *= 1.0 - min(dust_amt * 1.4, 0.8) - old * 0.3;
		}
		emit = refl * f;
	} else if (part > 0.7) {     // glass, and whoever sits behind it
		vec3 inside = vec3(0.0);
		// UV2 on a car's glass: (front seats' z, their cushion's height); traffic's custom
		// alpha 2+ has a driver, 4+ a passenger too (the rest of it is the brake light)
		float aboard = fixed_paint > 0.5 ? occupied : occ;
		if (UV2.y > 0.0 && aboard > 0.5) {
			vec3 rd = normalize(lpos - lcam);
			float best = 1e9;
			vec3 col_hit = vec3(0.0);
			vec3 n_hit = vec3(0.0, 1.0, 0.0);
			for (int s = 0; s < 2; s++) {
				if (s == 1 && aboard < 1.5) {
					break;
				}
				float x = s == 0 ? 0.36 : -0.36;   // the driver on the car's left (+X)
				vec3 head = vec3(x, UV2.y + 0.6, UV2.x);
				vec3 body = vec3(x, UV2.y + 0.28, UV2.x - 0.05);
				float th = ray_blob(lcam, rd, head, vec3(0.1, 0.12, 0.11));
				if (th > 0.0 && th < best) {
					best = th;
					vec3 hp = lcam + rd * th;
					n_hit = normalize((hp - head) / vec3(0.1, 0.12, 0.11));
					// hair on top and at the back, a face in front -- the front turned with the
					// player's driver's head as they look left and right
					float a = (fixed_paint > 0.5 && s == 0) ? head_turn : 0.0;
					float fz = n_hit.x * sin(a) + n_hit.z * cos(a);
					col_hit = (n_hit.y > 0.35 || fz < -0.2) ? hair.rgb : skin.rgb;
				}
				float tb = ray_blob(lcam, rd, body, vec3(0.21, 0.24, 0.14));
				if (tb > 0.0 && tb < best) {
					best = tb;
					n_hit = normalize((lcam + rd * tb - body) / vec3(0.21, 0.24, 0.14));
					col_hit = mix(shirt_a.rgb, shirt_b.rgb, fract(who * (s == 0 ? 1.0 : 7.3)));
				}
			}
			// lit dimly from the windows above and the side, the cabin itself dark
			inside = best < 1e8 ? col_hit * (0.22 + 0.25 * max(n_hit.y, 0.0) + 0.1 * abs(n_hit.x)) : vec3(0.02);
			inside *= 1.0 - 0.7 * night;
		}
		// a parked car's windscreen, as most have them in summer: a folded silver sunshade
		if (parked && lnrm.z > 0.3 && lpos.z > 0.0 && fract(plate_id * 9.71) < 0.45) {
			float fold = step(0.5, fract(lpos.x * 7.0));
			inside = vec3(0.5 + 0.14 * fold) * (1.0 - 0.6 * night);
		}
		float f = 0.12 + 0.88 * pow(1.0 - ndv, 3.0);
		emit = mix(inside, refl, f);
		emit = mix(emit, dust.rgb * 0.45, dirt * 0.3);   // (dusty glass)
		rough = 0.05;
	} else if (part > 0.6) {     // number plate
		rough = 0.4;
		if (plate_style > 0.5) {
			// as Israel's: yellow, black digits -- 123-45-678, or the older 12-345-67 -- in a
			// black rim, the blue strip at the left with IL; the digits made up from the car's
			// own number, never a real one
			float u = UV.x;
			float v = UV.y;
			vec3 ink_col = col * 0.06;
			float far = smoothstep(0.004, 0.012, fwidth(u));   // (a glyph pixel under one on screen)
			if (u < 0.115) {
				col = plate_blue.rgb;
				float gx = (u - 0.012) / 0.046;
				if (gx >= 0.0 && gx < 2.0 && v > 0.42 && v < 0.88) {
					col = mix(col, vec3(1.0), plate_glyph(gx < 1.0 ? 11.0 : 12.0, fract(gx), (v - 0.42) / 0.46, far));
				}
			} else {
				bool eight = fract(plate_id * 3.7) > 0.4;
				float n = eight ? 10.0 : 9.0;
				float gx = (u - 0.13) / (0.84 / n);
				float i = floor(gx);
				if (i >= 0.0 && i < n && v > 0.18 && v < 0.82) {
					bool dash = eight ? (i == 3.0 || i == 6.0) : (i == 2.0 || i == 6.0);
					float g = dash ? 10.0 : floor(fract(sin(plate_id * 12.9898 + i * 78.233) * 43758.5453) * 10.0);
					col = mix(col, ink_col, plate_glyph(g, fract(gx), (v - 0.18) / 0.64, far));
				}
			}
			float inside = step(0.012, u) * step(u, 0.988) * step(0.06, v) * step(v, 0.94);
			col = mix(ink_col, col, inside);
		} else {   // a row of dark characters
			float cell = (UV.x - 0.1) / 0.8 * 7.0;
			float ch = step(0.1, UV.x) * step(UV.x, 0.9) * step(0.26, UV.y) * step(UV.y, 0.74)
				* step(0.18, fract(cell)) * step(fract(cell), 0.82);
			col = mix(col, col * 0.08, ch);
		}
	} else if (part > 0.51) {    // a sign or a sticker (only on the cars that keep it: vertex())
		rough = 0.5;
		vec2 g = vec2(lpos.x - UV2.x, lpos.y - UV2.y);   // from its middle (UV2)
		if (part > 0.57) {       // a taxi's roof sign: yellow, מונית in black front and back, lit at night
			col = taxi_col.rgb;
			if (abs(lnrm.z) > 0.5) {
				float tx = g.x * sign(lnrm.z);   // (rightward as seen: from the front or from behind)
				float far = smoothstep(0.004, 0.012, fwidth(tx) / 0.52);
				if (taxi_latin > 0.5) {   // TAXI, left to right
					float i = floor((tx + 0.208) / 0.104);
					if (i >= 0.0 && i < 4.0 && abs(g.y) < 0.055) {
						float gx = (tx + 0.208 - i * 0.104) / 0.104;
						float gi = i < 0.5 ? 18.0 : (i < 1.5 ? 19.0 : (i < 2.5 ? 20.0 : 11.0));
						col = mix(col, vec3(0.04), plate_glyph(gi, gx, (0.055 - g.y) / 0.11, far));
					}
				} else {
					float i = floor((0.26 - tx) / 0.104);   // the letters right to left
					if (i >= 0.0 && i < 5.0 && abs(g.y) < 0.055) {
						float gx = (tx - 0.26 + (i + 1.0) * 0.104) / 0.104;
						col = mix(col, vec3(0.04), plate_glyph(13.0 + i, gx, (0.055 - g.y) / 0.11, far));
					}
				}
			}
			emit = col * night * 2.0 + refl * 0.08;
			rough = 0.3;
		} else if (part < 0.53) {       // a learner's roof sign: a white lamed on red, front and back
			col = sign_red.rgb;
			if (abs(lnrm.z) > 0.5) {
				vec2 q = vec2(g.x * sign(lnrm.z) / 0.19, g.y / 0.1);
				float l = step(abs(q.x + 0.35), 0.12) * step(0.15, q.y) * step(q.y, 0.95)       // the stroke up
					+ step(abs(q.y - 0.15), 0.12) * step(-0.35, q.x) * step(q.x, 0.42)          // along the top
					+ step(abs(q.x - 0.42), 0.12) * step(-0.75, q.y) * step(q.y, 0.15)          // down the right
					+ step(abs(q.y + 0.75), 0.12) * step(-0.1, q.x) * step(q.x, 0.42);          // the foot
				col = mix(col, vec3(0.95), clamp(l, 0.0, 1.0));
			}
		} else if (part < 0.55) {   // a new driver's sign: white, a red rim, its two words
			vec2 q = abs(g) / vec2(0.13, 0.06);
			col = (q.x > 0.85 || q.y > 0.75) ? sign_red.rgb : vec3(0.93);
			float words = step(q.y, 0.35) * step(0.12, abs(g.x / 0.13 - 0.05)) * step(q.x, 0.7)
				* step(0.3, fract(g.x * 40.0));
			col = mix(col, vec3(0.08), words);
		} else {                    // a parking permit: its colour, a white band
			col = mix(plate_blue.rgb, vec3(0.92), step(abs(g.y), 0.012));
		}
	} else if (part > 0.45) {    // trim
		rough = 0.55;
		emit = refl * 0.05;
	} else if (part > 0.35) {    // a rim, the car's own pattern: five spokes, twelve fine ones, ten, or a steel wheel's cap
		float r = length(UV);
		float a = atan(UV.y, UV.x);
		float style = floor(fract(plate_id * 4.13) * 4.0);
		float n = style < 1.0 ? 5.0 : (style < 2.0 ? 12.0 : 10.0);
		bool solid = r < 0.28 || r > 0.84;
		if (style < 2.5) {
			solid = solid || cos(a * n) > (style < 1.0 ? 0.35 : (style < 2.0 ? 0.5 : 0.62));
		} else {                 // steel, under a plastic cap with vents
			solid = r < 0.8 && (r < 0.55 || fract(a * 1.2732 + 0.5) > 0.22);
		}
		vec3 rim_col = fract(plate_id * 2.9) < 0.22 ? col * 0.32 : col;   // a dark alloy now and then
		vec3 behind = mix(well.rgb, vec3(0.3), step(0.42, r) * step(r, 0.76) * 0.7);   // the brake disc
		col = solid ? rim_col : behind;
		if (r > 0.13 && r < 0.2 && cos(a * 5.0) > 0.9) { col *= 0.45; }       // the wheel nuts
		metal = solid ? 0.7 : 0.2;
		rough = 0.35;
		emit = solid ? refl * 0.25 : vec3(0.0);
	} else if (part > 0.2) {     // tyres: the sidewall a shade lighter than the tread
		col = abs(lnrm.x) > 0.7 ? col * 1.35 : col;
		col = mix(col, dust.rgb * 0.35, dirt * 0.22);
		rough = 0.9;
		spec = 0.2;
	} else if (part > 0.05) {    // headlights (and anything lit like them: a bus's route sign)
		rough = 0.1;
		if (UV2.x > 1.5) {       // an indicator's repeater on a door mirror
			col = amber.rgb * 0.45;
			emit = blink_on(blink_k, lpos.x) ? amber_lit.rgb * 1.5 : refl * 0.2;
		} else if (UV2.x > 0.5) {
			// a car's headlight behind its clear cover (UV: x 0 inner to 1 outer, y 0 low to
			// 1 high): an older car's chrome reflector, or a newer one's black housing with two
			// lenses and its running light, a strip along the top (now and then turned down
			// at the inner end), lit while it drives; the indicator's amber at the outer end
			vec2 m = vec2((UV.x - 0.5) * 0.36, (UV.y - 0.5) * 0.12);
			float style = fract(plate_id * 6.13);
			bool modern = style > 0.35;
			float lens = 1.0 - smoothstep(0.034, 0.04, length(m - vec2(-0.05, -0.006)));
			float lens2 = modern ? 1.0 - smoothstep(0.021, 0.026, length(m - vec2(0.055, -0.01))) : 0.0;
			float glow = max(lens, lens2);
			col = mix(modern ? vec3(0.05) : vec3(0.42), vec3(0.85), glow * 0.6);
			float drl = 0.0;
			if (modern) {
				float strip = step(0.03, m.y) * step(m.y, 0.048) * step(-0.16, m.x) * step(m.x, 0.12);
				float hook = step(style, 0.7) * step(-0.165, m.x) * step(m.x, -0.145) * step(-0.035, m.y) * step(m.y, 0.048);
				drl = max(strip, hook);
				col = mix(col, vec3(0.9), drl);
			}
			float ind = step(0.13, m.x);
			col = mix(col, amber.rgb * 0.7, ind);
			emit = refl * 0.3 + lamp.rgb * night * 2.5 * (0.35 + 0.65 * glow) * (1.0 - ind)
				+ (driving ? vec3(1.7) * drl : vec3(0.0))
				+ (blink_on(blink_k, lpos.x) ? amber_lit.rgb * 1.5 * ind : vec3(0.0));
		} else {
			emit = lamp.rgb * night * 2.5 + refl * 0.3;
		}
	} else {                     // tail lights
		if (UV2.x > 1.5) {       // the third brake light, at the top of the rear window
			col = tail.rgb * 0.3;
			emit = red_lit.rgb * 1.6 * brake;
		} else if (UV2.x > 0.5) {
			// a car's tail light (UV as the headlight's): the red, with its position light's
			// shape (a ring round the edge, or two bars) brighter; at the inner end the white
			// reversing light over the amber indicator
			vec2 m = vec2((UV.x - 0.5) * 0.32, (UV.y - 0.5) * 0.14);
			float style = fract(plate_id * 3.71);
			float inner = step(m.x, -0.09);
			float rev_l = inner * step(-0.005, m.y);
			float ind_l = inner - rev_l;
			vec2 q = vec2((m.x - 0.035) / 0.125, m.y / 0.07);
			float d = max(abs(q.x), abs(q.y));
			float led = style < 0.5 ? step(0.74, d) * step(d, 0.92)
				: step(abs(abs(m.y) - 0.03), 0.009) * step(-0.08, m.x) * step(m.x, 0.15);
			col = mix(tail.rgb * mix(0.45, 0.8, led), rev_l > 0.5 ? vec3(0.72) : amber.rgb * 0.6, inner);
			// (lit in a saturated red, under 2: brighter, the sun's tone curve took it to white)
			emit = (1.0 - inner) * red_lit.rgb * ((0.12 + 0.75 * night) * (1.0 + 1.4 * led) + (driving ? 0.35 : 0.0) * led + 1.3 * brake * (1.0 + 0.3 * led))
				+ rev_l * (mod(flags, 2.0) > 0.5 ? vec3(1.8) : refl * 0.15)
				+ ind_l * (blink_on(blink_k, lpos.x) ? amber_lit.rgb * 1.5 : vec3(0.0));
		} else {
			col = tail.rgb * 0.6;
			emit = red_lit.rgb * (0.12 + 0.75 * night + 1.3 * brake);
		}
	}
	if (dented > 0.0) {   // scraped paint and the primer under it round a dent
		float sc = clamp(dented * 1.6, 0.0, 0.75) * (0.6 + 0.4 * fract(sin(dot(floor(lpos.xz * 22.0), vec2(12.9898, 78.233))) * 43758.5453));
		col = mix(col, col * 0.45 + vec3(0.12), sc);
		rough = mix(rough, 0.9, sc);
		spec = mix(spec, 0.2, sc);
	}
	ALBEDO = col;
	ROUGHNESS = rough;
	METALLIC = metal;
	SPECULAR = spec;
	EMISSION = emit;
	}
}
"""
var _car_shader_mat: ShaderMaterial
var _player_car_mat: ShaderMaterial  ## the same shader on the player's car, its paint its own

## The number plates' characters, for CAR_SHADER: 0-9, a dash, I and L (and a taxi sign's five
## Hebrew letters), five by seven pixels
## each in a cell of seven by nine, smoothed up eightfold (the shader takes the edge at the
## half-way grey). Made once.
const PLATE_GLYPHS := [
	"01110100011000110001100011000101110", "00100011000010000100001000010001110",
	"01110100010000100010001000100011111", "11111000100010000010000011000101110",
	"00010001100101010010111110001000010", "11111100001111000001000011000101110",
	"00110010001000011110100011000101110", "11111000010001000100010000100001000",
	"01110100011000101110100011000101110", "01110100011000101111000010001001100",
	"00000000000000001110000000000000000", "01110001000010000100001000010001110",
	"10000100001000010000100001000011111",
	# and for a taxi's sign, מונית: mem, vav, nun, yod, tav
	"11110010011000110001100011000110111", "01100001000010000100001000010000100",
	"01100000100001000010000100001011110", "01110000100010000000000000000000000",
	"11111010010100101001010010100111001",
	# and for one in Latin letters, TAXI (with the I above): T, A, X
	"11111001000010000100001000010000100", "01110100011000111111100011000110001", "10001100010101000100010101000110001"]
var _plate_tex: ImageTexture

func _plate_font() -> ImageTexture:
	if _plate_tex != null:
		return _plate_tex
	var img := Image.create(PLATE_GLYPHS.size() * 7, 9, false, Image.FORMAT_L8)
	img.fill(Color.BLACK)
	for gi in range(PLATE_GLYPHS.size()):
		var bits: String = PLATE_GLYPHS[gi]
		for r in range(7):
			for c in range(5):
				if bits[r * 5 + c] == "1":
					img.set_pixel(gi * 7 + 1 + c, 1 + r, Color.WHITE)
	img.resize(PLATE_GLYPHS.size() * 7 * 8, 9 * 8, Image.INTERPOLATE_BILINEAR)
	img.generate_mipmaps()
	_plate_tex = ImageTexture.create_from_image(img)
	return _plate_tex

func _car_material() -> ShaderMaterial:
	if _car_shader_mat == null:
		_car_shader_mat = ShaderMaterial.new()
		var sh := Shader.new()
		sh.code = CAR_SHADER
		_car_shader_mat.shader = sh
	for m: ShaderMaterial in [_car_shader_mat, _player_car_mat]:
		if m == null:
			continue
		m.set_shader_parameter("plate_font", _plate_font())
		m.set_shader_parameter("plate_style", 1.0 if String(_place.get("look", "")) == "med" else 0.0)
		m.set_shader_parameter("plate_blue", _real_col("blue").lerp(Palette.col("bg"), 0.35))   # (a plate's strip is a deep blue)
		m.set_shader_parameter("dust", (_tone.get("sand", _tone["pavement"]) as Color).lerp(_tone["pavement"], 0.4))
		m.set_shader_parameter("sign_red", _real_col("red"))
		var orange := _real_col("orange")
		m.set_shader_parameter("amber", orange)
		m.set_shader_parameter("amber_lit", Color.from_hsv(orange.h, 0.95, 1.0))
		var red := _real_col("red")
		m.set_shader_parameter("red_lit", Color.from_hsv(red.h, 0.97, 1.0))
		m.set_shader_parameter("taxi_col", _real_col("yellow"))
		m.set_shader_parameter("taxi_latin", 0.0 if String(_place.get("look", "")) == "med" else 1.0)
		m.set_shader_parameter("lamp", _tone["lamplight"])
		m.set_shader_parameter("tail", Palette.col("hazard"))
		m.set_shader_parameter("night", 1.0 if _night else 0.0)
		m.set_shader_parameter("street", _tone["asphalt"])
		m.set_shader_parameter("well", (_tone["tyre"] as Color).darkened(0.55))
		m.set_shader_parameter("skin", _tone["skin"])
		m.set_shader_parameter("hair", _tone["hair"])
		m.set_shader_parameter("shirt_a", _tone["shirt_a"])
		m.set_shader_parameter("shirt_b", _tone["shirt_b"])
		if env != null and env.sky != null:
			var rs := _sky_reflect()
			m.set_shader_parameter("sky_top", rs[0])
			m.set_shader_parameter("sky_hor", rs[1])
		if m == _player_car_mat:
			m.set_shader_parameter("fixed_paint", 1.0)
			m.set_shader_parameter("paint_col", _tone[String(m.get_meta("paint", "paint"))])
			m.set_shader_parameter("occupied", 0.0 if _walking else 1.0)
	return _car_shader_mat

var _car_meshes := {}

## Parked cars, the street's and the car parks': in PARKED_CELL squares, the full car out to
## PARKED_NEAR from its square's middle, past that one plain shape for every kind
## (_parked_far_mesh, stretched to each kind's size), no shadow, out to PARKED_SEEN. They were
## one multimesh a 400 m square, drawn out to its middle's range plus 284 m: every parked car
## within ~420 m, the full ~1,300-triangle car, 1.24 M triangles of a Tel Aviv frame's 2.4 M
## (tests/perf_dive.gd).
const PARKED_CELL := 100.0
const PARKED_NEAR := 70.0
const PARKED_SEEN := 140.0
func _draw_parked(xf_by: Dictionary, cols_by: Dictionary) -> void:
	var far_xf: Array = []
	var far_cols: Array = []
	for kind: String in xf_by:
		var list: Array = xf_by[kind]
		if list.is_empty():
			continue
		if not CAR_SHAPES.has(kind) or kind == "truck":   # (motorbikes: small, and few)
			_chunked(_parked_mesh(kind), list, PARKED_SEEN, cols_by[kind], null, true, true, PARKED_CELL)
			continue
		_chunked(_parked_mesh(kind), list, PARKED_NEAR, cols_by[kind], null, true, true, PARKED_CELL)
		var sc := _far_scale(kind)
		for i in range(list.size()):
			var t: Transform3D = list[i]
			far_xf.append(Transform3D(t.basis * Basis.from_scale(sc), t.origin))
			far_cols.append(cols_by[kind][i])
	if not far_xf.is_empty():
		_chunked(_parked_far_mesh(), far_xf, PARKED_SEEN, far_cols, null, false, true, PARKED_CELL,
			PARKED_NEAR + PARKED_CELL * 0.71)

## a kind's size against the sedan's, the plain shape's (across, up, along)
func _far_scale(kind: String) -> Vector3:
	var a: Array = CAR_SHAPES[kind]
	var b: Array = CAR_SHAPES["sedan"]
	var top := func(sh: Array) -> float:
		var t := 0.0
		for p: Vector2 in sh[1]:
			t = maxf(t, p.y)
		return t + (0.08 if sh == CAR_SHAPES["suv"] or sh == CAR_SHAPES["van"] else 0.0)
	return Vector3(float(a[2]) / float(b[2]), float(top.call(a)) / float(top.call(b)), float(a[3]) / float(b[3]))

## The parked car seen from afar: the sedan's two side outlines (CAR_SHAPES) pushed across its
## width -- the body in paint, the cabin's sides and ends glass and its roof paint -- and four
## blocks of tyre: some 60 triangles, the same outline and the same part codes for CAR_SHADER
## (the paint comes from each car's own colour, as the full car's does).
var _car_far: ArrayMesh
func _parked_far_mesh() -> ArrayMesh:
	if _car_far != null:
		return _car_far
	var shape: Array = CAR_SHAPES["sedan"]
	var hw: float = shape[2]
	var wz: float = shape[4]
	var wr: float = shape[5]
	var cm := CarMesh.new()
	var paint := Color(1, 1, 1, 1.0)
	var glass := Color(_tone["carglass"], 0.75)
	_far_prism(cm, PackedVector2Array(shape[0]), hw * 0.98, paint, paint, paint)
	_far_prism(cm, PackedVector2Array(shape[1]), hw * 0.84, glass, glass, paint)
	var tyres := Buf.new()
	for sx: float in [-1.0, 1.0]:
		for sz: float in [-1.0, 1.0]:
			_box(tyres, Vector3(sx * (hw - 0.2), wr, sz * wz), Vector3(0.22, wr * 2.0, wr * 2.0))
	cm.add_buf(tyres, Color(_tone["tyre"], 0.3))
	_car_far = cm.mesh(_car_material())
	_car_far.custom_aabb = _car_far.get_aabb().grow(0.1)
	return _car_far

## a side outline (x along the car, y up) pushed `half` either side of the middle: its two
## faces in `side`, its edges in `edge`, the highest edge (a cabin's roof) in `roof`
func _far_prism(cm: CarMesh, outline: PackedVector2Array, half: float, side: Color, edge: Color, roof: Color) -> void:
	var idx := Geometry2D.triangulate_polygon(outline)
	for sx: float in [-1.0, 1.0]:
		var nrm := Vector3(sx, 0, 0)
		var base := cm.v.size()
		for p: Vector2 in outline:
			cm.vert(Vector3(sx * half, p.y, p.x), nrm, side)
		for i in range(0, idx.size(), 3):
			cm.tri(base + idx[i], base + idx[i + 1], base + idx[i + 2], nrm)
	var mid := Vector2.ZERO
	for p: Vector2 in outline:
		mid += p
	mid /= outline.size()
	var top := -1
	var top_y := -INF
	for i in range(outline.size()):
		var y := (outline[i].y + outline[(i + 1) % outline.size()].y) * 0.5
		if y > top_y:
			top_y = y
			top = i
	for i in range(outline.size()):
		var a := outline[i]
		var b := outline[(i + 1) % outline.size()]
		if a.distance_to(b) < 0.001:
			continue
		var d := (b - a).normalized()
		var n2 := Vector2(-d.y, d.x)
		if n2.dot((a + b) * 0.5 - mid) < 0.0:
			n2 = -n2
		var nrm := Vector3(0, n2.y, n2.x)
		var col := roof if i == top else edge
		var i0 := cm.vert(Vector3(-half, a.y, a.x), nrm, col)
		var i1 := cm.vert(Vector3(half, a.y, a.x), nrm, col)
		var i2 := cm.vert(Vector3(half, b.y, b.x), nrm, col)
		var i3 := cm.vert(Vector3(-half, b.y, b.x), nrm, col)
		cm.tri(i0, i1, i2, nrm)
		cm.tri(i0, i2, i3, nrm)

func _parked_mesh(kind := "sedan") -> ArrayMesh:
	if _car_meshes.has(kind):
		return _car_meshes[kind]
	if kind == "bus":
		return _bus_mesh()
	if kind == "moto":
		return _moto_mesh()
	if kind == "moto_parked":
		return _moto_mesh(false)
	if kind == "truck":
		return _truck_mesh()
	var taxi := kind == "taxi"
	var cm := _car_body("sedan" if taxi else kind, true)
	if taxi:
		# the roof sign: yellow, מונית on it front and back, lit at night (CAR_SHADER's
		# signs; UV2 its middle)
		var sign := Buf.new()
		_box(sign, Vector3(0, 1.52, -0.3), Vector3(0.62, 0.17, 0.26))
		cm.add_buf(sign, Color(1, 1, 1, 0.58), Vector2(0.0, 1.52))
	var am := cm.mesh(_car_material())
	# a box round the whole car (lights and mirrors stand a little proud of the body)
	am.custom_aabb = am.get_aabb().grow(0.1)
	_car_meshes[kind] = am
	return am

## where a car's front passenger door hangs: (the body's half-width there, the hinge's z: the
## seam behind the front wheel, as CAR_SHADER draws it -- the doorway runs back to the pillar,
## at -0.19 of the wheels' z)
func _door_at(kind: String) -> Vector2:
	var shape: Array = CAR_SHAPES["sedan" if kind == "taxi" else kind]
	var zf: float = float(shape[4]) - float(shape[5]) - 0.14
	return Vector2(_plan_w(zf, shape[2], shape[3]), zf)

## a car's front passenger door, open (traffic.gd's kerb car): its hinge at the origin, the
## door running back along -Z, its outside facing -X -- the painted skin to the waist, the trim
## of its inside, the window leaning in as the cabin's glass does. In the car shader.
var _door_meshes := {}

func _door_mesh(kind: String) -> ArrayMesh:
	var k := "sedan" if kind == "taxi" else kind
	if _door_meshes.has(k):
		return _door_meshes[k]
	var shape: Array = CAR_SHAPES[k]
	var low := PackedVector2Array(shape[0])
	var cab: Array = shape[1]
	var wz: float = shape[4]
	var dz := _door_at(k)
	var long := dz.y + 0.19 * wz
	var lift := 0.08 if k in ["suv", "van"] else (0.05 if k == "mpv" else 0.0)
	var sill := 0.3 + lift
	var waist := _span_at(low, dz.y - long * 0.5).y
	var top := minf((cab[1] as Vector2).y, (cab[2] as Vector2).y) - 0.06
	var cm := CarMesh.new()
	var paint := Color(1, 1, 1, 1.0)
	var b := Buf.new()
	_box(b, Vector3(-0.015, (sill + waist) * 0.5, -long * 0.5), Vector3(0.05, waist - sill, long))
	cm.add_buf(b, paint)
	var t := Buf.new()   # its inside: the door card, an armrest
	_box(t, Vector3(0.02, (sill + waist) * 0.5 + 0.02, -long * 0.5), Vector3(0.03, waist - sill - 0.08, long - 0.08))
	_box(t, Vector3(0.05, waist - 0.2, -long * 0.55), Vector3(0.05, 0.04, long * 0.5))
	cm.add_buf(t, Color(_tone["cartrim"], 0.5))
	# the window: leaning in 0.22 m over its height, glass both sides, a thin frame along its top
	var lean := 0.22 * (top - waist) / maxf((cab[1] as Vector2).y - waist, 0.3)
	var glass := Color(_tone["carglass"], 0.75)
	var z0 := -0.03
	var z1 := -long + 0.03
	for side: float in [-1.0, 1.0]:
		var n := Vector3(side, (top - waist) * 0.0 + 0.2 * -side, 0).normalized()
		var off := side * 0.006
		var p0 := cm.vert(Vector3(off, waist, z0), n, glass)
		var p1 := cm.vert(Vector3(off, waist, z1), n, glass)
		var p2 := cm.vert(Vector3(lean + off, top, z1 + 0.08), n, glass)
		var p3 := cm.vert(Vector3(lean + off, top, z0 - 0.12), n, glass)
		cm.tri(p0, p1, p2, Vector3(side, 0, 0))
		cm.tri(p0, p2, p3, Vector3(side, 0, 0))
	var f := Buf.new()
	_box(f, Vector3(lean, top + 0.015, (z0 - 0.12 + z1 + 0.08) * 0.5), Vector3(0.03, 0.03, long - 0.2))
	cm.add_buf(f, paint)
	var am := cm.mesh(_car_material())
	_door_meshes[k] = am
	return am

## ---- car bodies ----------------------------------------------------------------------------
## A car is built from its side profile (CAR_SHAPES) as two lofts with smooth normals. The
## lower body is a rounded cross-section at each of a run of stations from the back to the
## front, between the outline's bottom (the sills, the bumpers' curve) and its top (boot,
## waist, bonnet), narrowing at the corners in plan; the cabin is a second loft from the
## waist to the roof line, the windscreen and rear window its sloped ends, the pillars and the
## roof rail in paint. So the light rolls over the shoulders, the bonnet and the roof instead
## of breaking at flat sides. One indexed surface per car shape: each part (paint, glass,
## trim, tyres, rims, lights, plates) is told apart by its vertex colour's alpha, for
## CAR_SHADER, and the lower body's UV2 carries the wheels' place and size so the shader can
## darken the wheel wells and draw the door seams.
const CAR_CORNER := 0.45             ## the plan's corner radius, front and back (m)

class CarMesh:
	var v := PackedVector3Array()
	var n := PackedVector3Array()
	var c := PackedColorArray()
	var uv := PackedVector2Array()
	var uv2 := PackedVector2Array()
	var idx := PackedInt32Array()

	func vert(p: Vector3, nrm: Vector3, col: Color, t := Vector2.ZERO, t2 := Vector2.ZERO) -> int:
		v.append(p)
		n.append(nrm)
		c.append(col)
		uv.append(t)
		uv2.append(t2)
		return v.size() - 1

	## a triangle facing `out` (Godot's front faces are clockwise: the winding is fixed to match)
	func tri(a: int, b: int, d: int, out: Vector3) -> void:
		if (v[b] - v[a]).cross(v[d] - v[a]).dot(out) > 0.0:
			idx.append_array([a, d, b])
		else:
			idx.append_array([a, b, d])

	## a Buf's triangle soup as it is, in one colour (boxes: lights, trim)
	func add_buf(b: Buf, col: Color, t2 := Vector2.ZERO) -> void:
		for i in range(b.v.size()):
			idx.append(vert(b.v[i], b.n[i], col, b.uv[i] if i < b.uv.size() else Vector2.ZERO, t2))

	func mesh(m: Material) -> ArrayMesh:
		var a := []
		a.resize(Mesh.ARRAY_MAX)
		a[Mesh.ARRAY_VERTEX] = v
		a[Mesh.ARRAY_NORMAL] = n
		a[Mesh.ARRAY_COLOR] = c
		a[Mesh.ARRAY_TEX_UV] = uv
		a[Mesh.ARRAY_TEX_UV2] = uv2
		a[Mesh.ARRAY_INDEX] = idx
		var am := ArrayMesh.new()
		am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, a)
		am.surface_set_material(0, m)
		return am

## the side outline cut straight down at z: (its bottom, its top)
func _span_at(outline: PackedVector2Array, z: float) -> Vector2:
	var lo := INF
	var hi := -INF
	for i in range(outline.size()):
		var a := outline[i]
		var b := outline[(i + 1) % outline.size()]
		if a.x == b.x or (a.x - z) * (b.x - z) > 0.0:
			continue
		var y := lerpf(a.y, b.y, (z - a.x) / (b.x - a.x))
		lo = minf(lo, y)
		hi = maxf(hi, y)
	return Vector2(lo, hi) if lo <= hi else Vector2(0.5, 0.5)

## the side outline cut across at height y: its front (or back) end
func _end_at(outline: PackedVector2Array, y: float, front: bool) -> float:
	var best := -INF if front else INF
	for i in range(outline.size()):
		var a := outline[i]
		var b := outline[(i + 1) % outline.size()]
		if a.y == b.y or (a.y - y) * (b.y - y) > 0.0:
			continue
		var z := lerpf(a.x, b.x, (y - a.y) / (b.y - a.y))
		best = maxf(best, z) if front else minf(best, z)
	return best

## the body's half-width at z: full along the sides, rounding off at the four corners
func _plan_w(z: float, hw: float, hl: float) -> float:
	var d := absf(z) - (hl - CAR_CORNER)
	if d <= 0.0:
		return hw
	return hw - CAR_CORNER + sqrt(maxf(CAR_CORNER * CAR_CORNER - d * d, 0.0))

## how far the rounded corner pulls the front (or back) in at x off the middle
func _plan_in(x: float, hw: float) -> float:
	var d := absf(x) - (hw - CAR_CORNER)
	if d <= 0.0:
		return 0.0
	return CAR_CORNER - sqrt(maxf(CAR_CORNER * CAR_CORNER - d * d, 0.0))

## A loft through rings of points (one per station, the same count each), normals smoothed
## over the grid and turned away from each station's middle; `part.call(i, j)` colours the
## quad from station i, ring point j. A vertex is shared by the quads of one part only, so
## glass and paint keep their own edges.
func _loft(cm: CarMesh, rings: Array, mids: PackedVector3Array, closed: bool, part: Callable, t2: Vector2,
		glass_t2 := Vector2.ZERO) -> void:
	var count := rings.size()
	var m: int = (rings[0] as PackedVector3Array).size()
	var nrm: Array = []
	for i in range(count):
		var ring: PackedVector3Array = rings[i]
		var prev: PackedVector3Array = rings[maxi(i - 1, 0)]
		var next: PackedVector3Array = rings[mini(i + 1, count - 1)]
		var nr := PackedVector3Array()
		for j in range(m):
			var jp := (j + 1) % m if closed else mini(j + 1, m - 1)
			var jm := (j - 1 + m) % m if closed else maxi(j - 1, 0)
			var nn := (ring[jp] - ring[jm]).cross(next[j] - prev[j])
			if nn.length_squared() < 1e-12:
				nn = ring[j] - mids[i]
			nn = nn.normalized()
			if nn.dot(ring[j] - mids[i]) < 0.0:
				nn = -nn
			nr.append(nn)
		nrm.append(nr)
	var made := {}
	for i in range(count - 1):
		for j in range(m if closed else m - 1):
			var j1 := (j + 1) % m
			var col: Color = part.call(i, j)
			var pid := int(round(col.a * 100.0))
			var q: Array = []
			for ij: Vector2i in [Vector2i(i, j), Vector2i(i + 1, j), Vector2i(i + 1, j1), Vector2i(i, j1)]:
				var key := (ij.x * 1000 + ij.y) * 1000 + pid
				if not made.has(key):
					made[key] = cm.vert((rings[ij.x] as PackedVector3Array)[ij.y], (nrm[ij.x] as PackedVector3Array)[ij.y], col, Vector2.ZERO,
						glass_t2 if pid == 75 else t2)
				q.append(made[key])
			var out: Vector3 = ((rings[i] as PackedVector3Array)[j] + (rings[i + 1] as PackedVector3Array)[j1]) * 0.5 - (mids[i] + mids[i + 1]) * 0.5
			cm.tri(q[0], q[1], q[2], out)
			cm.tri(q[0], q[2], q[3], out)

## A car body of a CAR_SHAPES kind, facing +Z, its wheels on y = 0. `extras`: the wheels,
## lights and number plates too (the player's car has its own, which turn and light up).
func _car_body(kind: String, extras: bool) -> CarMesh:
	var shape: Array = CAR_SHAPES[kind]
	var low := PackedVector2Array(shape[0])
	var cab: Array = shape[1]
	var hw: float = shape[2]
	var hl: float = shape[3]
	var wz: float = shape[4]
	var wr: float = shape[5]
	var lift := 0.08 if kind in ["suv", "van"] else (0.05 if kind == "mpv" else (0.12 if kind == "truck" else 0.0))
	var cm := CarMesh.new()
	var paint := Color(1, 1, 1, 1.0)
	var glass := Color(_tone["carglass"], 0.75)
	var trim := Color(_tone["cartrim"], 0.5)
	var wheels := Vector2(wz, wr)
	var zmin := INF
	var zmax := -INF
	for p in low:
		zmin = minf(zmin, p.x)
		zmax = maxf(zmax, p.x)
	# ---- the lower body: 16 stations, closer together toward the ends where it curves
	var rings: Array = []
	var mids := PackedVector3Array()
	var stations := 16
	for i in range(stations):
		var z := lerpf(zmin + 0.004, zmax - 0.004, 0.5 - 0.5 * cos(PI * i / (stations - 1)))
		var sp := _span_at(low, z)
		var yb := sp.x
		var yt := sp.y
		var h := maxf(yt - yb, 0.001)
		var w := _plan_w(z, hw, hl)
		var half: Array = [Vector2(0.0, yb), Vector2(w - 0.12, yb), Vector2(w - 0.03, yb + minf(0.07, h * 0.25)),
			Vector2(w, yb + h * 0.45), Vector2(w - 0.025, yt - minf(0.09, h * 0.25)),
			Vector2(w - 0.09, yt - minf(0.012, h * 0.05)), Vector2(w * 0.55, yt + 0.025), Vector2(0.0, yt + 0.035)]
		var ring := PackedVector3Array()
		for p: Vector2 in half:
			ring.append(Vector3(p.x, p.y, z))
		for k in range(half.size() - 2, 0, -1):
			ring.append(Vector3(-(half[k] as Vector2).x, (half[k] as Vector2).y, z))
		rings.append(ring)
		mids.append(Vector3(0.0, (yb + yt) * 0.5, z))
	_loft(cm, rings, mids, true, func(_i: int, _j: int) -> Color: return paint, wheels)
	# ---- the cabin, from the waist to the roof line
	var c0: Vector2 = cab[0]   # windscreen foot
	var c1: Vector2 = cab[1]   # windscreen top
	var c2: Vector2 = cab[2]   # rear top
	var c3: Vector2 = cab[3]   # rear foot
	var pillars: Array = [-0.26] if kind in ["sedan", "hatch"] else ([-0.32] if kind == "mini" else [-0.2, -1.25])
	var zs: Array = []
	for k in range(9):
		zs.append(lerpf(c3.x, c0.x, k / 8.0))
	zs.append_array([c1.x, c2.x])
	for pz: float in pillars:
		zs.append_array([pz - 0.06, pz + 0.06])
	var back_pillar := c2.x + 0.05 if kind in ["sedan", "hatch", "mini"] else c3.x + 0.18
	zs.append(back_pillar)
	zs.sort()
	var cz: Array = []
	for z: float in zs:
		if cz.is_empty() or z - float(cz[-1]) > 0.01:
			cz.append(clampf(z, c3.x, c0.x))
	var roof := func(z: float) -> float:
		if z >= c1.x:
			return lerpf(c1.y, c0.y, inverse_lerp(c1.x, c0.x, z))
		if z >= c2.x:
			return lerpf(c2.y, c1.y, inverse_lerp(c2.x, c1.x, z))
		return lerpf(c3.y, c2.y, inverse_lerp(c3.x, c2.x, z))
	rings = []
	mids = PackedVector3Array()
	for z: float in cz:
		var yb := _span_at(low, z).y
		var top := maxf(float(roof.call(z)), yb + 0.004)
		var w := _plan_w(z, hw, hl)
		var wb := w - 0.05
		var wt := w - 0.27
		var gh: Array = [Vector2(wb, yb - 0.01), Vector2(wt, maxf(yb, top - 0.05)), Vector2(wt - 0.07, top), Vector2(0.0, top + 0.02)]
		var ring := PackedVector3Array()
		for p: Vector2 in gh:
			ring.append(Vector3(p.x, p.y, z))
		for k in range(gh.size() - 2, -1, -1):
			ring.append(Vector3(-(gh[k] as Vector2).x, (gh[k] as Vector2).y, z))
		rings.append(ring)
		mids.append(Vector3(0.0, yb - 0.3, z))
	var cab_part := func(i: int, j: int) -> Color:
		var zc := (float(cz[i]) + float(cz[i + 1])) * 0.5
		if j == 1 or j == 4:
			return paint                      # the roof rail, the A- and C-pillars' edges
		if j == 2 or j == 3:
			return glass if (zc > c1.x or zc < c2.x) else paint   # windscreen, rear window / roof
		if zc < back_pillar:
			return paint
		for pz: float in pillars:
			if absf(zc - pz) < 0.06:
				return paint                  # the B-pillar (an SUV's and a van's C too)
		return glass
	# the glass carries where the front seats are -- just behind the windscreen's foot, the
	# cushion a little under the waist -- for the shader's people
	var seats := Vector2(c0.x - (0.75 if kind == "truck" else (1.3 if kind in ["suv", "van", "mpv"] else 1.15)), _span_at(low, c0.x).y - 0.45)
	_loft(cm, rings, mids, false, cab_part, Vector2.ZERO, seats)
	# ---- trim: bumper lips, the grille, mirrors, door handles
	var tb := Buf.new()
	var zf := _end_at(low, 0.4 + lift, true)
	var zr := _end_at(low, 0.4 + lift, false)
	_box(tb, Vector3(0, 0.32 + lift, zf - 0.07), Vector3((hw - 0.2) * 2.0, 0.1, 0.16))
	_box(tb, Vector3(0, 0.32 + lift, zr + 0.07), Vector3((hw - 0.2) * 2.0, 0.1, 0.16))
	var gy := 0.58 + lift
	_box(tb, Vector3(0, gy, _end_at(low, gy, true) - 0.025), Vector3(0.72, 0.13, 0.06))
	for sx: float in [-1.0, 1.0]:
		for hz: float in ([c0.x - 0.42] if kind == "truck" else [c0.x - 0.42, float(pillars[0]) - 0.4]):
			var hy := _span_at(low, hz).y - 0.11
			_box(tb, Vector3(sx * (_plan_w(hz, hw, hl) + 0.004), hy, hz), Vector3(0.02, 0.035, 0.15))
	cm.add_buf(tb, trim)
	var mb := Buf.new()
	for sx: float in [-1.0, 1.0]:
		_box(mb, Vector3(sx * (hw + 0.07), c0.y + 0.08, c0.x - 0.14), Vector3(0.15, 0.1, 0.08))
	cm.add_buf(mb, paint)
	if not extras:
		return cm
	# ---- wiper arms at the windscreen's foot, a shark-fin aerial at the roof's back, roof
	# rails on an SUV and an estate
	var fit := Buf.new()
	var ws := func(y: float) -> float:   # the windscreen's surface at height y
		return lerpf(c0.x, c1.x, clampf((y - c0.y) / maxf(c1.y - c0.y, 0.01), 0.0, 1.0))
	if kind != "truck":
		for sx: float in [-1.0, 1.0]:
			var wy := c0.y + 0.04
			_box(fit, Vector3(sx * 0.27 - 0.08, wy, float(ws.call(wy)) + 0.02), Vector3(0.5, 0.018, 0.022))
		if kind in ["sedan", "hatch", "mini", "wagon", "suv"]:
			_box(fit, Vector3(0, c2.y + 0.04, c2.x + 0.28), Vector3(0.05, 0.07, 0.17))
		if kind in ["suv", "wagon"]:
			for sx: float in [-1.0, 1.0]:
				_box(fit, Vector3(sx * (hw - 0.36), maxf(c1.y, c2.y) + 0.06, (c1.x + c2.x) * 0.5), Vector3(0.035, 0.035, absf(c1.x - c2.x) + 0.3))
				for foot: float in [c1.x - 0.05, c2.x + 0.05]:
					_box(fit, Vector3(sx * (hw - 0.36), maxf(c1.y, c2.y) + 0.03, foot), Vector3(0.05, 0.05, 0.08))
	cm.add_buf(fit, trim)
	if kind in ["sedan", "hatch", "mini", "wagon", "suv"]:
		# a learner's roof sign, a new driver's in the back window, a parking permit on the
		# windscreen: kept only on the cars the shader picks (vertex())
		var top := maxf(c1.y, c2.y)
		var lz := (c1.x + c2.x) * 0.5
		var lb := Buf.new()
		_box(lb, Vector3(0, top + 0.12, lz), Vector3(0.4, 0.22, 0.07))
		cm.add_buf(lb, Color(_real_col("red"), 0.52), Vector2(0.0, top + 0.12))
		var ry := lerpf(c3.y, c2.y, 0.32)
		var rz := lerpf(c3.x, c2.x, 0.32) - 0.04
		var nb := Buf.new()
		_box(nb, Vector3(0.36, ry, rz), Vector3(0.27, 0.13, 0.01))
		cm.add_buf(nb, Color(1, 1, 1, 0.54), Vector2(0.36, ry))
		var py := c0.y + 0.09
		var pb := Buf.new()
		_box(pb, Vector3(-(hw - 0.42), py, float(ws.call(py)) + 0.025), Vector3(0.09, 0.07, 0.006))
		cm.add_buf(pb, Color(1, 1, 1, 0.56), Vector2(-(hw - 0.42), py))
	# ---- wheels: tyres, their sidewalls, five-spoke rims (just proud of the body, in the
	# dark wells the shader paints round them)
	var tyre := Color(_tone["tyre"], 0.3)
	var rim := Color(_tone["rim"], 0.4)
	for wzs: float in [wz, -wz]:
		for sx: float in [-1.0, 1.0]:
			# (UV2: the wheel's middle, which the shader turns the front ones about as it steers)
			_wheel(cm, Vector3(sx * (hw - 0.09), wr, wzs), wr, sx, tyre, rim, 0.11, false, Vector2(sx * (hw - 0.09), wzs))
	# ---- lights: panels laid on the body's front and back, following its rounded corners
	# (UV2 x 1: drawn as a car's lamps, the indicators in them -- CAR_SHADER)
	var hy := 0.68 + lift
	var ty := _span_at(low, zmin + 0.12).y - 0.15
	for sx: float in [-1.0, 1.0]:
		_lamp(cm, low, hw, sx * (hw - 0.3), hy, 0.36, 0.12, true, Color(_tone["tank"], 0.1), Vector2(1, 0))
		_lamp(cm, low, hw, sx * (hw - 0.27), ty, 0.32, 0.14, false, Color(_tone["tank"], 0.0), Vector2(1, 0))
	# the indicators' repeaters on the door mirrors, and the third brake light at the top of
	# the rear window (UV2 x 2)
	var rb := Buf.new()
	for sx: float in [-1.0, 1.0]:
		_box(rb, Vector3(sx * (hw + 0.115), c0.y + 0.055, c0.x - 0.098), Vector3(0.05, 0.016, 0.006))
	cm.add_buf(rb, Color(_tone["tank"], 0.1), Vector2(2, 0))
	if kind != "truck":
		var by := c2.y - 0.05
		var bz := lerpf(c3.x, c2.x, clampf((by - 0.02 - c3.y) / maxf(c2.y - c3.y, 0.01), 0.0, 1.0)) - 0.015
		var bb := Buf.new()
		_box(bb, Vector3(0, by, bz), Vector3(0.34, 0.03, 0.012))
		cm.add_buf(bb, Color(_tone["tank"], 0.0), Vector2(2, 0))
	var plate := Color(Palette.col("warn") if String(_place.get("look", "")) == "med" else Palette.col("ink"), 0.65)
	for front: bool in [true, false]:
		var py := (0.45 if front else 0.6) + lift
		var pz := _end_at(low, py, front) + (0.012 if front else -0.012)
		var s := 1.0 if front else -1.0
		var a := cm.vert(Vector3(-0.26 * s, py - 0.06, pz), Vector3(0, 0, s), plate, Vector2(0, 1))
		var b := cm.vert(Vector3(0.26 * s, py - 0.06, pz), Vector3(0, 0, s), plate, Vector2(1, 1))
		var d := cm.vert(Vector3(0.26 * s, py + 0.06, pz), Vector3(0, 0, s), plate, Vector2(1, 0))
		var e := cm.vert(Vector3(-0.26 * s, py + 0.06, pz), Vector3(0, 0, s), plate, Vector2(0, 0))
		cm.tri(a, b, d, Vector3(0, 0, s))
		cm.tri(a, d, e, Vector3(0, 0, s))
	return cm

## a light panel w x h centred at (cx, cy) on the body's front (or back), each corner set on
## the rounded surface (a hair proud of it), so it bends round the corner as real ones do
func _lamp(cm: CarMesh, low: PackedVector2Array, hw: float, cx: float, cy: float, w: float, h: float, front: bool, col: Color,
		t2 := Vector2.ZERO) -> void:
	var s := 1.0 if front else -1.0
	var grid: Array = []
	# (2.5 cm proud of the body, five points across to follow its curve: at 8 mm and three
	# points the body bulged through between them and the two fought for the pixels, the lamp
	# a speckle of red on white -- worst on a phone's coarser depth buffer)
	for row in range(2):
		var y := cy + (float(row) - 0.5) * h
		var line: Array = []
		for k in range(5):
			var x := cx + (float(k) - 2.0) * w * 0.25
			var z := _end_at(low, y, front) - s * (_plan_in(x, hw) - 0.025)
			var nrm := Vector3(x / hw * 0.7, 0.1, s).normalized()
			# (UV for CAR_SHADER's lamps: x 0 at the inner end to 1 at the outer, y 0 low to 1 high)
			var u := float(k) / 4.0 if cx > 0.0 else 1.0 - float(k) / 4.0
			line.append(cm.vert(Vector3(x, y, z), nrm, col, Vector2(u, float(row)), t2))
		grid.append(line)
	var out := Vector3(cx / hw * 0.7, 0.1, s)
	for k in range(4):
		cm.tri(grid[0][k], grid[0][k + 1], grid[1][k + 1], out)
		cm.tri(grid[0][k], grid[1][k + 1], grid[1][k], out)

## a flat lamp w x h at c facing +Z (front) or -Z, with a car lamp's UV (x 0 inner to 1
## outer, y 0 low to 1 high) and UV2 x 1: drawn as a car's lamps, indicators and all (a bus's,
## a truck's box's)
func _lamp_quad(cm: CarMesh, c: Vector3, w: float, h: float, front: bool, col: Color) -> void:
	var s := 1.0 if front else -1.0
	var out := Vector3(0, 0, s)
	var q: Array = []
	for corner: Vector2 in [Vector2(-0.5, -0.5), Vector2(0.5, -0.5), Vector2(0.5, 0.5), Vector2(-0.5, 0.5)]:
		var u := 0.5 + corner.x * signf(c.x if c.x != 0.0 else 1.0)
		q.append(cm.vert(c + Vector3(corner.x * w, corner.y * h, 0.0), out, col, Vector2(u, corner.y + 0.5), Vector2(1, 0)))
	cm.tri(q[0], q[1], q[2], out)
	cm.tri(q[0], q[2], q[3], out)

## a tyre round the X axis at c, its outer side facing `side` (+1/-1): tread, sidewall, and the
## rim (UV: the disc's own -1..1, for the shader's spokes)
func _wheel(cm: CarMesh, c: Vector3, r: float, side: float, tyre: Color, rim: Color, half := 0.11,
		both := false, t2 := Vector2.ZERO) -> void:
	var seg := 10
	var rr := r * 0.62
	var out := Vector3(side, 0, 0)
	var tread: Array = []
	for k in range(seg + 1):
		var a := TAU * k / seg
		var dir := Vector3(0, cos(a), sin(a))
		tread.append([cm.vert(c + dir * r - out * half, dir, tyre, Vector2.ZERO, t2), cm.vert(c + dir * r + out * half, dir, tyre, Vector2.ZERO, t2),
			cm.vert(c + dir * r + out * half, out, tyre, Vector2.ZERO, t2), cm.vert(c + dir * rr + out * half, out, tyre, Vector2.ZERO, t2)])
	for k in range(seg):
		var a0: Array = tread[k]
		var a1: Array = tread[k + 1]
		var dir := Vector3(0, cos(TAU * (k + 0.5) / seg), sin(TAU * (k + 0.5) / seg))
		cm.tri(a0[0], a1[0], a1[1], dir)
		cm.tri(a0[0], a1[1], a0[1], dir)
		cm.tri(a0[2], a1[2], a1[3], out)
		cm.tri(a0[2], a1[3], a0[3], out)
	for o: Vector3 in ([out, -out] if both else [out]):
		var hub := cm.vert(c + o * (half - 0.004), o, rim, Vector2.ZERO, t2)
		var ring: Array = []
		for k in range(seg + 1):
			var a := TAU * k / seg
			ring.append(cm.vert(c + Vector3(0, cos(a), sin(a)) * rr + o * (half - 0.004), o, rim, Vector2(cos(a), sin(a)), t2))
		for k in range(seg):
			cm.tri(hub, ring[k], ring[k + 1], o)
		if both and o == -out:   # the far side's sidewall too (a scooter is seen from both)
			for k in range(seg):
				var a0 := TAU * k / seg
				var a1 := TAU * (k + 1) / seg
				var p0 := cm.vert(c + Vector3(0, cos(a0), sin(a0)) * r + o * half, o, tyre)
				var p1 := cm.vert(c + Vector3(0, cos(a1), sin(a1)) * r + o * half, o, tyre)
				var q0 := cm.vert(c + Vector3(0, cos(a0), sin(a0)) * rr + o * half, o, tyre)
				var q1 := cm.vert(c + Vector3(0, cos(a1), sin(a1)) * rr + o * half, o, tyre)
				cm.tri(p0, p1, q1, o)
				cm.tri(p0, q1, q0, o)

## parts [Buf, colour with the part code in alpha] as one surface in the car shader
func _car_parts_mesh(parts: Array) -> ArrayMesh:
	var one := Buf.new()
	for pair: Array in parts:
		var b: Buf = pair[0]
		one.v.append_array(b.v)
		one.n.append_array(b.n)
		one.uv.append_array(b.uv)
		one.uv2.append_array(b.uv2)
		for _i in range(b.v.size()):
			one.c.append(pair[1])
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, one.arrays())
	am.surface_set_material(0, _car_material())
	return am

## A city bus, 11.8 m: a rounded box -- the body in its colour below and above a band of
## windows all round, pillars between them, a big windscreen with the lit route sign over
## it, glazed doors on the kerb side (the car's -X), the air-conditioning box on the roof,
## the wheels in dark wells. One loft like the cars' (see _car_body), its ends flat faces
## in bands. Faces +Z.
func _bus_mesh() -> ArrayMesh:
	var cm := CarMesh.new()
	var hw := 1.25
	var hl := 5.9
	var rc := 0.3                       # the plan's corner radius
	var paint := Color(1, 1, 1, 1.0)
	var glass := Color(_tone["carglass"], 0.75)
	var trim := Color(_tone["cartrim"], 0.5)
	var wheels := Vector2(3.0, 0.5)     # (both axles' |z|, wheel radius): the wells
	var ys: Array = [0.32, 0.42, 1.0, 2.55, 2.9, 3.05]   # bottom, sill, window foot, top, roof edge, roof
	var pillars: Array = []
	for i in range(9):
		pillars.append(-hl + 0.7 + i * 1.32)
	var doors: Array = [Vector2(3.65, 4.85), Vector2(-0.9, 0.35)]
	var zs: Array = []
	for d: float in [0.0, 0.04, 0.1, 0.18, 0.3]:
		zs.append_array([-hl + d, hl - d])
	for pz: float in pillars:
		zs.append_array([pz - 0.06, pz + 0.06])
	for dz: Vector2 in doors:
		zs.append_array([dz.x, dz.y])
	zs.append_array([-hl + 0.6, hl - 0.6])
	zs.sort()
	var st: Array = []
	for z: float in zs:
		if st.is_empty() or z - float(st[-1]) > 0.01:
			st.append(z)
	var rings: Array = []
	var mids := PackedVector3Array()
	for z: float in st:
		var d := absf(z) - (hl - rc)
		var w := hw if d <= 0.0 else hw - rc + sqrt(maxf(rc * rc - d * d, 0.0))
		var half: Array = [Vector2(0.0, ys[0]), Vector2(w - 0.08, ys[0]), Vector2(w, ys[1]), Vector2(w, ys[2]),
			Vector2(w, ys[3]), Vector2(w, ys[4]), Vector2(w - 0.15, ys[5]), Vector2(0.0, float(ys[5]) + 0.02)]
		var ring := PackedVector3Array()
		for p: Vector2 in half:
			ring.append(Vector3(p.x, p.y, z))
		for k in range(half.size() - 2, 0, -1):
			ring.append(Vector3(-(half[k] as Vector2).x, (half[k] as Vector2).y, z))
		rings.append(ring)
		mids.append(Vector3(0.0, 1.6, z))
	var part := func(i: int, j: int) -> Color:
		var zc := (float(st[i]) + float(st[i + 1])) * 0.5
		var kerb := j >= 7
		var band := j if j < 7 else 13 - j   # the same band on either side
		for dz: Vector2 in doors:
			if kerb and zc > dz.x and zc < dz.y and (band == 2 or band == 3):
				return glass                  # the doors, glazed top to bottom
		if band == 3:
			if absf(zc) > hl - 0.45:
				return paint                  # the corners
			for pz: float in pillars:
				if absf(zc - pz) < 0.06:
					return paint
			return glass
		return trim if band <= 1 else paint
	_loft(cm, rings, mids, true, part, wheels)
	# the two ends: flat faces in bands -- bumper, panel, windscreen (rear window), route sign
	for front: bool in [true, false]:
		var z := hl if front else -hl
		var s := 1.0 if front else -1.0
		var w := hw - rc
		var bands: Array = [[ys[0], ys[1], trim], [ys[1], ys[2], paint], [ys[2], ys[3], glass],
			[ys[3], ys[4], Color(Palette.col("warn"), 0.1) if front else paint], [ys[4], ys[5], paint]]
		for b: Array in bands:
			var y0: float = b[0]
			var y1: float = b[1]
			var w0 := w - (0.08 if y0 <= float(ys[0]) else 0.0)
			var w1 := w - (0.15 if y1 >= float(ys[5]) else 0.0)
			var a := cm.vert(Vector3(-w0, y0, z), Vector3(0, 0, s), b[2])
			var bb := cm.vert(Vector3(w0, y0, z), Vector3(0, 0, s), b[2])
			var c := cm.vert(Vector3(w1, y1, z), Vector3(0, 0, s), b[2])
			var e := cm.vert(Vector3(-w1, y1, z), Vector3(0, 0, s), b[2])
			cm.tri(a, bb, c, Vector3(0, 0, s))
			cm.tri(a, c, e, Vector3(0, 0, s))
	# the roof's air conditioning, the mirrors on their arms
	var tb := Buf.new()
	_box(tb, Vector3(0, 3.2, -1.2), Vector3(1.6, 0.26, 2.8))
	for sx: float in [-1.0, 1.0]:
		_box(tb, Vector3(sx * (hw + 0.12), 2.15, hl - 0.25), Vector3(0.06, 0.4, 0.1))
	cm.add_buf(tb, trim)
	# lights low on the front, tall ones at the back (a car's lamps: the indicators in them),
	# a repeater on each side behind the front door
	var lamps := Buf.new()
	var tails := Buf.new()
	var reps := Buf.new()
	for sx: float in [-1.0, 1.0]:
		_box(lamps, Vector3(sx * (hw - 0.45), 0.62, hl + 0.004), Vector3(0.36, 0.14, 0.01))
		_box(tails, Vector3(sx * (hw - 0.22), 1.0, -hl - 0.004), Vector3(0.2, 0.42, 0.01))
		_lamp_quad(cm, Vector3(sx * (hw - 0.45), 0.62, hl + 0.012), 0.36, 0.14, true, Color(_tone["tank"], 0.1))
		_lamp_quad(cm, Vector3(sx * (hw - 0.22), 1.0, -hl - 0.012), 0.2, 0.42, false, Color(_tone["tank"], 0.0))
		_box(reps, Vector3(sx * (hw + 0.012), 1.0, hl - 2.2), Vector3(0.02, 0.07, 0.16))
	cm.add_buf(lamps, Color(_tone["cartrim"], 0.5))
	cm.add_buf(tails, Color(_tone["cartrim"], 0.5))
	cm.add_buf(reps, Color(_tone["tank"], 0.1), Vector2(2, 0))
	for wz: float in [wheels.x, -wheels.x]:
		for sx: float in [-1.0, 1.0]:
			_wheel(cm, Vector3(sx * (hw - 0.2), wheels.y, wz), wheels.y, sx, Color(_tone["tyre"], 0.3), Color(_tone["rim"], 0.4), 0.16)
	var am := cm.mesh(_car_material())
	am.custom_aabb = am.get_aabb().grow(0.1)
	_car_meshes["bus"] = am
	return am

## A scooter and its rider, 1.9 m, made of rounded pieces: two small spoked wheels, the
## body and the leg shield in its colour, a dark seat and floorboard, the handlebars, a lamp
## at each end; the rider in a dark jacket and trousers, arms out to the bars, a helmet
## with its visor. Faces +Z. Without `rider`: one parked on the pavement.
func _moto_mesh(rider := true) -> ArrayMesh:
	var cm := CarMesh.new()
	var paint := Color(1, 1, 1, 1.0)
	var trim := Color(_tone["cartrim"], 0.5)
	var jacket := Color(_tone["cartrim"].lerp(_tone["carglass"], 0.3), 0.5)
	var legs := Color(_tone["cartrim"].darkened(0.2), 0.5)
	var helmet := Color(_tone["mark"], 0.5)
	for wz: float in [0.62, -0.62]:
		_wheel(cm, Vector3(0, 0.25, wz), 0.25, 1.0, Color(_tone["tyre"], 0.3), Color(_tone["rim"], 0.4), 0.05, true)
	_blobm(cm, Vector3(0, 0.55, -0.32), Vector3(0.2, 0.2, 0.5), paint)            # the body over the back wheel
	_blobm(cm, Vector3(0, 0.62, 0.42), Vector3(0.22, 0.32, 0.07), paint)          # the leg shield
	_blobm(cm, Vector3(0, 0.44, 0.63), Vector3(0.08, 0.05, 0.2), paint)           # the front mudguard
	_blobm(cm, Vector3(0, 0.77, -0.3), Vector3(0.16, 0.06, 0.38), trim)           # the seat
	var tb := Buf.new()
	_box(tb, Vector3(0, 0.36, 0.08), Vector3(0.32, 0.06, 0.52))                   # the floorboard
	_box(tb, Vector3(0, 0.86, 0.5), Vector3(0.05, 0.46, 0.05))                    # the column
	_box(tb, Vector3(0, 1.08, 0.48), Vector3(0.62, 0.04, 0.04))                   # the bars
	cm.add_buf(tb, trim)
	_blobm(cm, Vector3(0, 0.98, 0.57), Vector3(0.07, 0.06, 0.03), Color(_tone["tank"], 0.1), 8, 4)
	_blobm(cm, Vector3(0, 0.62, -0.84), Vector3(0.07, 0.04, 0.03), Color(_tone["tank"], 0.0), 8, 4)
	# indicators either side, front and back (CAR_SHADER's repeaters: amber, lit as it blinks)
	var ib := Buf.new()
	for sx: float in [-1.0, 1.0]:
		_box(ib, Vector3(sx * 0.17, 0.95, 0.56), Vector3(0.05, 0.035, 0.035))
		_box(ib, Vector3(sx * 0.13, 0.64, -0.82), Vector3(0.05, 0.035, 0.035))
	cm.add_buf(ib, Color(_tone["tank"], 0.1), Vector2(2, 0))
	# the rider, leaning a little to the bars: a torso, arms bent at the elbow, knees up
	if rider:
		_moto_rider(cm, jacket, legs, helmet)
	var am := cm.mesh(_car_material())
	am.custom_aabb = am.get_aabb().grow(0.1)
	_car_meshes["moto" if rider else "moto_parked"] = am
	return am

func _moto_rider(cm: CarMesh, jacket: Color, legs: Color, helmet: Color) -> void:
	_limb(cm, Vector3(0, 0.98, -0.22), Vector3(0, 1.5, -0.06), 0.16, jacket)
	for sx: float in [-1.0, 1.0]:
		var shoulder := Vector3(sx * 0.18, 1.42, -0.07)
		var elbow := Vector3(sx * 0.26, 1.2, 0.17)
		var hand := Vector3(sx * 0.3, 1.1, 0.45)
		_limb(cm, shoulder, elbow, 0.06, jacket)
		_limb(cm, elbow, hand, 0.05, jacket)
		var hip := Vector3(sx * 0.11, 0.9, -0.2)
		var knee := Vector3(sx * 0.15, 0.93, 0.2)
		var foot := Vector3(sx * 0.14, 0.42, 0.2)
		_limb(cm, hip, knee, 0.08, legs)
		_limb(cm, knee, foot, 0.065, legs)
	_blobm(cm, Vector3(0, 1.66, 0.0), Vector3(0.13, 0.14, 0.14), helmet)          # the helmet
	_blobm(cm, Vector3(0, 1.64, 0.1), Vector3(0.1, 0.055, 0.06), Color(_tone["carglass"], 0.75), 8, 4)   # its visor

## A delivery truck, 6.8 m: a van's cab (CAR_SHAPES "truck", built like the cars) with a
## tall white box behind it, its back doors' seam and hinges. Faces +Z.
func _truck_mesh() -> ArrayMesh:
	var cm := _car_body("truck", true)
	var box := Buf.new()
	_box(box, Vector3(0, 2.13, -0.98), Vector3(2.3, 2.36, 4.8))
	cm.add_buf(box, Color(_tone["tank"], 0.5))
	var seam := Buf.new()
	_box(seam, Vector3(0, 2.13, -3.385), Vector3(0.03, 2.2, 0.02))
	for sx: float in [-1.0, 1.0]:
		for hy: float in [1.3, 2.9]:
			_box(seam, Vector3(sx * 1.05, hy, -3.385), Vector3(0.1, 0.06, 0.02))
	cm.add_buf(seam, Color(_tone["cartrim"], 0.5))
	# its tail lights on the box's back (the cab's own are behind the box), a car's lamps
	for sx: float in [-1.0, 1.0]:
		_lamp_quad(cm, Vector3(sx * 0.9, 0.82, -3.4), 0.34, 0.16, false, Color(_tone["tank"], 0.0))
	var am := cm.mesh(_car_material())
	am.custom_aabb = am.get_aabb().grow(0.1)
	_car_meshes["truck"] = am
	return am

## a limb from a to b: a long rounded piece, `rad` thick
func _limb(cm: CarMesh, a: Vector3, b: Vector3, rad: float, col: Color) -> void:
	var up := (b - a).normalized()
	var side := up.cross(Vector3.FORWARD if absf(up.z) < 0.9 else Vector3.RIGHT).normalized()
	var fwd := side.cross(up)
	_blobm(cm, (a + b) * 0.5, Vector3(rad, a.distance_to(b) * 0.5 + rad * 0.6, rad), col, 8, 5, Basis(side, up, fwd))

## a rounded blob (an ellipsoid at c with radii r, turned by `turn`), smooth, in one colour
func _blobm(cm: CarMesh, c: Vector3, r: Vector3, col: Color, seg := 10, rings := 6, turn := Basis()) -> void:
	var first := cm.v.size()
	for i in range(rings + 1):
		var th := PI * i / rings
		for j in range(seg + 1):
			var ph := TAU * j / seg
			var u := Vector3(sin(th) * cos(ph), cos(th), sin(th) * sin(ph))
			cm.vert(c + turn * (u * r), (turn * (u / r)).normalized(), col)
	for i in range(rings):
		for j in range(seg):
			var a := first + i * (seg + 1) + j
			var b := a + seg + 1
			var out: Vector3 = (cm.v[a] + cm.v[b + 1]) * 0.5 - c
			cm.tri(a, b, b + 1, out)
			cm.tri(a, b + 1, a + 1, out)

## a low cylinder lying along x (a wheel)
func _cyl_x(buf: Buf, c: Vector3, r: float, w: float, seg: int) -> void:
	for i in range(seg):
		var a0 := TAU * i / seg
		var a1 := TAU * (i + 1) / seg
		var p0 := Vector3(0, cos(a0) * r, sin(a0) * r)
		var p1 := Vector3(0, cos(a1) * r, sin(a1) * r)
		var hx := Vector3(w * 0.5, 0, 0)
		var nrm := Vector3(0, cos((a0 + a1) * 0.5), sin((a0 + a1) * 0.5))
		buf.tri(c + p0 - hx, c + p1 - hx, c + p1 + hx, nrm, Color.WHITE)
		buf.tri(c + p0 - hx, c + p1 + hx, c + p0 + hx, nrm, Color.WHITE)
		buf.tri(c - hx, c + p0 - hx, c + p1 - hx, Vector3.LEFT, Color.WHITE)
		buf.tri(c + hx, c + p0 + hx, c + p1 + hx, Vector3.RIGHT, Color.WHITE)

## a palm's crown: nine drooping fronds, one mesh
## many copies of one mesh, one MultiMeshInstance3D per square so far ones are not drawn,
## each drawn while the camera is within `range_end` of it. A multimesh is drawn whole or
## not at all, judged by the middle of its box, so the squares are sized to the range:
## 400 m squares for things seen 160 m off drew every parked car in a whole square, and
## none at all from near a corner of one. Optional per-copy colours. Shadows only where
## asked: the shadow map draws every caster again.
## ---- batching: the small things merged ---------------------------------------------------
## A street has dozens of kinds of small things -- sign plates and poles, lamp posts, power
## poles, racks, benches, balconies -- and as a multimesh each, every kind cost a draw call
## in every square of the map in view: hundreds in all. While the city is built, every
## kind that shares a material (most share one of a few: the poles' grey, the one vertex-
## coloured "kit" material) is instead copied, transformed, into ONE mesh per square per
## material and draw range. The copying is the engine's: a Transform3D times a packed array
## of vertices is a single call. Left out: whatever changes at night or moves (lamps, lit
## glass, flags, ads, the cars) and anything so numerous that copying it would be a lot of
## memory (the trees), which stay multimeshes.
var _batching := false
var _batches := {}
var _soups := {}
const BATCH_CELL := 400.0
const BATCH_RANGES := [140.0, 200.0, 270.0, 340.0, 460.0, 700.0, 1150.0]
const BATCH_VERTS := 650000          ## more than this in one call: left as a multimesh (trees, balconies)
## A kit of more vertices than this stays a multimesh however few: merged, every copy's vertices
## are written out (a 534-vertex tree trunk is 13 KB a copy merged, 64 bytes a copy as an
## instance). Tel Aviv's merged meshes held 16 M vertices, 9.6 M of them copies of kits --
## trunks 3.5 M, cats, terraces, bins -- most of its 505 MB of vertex buffers (perf_dive).
const BATCH_KIT_VERTS := 200

## ONE material for every merged mesh: a vertex either carries its colour (alpha 1: signs,
## kits, balconies) or the number of a tone of the palette (alpha 0, the number in red),
## looked up in a table the material holds -- so the asphalt, the grass, the poles and the
## paint of a square are one mesh and one draw, and a new palette is a new table.
## Each tone also has a surface (tone_fx: x patches, y grain, z slab size, w kind): grass
## mottled, asphalt grained and worn in patches, pavements in slabs. The big patches are
## worked out per pixel from the world position; the fine part is a photo (textures/, CC0
## from Poly Haven) for each kind -- asphalt, pavers, grass -- with its bumps. A photo is
## divided by its own average colour and multiplied by the tone, so the palette still sets
## the colour and the photo only adds the grit, cracks and joints. textured = 0 falls back
## to the cheap noise grain (the lowest web quality level).
const TONE_SHADER := """
shader_type spatial;
render_mode cull_back;
uniform int gone_n = 0;   // road signs bent by the car (_bend_sign): hidden here, a bent copy drawn
uniform vec4 gone[12];    // ... x, z of the pole, from what height, to what height
uniform float gone_r[12]; // ... and how far out its plate reaches
uniform vec4 tones[64] : source_color;
uniform vec4 tone_fx[64];
uniform float textured = 1.0;
uniform sampler2D asph_tex : filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D asph_nrm : filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D asph_big : filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D pave_tex : filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D pave_nrm : filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D grass_tex : filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D grass_nrm : filter_linear_mipmap_anisotropic, repeat_enable;
uniform vec3 asph_mean = vec3(0.5);   // each photo's average, as stored (TEX_MEAN)
uniform vec3 big_mean = vec3(0.5);
uniform vec3 pave_mean = vec3(0.5);
uniform vec3 grass_mean = vec3(0.5);
uniform float pave_m = 2.0;            // metres one pave_tex covers, for the pavement's slab size
uniform vec3 wear_col = vec3(0.3);     // what worn road paint shows through: the asphalt
varying vec3 wpos;
varying float wup;                     // how much the face looks up: the photos are laid from above
varying vec3 wnrm;                     // the face's way out, in the world (for the tags along a wall)
uniform vec4 tag_a : source_color;     // spray paint: four colours of the palette's
uniform vec4 tag_b : source_color;
uniform vec4 tag_c : source_color;
uniform vec4 tag_d : source_color;     // (and black, the commonest)
uniform sampler2D hmap : filter_nearest, repeat_disable;   // the ground's height grid (how high up a wall a pixel is)
uniform vec4 h_info = vec4(0.0, 0.0, 1.0, 0.0);
uniform ivec2 h_size = ivec2(1, 1);
// a photo's colour over its average: 1 on average, so the tone underneath keeps its colour
vec3 detail(vec3 t, vec3 mean, float k) { return mix(vec3(1.0), clamp(t / max(mean, vec3(0.002)), vec3(0.0), vec3(2.6)), k); }
// a normal map's (x, y), reconstructed to a unit normal: the compressed maps keep only x and y
vec3 unpack(vec2 rg, float k) {
	vec2 xy = (rg * 2.0 - 1.0) * k;
	return vec3(xy, sqrt(max(0.0, 1.0 - dot(xy, xy))));
}
float hash(vec2 p) {
	vec3 q = fract(vec3(p.xyx) * 0.1031);
	q += dot(q, q.yzx + 33.33);
	return fract((q.x + q.y) * q.z);
}
float noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
}
void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	for (int i = 0; i < gone_n; i++) {
		// what stands round a bent sign's pole, from knee height to its top: squashed onto
		// its stub (the pole's foot is left; a merged batch cannot leave one sign out)
		if (distance(wpos.xz, gone[i].xy) < gone_r[i] && wpos.y > gone[i].z && wpos.y < gone[i].w) {
			wpos = vec3(gone[i].x + (wpos.x - gone[i].x) * 0.05, gone[i].z, gone[i].y + (wpos.z - gone[i].y) * 0.05);
			VERTEX = (inverse(MODEL_MATRIX) * vec4(wpos, 1.0)).xyz;
		}
	}
	wnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
	wup = wnrm.y;
}
// A tired road crazes into small plates: where a noise says this stretch is old, the edges
// of a Voronoi pattern 45 cm across, a hairline as wide as a pixel allows. 1 where there is
// no crack, darker on one. Only near the eye: further off it is less than a pixel.
float crazing(vec2 p, float dist, float pxw) {
	float tired = smoothstep(0.7, 0.84, noise(p / 9.0 + 3.7)) * (1.0 - smoothstep(30.0, 55.0, dist));
	if (tired <= 0.0) {
		return 1.0;
	}
	vec2 gq = p / 0.45;
	vec2 gi = floor(gq);
	vec2 gf = gq - gi;
	float d1 = 9.0;
	float d2 = 9.0;
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			vec2 o = vec2(float(x), float(y));
			vec2 pt = o + vec2(hash(gi + o), hash(gi + o + 17.3)) * 0.9 + 0.05;
			float dd = length(gf - pt);
			if (dd < d1) {
				d2 = d1;
				d1 = dd;
			} else if (dd < d2) {
				d2 = dd;
			}
		}
	}
	float edge = (d2 - d1) * 0.22;   // metres to the crack
	// not every edge has cracked: some plates are still joined
	float open = step(0.35, hash(floor(gq + vec2(0.5)) + 41.0));
	float crack = 1.0 - smoothstep(0.0015, 0.0015 + pxw, edge);
	return 1.0 - 0.28 * crack * tired * open;
}
// cells of a Voronoi pattern round q: (distance to the nearest edge, in cells; that cell's id)
vec3 voro(vec2 q) {
	vec2 gi = floor(q);
	vec2 gf = q - gi;
	float d1 = 9.0;
	float d2 = 9.0;
	vec2 id = gi;
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			vec2 o = vec2(float(x), float(y));
			vec2 pt = o + vec2(hash(gi + o), hash(gi + o + 17.3)) * 0.8 + 0.1;
			float dd = length(gf - pt);
			if (dd < d1) {
				d2 = d1;
				d1 = dd;
				id = gi + o;
			} else if (dd < d2) {
				d2 = dd;
			}
		}
	}
	return vec3((d2 - d1) * 0.5, id);
}
float ground_y(vec2 p) {   // as the game's _h (the grid's triangles), with _g3's lift
	if (h_info.w < 0.5) { return 0.0; }
	float fx = clamp((p.x - h_info.x) / h_info.z, 0.0, float(h_size.x) - 1.001);
	float fz = clamp((p.y - h_info.y) / h_info.z, 0.0, float(h_size.y) - 1.001);
	int i = int(fx);
	int j = int(fz);
	float ax = fx - float(i);
	float az = fz - float(j);
	float h00 = texelFetch(hmap, ivec2(i, j), 0).r;
	float h10 = texelFetch(hmap, ivec2(i + 1, j), 0).r;
	float h01 = texelFetch(hmap, ivec2(i, j + 1), 0).r;
	float h11 = texelFetch(hmap, ivec2(i + 1, j + 1), 0).r;
	if (ax + az <= 1.0) { return h00 + (h10 - h00) * ax + (h01 - h00) * az + 0.07; }
	return h11 + (h01 - h11) * (1.0 - ax) + (h10 - h11) * (1.0 - az) + 0.07;
}
// Tags and stickers on a face that takes them (garden walls, poles, cabinets): in 2.6 m
// stretches along it, one in three a tag between knee and head height -- a scribble of
// wobbling strokes, or now and then bubble letters filled and outlined -- and in 0.45 m
// cells round shoulder height a sticker or two, pale, with a line of print on it.
vec3 graffiti(vec3 c, float dist) {
	vec2 along_dir = normalize(vec2(-wnrm.z, wnrm.x) + vec2(1e-5, 0.0));
	float u = dot(wpos.xz, along_dir);
	float face = floor(dot(wpos.xz, normalize(wnrm.xz + vec2(1e-5, 0.0))) * 1.5);
	float hgt = wpos.y - ground_y(wpos.xz);
	float fade = 1.0 - smoothstep(25.0, 45.0, dist);
	float cell = floor(u / 2.6);
	vec2 key = vec2(cell, face);
	if (hash(key + 3.1) < 0.33) {
		float x0 = (cell + 0.05 + 0.35 * hash(key + 1.7)) * 2.6;
		float w = 0.6 + 1.1 * hash(key + 2.3);
		float y0 = 0.1 + 0.45 * hash(key + 4.9);   // (low: most garden walls are knee to waist high)
		float hh = 0.2 + 0.25 * hash(key + 5.3);
		vec2 q = vec2((u - x0) / w, (hgt - y0) / hh);
		if (q.x > 0.0 && q.x < 1.0 && q.y > 0.0 && q.y < 1.0) {
			float pick = hash(key + 9.7);
			vec3 ink = pick < 0.45 ? tag_d.rgb : (pick < 0.65 ? tag_a.rgb : (pick < 0.82 ? tag_b.rgb : tag_c.rgb));
			float env = smoothstep(0.0, 0.12, q.y) * smoothstep(1.0, 0.82, q.y) * smoothstep(0.0, 0.04, q.x) * smoothstep(1.0, 0.96, q.x);
			vec2 pp = vec2(u, hgt);
			if (hash(key + 6.1) < 0.7) {   // a scribble
				float n = noise(pp * 5.0 + key * 7.0) * 0.6 + noise(pp * 13.0 + key) * 0.4;
				float k = 2.5 + 3.5 * hash(key + 8.1);
				float st = abs(fract(q.x * k * w + n * 1.4 + q.y * 0.6) - 0.5);
				float line = 1.0 - smoothstep(0.07, 0.11, st);
				c = mix(c, ink, line * env * fade * 0.92);
			} else {   // bubble letters: rounded, fat, side by side, a dark outline, some with a hole
				float nl = 3.0 + floor(hash(key + 8.3) * 3.0);
				float li = floor(q.x * nl);
				vec2 lp = vec2(fract(q.x * nl) - 0.5, q.y - 0.5) * vec2(w / nl, hh) / hh;
				float wob = (noise(vec2(u, hgt) * 9.0 + key) - 0.5) * 0.08;
				lp.y += sin(li * 1.7 + key.x) * 0.06;   // (letters bounce up and down a little)
				float sd = length(max(abs(lp) - vec2(0.12 + 0.05 * hash(vec2(li, key.x)), 0.22), 0.0)) - 0.14 + wob;
				float hole = hash(vec2(li, key.x + 4.0)) < 0.5 ? 1.0 - smoothstep(0.04, 0.06, length(lp - vec2(0.0, 0.06))) : 0.0;
				float fill = (1.0 - smoothstep(-0.01, 0.0, sd)) * (1.0 - hole);
				float edge = (1.0 - smoothstep(0.03, 0.04, sd)) * (1.0 - fill);
				c = mix(c, ink, fill * fade * 0.95);
				c = mix(c, tag_d.rgb, edge * fade * 0.9);
			}
		}
	}
	vec2 sc = floor(vec2(u, hgt) / 0.45);
	if (hgt > 0.9 && hgt < 1.9 && hash(sc + face + 2.2) < 0.12) {
		vec2 f = fract(vec2(u, hgt) / 0.45);
		vec2 lo = vec2(0.15 + 0.2 * hash(sc + 4.4), 0.2 + 0.2 * hash(sc + 5.5));
		vec2 hi = lo + vec2(0.25 + 0.2 * hash(sc + 6.6), 0.2 + 0.15 * hash(sc + 7.7));
		if (f.x > lo.x && f.x < hi.x && f.y > lo.y && f.y < hi.y) {
			float pick = hash(sc + 8.8);
			vec3 paper = pick < 0.5 ? vec3(0.92, 0.9, 0.85) : (pick < 0.75 ? tag_b.rgb * 0.5 + 0.45 : tag_a.rgb * 0.4 + 0.5);
			float row = step(0.45, fract((f.y - lo.y) / (hi.y - lo.y) * 3.0)) * step(0.2, (f.x - lo.x) / (hi.x - lo.x)) * step((f.x - lo.x) / (hi.x - lo.x), 0.8);
			c = mix(c, mix(paper, tag_d.rgb, row * 0.6), fade);
		}
	}
	return c;
}
void fragment() {
	vec3 c = COLOR.rgb;
	vec4 fx = vec4(0.0);
	float lay = 0.0;   // which way slabs are laid: a tone's spare green, 0..1 for 0..180 degrees
	if (COLOR.a < 0.02) {
		int i = int(COLOR.r * 63.0 + 0.5);
		c = tones[i].rgb;
		fx = tone_fx[i];
		lay = COLOR.g * 3.14159265;
	}
	// Texture lookups below sit in branches that differ from one triangle to the next, where
	// a GPU's own mip choice is undefined at the edges: so the slopes are taken here, where
	// every pixel runs, and handed to textureGrad.
	vec2 p = wpos.xz;
	vec2 dpx = dFdx(p);
	vec2 dpy = dFdy(p);
	vec3 bump = vec3(0.0, 0.0, 1.0);
	if (fx.x + fx.y > 0.0) {
		float near = clamp(1.0 - length(VERTEX) / 90.0, 0.0, 1.0);
		float big = noise(p / 11.0) * 0.6 + noise(p / 3.1) * 0.4;
		float shade = 1.0 + (big - 0.5) * fx.x * 2.0;
		if (fx.w > 0.5 && fx.w < 1.5) {   // grass and ground: drier, yellower patches here and there
			c = mix(c, c * vec3(1.12, 1.07, 0.8), smoothstep(0.56, 0.82, noise(p / 17.0 + 7.0)) * fx.x * 4.0);
		}
		// a wall or a kerb's face stays on the noise: laid from above, a photo runs down it in
		// streaks; kind 0 (a pole's top, a bench, a sign) has no photo at all
		if (fx.w > 3.5 && fx.w < 4.5) {   // kind 4: a wall of rough stones in mortar (garden walls)
			vec2 q = wup > 0.6 ? p : vec2(wpos.x + wpos.z, wpos.y * 1.3);
			vec3 vr = voro(q / 0.24);
			float pxc = (length(dpx) + length(dpy)) / 0.24;
			float mortar = 1.0 - smoothstep(0.04, 0.04 + pxc * 1.5, vr.x);
			c *= 0.84 + 0.3 * hash(vr.yz + 5.1);
			c = mix(c, c * 0.62 + vec3(0.04), mortar * near);
		} else if (textured > 0.5 && wup > 0.6 && fx.w > 0.5) {
			if (fx.w < 1.5) {   // grass, earth, sand: a lawn photo, 2 m across (fading out further
				// off, where its repeat would line up into a grid; see GROUND_SHADER)
				float kd = 1.0 - smoothstep(25.0, 110.0, length(VERTEX));
				vec2 uv = p * 0.5;
				vec3 t = textureGrad(grass_tex, uv, dpx * 0.5, dpy * 0.5).rgb;
				vec3 lw = vec3(0.2126, 0.7152, 0.0722);
				vec3 t_grey = grass_mean * (dot(t, lw) / dot(grass_mean, lw));   // its brightness, the lawn's average colour
				c *= detail(mix(t_grey, t, fx.z), grass_mean, 0.85 * kd);
				bump = unpack(textureGrad(grass_nrm, uv, dpx * 0.5, dpy * 0.5).rg, 0.8 * kd);
			} else if (fx.w < 2.5) {   // asphalt: fine grit 3 m across over 30 m of patches and tyre marks
				vec2 uv = p / 3.0;
				// paint (no patches of its own) takes the grit faintly: it is worn, not gritty
				float k = fx.x > 0.0 ? 1.0 : 0.35;
				c *= detail(textureGrad(asph_tex, uv, dpx / 3.0, dpy / 3.0).rgb, asph_mean, 0.9 * k);
				vec3 b = textureGrad(asph_big, p / 30.0, dpx / 30.0, dpy / 30.0).rgb;
				c *= mix(1.0, clamp(dot(b, vec3(0.333)) / dot(big_mean, vec3(0.333)), 0.0, 2.0), 0.7 * k);
				bump = unpack(textureGrad(asph_nrm, uv, dpx / 3.0, dpy / 3.0).rg, 1.0);
				float dist = length(VERTEX);
				float pxw = length(dpx) + length(dpy);
				if (fx.x > 0.0 && dist < 140.0) {
					// worn, as Givatayim's streets are: one 5 m square in eight patched with
					// newer, darker asphalt and its sealed seam; crazed plates where it is old;
					// the light stones of the mix showing, close up
					vec2 pc = floor(p / 5.0);
					if (hash(pc + 2.3) < 0.13) {
						vec2 lo = (pc + vec2(hash(pc + 4.1), hash(pc + 5.3)) * 0.4) * 5.0;
						vec2 hi = lo + vec2(1.2 + 2.6 * hash(pc + 6.7), 1.0 + 2.2 * hash(pc + 8.9));
						vec2 d = min(p - lo, hi - p);
						float inside = step(0.0, min(d.x, d.y));
						c *= mix(1.0, 0.8, inside);
						c *= 1.0 - 0.4 * inside * (1.0 - smoothstep(0.02, 0.02 + pxw * 2.0, min(d.x, d.y)));
					}
					c *= crazing(p, dist, pxw);
					c *= 1.0 + step(0.94, hash(floor(p / 0.012))) * 0.4 * (1.0 - smoothstep(3.0, 12.0, dist));
				}
				if (fx.x > 0.0) {
					// oil and rubber: a dark blotch in about one 3 m square in six, oval, soft
					vec2 cell = floor(p / 3.0);
					if (hash(cell) > 0.83) {
						vec2 cc = (cell + 0.5 + (vec2(hash(cell + 3.1), hash(cell + 7.7)) - 0.5) * 0.5) * 3.0;
						float r = 0.35 + 0.55 * hash(cell + 1.3);
						float d = length((p - cc) * vec2(1.0, 1.7));
						c *= 1.0 - 0.5 * smoothstep(r, r * 0.35, d) * (0.6 + 0.4 * noise(p * 3.0));
					}
				} else {
					// paint wears through to the asphalt, in patches and in grains -- a zebra half
					// gone, as most are -- and the road's cracks run through it
					float wear = smoothstep(0.42, 0.8, noise(p * 1.3)) * 0.7 + smoothstep(0.55, 0.9, noise(p * 7.0)) * 0.35;
					c = mix(c, wear_col, clamp(wear, 0.0, 0.92));
					c *= crazing(p, dist, pxw);
				}
			} else if (fx.w < 3.5) {   // pavement and plazas: pavers, bigger in a plaza
				float s = pave_m * fx.z / 0.6;
				vec2 uv = p / s;
				c *= detail(textureGrad(pave_tex, uv, dpx / s, dpy / s).rgb, pave_mean, 0.9);
				bump = unpack(textureGrad(pave_nrm, uv, dpx / s, dpy / s).rg, 1.0);
			} else if (fx.w > 7.5 && fx.w < 8.5) {   // tactile paving (kind 8): slabs fx.z square
				// laid along `lay`, each with 6 x 6 domes -- the bend of the light on them done by
				// the normal, so the sun picks them out from its own side; they fade to the slab's
				// tone with distance before they can shimmer
				mat2 rot = mat2(vec2(cos(lay), -sin(lay)), vec2(sin(lay), cos(lay)));
				vec2 q = rot * p / fx.z;
				vec2 cell = floor(q);
				vec2 f = fract(q);
				float fw = max(length(dpx), length(dpy)) / fx.z;
				c *= 0.93 + 0.12 * hash(cell + 3.7);
				c *= detail(textureGrad(asph_tex, p / 1.5, dpx / 1.5, dpy / 1.5).rgb, asph_mean, 0.25);
				vec2 e = min(f, 1.0 - f);
				c *= 1.0 - 0.25 * (1.0 - smoothstep(0.01, 0.01 + fw * 1.5, min(e.x, e.y)));
				vec2 dq = fract(f * 6.0) - 0.5;
				float r = length(dq);
				float dw = fw * 6.0;
				float fade = 1.0 - smoothstep(0.2, 0.55, dw);
				float dome = 1.0 - smoothstep(0.3, 0.3 + dw, r);
				float ring = smoothstep(0.22, 0.3, r) * (1.0 - smoothstep(0.3, 0.38 + dw, r));
				c *= 1.0 - (0.22 * ring * fade + 0.05 * (1.0 - fade));
				vec2 side = (dq * rot) / max(r, 0.001) * clamp(r / 0.3, 0.0, 1.0) * dome * fade * 0.75;
				side.y = -side.y;   // (the normal's frame: x along +X, y along -Z)
				bump = vec3(side, sqrt(max(0.0, 1.0 - dot(side, side))));
			} else if (fx.w > 6.5 && fx.w < 7.5) {   // pavers in rows (kind 7), fx.z long and half that wide,
				// each row half a paver on from the last, laid along `lay`; the joints fade out
				// with distance before they can shimmer
				vec2 q = mat2(vec2(cos(lay), -sin(lay)), vec2(sin(lay), cos(lay))) * p / fx.z;
				q.y *= 2.0;
				q.x += 0.5 * mod(floor(q.y), 2.0);
				vec2 cell = floor(q);
				vec2 f = fract(q);
				float fw = max(length(dpx), length(dpy)) / fx.z;
				c *= 0.9 + 0.2 * hash(cell + 1.7);
				c *= detail(textureGrad(asph_tex, p / 1.5, dpx / 1.5, dpy / 1.5).rgb, asph_mean, 0.25);
				vec2 e = min(f, 1.0 - f) * vec2(1.0, 0.5);
				float joint = 1.0 - smoothstep(0.02, 0.02 + fw * 1.5, min(e.x, e.y));
				c *= 1.0 - 0.3 * joint * (1.0 - smoothstep(0.15, 0.4, fw));
			} else {   // poured concrete slabs (kind 6), fx.z across, laid along `lay`: each a
				// shade of its own, the joints dark, a crack across about one in six
				vec2 q = mat2(vec2(cos(lay), -sin(lay)), vec2(sin(lay), cos(lay))) * p / fx.z;
				vec2 cell = floor(q);
				vec2 f = fract(q);
				float fw = max(length(dpx), length(dpy)) / fx.z;
				c *= 0.94 + 0.1 * hash(cell + 5.3);
				c *= detail(textureGrad(asph_tex, p / 1.5, dpx / 1.5, dpy / 1.5).rgb, asph_mean, 0.3);
				c *= 1.0 - 0.13 * smoothstep(0.5, 0.85, noise(p * 0.45 + 3.0));   // old stains, soft
				vec2 e = min(f, 1.0 - f);
				c *= 1.0 - 0.16 * (1.0 - smoothstep(0.005, 0.005 + fw * 1.5, min(e.x, e.y)));
				if (hash(cell + 9.1) > 0.83) {
					float a = hash(cell + 6.6) * 3.14159;
					vec2 o = vec2(hash(cell + 2.2), hash(cell + 4.4)) * 0.6 + 0.2;
					float d = abs(dot(f - o, vec2(cos(a), sin(a))) + (noise(q * 9.0) - 0.5) * 0.06);
					c *= 1.0 - 0.3 * (1.0 - smoothstep(0.003, 0.003 + fw * 1.5, d));
				}
			}
		} else if (near > 0.0) {
			shade += (noise(p * 1.9) - 0.5) * fx.y * 2.0 * near;
			if (fx.w > 2.5) {   // paving: a grid of slabs, the joints a little darker
				vec2 g = abs(fract(p / fx.z) - 0.5);
				shade -= step(0.45, max(g.x, g.y)) * 0.1 * near;
			}
		}
		c *= shade;
	}
	// the photos are mapped on the world's X and Z, so their frame is the world's: across is
	// +X, the map's "up" is -Z; bent round the surface's own normal for the hills
	// (only on the ground: on a pole or a sign the frame would come out of nothing)
	if (bump.z < 0.99999) {
		vec3 t = (VIEW_MATRIX * vec4(1.0, 0.0, 0.0, 0.0)).xyz;
		t = normalize(t - NORMAL * dot(NORMAL, t));
		NORMAL = normalize(t * bump.x + cross(NORMAL, t) * bump.y + NORMAL * bump.z);
	}
	if (abs(wup) < 0.35 && ((fx.w < 0.5 && fx.z > 0.5) || (COLOR.a > 0.3 && COLOR.a < 0.7))) {
		float dist_t = length(VERTEX);
		if (dist_t < 45.0) {
			c = graffiti(c, dist_t);
		}
	}
	float rough = 0.9;
	float spec = 0.25;
	vec3 emit = vec3(0.0);
	if (wet > 0.001) {   // after rain: hard ground (asphalt, paint, pavers, slabs) dark and glossy,
		// puddles in its dips; grass and earth a little darker
		float hard = ((fx.w > 1.5 && fx.w < 3.5) || fx.w > 5.5) ? 1.0 : 0.0;
		float soak = wet * smoothstep(0.6, 0.8, wup);
		float pn = noise(p / 2.6) * 0.6 + noise(p / 0.8 + 3.7) * 0.4;
		float lvl = fx.w < 2.5 ? 0.64 : 0.71;   // (fewer on pavers than on the road)
		float puddle = hard * soak * smoothstep(lvl, lvl + 0.05, pn);
		// (only the puddles a mirror: a whole road at a low roughness took the renderer's flat
		// ambient reflection all over and came out pale grey, not dark and wet)
		c *= mix(1.0, mix(0.85, 0.5, hard), soak);
		c *= 1.0 - 0.45 * puddle;
		rough = mix(mix(rough, 0.68, soak * hard), 0.08, puddle);   // (glossier flared white in the sun)
		spec = mix(spec, 0.3, soak * hard);
		spec = mix(spec, 0.5, puddle);
		vec3 vd = normalize((INV_VIEW_MATRIX * vec4(VERTEX, 0.0)).xyz);
		emit = wet_mirror(vd) * (soak * hard * 0.05 + puddle * 0.25);
	}
	float fsh = far_shade(wpos, length(VERTEX));
	ALBEDO = c * mix(1.0, fsh, step(0.7, wup));   // (the ground, not a wall or a pole)
	ROUGHNESS = rough;
	SPECULAR = spec;
	EMISSION = emit;
}
"""
## the surface each tone gets: [patches, grain, slab size (kind 3) / the lawn photo's colours too
## (kind 1: 1 grass, 0 bare earth: its light and dark only), kind (0 none, 1 soft, 2 grained, 3 slabs,
## 4 rough stones in mortar, 6 poured slabs laid along a line, 7 pavers in rows, 8 tactile paving
## (domed slabs at a crossing's kerbs); the shader tests
## each kind's range on both sides, so a new kind never falls into another's branch)]
const TONE_FX := {
	"grass": [0.16, 0.08, 1.0, 1.0], "pitch": [0.06, 0.05, 1.0, 1.0], "wood": [0.16, 0.07, 1.0, 1.0],
	"bush": [0.1, 0.05, 1.0, 1.0], "ground": [0.1, 0.06, 0.0, 1.0], "sand": [0.08, 0.08, 0.0, 1.0],
	"asphalt": [0.11, 0.075, 0.0, 2.0], "parking": [0.1, 0.06, 0.0, 2.0], "path": [0.06, 0.07, 0.0, 2.0],
	"pavement": [0.04, 0.04, 0.6, 3.0], "plaza": [0.05, 0.04, 1.0, 3.0], "mark": [0.0, 0.04, 0.0, 2.0],
	"pavers_dark": [0.04, 0.04, 0.6, 3.0], "slabs": [0.05, 0.04, 1.0, 6.0], "pavers_grey": [0.04, 0.03, 0.2, 7.0],
	"tactile": [0.03, 0.03, 0.3, 8.0], "pavers_red": [0.04, 0.04, 0.6, 3.0],
	"markyellow": [0.0, 0.04, 0.0, 2.0], "metal": [0.0, 0.0, 0.0, 0.0], "metalrim": [0.0, 0.0, 0.0, 0.0],
	"stonewall": [0.06, 0.04, 0.0, 4.0],
	"gardenwall": [0.14, 0.05, 1.0, 0.0], "coping": [0.06, 0.05, 0.0, 0.0],
	"pole": [0.03, 0.02, 1.0, 0.0],      # (kind 0 with z 1: tags and stickers on it, TONE_SHADER's graffiti())
}
var _tone_list: Array = []           ## the table's tone names, in order
var _tone_material: ShaderMaterial

func _tone_mat() -> ShaderMaterial:
	if _tone_material == null:
		_tone_material = ShaderMaterial.new()
		var sh := Shader.new()
		sh.code = _with_far(TONE_SHADER)
		_tone_material.shader = sh
		_far(_tone_material)
		# Israeli pavements are 20 x 10 cm concrete pavers in herringbone, a mix of greys
		# and red-browns (drawn by textures/herringbone.py); Bedford's are poured slabs, the
		# photo's slabs blown up to a metre or so
		var north := String(_place.get("look", "")) == "north"
		var pave := "concrete_pavement" if north else "herringbone_pavers"
		_tone_material.set_shader_parameter("asph_tex", _tex("asphalt_02_diff"))
		_set_hmap(_tone_material)
		_tone_material.set_shader_parameter("asph_nrm", _tex("asphalt_02_nor"))
		_tone_material.set_shader_parameter("asph_big", _tex("aerial_asphalt_01_diff"))
		_tone_material.set_shader_parameter("pave_tex", _tex(pave + "_diff"))
		_tone_material.set_shader_parameter("pave_nrm", _tex(pave + "_nor"))
		_tone_material.set_shader_parameter("grass_tex", _tex("leafy_grass_diff"))
		_tone_material.set_shader_parameter("grass_nrm", _tex("leafy_grass_nor"))
		_tone_material.set_shader_parameter("asph_mean", TEX_MEAN["asphalt_02"])
		_tone_material.set_shader_parameter("big_mean", TEX_MEAN["aerial_asphalt_01"])
		_tone_material.set_shader_parameter("pave_mean", TEX_MEAN[pave])
		_tone_material.set_shader_parameter("grass_mean", TEX_MEAN["leafy_grass"])
		_tone_material.set_shader_parameter("pave_m", 4.0 if north else 2.0)
		_tone_material.set_shader_parameter("textured", 1.0 if _quality > 0 else 0.0)
	return _tone_material

## The photos under the surfaces: CC0 from Poly Haven (textures/CREDITS.md), 1024 px, the
## bump maps 512 -- all but the herringbone pavers, which textures/herringbone.py draws. The shaders divide each by its average colour, so a photo adds detail
## without changing the palette's colour. The averages are of the stored (sRGB) values, and
## the samplers have no source_color, so they read exactly those: in the Compatibility
## renderer source_color does not convert them anyway (measured), and a photo's own smallest
## mipmap, the obvious way to get its average in the shader, read back as junk there.
const TEX_DIR := "res://game/streets/textures/"
const TEX_MEAN := {
	"aerial_asphalt_01": Vector3(0.402, 0.385, 0.406),
	"asphalt_02": Vector3(0.356, 0.353, 0.333),
	"concrete_pavement": Vector3(0.501, 0.457, 0.403),
	"herringbone_pavers": Vector3(0.502, 0.489, 0.483),
	"leafy_grass": Vector3(0.593, 0.516, 0.351),
	"painted_plaster_wall": Vector3(0.671, 0.639, 0.627),
	"bark_brown_02": Vector3(0.373, 0.338, 0.251),
	"palm_tree_bark": Vector3(0.613, 0.565, 0.507),
}

func _tex(file: String) -> Texture2D:
	return load(TEX_DIR + file + ".jpg") as Texture2D

## the photo textures on or off in every shader that has them (off at the lowest web level)
func _set_textured(on: bool) -> void:
	for m: ShaderMaterial in [_tone_material, _wall_mat, _ground_shader_mat, _kerb_mat, _roof_mat]:
		if m != null:
			m.set_shader_parameter("textured", 1.0 if on else 0.0)

## the ground's height grid as a texture, for shaders that need a height above the ground
## (the grass blades, the tags on walls): once, shared
var _hmap_tex: ImageTexture

func _set_hmap(m: ShaderMaterial) -> void:
	if _hnx == 0:
		return
	if _hmap_tex == null:
		_hmap_tex = ImageTexture.create_from_image(Image.create_from_data(_hnx, _hnz, false, Image.FORMAT_RF, _hgrid.to_byte_array()))
	m.set_shader_parameter("hmap", _hmap_tex)
	m.set_shader_parameter("h_info", Vector4(_hx0, _hz0, _hstep, 1.0))
	m.set_shader_parameter("h_size", Vector2i(_hnx, _hnz))
	m.set_meta("hmap", true)

func _retint_tone_mat() -> void:
	if _tone_material == null:
		return
	# (the material is made before the height grid is read: hand it the grid here too)
	if not _tone_material.has_meta("hmap"):
		_set_hmap(_tone_material)
	# spray paint: black mostly, then the palette's own loud colours, a little toned down
	_tone_material.set_shader_parameter("tag_a", _natural(Palette.col("hazard"), 0.8))
	_tone_material.set_shader_parameter("tag_b", _natural(Palette.col("player"), 0.75))
	_tone_material.set_shader_parameter("tag_c", _natural(Palette.col("prize"), 0.75))
	_tone_material.set_shader_parameter("tag_d", Palette.col("bg").lerp(Palette.col("bg_alt"), 0.2))
	var cols := PackedColorArray()
	cols.resize(64)
	var fxs: Array = []
	fxs.resize(64)
	fxs.fill(Vector4.ZERO)
	for i in range(_tone_list.size()):
		cols[i] = _tone.get(_tone_list[i], Palette.col("warn"))
		var f: Array = TONE_FX.get(_tone_list[i], [0.03, 0.02, 0.0, 0.0])   # (kind 0: no photo)
		fxs[i] = Vector4(f[0], f[1], f[2], f[3])
	_tone_material.set_shader_parameter("tones", cols)
	_tone_material.set_shader_parameter("wear_col", _tone["asphalt"])
	_tone_material.set_shader_parameter("tone_fx", fxs)

## the tone a plain material is (one of _surface's), or "" when it is anything else
func _tone_of(m: Material) -> String:
	var sm := m as StandardMaterial3D
	if sm == null or sm.vertex_color_use_as_albedo or sm.emission_enabled or sm.transparency != BaseMaterial3D.TRANSPARENCY_DISABLED:
		return ""
	for t: String in _smat:
		if _smat[t] == m and _tone.has(String(sm.get_meta("tone", t))) and t != "lamp":
			return String(sm.get_meta("tone", t))
	return ""

## how a material's geometry goes into the merged mesh: [colour to fill with, or null to keep
## the vertex colours, the material's own colour to multiply them by (linear)], or [] if it
## is not one for the merged mesh. (A tree's tint is its instance colour times the leaf's.)
func _merge_as(m: Material) -> Array:
	var sm := m as StandardMaterial3D
	if sm != null and sm.vertex_color_use_as_albedo and not sm.emission_enabled and sm.transparency == BaseMaterial3D.TRANSPARENCY_DISABLED:
		return [null, sm.albedo_color.srgb_to_linear()]
	var t := _tone_of(m)
	if t == "":
		return []
	var i := _tone_list.find(t)
	if i < 0:
		if _tone_list.size() >= 64:
			return []
		_tone_list.append(t)
		i = _tone_list.size() - 1
	return [Color(float(i) / 63.0, 0.0, 0.0, 0.0)]

func _range_class(seen: float) -> float:
	if seen <= 0.0:
		return 100000.0
	for r: float in BATCH_RANGES:
		if r >= seen:
			return r
	return BATCH_RANGES[BATCH_RANGES.size() - 1]

## a whole Buf (already in world space) into the merged meshes
func _batch_buf(buf: Buf, m: Material, how: Array, shadows: bool, seen: float) -> void:
	var rc := _range_class(seen)
	var nb := 0
	for pk: Vector2i in buf.parts():
		nb += (buf.parts()[pk] as Buf).v.size()
	_tally("batched vertices: " + (_tone_of(m) if _tone_of(m) != "" else "coloured"), nb)   # (tests/perf_dive.gd)
	var key := "U|%s|%d" % [shadows, int(rc)]
	if not _batches.has(key):
		_batches[key] = {"mat": _tone_mat(), "shadows": shadows, "range": rc, "cells": {}}
	var cells: Dictionary = _batches[key]["cells"]
	var parts := buf.parts()
	for pk: Vector2i in parts:
		var part: Buf = parts[pk]
		if part.empty():
			continue
		var centre := part.v[0]
		var ck := _tile if _tiled else _cell(Vector2(centre.x, centre.z), BATCH_CELL)
		var bat: Buf = cells.get(ck)
		if bat == null:
			bat = Buf.new()
			cells[ck] = bat
		bat.v.append_array(part.v)
		bat.n.append_array(part.n)
		if how[0] == null:
			var alb: Color = how[1]
			if alb == Color.WHITE:
				bat.c.append_array(part.c)
			else:
				var pc := part.c.duplicate()
				for k in range(pc.size()):
					pc[k] = pc[k] * alb
				bat.c.append_array(pc)
		elif part.c.size() > 0 and part.c[0].a < 0.02:
			# laid along a line (paving's slabs: _front_gate, details.gd): the way in the
			# green kept, the tone's index in the red
			var cs2 := part.c.duplicate()
			var tr: float = (how[0] as Color).r
			for k in range(cs2.size()):
				cs2[k] = Color(tr, cs2[k].g, 0.0, 0.0)
			bat.c.append_array(cs2)
		else:
			var cs := PackedColorArray()
			cs.resize(part.v.size())
			cs.fill(how[0])
			bat.c.append_array(cs)

## the one material for everything coloured in its vertices (signs, kits, balconies)
var _vc_material: StandardMaterial3D
func _vc_mat() -> StandardMaterial3D:
	if _vc_material == null:
		_vc_material = StandardMaterial3D.new()
		_vc_material.vertex_color_use_as_albedo = true
		_vc_material.roughness = 0.75
	return _vc_material

## a mesh's first surface as plain triangles: [vertices, normals, colours, all white?]
func _soup(mesh: Mesh) -> Array:
	var id := mesh.get_instance_id()
	if _soups.has(id):
		return _soups[id]
	var arr := mesh.surface_get_arrays(0)
	var v: PackedVector3Array = arr[Mesh.ARRAY_VERTEX]
	var n: PackedVector3Array = arr[Mesh.ARRAY_NORMAL] if arr[Mesh.ARRAY_NORMAL] != null else PackedVector3Array()
	var c: PackedColorArray = arr[Mesh.ARRAY_COLOR] if arr[Mesh.ARRAY_COLOR] != null else PackedColorArray()
	var idx: PackedInt32Array = arr[Mesh.ARRAY_INDEX] if arr[Mesh.ARRAY_INDEX] != null else PackedInt32Array()
	if n.size() != v.size():
		n = PackedVector3Array()
		n.resize(v.size())
		n.fill(Vector3.UP)
	if c.size() != v.size():
		c = PackedColorArray()
		c.resize(v.size())
		c.fill(Color.WHITE)
	if not idx.is_empty():
		var v2 := PackedVector3Array()
		var n2 := PackedVector3Array()
		var c2 := PackedColorArray()
		v2.resize(idx.size())
		n2.resize(idx.size())
		c2.resize(idx.size())
		for k in range(idx.size()):
			v2[k] = v[idx[k]]
			n2[k] = n[idx[k]]
			c2[k] = c[idx[k]]
		v = v2
		n = n2
		c = c2
	var white := true
	for col in c:
		if col != Color.WHITE:
			white = false
			break
	var out := [v, n, c, white]
	_soups[id] = out
	return out

func _batchable(mesh: Mesh, m: Material, count: int) -> bool:
	if mesh == null or mesh.get_surface_count() != 1:
		return false
	var mt: Material = m if m != null else mesh.surface_get_material(0)
	if not (mt is StandardMaterial3D):
		return false
	var sm := mt as StandardMaterial3D
	if sm.emission_enabled or sm.transparency != BaseMaterial3D.TRANSPARENCY_DISABLED or sm == _smat.get("lamp"):
		return false
	var nv := (_soup(mesh)[0] as PackedVector3Array).size()
	return nv <= BATCH_KIT_VERTS and nv * count <= BATCH_VERTS

func _batch_add(mesh: Mesh, xforms: Array, range_end: float, colours: Array, m: Material, shadows: bool) -> void:
	var mt: Material = m if m != null else mesh.surface_get_material(0)
	var rc := _range_class(range_end)
	var how := _merge_as(mt)
	var key := ("U|%s|%d" % [shadows, int(rc)]) if not how.is_empty() else ("%d|%s|%d" % [mt.get_instance_id(), shadows, int(rc)])
	if not _batches.has(key):
		_batches[key] = {"mat": _tone_mat() if not how.is_empty() else mt, "shadows": shadows, "range": rc, "cells": {}}
	var cells: Dictionary = _batches[key]["cells"]
	var soup := _soup(mesh)
	var sv: PackedVector3Array = soup[0]
	var sn: PackedVector3Array = soup[1]
	var sc: PackedColorArray = soup[2]
	var white: bool = soup[3]
	var nv := sv.size()
	_tally("batched vertices: " + (_tone_of(mt) if _tone_of(mt) != "" else "coloured kits"), nv * xforms.size())   # (tests/perf_dive.gd)
	if OS.is_debug_build():   # (and by who added them: the first caller that is not the batching itself)
		var who := "?"
		for fr: Dictionary in get_stack():
			if not String(fr["function"]) in ["_batch_add", "_chunked", "_chunked_paced", "_place", "_tally"]:
				who = "%s:%d (%d verts)" % [fr["function"], fr["line"], nv]
				break
		_tally("batched by: " + who, nv * xforms.size())
	for i in range(xforms.size()):
		var t: Transform3D = xforms[i]
		var ck := _tile if _tiled else _cell(Vector2(t.origin.x, t.origin.z), BATCH_CELL)
		var bat: Buf = cells.get(ck)
		if bat == null:
			bat = Buf.new()
			cells[ck] = bat
		bat.v.append_array(t * sv)
		bat.n.append_array(Transform3D(t.basis, Vector3.ZERO) * sn)
		if not how.is_empty() and how[0] != null:   # a plain tone: its number, whatever the instance colour
			var ts := PackedColorArray()
			ts.resize(nv)
			ts.fill(how[0])
			bat.c.append_array(ts)
		elif colours.is_empty() and (how.is_empty() or how[1] == Color.WHITE):
			bat.c.append_array(sc)
		else:
			var col: Color = (colours[i] if not colours.is_empty() else Color.WHITE) * (how[1] if not how.is_empty() else Color.WHITE)
			var cs := PackedColorArray()
			cs.resize(nv)
			if white:
				cs.fill(col)
			else:
				for k in range(nv):
					cs[k] = sc[k] * col
			bat.c.append_array(cs)

func _flush_batches() -> void:
	_batching = false
	_retint_tone_mat()
	var made := 0
	for key: String in _batches:
		var b: Dictionary = _batches[key]
		var rc: float = b["range"]
		for ck: Vector2i in b["cells"]:
			if _over():
				await _pause()
			var bat: Buf = b["cells"][ck]
			var am := ArrayMesh.new()
			await _index_into(am, bat, b["mat"])
			var mi := MeshInstance3D.new()
			mi.mesh = am
			if rc < 99999.0:
				mi.visibility_range_end = rc + BATCH_CELL * 0.71
				mi.visibility_range_end_margin = 20.0
			mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON if b["shadows"] else GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			world.add_child(mi)
			made += 1
	_tally("batches", made)
	_batches = {}
	_soups = {}

## The merged meshes are triangle soups -- each triangle its own three vertices, built that
## way -- and most vertices repeat: a quad's two triangles share two, a kit's faces share
## theirs. Indexed (the same position, normal and colour kept once), Tel Aviv's 9.8 M merged
## vertices are 5.4 M, 187 MB -> 121 MB (tests/index_gain.gd). SurfaceTool does it in C++,
## but on the main thread (the web build has none other): a piece of at most INDEX_PIECE
## vertices at a time, each its own surface, the frame handed back between them -- whole,
## the biggest square's 170 k vertices took 30 ms here. (Pieces under 65,536 vertices keep
## 16-bit indices, too.) Only the squares built while driving: the ones round the start are
## built behind the loading text, where it would add to the wait (the pieces also cost
## draws: all indexed, Tel Aviv's start view went 669 -> 692 draws, video memory 445 -> 365 MB).
const INDEX_PIECE := 30000
func _index_into(am: ArrayMesh, bat: Buf, mat: Material) -> void:
	var n := bat.v.size()
	if not _bg_build or OS.get_environment("STREETS_NO_INDEX") == "1":   # (=1: as before, to compare)
		var soup := []
		soup.resize(Mesh.ARRAY_MAX)
		soup[Mesh.ARRAY_VERTEX] = bat.v
		soup[Mesh.ARRAY_NORMAL] = bat.n
		soup[Mesh.ARRAY_COLOR] = bat.c
		am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, soup)
		am.surface_set_material(0, mat)
		return
	for from in range(0, n, INDEX_PIECE):
		if from > 0 and _over():
			await _pause()
		var to := mini(from + INDEX_PIECE, n)
		var arr := []
		arr.resize(Mesh.ARRAY_MAX)
		var whole := from == 0 and to == n
		arr[Mesh.ARRAY_VERTEX] = bat.v if whole else bat.v.slice(from, to)
		arr[Mesh.ARRAY_NORMAL] = bat.n if whole else bat.n.slice(from, to)
		arr[Mesh.ARRAY_COLOR] = bat.c if whole else bat.c.slice(from, to)
		var st := SurfaceTool.new()
		st.create_from_arrays(arr)
		st.index()
		am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, st.commit_to_arrays())
		am.surface_set_material(am.get_surface_count() - 1, mat)

## _chunked a couple of hundred copies at a time while building in the background (a
## square's trees merged in one go took most of a frame)
func _chunked_paced(mesh: Mesh, xforms: Array, range_end: float, colours: Array = [], m: Material = null, shadows := false) -> void:
	if xforms.size() <= 200 or not (_bg_build and _batching and _batchable(mesh, m, xforms.size())):
		_chunked(mesh, xforms, range_end, colours, m, shadows)
		return
	for i in range(0, xforms.size(), 200):
		if _over():
			await _pause()
		_batch_add(mesh, xforms.slice(i, i + 200), range_end, colours.slice(i, i + 200) if not colours.is_empty() else [],
			m, shadows)

func _chunked(mesh: Mesh, xforms: Array, range_end: float, colours: Array = [], m: Material = null, shadows := false,
		custom := false, cell_m := 0.0, range_begin := 0.0) -> void:
	if xforms.is_empty():
		return
	if _batching and not custom and _batchable(mesh, m, xforms.size()):
		_batch_add(mesh, xforms, range_end, colours, m, shadows)
		return
	# a square about as big as the range: little things (signs, posts, racks) seen 100-150 m
	# off in 140 m squares were a dozen draws a kind, and a big city tens of thousands of nodes
	# (`cell_m`: squares that size whatever is being built -- a square's range counts to its
	# middle, so a 400 m one drew what it held out to its range plus 284 m)
	var cell := cell_m if cell_m > 0.0 else (TILE if _tiled else clampf(range_end, 220.0, CHUNK))
	# a little thing seen to 200 m or less, built a square at a time: the square cut in four, so
	# its range counts from a 200 m cell's middle, not a 400 m square's (AC units meant for 140 m
	# were drawn to 424, 9,700 of them in view from one walk: 814k triangles; a draw or two more
	# a kind)
	var quarter := _tiled and cell_m <= 0.0 and range_end <= SMALL_RANGE
	if quarter:
		cell = TILE * 0.5
	var groups := {}
	for i in range(xforms.size()):
		var t: Transform3D = xforms[i]
		var key := _tile if _tiled and cell_m <= 0.0 and not quarter else _cell(Vector2(t.origin.x, t.origin.z), cell)
		if not groups.has(key):
			groups[key] = []
		(groups[key] as Array).append(i)
	for key: Vector2i in groups:
		var list: Array = groups[key]
		var mm := MultiMesh.new()
		mm.transform_format = MultiMesh.TRANSFORM_3D
		# with custom data, colours on too (all white): this renderer multiplies the vertex
		# colour by the instance colour, and without one that came out as nothing (black)
		mm.use_colors = not colours.is_empty()
		mm.use_custom_data = not colours.is_empty() and custom
		mm.mesh = mesh
		mm.instance_count = list.size()
		for j in range(list.size()):
			mm.set_instance_transform(j, xforms[list[j]])
			if not colours.is_empty():
				if custom:
					mm.set_instance_custom_data(j, Color(colours[list[j]], 0.0))
					mm.set_instance_color(j, Color.WHITE)
				else:
					mm.set_instance_color(j, colours[list[j]])
		var mmi := MultiMeshInstance3D.new()
		mmi.multimesh = mm
		mmi.visibility_range_end = range_end + cell * 0.71
		mmi.visibility_range_end_margin = 20.0
		if range_begin > 0.0:
			mmi.visibility_range_begin = range_begin
			mmi.visibility_range_begin_margin = 20.0
		if m != null:
			mmi.material_override = m
		if not shadows:
			mmi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		world.add_child(mmi)

func _tree_ok(p: Vector2, spacing: float) -> bool:
	if not _bounds.has_point(p):
		return false
	var hit := _nearest_seg(p, 12.0, true)
	if not hit.is_empty() and hit["edge"] < 0.7:
		return false
	if _push_out(p, 1.1, false) != Vector2.ZERO:
		return false
	for i: int in _near(_post_hash, p, spacing, BLD_CELL):
		if _posts[i].distance_to(p) < spacing:
			return false
	return true

## p is at least `margin` metres clear of every drivable road's asphalt (negative: may poke
## that far in). Anything solid is checked with this before it goes down: a bench by a
## footpath that runs beside a road, or a sign by a narrow street where a wide one passes,
## stood in the lane, and autodrive drove into it again and again.
func _off_road(p: Vector2, margin: float) -> bool:
	var hit := _nearest_seg(p, 14.0, true)
	return (hit.is_empty() or float(hit["edge"]) >= margin) and not _in_corner_fill(p, margin) 		and _split_push(p, margin) == Vector2.ZERO

## The line cars drive past the split of a divided road. OSM starts both halves at the two-way
## road's middle, so for some metres past the split a car in the two-way road's lane drives
## on beside the narrower half's asphalt -- and what was put up 1 m off that asphalt stood in
## its way (tests/split_posts.gd DRIVE=1, Ashdod: a no-entry sign at Dakar's split and a post
## at Tamuz's touched; before it, a one-way arrow knocked flat on every drive). The line runs
## from the two-way road's lane at the split over to the half's own lane 25 m on, as autodrive
## drives it; nothing is put up within a car's half width of it. Worked out the first time.
var _split_lines := []    ## [a, b] pieces of those lines
var _split_hash := {}     ## SEG_CELL -> indices into _split_lines
var _split_done := false
const SPLIT_HALF := 0.9 + 0.25   ## a car's half width and a little

func _find_split_lines() -> void:
	_split_done = true
	for ni in range(mini(_nodes.size(), _node_roads.size())):
		var c := _nodes[ni]
		for e: Vector2i in _node_roads[ni]:
			var r: Dictionary = _roads[e.x]
			var pts: PackedVector2Array = r["pts"]
			if int(r["o"]) != 0 or not r["drive"] or String(r.get("name", "")) == "" or (e.y != 0 and e.y != pts.size() - 1):
				continue
			var prev: int = 1 if e.y == 0 else e.y - 1
			if prev < 0 or prev >= pts.size():
				continue
			var t := (c - pts[prev]).normalized()
			for h: Vector2i in _node_roads[ni]:
				var hr: Dictionary = _roads[h.x]
				var hp: PackedVector2Array = hr["pts"]
				if h.x == e.x or int(hr["o"]) == 0 or String(hr.get("name", "")) != String(r["name"]) or float(hr["w"]) > float(r["w"]) - 2.0:
					continue
				for k: int in [h.y - 1, h.y + 1]:
					if k < 0 or k >= hp.size() or (hp[k] - c).normalized().dot(t) <= 0.8:
						continue
					var way := 1 if k == h.y + int(hr["o"]) else -1
					var u := (hp[k] - c).normalized()
					var trav := u * float(way)
					var right := Vector2(-trav.y, trav.x)
					var tw := t * float(way)
					var at0 := (Vector2(-tw.y, tw.x) * _lane_off(r)).dot(right)
					var off_h := _lane_off(hr)
					var last := c + right * at0
					for i in range(5, 26, 5):
						var q := c + u * float(i) + right * lerpf(at0, off_h, float(i) / 25.0)
						_hash_add(_split_hash, Rect2(last, Vector2.ZERO).expand(q).grow(SPLIT_HALF + 1.0), SEG_CELL, _split_lines.size())
						_split_lines.append([last, q])
						last = q

## how far p must move to keep a body of radius r out of a split's line (ZERO: it is clear)
func _split_push(p: Vector2, r: float) -> Vector2:
	if not _split_done:
		_find_split_lines()
	if _split_lines.is_empty():
		return Vector2.ZERO
	for i: int in _near(_split_hash, p, 0.1, SEG_CELL):
		var ln: Array = _split_lines[i]
		var q := Geometry2D.get_closest_point_to_segment(p, ln[0], ln[1])
		var d := p.distance_to(q)
		if d < SPLIT_HALF + r:
			return (p - q).normalized() * (SPLIT_HALF + r - d + 0.05) if d > 0.01 else Vector2.ZERO
	return Vector2.ZERO

## p is on (or within `margin` of) the asphalt round a junction's point -- the disc as wide as
## its widest road that every junction is laid with, which no one road's lanes cover. Railings
## and bollards by a zebra near a corner, checked against the roads' edges only, stood there
## in the junction's mouth.
func _in_junction(p: Vector2, margin: float) -> bool:
	for code: int in _near(_seg_hash, p, 12.0, SEG_CELL):
		var r: Dictionary = _roads[code / 4096]
		if not r["drive"]:
			continue
		var ids: PackedInt32Array = r["ids"]
		var sj: int = code % 4096
		for n: int in [ids[sj], ids[sj + 1]]:
			if p.distance_to(_nodes[n]) < _node_r[n] * 1.05 + margin and _node_ways(n) >= 3:
				return true
	return false

## p is on a street's asphalt (a kerbed road's lanes, or a junction's disc), not a driveway's,
## a service lane's or a car park's: where people do not walk but on a zebra
func _on_street(p: Vector2) -> bool:
	var hit := _nearest_seg(p, 14.0, true)
	if not hit.is_empty() and float(hit["edge"]) < 0.0 and _kerbed(_roads[int(hit["road"])]):
		return true
	return _in_junction(p, 0.0)

## nothing round (a tree, a lamp, a sign) stands within `d` metres of p
func _clear_of_posts(p: Vector2, d: float) -> bool:
	for i: int in _near(_post_hash, p, d, BLD_CELL):
		if _posts[i].distance_to(p) < d:
			return false
	return true

## for scripts that build meshes the game's way (furniture.gd)
func new_buf() -> Buf:
	return Buf.new()

func new_cbuf(cell: float) -> CBuf:
	return CBuf.new(cell)

## Thin walls the car and people bump into: fences and railings, hedges, the low garden walls,
## a bus shelter's back. They had no collision at all -- not for performance, they were just
## never added -- and the car drove through them.
var _walls := PackedVector2Array()   ## two points a wall
var _wall_r := PackedFloat32Array()  ## half its thickness
var _wall_soft := PackedByteArray()  ## 1: a hedge, that gives (no dent, no glass, leaves fly)
var _wall_give := PackedByteArray()  ## 1: the car breaks through at speed (a railing, a low wall, a hedge: _smash)
var _wall_hash := {}

## `gives`: light enough that the car goes through it at speed rather than stopping -- a kerb
## railing, a garden wall under knee height, a hedge (the user, 22 Nov 2026: "things bit more
## breakable that dont completely stop us"). Tall fences and building walls do not.
func add_wall(a: Vector2, b: Vector2, half: float, soft := false, gives := false) -> void:
	if a.distance_squared_to(b) < 0.0001:
		return
	var i := _wall_r.size()
	_walls.append(a)
	_walls.append(b)
	_wall_r.append(half)
	_wall_soft.append(1 if soft else 0)
	_wall_give.append(1 if (gives or soft) else 0)
	_hash_add(_wall_hash, Rect2(a, Vector2.ZERO).expand(b).grow(half), BLD_CELL, i)

## a post as big as r already stands within 0.3 m of p (see _add_post's `unique`)
func _post_twin(p: Vector2, r: float) -> bool:
	for j: int in _near(_post_hash, p, 0.3, BLD_CELL):
		if is_equal_approx(_post_r[j], r) and _posts[j].distance_to(p) < 0.3:
			return true
	return false

var _post_from: Array = []   ## (POSTS_FROM=1 only: who put each post up, for tests/posts_twice_where.gd)
static var _posts_from_on := OS.get_environment("POSTS_FROM") != ""

## `unique`: not when a post as big already stands within 0.3 m (false back, nothing added) --
## the same thing put up twice on one spot, twice the checks (city_check's "posts twice":
## a building's stilts laid by two of its parts, two railings' end posts, a garden's greenery
## laid by both streets at a corner). Callers that draw the thing skip drawing it then too.
## Not for callers that keep the new post's index (_posts.size() before the call: signs, bins,
## bollards to knock over): a post left out would hand them the next one's.
func _add_post(p: Vector2, r: float, unique := false) -> bool:
	if unique and _post_twin(p, r):
		return false
	var i := _posts.size()
	if _posts_from_on:
		var st := get_stack()
		var who := ""
		for k in range(1, mini(st.size(), 4)):
			who += "%s:%d " % [String(st[k]["function"]), int(st[k]["line"])]
		_post_from.append(who)
	_posts.append(p)
	_post_r.append(r)
	_hash_add(_post_hash, Rect2(p, Vector2.ZERO).grow(r), BLD_CELL, i)
	return true

## A parked car as solid ground: five posts along it. It was two, 0.85 m round at 1.25 m
## either side of its middle -- 2.5 m apart, a 0.8 m gap between them, and a person (0.25 m)
## fitted in it: walkers on a pavement with cars parked half up on it went in at the car's
## nose, came out of its door and back in at its boot. With one more in the middle, the
## scallops between three round posts still let a shoulder 0.2-0.35 m into the car's side
## (tests/walk_people.gd); five, 0.7 m apart, the end ones at 1.4 m (reaching 2.25 m, a
## car's own half-length: at 1.25 its front and back wings were 0.17-0.27 m short), leave
## about 0.1 m. All 0.85 m: city_check knows a parked car's posts by that, and they reach
## into the road by design. (The end two first: tests find a parked car as that pair.)
func _add_car_posts(c: Vector2, along: Vector2) -> void:
	_add_post(c + along * 1.4, 0.85)
	_add_post(c - along * 1.4, 0.85)
	for k: float in [-0.7, 0.0, 0.7]:
		_add_post(c + along * k, 0.85)
	var i := _car_box_c.size()
	_car_box_c.append(c)
	_car_box_u.append(along.normalized())
	_hash_add(_car_box_hash, Rect2(c, Vector2.ZERO).grow(2.4), BLD_CELL, i)

## Out of a parked car's own outline, for the people, the dogs and the pushchairs: 4.5 x
## 1.84 m, the corners rounded 0.3 m. Its posts are round, and left its corners and wings a
## shoulder's width open (0.15 m: tests/walk_people.gd). (The car and you on foot still go
## by the posts: a box's corners would be new things to scrape past on a narrow street.)
var _car_box_c := PackedVector2Array()
var _car_box_u := PackedVector2Array()
var _car_box_hash := {}
const CAR_BOX := Vector2(2.25, 0.92)   ## half length, half width
const CAR_BOX_ROUND := 0.3

## how far point q is from the car's body standing at `at` (facing as it does now): 0 inside
func _body_gap(q: Vector2, at: Vector2) -> float:
	var u := _fwd()
	var d := q - at
	var ex := absf(d.dot(u)) - CAR_LEN * 0.5
	var ey := absf(d.dot(Vector2(-u.y, u.x))) - CAR_WIDTH * 0.5
	return Vector2(maxf(ex, 0.0), maxf(ey, 0.0)).length()

func _car_box_push(c: Vector2, r: float) -> Vector2:
	var push := Vector2.ZERO
	for i: int in _near(_car_box_hash, c, r, BLD_CELL):
		var q := c + push - _car_box_c[i]
		var u := _car_box_u[i]
		var v := Vector2(-u.y, u.x)
		var a := q.dot(u)
		var b := q.dot(v)
		var ex := absf(a) - (CAR_BOX.x - CAR_BOX_ROUND)
		var ey := absf(b) - (CAR_BOX.y - CAR_BOX_ROUND)
		var out := Vector2(maxf(ex, 0.0), maxf(ey, 0.0))
		var dist := out.length() + minf(maxf(ex, ey), 0.0) - CAR_BOX_ROUND   # (signed: inside, below 0)
		if dist >= r:
			continue
		var sa := 1.0 if a >= 0.0 else -1.0
		var sb := 1.0 if b >= 0.0 else -1.0
		var n := (u * sa * out.x + v * sb * out.y).normalized() if out != Vector2.ZERO else (u * sa if ex > ey else v * sb)
		push += n * (r - dist)
	return push

var _light_far: Array = []   ## [pole, junction, way in] put up by _build_signals' second round of spots

## a traffic light on the right of every way into a signalled junction, in two groups by
## direction so crossing streets take turns
func _build_signals() -> void:
	var med := String(_place.get("look", "")) == "med"
	var poles: Array = []
	var heads: Array = []
	var bulbs: Array = [[[], [], []], [[], [], []]]
	for node: int in _tile_lit.get(_tile, []):
		if _over():
			await _pause()
		var c := _nodes[node]
		var rn := _node_r[node]
		for way: Array in _sig_line.get(node, []):
			if way[3]:
				continue   # from the junction's own other point: through, no light (see _lights_setup)
			var dir: Vector2 = way[0]
			var r: Dictionary = _roads[int(way[2])]
			var right := Vector2(-dir.y, dir.x)
			var reach := float(r["w"]) * 0.5 + 0.8
			_stop_lines.append([c, dir, float(way[1]), float(r["w"]), r["o"] != 0, ""])
			# the pole on the right at the corner; where that is a wall or another road (a
			# driveway, a slip road), further back along the kerb, then a little further from it;
			# on a one-way road (a divided road's half: its median) the left will do. A way in
			# with no pole had cars stopping for a light nobody could see.
			# A way in on a bridge's deck (a ramp landing at the junction, a slip road meeting
			# one up on its embankment): tried at the ground's level, every spot beside it was
			# the road below or the deck's own wall, and cars stopped for a light with no pole
			# (Tel Aviv's Modai bridge, the HaShalom interchange). There the pole stands on the
			# parapet's line at the deck's height, kept out of other roads' lanes at that level.
			var deck: bool = r.has("ys") and r.has("side")
			if deck:
				reach = float(r["w"]) * 0.5 + float(r["side"]) + Decks.WALL_T * 0.5
			var spots: Array = []
			for out: float in ([0.0] if deck else [0.0, 0.8]):
				for sgn: float in ([1.0, -1.0] if r["o"] != 0 else [1.0]):
					for back: float in [rn + 1.5, float(way[1]) + 0.6, float(way[1]) + 3.0, float(way[1]) + 6.0]:
						spots.append([back, (reach + out) * sgn])
			var p := Vector2.INF
			var py := NAN
			for sp: Array in spots:
				var q := c - dir * float(sp[0]) + right * float(sp[1])
				if deck:
					var ly: float = _decks.deck_y(int(way[2]), q)
					var on_d := _nearest_seg(q, 12.0, true, false, ly)
					if not on_d.is_empty() and int(on_d["road"]) != int(way[2]) and float(on_d["edge"]) < 0.4:
						continue
					p = q
					py = ly
					break
				if _push_out(q, 0.3, false) != Vector2.ZERO:
					continue
				var on := _nearest_seg(q, 12.0, true)
				if not on.is_empty() and float(on["edge"]) < 0.4:
					continue   # never plant it in a lane
				if _in_corner_fill(q, 0.15):
					continue   # nor on a rounded corner's asphalt (the first spot, at the corner,
					           # often was: city_check, 32 of Givatayim's 40 posts on the road)
				p = q
				break
			if p == Vector2.INF and not spots.is_empty():
				# none clear: the corner's spot, moved off its asphalt onto its pavement -- a way
				# in with no pole had cars stopping for a light nobody could see
				var q0 := _out_of_corner(c - dir * float(spots[0][0]) + right * float(spots[0][1]), 0.3)
				var on0 := _nearest_seg(q0, 12.0, true)
				if _push_out(q0, 0.3, false) == Vector2.ZERO and (on0.is_empty() or float(on0["edge"]) >= 0.4):
					p = q0
			if p == Vector2.INF and not deck:
				# still none: further out onto the pavement, on a two-way road the left kerb too
				# (a pole facing in from there reads as the same light), and last across the
				# junction, a far-side light facing the way in (never further back than the
				# spots above: behind the stop line a waiting driver has gone past it). Tel Aviv
				# had 12 ways in with no pole, a wall, a slip road or a driveway's lane at every
				# spot above (light_audit, 21 Nov).
				var backs: Array = [rn + 1.5, float(way[1]) + 0.6, float(way[1]) + 3.0, maxf(rn * 0.5, 1.0),
					-(rn + 1.5), -(rn + 4.0)]
				for out: float in [0.0, 0.8, 1.6, 2.4]:
					for back: float in backs:
						for sgn: float in [1.0, -1.0]:
							if p != Vector2.INF:
								break
							if out <= 0.8 and back > 0.0 and back != maxf(rn * 0.5, 1.0) and (sgn > 0.0 or r["o"] != 0):
								continue   # (tried above)
							var q := c - dir * back + right * (reach + out) * sgn
							if _push_out(q, 0.3, false) != Vector2.ZERO or _in_corner_fill(q, 0.15):
								continue
							var on := _nearest_seg(q, 12.0, true)
							if not on.is_empty() and float(on["edge"]) < 0.4:
								continue
							p = q
				if p != Vector2.INF:
					_tally("lights_far_spot", 1)
					_light_far.append([p, c, dir])   # (tests/far_lights.gd looks at them)
			if p == Vector2.INF:
				_tally("lights_no_spot", 1)
				continue
			var g := _light_group(node, dir) - 1
			# one pole where two would stand: two ways in arriving side by side (a road and the
			# lane beside it mapped apart) each put one up, a metre apart, facing the same way
			# (Tel Aviv 3; city_check's "lights doubled"). Only for the same group: the ways in
			# still stop at their own lines, the light the first one's.
			var twin := false
			for o: int in _near(_light_poles, p, 3.0, SEG_CELL):
				var tw: Array = _light_spots[o]
				twin = twin or (Vector2((tw[0] as Vector3).x, (tw[0] as Vector3).z).distance_to(p) < 3.0
					and (tw[1] as Vector2).dot(-dir) > 0.95 and int(tw[2]) == g)
			if twin:
				_tally("lights_twins", 1)
				continue
			_hash_add(_light_poles, Rect2(p, Vector2.ZERO), SEG_CELL, _light_spots.size())
			var face := Basis(Vector3.UP, atan2(-dir.x, -dir.y))   # +Z of the head toward the traffic
			var gy := _h(p) if is_nan(py) else py
			poles.append(Transform3D(Basis(), Vector3(p.x, gy + 1.7, p.y)))
			heads.append(Transform3D(face, Vector3(p.x, gy + 3.3, p.y)))
			_light_spots.append([Vector3(p.x, gy + 3.3, p.y), -dir, g])   # (for tests: where, facing, group)
			# the blue crossing sign strapped to the pole under the light, as in Israel
			# (Nova Scotia's lights carry walk signals instead): the zebra is just past it
			if med:
				_pole_plates.append(["crossing", Transform3D(face * Basis.from_scale(Vector3.ONE * SIGN_SCALE),
						Vector3(p.x, gy + 2.25, p.y) + Vector3(-dir.x, 0.0, -dir.y) * 0.09)])
			var front := Vector3(-dir.x, 0.0, -dir.y) * 0.17
			for ci in range(3):
				bulbs[g][ci].append(Vector3(p.x, gy + 3.3 + 0.3 - 0.3 * ci, p.y) + front)
				_wave.lamp(_site_of.get(node, -1), "car", g, ci, Vector3(p.x, gy + 3.3 + 0.3 - 0.3 * ci, p.y) + front)
			if is_nan(py) or py - _h(p) < 1.0:
				_add_post(p, 0.15)   # (posts are solid at the ground's level: not one up on a bridge)
	if poles.is_empty():
		return
	var pole_mesh := CylinderMesh.new()
	pole_mesh.top_radius = 0.06
	pole_mesh.bottom_radius = 0.08
	pole_mesh.height = 3.4
	pole_mesh.radial_segments = 6
	pole_mesh.material = _surface("pole")
	var head_mesh := BoxMesh.new()
	head_mesh.size = Vector3(0.34, 1.0, 0.3)
	head_mesh.material = _surface("pole")
	_chunked(pole_mesh, poles, LAMP_RANGE)
	_chunked(head_mesh, heads, LAMP_RANGE)
	for g in range(2):
		for ci in range(3):
			if not (bulbs[g][ci] as Array).is_empty():
				_add_bulbs(g, ci, bulbs[g][ci])
	_build_walk_lights(pole_mesh)

var _bulb_mm: Array = []             ## [group][colour] -> the one multimesh of those bulbs, city-wide
var _bulb_at: Array = []             ## [group][colour] -> their transforms, 12 numbers a bulb

## The bulbs of one colour of one group: one multimesh across the whole city, grown square by
## square (a multimesh a square was a hundred more draws, the bulbs having no draw range).
func _add_bulbs(g: int, ci: int, at: Array) -> void:
	if _bulb_mm.is_empty():
		var bulb := SphereMesh.new()
		bulb.radius = 0.11
		bulb.height = 0.22
		bulb.radial_segments = 6
		bulb.rings = 2
		for gg in range(2):
			var mms: Array = []
			var ats: Array = []
			for c in range(3):
				var mm := MultiMesh.new()
				mm.transform_format = MultiMesh.TRANSFORM_3D
				mm.mesh = bulb
				var mi := MultiMeshInstance3D.new()
				mi.multimesh = mm
				mi.material_override = _sig_mats[gg][c]
				mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
				world.add_child(mi)
				mms.append(mm)
				ats.append(PackedFloat32Array())
			_bulb_mm.append(mms)
			_bulb_at.append(ats)
	var buf: PackedFloat32Array = _bulb_at[g][ci]
	for p: Vector3 in at:
		buf.append_array([1.0, 0.0, 0.0, p.x, 0.0, 1.0, 0.0, p.y, 0.0, 0.0, 1.0, p.z])
	_bulb_at[g][ci] = buf
	var mm: MultiMesh = _bulb_mm[g][ci]
	mm.instance_count = buf.size() / 12
	mm.buffer = buf

## Which junctions have lights, for the whole city at once (traffic and autodrive stop at
## them wherever they are; the poles go up square by square).
##
## A junction with lights is a SITE. OSM draws one junction as several points -- each half of
## a divided road meets the cross street at its own, 10-30 m apart, two divided roads crossing
## at four -- and maps a light on one approach only, often a few metres out. Each mapped light
## is taken to the junction it stands at (the nearest within 40 m along its road), the other
## half of a divided road joins its lit half, and lit points joined by a short piece of road
## are one site. Its two groups go by direction across the whole site (_light_group); its
## ways in from outside get the lights and the stop lines; a car that has come into it goes
## through all of it. (Each point used to pick its own main road by name: a road that changes
## name at a junction was in the same group as the street across it, and green at one point
## of a divided road's junction was red at the next, 10 m on, which cars drove through.) A
## light far from any junction (a crossing mid-street) is a site of its own.
func _lights_setup() -> void:
	var lit := {}
	for ni in _city_data.get("signals", []):
		var node := int(ni)
		if node < 0 or node >= _nodes.size():
			continue
		var j := _junction_of(node, 40.0)
		lit[j if j >= 0 else node] = true
	# the other halves of divided roads (twice over: two divided roads crossing are four points)
	for _pass in range(2):
		var more: Array = []
		for j: int in lit:
			for leg: Array in _site_legs(j):
				if not lit.has(leg[0]) and _other_half(j, int(leg[0]), int(leg[1])):
					more.append(leg[0])
		for o: int in more:
			lit[o] = true
	# lit points a short piece of road apart: one site -- the shortest pieces first, and never
	# wider than SITE_SPAN (a chain of them made one "junction" of two, 66 m across, that a
	# car drove all of on one green)
	var legs: Array = []
	var members := {}
	var up := {}
	for j: int in lit:
		up[j] = j
		members[j] = [j]
		for leg: Array in _site_legs(j):
			if lit.has(leg[0]) and int(leg[0]) > j:
				legs.append([j, leg[0], leg[2]])
	legs.sort_custom(func(x, y): return x[2] < y[2])
	for leg: Array in legs:
		var a := _site_root(up, leg[0])
		var b := _site_root(up, leg[1])
		if a == b:
			continue
		var wide := 0.0
		for p: int in members[a]:
			for q: int in members[b]:
				wide = maxf(wide, _nodes[p].distance_to(_nodes[q]))
		if wide > SITE_SPAN:
			continue
		up[a] = b
		(members[b] as Array).append_array(members[a])
		members.erase(a)
	# lit points close together that no short piece of road joins -- the two halves of a
	# divided road's crossing mid-street, each half a crossing of its own -- are one: the
	# halves ran their own phases, green on one and red on the other for someone crossing
	# (city_check's "split junctions": six on Sderot Herzl in Ashdod, 8-16 m apart)
	var lit_keys: Array = lit.keys()
	for ai in range(lit_keys.size()):
		for bi in range(ai + 1, lit_keys.size()):
			var pa: int = lit_keys[ai]
			var pb: int = lit_keys[bi]
			if _nodes[pa].distance_to(_nodes[pb]) > 16.0:
				continue
			var ra := _site_root(up, pa)
			var rb := _site_root(up, pb)
			if ra == rb:
				continue
			var span := 0.0
			for p: int in members[ra]:
				for q: int in members[rb]:
					span = maxf(span, _nodes[p].distance_to(_nodes[q]))
			if span > SITE_SPAN:
				continue
			up[ra] = rb
			(members[rb] as Array).append_array(members[ra])
			members.erase(ra)
	_sites = []
	for rt: int in members:
		for n: int in members[rt]:
			_site_of[n] = _sites.size()
		_sites.append(_site_axes(members[rt]))
	# two sites a short piece of road apart: that road in the same group at both (either group
	# can go first, so one site's are swapped if need be) -- or a car let through by one's
	# green met the other's red 30 m on and queued back across the first
	var settled := {}
	for leg: Array in legs:
		var sa: int = _site_of[leg[0]]
		var sb: int = _site_of[leg[1]]
		if sa == sb:
			continue
		var dir := (_nodes[leg[1]] - _nodes[leg[0]]).normalized()
		if _light_group(leg[0], dir) != _light_group(leg[1], dir):
			for sx: int in [sb, sa]:
				if not settled.has(sx):
					_sites[sx]["flip"] = true
					break
		settled[sa] = true
		settled[sb] = true
	_lit = lit
	for node: int in lit:
		_sig_set[node] = true
		_hash_add(_sig_hash, Rect2(_nodes[node], Vector2.ZERO), SEG_CELL, node)
		_sig_line[node] = _site_ways_in(node)   # (before any square puts up its poles)
		_bucket(_tile_lit, _tile_of(_nodes[node]), node)
	if lit.is_empty():
		return
	# the bulbs' colours, shared by every square's lights and switched together
	_sig_mats = []
	for g in range(2):
		var mats: Array = []
		for ci in range(3):
			var m := StandardMaterial3D.new()
			m.roughness = 0.4
			mats.append(m)
		_sig_mats.append(mats)
	_ped_mats = []
	for g in range(2):
		var mats: Array = []
		for ci in range(2):
			var m := StandardMaterial3D.new()
			m.roughness = 0.4
			mats.append(m)
		_ped_mats.append(mats)
	_apply_signals()

## People's lights at each zebra by a junction with lights: a short pole at each end of the
## crossing with a head looking across at whoever waits on the other side -- the red man over
## the green man -- in step with the cars' lights (see _apply_signals). People at those
## crossings go by them (_walk_light).
var _ped_mats: Array = []            ## [group][0 red man, 1 green man]
var _light_spots: Array = []         ## [head, the way it faces, group] of the cars' lights (for tests)
var _light_poles := {}               ## cell -> index into _light_spots (one pole where two would stand)
var _walk_spots: Array = []          ## [head, the way it faces] of the people's lights
var _walk_poles := {}                ## cell -> index into _walk_spots (one pole where two would stand)

var _lit := {}                       ## junctions with lights (all of them, from _lights_setup)

## the lit point a zebra's walk lights go by: the nearest within 30 m, or -1 (no walk lights).
## The walk lights and the people waiting at them both ask this.
func _zebra_light(ni: int) -> int:
	var j := -1
	var jd := 30.0
	for n: int in _near(_sig_hash, _nodes[ni], 30.0, SEG_CELL):
		if _nodes[n].distance_to(_nodes[ni]) < jd:
			jd = _nodes[n].distance_to(_nodes[ni])
			j = n
	return j
var _walk_mm: Array = []             ## [group][0 red, 1 green] -> one multimesh of those lamps, city-wide
var _walk_at: Array = []

func _build_walk_lights(pole_mesh: Mesh) -> void:
	var poles: Array = []
	var heads: Array = []
	var lamps: Array = [[[], []], [[], []]]
	for ni: int in _crossing_nodes:
		if not _mine(_nodes[ni]):
			continue   # (each zebra's lights put up by the square it is in, once)
		var z := _zebra_geom(ni)
		if z.is_empty():
			continue
		var j := _zebra_light(ni)
		if j < 0:
			continue
		var span := _zebra_span(z)
		if span.is_empty():
			continue
		var g := _light_group(j, z[3]) - 1
		for k in range(2):
			var here: Vector2 = span[k]
			var there: Vector2 = span[1 - k]
			var across := (there - here).normalized()
			var p := here - across * 0.35
			if _push_out(p, 0.3, true, false) != Vector2.ZERO:
				continue
			# one pole where two would stand: a divided road's zebra is a crossing point on each
			# half, each spanning both, so every pole came twice half a metre apart, facing the
			# same way (94 of Ashdod's 408 -- "two red lights to the same direction for the
			# people"); and two crossings in line can start from one kerb
			var twin := false
			for o: int in _near(_walk_poles, p, 3.0, SEG_CELL):
				var tw: Array = _walk_spots[o]
				twin = twin or (Vector2((tw[0] as Vector3).x, (tw[0] as Vector3).z).distance_to(p) < 3.0 and (tw[1] as Vector2).dot(across) > 0.7)
			if twin:
				_tally("walk_lights_twins", 1)
				continue
			_hash_add(_walk_poles, Rect2(p, Vector2.ZERO), SEG_CELL, _walk_spots.size())
			var gy := _h(p)
			var face := Basis(Vector3.UP, atan2(across.x, across.y))   # +Z toward the far kerb
			poles.append(Transform3D(Basis.from_scale(Vector3(0.8, 2.7 / 3.4, 0.8)), Vector3(p.x, gy + 1.35, p.y)))
			heads.append(Transform3D(face * Basis.from_scale(Vector3(0.7, 0.55, 0.6)), Vector3(p.x, gy + 2.55, p.y)))
			_walk_spots.append([Vector3(p.x, gy + 2.55, p.y), across])
			var front := Vector3(across.x, 0.0, across.y) * 0.1
			lamps[g][0].append(Vector3(p.x, gy + 2.67, p.y) + front)
			lamps[g][1].append(Vector3(p.x, gy + 2.43, p.y) + front)
			_wave.lamp(_site_of.get(j, -1), "walk", g, 0, Vector3(p.x, gy + 2.67, p.y) + front)
			_wave.lamp(_site_of.get(j, -1), "walk", g, 1, Vector3(p.x, gy + 2.43, p.y) + front)
			_add_post(p, 0.1)
	_tally("walk_lights", poles.size())
	if poles.is_empty():
		return
	_chunked(pole_mesh, poles, LAMP_RANGE)
	var head_mesh := BoxMesh.new()
	head_mesh.size = Vector3(0.34, 1.0, 0.3)
	head_mesh.material = _surface("pole")
	_chunked(head_mesh, heads, LAMP_RANGE)
	if _walk_mm.is_empty():
		var bulb := SphereMesh.new()
		bulb.radius = 0.08
		bulb.height = 0.16
		bulb.radial_segments = 6
		bulb.rings = 2
		for gg in range(2):
			var mms: Array = []
			var ats: Array = []
			for c in range(2):
				var mm := MultiMesh.new()
				mm.transform_format = MultiMesh.TRANSFORM_3D
				mm.mesh = bulb
				var mi := MultiMeshInstance3D.new()
				mi.multimesh = mm
				mi.material_override = _ped_mats[gg][c]
				mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
				world.add_child(mi)
				mms.append(mm)
				ats.append(PackedFloat32Array())
			_walk_mm.append(mms)
			_walk_at.append(ats)
	for g in range(2):
		for c in range(2):
			if (lamps[g][c] as Array).is_empty():
				continue
			var buf: PackedFloat32Array = _walk_at[g][c]
			for p: Vector3 in lamps[g][c]:
				buf.append_array([1.0, 0.0, 0.0, p.x, 0.0, 1.0, 0.0, p.y, 0.0, 0.0, 1.0, p.z])
			_walk_at[g][c] = buf
			var mm: MultiMesh = _walk_mm[g][c]
			mm.instance_count = buf.size() / 12
			mm.buffer = buf


## a lit shopfront on the street side of each shop's building, and its name above it
func _build_pois() -> void:
	var k := 1.0 / float(_city_data.get("scale", 10))
	var front := {"glass": [], "glass_k": [], "post": [], "beam": [], "shutter": [], "housing": []}   ## shop windows and their frames (glass_k: what is inside, SHOP_SHADER)
	var board_cols: Array = []       ## each sign board's colour: dark, white, the shop's, cream
	var awnings := {"xf": [], "col": []}   ## awning transforms and their colours
	var crates := new_cbuf(BLD_CELL)    ## fruit and vegetables out in front of a greengrocer
	var bulbs: Array = []               ## string lights' bulbs (a shop's look: "lights")
	var crosses: Array = []          ## pharmacy crosses, sticking out from the wall
	var canopy := {"roof": [], "pillar": [], "pump": [], "band": []}   ## gas stations
	var boards: Array = []           ## the sign boards behind the names
	var terrace := {"top": [], "leg": [], "seat": [], "back": [], "pole": []}
	var shades := {"xf": [], "col": []}   ## umbrellas and their colours
	var taken := _poi_taken          ## a facade spot already used -> how many there
	var all_pois: Array = _city_data.get("pois", [])
	for pi: int in _tile_pois.get(_tile, []):
		if _over():
			await _pause()
		var p: Array = all_pois[pi]
		var at := Vector2(p[0], p[1]) * k
		var kind := String(p[2])
		if kind in ["shop:vacant", "shop:disused", "shop:no"] or String(p[3]).to_lower() == "vacant":
			continue   # an empty shop: OSM keeps it on the map, and its sign read "vacant"
		var look: Array = _poi_look(kind)
		if look.is_empty():
			continue   # e.g. parking entrances that came in on an address point
		var shop: Dictionary = _details.shop_look(p, k) if _details != null else {}
		var role: String = look[0]
		var spot := _facade_spot(at)
		var pos: Vector2 = spot[0]
		var n: Vector2 = spot[1]
		var along := Vector2(-n.y, n.x)
		var key := Vector2i((pos / 2.0).round())
		var dup: int = taken.get(key, 0)
		taken[key] = dup + 1
		pos += along * 6.0 * float((dup + 1) / 2) * (1.0 if dup % 2 == 1 else -1.0)
		var face := atan2(n.x, n.y)
		var sub := kind.substr(5) if kind.begins_with("shop:") else ""
		var gy := _h(pos + n * 0.6)
		var station := Vector2.INF
		if kind == "fuel":
			# OSM marks most stations by a point in the shop building: the canopy goes out
			# front, between the building and the street, wherever there is room for it
			for c: Vector2 in [pos + n * 6.0, pos + n * 8.0, at]:
				var on := _nearest_seg(c, 15.0, true)
				if _push_out(c, 3.2, false) == Vector2.ZERO and (on.is_empty() or float(on["edge"]) > 1.5) \
						and _station_fits(c, n):
					_gas_station(c, n, canopy)
					station = c
					break
		elif spot[2]:
			# a shop window with the light on inside, a dark frame, an awning over it
			var wide := 2.0 if WIDE_SHOPS.has(sub) else 1.0
			var b := Basis(Vector3.UP, face)
			var at3 := func(q: Vector2, out: float, y: float) -> Vector3: return Vector3(q.x + n.x * out, gy + y, q.y + n.y * out)
			front["glass"].append(Transform3D(b * Basis.from_scale(Vector3(wide, 1, 1)), at3.call(pos, 0.05, 1.3)))
			# what the window shows inside: a counter (cafes, bars, restaurants), racks of
			# clothes, or shelves of goods (the rest)
			var inside_k := 1.0 if kind in ["cafe", "restaurant", "fast_food", "ice_cream", "bar", "pub"] else \
				(0.6 if sub in ["clothes", "shoes", "fashion", "boutique", "jewelry", "bag", "fabric"] else 0.0)
			front["glass_k"].append(Color(inside_k, 0.0, 0.0, 1.0))
			if _mine(pos):
				_shop_lights.append([pos + n * 0.1, n, wide])
			front["beam"].append(Transform3D(b * Basis.from_scale(Vector3(wide, 1, 1)), at3.call(pos, 0.08, 2.62)))
			for sgn: float in [-1.0, 1.0]:
				front["post"].append(Transform3D(b, at3.call(pos + along * 1.56 * wide * sgn, 0.08, 1.3)))
			var hue: String = role if kind != "shop" and sub == "" else AWNINGS[posmod(_hash_i(at), AWNINGS.size())]
			var look_k := posmod(_hash_i(at) >> 4, 100)
			var awn := String(shop.get("awning", "")) if not shop.is_empty() else ""
			if awn != "none" and (look_k >= 28 or awn != ""):   # most have an awning; some just the sign over the window
				(awnings["xf"] as Array).append(Transform3D(b * Basis(Vector3.RIGHT, 0.33) * Basis.from_scale(Vector3(wide, 1, 1)), at3.call(pos, 0.72, 2.9)))
				(awnings["col"] as Array).append(_real_col(awn) if awn != "" else _awning_col(hue, at))
			var has_crates: bool = shop.get("crates", sub in ["greengrocer", "convenience", "kiosk"] and look_k < 70)
			if has_crates:
				_crates(crates, pos, n, along, gy, wide)
			elif look_k >= 10 and look_k < 50 and kind.begins_with("shop"):   # open: an A-frame board out front
				_a_board(crates, pos + n * 1.15 + along * (1.25 * wide), n, along, gy, look_k)
			if look_k >= 10 and _mine(pos):   # (not a shut one) a shopkeeper may stand in its door
				_shop_spots.append([pos + n * 0.5 + along * (0.6 if look_k % 2 == 0 else -0.6), n])
			if shop.get("lights", false):
				_string_lights(crates, bulbs, pos, n, along, gy)
			if look_k < 10 and kind.begins_with("shop"):   # shut: the roller shutter down
				front["shutter"].append(Transform3D(b * Basis.from_scale(Vector3(wide, 1, 1)), at3.call(pos, 0.1, 1.3)))
			# the roller shutter's box over the window, as most of the towns' shops have it
			# rolled up into (a grey metal box the window's width); every shut one has one
			if look_k < 10 or posmod(_hash_i(at) >> 13, 100) < 75:
				front["housing"].append(Transform3D(b * Basis.from_scale(Vector3(wide, 1, 1)), at3.call(pos, 0.2, 2.86)))
			if kind == "pharmacy":
				crosses.append(Transform3D(b, at3.call(pos + along * (1.6 * wide + 0.5), 0.5, 3.2)))
		if spot[2] and kind in ["cafe", "restaurant", "fast_food", "ice_cream", "bar", "pub"] and String(shop.get("seats", "")) != "none":
			var umb := String(shop.get("umbrella", ""))
			_terrace(pos, n, along, _awning_col(role, at + Vector2(3, 0)) if umb == "" else _real_col(umb), terrace, shades,
				String(shop.get("seats", "tables")), umb != "none")
		var name := String(p[3]) if String(p[3]) != "" else (String(p[4]) if String(p[4]) != "" else String(look[1]))
		name = String(shop.get("sign", name))   # (a name filmed or told, where the map has none)
		var sign := Label3D.new()
		sign.text = name
		sign.font = _font
		sign.font_size = 64
		sign.pixel_size = 0.011
		sign.outline_size = 8
		sign.modulate = Palette.col(role)
		sign.outline_modulate = Palette.col("bg")
		var sy := gy + (3.75 if spot[2] else 2.7)
		if station.is_finite():   # the name on the canopy's street edge
			pos = station + n * 3.05
			sy = _h(station) + 5.45
		sign.position = Vector3(pos.x + n.x * 0.16, sy, pos.y + n.y * 0.16)
		sign.rotation.y = face
		var tw := _font.get_string_size(name, HORIZONTAL_ALIGNMENT_LEFT, -1, 64).x * 0.011
		boards.append(Transform3D(Basis(Vector3.UP, face) * Basis.from_scale(Vector3(maxf(tw + 0.5, 2.0), 1.0, 1.0)),
			Vector3(pos.x + n.x * 0.1, sy, pos.y + n.y * 0.1)))
		var bk := posmod(_hash_i(at) >> 9, 100)
		board_cols.append(_real_col(String(shop["board"])) if shop.has("board") else (_tone["board"] if bk < 45 else (_tone["mark"] if bk < 68 else
			(Palette.col(role).lerp(Palette.col("bg"), 0.55) if bk < 86 else _tone["wall3"]))))
		sign.double_sided = false
		sign.visibility_range_end = SIGN_RANGE
		sign.set_meta("role", role)
		world.add_child(sign)
		_pois.append([at, role, sign])
		if not _life.is_empty():   # (built after the people's map of where life is: it counts there too)
			var lk := _cell(at, LIFE_CELL)
			_life[lk] = float(_life.get(lk, 0.0)) + 4.0
	if not boards.is_empty():
		var plate := BoxMesh.new()
		plate.size = Vector3(1.0, 0.95, 0.08)
		var bmat := _vc_mat()   # each board's own colour (instance colour)
		# cut into squares like everything else (one multimesh across the city is culled by
		# the middle of its box, and the boards vanished away from the town centre)
		_chunked(plate, boards, SIGN_RANGE * 3.0, board_cols, bmat)
	_terrace_meshes(terrace, shades)
	_tally("tables", (terrace["top"] as Array).size())
	_tally("shops", (front["glass"] as Array).size())
	var r := SIGN_RANGE * 2.0
	var glass := BoxMesh.new()
	glass.size = Vector3(3.0, 2.4, 0.06)
	_chunked(glass, front["glass"], r, front["glass_k"], _shop_interior(), false)
	var post := BoxMesh.new()
	post.size = Vector3(0.14, 2.6, 0.14)
	_chunked(post, front["post"], r, [], _surface("cartrim"), false)
	var beam := BoxMesh.new()
	beam.size = Vector3(3.26, 0.2, 0.16)
	_chunked(beam, front["beam"], r, [], _surface("cartrim"), false)
	if not (front["shutter"] as Array).is_empty():
		var shut := BoxMesh.new()
		shut.size = Vector3(3.0, 2.4, 0.05)
		_chunked(shut, front["shutter"], r, [], _surface("shutter"), false)
	if not (front["housing"] as Array).is_empty():
		var hb := BoxMesh.new()
		hb.size = Vector3(3.2, 0.3, 0.3)
		_chunked(hb, front["housing"], r, [], _surface("shutter"), false)
	_tally("shutter_boxes", (front["housing"] as Array).size())
	var awning := BoxMesh.new()
	awning.size = Vector3(3.3, 0.14, 1.5)
	_chunked(awning, awnings["xf"], r, awnings["col"], _vc_mat(), true)
	_add_mesh(crates, _vc_mat(), true, SIGN_RANGE * 1.5)
	if not bulbs.is_empty():
		var bulb := SphereMesh.new()
		bulb.radius = 0.035
		bulb.height = 0.07
		bulb.radial_segments = 6
		bulb.rings = 3
		_chunked(bulb, bulbs, SIGN_RANGE * 1.5, [], mat("warn", 1.6))
	if not crosses.is_empty():
		var cross := ArrayMesh.new()
		var cb := Buf.new()
		_box(cb, Vector3.ZERO, Vector3(0.06, 0.78, 0.26))
		_box(cb, Vector3.ZERO, Vector3(0.06, 0.26, 0.78))
		cross.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, cb.arrays())
		_chunked(cross, crosses, r, [], mat("friend", 1.3), false)
	if not (canopy["roof"] as Array).is_empty():
		var roof := BoxMesh.new()
		roof.size = Vector3(9.0, 0.45, 6.0)
		_chunked(roof, canopy["roof"], r, [], _surface("tank"))
		var band := BoxMesh.new()
		band.size = Vector3(9.06, 0.2, 6.06)
		_chunked(band, canopy["band"], r, [], mat("player", 0.4), false)
		var pillar := BoxMesh.new()
		pillar.size = Vector3(0.3, 4.6, 0.3)
		_chunked(pillar, canopy["pillar"], r, [], _surface("tank"))
		var pump := BoxMesh.new()
		pump.size = Vector3(0.7, 1.6, 0.45)
		_chunked(pump, canopy["pump"], r, [], mat("player", 0.15))

## bus stops: a shelter with a glass back, a roof and a bench, and the stop's pole and
## sign, on the pavement facing the street, its name along the roof edge
func _build_stops() -> void:
	var k := 1.0 / float(_city_data.get("scale", 10))
	var parts := {"back": [], "roof": [], "post": [], "bench": [], "pole": [], "plate": []}
	var all_stops: Array = _city_data.get("stops", [])
	for si: int in _tile_stops.get(_tile, []):
		if _over():
			await _pause()
		var st: Array = all_stops[si]
		var at := Vector2(st[0], st[1]) * k
		var road := _nearest_seg(at, 30.0, true, true)
		if road.is_empty():
			continue
		var q: Vector2 = road["q"]
		var out := (at - q).normalized()
		if out == Vector2.ZERO:
			continue
		var r: Dictionary = _roads[road["road"]]
		var c := q + out * (float(r["w"]) * 0.5 + 1.9)   # on the pavement, whatever the map said
		if _push_out(c, 1.2, false) != Vector2.ZERO:
			continue
		var n := -out                                       # the shelter faces the street
		var along := Vector2(-n.y, n.x)
		if not (_off_road(c - n * 0.6 + along * 1.5, 0.3) and _off_road(c - n * 0.6 - along * 1.5, 0.3)
				and _off_road(c + along * 2.4 + n * 0.5, 0.3)):
			continue   # a corner where another road comes by
		var gy := _h(c)
		var b := Basis(Vector3.UP, atan2(n.x, n.y))
		var P := func(p: Vector2, y: float) -> Vector3: return Vector3(p.x, gy + y, p.y)
		parts["back"].append(Transform3D(b, P.call(c - n * 0.7, 1.25)))
		_hash_add(_stop_hash, Rect2(c, Vector2.ZERO), SEG_CELL, _stop_spots.size())
		_stop_spots.append(c)
		parts["roof"].append(Transform3D(b, P.call(c, 2.55)))
		for sgn: float in [-1.0, 1.0]:
			parts["post"].append(Transform3D(b, P.call(c - n * 0.7 + along * 1.5 * sgn, 1.25)))
		parts["bench"].append(Transform3D(b, P.call(c - n * 0.4, 0.45)))
		var pole := c + along * 2.4 + n * 0.5
		parts["pole"].append(Transform3D(b, P.call(pole, 1.4)))
		parts["plate"].append(Transform3D(b, P.call(pole, 2.45)))
		# a lit ad panel standing at the other end of the shelter, square to it
		var ad := c - along * 2.0 - n * 0.35
		if _off_road(ad, 0.3) and _push_out(ad, 0.5, false) == Vector2.ZERO and _clear_of_posts(ad, 1.0):
			_stop_ads.append(Transform3D(Basis(Vector3.UP, atan2(along.x, along.y)), P.call(ad, 0.0)))
			_add_post(ad, 0.6)
		_add_post(c - n * 0.6 + along * 1.5, 0.2, true)
		_add_post(c - n * 0.6 - along * 1.5, 0.2, true)
		add_wall(c - n * 0.7 + along * 1.5, c - n * 0.7 - along * 1.5, 0.08)   # its back
		_add_post(pole, 0.1)
		_add_post(pole, 0.12)
		var name := String(st[2])
		if name != "":
			var lb := Label3D.new()
			lb.text = name
			lb.font = _font
			lb.font_size = 40
			lb.pixel_size = 0.008
			lb.outline_size = 6
			lb.modulate = Palette.col("ink")
			lb.outline_modulate = Palette.col("bg")
			lb.position = P.call(c + n * 0.82, 2.42)
			lb.rotation.y = atan2(n.x, n.y)
			lb.double_sided = false
			lb.visibility_range_end = 60.0
			world.add_child(lb)
	if (parts["back"] as Array).is_empty():
		return
	var r := SIGN_RANGE * 1.6
	_chunked(_boxm(Vector3(3.2, 2.3, 0.05)), parts["back"], r, [], _shop_glass(), false)
	_chunked(_furn.bus_roof_kit(), parts["roof"], r)
	_chunked(_boxm(Vector3(0.08, 2.5, 0.08)), parts["post"], r, [], _surface("pole"))
	_chunked(_boxm(Vector3(2.0, 0.08, 0.42)), parts["bench"], r, [], _surface("furniture"))
	_chunked(_boxm(Vector3(0.07, 2.8, 0.07)), parts["pole"], r, [], _surface("pole"))
	_chunked(_furn.bus_sign_kit(), parts["plate"], r)
	_tally("bus_stops", (parts["back"] as Array).size())

func _boxm(size: Vector3) -> BoxMesh:
	var b := BoxMesh.new()
	b.size = size
	return b

## [colour role, word for an unnamed one] for a place's OSM kind; [] = not shown
func _poi_look(kind: String) -> Array:
	if POI_LOOK.has(kind):
		return POI_LOOK[kind]
	if kind.begins_with("shop:"):
		var t := kind.substr(5)
		return ["accent", SHOP_WORDS.get(t, t.replace("_", " "))]
	return []

## the glass of a shop window: dark glass with the shop's light on inside
## A shop window you see into: behind the glass a room 3.5 m deep, worked out from where you
## look (the ray from the eye through the glass to the room's back wall, its sides, floor
## or ceiling -- no geometry), with shelves of goods along the walls, or a cafe's counter
## and menu board, a tiled floor and a strip light, lit from inside (brighter at night), and
## the glass's own sheen of the sky over it. Each shop its own mix, from where it stands.
## (Was a flat lit pane: a shop showed nothing inside. One shader more for a browser to
## compile while loading, about 7 programs.)
const SHOP_SHADER := """
shader_type spatial;
uniform vec4 light : source_color;      // the shop's light (the tone "shoplight")
uniform vec4 floor_col : source_color;
uniform vec4 wall_col : source_color;
uniform vec4 shelf_col : source_color;
uniform vec4 goods_a : source_color;
uniform vec4 goods_b : source_color;
uniform vec4 goods_c : source_color;
uniform vec4 goods_d : source_color;
uniform vec4 sky_col : source_color;
uniform float lit = 0.7;
varying vec3 wpos;
varying vec3 o;
varying vec3 ax;
varying vec3 az;
varying float hw;
varying float kind;                     // the instance colour's red: 1 a cafe's counter, 0.6 clothes, 0 shelves
float h21(vec2 p) {
	vec3 q = fract(vec3(p.xyx) * 0.1031);
	q += dot(q, q.yzx + 33.33);
	return fract((q.x + q.y) * q.z);
}
void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	o = MODEL_MATRIX[3].xyz;
	ax = normalize(MODEL_MATRIX[0].xyz);
	az = normalize(MODEL_MATRIX[2].xyz);
	hw = length(MODEL_MATRIX[0].xyz) * 1.5;
	kind = COLOR.r;
}
// clothes on a rail along a wall: garments hanging side by side, each its own colour
vec3 racks(float s, float y, float seed) {
	if (y > 0.62 && y < 0.66) { return shelf_col.rgb * 0.5; }      // the rail
	if (y < -0.55 || y > 0.62) { return wall_col.rgb; }
	float cell = floor(s / 0.11);
	float k = h21(vec2(cell, seed));
	float len = mix(-0.5, 0.0, h21(vec2(cell * 3.1, seed)));
	if (y < len || k < 0.08) { return wall_col.rgb * 0.85; }
	vec3 g = k < 0.3 ? goods_a.rgb : (k < 0.5 ? wall_col.rgb * 0.3 : (k < 0.72 ? goods_d.rgb : wall_col.rgb * 0.9));
	return g * (0.7 + 0.3 * h21(vec2(cell, 9.0 + seed)));
}
// goods on shelves along a wall: s across it, y up (window's frame), seed the shop
vec3 shelves(float s, float y, float seed, float sparse) {
	float row = floor((y + 1.05) / 0.42);
	float in_row = fract((y + 1.05) / 0.42);
	if (y < -1.05 || y > 1.05) { return wall_col.rgb; }
	if (in_row < 0.09) { return shelf_col.rgb; }                  // the shelf board
	float w = mix(0.16, 0.34, h21(vec2(row, seed)));
	float cell = floor(s / w);
	float k = h21(vec2(cell * 1.7 + row * 13.1, seed));
	if (k < 0.12 + sparse * 0.5 || in_row > 0.55 + 0.4 * h21(vec2(cell, row + seed))) { return wall_col.rgb * 0.8; }
	vec3 g = k < 0.35 ? goods_a.rgb : (k < 0.55 ? goods_b.rgb : (k < 0.78 ? goods_c.rgb : goods_d.rgb));
	g = mix(g, wall_col.rgb * h21(vec2(cell * 5.3, row + seed)), 0.4);   // (packets, not paint chips)
	return g * (0.7 + 0.35 * h21(vec2(cell, row * 3.0 + seed)));
}
void fragment() {
	vec3 cam = CAMERA_POSITION_WORLD;
	vec3 rd = normalize(wpos - cam);
	vec3 q = vec3(dot(wpos - o, ax), wpos.y - o.y, dot(wpos - o, az));
	vec3 d = vec3(dot(rd, ax), rd.y, dot(rd, az));
	float seed = floor(h21(floor(o.xz * 0.5)) * 97.0);
	float cafe = step(0.8, kind);
	float clothes = step(0.4, kind) * (1.0 - cafe);
	vec3 inside = wall_col.rgb * 0.3;
	if (d.z < -0.01 && q.z > -0.02) {                             // in through the front of the glass
		float D = 3.5;
		float t = (-D - q.z) / d.z;
		int face = 0;                                              // 0 back, 1 side, 2 floor, 3 ceiling
		if (abs(d.x) > 1e-3) {
			float ts = (sign(d.x) * hw - q.x) / d.x;
			if (ts > 0.0 && ts < t) { t = ts; face = 1; }
		}
		if (abs(d.y) > 1e-3) {
			float tf = ((d.y < 0.0 ? -1.3 : 1.55) - q.y) / d.y;
			if (tf > 0.0 && tf < t) { t = tf; face = d.y < 0.0 ? 2 : 3; }
		}
		vec3 h = q + d * t;
		if (face == 0) {
			inside = cafe > 0.5 ? (h.y > 0.15 && h.y < 0.95 && abs(h.x) < hw * 0.6 ? shelf_col.rgb * 0.25
				+ step(0.5, fract(h.y * 9.0)) * step(abs(h.x), hw * 0.55) * 0.18 : wall_col.rgb)
				: (clothes > 0.5 ? racks(h.x, h.y, seed) : shelves(h.x, h.y, seed, 0.0));
		} else if (face == 1) {
			inside = clothes > 0.5 ? racks(h.z, h.y, seed + 31.0) : shelves(h.z, h.y, seed + 31.0, cafe);
		} else if (face == 2) {
			vec2 tl = floor(vec2(h.x, h.z) / 0.5);
			inside = floor_col.rgb * (0.85 + 0.15 * mod(tl.x + tl.y, 2.0));
		} else {
			inside = wall_col.rgb * 1.1 + light.rgb * 1.5 * step(abs(h.x), 0.15) * step(fract(h.z * 0.5), 0.7);
		}
		// a cafe's counter across the room, half way in, waist high
		if (cafe > 0.5 && face != 3) {
			float tc = (-1.6 - q.z) / d.z;
			vec3 hc = q + d * tc;
			if (tc > 0.0 && tc < t && hc.y < -0.25 && abs(hc.x) < hw * 0.8) {
				inside = shelf_col.rgb * (0.55 + 0.1 * step(0.9, fract(hc.x)));
			}
		}
		inside *= 1.0 - 0.35 * smoothstep(1.0, 4.5, t);           // further in, a little darker
	}
	float f = 0.06 + 0.94 * pow(1.0 - clamp(dot(-rd, az), 0.0, 1.0), 4.0);
	ALBEDO = mix(inside * 0.15, sky_col.rgb * 0.5, f);
	EMISSION = inside * light.rgb * lit * (1.0 - f);
	ROUGHNESS = 0.1;
	METALLIC = 0.2;
}
"""
var _shop_mat: ShaderMaterial

func _shop_interior() -> ShaderMaterial:
	if _shop_mat == null:
		_shop_mat = ShaderMaterial.new()
		var sh := Shader.new()
		sh.code = SHOP_SHADER
		_shop_mat.shader = sh
	_shop_mat.set_shader_parameter("light", _tone["shoplight"])
	_shop_mat.set_shader_parameter("floor_col", _tone["mark"].lerp(_tone["pavement"], 0.4))
	_shop_mat.set_shader_parameter("wall_col", _tone["mark"].darkened(0.1))
	_shop_mat.set_shader_parameter("shelf_col", _tone["woodfence"].lightened(0.2))
	_shop_mat.set_shader_parameter("goods_a", _real_col("red"))
	_shop_mat.set_shader_parameter("goods_b", _real_col("yellow"))
	_shop_mat.set_shader_parameter("goods_c", _real_col("green"))
	_shop_mat.set_shader_parameter("goods_d", _real_col("blue"))
	_shop_mat.set_shader_parameter("sky_col", (_sky_reflect()[1] as Color) if env != null and env.sky != null else Palette.col("bg_alt"))
	_shop_mat.set_shader_parameter("lit", 1.4 if _night else 0.45)
	return _shop_mat

func _shop_glass() -> StandardMaterial3D:
	if _smat.has("shopglass"):
		return _smat["shopglass"]
	var m := _surface("glass").duplicate() as StandardMaterial3D
	m.set_meta("tone", "glass")
	m.roughness = 0.12
	m.metallic = 0.3
	m.emission_enabled = true
	m.emission = _tone["shoplight"]
	m.emission_energy_multiplier = 0.7
	_smat["shopglass"] = m
	return m

## a gas station: a canopy on four pillars over two pumps, square to the street
## every column of a station's canopy and both pumps off the road (the middle 1.5 m off it
## let a corner column, 4 m from the middle, stand 0.9 m into a primary road -- city_check,
## Bedford)
func _station_fits(at: Vector2, n: Vector2) -> bool:
	var along := Vector2(-n.y, n.x)
	for sx: float in [-1.0, 1.0]:
		for sz: float in [-1.0, 1.0]:
			if not _off_road(at + along * 3.6 * sx + n * 2.2 * sz, 0.45):
				return false
	return true

func _gas_station(at: Vector2, n: Vector2, c: Dictionary) -> void:
	var along := Vector2(-n.y, n.x)
	var gy := _h(at)
	var b := Basis(Vector3.UP, atan2(n.x, n.y))
	c["roof"].append(Transform3D(b, Vector3(at.x, gy + 4.85, at.y)))
	c["band"].append(Transform3D(b, Vector3(at.x, gy + 4.85, at.y)))
	for sx: float in [-1.0, 1.0]:
		for sz: float in [-1.0, 1.0]:
			var q := at + along * 3.6 * sx + n * 2.2 * sz
			c["pillar"].append(Transform3D(b, Vector3(q.x, gy + 2.3, q.y)))
			_add_post(q, 0.25)
		var pq := at + along * 1.8 * sx
		c["pump"].append(Transform3D(b, Vector3(pq.x, gy + 0.8, pq.y)))
		_add_post(pq, 0.45)

## tables and chairs on the pavement in front of a cafe or restaurant, umbrellas over
## them in `umb`'s colour -- where there is pavement (not road, not building). `style`
## "stools": a bar's row of tall stools at a narrow ledge along its front instead (as a
## filmed bar on a shopping street has them), no umbrellas.
func _terrace(pos: Vector2, n: Vector2, along: Vector2, umb: Color, t: Dictionary, shades: Dictionary,
		style := "tables", umbrellas := true) -> void:
	if style == "stools":
		_bar_stools(pos, n, along, t)
		return
	for off: float in [-2.3, 0.0, 2.3]:
		# 2.6 m out, or where the wall stands close to the kerb (a map's outline that runs out
		# to the road with the upper floors) up against the window: a filmed sabich stand's
		# tables and red umbrella were on a pavement the game had all but none of
		var c := Vector2.INF
		var room := 0.7   # (the solid circle: no bigger than the room to the road's edge)
		for tr: Vector3 in [Vector3(2.6, 0.9, 0.9), Vector3(1.6, 0.6, 0.4), Vector3(1.1, 0.45, -0.1)]:   # out, room, edge
			if tr.x < 1.5 and (off != 0.0 or not umbrellas):
				continue   # (that close: one table, and only for an umbrella someone filmed)
			var q := pos + n * tr.x + along * off
			var on := _nearest_seg(q, 12.0, true)
			if _push_out(q, tr.y, false) == Vector2.ZERO and (on.is_empty() or float(on["edge"]) >= tr.z) 					and not _in_corner_fill(q, maxf(tr.z, 0.0) + 0.25):   # (nor on a corner's asphalt: Aluf David, Dizengoff)
				c = q
				if not on.is_empty():
					room = clampf(float(on["edge"]), 0.1, 0.7)   # (0.25 at least had a table at the lane's edge 0.35 m into Dizengoff)
				break
		if not c.is_finite():
			continue
		if _post_twin(c, room):
			continue   # (a table there already: one cafe mapped twice, Tel Aviv 18)
		var gy := _h(c)
		var face := atan2(along.x, along.y)
		t["top"].append(Transform3D(Basis(), Vector3(c.x, gy + 0.74, c.y)))
		t["leg"].append(Transform3D(Basis(), Vector3(c.x, gy + 0.37, c.y)))
		for sgn: float in [-1.0, 1.0]:
			var ch := c + along * 0.62 * sgn
			var b := Basis(Vector3.UP, face + (0.0 if sgn > 0.0 else PI))
			t["seat"].append(Transform3D(b, Vector3(ch.x, gy + 0.45, ch.y)))
			var bk := ch + along * 0.2 * sgn
			t["back"].append(Transform3D(b, Vector3(bk.x, gy + 0.68, bk.y)))
		_table_spots.append(c)
		_table_along[c] = along   # (its two chairs: 0.62 m either way along this, facing it)
		if umbrellas:
			t["pole"].append(Transform3D(Basis(), Vector3(c.x, gy + 1.2, c.y)))
			(shades["xf"] as Array).append(Transform3D(Basis(), Vector3(c.x, gy + 2.35, c.y)))
			(shades["col"] as Array).append(umb)
		# (a 0.7 m circle round a table up against the kerb stood 0.8 m into the lane: city_check)
		_add_post(c, room)

## a bar's front: a narrow ledge along it 0.9 m out and a row of tall stools at it
func _bar_stools(pos: Vector2, n: Vector2, along: Vector2, t: Dictionary) -> void:
	var face := atan2(n.x, n.y)
	var ledge := pos + n * 1.0
	if _push_out(ledge, 0.5, false) != Vector2.ZERO:
		return
	var gy := _h(ledge)
	# (the terrace's own meshes, stretched: a chair's back box as the ledge, its seat and the
	# table's leg as the stools' seat and stem)
	t["back"].append(Transform3D(Basis(Vector3.UP, face) * Basis.from_scale(Vector3(8.0, 0.1, 6.0)), Vector3(ledge.x, gy + 1.05, ledge.y)))
	for off: float in [-1.4, -0.7, 0.0, 0.7, 1.4]:
		var c := pos + n * 1.45 + along * off
		if _push_out(c, 0.25, false) != Vector2.ZERO:
			continue
		t["seat"].append(Transform3D(Basis(Vector3.UP, face) * Basis.from_scale(Vector3(0.85, 1.0, 0.85)), Vector3(c.x, gy + 0.78, c.y)))
		t["leg"].append(Transform3D(Basis.from_scale(Vector3(1.0, 1.05, 1.0)), Vector3(c.x, gy + 0.39, c.y)))
		var bk := c + n * 0.18
		t["back"].append(Transform3D(Basis(Vector3.UP, face) * Basis.from_scale(Vector3(0.85, 0.7, 1.0)), Vector3(bk.x, gy + 0.98, bk.y)))
	_add_post(ledge, 0.4)

## crates of fruit and vegetables on low stands either side of a greengrocer's door, the
## produce's colours on top of each (as a filmed one has them out on the pavement)
func _crates(b: CBuf, pos: Vector2, n: Vector2, along: Vector2, gy: float, wide: float) -> void:
	var bs := Basis(Vector3.UP, atan2(along.x, along.y))
	var wood: Color = _tone["woodfence"].lightened(0.15)
	var produce: Array = [_real_col("green"), _real_col("orange"), _real_col("red"), _real_col("yellow"), _real_col("green").lightened(0.2)]
	var k := posmod(_hash_i(pos), 5)
	for sgn: float in [-1.0, 1.0]:
		var c := pos + n * 0.75 + along * (1.0 * wide) * sgn
		if _push_out(c, 0.4, false) != Vector2.ZERO:
			continue
		_furn._box(b, Vector3(c.x, gy + 0.3, c.y), Vector3(1.3, 0.6, 0.55), _tone["tyre"].lightened(0.1), bs)   # the stand
		for j in 3:
			var q := c + along * (float(j) - 1.0) * 0.42
			_furn._box(b, Vector3(q.x, gy + 0.7, q.y), Vector3(0.4, 0.2, 0.5), wood, bs)                     # a crate
			_furn._box(b, Vector3(q.x, gy + 0.81, q.y), Vector3(0.36, 0.05, 0.46), produce[(k + j) % 5], bs)  # what is in it
			k += 1
		_add_post(c, 0.5)

## a sandwich board out in front of an open shop: two boards leaning together, chalk-black
## or white, in a wooden frame
func _a_board(b: CBuf, c: Vector2, n: Vector2, along: Vector2, gy: float, k: int) -> void:
	if _push_out(c, 0.35, true, false) != Vector2.ZERO or not _off_road(c, 0.6):
		return
	var face: Color = _tone["tyre"].darkened(0.3) if k % 3 != 0 else Palette.col("ink").lerp(Palette.col("bg_alt"), 0.1)
	var frame: Color = _tone["woodfence"].lightened(0.1)
	for side: float in [-1.0, 1.0]:   # each board leans in from 0.17 m out at its foot
		var bs := Basis(Vector3.UP, atan2(n.x, n.y)) * Basis(Vector3.RIGHT, -side * 0.2)   # (tops together)
		var q := c + n * side * 0.085
		_furn._box(b, Vector3(q.x, gy + 0.43, q.y), Vector3(0.58, 0.86, 0.035), frame, bs)
		var f := c + n * side * 0.105
		_furn._box(b, Vector3(f.x, gy + 0.45, f.y), Vector3(0.48, 0.66, 0.012), face, bs)
	_add_post(c, 0.3)

## string lights along a bar's front, as a filmed one has them lit by day: two strands of warm
## bulbs looping between hooks every 2 m, 1 m and 2 m out from the wall under the awning
func _string_lights(wire: CBuf, bulbs: Array, pos: Vector2, n: Vector2, along: Vector2, gy: float) -> void:
	var dark: Color = _tone["tyre"]
	for strand: Vector2 in [Vector2(1.0, 2.72), Vector2(2.0, 2.62)]:   # out, hook height
		var prev := Vector3.INF
		var s := -4.0
		while s <= 4.0 + 0.01:
			var k := fposmod(s + 4.0, 2.0) / 2.0          # 0 at a hook .. 1 at the next
			var sag := 0.22 * 4.0 * k * (1.0 - k)
			var q := pos + n * strand.x + along * s
			var at := Vector3(q.x, gy + strand.y - sag, q.y)
			if prev.is_finite():
				var mid := (prev + at) * 0.5
				var dv := at - prev
				_furn._box(wire, mid, Vector3(dv.length(), 0.012, 0.012), dark,
					Basis(Vector3.UP, atan2(-dv.z, dv.x)) * Basis(Vector3.BACK, atan2(dv.y, Vector2(dv.x, dv.z).length())))
			bulbs.append(Transform3D(Basis(), at - Vector3(0, 0.045, 0)))
			prev = at
			s += 0.4

## an awning's colour when nobody filmed it: the shop's palette colour, muted to a canvas's
## (a filmed shopping street had no neon awnings: black, white, dark green, maroon)
func _awning_col(hue: String, at: Vector2) -> Color:
	var k := posmod(_hash_i(at) >> 6, 10)
	if k < 3:
		return _real_col("black")
	if k < 5:
		return _real_col("white")
	return _natural(Palette.col(hue).lerp(Palette.col("bg"), 0.45), 0.55)

## a real thing's colour by name, for what was filmed (details.gd "shops"): a red is a paint's
## red and a green a sign's green whatever the palette, their strength the palette's
func _real_col(name: String) -> Color:
	var hz := Palette.col("hazard")
	var fr := Palette.col("friend")
	match name:
		"black":
			return _tone["tyre"].lightened(0.06)
		"white":
			return _tone["mark"]
		"cream":
			return _tone["mark"].lerp(_tone["woodfence"], 0.3)
		"red":
			return Color.from_hsv(0.99, clampf(hz.s, 0.6, 0.85), clampf(hz.v * 0.75, 0.45, 0.7))
		"maroon":
			return Color.from_hsv(0.98, clampf(hz.s, 0.5, 0.75), clampf(hz.v * 0.4, 0.25, 0.4))
		"green":
			return Color.from_hsv(0.33, clampf(fr.s, 0.5, 0.8), clampf(fr.v * 0.5, 0.3, 0.5))
		"orange":
			return Color.from_hsv(0.08, 0.8, clampf(hz.v * 0.85, 0.6, 0.85))
		"yellow":
			return _tone["markyellow"]
		"blue":
			return _natural(_tone["signblue"], 0.7)
	return _tone["board"]

func _terrace_meshes(t: Dictionary, shades: Dictionary) -> void:
	if (t["top"] as Array).is_empty() and (t["seat"] as Array).is_empty():
		return   # (a bar's stools have seats and no table tops)
	var furn := _surface("furniture")
	var top := CylinderMesh.new()
	top.top_radius = 0.4
	top.bottom_radius = 0.4
	top.height = 0.04
	top.radial_segments = 10
	var leg := CylinderMesh.new()
	leg.top_radius = 0.035
	leg.bottom_radius = 0.035
	leg.height = 0.72
	leg.radial_segments = 5
	var seat := BoxMesh.new()
	seat.size = Vector3(0.42, 0.05, 0.42)
	var back := BoxMesh.new()
	back.size = Vector3(0.42, 0.42, 0.05)
	var pole := CylinderMesh.new()
	pole.top_radius = 0.025
	pole.bottom_radius = 0.025
	pole.height = 2.4
	pole.radial_segments = 4
	for pair: Array in [[top, "top"], [leg, "leg"], [seat, "seat"], [back, "back"], [pole, "pole"]]:
		_chunked(pair[0], t[pair[1]], SIGN_RANGE * 1.5, [], furn)
	var shade := CylinderMesh.new()
	shade.top_radius = 0.03
	shade.bottom_radius = 1.25
	shade.height = 0.4
	shade.radial_segments = 10
	_chunked(shade, shades["xf"], SIGN_RANGE * 1.5, shades["col"], _vc_mat())

## where a place's front goes: [point, outward normal, true if on a building wall]. The
## wall of its building (or the nearest one) closest to the street; otherwise a free-
## standing sign on the spot, facing the street.
func _facade_spot(at: Vector2) -> Array:
	var road := _nearest_seg(at, 60.0, true, true)
	var street: Vector2 = road["q"] if not road.is_empty() else at + Vector2(0, 1)
	var best := INF
	var out: Array = []
	for i: int in _near(_bld_hash, at, 16.0, BLD_CELL):
		if not (_bld_box[i] as Rect2).grow(16.0).has_point(at):
			continue
		var poly: PackedVector2Array = _blds[i]
		var inside := Geometry2D.is_point_in_polygon(at, poly)
		var area := 0.0
		for j in range(poly.size()):
			area += poly[j].x * poly[(j + 1) % poly.size()].y - poly[(j + 1) % poly.size()].x * poly[j].y
		for j in range(poly.size()):
			var a := poly[j]
			var b := poly[(j + 1) % poly.size()]
			if a.distance_to(b) < 2.5:
				continue
			var c := Geometry2D.get_closest_point_to_segment(street, a, b)
			var score := c.distance_to(street) + (0.0 if inside else 2.0 * c.distance_to(at))
			if score < best:
				best = score
				var e := (b - a).normalized()
				out = [c, Vector2(e.y, -e.x) * (1.0 if area > 0.0 else -1.0), true]
	if out.is_empty():
		var face := (street - at).normalized() if street != at else Vector2(0, 1)
		out = [at, face, false]
	return out

func _multi(mesh: Mesh, xforms: Array) -> MultiMeshInstance3D:
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.mesh = mesh
	mm.instance_count = xforms.size()
	for i in range(xforms.size()):
		mm.set_instance_transform(i, xforms[i])
	var mi := MultiMeshInstance3D.new()
	mi.multimesh = mm
	world.add_child(mi)
	return mi

var _sig_blink := true               ## a flashing green: lit in this half second?

func _signals_tick(dt: float) -> void:
	if _sig_mats.is_empty():
		return
	_sig_t += dt
	var step: Array = SIGNAL_CYCLE[_sig_phase]
	if _sig_t >= float(step[0]):
		_sig_t = 0.0
		_sig_phase = (_sig_phase + 1) % SIGNAL_CYCLE.size()
		_sig_blink = true
		_apply_signals()
	elif step.has("gf"):
		var blink := fmod(_sig_t, 1.0) < 0.5   # three flashes in its three seconds
		if blink != _sig_blink:
			_sig_blink = blink
			_apply_signals()

## ---- shadows past the shadows -----------------------------------------------------------------
## The real shadows reach 45-75 m from the camera (none at the lowest quality): past that the
## whole city stood on evenly sunlit ground, flat as a map, and that is most of what you see
## from the car. The sun does not move, so every building's shadow is painted once, at load,
## into one picture of the whole city seen from above (each outline swept along the sun's
## way by its height, then the outline itself cleared: whatever is on a roof is not in its
## shadow), read back and mipmapped (a picture drawn straight into a viewport has no
## mipmaps, and its edges shimmered off in the distance). The ground's shaders darken by it
## where the real shadows fade out (far_shade), so the two meet without a seam; the trees'
## shadows go in the contact-shadow layer, square by square, as the trees are planted.
const FAR_SHADE := """
uniform sampler2D far_shadow : filter_linear_mipmap_anisotropic, repeat_disable, hint_default_black;
uniform vec4 fs_rect = vec4(0.0);   // the picture's corner (x, z) and 1 / its size in metres
uniform float fs_near = 60.0;       // where the real shadows end (0: there are none)
uniform float fs_fade = 0.8;        // ... and where they start fading out, a share of that
uniform float fs_dark = 0.0;        // how much of the light a shadow takes (0: at night, no picture)
float far_shade(vec3 wp, float dist) {
	float s = texture(far_shadow, (wp.xz - fs_rect.xy) * fs_rect.zw).r;
	float on = clamp((dist - fs_near * fs_fade) / (fs_near * (1.0 - fs_fade) + 0.001), 0.0, 1.0);
	return 1.0 - fs_dark * s * on;
}
"""
## After rain (the "wet" button): hard ground darker and glossy, mirroring the sky -- by
## Fresnel, as water does: little looking down, a lot at a low angle -- and, low down in the
## mirror, the street's buildings (no screen-space reflections in this renderer: a darker band
## stands in for them); puddles in the dips nearly mirror-smooth. Read by the tone, kerb and
## ground shaders (with far_shade, see _with_far); `wet` fades in and out (_set_wet).
const WET_GLSL := """
uniform float wet = 0.0;                             // 0 dry .. 1 just after rain
uniform vec3 wet_sky_top = vec3(0.45, 0.55, 0.7);    // what it mirrors: the sky overhead
uniform vec3 wet_sky_hor = vec3(0.75);               // and along the horizon
vec3 wet_mirror(vec3 vd) {   // vd: from the eye to the point, in the world
	vec3 r = reflect(vd, vec3(0.0, 1.0, 0.0));
	float fres = 0.04 + 0.96 * pow(1.0 - clamp(-vd.y, 0.0, 1.0), 5.0);
	vec3 sky = mix(wet_sky_hor, wet_sky_top, smoothstep(0.0, 0.6, r.y));
	return mix(wet_sky_hor * 0.5, sky, smoothstep(0.02, 0.2, r.y)) * fres;
}
"""
const FS_PX := 2048                  ## the picture's longer side (px): ~1.6 m a pixel over Givatayim
## A phone's browser, or any device in slow-frames mode, draws it at half that: the picture is
## drawn, read back, converted and mipmapped in one frame (a phone: building ~0.6-1 s + "rest"
## ~0.7-1 s, a 2-second freeze), and a quarter of the pixels is a quarter of that work. The far
## ground's shadows are coarser (~3 m a pixel), little to see on a phone's screen.
func _fs_px() -> int:
	if _slow_frames or OS.has_feature("web_android") or OS.has_feature("web_ios"):
		return FS_PX / 2
	return FS_PX
const FS_DARK_EVE := 0.4             ## the same in the evening: a low sun lights the ground less, so its shadows take less
const FS_DARK := 0.55                ## the share of the light a shadow takes off the ground (the real ones: tests/far_shadows.gd)
var _fs_tex: ImageTexture = null
var _fs_rect := Vector4.ZERO
var _fs_cache := {}                  ## "day" / "evening" -> [texture, rect]: each sun's drawn once
var _fs_drawing := {}                ## the suns whose picture is being drawn just now
var _far_mats: Array = []

## a ground shader's code with far_shade() in it
func _with_far(code: String) -> String:
	return code.replace("void vertex()", FAR_SHADE + WET_GLSL + "void vertex()")

## a ground material to keep in step with the picture, the quality and the night
func _far(m: ShaderMaterial) -> void:
	if not _far_mats.has(m):
		_far_mats.append(m)
	_far_set(m)

func _far_set(m: ShaderMaterial) -> void:
	m.set_shader_parameter("far_shadow", _fs_tex)
	m.set_shader_parameter("fs_rect", _fs_rect)
	m.set_shader_parameter("fs_near", sun.directional_shadow_max_distance if sun.shadow_enabled else 0.0)
	m.set_shader_parameter("fs_fade", sun.directional_shadow_fade_start)
	m.set_shader_parameter("fs_dark", 0.0 if _night or _fs_tex == null else (FS_DARK_EVE if _evening else FS_DARK))
	m.set_shader_parameter("wet", _wet_k)
	if env != null:
		var rs := _sky_reflect()
		m.set_shader_parameter("wet_sky_top", rs[0])
		m.set_shader_parameter("wet_sky_hor", rs[1])
	if m == _ao_mat:   # the trees' patches: where this sun throws them
		var L := -sun.global_transform.basis.z if sun.is_inside_tree() else Vector3(0, -1, 0)
		var off := Vector2(L.x, L.z) / maxf(-L.y, 0.05)
		m.set_shader_parameter("sun_off", off)
		m.set_shader_parameter("sun_stretch", 1.0 / clampf(-L.y, 0.2, 1.0))

func _far_update() -> void:
	for m: ShaderMaterial in _far_mats:
		_far_set(m)
	_grass_retint()   # (the grass reads the same picture's green)

func _build_far_shadows(chunked := false, for_sun := "") -> void:
	if DisplayServer.get_name() == "headless":
		return   # (nothing is drawn: a headless playtest)
	# the sun drawn for: this one, or the other ahead of its button ("day" / "evening") -- and
	# kept as it was asked, the button may change the sun before the picture is done
	var ev := _evening if for_sun == "" else for_sun == "evening"
	var L := -Basis.from_euler(Vector3(SKIES["evening" if ev else "day"]["sun"]) * (PI / 180.0)).z   # the way the sunlight goes
	if _city_data.is_empty() or not _city_data.has("buildings"):
		return   # (the city file let go: both suns were drawn before that, _far_both)
	if chunked:
		_yield_at = Time.get_ticks_usec() + _build_us
	if L.y > -0.05:
		return
	var off := Vector2(L.x, L.z) / -L.y      # a shadow's reach on the ground per metre of height
	var t0 := Time.get_ticks_usec()
	var mpp := maxf(1.0, maxf(_bounds.size.x, _bounds.size.y) / _fs_px())
	var w := int(ceil(_bounds.size.x / mpp))
	var h := int(ceil(_bounds.size.y / mpp))
	var o := _bounds.position
	var pts := PackedVector2Array()
	var cols := PackedColorArray()
	var idx := PackedInt32Array()
	var lit: Array = []   # the outlines, cleared after all the shadows are in
	for bd: Dictionary in _city_data["buildings"]:
		if chunked and Time.get_ticks_usec() > _yield_at:   # (after the car: a few ms a frame, building or not)
			await _pause()
		var ring: PackedVector2Array = bd["_ring"]
		if ring.size() < 3:
			continue
		var top := float(bd["_h"])
		var low := float(bd["_base"])
		var px := PackedVector2Array()
		for p in ring:
			px.append((p - o + off * low) / mpp)
			px.append((p - o + off * top) / mpp)
		var hull := Geometry2D.convex_hull(px)
		if hull.size() > 1 and hull[0] == hull[hull.size() - 1]:
			hull.remove_at(hull.size() - 1)
		var b := pts.size()
		for q in hull:
			pts.append(q)
			cols.append(Color(1, 0, 0))
		for i in range(1, hull.size() - 1):
			idx.append_array([b, b + i, b + i + 1])
		if low == 0.0:
			lit.append(ring)
	var fpts := PackedVector2Array()
	var fcols := PackedColorArray()
	var fidx := PackedInt32Array()
	for ring: PackedVector2Array in lit:
		if chunked and Time.get_ticks_usec() > _yield_at:
			await _pause()
		var tri := Geometry2D.triangulate_polygon(ring)
		var b := fpts.size()
		for p in ring:
			fpts.append((p - o) / mpp)
			fcols.append(Color.BLACK)
		for i in tri:
			fidx.append(b + i)
	var vp := SubViewport.new()
	vp.size = Vector2i(w, h)
	vp.disable_3d = true
	vp.render_target_update_mode = SubViewport.UPDATE_ONCE
	var holder := Node2D.new()
	vp.add_child(holder)
	add_child(vp)
	# In the same picture, green: where grass grows (the blades near the camera, _build_grass):
	# 0.5 open ground (its own noise decides, as GROUND_SHADER draws it), 1 parks, lawns, woods,
	# pitches and the front gardens, 0 the roads with their pavements, paths, car parks, plazas,
	# water and the buildings. Each layer its own canvas item, blended so the red (shadows) and
	# the green leave each other alone: green and shadows added, roads multiplied by (1, 0, 1).
	var items: Array = []
	var mats: Array = []
	var to_px := Transform2D(Vector2(1.0 / mpp, 0), Vector2(0, 1.0 / mpp), -o / mpp)
	var layer := func(blend: int, world: bool) -> RID:
		var it := RenderingServer.canvas_item_create()
		RenderingServer.canvas_item_set_parent(it, holder.get_canvas_item())
		RenderingServer.canvas_item_set_draw_index(it, items.size())
		if world:
			RenderingServer.canvas_item_set_transform(it, to_px)
		if blend >= 0:
			var cm := CanvasItemMaterial.new()
			cm.blend_mode = blend
			mats.append(cm)
			RenderingServer.canvas_item_set_material(it, cm.get_rid())
		items.append(it)
		return it
	var bg: RID = layer.call(-1, false)
	RenderingServer.canvas_item_add_rect(bg, Rect2(0, 0, w, h), Color(0, 0.5, 0))
	var green: RID = layer.call(CanvasItemMaterial.BLEND_MODE_ADD, true)
	var g1 := PackedColorArray([Color(0, 1, 0)])
	for kind: String in ["park", "grass", "wood", "pitch"]:
		for ring: PackedVector2Array in _area_rings.get(kind, []):
			if chunked and Time.get_ticks_usec() > _yield_at:   # (all of these at once: most of a second on a phone)
				await _pause()
			_canvas_ring(green, ring, Color(0, 1, 0))
	var med := String(_place.get("look", "")) == "med"
	for r: Dictionary in _roads:
		if chunked and Time.get_ticks_usec() > _yield_at:
			await _pause()
		if med and r["drive"] and r["k"] in ["residential", "living_street"]:
			var hw: float = float(r["w"]) * 0.5
			for sgn: float in [-1.0, 1.0]:   # the front gardens, behind the pavements
				RenderingServer.canvas_item_add_polyline(green, _offset_line(r["pts"], (hw + PAVE_W + 1.85) * sgn), g1, 3.1)
	var shade: RID = layer.call(CanvasItemMaterial.BLEND_MODE_ADD, false)
	RenderingServer.canvas_item_add_triangle_array(shade, idx, pts, cols)
	var bare: RID = layer.call(CanvasItemMaterial.BLEND_MODE_MUL, true)
	var keep_red := PackedColorArray([Color(1, 0, 1)])
	for r: Dictionary in _roads:
		if chunked and Time.get_ticks_usec() > _yield_at:
			await _pause()
		var wide: float = float(r["w"]) + (2.0 * (KERB_W + PAVE_W) if r["drive"] and _kerbed(r) else 0.6)
		RenderingServer.canvas_item_add_polyline(bare, r["pts"], keep_red, wide)
	for kind: String in ["water", "parking", "plaza", "school"]:
		for ring: PackedVector2Array in _area_rings.get(kind, []):
			if chunked and Time.get_ticks_usec() > _yield_at:
				await _pause()
			_canvas_ring(bare, ring, Color(1, 0, 1))
	var feet: RID = layer.call(-1, false)
	RenderingServer.canvas_item_add_triangle_array(feet, fidx, fpts, fcols)
	var t1 := Time.get_ticks_usec()
	await RenderingServer.frame_post_draw
	await RenderingServer.frame_post_draw
	var t2 := Time.get_ticks_usec()
	var img := vp.get_texture().get_image()
	for it: RID in items:
		RenderingServer.free_rid(it)
	vp.queue_free()
	if img == null or img.is_empty():
		return
	img.convert(Image.FORMAT_RG8)   # (red: the shadows, green: the grass)
	img.generate_mipmaps()
	var tex := ImageTexture.create_from_image(img)
	var rect := Vector4(o.x, o.y, 1.0 / (w * mpp), 1.0 / (h * mpp))
	_fs_cache["evening" if ev else "day"] = [tex, rect]
	_fs_drawing.erase("evening" if ev else "day")
	if _evening == ev:
		_fs_tex = tex
		_fs_rect = rect
		_far_update()
	# (what it costs apart from the two frames it waits for the drawing: those are a few ms
	# in a browser, but most of a second under a test's software renderer)
	_stage_ms["far shadows: work, not the frames"] = (t1 - t0 + Time.get_ticks_usec() - t2) / 1000

## ---- grass blades near the camera --------------------------------------------------------
## A lawn drawn flat looked like a green carpet from a walker's height. Blades on every lawn
## would be millions of triangles; instead one patch of them (4 x 4 m, GRASS_BLADES) repeated
## in a grid that moves with the camera, a square at a time, and the shader grows each blade
## only where grass grows -- the far-shadow picture's green (_build_far_shadows) -- at the
## ground's height there (the height grid as a texture, interpolated as _h does), shorter
## further off and gone by GRASS_REACH. Off at the lowest two qualities; a smaller grid at 2.
const GRASS_SHADER := """
shader_type spatial;
render_mode cull_disabled;
uniform sampler2D mask : filter_linear, repeat_disable;   // green: where grass grows
uniform vec4 mask_rect = vec4(0.0);
uniform sampler2D hmap : filter_nearest, repeat_disable;  // the ground's height grid
uniform vec4 h_info = vec4(0.0, 0.0, 1.0, 0.0);           // its corner (x, z), its step, 1 if hilly
uniform ivec2 h_size = ivec2(1, 1);
uniform vec3 col_a : source_color = vec3(0.3, 0.5, 0.2);   // the lawn
uniform vec3 col_b : source_color = vec3(0.5, 0.5, 0.25);  // drier blades among it
uniform float greenness = 0.5;
uniform float reach = 18.0;
uniform int cut_n = 0;           // the garden paths near the camera (_grass_cuts): no blades on them
uniform vec4 cut_a[24];          // each one's middle (x, z) and its way along (x, z)
uniform vec2 cut_b[24];          // ... its half length and half width
varying float tip;
varying vec3 tint;
float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }
float noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
}
float ground(vec2 p) {   // as the game's _h: the grid's triangles
	if (h_info.w < 0.5) { return 0.0; }
	float fx = clamp((p.x - h_info.x) / h_info.z, 0.0, float(h_size.x) - 1.001);
	float fz = clamp((p.y - h_info.y) / h_info.z, 0.0, float(h_size.y) - 1.001);
	int i = int(fx);
	int j = int(fz);
	float ax = fx - float(i);
	float az = fz - float(j);
	float h00 = texelFetch(hmap, ivec2(i, j), 0).r;
	float h10 = texelFetch(hmap, ivec2(i + 1, j), 0).r;
	float h01 = texelFetch(hmap, ivec2(i, j + 1), 0).r;
	float h11 = texelFetch(hmap, ivec2(i + 1, j + 1), 0).r;
	if (ax + az <= 1.0) { return h00 + (h10 - h00) * ax + (h01 - h00) * az; }
	return h11 + (h01 - h11) * (1.0 - ax) + (h10 - h11) * (1.0 - az);
}
void vertex() {
	// a blade's three corners all sit at its root (VERTEX); UV says which corner (x across,
	// y up), UV2 is the blade's own two random numbers
	vec3 root = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	vec2 p = root.xz;
	float gy = ground(p) + (h_info.w > 0.5 ? 0.07 : 0.0) + 0.015;
	float d = distance(vec3(p.x, gy, p.y), CAMERA_POSITION_WORLD);   // (from up high: none)
	float m = textureLod(mask, (p - mask_rect.xy) * mask_rect.zw, 0.0).g;
	float n = noise(p / 70.0) * 0.65 + noise(p / 15.0) * 0.35;
	float wild = smoothstep(0.62 - greenness * 0.45, 0.78 - greenness * 0.4, n);
	float grow = m > 0.75 ? 1.0 : (m > 0.25 ? wild * 0.85 : 0.0);
	grow *= 1.0 - smoothstep(reach * 0.6, reach, d);
	for (int i = 0; i < cut_n; i++) {
		vec2 r = p - cut_a[i].xy;
		if (abs(dot(r, cut_a[i].zw)) < cut_b[i].x && abs(dot(r, vec2(-cut_a[i].w, cut_a[i].z))) < cut_b[i].y) {
			grow = 0.0;
		}
	}
	float h = (0.06 + 0.1 * UV2.x) * grow;
	float a = UV2.y * 6.2831853;
	vec3 side = vec3(cos(a), 0.0, sin(a));
	vec3 lean = vec3(-sin(a), 0.0, cos(a)) * (0.2 + 0.35 * UV2.x);
	float sway = sin(TIME * 1.7 + p.x * 0.31 + p.y * 0.23) * 0.15 + sin(TIME * 3.1 + p.x * 1.3) * 0.05;
	vec3 w = vec3(p.x, gy, p.y);
	if (h > 0.004) {
		w += side * UV.x * (0.011 + 0.007 * UV2.y) * (1.0 - UV.y)
			+ (vec3(0.0, 1.0, 0.0) + lean + vec3(sway, 0.0, sway * 0.6)) * UV.y * h;
	}
	VERTEX = w - MODEL_MATRIX[3].xyz;   // (the grid moves, it does not turn)
	NORMAL = vec3(0.0, 1.0, 0.0);
	tip = UV.y;
	tint = mix(col_a, col_b, step(0.82, fract(UV2.x * 7.3)) * 0.7 + (1.0 - clamp(m * 2.0 - 1.0, 0.0, 1.0)) * 0.25);
}
void fragment() {
	// (a blade's base as dark as the lawn under it read as black spikes: barely darker, and
	// the tips lighter than the lawn, as sunlit blades are)
	ALBEDO = tint * mix(0.9, 1.35, tip);
	if (!FRONT_FACING) { NORMAL = -NORMAL; }   // (double-sided: seen from behind, the renderer turned it to the ground, and the blade went black)
	ROUGHNESS = 0.9;
	SPECULAR = 0.2;
}
"""
const GRASS_PATCH := 4.0             ## metres a patch of blades covers
const GRASS_BLADES := 520            ## blades a patch (about 32 a square metre)
const GRASS_REACH := 18.0            ## metres from the camera blades grow to
var _grass: MultiMeshInstance3D
var _grass_mat: ShaderMaterial

func _build_grass() -> void:
	if _fs_tex == null and (not _far_later or DisplayServer.get_name() == "headless"):
		return   # (no picture of where grass grows: a headless run)
	var b := Buf.new()
	var rng := RandomNumberGenerator.new()
	rng.seed = 77
	for i in range(GRASS_BLADES):
		var at := Vector3(rng.randf() * GRASS_PATCH, 0, rng.randf() * GRASS_PATCH)
		var u2 := Vector2(rng.randf(), rng.randf())
		b.tri(at, at, at, Vector3.UP, Color.WHITE, Vector2(-1, 0), Vector2(1, 0), Vector2(0, 1), u2)
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, b.arrays())
	_grass_mat = ShaderMaterial.new()
	var sh := Shader.new()
	sh.code = GRASS_SHADER
	_grass_mat.shader = sh
	am.surface_set_material(0, _grass_mat)
	if _hnx > 0:
		_set_hmap(_grass_mat)
	_grass_mat.set_shader_parameter("reach", GRASS_REACH)
	_grass_mat.set_shader_parameter("greenness", 0.85 if String(_place.get("look", "")) == "north" else 0.35)
	# the grid round the camera, nearest patches first (a smaller grid shows only the first)
	var k := int(ceil(GRASS_REACH / GRASS_PATCH)) + 1
	var cells: Array = []
	for j in range(-k, k):
		for i in range(-k, k):
			cells.append(Vector2i(i, j))
	cells.sort_custom(func(a: Vector2i, c: Vector2i) -> bool:
		return Vector2(a.x + 0.5, a.y + 0.5).length() < Vector2(c.x + 0.5, c.y + 0.5).length())
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.mesh = am
	mm.instance_count = cells.size()
	for n in range(cells.size()):
		var c: Vector2i = cells[n]
		mm.set_instance_transform(n, Transform3D(Basis(), Vector3(c.x * GRASS_PATCH, 0, c.y * GRASS_PATCH)))
	mm.custom_aabb = AABB(Vector3(-k * GRASS_PATCH, -600, -k * GRASS_PATCH), Vector3(2 * k * GRASS_PATCH, 1800, 2 * k * GRASS_PATCH))
	_grass = MultiMeshInstance3D.new()
	_grass.multimesh = mm
	_grass.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	world.add_child(_grass)
	_grass_retint()
	_grass_quality()

## where grass grows, before the far shadows' picture says (or while another sun's is drawn):
## nowhere -- an unset mask reads white, grass everywhere
var _fs_none: ImageTexture
func _fs_blank() -> ImageTexture:
	if _fs_none == null:
		_fs_none = ImageTexture.create_from_image(Image.create(1, 1, false, Image.FORMAT_RG8))
	return _fs_none

func _grass_retint() -> void:
	if _grass_mat == null:
		return
	_grass_mat.set_shader_parameter("mask", _fs_tex if _fs_tex != null else _fs_blank())
	_grass_mat.set_shader_parameter("mask_rect", _fs_rect)
	var gr: Color = _tone["grass"]
	_grass_mat.set_shader_parameter("col_a", gr)
	_grass_mat.set_shader_parameter("col_b", gr.lerp(_tone.get("sand", gr), 0.45))

## how many of the patches show: all at the top quality, the nearer ones at 2, none below
func _grass_quality() -> void:
	if _grass == null:
		return
	_grass.visible = _quality >= 2
	var all := _grass.multimesh.instance_count
	_grass.multimesh.visible_instance_count = all if _quality >= 3 else int(all * 0.55)

## the grid under the camera, a patch at a time (each frame, with the sky)
func _grass_follow() -> void:
	if _grass == null or not _grass.visible:
		return
	var c := cam.global_position
	var at := Vector3(floorf(c.x / GRASS_PATCH) * GRASS_PATCH, 0, floorf(c.z / GRASS_PATCH) * GRASS_PATCH)
	if at != _grass.position:
		_grass.position = at
		_grass_cuts_near(Vector2(c.x, c.z))

## The front gardens' paths across their lawns, to keep the blades off (grass poked up
## through the slabs). The picture of where grass grows is a metre or two a pixel and drawn
## before most gardens are laid, so it cannot hold a 1.3 m path; the shader is handed the
## ones near the camera instead, as the grid moves (24 at most: about a street's worth).
var _cut_c := PackedVector2Array()    ## a path's middle
var _cut_u := PackedVector2Array()    ## its way along (unit)
var _cut_s := PackedVector2Array()    ## its half length, half width
var _cut_hash := {}

func _grass_cut(c: Vector2, u: Vector2, half_len: float, half_w: float) -> void:
	var i := _cut_c.size()
	_cut_c.append(c)
	_cut_u.append(u)
	_cut_s.append(Vector2(half_len, half_w))
	_hash_add(_cut_hash, Rect2(c, Vector2.ZERO).grow(half_len + half_w), BLD_CELL, i)

func _grass_cuts_near(c: Vector2) -> void:
	if _grass_mat == null:
		return
	var near: Array = _near(_cut_hash, c, GRASS_REACH + 2.0, BLD_CELL).duplicate()   # (one cell: the hash's own array)
	near.sort_custom(func(a: int, b: int) -> bool: return _cut_c[a].distance_squared_to(c) < _cut_c[b].distance_squared_to(c))
	var a: Array = []
	var b: Array = []
	for i: int in near.slice(0, 24):
		a.append(Vector4(_cut_c[i].x, _cut_c[i].y, _cut_u[i].x, _cut_u[i].y))
		b.append(_cut_s[i])
	while a.size() < 24:
		a.append(Vector4.ZERO)
		b.append(Vector2.ZERO)
	_grass_mat.set_shader_parameter("cut_a", a)
	_grass_mat.set_shader_parameter("cut_b", b)
	_grass_mat.set_shader_parameter("cut_n", mini(near.size(), 24))

## an outline filled on a canvas item, in one colour (skipped if it will not triangulate)
func _canvas_ring(item: RID, ring: PackedVector2Array, col: Color) -> void:
	var tri := Geometry2D.triangulate_polygon(ring)
	if tri.is_empty():
		return
	var c := PackedColorArray()
	c.resize(ring.size())
	c.fill(col)
	RenderingServer.canvas_item_add_triangle_array(item, tri, ring, c)

## a tree's shadow on the ground (crown r across, its middle y up), for past the real ones:
## laid round the foot of its trunk; AO_SHADER moves it out along the sun's way and draws it
## out, so it follows the sun (day or evening) without being laid again
func _ao_tree(p: Vector2, r: float, y: float) -> void:
	if _ao == null:
		return
	var col := Color(0.8, clampf(y / 40.0, 0.0, 1.0), 1.0)
	var mid := _g3(p, KERB_H + 0.03)
	var one := Vector2(1, 0)
	var last := Vector3.ZERO
	for k in range(9):
		var a := TAU * k / 8.0
		var q := _g3(p + Vector2(cos(a), sin(a)) * r, KERB_H + 0.03)
		if k > 0:
			_ao.tri(mid, last, q, Vector3.UP, col, one, Vector2.ZERO, Vector2.ZERO, p)
		last = q

## ---- street cats and flags on cars -------------------------------------------------------
## The builders say where a cat is (cat_at: on a garden wall, by a bin, at a parked car's nose)
## and furniture.gd's cats() puts them there; a parked car in fourteen flies a flag from a back
## window (Israel only). Both a square at a time, with the square.
var _cat_spots: Array = []           ## this square's cats: [transform, "sit" / "loaf", coat]
var _car_flags: Array = []           ## this square's flags on parked cars

func cat_at(p: Vector2, y: float, face: Vector2, kind: String) -> void:
	if not _mine(p):
		return
	if y - _h(p) < 0.4 and not _off_road(p, 0.2):
		return   # no cat sitting on the road (by a parked car's nose: city_check)
	if y - _h(p) < 0.4 and _push_out(p, 0.15, true, false) != Vector2.ZERO:
		return   # nor inside a lamp post or a tree at the kerb (Ashdod: city_check's "posts twice")
	var yaw := atan2(face.x, face.y) if face.length_squared() > 0.0001 else 0.0
	_cat_spots.append([Transform3D(Basis(Vector3.UP, yaw), Vector3(p.x, y, p.y)), kind, posmod(_hash_i(p * 3.0), 97)])
	if y - _h(p) < 0.4:   # on the ground (not up on a wall): a small post, not walked through
		_add_post(p, 0.15)

## ---- contact shadows ------------------------------------------------------------------------
## Where a wall meets the ground, and under a parked car, less of the sky's light gets in and
## the ground is darker: what makes a house stand on the street and a car sit on it, rather
## than float over them (the walls' own feet are darker already, in WALL_SHADER). The
## Compatibility renderer has no ambient occlusion, so it is laid out with the city: soft
## dark strips multiplied over whatever ground is there -- one mesh a square, drawn after the
## ground, writing no depth, gone past AO_SEEN. Its ramp is UV.x (1 at the foot, 0 at the
## rim), its depth COLOR.r, a flat floor to the ramp COLOR.g (the ground under a block on
## columns, dark all over). It lies a little above the pavement, whatever is under it: on a
## lawn or a car park it floats a hand's width up, which a soft dark ramp does not show.
## COLOR.b 1: a tree's shadow instead (see "shadows past the shadows" below), there only
## where the real ones have ended, and not inside a building's.
const AO_SHADER := """
shader_type spatial;
render_mode unshaded, blend_mul, depth_draw_never, cull_disabled, shadows_disabled, fog_disabled;
uniform float strength = 0.62;
uniform float far = 150.0;
uniform vec2 sun_off = vec2(0.0);     // a shadow's reach on the ground per metre up
uniform float sun_stretch = 1.0;      // a ball's shadow, longer along the sun's way
varying vec3 wpos;
float h21(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }
float vn(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(h21(i), h21(i + vec2(1.0, 0.0)), f.x), mix(h21(i + vec2(0.0, 1.0)), h21(i + vec2(1.0, 1.0)), f.x), f.y);
}
void vertex() {
	if (COLOR.b > 0.5) {
		// a tree's patch is laid round the foot of its trunk (UV2), its crown's height in
		// COLOR.g (/ 40 m): moved out along the sun's way and drawn out, whichever sun it is
		float len = length(sun_off);
		vec2 way = len > 0.001 ? sun_off / len : vec2(1.0, 0.0);
		vec2 rel = VERTEX.xz - UV2;
		float h = COLOR.g * 40.0;
		VERTEX.xz = UV2 + sun_off * h + rel + way * dot(rel, way) * (sun_stretch - 1.0);
		VERTEX.y += len * h * 0.04;   // (on a slope, over the ground rather than in it)
	}
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}
void fragment() {
	float d = length(VERTEX);
	float in_bld = texture(far_shadow, (wpos.xz - fs_rect.xy) * fs_rect.zw).r;
	if (COLOR.b > 0.5) {
		// a crown lets some light through: the shadow dappled, its rim soft
		float dap = 0.7 + 0.3 * vn(wpos.xz * 0.9);
		float a = smoothstep(0.0, 0.55, UV.x) * dap;
		float on = clamp((d - fs_near * fs_fade) / (fs_near * (1.0 - fs_fade) + 0.001), 0.0, 1.0);
		ALBEDO = vec3(1.0 - fs_dark * COLOR.r * a * on * (1.0 - in_bld));
	} else {
		float a = max(UV.x * UV.x, COLOR.g);   // (squared: falls away faster than the straight ramp)
		float fade = 1.0 - smoothstep(far * 0.5, far, d);
		ALBEDO = vec3(1.0 - strength * COLOR.r * a * fade);
	}
}
"""
const AO_SEEN := 150.0
const AO_W := 1.7             ## how far out from a wall the ground is darker (m)
var _ao: CBuf = null          ## this square's contact shadows, while it is built (_build_tile)
var _ao_mat: ShaderMaterial

func _ao_material() -> ShaderMaterial:
	if _ao_mat == null:
		_ao_mat = ShaderMaterial.new()
		var sh := Shader.new()
		sh.code = _with_far(AO_SHADER)
		_ao_mat.shader = sh
		_ao_mat.set_shader_parameter("far", AO_SEEN)
		_ao_mat.render_priority = -1   # (under the other see-through things: leaves, glass)
		_far(_ao_mat)
	return _ao_mat

## the ground round a building's foot: a strip out from each wall, a fan round each outside
## corner. At an inside corner two strips overlap and it is darker still, as it is. (w
## negative: a strip in under it instead.) Built for every building, so every height is
## looked up once: it was 150 us a building done plainly, a third of the buildings' build.
func _ao_footprint(ring: PackedVector2Array, foot := 1.0, w := AO_W, col := Color(1, 0, 0)) -> void:
	var n := ring.size()
	if n > 1 and ring[0].distance_squared_to(ring[n - 1]) < 0.0001:
		n -= 1
	if n < 3:
		return
	var area := 0.0
	for i in range(n):
		area += ring[i].cross(ring[(i + 1) % n])
	var sg := 1.0 if area > 0.0 else -1.0   # out is to the right of each wall going round
	var y := KERB_H + 0.025
	var one := Vector2(foot, 0)
	var zero := Vector2.ZERO
	var up := Vector3.UP
	var foot3 := PackedVector3Array()
	foot3.resize(n)
	for i in range(n):
		foot3[i] = _g3(ring[i], y)
	var carry := Vector3.INF     # the next wall's outer start, made by the corner before it
	for i in range(n):
		var i1 := (i + 1) % n
		var a := ring[i]
		var b := ring[i1]
		var L := a.distance_to(b)
		if L < 0.05:
			carry = Vector3.INF
			continue
		var d := (b - a) / L
		var o := Vector2(d.y, -d.x) * sg
		# the strip, in pieces short enough to follow the ground on a hill
		var k := maxi(1, int(L / 8.0))
		var f0 := foot3[i]
		var r0 := carry if carry != Vector3.INF else _g3(a + o * w, y)
		for j in range(1, k + 1):
			var p1 := a.lerp(b, float(j) / k)
			var f1 := foot3[i1] if j == k else _g3(p1, y)
			var r1 := _g3(p1 + o * w, y)
			_ao.tri(f0, f1, r1, up, col, one, one, zero)
			_ao.tri(f0, r1, r0, up, col, one, zero, zero)
			f0 = f1
			r0 = r1
		carry = Vector3.INF
		# an outside corner at b: a fan from the last wall's strip round to the next one's
		var c := ring[(i + 2) % n]
		if c.distance_to(b) < 0.05:
			continue
		var d2 := (c - b).normalized()
		if d.cross(d2) * sg * signf(w) > 0.0:   # (turning towards the inside: the outside opens up)
			var o2 := Vector2(d2.y, -d2.x) * sg
			var turn := o.angle_to(o2)
			var steps := clampi(int(ceil(absf(turn) / 1.6)), 1, 3)   # (a right angle: one; the soft ramp hides the chamfer)
			for st in range(1, steps + 1):
				var nx := _g3(b + o.rotated(turn * float(st) / steps) * w, y)
				_ao.tri(foot3[i1], r0, nx, up, col, one, zero, zero)
				r0 = nx
			carry = r0   # (b + o2 * w: where the next wall's strip starts)

## a soft round patch on the ground round c (a tree's trunk): dark in the middle, gone at r
func _ao_disc(c: Vector2, r: float, k: float) -> void:
	if _ao == null:
		return
	var col := Color(k, 0, 0)
	var mid := _g3(c, KERB_H + 0.025)   # (one height: a metre across, the ground is level enough)
	var one := Vector2(1, 0)
	var last := mid + Vector3(r, 0, 0)
	for i in range(1, 7):
		var a := TAU * i / 6.0
		var q := mid + Vector3(cos(a) * r, 0, sin(a) * r)
		_ao.tri(mid, last, q, Vector3.UP, col, one, Vector2.ZERO, Vector2.ZERO)
		last = q

var _ao_cars: Array = []      ## [middle, nose] of the first cars given a patch (for tests)

## under a parked car (middle c, nose along fwd): dark under it, softening out past its sides
func _ao_car(c: Vector2, fwd: Vector2, lift: float) -> void:
	if _ao == null:
		return
	if _ao_cars.size() < 400:
		_ao_cars.append([c, fwd])
	var sd := Vector2(fwd.y, -fwd.x)
	var col := Color(1.0, 0, 0)
	var inner: Array = []
	var outer: Array = []
	for q: Vector2 in [Vector2(-1, -1), Vector2(1, -1), Vector2(1, 1), Vector2(-1, 1)]:
		inner.append(c + sd * q.x * 0.75 + fwd * q.y * 1.95)
		outer.append(c + sd * q.x * 1.7 + fwd * q.y * 3.1)
	var one := Vector2(1, 0)
	var I: Array = []
	var O: Array = []
	for i in range(4):
		I.append(_g3(inner[i], lift))
		O.append(_g3(outer[i], lift))
	_ao.tri(I[0], I[1], I[2], Vector3.UP, col, one, one, one)
	_ao.tri(I[0], I[2], I[3], Vector3.UP, col, one, one, one)
	for i in range(4):
		var j := (i + 1) % 4
		_ao.tri(I[i], I[j], O[j], Vector3.UP, col, one, one, Vector2.ZERO)
		_ao.tri(I[i], O[j], O[i], Vector3.UP, col, one, Vector2.ZERO, Vector2.ZERO)

## ---- paint at junctions, speed limits --------------------------------------------------------
var _stop_lines: Array = []          ## [junction, way in, line before it, road width, one-way, "stop", "give" or ""]

## A solid stop line across the lane at every light and stop sign; STOP painted before a
## stop sign's line (עצור in Givatayim); a dashed line at a give-way (and האט before it in
## the Israeli towns); SLOW (האט) before a crossing near a school.
func _build_road_paint() -> void:
	var paint := CBuf.new(GROUND_CELL)
	var med := String(_place.get("look", "")) == "med"
	for sl: Array in _stop_lines:
		var c: Vector2 = sl[0]
		var dir: Vector2 = sl[1]
		var w: float = sl[3]
		var right := Vector2(-dir.y, dir.x)
		var at := c - dir * float(sl[2])
		var o0 := -(w * 0.5 - 0.25) if sl[4] else 0.15
		var o1 := w * 0.5 - 0.25
		if sl[5] == "give":   # a give-way's line is dashed: half a metre on, half off
			var n := maxi(1, int((o1 - o0) / 1.0))
			for k in range(n):
				var d0 := lerpf(o0, o1, float(k) / n)
				var d1 := d0 + (o1 - o0) / n * 0.5
				paint.quad3(_g3(at + right * d0, Y_MARK + 0.002), _g3(at + right * d1, Y_MARK + 0.002),
					_g3(at + right * d1 - dir * 0.3, Y_MARK + 0.002), _g3(at + right * d0 - dir * 0.3, Y_MARK + 0.002))
			if med:
				_road_word("האט", at - dir * 2.6 + right * ((o0 + o1) * 0.5), dir)
			continue
		paint.quad3(_g3(at + right * o0, Y_MARK + 0.002), _g3(at + right * o1, Y_MARK + 0.002),
			_g3(at + right * o1 - dir * 0.45, Y_MARK + 0.002), _g3(at + right * o0 - dir * 0.45, Y_MARK + 0.002))
		if sl[5] == "stop":
			_road_word("עצור" if med else "STOP", at - dir * 2.6 + right * ((o0 + o1) * 0.5), dir)
	# SLOW before the crossings near a school or a kindergarten
	var schools := _schools
	for ni: int in _tile_nodes.get(_tile, []):
		if not _crossing_set.has(ni):
			continue
		if _over():
			await _pause()
		var c := _nodes[ni]
		var near := false
		for sc: Vector2 in schools:
			if sc.distance_to(c) < 150.0:
				near = true
				break
		if not near:
			continue
		for e: Vector2i in _node_roads[ni]:
			var r: Dictionary = _roads[e.x]
			if not r["drive"] or r["k"] == "service":
				continue
			var pts: PackedVector2Array = r["pts"]
			for d2: int in [-1, 1]:
				var from := e.y + d2
				if from < 0 or from >= pts.size() or (r["o"] != 0 and r["o"] != -d2):
					continue
				var dir := (c - pts[from]).normalized()
				if c.distance_to(pts[from]) < 16.0:
					continue
				var lane := _lane_off(r)
				_road_word("האט" if med else "SLOW", c - dir * 12.0 + Vector2(-dir.y, dir.x) * lane, dir)
	_add_mesh(paint, _surface("mark"), false, DETAIL_RANGE)

## a word painted on the road, read by a driver going `dir`: flat, stretched long the way
## road lettering is so it reads at a shallow angle
func _road_word(text: String, at: Vector2, dir: Vector2) -> void:
	var lb := Label3D.new()
	lb.text = text
	lb.font = _font
	lb.font_size = 96
	lb.pixel_size = 0.012
	lb.outline_size = 0
	lb.modulate = _tone["mark"]
	lb.shaded = true
	lb.double_sided = false
	var right3 := Vector3(-dir.y, 0.0, dir.x)
	var fwd3 := Vector3(dir.x, 0.0, dir.y)
	lb.transform = Transform3D(Basis(right3, fwd3 * 2.2, Vector3.UP), _g3(at, Y_MARK + 0.012))
	lb.visibility_range_end = 70.0
	world.add_child(lb)

## A town's own speed limit for a kind of street, where enough of them are tagged and they
## agree: Israeli towns have made most residential streets 30 zones, but OSM tags only some
## (Givatayim 184 of 622, 95% of them 30), and an untagged street beside a tagged one should
## not be driven at 50. Needs 20+ tagged, a quarter of that kind's pieces, 85% one value.
func _town_limits(roads: Array) -> Dictionary:
	var all := {}
	var tagged := {}
	for rd: Dictionary in roads:
		var k := String(rd.get("k", ""))
		all[k] = int(all.get(k, 0)) + 1
		if rd.has("ms"):
			if not tagged.has(k):
				tagged[k] = {}
			tagged[k][int(rd["ms"])] = int(tagged[k].get(int(rd["ms"]), 0)) + 1
	var out := {}
	for k: String in tagged:
		var n := 0
		var best := 0
		for v: int in tagged[k]:
			n += int(tagged[k][v])
			if best == 0 or int(tagged[k][v]) > int(tagged[k][best]):
				best = v
		if n >= 20 and n >= int(all[k]) / 4 and int(tagged[k][best]) >= n * 0.85:
			out[k] = best
	return out

## Speed limits on the main roads: a sign a little after each junction, every way the road
## runs. Round and red-rimmed in Givatayim; a white MAXIMUM board in Bedford.
func _build_speed_signs() -> void:
	var med := String(_place.get("look", "")) == "med"
	var poles: Array = []
	var plates: Array = []
	var rims: Array = []
	for ri: int in _tile_roads.get(_tile, []):
		var r: Dictionary = _roads[ri]
		if not r["drive"] or r["pv"] or not MAIN_ROADS.has(r["k"]):
			continue
		if _over():
			await _pause()
		var kmh := int(round(float(r["speed"]) * 3.6 / 10.0)) * 10
		for run: PackedVector2Array in _street_runs(r):
			var cum := PackedFloat32Array([0.0])
			for i in range(1, run.size()):
				cum.append(cum[i - 1] + run[i - 1].distance_to(run[i]))
			var total := cum[cum.size() - 1]
			if total < 120.0:
				continue
			for d2: int in [1, -1]:
				if r["o"] != 0 and r["o"] != d2:
					continue
				var s := 18.0 if d2 > 0 else total - 18.0
				var a := _along(run, cum, s)
				var b := _along(run, cum, s + 1.0 * d2)
				var dir := (b - a).normalized()
				var right := Vector2(-dir.y, dir.x)
				var p := a + right * (float(r["w"]) * 0.5 + 0.9)
				if not _mine(p) or _push_out(p, 0.4, true, false) != Vector2.ZERO or not _off_road(p, 0.4):
					continue
				var gy := _h(p)
				var face := Basis(Vector3.UP, atan2(-dir.x, -dir.y))
				poles.append(Transform3D(Basis(), Vector3(p.x, gy + 1.1, p.y)))
				var mid := Vector3(p.x, gy + 2.35, p.y)
				if med:
					rims.append(Transform3D(face * Basis(Vector3.RIGHT, PI * 0.5), mid))
					plates.append(Transform3D(face * Basis(Vector3.RIGHT, PI * 0.5), mid - Vector3(dir.x, 0, dir.y) * 0.02))
				else:
					rims.append(Transform3D(face, mid))
					plates.append(Transform3D(face, mid - Vector3(dir.x, 0, dir.y) * 0.02))
				_add_post(p, 0.08)
				_landmarks.append([p, "speed", dir])
				var lb := Label3D.new()
				lb.text = str(kmh)
				lb.font = _font
				lb.font_size = 64
				lb.pixel_size = 0.0055 if med else 0.0062
				lb.outline_size = 0
				lb.modulate = Palette.col("bg")
				lb.shaded = true
				lb.double_sided = false
				var front := mid - Vector3(dir.x, 0, dir.y) * 0.045
				lb.position = front + (Vector3.ZERO if med else Vector3(0, -0.08, 0))
				lb.rotation.y = atan2(-dir.x, -dir.y)
				lb.visibility_range_end = 60.0
				world.add_child(lb)
				if not med:
					var top := Label3D.new()
					top.text = "MAXIMUM"
					top.font = _font
					top.font_size = 32
					top.pixel_size = 0.0045
					top.modulate = Palette.col("bg")
					top.shaded = true
					top.double_sided = false
					top.position = front + Vector3(0, 0.24, 0)
					top.rotation.y = lb.rotation.y
					top.visibility_range_end = 45.0
					world.add_child(top)
	if poles.is_empty():
		return
	var pole := CylinderMesh.new()
	pole.top_radius = 0.035
	pole.bottom_radius = 0.035
	pole.height = 2.2
	pole.radial_segments = 6
	pole.rings = 1
	pole.material = _surface("pole")
	_chunked(pole, poles, LAMP_RANGE)
	if med:
		var rim := CylinderMesh.new()
		rim.top_radius = 0.4
		rim.bottom_radius = 0.4
		rim.height = 0.03
		rim.radial_segments = 16
		rim.rings = 1
		rim.material = mat("hazard", 0.15)
		var face := CylinderMesh.new()
		face.top_radius = 0.31
		face.bottom_radius = 0.31
		face.height = 0.03
		face.radial_segments = 16
		face.rings = 1
		face.material = _surface("mark")
		_chunked(rim, rims, LAMP_RANGE)
		_chunked(face, plates, LAMP_RANGE)
	else:
		var border := _boxm(Vector3(0.66, 0.84, 0.02))
		border.material = _surface("pole")
		var board := _boxm(Vector3(0.6, 0.78, 0.03))
		board.material = _surface("mark")
		_chunked(border, rims, LAMP_RANGE)
		_chunked(board, plates, LAMP_RANGE)
	_tally("speed_signs", poles.size())

## ---- the signs every street has ------------------------------------------------------------
## Green street-name plates at the corners (Hebrew and English), a blue roundabout sign on
## every way into one, a blue crossing sign on both sides of each zebra and on every
## traffic-light pole, a P at the car parks, no-entry at the wrong end of a one-way street
## and the blue one-way arrow at its right end, "turn this way" where only one way out is
## allowed, "keep right" where a street splits round an island, and painted lane arrows
## before the junctions of the main roads.
var _sign_meshes := {}
var _pole_plates: Array = []         ## [kind, transform] of plates on poles built elsewhere
const SIGN_SCALE := 1.35
## Street-name plates are thousands; their names are drawn only near the car, by a small
## pool of labels handed to the nearest plates every so often (two thousand labels made up
## front cost a second of loading and a node each).
var _name_signs: Array = []          ## [transform, text]
var _name_hash := {}
var _name_pool: Array = []
var _name_t := 0.0
const NAME_POOL := 18
const NAME_SEEN := 55.0

func _names_tick(dt: float) -> void:
	_name_t -= dt
	if _name_t > 0.0 or _name_signs.is_empty():
		return
	_name_t = 0.4
	if _name_pool.is_empty():
		for i in range(NAME_POOL):
			var lb := Label3D.new()
			lb.font = _font
			lb.font_size = 40
			lb.pixel_size = 0.0058
			lb.outline_size = 0
			lb.modulate = _tone["mark"]
			# crisp and full white, like the reflective letters of a real plate: shaded and
			# blended they came out grey and see-through
			lb.shaded = false
			lb.alpha_cut = Label3D.ALPHA_CUT_OPAQUE_PREPASS
			lb.double_sided = false
			lb.line_spacing = -6.0
			lb.visible = false
			world.add_child(lb)
			_name_pool.append(lb)
	var near: Array = []
	for i: int in _near(_name_hash, _pos, NAME_SEEN, 50.0):
		var xf: Transform3D = _name_signs[i][0]
		var d := Vector2(xf.origin.x, xf.origin.z).distance_to(_pos)
		if d < NAME_SEEN:
			near.append([d, i])
	near.sort_custom(func(a, b): return a[0] < b[0])
	for k in range(_name_pool.size()):
		var lb: Label3D = _name_pool[k]
		if k < near.size():
			var sg: Array = _name_signs[near[k][1]]
			if lb.text != sg[1]:
				lb.text = sg[1]
				lb.pixel_size = _name_fit(String(sg[1]))
			lb.transform = sg[0]
			lb.visible = true
		else:
			lb.visible = false

## the label size that keeps a street's name inside the green of its plate (about 1.1 by
## 0.26 m before SIGN_SCALE): long names get smaller letters instead of running off the end
func _name_fit(text: String) -> float:
	var w := 1.0
	var lines := text.split("\n")
	for line: String in lines:
		w = maxf(w, _font.get_string_size(line, HORIZONTAL_ALIGNMENT_LEFT, -1, 40).x)
	var h := lines.size() * (_font.get_height(40) - 6.0)
	return minf(0.0058, minf(1.06 / w, 0.25 / maxf(h, 1.0)))

var _planted: Array = []             ## [kind, where, the way its face looks(, road)] of the signs that order

func _build_street_signs() -> void:
	var med := String(_place.get("look", "")) == "med"
	var plates := {}     # kind -> transforms
	var poles: Array = []
	var marks := CBuf.new(GROUND_CELL)
	var plant := func(kind: String, p: Vector2, facing: Basis, h: float) -> void:
		# a spot a set way from the road's edge line, near a junction, can be out on the
		# asphalt a rounded corner adds: across that corner's kerb instead, onto its pavement
		var q := _out_of_corner(p, 0.35)
		if q != p:
			if _push_out(q, 0.4, true, false) != Vector2.ZERO:
				return
			p = q
		# nor in the line the cars drive past a divided road's split: aside out of it
		var sp := _split_push(p, 0.06)
		if sp != Vector2.ZERO:
			if _push_out(p + sp, 0.4, true, false) != Vector2.ZERO:
				return
			p += sp
		# nor on any road's asphalt: between a divided road's halves where a street crosses
		# them (Tel Aviv's Yehezkel Kaufman by Nahum Goldman: autodrive ran over one, its
		# plan went through it -- tests/drive_bumps.gd, 22 Nov)
		var oa := _off_asphalt(p, 0.06)
		if oa != p:
			if _push_out(oa, 0.4, true, false) != Vector2.ZERO:
				return
			p = oa
		if not plates.has(kind):
			plates[kind] = []
		var gy := _h(p)
		# a third bigger than life: on a screen, at driving distance, life-size is a speck
		var plate_xf := Transform3D(facing * Basis.from_scale(Vector3.ONE * SIGN_SCALE), Vector3(p.x, gy + h, p.y))
		var pole_xf := Transform3D(Basis.from_scale(Vector3(1, h / 2.2, 1)), Vector3(p.x, gy + h * 0.5, p.y))
		(plates[kind] as Array).append(plate_xf)
		poles.append(pole_xf)
		_add_post(p, 0.06)
		_signs_at[_posts.size() - 1] = [kind, plate_xf, pole_xf]   # (one the car can bend: _bend_sign)
		if kind in ["noentry", "turn_l", "turn_r"]:   # (for tests: which way each one faces)
			_planted.append([kind, p, Vector2((facing * Vector3.BACK).x, (facing * Vector3.BACK).z)])
	var toward := func(dir: Vector2) -> Basis: return Basis(Vector3.UP, atan2(-dir.x, -dir.y))
	var side_spot := func(c: Vector2, dir: Vector2, back: float, w: float) -> Vector2:
		return c - dir * back + Vector2(-dir.y, dir.x) * (w * 0.5 + 0.8)
	var named := 0
	# the crossing signs strapped to the traffic-light poles: their pole is the light's
	for pp: Array in _pole_plates:
		if not plates.has(pp[0]):
			plates[pp[0]] = []
		(plates[pp[0]] as Array).append(pp[1])
	# the point `dist` metres along a road's points from index k, going `step` (+1 or -1)
	var walk := func(pts: PackedVector2Array, k: int, step: int, dist: float) -> Vector2:
		var left := dist
		while k + step >= 0 and k + step < pts.size():
			var seg := pts[k].distance_to(pts[k + step])
			if seg >= left:
				return pts[k].lerp(pts[k + step], left / maxf(seg, 0.001))
			left -= seg
			k += step
		return pts[k]
	var spot_free := func(p: Vector2, margin: float) -> bool:
		return _off_road(p, margin) and _push_out(p, 0.4, true, false) == Vector2.ZERO
	for ni: int in _tile_nodes.get(_tile, []):
		if _over():
			await _pause()
		var ways := _node_ways(ni)
		if ways < 2:
			continue
		var c := _nodes[ni]
		if ways == 3:
			_keep_right_at(ni, walk, spot_free, plant, toward)
		var arrivals: Array = []   # [dir in, road]
		var seen_names := {}
		for e: Vector2i in _node_roads[ni]:
			var r: Dictionary = _roads[e.x]
			if not r["drive"] or r["pv"] or r["k"] == "service":
				continue
			var pts: PackedVector2Array = r["pts"]
			for d2: int in [-1, 1]:
				var from := e.y + d2
				if from < 0 or from >= pts.size():
					continue
				var dir := (c - pts[from]).normalized()
				if r["o"] == 0 or r["o"] == -d2:
					arrivals.append([dir, r, c.distance_to(pts[from])])
				if ways >= 3 and r["o"] == -d2 and not _short_link(r, e.y, d2):
					# a one-way street whose traffic comes out here: driving into it from the
					# junction is against it -- no entry, facing whoever would turn in, on the
					# right and (a wide one) the left. (It stood at the other end, where
					# going in is the way the street runs: autodrive drove in under it.)
					var w: float = r["w"]
					for sd: float in ([1.0, -1.0] if w >= 9.0 else [1.0]):
						var sp: Vector2 = c - dir * (_node_r[ni] + 3.0) + Vector2(dir.y, -dir.x) * sd * (w * 0.5 + 0.8)
						if _off_road(sp, 0.4) and _push_out(sp, 0.4, true, false) == Vector2.ZERO:
							plant.call("noentry", sp, toward.call(-dir), 2.2)
							(_planted.back() as Array).append(e.x)
		if ways < 3:
			continue
		for a: Array in arrivals:
			var dir: Vector2 = a[0]
			var r: Dictionary = a[1]
			var w: float = r["w"]
			# a roundabout ahead
			var ring_ahead := false
			for e: Vector2i in _node_roads[ni]:
				if (_roads[e.x] as Dictionary).get("ring", false) and not r.get("ring", false):
					ring_ahead = true
			if ring_ahead:
				var sp: Vector2 = side_spot.call(c, dir, _node_r[ni] + 6.0, w)
				if _off_road(sp, 0.4) and _push_out(sp, 0.4, true, false) == Vector2.ZERO:
					plant.call("roundabout", sp, toward.call(dir), 2.2)
			# lane arrows before the junctions of the main roads
			if MAIN_ROADS.has(r["k"]) and float(a[2]) > 30.0 and not r.get("ring", false):
				_lane_arrows(marks, ni, dir, r)
			# only one way out (the street across the end is one-way): the blue "turn this
			# way" across the junction, facing the street coming in
			# (not at one point of a junction drawn as several: the ways on from one point
			# are not the junction's -- "turn left" stood where the road runs straight on
			# through the next point)
			if not r.get("ring", false) and not ring_ahead and not _in_knot(ni):
				var mv := _moves(ni, dir)
				if mv.size() == 1 and not mv.has("s"):
					for extra: float in [0.8, 1.8, 2.8, 3.8]:
						var far := c + dir * (_node_r[ni] + extra)
						if spot_free.call(far, 0.4):
							plant.call("turn_r" if mv.has("r") else "turn_l", far, toward.call(dir), 2.2)
							break
		# a one-way street leaving here: the blue arrow at its corner, side-on to the street
		# it leaves from so the cross traffic reads which way it runs (under the name plate
		# when there is one: same corner, same pole)
		for e: Vector2i in _node_roads[ni]:
			var r: Dictionary = _roads[e.x]
			if ways < 3 or r["o"] == 0 or not r["drive"] or r.get("ring", false) or r["k"] == "service" \
					or HIGHWAYS.has(r["k"]) or r["k"] == "primary" or r["k"] == "primary_link":
				continue   # (a one-way primary is mostly half of a dual carriageway: no arrow)
			var nxt: int = e.y + int(r["o"])
			var pts: PackedVector2Array = r["pts"]
			if nxt < 0 or nxt >= pts.size():
				continue
			if _divided_half_at(ni, e.x, nxt):
				continue   # (half of a divided road where it splits off: no arrow -- see there)
			var along := (pts[nxt] - c).normalized()
			var across := Vector2(-along.y, along.x)
			var w: float = r["w"]
			for side: float in [1.0, -1.0]:
				var corner := c + along * (w * 0.5 + 2.0) + across * side * (w * 0.5 + 1.0)
				if spot_free.call(corner, 0.5):
					plant.call("oneway", corner, Basis(Vector3.UP, atan2(along.x, along.y) - PI * 0.5), 2.0)
					break
		# a street-name plate at a corner for each named street through it, parallel to it,
		# read from the cross street
		for e: Vector2i in _node_roads[ni]:
			var r: Dictionary = _roads[e.x]
			var nm := String(r["name"])
			if nm == "" or seen_names.has(nm) or not r["drive"] or r["k"] == "service" or HIGHWAYS.has(r["k"]):
				continue
			seen_names[nm] = true
			var pts: PackedVector2Array = r["pts"]
			var k2 := e.y + 1 if e.y + 1 < pts.size() else e.y - 1
			var along := (pts[k2] - c).normalized()
			var across := Vector2(-along.y, along.x)
			var corner := c + along * (float(r["w"]) * 0.5 + 2.0) + across * (float(r["w"]) * 0.5 + 1.0)
			if not _off_road(corner, 0.5) or _push_out(corner, 0.5, true, false) != Vector2.ZERO:
				corner = c - along * (float(r["w"]) * 0.5 + 2.0) - across * (float(r["w"]) * 0.5 + 1.0)
				if not _off_road(corner, 0.5) or _push_out(corner, 0.5, true, false) != Vector2.ZERO:
					continue
			var face := Basis(Vector3.UP, atan2(along.x, along.y) - PI * 0.5)   # its face looks across the street it names
			plant.call("street", corner, face, 2.6)
			var en := String(r["en"])
			var text := ("רח' " + nm + ("\n" + en.to_upper() if en != "" else "")) if med else (en if en != "" else nm)
			_hash_add(_name_hash, Rect2(corner, Vector2.ZERO), 50.0, _name_signs.size())
			_name_signs.append([Transform3D(face * Basis.from_scale(Vector3.ONE * SIGN_SCALE), Vector3(corner.x, _h(corner) + 2.6, corner.y) + face * Vector3(0, 0, 0.04)), text])
			named += 1
	# crossing signs, both sides of each zebra
	for ni: int in _tile_nodes.get(_tile, []):
		if not _crossing_set.has(ni):
			continue
		var c := _nodes[ni]
		for e: Vector2i in _node_roads[ni]:
			var r: Dictionary = _roads[e.x]
			if not r["drive"] or r["k"] == "service":
				continue
			var pts: PackedVector2Array = r["pts"]
			for d2: int in [-1, 1]:
				var from := e.y + d2
				if from < 0 or from >= pts.size() or (r["o"] != 0 and r["o"] != -d2):
					continue
				var dir := (c - pts[from]).normalized()
				var sp: Vector2 = side_spot.call(c, dir, 2.5, float(r["w"]))
				if _off_road(sp, 0.4) and _push_out(sp, 0.4, true, false) == Vector2.ZERO:
					plant.call("crossing", sp, toward.call(dir), 2.4)
			break
	# car parks: a P by the road at the corner nearest it
	for ring: PackedVector2Array in _rings_near("parking"):
		if _area(ring) < 300.0 or not _ring_mine(ring):
			continue
		var best := INF
		var at := Vector2.ZERO
		var dir := Vector2.ZERO
		for q in ring:
			var hit := _nearest_seg(q, 25.0, true, true)
			if not hit.is_empty() and float(hit["edge"]) < best and float(hit["edge"]) > 0.6:
				best = float(hit["edge"])
				at = q
				dir = ((hit["q"] as Vector2) - q).normalized()
		if best < INF and _push_out(at, 0.4, true, false) == Vector2.ZERO:
			plant.call("parking", at, Basis(Vector3.UP, atan2(dir.x, dir.y)), 2.3)
	var pole := CylinderMesh.new()
	pole.top_radius = 0.035
	pole.bottom_radius = 0.035
	pole.height = 2.2
	pole.radial_segments = 6
	pole.rings = 1
	pole.material = _surface("pole")
	_chunked(pole, poles, LAMP_RANGE)
	for kind: String in plates:
		_chunked(_street_sign_mesh(kind), plates[kind], LAMP_RANGE)
		_tally("sign_" + kind, (plates[kind] as Array).size())
	_add_mesh(marks, _surface("mark"), false, DETAIL_RANGE)
	_tally("street_signs", poles.size())
	_tally("street_names", named)

## A two-way street splitting into a pair of one-way carriageways at node `ni` (three ways:
## the street in, one carriageway out and one back): a blue "keep right" on the nose of the
## island between them, facing the street coming in.
func _keep_right_at(ni: int, walk: Callable, spot_free: Callable, plant: Callable, toward: Callable) -> void:
	var c := _nodes[ni]
	var two: Array = []      # direction coming in on the two-way street
	var outs: Array = []     # [points, index, step] of the carriageway leaving
	var ins: Array = []      # ...and the one coming back
	for e: Vector2i in _node_roads[ni]:
		var r: Dictionary = _roads[e.x]
		if not r["drive"]:
			continue
		if r["k"] == "service" or r.get("ring", false):
			return
		var pts: PackedVector2Array = r["pts"]
		for d2: int in [-1, 1]:
			var k := e.y + d2
			if k < 0 or k >= pts.size():
				continue
			if r["o"] == 0:
				two.append((c - pts[k]).normalized())
			elif r["o"] == d2:
				outs.append([pts, e.y, d2])
			else:
				ins.append([pts, e.y, d2])
	if two.size() != 1 or outs.size() != 1 or ins.size() != 1:
		return
	var dir: Vector2 = two[0]
	for dist: float in [8.0, 12.0, 16.0, 20.0]:
		var pa: Vector2 = walk.call(outs[0][0], outs[0][1], outs[0][2], dist)
		var pb: Vector2 = walk.call(ins[0][0], ins[0][1], ins[0][2], dist)
		var nose := (pa + pb) * 0.5
		if pa.distance_to(pb) > 24.0 or (nose - c).dot(dir) < dist * 0.6:
			return   # not a pair carrying on ahead side by side: a junction, not a split
		if spot_free.call(nose, 0.3):
			plant.call("keepright", nose, toward.call(dir), 1.6)
			return

## painted arrows in the lane(s) coming into junction `ni` going `dir`: straight, right,
## left -- whichever ways out there are from it
func _lane_arrows(buf: Buf, ni: int, dir: Vector2, r: Dictionary) -> void:
	var c := _nodes[ni]
	var moves := _moves(ni, dir)
	if moves.is_empty():
		return
	var w: float = r["w"]
	var lanes: Array = []
	if r["o"] == 0:
		lanes = [clampf(w * 0.25, 1.2, 1.9)]
	else:
		var n := maxi(1, int(r["l"]) if int(r["l"]) > 0 else int(w / 3.4))
		for i in range(n):
			lanes.append(-w * 0.5 + w * (i + 0.5) / n)
	var right := Vector2(-dir.y, dir.x)
	var y := Y_MARK + 0.004
	for lane: float in lanes:
		var a := c - dir * (_node_r[ni] + 16.0) + right * lane
		var quad := func(p0: Vector2, p1: Vector2, half: float) -> void:
			var d := (p1 - p0).normalized()
			var n := Vector2(-d.y, d.x) * half
			buf.quad3(_g3(p0 - n, y), _g3(p1 - n, y), _g3(p1 + n, y), _g3(p0 + n, y))
		var head := func(base: Vector2, d: Vector2) -> void:
			var n := Vector2(-d.y, d.x)
			buf.tri(_g3(base - n * 0.38, y), _g3(base + n * 0.38, y), _g3(base + d * 1.1, y), Vector3.UP, Color.WHITE)
		quad.call(a - dir * 2.6, a + dir * 0.4, 0.09)
		if moves.has("s"):
			quad.call(a + dir * 0.4, a + dir * 1.0, 0.09)
			head.call(a + dir * 1.0, dir)
		for t: String in ["r", "l"]:
			if moves.has(t):
				var sd := right if t == "r" else -right
				quad.call(a + dir * 0.2, a + dir * 0.2 + sd * 0.75, 0.09)
				head.call(a + dir * 0.2 + sd * 0.75, sd)

## the ways out of junction `ni` for a car arriving going `dir`: "s" straight on, "r" right,
## "l" left (never back the way it came, never the wrong way down a one-way)
## a short piece (under 30 m) from point k of road r going `step` to another junction: a link
## inside a junction drawn as several points, not a street
## One-way road ri leaving point ni (its next point `nxt`): half of a divided road, where it
## splits off -- another of its name there, two-way (the road it splits from) or one-way the
## other way, coming in from beside it (the other half)? Its "one way" arrow at the corner
## would stand where the two-way road's lane runs on into the half: OSM starts both halves at
## the two-way road's middle, so for some metres the cars drive past the half's asphalt
## (Ashdod's Shlomo Ben Yosef, 9 m splitting into two 4 m halves: autodrive's side met the
## arrow's pole 0.9 m from its middle, and lost 19 km/h knocking it flat, every time).
func _divided_half_at(ni: int, ri: int, nxt: int) -> bool:
	var r: Dictionary = _roads[ri]
	var nm := String(r.get("name", ""))
	if nm == "":
		return false
	var c: Vector2 = _nodes[ni]
	var out := ((r["pts"] as PackedVector2Array)[nxt] - c).normalized()
	for e: Vector2i in _node_roads[ni]:
		if e.x == ri:
			continue
		var o: Dictionary = _roads[e.x]
		if String(o.get("name", "")) != nm or not o["drive"]:
			continue
		if o["o"] == 0:
			# (the road it splits from: on behind it, and wider -- not a street that is one-way
			# from here on, the same width, where the arrow is right)
			for k: int in [e.y - 1, e.y + 1]:
				if k >= 0 and k < (o["pts"] as PackedVector2Array).size() and float(o["w"]) > float(r["w"]) + 2.0 \
						and ((o["pts"] as PackedVector2Array)[k] - c).normalized().dot(out) < -0.5:
					return true
			continue
		var prev: int = e.y - int(o["o"])   # (where its traffic comes from, if it comes in here)
		var opts: PackedVector2Array = o["pts"]
		if prev >= 0 and prev < opts.size() and (opts[prev] - c).normalized().dot(out) > 0.5:
			return true
	return false

func _short_link(r: Dictionary, k: int, step: int) -> bool:
	var pts: PackedVector2Array = r["pts"]
	var ids: PackedInt32Array = r["ids"]
	var run := 0.0
	var i := k
	while i + step >= 0 and i + step < pts.size():
		run += pts[i].distance_to(pts[i + step])
		i += step
		if run > 30.0:
			return false
		if _node_ways(ids[i]) >= 3:
			return true
	return false

## node ni is one point of a junction drawn as several: another junction point within 30 m
## along one of its roads
func _in_knot(ni: int) -> bool:
	for e: Vector2i in _node_roads[ni]:
		var r: Dictionary = _roads[e.x]
		if not r["drive"]:
			continue
		for step: int in [1, -1]:
			if _short_link(r, e.y, step):
				return true
	return false

func _moves(ni: int, dir: Vector2) -> Dictionary:
	var c := _nodes[ni]
	var moves := {}
	for e: Vector2i in _node_roads[ni]:
		var r2: Dictionary = _roads[e.x]
		if not r2["drive"] or r2["pv"] or r2["k"] == "service":
			continue
		var p2: PackedVector2Array = r2["pts"]
		for d2: int in [1, -1]:
			var nxt := e.y + d2
			if nxt < 0 or nxt >= p2.size() or (r2["o"] != 0 and r2["o"] != d2):
				continue
			var go := (p2[nxt] - c).normalized()
			var turn := dir.angle_to(go)
			if absf(turn) > 2.6:
				continue   # back the way it came
			moves["s" if absf(turn) < 0.5 else ("r" if turn > 0.0 else "l")] = true
	return moves

## a sign's plate as one surface (its colours in the vertex colours), facing +Z, grey behind
## (the one-way arrow is painted on both faces: it stands side-on to the cross street)
func _street_sign_mesh(kind: String) -> ArrayMesh:
	if _sign_meshes.has(kind):
		return _sign_meshes[kind]
	var b := Buf.new()
	var blue: Color = _tone["signblue"]
	var white: Color = _tone["mark"]
	var red: Color = _tone["signred"]
	var green: Color = _tone["signgreen"]
	var back: Color = _tone["pole"]
	var flat := func(pts: Array, z: float, col: Color) -> void:
		for i in range(1, pts.size() - 1):
			var p0: Vector2 = pts[0]
			var p1: Vector2 = pts[i]
			var p2: Vector2 = pts[i + 1]
			b.tri(Vector3(p0.x, p0.y, z), Vector3(p1.x, p1.y, z), Vector3(p2.x, p2.y, z), Vector3.BACK, col)
			if z < 0.005:   # the back
				b.tri(Vector3(p0.x, p0.y, z - 0.01), Vector3(p2.x, p2.y, z - 0.01), Vector3(p1.x, p1.y, z - 0.01), Vector3.FORWARD, back)
	var circle := func(r: float) -> Array:
		var out: Array = []
		for i in range(16):
			out.append(Vector2(cos(TAU * i / 16.0), sin(TAU * i / 16.0)) * r)
		return out
	var box := func(cx: float, cy: float, w: float, h: float) -> Array:
		return [Vector2(cx - w * 0.5, cy - h * 0.5), Vector2(cx + w * 0.5, cy - h * 0.5), Vector2(cx + w * 0.5, cy + h * 0.5), Vector2(cx - w * 0.5, cy + h * 0.5)]
	# both faces in the same colour, for a plate seen from either side
	var both := func(pts: Array, z: float, col: Color) -> void:
		for i in range(1, pts.size() - 1):
			var p0: Vector2 = pts[0]
			var p1: Vector2 = pts[i]
			var p2: Vector2 = pts[i + 1]
			b.tri(Vector3(p0.x, p0.y, z), Vector3(p1.x, p1.y, z), Vector3(p2.x, p2.y, z), Vector3.BACK, col)
			b.tri(Vector3(p0.x, p0.y, -z - 0.01), Vector3(p2.x, p2.y, -z - 0.01), Vector3(p1.x, p1.y, -z - 0.01), Vector3.FORWARD, col)
	# left-right mirror of a polygon, wound the same way round
	var mirror := func(pts: Array) -> Array:
		var out: Array = []
		for i in range(pts.size() - 1, -1, -1):
			out.append(Vector2(-(pts[i] as Vector2).x, (pts[i] as Vector2).y))
		return out
	match kind:
		"oneway":
			both.call(box.call(0, 0, 0.7, 0.3), 0.0, blue)
			both.call(box.call(-0.07, 0.0, 0.4, 0.07), 0.006, white)
			both.call([Vector2(0.12, -0.11), Vector2(0.29, 0.0), Vector2(0.12, 0.11)], 0.006, white)
		"turn_r", "turn_l":
			# the blue "this way only": up from the bottom, then round the corner
			flat.call(circle.call(0.32), 0.0, blue)
			var parts: Array = [box.call(-0.06, -0.06, 0.08, 0.3), box.call(0.02, 0.05, 0.24, 0.08),
					[Vector2(0.12, -0.07), Vector2(0.27, 0.05), Vector2(0.12, 0.17)]]
			for pts: Array in parts:
				flat.call(pts if kind == "turn_r" else mirror.call(pts), 0.006, white)
		"keepright":
			# the blue "keep right" on the nose of a traffic island: an arrow down to the right
			flat.call(circle.call(0.32), 0.0, blue)
			var d := Vector2(1, -1).normalized()
			var n := Vector2(-d.y, d.x)
			var a := -d * 0.17
			var t := d * 0.07
			flat.call([a - n * 0.04, t - n * 0.04, t + n * 0.04, a + n * 0.04], 0.006, white)
			flat.call([t - n * 0.12, t + d * 0.15, t + n * 0.12], 0.006, white)
		"roundabout":
			flat.call(circle.call(0.32), 0.0, blue)
			for k in range(3):   # three white arrows chasing round
				var a0 := TAU * k / 3.0
				for j in range(4):
					var t0 := a0 + j * 0.32
					var t1 := t0 + 0.32
					flat.call([Vector2(cos(t0), sin(t0)) * 0.15, Vector2(cos(t0), sin(t0)) * 0.21, Vector2(cos(t1), sin(t1)) * 0.21, Vector2(cos(t1), sin(t1)) * 0.15], 0.006, white)
				var tip := a0 + 1.5
				flat.call([Vector2(cos(tip - 0.25), sin(tip - 0.25)) * 0.1, Vector2(cos(tip - 0.25), sin(tip - 0.25)) * 0.26, Vector2(cos(tip), sin(tip)) * 0.18], 0.006, white)
		"crossing":
			flat.call(box.call(0, 0, 0.56, 0.56), 0.0, blue)
			flat.call([Vector2(0, 0.22), Vector2(-0.23, -0.18), Vector2(0.23, -0.18)], 0.006, white)
			flat.call(box.call(0.0, -0.05, 0.05, 0.16), 0.012, back)
			flat.call(box.call(0.0, 0.06, 0.06, 0.06), 0.012, back)
		"noentry":
			flat.call(circle.call(0.32), 0.0, red)
			flat.call(box.call(0, 0, 0.44, 0.1), 0.006, white)
		"parking":
			flat.call(box.call(0, 0, 0.5, 0.5), 0.0, blue)
			flat.call(box.call(-0.06, 0.0, 0.07, 0.34), 0.006, white)
			flat.call(box.call(0.03, 0.08, 0.2, 0.18), 0.006, white)
			flat.call(box.call(0.03, 0.08, 0.09, 0.07), 0.012, blue)
		"street":
			flat.call([Vector2(-0.66, -0.17), Vector2(0.58, -0.17), Vector2(0.7, 0.0), Vector2(0.58, 0.17), Vector2(-0.66, 0.17)], 0.0, white)
			flat.call([Vector2(-0.63, -0.14), Vector2(0.56, -0.14), Vector2(0.66, 0.0), Vector2(0.56, 0.14), Vector2(-0.63, 0.14)], 0.006, green)
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, b.arrays())
	am.surface_set_material(0, _vc_mat())
	_sign_meshes[kind] = am
	return am

## the junction a node belongs to: itself if three or more ways meet there, else the first
## such node within `reach` metres along a road through it (-1 if none)
func _junction_of(node: int, reach: float) -> int:
	if _node_ways(node) >= 3:
		return node
	var best := -1
	var best_d := INF
	for e: Vector2i in _node_roads[node]:
		var r: Dictionary = _roads[e.x]
		if not r["drive"]:
			continue
		var ids: PackedInt32Array = r["ids"]
		var pts: PackedVector2Array = r["pts"]
		for step: int in [-1, 1]:
			var d := 0.0
			var k := e.y
			while k + step >= 0 and k + step < ids.size():
				d += pts[k].distance_to(pts[k + step])
				k += step
				if d > reach:
					break
				if _node_ways(ids[k]) >= 3:
					if d < best_d:
						best_d = d
						best = ids[k]
					break
	return best

## OSM maps few stop and give-way signs (Givatayim 33, Tel Aviv 22), where nearly every side
## street meeting a bigger one without lights has one. Each such way in gets one here, as a
## sign facing that way: a stop where the bigger road is a main road (secondary or up) in an
## Israeli town, a give-way otherwise (and always on a slip road, and in Bedford, where stop
## signs are rare). Left alone: a slip road merging onto a motorway or trunk road, two
## streets of one class (first come, as before), roundabouts
## (their own rule), service roads and driveways, lit junctions, a junction with a sign mapped
## within SIGN_MAPPED, the gap through a divided road's median (only the outer way in), and a
## street that goes on through the junction under another class.
const SIGN_MAPPED := 30.0
func _infer_signs() -> void:
	if not _city_data.has("signs"):
		_city_data["signs"] = []
	var signs: Array = _city_data["signs"]
	var mapped := {}
	for sg: Array in signs:
		var node := int(sg[0])
		if node >= 0 and node < _nodes.size():
			_hash_add(mapped, Rect2(_nodes[node], Vector2.ZERO), SEG_CELL, node)
	var med := String(_place.get("look", "")) == "med"
	var added := {"stop": 0, "give_way": 0}
	for ni in range(_nodes.size()):
		if _node_roads[ni].size() < 2 or _sig_set.has(ni) or _node_ways(ni) < 3:
			continue
		var c := _nodes[ni]
		var top := 0
		var names := {}   # the top class's street names here
		var ring := false
		for e: Vector2i in _node_roads[ni]:
			var r: Dictionary = _roads[e.x]
			if not r["drive"]:
				continue
			ring = ring or bool(r["ring"])
			var rank := int(ROAD_RANK.get(r["k"], 1))
			if rank > top:
				top = rank
				names = {}
			if rank == top and String(r["name"]) != "":
				names[String(r["name"])] = true
		if ring or top < 2:
			continue
		var near_sign := false
		for o: int in _near(mapped, c, SIGN_MAPPED, SEG_CELL):
			near_sign = near_sign or _nodes[o].distance_to(c) < SIGN_MAPPED
		for o: int in _near(_sig_hash, c, 30.0, SEG_CELL):
			near_sign = near_sign or _nodes[o].distance_to(c) < 30.0
		if near_sign:
			continue
		for e: Vector2i in _node_roads[ni]:
			var r: Dictionary = _roads[e.x]
			var rank := int(ROAD_RANK.get(r["k"], 1))
			if not r["drive"] or r["pv"] or rank == 0 or rank >= top or names.has(String(r["name"])):
				continue
			if String(r["k"]).ends_with("_link") and top >= 6:
				continue   # a slip road onto a motorway merges at speed: no line to wait at
			var pts: PackedVector2Array = r["pts"]
			for d2: int in [-1, 1]:
				var from := e.y + d2
				if from < 0 or from >= pts.size() or (r["o"] != 0 and r["o"] != -d2):
					continue
				var back := _points_back(e, d2, SITE_LEG)
				if not back.is_empty():
					var o := int(back[back.size() - 1][0])
					if o != ni and _node_ways(o) >= 3 and _other_half(ni, o, e.x):
						continue   # across a divided road's median: the outer way in has it
				var way_in := (c - pts[from]).normalized()
				var kind := "stop" if med and top >= 4 and not String(r["k"]).ends_with("_link") else "give_way"
				signs.append([ni, kind, roundi(way_in.x * 100.0), roundi(way_in.y * 100.0)])
				_bucket(_tile_signs, _tile_of(c), signs.size() - 1)
				added[kind] += 1
	_dressing["signs inferred: stop"] = added["stop"]
	_dressing["signs inferred: give way"] = added["give_way"]

## Stop and give-way signs: a pole and a plate on the right of each way in they are for.
## Which ways: the one OSM says (direction=forward/backward); else, at a junction, the
## minor roads into it (all of them if they are all alike); on a plain stretch, both ways.
func _build_signs() -> void:
	var poles: Array = []
	var plates := {"stop": [], "give_way": []}
	var all_signs: Array = _city_data.get("signs", [])
	for si: int in _tile_signs.get(_tile, []):
		if _over():
			await _pause()
		var sg: Array = all_signs[si]
		var node := int(sg[0])
		if node < 0 or node >= _nodes.size():
			continue
		var kind := String(sg[1])
		if not plates.has(kind):
			continue
		var facing := Vector2(float(sg[2]), float(sg[3])) / 100.0
		var c := _nodes[node]
		var junction := _node_ways(node) >= 3
		var top := 0
		var bottom := 99
		for e: Vector2i in _node_roads[node]:
			var r: Dictionary = _roads[e.x]
			if r["drive"]:
				top = maxi(top, int(ROAD_RANK.get(r["k"], 1)))
				bottom = mini(bottom, int(ROAD_RANK.get(r["k"], 1)))
		var rules: Array = []
		# a sign facing one way is for the one way in nearest that way: a slip road merging at
		# a shallow angle comes in within 45 degrees of the street it joins, and both got its
		# give-way -- two plates side by side, and the street's own traffic giving way to it
		var best := 0.7
		if facing != Vector2.ZERO:
			for e: Vector2i in _node_roads[node]:
				var r: Dictionary = _roads[e.x]
				var pts: PackedVector2Array = r["pts"]
				for d2: int in [-1, 1]:
					var from := e.y + d2
					if r["drive"] and not r["pv"] and from >= 0 and from < pts.size() and (r["o"] == 0 or r["o"] == -d2):
						best = maxf(best, (c - pts[from]).normalized().dot(facing))
		for e: Vector2i in _node_roads[node]:
			var r: Dictionary = _roads[e.x]
			if not r["drive"] or r["pv"]:
				continue
			var pts: PackedVector2Array = r["pts"]
			for d2: int in [-1, 1]:
				var from := e.y + d2
				if from < 0 or from >= pts.size():
					continue
				if r["o"] != 0 and r["o"] != -d2:
					continue   # arriving from `from` is travelling -d2 along the road
				var way_in := (c - pts[from]).normalized()
				if facing != Vector2.ZERO:
					if way_in.dot(facing) < best - 0.0001:
						continue
				elif junction and top != bottom and int(ROAD_RANK.get(r["k"], 1)) >= top:
					continue   # the main road through has the right of way
				var line := _node_r[node] + 2.0 if junction else 1.0
				rules.append([kind, way_in, line])
				if kind == "stop" or kind == "give_way":
					_stop_lines.append([c, way_in, line, float(r["w"]), r["o"] != 0, "stop" if kind == "stop" else "give"])
				var right := Vector2(-way_in.y, way_in.x)
				# by the line on the right, or a little further back or out: at a corner the
				# first spot is often in the corner's asphalt or against a wall (Givatayim: 44
				# poles of 167 ways in stood at the first spot alone)
				var p := Vector2.INF
				for back: float in [0.4, 2.0, 4.0, 6.5]:
					for out: float in [0.7, 1.3]:
						var q := c - way_in * (line + back) + right * (float(r["w"]) * 0.5 + out)
						if p == Vector2.INF and _push_out(q, 0.3, false) == Vector2.ZERO and _off_road(q, 0.3):
							p = q
				if p == Vector2.INF:
					continue
				# one plate where two would stand side by side: two lanes of a slip road arriving
				# together, or two signs OSM maps a metre or two apart (Ashdod) -- the rules and
				# lines stay, each way in still gives way
				var twin := false
				for o: int in _near(_sign_poles, p, 3.0, SEG_CELL):
					var tw: Array = sign_at[o]
					twin = twin or ((tw[0] as Vector2).distance_to(p) < 3.0 and tw[2] == kind and (tw[1] as Vector2).dot(way_in) > 0.85)
				if twin:
					continue
				var gy := _h(p)
				_hash_add(_sign_poles, Rect2(p, Vector2.ZERO), SEG_CELL, sign_at.size())
				sign_at.append([p, way_in, kind, node, sg])
				poles.append(Transform3D(Basis(), Vector3(p.x, gy + 1.1, p.y)))
				(plates[kind] as Array).append(Transform3D(Basis(Vector3.UP, atan2(-way_in.x, -way_in.y)) * Basis.from_scale(Vector3.ONE * SIGN_SCALE), Vector3(p.x, gy + 2.3, p.y)))
				_add_post(p, 0.08)
				if kind == "stop" and String(_place.get("look", "")) != "med":
					var word := Label3D.new()   # a North American stop sign says so
					word.text = "STOP"
					word.font = _font
					word.font_size = 48
					word.pixel_size = 0.0058 * SIGN_SCALE
					word.outline_size = 0
					word.modulate = _tone["mark"]
					word.shaded = true
					word.double_sided = false
					word.rotation.y = atan2(-way_in.x, -way_in.y)
					word.position = Vector3(p.x, gy + 2.3, p.y) - Vector3(way_in.x, 0, way_in.y) * 0.03
					word.visibility_range_end = 60.0
					world.add_child(word)
		if not rules.is_empty():
			if _signs.has(node):   # (another sign here already, for another way in: both kept)
				(_signs[node] as Array).append_array(rules)
				continue
			_signs[node] = rules
			_hash_add(_sign_hash, Rect2(c, Vector2.ZERO), SEG_CELL, node)
	if poles.is_empty():
		return
	var pole := CylinderMesh.new()
	pole.top_radius = 0.035
	pole.bottom_radius = 0.035
	pole.height = 2.2
	pole.radial_segments = 6
	pole.rings = 1
	pole.material = _surface("pole")
	_chunked(pole, poles, LAMP_RANGE)
	for kind: String in plates:
		if not (plates[kind] as Array).is_empty():
			_chunked(_sign_plate(kind), plates[kind], LAMP_RANGE)
	_tally("signs", poles.size())

## the plate, facing +Z: a red octagon in a thin white rim, or a white triangle point down
## in a red one; grey behind
func _sign_plate(kind: String) -> ArrayMesh:
	var outer: Array = []
	var inner: Array = []
	if kind == "stop":
		for i in range(8):
			var a := TAU * (float(i) + 0.5) / 8.0
			outer.append(Vector2(cos(a), sin(a)) * 0.38)
			inner.append(Vector2(cos(a), sin(a)) * 0.34)
	else:
		for v: Vector2 in [Vector2(0, -0.42), Vector2(0.46, 0.38), Vector2(-0.46, 0.38)]:
			outer.append(v)
			inner.append(Vector2(v.x, v.y + 0.035) * 0.62)
	var rim := Buf.new()
	var face := Buf.new()
	var back := Buf.new()
	if kind == "stop" and String(_place.get("look", "")) == "med":
		# Israel's stop sign carries a white hand, palm out
		var z := 0.02
		var hand: Array = [[-0.085, -0.13, 0.17, 0.17]]   # palm: x, y (bottom), w, h
		for f: Array in [[-0.085, 0.13], [-0.04, 0.16], [0.005, 0.155], [0.05, 0.13]]:
			hand.append([f[0], 0.03, 0.038, f[1]])
		for hb: Array in hand:
			var x0: float = hb[0]
			var y0: float = hb[1]
			_poly(rim, [Vector3(x0, y0, z), Vector3(x0 + hb[2], y0, z), Vector3(x0 + hb[2], y0 + hb[3], z), Vector3(x0, y0 + hb[3], z)], Vector3.BACK)
		_poly(rim, [Vector3(0.085, -0.06, z), Vector3(0.15, 0.0, z), Vector3(0.13, 0.03, z), Vector3(0.07, -0.01, z)], Vector3.BACK)   # thumb
	_poly(rim, outer.map(func(v): return Vector3(v.x, -v.y, 0.012)), Vector3.BACK)
	_poly(face, inner.map(func(v): return Vector3(v.x, -v.y, 0.016)), Vector3.BACK)
	_poly(back, outer.map(func(v): return Vector3(v.x, -v.y, 0.0)), Vector3.FORWARD)
	var red := mat("hazard", 0.15)
	var white := _surface("mark")
	var am := ArrayMesh.new()
	for pair: Array in [[rim, white if kind == "stop" else red], [face, red if kind == "stop" else white],
			[back, _surface("pole")]]:
		am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, (pair[0] as Buf).arrays())
		am.surface_set_material(am.get_surface_count() - 1, pair[1])
	return am

## how many ways a car can leave a graph node by (3 or more: a junction)
func _node_ways(n: int) -> int:
	var count := 0
	for e: Vector2i in _node_roads[n]:
		var r: Dictionary = _roads[e.x]
		if not r["drive"]:
			continue
		if e.y > 0:
			count += 1
		if e.y < (r["pts"] as PackedVector2Array).size() - 1:
			count += 1
	return count

## the sign for traffic arriving at node `n` going `dir`: [kind, line before the node] or []
func _sign_rule(n: int, dir: Vector2) -> Array:
	var rules: Array = _signs.get(n, [])
	if rules.is_empty() or dir == Vector2.ZERO:
		return []
	var d := dir.normalized()
	for rule: Array in rules:
		if d.dot(rule[1]) > 0.7:
			return [rule[0], rule[2]]
	return []

## the player through a stop sign without stopping: called out, like a red light
func _check_stop_signs() -> void:
	if absf(_v) < 0.8:
		_stopped_odo = _odo
	if _signs.is_empty() or _v < 2.0 or _odo - _sign_odo < 20.0:
		return
	for n: int in _near(_sign_hash, _pos, 20.0, SEG_CELL):
		var rule := _sign_rule(n, _fwd())
		if rule.is_empty() or rule[0] != "stop":
			continue
		if _nodes[n].distance_to(_pos) > float(rule[1]) + 0.6:
			continue
		_sign_odo = _odo
		if _odo - _stopped_odo > 12.0:
			_show_banner("didn't stop at the stop sign", 1.8)
			Probe.event("stop_sign", {"street": _on_name, "kmh": int(_v * 3.6), "auto": _auto})
		return

## autodrive at signs on its lane: a full stop at a stop sign's line (a moment, then on),
## slow to walking pace for a give-way
func _ap_sign_v(dt: float) -> float:
	if _signs.is_empty() or _ap_pts.size() < 2:
		return INF
	var best := INF
	for n: int in _near(_sign_hash, _pos, 60.0, SEG_CELL):
		var c := _nodes[n]
		var base := -_ap_pts[0].distance_to(Geometry2D.get_closest_point_to_segment(_pos, _ap_pts[0], _ap_pts[1]))
		for j in range(_ap_pts.size() - 1):
			if base > 60.0:
				break
			var a := _ap_pts[j]
			var b := _ap_pts[j + 1]
			var cp := Geometry2D.get_closest_point_to_segment(c, a, b)
			if cp.distance_to(c) < 4.5:
				var rule := _sign_rule(n, b - a)
				if rule.is_empty():
					break
				var line := base + a.distance_to(cp) - float(rule[1])
				if line < -1.0:
					break
				if rule[0] == "give_way":
					best = minf(best, sqrt(16.0 + 2.0 * 2.6 * maxf(line, 0.0)))
				elif _ap_sign_done != n:
					if line < 2.5 and _v < 0.3:
						_ap_sign_wait += dt
						if _ap_sign_wait > 0.8:
							_ap_sign_done = n
							_ap_sign_wait = 0.0
						best = 0.0
					else:
						best = minf(best, sqrt(2.0 * 2.6 * maxf(line - 0.4, 0.0)))
				break
			base += a.distance_to(b)
	return best

## The car coming into a junction with lights: noted as its nose crosses the stop line (the
## rest of that junction -- the far half of a divided road -- is then through, not stopped
## at), and whether that was on red. Read by the way it came in, a few metres back: the
## heading mid-turn read the cross street's light, and the check used to wait until the car
## was in the middle, so a car in on the last of the amber was told it ran a red.
var _reds := 0
var _trail := PackedVector2Array()   ## where the car was, a point every 2 m, the last few
var _trail_odo := 0.0


func _through_lights() -> void:
	if _trail.is_empty() or _odo - _trail_odo > 2.0 or _pos.distance_to(_trail[_trail.size() - 1]) > 8.0:
		if not _trail.is_empty() and _pos.distance_to(_trail[_trail.size() - 1]) > 8.0:
			_trail = PackedVector2Array()   # (moved: put back on the road, a new start)
		_trail.append(_pos)
		_trail_odo = _odo
		if _trail.size() > 5:
			_trail.remove_at(0)
	if _v < 1.0 or _sig_set.is_empty():
		return
	var came := _came_dir()
	var nose := _pos + _fwd() * CAR_LEN * 0.5
	for n: int in _near(_sig_hash, _pos, 30.0, SEG_CELL):
		var s: int = _site_of.get(n, -1)
		if s == _light_site and _odo - _light_odo < SITE_KEEP:
			if _nodes[n].distance_to(_pos) < _node_r[n] + 3.0:
				_light_odo = _odo   # (still in it)
			continue
		var way := _way_in(n, came)
		if way.is_empty() or way[3]:
			continue   # not a way into it from outside: going by
		var rel := _nodes[n] - nose
		var along := rel.dot(came)
		if along > float(way[1]) or along < -_node_r[n] or absf(rel.dot(Vector2(-came.y, came.x))) > _node_r[n] + 2.0:
			continue
		_light_site = s
		_light_odo = _odo
		if _light_at(n, came) == "r" and _v > 2.5:
			_reds += 1
			_show_banner("ran a red light", 1.8)
			shake3d(1.5)
			Probe.event("red_light", {"street": _on_name, "kmh": int(_v * 3.6), "auto": _auto})
			_log.event("red light")
		return

## the way the car came, over the last 6 m or so (its heading, when it has not gone that far)
func _came_dir() -> Vector2:
	for i in range(_trail.size() - 1, -1, -1):
		if _trail[i].distance_to(_pos) > 5.0:
			return (_pos - _trail[i]).normalized()
	return _fwd() * signf(_v) if _v != 0.0 else _fwd()

## autodrive: the first light on the planned lane that counts -- of a junction it is not in
## already. Red: come to a stop at its line. Amber: stop if there is room to, else through.
## The speed allowed now (INF: none). A lane turning at a junction curves past its point,
## not over it: looked for only within 4.5 m of the point, a turn missed the light and drove
## through the red (now: within the junction and 2 m, as the car's own red-light check sees it).
var _ap_light_dbg: Array = []         ## the light autodrive read last: [point, its colour for my way, metres to where it stops] (for traces)

func _ap_light_v() -> float:
	_ap_light_dbg = []
	if _sig_set.is_empty() or _ap_pts.size() < 2:
		return INF
	var found: Array = []   # [along the lane to its stop line, node, way in]
	for n: int in _near(_sig_hash, _pos, 90.0, SEG_CELL):
		if _site_of.get(n, -1) == _light_site and _odo - _light_odo < SITE_KEEP \
				and (absf(_v) > 2.0 or _nodes[n].distance_to(_pos) - CAR_LEN * 0.5 < _node_r[n]):
			continue   # in it already: through (standing just over its line is not, see below)
		var c := _nodes[n]
		var base := -_ap_pts[0].distance_to(Geometry2D.get_closest_point_to_segment(_pos, _ap_pts[0], _ap_pts[1]))
		for j in range(_ap_pts.size() - 1):
			if base > 90.0:
				break
			var a := _ap_pts[j]
			var b := _ap_pts[j + 1]
			var cp := Geometry2D.get_closest_point_to_segment(c, a, b)
			if cp.distance_to(c) < _node_r[n] + 2.0:
				# the way in, a few metres back (mid-turn the lane runs diagonally across)
				var k := j
				var back := a.distance_to(cp)
				while k > 0 and back < 6.0:
					back += _ap_pts[k - 1].distance_to(_ap_pts[k])
					k -= 1
				var din := (cp - _ap_pts[k]).normalized()
				var way := _way_in(n, din)
				if way.is_empty() or way[3]:
					break   # going past it (the other half of a divided road), not into it
				# the line is so far before the point along the way in; this piece of lane may
				# be short of the point already (a right turn cuts the corner)
				var short := maxf(0.0, (c - cp).dot(din))
				found.append([base + a.distance_to(cp) - maxf(0.0, float(way[1]) - short), n, din])
				break
			base += a.distance_to(b)
	if found.is_empty():
		return INF
	found.sort_custom(func(x, y): return x[0] < y[0])
	# the nearest junction's point the lane comes to first, where its line is; one whose line
	# the nose is over already is through (all of it), and the next one counts
	var over := {}
	for f: Array in found:
		var n: int = f[1]
		if over.has(_site_of.get(n, -1)):
			continue
		var stop := float(f[0]) - (1.0 + CAR_LEN * 0.5)   # (the nose a metre short of the line)
		if stop < -1.5:
			if absf(_v) > 2.0 or _nodes[n].distance_to(_pos) - CAR_LEN * 0.5 < _node_r[n]:
				over[_site_of.get(n, -1)] = true
				continue   # over the line already, rolling (or in the junction): through
			stop = 0.0   # (standing a little over it -- stopped there for people on a crossing --
			             # is not through: it waits for its green where it stands)
		var state := _light_at(n, f[2])
		var raw := String(SIGNAL_CYCLE[_ph_at(n)][_light_group(n, f[2])])
		_ap_light_dbg = [n, raw, stop]
		if raw == "g":
			_ap_amber_n = -1
			return INF
		if _ap_amber_n == n:
			return _ap_brake_for(stop)   # (stopping for it already: kept to, through to its red)
		if raw == "gf" or raw == "y":
			# the green ending (flashing) or amber: on only if the nose is over the line before
			# the red, at the pace the plan goes up to it -- "too late to stop" alone (at
			# 3 m/s^2) went on at 50 km/h into a left turn, slowed for the corner, and the
			# amber ran out short of the line (the route set's one red, Ashdod's Bnei Brit)
			# (standing, or nearly: not off on an amber -- one stopped over its line for people
			# on the crossing waits there for its green)
			if (raw == "gf" or _v > 2.0) and _ap_time_to(stop + 1.0) < _light_red_in(n, f[2]) - 0.3:
				return INF
			# else stop: gently on the flashing green (or on, deciding again on the amber),
			# firmly on the amber if need be (too late even for that: on through)
			if _v * _v > 2.0 * (2.6 if raw == "gf" else 4.5) * maxf(stop - 0.5, 0.1):
				return INF
			_ap_amber_n = n
			return _ap_brake_for(stop)
		if state == "g":
			return INF
		return sqrt(2.0 * 2.6 * maxf(stop - 0.5, 0.0))
	return INF

## Stopping for a light that is changing: the speed to aim at now to brake at what the stop
## needs, and a fifth more. (Aimed at "the speed that just stops in time from here", the
## target sat a hair under the speed and the controller -- braking by how far over it is --
## hardly braked: the need grew and grew, and it gave up and drove on into the red.)
## Far off, or slow, the need is small: up to the line on the usual slope, as for a red.
## (Braking at 1.5 m/s^2 at least, wherever the line was, a green ending 80 m off stopped the
## car 23 m on, in the middle of the street -- and standing, the need is nothing, the speed
## to aim at nothing: it stood there all through the red. A user, twice: "the car weirdly
## stops in the middle of the run.")
var _ap_amber_n := -1                ## the lit point it decided to stop at as its green ended (kept to until green again)

func _ap_brake_for(stop: float) -> float:
	var room := stop - 0.5
	if room <= 0.2:
		return 0.0
	var v := maxf(_v, 0.0)
	var need := v * v / (2.0 * room)
	var slope := sqrt(2.0 * 2.6 * room)
	if need < 2.0:
		return slope
	return minf(maxf(v - minf(need * 1.2, 6.0) * 0.5, 0.0), slope)   # (autodrive brakes 2 m/s^2 for each m/s over: see _autodrive)

## seconds until the light at lit point n facing traffic going `dir` turns red (0: red, or
## red and amber, now)
func _light_red_in(n: int, dir: Vector2) -> float:
	var grp := _light_group(n, dir)
	if _wave != null and _wave.held(_site_of.get(n, -1), grp):
		return INF   # (held green for the car: wave.gd)
	var acc := 0.0
	var p0 := _ph_at(n)
	for k in range(SIGNAL_CYCLE.size()):
		var ph: Array = SIGNAL_CYCLE[(p0 + k) % SIGNAL_CYCLE.size()]
		if String(ph[grp]) in ["r", "ry"]:
			return acc
		acc += float(ph[0]) - (_t_at(n) if k == 0 else 0.0)
	return INF

## autodrive: seconds to drive `dist` metres along the plan, at the pace it goes there --
## halfway between the speed now and the slowest the plan allows by then and a few metres on
## (a corner just past a stop line slows the car before it); speeding up is not counted on
func _ap_time_to(dist: float) -> float:
	var vc := maxf(_v, 3.0)   # (holding its speed, unless the plan slows it)
	var along := 0.0
	var p := _pos
	for i in range(1, mini(_ap_pts.size(), _ap_v.size())):
		along += p.distance_to(_ap_pts[i])
		p = _ap_pts[i]
		if _ap_v[i] > 0.0:
			vc = minf(vc, _ap_v[i])
		if along > dist + 8.0:
			break
	return maxf(dist, 0.0) / maxf((maxf(_v, 0.0) + vc) * 0.5, 1.0)

## the light facing traffic that arrives at node `n` going `dir`, as a driver reads it: "g"
## (flashing green too: still go), "y", "r" (red-and-amber too: still stop), or "" where
## there is none
func _light_at(n: int, dir: Vector2) -> String:
	if not _sig_set.has(n):
		return ""
	var st: String = SIGNAL_CYCLE[_ph_at(n)][_light_group(n, dir)]
	return "g" if st == "gf" else ("r" if st == "ry" else st)

## the step of the light cycle lit point n is at, and how far into it: the city's clock, or
## its own while the green wave has it (wave.gd)
func _ph_at(n: int) -> int:
	return _wave.phase(_site_of.get(n, -1)) if _wave != null and not _wave.ovr.is_empty() else _sig_phase

func _t_at(n: int) -> float:
	return _wave.time(_site_of.get(n, -1)) if _wave != null and not _wave.ovr.is_empty() else _sig_t

## Which of the two signal groups (1 or 2, the columns of SIGNAL_CYCLE) traffic arriving at
## node n going `dir` belongs to: the site's axis it runs nearer, either way along it. The
## same at every point of a site, so a car going straight through a divided road's junction
## reads the same light at each half, and both ways along a street share it (the walk lights
## over it with them).
func _light_group(n: int, dir: Vector2) -> int:
	var s: int = _site_of.get(n, -1)
	if s < 0 or dir == Vector2.ZERO:
		return 1
	var site: Dictionary = _sites[s]
	var g := 1
	if float(site["hi"]) >= 0.0:
		# in group 1's arc (lo to hi, round the half circle), or not
		g = 1 if fposmod(fposmod(dir.angle(), PI) - float(site["lo"]), PI) <= fposmod(float(site["hi"]) - float(site["lo"]), PI) else 2
	return 3 - g if site.has("flip") else g

## the way into lit point n that traffic going `dir` takes ([way in, line, road, from inside]
## as in _sig_line), or [] when none runs within 45 degrees of it: going past the point, not
## into it (along the other half of a divided road, a few metres over)
func _way_in(n: int, dir: Vector2) -> Array:
	var best: Array = []
	var bd := 0.7
	for way: Array in _sig_line.get(n, []):
		var dt := (way[0] as Vector2).dot(dir.normalized())
		if dt > bd:
			bd = dt
			best = way
	return best

## the stop line before lit point n for traffic arriving going `dir` (metres from the node)
func _light_line(n: int, dir: Vector2) -> float:
	var best := -2.0
	var line := _node_r[n] + 1.2
	for way: Array in _sig_line.get(n, []):
		var dt := (way[0] as Vector2).dot(dir.normalized())
		if dt > best:
			best = dt
			line = way[1]
	return line

var _sites: Array = []               ## per junction with lights: {nodes, c (middle), lo, hi (group 1's arc of directions, radians mod PI; hi -1: one group), flip (groups swapped)}
var _site_of := {}                   ## each lit point -> its site
var _sig_line := {}                  ## lit point -> [[way in (unit), stop line (m), road, from inside the site], ...]
const SITE_LEG := 36.0               ## lit points this close along a road are one junction...
const SITE_SPAN := 50.0              ## ...up to this far across

func _axis_gap(a: float, b: float) -> float:
	var d := fposmod(a - b, PI)
	return minf(d, PI - d)

func _site_root(up: Dictionary, j: int) -> int:
	while up[j] != j:
		up[j] = up[up[j]]
		j = up[j]
	return j

## the next junctions along each road from node j, within SITE_LEG: [[node, road, metres], ...]
func _site_legs(j: int) -> Array:
	var out: Array = []
	for e: Vector2i in _node_roads[j]:
		if not (_roads[e.x] as Dictionary)["drive"]:
			continue
		for step: int in [-1, 1]:
			var pts := _points_back(e, step, SITE_LEG)
			if pts.is_empty():
				continue
			var last: Array = pts[pts.size() - 1]
			if int(last[0]) != j and _node_ways(last[0]) >= 3:
				out.append([last[0], e.x, last[1]])
	return out

## the way road e.x runs at its point e.y (along its points)
func _road_dir_at(e: Vector2i) -> Vector2:
	var pts: PackedVector2Array = (_roads[e.x] as Dictionary)["pts"]
	return (pts[mini(e.y + 1, pts.size() - 1)] - pts[maxi(e.y - 1, 0)]).normalized()

## Is junction o the other half of a divided road j is on, across the piece of road `leg`
## between them: a one-way road through each, running opposite ways, across the piece?
func _other_half(j: int, o: int, leg: int) -> bool:
	var u := (_nodes[o] - _nodes[j]).normalized()
	for e: Vector2i in _node_roads[o]:
		var r: Dictionary = _roads[e.x]
		if e.x == leg or not r["drive"] or int(r["o"]) == 0:
			continue
		var dh := _road_dir_at(e) * float(r["o"])
		if absf(dh.dot(u)) > 0.5:
			continue   # along the piece, not across it
		for f: Vector2i in _node_roads[j]:
			var r2: Dictionary = _roads[f.x]
			if f.x == leg or f.x == e.x or not r2["drive"] or int(r2["o"]) == 0:
				continue
			if (_road_dir_at(f) * float(r2["o"])).dot(dh) < -0.8:
				return true
	return false

## A site's two directions: group 1 along its main road (the highest class, then the widest;
## a divided road's half counts double), group 2 along whichever road lies furthest from it
## -- or none, when every road runs within 20 degrees of the main one (a crossing mid-street).
func _site_axes(nodes: Array) -> Dictionary:
	var c := Vector2.ZERO
	var arms: Array = []   # [direction mod PI, rank, width]: each way into each point
	var all_arms: Array = []
	var sid: int = _site_of.get(nodes[0], -1)
	for n: int in nodes:
		c += _nodes[n]
		for e: Vector2i in _node_roads[n]:
			var r: Dictionary = _roads[e.x]
			if not r["drive"]:
				continue
			var pts: PackedVector2Array = r["pts"]
			# each way in on its own: a road bending at the junction runs two ways, and the line
			# across the bend (once taken as its direction) ran neither; and only the ways cars
			# come in by -- a one-way road leaving set the axes at a junction of one-way halves
			# in Bedford, and two streets crossing had green together
			for d2: int in [-1, 1]:
				if e.y + d2 >= 0 and e.y + d2 < pts.size() and (r["o"] == 0 or r["o"] == -d2):
					var arm := [fposmod((pts[e.y + d2] - pts[e.y]).angle(), PI), int(ROAD_RANK.get(r["k"], 1)),
							float(r["w"]) * (2.0 if r.has("median") else 1.0)]
					all_arms.append(arm)
					# (and not a way from inside the junction -- the road between two of its
					# points, as `_site_ways_in` finds: it has no light, and its direction
					# skewed the split; at a skewed junction in Tel Aviv a street shared its
					# green with the one across it)
					var inside := false
					for back: Array in _points_back(e, d2, SITE_LEG + 4.0):
						if int(back[0]) != n and _site_of.get(int(back[0]), -1) == sid:
							inside = true
							break
					if not inside:
						arms.append(arm)
	if arms.size() < 2:
		arms = all_arms
	# the ways' directions, alike within 6 degrees taken as one, round the half circle
	var dirs: Array = []
	for a: Array in arms:
		if not dirs.any(func(d): return _axis_gap(d, a[0]) < deg_to_rad(6.0)):
			dirs.append(a[0])
	dirs.sort()
	var out := {"nodes": nodes, "c": c / maxf(nodes.size(), 1.0), "lo": 0.0, "hi": -1.0}
	var k := dirs.size()
	if k < 2 or dirs.all(func(d): return _axis_gap(d, dirs[0]) < deg_to_rad(20.0)):
		return out   # all one way (a crossing mid-street): one group
	# Two groups are two arcs of the half circle. Every split tried (a few ways in: a handful),
	# the one with the fewest pairs of ways crossing (over 53 degrees apart) in the same group;
	# among those, the widest gap between the groups. (It took the main road and whichever way
	# lay furthest from it, and where three streets met at 50-60 degrees, two that crossed
	# shared a green.)
	var best_cost := INF
	for i in range(k):
		for n in range(1, k):
			var g1: Array = []
			var g2: Array = []
			for q in range(k):
				((g1 if (q - i + k) % k < n else g2) as Array).append(dirs[q])
			var cost := 0.0
			for grp: Array in [g1, g2]:
				for x in range(grp.size()):
					for y in range(x + 1, grp.size()):
						if _axis_gap(grp[x], grp[y]) > deg_to_rad(53.0):
							cost += 1.0
			var sep := PI
			for x: float in g1:
				for y: float in g2:
					sep = minf(sep, _axis_gap(x, y))
			cost -= sep * 0.01
			if cost < best_cost:
				best_cost = cost
				# group 1's arc: from halfway between the first of it and the way before, to
				# halfway between the last of it and the way after
				var first: float = dirs[i]
				var before: float = dirs[(i - 1 + k) % k]
				var last: float = dirs[(i + n - 1) % k]
				var after: float = dirs[(i + n) % k]
				out["lo"] = fposmod(first - fposmod(first - before, PI) * 0.5, PI)
				out["hi"] = fposmod(last + fposmod(after - last, PI) * 0.5, PI)
	# group 1 the main road's (the busiest kind, then the widest): its green is the longer
	var main: Array = arms[0]
	for a: Array in arms:
		if int(a[1]) > int(main[1]) or (int(a[1]) == int(main[1]) and float(a[2]) > float(main[2])):
			main = a
	var lo: float = out["lo"]
	var hi: float = out["hi"]
	if fposmod(float(main[0]) - lo, PI) > fposmod(hi - lo, PI):
		out["lo"] = hi
		out["hi"] = lo
	return out

## The ways into lit point `node`: [way in (unit), stop line before the node (m), road, from
## inside the site]. The line is 1.2 m out from the junction's edge, or behind a zebra painted
## across the way in near the junction: cars stopped at the line stood on the zebra, where the
## people crossing on their green man walked into them. A way in from another point of the
## same site gets no light and no line: a car on it is already in the junction.
func _site_ways_in(node: int) -> Array:
	var out: Array = []
	var c := _nodes[node]
	var s: int = _site_of[node]
	var rn := _node_r[node]
	var slip := _slip_join(node)
	if slip:
		_tally("lights_slip_joins", 1)
	for e: Vector2i in _node_roads[node]:
		var r: Dictionary = _roads[e.x]
		if not r["drive"]:
			continue
		# the main road drives on: the light is the slip road's. Its ways in are kept, as from
		# inside (no line, no pole): left out, a car on it took the slip road's, joining at a
		# shallow angle, for its own and stopped all the same
		var free := slip and not String(r["k"]).ends_with("_link")
		var pts: PackedVector2Array = r["pts"]
		for d2: int in [-1, 1]:
			var from := e.y + d2
			if from < 0 or from >= pts.size():
				continue
			if r["o"] != 0 and r["o"] != -d2:
				continue   # (arriving from `from` is travelling -d2 along the road)
			var line := rn + 1.2
			var inside := false
			for back: Array in _points_back(e, d2, SITE_LEG + 4.0):
				var o: int = back[0]
				if o != node and _site_of.get(o, -1) == s:
					inside = true
					break
				if _crossing_set.has(o) and float(back[1]) > 1.0 and float(back[1]) < rn + 10.0:
					line = maxf(line, float(back[1]) + 2.0)   # (its stripes run 1.5 m either side of the point)
			var din := (c - pts[from]).normalized()
			if not inside and not free:
				line = _line_off_zebras(c, din, line, rn)
			out.append([din, line, e.x, inside or free])
	return out

## A stop line moved back so the car waiting at it stands on no zebra: the zebras on the
## road's own points are seen above, but one mapped on the lane beside it, or the other half
## of a divided road, was under the waiting car (light_audit's "front on the zebra": Givatayim
## 2, Tel Aviv 3). Any zebra point within 3 m of the way's line, under where the car would
## stand, puts the line 2 m behind it (its stripes run 1.5 m either side of the point).
var _zebra_pts := {}
func _line_off_zebras(c: Vector2, din: Vector2, line: float, rn: float) -> float:
	if _zebra_pts.is_empty():
		for ni: int in _crossing_nodes:
			var k := _cell(_nodes[ni], 20.0)
			if not _zebra_pts.has(k):
				_zebra_pts[k] = []
			(_zebra_pts[k] as Array).append(ni)
	var across := Vector2(-din.y, din.x)
	for _pass in range(3):
		var moved := false
		var q := c - din * (line + 4.0)
		var k0 := _cell(q, 20.0)
		for dx in range(-1, 2):
			for dz in range(-1, 2):
				for ni: int in _zebra_pts.get(k0 + Vector2i(dx, dz), []):
					var rel: Vector2 = c - _nodes[ni]
					var t := rel.dot(din)   # how far back along the way in
					if absf(rel.dot(across)) < 3.0 and t > 1.0 and t < rn + 12.0 							and t > line - 0.5 and t < line + 2.5 + CAR_LEN:
						line = t + 2.0
						moved = true
		if not moved:
			break
	return line

## A lit point where only a slip road joins a one-way main road, from its right-hand side --
## merging in or peeling off, across no one's way: OSM's light there is the slip road's (and
## its crossing's), and the main road's lanes drive on. As a light for everyone it stopped
## autodrive and the traffic on Ashdod's Menachem Begin 35 m past the Herzl junction, by a
## bus stop, for a light that was the slip road's from Herzl (a user: "why are the cars
## stopping there"; tests/light_line.gd). A slip road joining from the left -- across the
## traffic -- keeps its light for all.
func _slip_join(node: int) -> bool:
	var c := _nodes[node]
	var mains: Array = []   # [the way out along it, the road, the step]
	var links: Array = []   # the way out along each slip road, a few metres on
	for e: Vector2i in _node_roads[node]:
		var r: Dictionary = _roads[e.x]
		if not r["drive"]:
			continue
		var pts: PackedVector2Array = r["pts"]
		for step: int in [-1, 1]:
			var k := e.y + step
			if k < 0 or k >= pts.size():
				continue
			if String(r["k"]).ends_with("_link"):
				while k + step >= 0 and k + step < pts.size() and pts[k].distance_to(c) < 8.0:
					k += step
				links.append((pts[k] - c).normalized())
			else:
				mains.append([(pts[k] - c).normalized(), r, step])
	if links.is_empty() or mains.size() != 2:
		return false
	var a: Array = mains[0]
	var b: Array = mains[1]
	if (a[0] as Vector2).dot(b[0]) > -0.8 or int(a[1]["o"]) == 0 or int(b[1]["o"]) == 0:
		return false   # not one one-way road running straight through
	# the way it runs: in along the arm whose traffic arrives (its "o" against the step out)
	var arrive: Array = a if int(a[1]["o"]) == -int(a[2]) else b
	var leave: Array = b if arrive == a else a
	if int(leave[1]["o"]) != int(leave[2]):
		return false   # (the two pieces flowing at each other: not one road)
	var t := -(arrive[0] as Vector2)
	var right := Vector2(-t.y, t.x)   # (left of the traffic is (t.y, -t.x), as in _partner)
	for l: Vector2 in links:
		if l.dot(right) <= 0.05:
			return false
	return true

## The points back along a road from its point e.y, stepping d2 along it, up to `reach`
## metres and ending at the first junction: [[node, metres], ...]. Carries on across the
## joins where OSM cuts one street into pieces (a zebra on the next piece was missed).
func _points_back(e: Vector2i, d2: int, reach: float) -> Array:
	var out: Array = []
	var ri := e.x
	var k := e.y
	var step := d2
	var d := 0.0
	for _guard in range(80):
		var ids: PackedInt32Array = (_roads[ri] as Dictionary)["ids"]
		var pts: PackedVector2Array = (_roads[ri] as Dictionary)["pts"]
		if k + step < 0 or k + step >= ids.size():
			var here := ids[k]
			if _node_ways(here) != 2:
				break   # a junction, or the street's end
			var next := Vector2i(-1, 0)
			for f: Vector2i in _node_roads[here]:
				if f.x != ri and (_roads[f.x] as Dictionary)["drive"]:
					next = f
			if next.x < 0:
				break
			ri = next.x
			k = next.y
			step = 1 if k == 0 else -1   # (away from the join)
			continue
		d += pts[k].distance_to(pts[k + step])
		k += step
		if d > reach:
			break
		out.append([ids[k], d])
		if _node_ways(ids[k]) >= 3:
			break
	return out

## A signal's colours are what a driver reads, so they are red, amber and green whatever the
## palette: each keeps the palette's strength of colour but takes the signal's own hue (the
## palette's pink "red", yellow and mint "green" read as anything but a traffic light). Lit:
## glowing; out: nearly black behind the glass.
func _signal_cols() -> Array:
	var sat := clampf(maxf(Palette.col("hazard").s, Palette.col("friend").s), 0.8, 1.0)
	return [Color.from_hsv(0.0, sat, 1.0), Color.from_hsv(0.11, sat, 1.0), Color.from_hsv(0.40, sat, 0.95)]

func _light_lamp(m: StandardMaterial3D, col: Color, on: bool) -> void:
	# (a strong glow came out white: the film-like tone curve bleaches anything much over 1,
	# so the lamp keeps its colour in the glass and glows only a little past it)
	m.albedo_color = col * 0.5 if on else col.lerp(Palette.col("bg").darkened(0.6), 0.9)
	m.emission_enabled = on
	m.emission = col
	m.emission_energy_multiplier = 0.9
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED if on else BaseMaterial3D.SHADING_MODE_PER_PIXEL

func _apply_signals() -> void:
	var step: Array = SIGNAL_CYCLE[_sig_phase]
	var cols := _signal_cols()
	for g in range(_sig_mats.size()):
		var st: String = step[1 + g]
		var on := [st == "r" or st == "ry", st == "y" or st == "ry", st == "g" or (st == "gf" and _sig_blink)]
		for ci in range(3):
			_light_lamp(_sig_mats[g][ci], cols[ci], on[ci])
	# the people's lights: the green man while the road they cross is held at red and the
	# other way has its steady green; the red man the rest of the time (from the other way's
	# flashing green, through the amber and the red all round, to the next green)
	for g in range(_ped_mats.size()):
		var walk: bool = step[1 + g] == "r" and step[2 - g] == "g"
		_light_lamp(_ped_mats[g][0], cols[0], not walk)
		_light_lamp(_ped_mats[g][1], cols[2], walk)

## ---- the sky: a photograph -----------------------------------------------------------------
## By day the sky is a photo (textures/sky_day.jpg: the upper half of Poly Haven's CC0
## "kloofendal_48d_partly_cloudy_puresky", tonemapped by textures/hdr_sky.py; in the evening
## sky_evening.jpg, their "kloppenheim_06_puresky" kept darker), on a dome that
## follows the camera, drawn unlit and through no fog. It is turned so the sun in it stands
## where the sunlight comes from, and fades into the fog at the horizon. The shell keeps its
## own procedural sky behind it (it retints that on a palette change), which shows at night,
## when the dome is hidden. The palette's sky tone tints it lightly, as it does everything.
## Each: the photo; where its sun is across it (0..1); its average colour and its colour
## along the horizon, as stored (hdr_sky.py prints all three); where the sunlight comes from
## (the light's rotation, degrees: the evening sun in the west-south-west, where it sets in
## Givatayim in the autumn, 13 degrees up -- the photo's is 5, which made every shadow 12
## times the height of what cast it); its colour (palette roles: ink toward warn) and energy.
const SKIES := {
	"day": {"photo": "sky_day.jpg", "sun_u": 0.595, "mean": Vector3(0.626, 0.686, 0.792),
		"horizon": Vector3(0.742, 0.758, 0.801), "sun": Vector3(-50, -28, 0), "warm": 0.22, "energy": 1.1},
	"evening": {"photo": "sky_evening.jpg", "sun_u": 0.6118, "mean": Vector3(0.44, 0.523, 0.623),
		"horizon": Vector3(0.598, 0.592, 0.584), "sun": Vector3(-13, -78, 0), "warm": 0.55, "energy": 1.3},
}
var _evening := false
var _sky_tex := {}                   ## photo -> its texture, once loaded

func _sky_now() -> Dictionary:
	return SKIES["evening" if _evening else "day"]
const SKY_SHADER := """
shader_type spatial;
render_mode unshaded, fog_disabled, cull_front, shadows_disabled;
uniform sampler2D photo : filter_linear, repeat_enable;
uniform vec3 tint = vec3(1.0);
uniform vec3 horizon = vec3(0.75);
uniform float turn = 0.0;
varying vec3 dir;
void vertex() { dir = VERTEX; }
void fragment() {
	vec3 d = normalize(dir);
	float up = clamp(d.y, 0.0, 1.0);
	float u = atan(d.x, -d.z) / 6.2831853 + 0.5 + turn;
	float v = 1.0 - asin(up) / 1.5707963;
	vec3 c = texture(photo, vec2(u, v)).rgb;
	ALBEDO = mix(horizon, c * tint, smoothstep(0.0, 0.07, up));
}
"""
var _sky_dome: MeshInstance3D
var _sky_mat: ShaderMaterial

## the palette's say in the sky: its sky tone's hue (not its brightness) over the photo's
func _sky_tint() -> Vector3:
	var t: Color = _tone.get("sky", Color(0.6, 0.7, 0.8))
	var lt := maxf(t.get_luminance(), 0.01)
	var m: Vector3 = _sky_now()["mean"]
	var lm := m.dot(Vector3(0.2126, 0.7152, 0.0722))
	var ratio := Vector3(t.r / lt, t.g / lt, t.b / lt) / (m / lm)
	return Vector3.ONE.lerp(ratio, 0.25)

## one of the photo's colours, tinted as the dome draws it
func _sky_col(c: Vector3) -> Color:
	var t := _sky_tint()
	return Color(c.x * t.x, c.y * t.y, c.z * t.z)

## what the glass and the paint reflect: [overhead, horizon], the photo's by day
func _sky_reflect() -> Array:
	if _night or _sky_dome == null:
		var sk := env.sky.sky_material as ProceduralSkyMaterial
		return [sk.sky_top_color, sk.sky_horizon_color]
	return [_sky_col(_sky_now()["mean"]), _sky_col(_sky_now()["horizon"])]

func _build_sky_dome() -> void:
	var tex := _sky_photo()
	if tex == null:
		return
	_sky_mat = ShaderMaterial.new()
	var sh := Shader.new()
	sh.code = SKY_SHADER
	_sky_mat.shader = sh
	_sky_mat.set_shader_parameter("photo", tex)
	# a whole sphere, not Godot's hemisphere: that one closes with a flat disc at its middle's
	# height, and the dome stands on the eye -- a plane through the eye, edge-on, that a phone's
	# GPU drew now and then as a flickering line straight across the screen at the horizon,
	# over near hedges too (tests/horizon_line.gd). The lower half is the horizon's haze.
	var mesh := SphereMesh.new()
	mesh.radius = 1900.0
	mesh.height = 3800.0
	mesh.is_hemisphere = false
	mesh.radial_segments = 32
	mesh.rings = 20
	mesh.material = _sky_mat
	_sky_dome = MeshInstance3D.new()
	_sky_dome.mesh = mesh
	_sky_dome.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_sky_dome.extra_cull_margin = 4000.0
	world.add_child(_sky_dome)
	_retint_sky_dome()

## the dome round the camera, wherever it went this frame
var sky_drop := 0.0                  ## tests: the dome this far below the eye (tests/horizon_line.gd)
func _sky_follow() -> void:
	if _sky_dome != null:
		_sky_dome.global_position = cam.global_position - Vector3(0.0, sky_drop, 0.0)
	_grass_follow()

func _retint_sky_dome() -> void:
	if _sky_dome == null:
		return
	_sky_dome.visible = not _night
	var t := _sky_tint()
	_sky_mat.set_shader_parameter("tint", t)
	var hz: Vector3 = _sky_now()["horizon"]
	_sky_mat.set_shader_parameter("photo", _sky_photo())
	_sky_mat.set_shader_parameter("horizon", Vector3(hz.x * t.x, hz.y * t.y, hz.z * t.z))
	# turn the photo so its sun is where the light comes from (the light shines down its -Z)
	var to_sun := sun.global_transform.basis.z if sun.is_inside_tree() else Basis.from_euler(sun.rotation).z
	_sky_mat.set_shader_parameter("turn", float(_sky_now()["sun_u"]) - (atan2(to_sun.x, -to_sun.z) / TAU + 0.5))

func _sky_photo() -> Texture2D:
	var f: String = _sky_now()["photo"]
	if not _sky_tex.has(f):
		_sky_tex[f] = load(TEX_DIR + f) as Texture2D
	return _sky_tex[f]

## ---- look: every colour is a palette role, mixed for daylight ---------------------------
## The kit's palettes are neon on dark. A street in daylight is greys, creams and greens, so
## each tone, still mixed from the palette's roles (so /look still reskins it), keeps only
## part of its colour (NATURAL: the share of its saturation kept, the rest going to its own
## brightness): asphalt, pavements, kerbs and concrete nearly none, walls about half, plants
## more -- and plants lean from the palette's "friend" toward its "warn", which takes a mint
## to a grass green. Signs, kerb paint, lights and the cars' colours keep theirs: real ones
## are bright.
const NATURAL := {
	"ground": 0.45, "rock": 0.3, "path": 0.15, "asphalt": 0.08, "parking": 0.08, "plaza": 0.2,
	"grass": 0.6, "pitch": 0.6, "wood": 0.6, "leaf": 0.62, "bush": 0.6, "water": 0.5, "sand": 0.6, "beach": 0.75,
	"mark": 0.3, "wall": 0.5, "wall2": 0.45, "wall3": 0.6, "wall4": 0.6, "wall5": 0.5, "wall6": 0.3, "wall7": 0.62,
	"glass": 0.5, "glass2": 0.5, "glass3": 0.5, "glass4": 0.5, "shutter": 0.3, "recess": 0.3, "lobby": 0.35, "flowers": 0.8,
	"roof": 0.2, "trunk": 0.45, "pole": 0.2, "haze": 0.45, "sky": 0.6, "board": 0.4, "solar": 0.5,
	"tank": 0.3, "furniture": 0.3, "pavement": 0.2, "pavers_dark": 0.15, "slabs": 0.15, "pavers_grey": 0.1, "tactile": 0.3, "pavers_red": 0.45, "kerb": 0.15, "stonewall": 0.45, "roofroom": 0.4,
	"gardenwall": 0.3, "coping": 0.4,
	"cat_ginger": 0.6, "cat_grey": 0.1, "cat_black": 0.1, "cat_cream": 0.35, "cat_brown": 0.45,
	"gable": 0.5, "brick_red": 0.6, "brick_dark": 0.5, "brick_yellow": 0.55, "mortar": 0.15, "carglass": 0.4, "cartrim": 0.2, "tyre": 0.15, "rim": 0.2, "concrete": 0.15,
	"insulator": 0.3, "trafo": 0.4, "cable": 0.2, "railing": 0.3, "brick": 0.7, "rubber": 0.6,
	"metal": 0.1, "metalrim": 0.1, "skin": 0.75, "hair": 0.5, "shirt_a": 0.6, "shirt_b": 0.4,
}

## a palette colour with only `keep` of its saturation, the rest toward its own brightness
static func _natural(c: Color, keep: float) -> Color:
	var l := c.get_luminance()
	return Color(lerpf(l, c.r, keep), lerpf(l, c.g, keep), lerpf(l, c.b, keep), c.a)

## a palette colour with most of its tint taken out (`k` 1: grey of the same brightness) --
## concrete is grey, whatever colour the palette's light is
func _greyed(c: Color, k: float) -> Color:
	var l := c.get_luminance()
	return c.lerp(Color(l, l, l, c.a), k)

func _tones() -> void:
	var bg := Palette.col("bg")
	var alt := Palette.col("bg_alt")
	var ink := Palette.col("ink")
	var pl := Palette.col("player")
	var fr := Palette.col("friend")
	var wn := Palette.col("warn")
	var ac := Palette.col("accent")
	var pz := Palette.col("prize")
	var veg := fr.lerp(wn, 0.3)   # what grows: the palette's green, leaning toward its yellow
	_tone = {
		# bare earth: dusty sand, warmer and lighter than the asphalt. (It was a grey a shade
		# off the road's, and with the lawn photo's light and dark over it read as asphalt:
		# a boulevard's middle strip looked like more road, its lawns like grass painted on it.)
		"ground": alt.lerp(ink, 0.5).lerp(wn, 0.3),
		"rock": alt.lerp(ink, 0.3).lerp(wn, 0.2),
		"path": alt.lerp(ink, 0.62),
		"asphalt": alt.lerp(ink, 0.27),   # (pale grey, as sun-bleached asphalt is)
		"parking": alt.lerp(ink, 0.32),
		"plaza": alt.lerp(ink, 0.58).lerp(wn, 0.08),
		"grass": veg.lerp(bg, 0.48),
		"pitch": veg.lerp(bg, 0.36),
		"wood": veg.lerp(bg, 0.6),
		"water": pl.lerp(bg, 0.42),
		"mark": ink,
		"wall": ink.lerp(wn, 0.1),
		"wall2": ink.lerp(ac, 0.28),
		"wall3": ink.lerp(wn, 0.38).lerp(alt, 0.06),
		"wall4": ink.lerp(wn, 0.5).lerp(pz, 0.05),
		"wall5": ink.lerp(Palette.col("hazard"), 0.2).lerp(wn, 0.18),
		"wall6": ink.lerp(alt, 0.34),
		# the old blocks' sand render: the stone's beige, deeper toward the yellow, a touch of
		# red, dulled (from the stone and the peach plaster it read grey-beige; the film's is tan)
		"wall7": ink.lerp(wn, 0.38).lerp(alt, 0.06).lerp(wn, 0.22).lerp(Palette.col("hazard"), 0.14) * 0.83,
		"glass2": alt.lerp(pl, 0.55),
		"glass3": alt.lerp(fr, 0.45),
		"glass4": ink.lerp(alt, 0.45).lerp(pl, 0.1),
		"glass": alt.lerp(pl, 0.3),
		"shutter": ink.lerp(alt, 0.22),
		"recess": alt.lerp(bg, 0.25),
		"lobby": ink.lerp(wn, 0.22).lerp(alt, 0.12),   # the tiled walls of a lobby under a block on columns
		"flowers": Palette.col("hazard").lerp(Palette.col("accent"), 0.35),   # bougainvillea
		"roof": ink.lerp(alt, 0.42),
		# (less red, a touch less blue than the palette's green mixed toward its dark: on screen the
		# leaves came out 72/61/52, red over green -- brown -- against the film's 55/61/46)
		"leaf": Color(veg.lerp(bg, 0.52).r * 0.76, veg.lerp(bg, 0.52).g, veg.lerp(bg, 0.52).b * 0.88),
		"trunk": alt.lerp(wn, 0.3),
		"pole": alt.lerp(ink, 0.3),
		"sky": pl.lerp(pz, 0.35).lerp(bg, 0.32),
		"haze": ink.lerp(pl, 0.3),
		"beacon": Color(ac, 0.35),
		"board": bg.lerp(alt, 0.5),
		"solar": alt.lerp(pl, 0.35).lerp(bg, 0.2),
		"tank": ink.lerp(alt, 0.08),
		"lamp": ink.lerp(wn, 0.25),
		"furniture": alt.lerp(ink, 0.35),
		"paint": pl.lerp(alt, 0.5).lerp(ink, 0.12),
		"shoplight": ink.lerp(wn, 0.45),
		"pavement": _greyed(ink.lerp(alt, 0.48).lerp(wn, 0.04), 0.85),   # (0.65 kept the palette's lavender: pink pavers)
		# a filmed street's details (details.gd): charcoal pavers under an arcade, a forecourt
		# of pale poured slabs
		"pavers_dark": _greyed(ink.lerp(alt, 0.62), 0.85),   # (0.8 read near black under the arcade: the film's are mid-grey in its shade)
		"slabs": _greyed(ink.lerp(alt, 0.55).lerp(wn, 0.28), 0.38),   # (the film's: warm beige in the sun)
		"pavers_grey": _greyed(ink.lerp(alt, 0.5), 0.97),   # (the film's are a neutral grey)
		# a crossing's kerbs: buff domed slabs; a median's raised ends, red pavers (the film's)
		"tactile": ink.lerp(alt, 0.5).lerp(wn, 0.4),
		"pavers_red": Palette.col("hazard").lerp(bg, 0.45).lerp(alt, 0.2),
		"kerb": ink.lerp(alt, 0.45),
		"stonewall": ink.lerp(wn, 0.3).lerp(alt, 0.2),
		"gardenwall": ink.lerp(alt, 0.3).lerp(wn, 0.1),     # a rendered garden wall, weathered
		"coping": ink.lerp(wn, 0.2).lerp(alt, 0.08),        # its cap: pale Jerusalem stone
		# street cats' coats
		"cat_ginger": ink.lerp(wn, 0.6).lerp(Palette.col("hazard"), 0.22),
		"cat_grey": ink.lerp(bg, 0.48),
		"cat_black": bg.lerp(ink, 0.1),
		"cat_cream": ink.lerp(wn, 0.16),
		"cat_brown": ink.lerp(wn, 0.4).lerp(bg, 0.5),
		"woodfence": alt.lerp(wn, 0.35).lerp(bg, 0.4),
		"bush": veg.lerp(bg, 0.58),
		"roofroom": ink.lerp(wn, 0.12).lerp(alt, 0.1),
		"gable": ink.lerp(wn, 0.15),
		# Dutch brick: red-brown, a dark purple-brown, the old yellow; light grey mortar
		# (the palette's red is a pink: half toward its yellow it is a brick's brown-orange; on
		# screen at 0.14 the sunlit brick read 193/129/127, salmon)
		"brick_red": Palette.col("hazard").lerp(wn, 0.42).lerp(bg, 0.56),
		"brick_dark": Palette.col("hazard").lerp(wn, 0.25).lerp(bg, 0.74),
		"brick_yellow": ink.lerp(wn, 0.5).lerp(Palette.col("hazard"), 0.1) * 0.8,
		"mortar": ink.lerp(alt, 0.38),
		"carglass": bg.lerp(pl, 0.12),
		"cartrim": bg.lerp(alt, 0.4),
		"tyre": bg.lerp(alt, 0.2),
		"rim": ink.lerp(alt, 0.35),
		"lit": ink.lerp(wn, 0.55),
		"litcool": ink.lerp(pl, 0.2),
		"lamplight": ink.lerp(wn, 0.45),
		"brick": Palette.col("hazard").lerp(bg, 0.45).lerp(alt, 0.15),
		"markyellow": wn.lerp(ink, 0.2),
		"signblue": pl.lerp(bg, 0.4),
		"signgreen": fr.lerp(bg, 0.45),
		# a sign's red is a traffic sign's red, its strength the palette's: as the palette's hazard
		# (pink here) stop and no-entry signs, crossing barriers and railings' bands were pink
		"signred": Color.from_hsv(0.995, clampf(Palette.col("hazard").s, 0.7, 0.92), clampf(Palette.col("hazard").v * 0.85, 0.55, 0.85)),
		"rubber": ac.lerp(alt, 0.55).lerp(bg, 0.25),
		"sand": wn.lerp(ink, 0.45).lerp(alt, 0.1),
		# a beach's: warmer and darker than a sandpit's (the sandpit's tone over a beach's
		# acres read as snow beside the sea)
		"beach": wn.lerp(ink, 0.3).lerp(Palette.col("hazard"), 0.06).darkened(0.2),
		"concrete": ink.lerp(alt, 0.32).lerp(wn, 0.04),
		"insulator": ink.lerp(alt, 0.15),
		"trafo": alt.lerp(ink, 0.4).lerp(fr, 0.08),
		"cable": bg.lerp(alt, 0.35),
		"lampgreen": fr.lerp(bg, 0.74),
		"fencegreen": fr.lerp(bg, 0.55),
		"railing": ink.lerp(alt, 0.12),
		"skin": ink.lerp(wn, 0.38).lerp(Palette.col("hazard"), 0.12).lerp(bg, 0.2),   # people in the cars
		"hair": bg.lerp(alt, 0.5).lerp(wn, 0.08),
		"shirt_a": pl.lerp(bg, 0.45).lerp(ink, 0.15),
		"shirt_b": ink.lerp(alt, 0.25),
		"metal": alt.lerp(ink, 0.22),          # cast iron: manhole covers, drain grates
		"metalrim": alt.lerp(ink, 0.32),
	}
	for k: String in NATURAL:
		if _tone.has(k):
			_tone[k] = _natural(_tone[k], float(NATURAL[k]))

func _retint_city() -> void:
	_tones()
	for t: String in _smat:
		var sm := _smat[t] as StandardMaterial3D
		sm.albedo_color = _tone[sm.get_meta("tone", t)]
	if _smat.has("shopglass"):
		(_smat["shopglass"] as StandardMaterial3D).emission = _tone["shoplight"]
	if _shop_mat != null:
		_shop_interior()   # (its colours from the tones again)
	_retint_trees()
	if _wall_mat != null:
		_wall_mat.set_shader_parameter("wall_a", _tone["wall"])
		_wall_mat.set_shader_parameter("wall_b", _tone["wall2"])
		_wall_mat.set_shader_parameter("glass", _tone["glass"])
		_wall_mat.set_shader_parameter("wall_c", _tone["wall3"])
		_wall_mat.set_shader_parameter("wall_d", _tone["wall4"])
		_wall_mat.set_shader_parameter("wall_e", _tone["wall5"])
		_wall_mat.set_shader_parameter("wall_f", _tone["wall6"])
		_wall_mat.set_shader_parameter("wall_g", _tone["wall7"])
		_wall_mat.set_shader_parameter("glass_b", _tone["glass2"])
		_wall_mat.set_shader_parameter("glass_c", _tone["glass3"])
		_wall_mat.set_shader_parameter("glass_d", _tone["glass4"])
		_wall_mat.set_shader_parameter("shutter", _tone["shutter"])
		_wall_mat.set_shader_parameter("dark", _tone["recess"])
		_wall_mat.set_shader_parameter("brick_a", _tone["brick_red"])
		_wall_mat.set_shader_parameter("brick_b", _tone["brick_dark"])
		_wall_mat.set_shader_parameter("brick_c", _tone["brick_yellow"])
		_wall_mat.set_shader_parameter("brick_m", _tone["mortar"])
	if env != null:
		# by day the photo sky (_sky_dome) sets the haze: the fog takes its horizon, so far
		# streets melt into the sky, and the shade its blue
		var hor := _sky_col(_sky_now()["horizon"])
		var sky := env.sky.sky_material as ProceduralSkyMaterial
		sky.sky_top_color = _sky_col(_sky_now()["mean"])
		sky.sky_horizon_color = hor
		sky.ground_horizon_color = hor
		sky.ground_bottom_color = _tone["ground"]
		sky.sky_curve = 0.12
		env.background_color = hor
		env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
		# (in the evening the shade is the sky's blue, not the haze: the warm light and the cool
		# shade are what makes golden hour, and the haze in it turned the shade khaki)
		env.ambient_light_color = _sky_col(_sky_now()["mean"]).lerp(_tone["haze"], 0.1 if _evening else 0.4)
		# (the fill light 0.6 of what it was: with more, every shade was lifted and the shapes
		# went flat and pastel -- tried on the look bench beside the user's photos)
		env.ambient_light_energy = (0.62 if _evening else 0.55) * 0.6
		env.fog_enabled = true
		env.fog_light_color = hor
		env.fog_density = _fog_day()   # (half in the made-up town's valley, see _fog_day)
		# (the haze glows towards a low sun. Never 0: any glow at all is another version of every
		# shader in the browser, and 0 by day made the evening button compile 30 programs there and
		# then -- a hang; a trace by day, too faint to see, keeps one version for both, compiled
		# while loading)
		env.fog_sun_scatter = 0.3 if _evening else FOG_SCATTER_DAY
		env.fog_sky_affect = 0.0
		# a film-like curve: the bright walls roll off instead of clipping, the shade deepens
		env.tonemap_mode = Environment.TONE_MAPPER_ACES
		env.tonemap_exposure = 1.0
	if sun != null:
		# warm: ink toward warn, and in the evening toward hazard too (warn alone was lemon;
		# with a little of the red it is the orange of a low sun)
		sun.light_color = Palette.col("ink").lerp(Palette.col("warn"), float(_sky_now()["warm"])) \
			.lerp(Palette.col("hazard"), 0.16 if _evening else 0.0)
		sun.light_energy = float(_sky_now()["energy"]) * 1.12
		sun.sky_mode = DirectionalLight3D.SKY_MODE_LIGHT_AND_SKY
	_retint_sky_dome()
	if _wall_mat != null:
		_wall_mat.set_shader_parameter("lit", _tone["lit"])
		_wall_mat.set_shader_parameter("lit_cool", _tone["litcool"])
		_wall_mat.set_shader_parameter("night", 1.0 if _night else 0.0)
		_wall_mat.set_shader_parameter("trim", _tone["mark"])
		_wall_mat.set_shader_parameter("siding", 1.0 if String(_place.get("look", "")) == "north" else 0.0)
		_wall_mat.set_shader_parameter("brick", 1.0 if _dutch() else 0.0)
	for m: ShaderMaterial in _glow_mats.values():
		m.set_shader_parameter("col", _tone[m.get_meta("tone")])
	if _furn != null:
		_furn.retint()
	_retint_tone_mat()
	var lamp := _surface("lamp")
	lamp.emission_enabled = _night
	lamp.emission = _tone["lamplight"]
	lamp.emission_energy_multiplier = 2.4
	if _smat.has("shopglass"):
		# (at night 2.0 clipped to a blank white pane; the light spills onto the pavement instead)
		(_smat["shopglass"] as StandardMaterial3D).emission_energy_multiplier = 0.85 if _night else 0.7
	if _shop_mat != null:
		_shop_mat.set_shader_parameter("lit", 1.4 if _night else 0.45)
	if _night and env != null:
		var bg := Palette.col("bg")
		var pl := Palette.col("player")
		var ink := Palette.col("ink")
		var wn := Palette.col("warn")
		# a dark night, a little blue (the palette's player colour, lightly: more of it was a
		# teal "day for night" over everything), the city's own glow low on the horizon
		var haze := bg.lerp(ink, 0.1).lerp(wn, 0.05)
		var sky := env.sky.sky_material as ProceduralSkyMaterial
		sky.sky_top_color = bg.lerp(pl, 0.04)
		sky.sky_horizon_color = bg.lerp(ink, 0.16).lerp(wn, 0.1)
		sky.ground_horizon_color = haze
		sky.ground_bottom_color = bg
		env.background_color = haze
		env.ambient_light_color = bg.lerp(ink, 0.32).lerp(pl, 0.14)
		env.ambient_light_energy = 0.38
		env.fog_light_color = haze
		env.fog_density = _fog_night()
		sun.light_color = ink.lerp(pl, 0.15)   # the moon
		sun.light_energy = 0.14
		sun.sky_mode = DirectionalLight3D.SKY_MODE_LIGHT_ONLY   # no sun disc in a night sky
	if _car_shader_mat != null:   # the cars' reflections, lamps and wells
		_car_material()
	if _wall_mat != null and env != null:   # what the windows reflect: the sky as it is now
		var rs := _sky_reflect()
		_wall_mat.set_shader_parameter("sky_top", rs[0])
		_wall_mat.set_shader_parameter("sky_hor", rs[1])
	_apply_signals_safe()
	_retint_kerbs()
	_retint_ground()
	_retint_edge()
	if _blob_plane != null:
		(_blob_plane.material as ShaderMaterial).set_shader_parameter("tint", Palette.col("bg"))
	for poi: Array in _pois:
		var lb := poi[2] as Label3D
		lb.modulate = Palette.col(poi[1])
		lb.outline_modulate = Palette.col("bg")
	for lb: Label3D in _names:
		lb.modulate = Palette.col(lb.get_meta("role"))
		lb.outline_modulate = Palette.col("bg")
	_retint_hud()
	if sun != null:
		_far_update()   # (what the wet ground mirrors: the sky as it is now)

func _apply_signals_safe() -> void:
	if not _sig_mats.is_empty():
		_apply_signals()

## ---- the car ------------------------------------------------------------------------------

func _build_car() -> void:
	_car = Node3D.new()
	_car.name = "car"
	world.add_child(_car)
	_body = Node3D.new()
	_car.add_child(_body)
	_sedan_node = _sedan("paint")
	_body.add_child(_sedan_node)
	var beam := MeshInstance3D.new()
	beam.mesh = _beam_mesh()
	beam.material_override = _glow_mat("lamplight", 0.9)
	beam.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	beam.visible = _night
	_car.add_child(beam)
	_beam_node = beam
	_lights_on = _night
	_blob = MeshInstance3D.new()
	_blob.mesh = blob_mesh()
	_blob.scale = Vector3(2.7, 1.0, 5.6)
	_blob.position = Vector3(0, 0.02, 0)
	_blob.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
