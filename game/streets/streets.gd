## Where the real shadows are off (the lowest quality: a phone that could not keep up), a
## soft dark patch under each car keeps it standing on the road. Without them the street
## went flat the moment the game stepped down, and the cars floated over it.
var _blobs_on := false
var _blob: MeshInstance3D
var _blob_plane: PlaneMesh
const BLOB_SHADER := """
shader_type spatial;
render_mode unshaded, depth_draw_never, cull_disabled, shadows_disabled;
uniform vec3 tint : source_color = vec3(0.0);
void fragment() {
	vec2 q = abs(UV - 0.5) * 2.0;   // 0 in the middle, 1 at the rim
	float d = length(max(q - vec2(0.5, 0.68), 0.0) / vec2(0.5, 0.32));
	ALBEDO = tint;
	ALPHA = (1.0 - smoothstep(0.0, 1.0, d)) * 0.62;
}
"""

## a 1 m square lying flat, the patch's shape and fade in its shader (scaled to each car)
func blob_mesh() -> PlaneMesh:
	if _blob_plane == null:
		_blob_plane = PlaneMesh.new()
		_blob_plane.size = Vector2(1.0, 1.0)
		var m := ShaderMaterial.new()
		var sh := Shader.new()
		sh.code = BLOB_SHADER
		m.shader = sh
		m.set_shader_parameter("tint", Palette.col("bg"))
		_blob_plane.material = m
	return _blob_plane

func _set_blobs(on: bool) -> void:
	_blobs_on = on
	if _blob != null:
		_blob.visible = on
	if _traffic != null:
		_traffic.show_blobs(on)

func _fwd() -> Vector2:
	return Vector2(cos(_yaw), sin(_yaw))

## The right-hand lane's line, this far right of a two-way road's middle. Every two-way
## street has two lanes, however narrow; the line sits a little past the lane's own middle,
## toward the kerb, as drivers do -- at w/4 cars ran close to the centre line and met the
## traffic coming the other way in it; at w/4 + 0.25 they hugged the kerb. A one-way road of
## one lane: its middle; of two: the middle of the right-hand one; of three or more: the
## second from the right (autodrive used to take the middle of the road, astride two
## lanes, and ran in between the cars in them).
func _lane_off(r: Dictionary) -> float:
	var w := float(r["w"])
	if int(r["o"]) != 0:
		var n := _lanes_each_way(r)
		if n <= 1:
			return 0.0
		# three lanes or more: the second from the right, where traffic going straight on
		# drives (the right-hand one hugged the kerb all along Sderot Herzl); the right-hand
		# lane is taken before a right turn (_ap_turn_lane). Never a bus lane: the next one
		# left of it (Kaplan's right-hand lane is the buses')
		var idx := 1 if n >= 3 else 0
		var dir := 1 if int(r["o"]) > 0 else -1
		while idx < n - 1 and _bus_lane(r, idx, dir):
			idx += 1
		return w * 0.5 - w / n * (idx + 0.5)
	# (+0.12 past the lane's middle, and 1.1 m clear of the kerb: +0.25 left a car 0.6 m from
	# the kerb on a 7 m street, and the others, drifting, hugged it)
	return clampf(minf(w * 0.25 + 0.12, w * 0.5 - 1.1), 0.9, 2.6)

## lanes each way: a one-way road's all, half a two-way road's (by the tag, else the width)
func _lanes_each_way(r: Dictionary) -> int:
	var l := int(r.get("l", 0))
	var w := float(r["w"])
	var n := 1
	if int(r["o"]) != 0:
		n = mini(l if l > 0 else int(w / 3.3), int(w / 2.8))
	else:
		n = mini(l / 2 if l > 1 else int(w / 6.6), int(w / 5.6))
	return clampi(n, 1, 4)   # (no more than the width holds: a tagged two lanes narrowed to 4 m is one)

## Is lane `idx` (0 the right-hand one) of road r, going `dir` along it (1 its points' way,
## -1 the other), a bus lane? OSM's lanes are lined up from the right (the bake's letters run
## left to right); a way with one lane that way has no bus lane, whatever OSM says (a bus
## lane needs a lane beside it for the rest).
func _bus_lane(r: Dictionary, idx: int, dir: int) -> bool:
	var pat := String(r.get("bf" if dir >= 0 else "bb", ""))
	var n := _lanes_each_way(r)
	if pat == "" or n <= 1:
		return false
	var j := pat.length() - 1 - idx
	if j < 0 or pat[j] != "b":
		return false
	# never every lane: the letters are lined up with the lanes the bake counted, and the
	# width fitted at load can leave fewer (HaMasger: "-bb" on 2 lanes, both bus, and
	# autodrive's line in one) -- then the leftmost is the cars'
	var all_bus := true
	for i in range(n):
		var k := pat.length() - 1 - i
		all_bus = all_bus and k >= 0 and pat[k] == "b"
	return not (all_bus and idx == n - 1)

## does road r have a bus lane either way
func _has_bus_lane(r: Dictionary) -> bool:
	return String(r.get("bf", "")).contains("b") or String(r.get("bb", "")).contains("b")

## of road r's lanes going one way, the line of the one nearest `off` metres right of the
## road's middle
func _nearest_lane(r: Dictionary, off: float) -> float:
	var best := _lane_off(r)
	var n := _lanes_each_way(r)
	var w := float(r["w"])
	var span := w if int(r["o"]) != 0 else w * 0.5
	for i in range(n if n > 1 else 0):
		var c := w * 0.5 - span / n * (i + 0.5)
		if absf(c - off) < absf(best - off):
			best = c
	return best

## ---- the driver's seat ----------------------------------------------------------------------
## The view from behind the wheel, like a dashcam a little lower: the bonnet through the
## windscreen (the body's own faces point out, so from inside only the bonnet and the mirrors
## show), and inside, the dashboard, a steering wheel that turns with the front wheels, the
## windscreen pillars, the roof's edge and the mirror. Left-hand drive: the seat is on the
## car's left (+X, the car facing +Z).
const SEAT := Vector3(0.37, 1.2, -0.32)

func _build_cockpit() -> void:
	_cockpit_node = Node3D.new()
	_cockpit_node.visible = false
	_body.add_child(_cockpit_node)
	var dark: Color = _tone["cartrim"]
	var b := Buf.new()
	var box := func(c: Vector3, sz: Vector3, col: Color) -> void:
		var h := sz * 0.5
		for f: Array in [[Vector3(h.x, 0, 0), Vector3(0, h.y, 0), Vector3(0, 0, h.z)], [Vector3(-h.x, 0, 0), Vector3(0, h.y, 0), Vector3(0, 0, h.z)],
				[Vector3(0, h.y, 0), Vector3(h.x, 0, 0), Vector3(0, 0, h.z)], [Vector3(0, -h.y, 0), Vector3(h.x, 0, 0), Vector3(0, 0, h.z)],
				[Vector3(0, 0, h.z), Vector3(h.x, 0, 0), Vector3(0, h.y, 0)], [Vector3(0, 0, -h.z), Vector3(h.x, 0, 0), Vector3(0, h.y, 0)]]:
			var n: Vector3 = f[0]
			var u: Vector3 = f[1]
			var v: Vector3 = f[2]
			var o: Vector3 = c + n
			b.tri(o - u - v, o + u - v, o + u + v, n.normalized(), col)
			b.tri(o - u - v, o + u + v, o - u + v, n.normalized(), col)
	# the dashboard under the windscreen (down to the footwell), the instrument hood in
	# front of the driver, the centre console, and the doors' insides below the windows
	box.call(Vector3(0, 0.7, 0.78), Vector3(1.7, 0.5, 0.62), dark)
	box.call(Vector3(0.37, 1.0, 0.55), Vector3(0.44, 0.1, 0.16), dark.darkened(0.2))   # the binnacle
	box.call(Vector3(0, 0.5, 0.2), Vector3(0.3, 0.3, 0.6), dark.lightened(0.05))
	for sx: float in [-1.0, 1.0]:
		box.call(Vector3(sx * 0.84, 0.66, 0.05), Vector3(0.05, 0.56, 1.9), dark.lightened(0.08))
	box.call(Vector3(0, 1.36, 0.36), Vector3(0.24, 0.07, 0.03), dark)           # the mirror
	box.call(Vector3(0, 1.4, 0.32), Vector3(0.03, 0.06, 0.03), dark)
	# the pillars beside the windscreen and the roof's edge over it, seen from inside
	var shape: Array = CAR_SHAPES["sedan"]
	var hw: float = shape[2]
	var c0: Vector2 = shape[1][0]
	var c1: Vector2 = shape[1][1]
	var lo := hw - 0.06
	var up := hw - 0.24
	var quad2 := func(a: Vector3, e: Vector3, f: Vector3, d: Vector3, col: Color) -> void:
		var n := (e - a).cross(d - a).normalized()
		for sg: float in [1.0, -1.0]:
			b.tri(a, e, f, n * sg, col)
			b.tri(a, f, d, n * sg, col)
	for sx: float in [-1.0, 1.0]:
		var foot := Vector3(lo * sx, c0.y, c0.x)
		var top := Vector3(up * sx, c1.y, c1.x)
		var inw := Vector3(-sx * 0.11, 0, 0)
		quad2.call(foot, top, top + inw + Vector3(0, -0.02, -0.03), foot + inw + Vector3(0, 0, -0.04), dark)
	quad2.call(Vector3(-up, c1.y - 0.01, c1.x), Vector3(up, c1.y - 0.01, c1.x), Vector3(up, c1.y + 0.01, c1.x - 0.5),
			Vector3(-up, c1.y + 0.01, c1.x - 0.5), dark.lightened(0.1))
	# the bonnet through the windscreen, in the car's paint (the body itself is hidden here:
	# it is built to be seen from outside, and from inside it showed its backs)
	var low: Array = shape[0]
	var hb := Buf.new()
	var hood: Array = []
	for q: Vector2 in low:
		if q.x > c0.x - 0.05 and q.y > 0.5:
			hood.append(q)
	hood.sort_custom(func(a: Vector2, e: Vector2): return a.x < e.x)
	for i in range(hood.size() - 1):
		var a: Vector2 = hood[i]
		var e: Vector2 = hood[i + 1]
		var n := Vector3(0, e.x - a.x, -(e.y - a.y)).normalized()
		if n.y < 0.0:
			n = -n
		hb.tri(Vector3(-hw, a.y, a.x), Vector3(hw, a.y, a.x), Vector3(hw, e.y, e.x), n, Color.WHITE)
		hb.tri(Vector3(-hw, a.y, a.x), Vector3(hw, e.y, e.x), Vector3(-hw, e.y, e.x), n, Color.WHITE)
	var hmi := MeshInstance3D.new()
	var ham := ArrayMesh.new()
	ham.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, hb.arrays())
	ham.surface_set_material(0, _car_mat("paint", "paint"))
	hmi.mesh = ham
	hmi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_cockpit_node.add_child(hmi)
	var mi := MeshInstance3D.new()
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, b.arrays())
	var m := StandardMaterial3D.new()
	m.vertex_color_use_as_albedo = true
	m.roughness = 0.9
	am.surface_set_material(0, m)
	mi.mesh = am
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_cockpit_node.add_child(mi)
	# the wheel: a ring and three spokes, tilted back toward the driver, turned with the
	# front wheels (about 15 turns of it to one of theirs)
	# the speedometer and rev counter in the binnacle, facing the driver, and the green
	# indicator arrows between them
	var face_c: Color = _tone["tyre"].darkened(0.4)
	var tick_c: Color = _tone["mark"]
	var dial_at := [Vector3(0.465, 1.03, 0.43), Vector3(0.275, 1.03, 0.43)]
	var dial_b := Basis(Vector3.RIGHT, 0.32)   # tipped back toward the eyes
	var b0: Buf = b
	b = Buf.new()   # (the cockpit's own mesh is built already: the dials get one of theirs)
	for di in range(2):
		var c: Vector3 = dial_at[di]
		var R := 0.052
		for i in range(16):
			var a0 := TAU * i / 16.0
			var a1 := TAU * (i + 1) / 16.0
			var e0 := Vector3(cos(a0), sin(a0), 0)
			var e1 := Vector3(cos(a1), sin(a1), 0)
			b.tri(c, c + dial_b * (e0 * R), c + dial_b * (e1 * R), dial_b * Vector3.FORWARD, face_c)
			# a bright rim round it, so the dial reads in a dark cabin
			var z := Vector3(0, 0, -0.001)
			b.tri(c + dial_b * (e0 * R + z), c + dial_b * (e0 * (R + 0.006) + z), c + dial_b * (e1 * (R + 0.006) + z), dial_b * Vector3.FORWARD, tick_c)
			b.tri(c + dial_b * (e0 * R + z), c + dial_b * (e1 * (R + 0.006) + z), c + dial_b * (e1 * R + z), dial_b * Vector3.FORWARD, tick_c)
		for i in range(9):
			var a := 2.2 - 4.4 * i / 8.0 + PI * 0.5
			var d := Vector3(cos(a), sin(a), 0)
			var nn := Vector3(-d.y, d.x, 0) * 0.003
			var p0 := d * R * 0.78
			var p1 := d * R * 0.95
			b.tri(c + dial_b * (p0 - nn + Vector3(0, 0, -0.002)), c + dial_b * (p1 - nn + Vector3(0, 0, -0.002)), c + dial_b * (p1 + nn + Vector3(0, 0, -0.002)), dial_b * Vector3.FORWARD, tick_c)
			b.tri(c + dial_b * (p0 - nn + Vector3(0, 0, -0.002)), c + dial_b * (p1 + nn + Vector3(0, 0, -0.002)), c + dial_b * (p0 + nn + Vector3(0, 0, -0.002)), dial_b * Vector3.FORWARD, tick_c)
		var pivot := Node3D.new()
		pivot.position = c + dial_b * Vector3(0, 0, -0.004)
		pivot.basis = dial_b
		_cockpit_node.add_child(pivot)
		var needle := MeshInstance3D.new()
		var nm := BoxMesh.new()
		nm.size = Vector3(0.004, 0.05, 0.002)
		needle.mesh = nm
		needle.position = Vector3(0, 0.022, 0)
		needle.material_override = mat("hazard", 1.4)
		pivot.add_child(needle)
		if di == 0:
			_dial_speed = pivot
		else:
			_dial_rpm = pivot
	var dmi := MeshInstance3D.new()
	var dam := ArrayMesh.new()
	dam.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, b.arrays())
	dam.surface_set_material(0, m)
	dmi.mesh = dam
	dmi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_cockpit_node.add_child(dmi)
	b = b0
	for side: int in [-1, 1]:
		var arrow := MeshInstance3D.new()
		var ab := Buf.new()
		var sx := -float(side)   # the car's right is -X
		var c := Vector3(0.37 + sx * 0.03, 1.03, 0.43)
		ab.tri(c + dial_b * Vector3(sx * 0.018, 0, -0.003), c + dial_b * Vector3(-sx * 0.01, 0.013, -0.003), c + dial_b * Vector3(-sx * 0.01, -0.013, -0.003), dial_b * Vector3.FORWARD, Color.WHITE)
		var aam := ArrayMesh.new()
		aam.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, ab.arrays())
		arrow.mesh = aam
		arrow.material_override = mat("friend", 2.2)
		arrow.visible = false
		_cockpit_node.add_child(arrow)
		_dash_arrows[side] = arrow
	_wheel_node = Node3D.new()
	_wheel_node.position = Vector3(0.37, 0.94, 0.3)
	_wheel_node.rotation.x = -0.45
	_cockpit_node.add_child(_wheel_node)
	var wb := Buf.new()
	var rim := dark.darkened(0.3)
	var R := 0.185
	for i in range(14):
		var a0 := TAU * i / 14.0
		var a1 := TAU * (i + 1) / 14.0
		var p0 := Vector3(cos(a0) * R, sin(a0) * R, 0)
		var p1 := Vector3(cos(a1) * R, sin(a1) * R, 0)
		var r0 := p0.normalized() * 0.022
		var r1 := p1.normalized() * 0.022
		for side: float in [1.0, -1.0]:
			var zz := Vector3(0, 0, 0.022 * side)
			wb.tri(p0 + zz - r0, p1 + zz - r1, p1 + zz + r1, Vector3(0, 0, side), rim)
			wb.tri(p0 + zz - r0, p1 + zz + r1, p0 + zz + r0, Vector3(0, 0, side), rim)
			wb.tri(p0 + r0 * side - zz, p1 + r1 * side - zz, p1 + r1 * side + zz, p0.normalized() * side, rim)
			wb.tri(p0 + r0 * side - zz, p1 + r1 * side + zz, p0 + r0 * side + zz, p0.normalized() * side, rim)
	for a: float in [PI * 0.5 + PI, 0.0, PI]:
		var d := Vector3(cos(a), sin(a), 0) * R
		var n := Vector3(-d.y, d.x, 0).normalized() * 0.02
		for side: float in [1.0, -1.0]:
			var zz := Vector3(0, 0, 0.012 * side)
			wb.tri(zz - n, d + zz - n, d + zz + n, Vector3(0, 0, side), rim)
			wb.tri(zz - n, d + zz + n, zz + n, Vector3(0, 0, side), rim)
	var wmi := MeshInstance3D.new()
	var wam := ArrayMesh.new()
	wam.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, wb.arrays())
	wam.surface_set_material(0, m)
	wmi.mesh = wam
	wmi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_wheel_node.add_child(wmi)

## ---- on foot ---------------------------------------------------------------------------------
## Out of the car (the "walk" button, or F): the driver steps out of the door onto the
## street and walks the same city -- arrows or the stick to walk and turn, held action
## (space) to run. Out of a moving car you jump: you tumble out of the door with the car's
## speed, roll, and get up; the car rolls on driverless, slowing, until it stops or hits
## something. Traffic goes round it; traffic stops for you on the road the way it does for
## the car. Back at the car, the same button gets you in.
var _car_v := 0.0                    ## the empty car still rolling (m/s, along its heading)
var _tumble := 0.0                   ## s left of a tumble out of a moving car (no control)
var _jump_v := Vector2.ZERO          ## the tumble's slide

func _get_out() -> void:
	var moving := absf(_v) > 1.0
	if _auto:
		_set_auto(false)
	_set_blink(0)
	_horn_held = false
	_throttle_in = 0.0
	_car_at = _pos
	_car_yaw_at = _yaw
	_car_y_at = _y
	var fwd := _fwd()
	var left := Vector2(fwd.y, -fwd.x)
	var door := _pos + left * 1.4
	if _push_out(door, 0.35, true, true, _y) != Vector2.ZERO:
		door = _pos - left * 1.4   # a wall on that side: out of the other door
	if _me == null:
		_me = Actor3D.new()
		world.add_child(_me)
		_me.set_character(PEOPLE[1], 1.66)   # (a woman's figure: Israel's women average ~1.63, men ~1.77)
		_humanize(_me, hash(_me.get_instance_id()))
	_me.visible = true
	_me_anim = ""
	_walking = true
	_car_material()   # (you, seen through the windows, get in or out)
	_set_cockpit(_cockpit)   # (from the eyes if the seat view was on)
	if _cockpit_node != null:
		_cockpit_node.visible = false
	if _sedan_node != null:   # the car seen from outside again, whatever the view
		for gi: GeometryInstance3D in _sedan_node.find_children("*", "GeometryInstance3D", true, false):
			gi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
	_pos = door
	_prev_pos = door
	_car_v = _v if moving else 0.0
	_tumble = 0.0
	_jump_v = Vector2.ZERO
	if moving:
		# out of the door with the car's speed (a little less: you push off it) and away
		# from it; a roll, and up again
		var side := (door - _car_at).normalized()
		_jump_v = fwd * _v * 0.75 + side * 2.2
		_tumble = clampf(0.5 + absf(_v) * 0.05, 0.5, 1.5)
		_me.play("Roll" if absf(_v) > 4.0 else "RecieveHit", false, 1.0)
		_me_anim = "tumble"
		_yaw = _jump_v.angle()
		_prev_yaw = _yaw
	_v = 0.0
	_y = _walk_y(door, _car_y_at)
	_prev_y = _y
	_cam_dist = 3.4
	Probe.event("walk", {"on": true, "jumped": moving, "kmh": int(absf(_car_v) * 3.6)})
	_show_banner("jumped out!" if moving else "on foot", 1.0)

func _get_in() -> void:
	var d := _pos.distance_to(_car_at)
	# any car in traffic within reach, nearer than yours: you take it (it leaves the traffic,
	# and your car is where that one stood). Parked cars are drawn in batches a square at a
	# time, and are not taken yet.
	var take = _car_to_take(minf(d, TAKE_REACH))
	if take != null:
		var cdir := Vector2(sin(float(take.yaw)), cos(float(take.yaw)))
		_car_at = take.pos
		_car_yaw_at = cdir.angle()
		_car_y_at = float(take.y)
		_car_v = 0.0
		take.alive = false
		take.retry = 8.0
		_show_banner("you took the %s" % String(take.kind), 1.6)
		Probe.event("take_car", {"kind": String(take.kind)})
	elif d > 3.6:
		_show_banner("walk to a car -- yours is %d m off, or any car in the traffic" % int(d), 1.8)
		return
	_walking = false
	_car_material()   # (you, seen through the windows, get in or out)
	_me.visible = false
	_set_cockpit(_cockpit)   # back to the view it was in
	_pos = _car_at
	_prev_pos = _car_at
	_yaw = _car_yaw_at
	_prev_yaw = _yaw
	_y = _car_y_at
	_v = _car_v   # (caught it still rolling: it rolls on with you in it)
	_car_v = 0.0
	_gear = 1
	Probe.event("walk", {"on": false})
	_show_banner("driving", 1.0)

## the traffic car nearest you on foot, its body within `reach` (not a bus or a motorbike), or null
func _car_to_take(reach: float):
	if _traffic == null:
		return null
	var best = null
	var bd := reach
	for c in _traffic.cars:
		if not c.alive or c.kind == "bus" or c.kind == "moto":
			continue
		var cdir := Vector2(sin(float(c.yaw)), cos(float(c.yaw)))
		var half := float(c.len) * 0.5
		var q := Geometry2D.get_closest_point_to_segment(_pos, c.pos - cdir * half, c.pos + cdir * half)
		var dd := q.distance_to(_pos) - 0.9   # (from its side, not its middle line)
		if dd < bd:
			bd = dd
			best = c
	return best

## ---- a filmed walk, replayed ------------------------------------------------------------------
## A place in LEVELS with a "walk" replays a walk someone filmed: in first person, from the
## eyes of someone holding a phone at the chest, on its own, with no controls and no driving
## HUD. The route is in the city's details file (details.gd) as [seconds, x, z] points timed
## to the film, so it passes each place when the film did and the two can be watched side
## by side. At the end it stands still.
## The head is not the body: it looks where the walk is going and turns into a bend a moment
## before the feet do, and the walk's "looks" turn it to see the traffic before a crossing.
## While the walk waits at a crossing or is on it ("zebras"), it counts as someone on the
## zebra, so cars stop for it; "cars" sends a car down a street at a set second, so there is
## traffic to stop when it gets there.

var _film: Array = []                ## Vector3(x, z, seconds): the route, in time order
var _film_t := 0.0
var _film_step := 0.0                ## metres walked: the head bobs with the steps
var _film_done := false
var _film_look := 0.0                ## the head turned from the body (radians, + right)
var _film_looks: Array = []          ## Vector4(from, to, radians across, radians up): a glance
var _film_head: Array = []           ## Vector2(seconds, radians right of the body): the head's turns
                                     ## as measured off the film (the walk's "head"); where it runs,
                                     ## it is the head, in place of the turn into bends and the looks'
                                     ## turns across (their tips up and down still apply)
var _film_faces: Array = []          ## Vector3(from, to, radians round the map): the camera held facing that way
var _film_tilt := 0.0                ## the phone tipped from its usual tilt by the looks (radians, + up)
var _film_zebras: Array = []         ## [from, to, kerb, kerb]: on a crossing (or waiting at it)
var _film_cars: Array = []           ## [second, at, heading]: a car sent down a street
var _film_sent := 0
var _film_people: Array = []         ## [actor, from, to, from second, to second, stays, arrived, talking's facing or INF]: who the film shows

func _film_begin(id: String) -> void:
	var walks: Dictionary = _details.data.get("walks", {}) if _details != null else {}
	var pts: Array = (walks.get(id, {}) as Dictionary).get("points", [])
	if pts.size() < 2:
		Probe.note("no walk '%s' in this city's details file" % id)
		return
	for p: Array in pts:
		_film.append(Vector3(float(p[1]), float(p[2]), float(p[0])))
	var w: Dictionary = walks[id]
	for l: Array in w.get("looks", []):
		# [from, to, degrees right] and, if there, degrees up (down at a zebra's stripes: -25)
		_film_looks.append(Vector4(float(l[0]), float(l[1]), deg_to_rad(float(l[2])),
			deg_to_rad(float(l[3])) if l.size() > 3 else 0.0))
	for f: Array in w.get("face", []):
		_film_faces.append(Vector3(float(f[0]), float(f[1]), deg_to_rad(float(f[2]))))
	for h: Array in w.get("head", []):
		_film_head.append(Vector2(float(h[0]), deg_to_rad(float(h[1]))))
	for z: Array in w.get("zebras", []):
		_film_zebras.append([float(z[0]), float(z[1]), Vector2(z[2][0], z[2][1]), Vector2(z[3][0], z[3][1])])
	for c: Array in w.get("cars", []):
		_film_cars.append([float(c[0]), Vector2(c[1][0], c[1][1]), Vector2(c[2][0], c[2][1]), c[3] if c.size() > 3 else {}])
	_film_cars.sort_custom(func(a, b): return a[0] < b[0])
	# the people the film shows, where it shows them: standing, or walking from `at` to `to`
	# between two of its seconds (and not there before or after)
	for pp: Dictionary in w.get("people", []):
		var a := Actor3D.new()
		world.add_child(a)
		var who := int(pp.get("who", _film_people.size()))
		a.set_character(PEOPLE[who % PEOPLE.size()], float(pp.get("tall", 1.70)))
		_humanize(a, 9001 + who * 31)
		if bool(pp.get("talk", false)):
			_talker(a, 9001 + who * 31)
		_people_lod(a)
		var A := Vector2(float(pp["at"][0]), float(pp["at"][1]))
		var B := Vector2(float(pp["to"][0]), float(pp["to"][1])) if pp.has("to") else A
		var tt: Array = pp.get("t", [0.0, 0.0])
		a.position = Vector3(A.x, _walk_y(A), A.y)
		var fc: Array = pp.get("face", [1, 0])
		var fd: Vector2 = (B - A).normalized() if B != A else Vector2(float(fc[0]), float(fc[1])).normalized()
		a.face(Vector3(fd.x, 0, fd.y))
		var moving := B != A
		var pace: float = A.distance_to(B) / maxf(float(tt[1]) - float(tt[0]), 0.01)
		a.play("Walk" if moving else "Idle", true, pace / _walk_clip_v() if moving else 1.0)
		a.visible = not moving
		# `talk`: one of a group standing talking -- no clip for it, so the body does it: turning a
		# little to the one spoken to and back, now and then a wider turn (as the film's do)
		_film_people.append([a, A, B, float(tt[0]), float(tt[1]), bool(pp.get("stay", false)), false,
			fd.angle() if bool(pp.get("talk", false)) else INF])
	if bool(w.get("dodge", false)):
		_film_dodge_begin()
	var p0 := _film_at(0.0)
	_pos = p0
	_yaw = (_film_at(1.5) - p0).angle()
	_v = 0.0
	_y = 1.0e6
	_snap_pose()
	_cockpit = true
	_get_out()
	_car.visible = false
	_pos = p0
	_prev_pos = p0
	_cam_yaw = _yaw
	_hud.visible = false
	if OS.get_environment("STREETS_FILM_LOOK") != "0":   # (=0: the game's own picture, to measure it bare)
		_film_look_layer()
	_walk_bar_build()
	Probe.event("film", {"walk": id, "seconds": _film[_film.size() - 1].z})

## The phone's picture over a filmed walk: a grade on the finished frame, under the shell's
## buttons. Measured, one frame a second over walk 1, film against replay (game/streets/
## tests/film_look.py): the phone's HDR squeezes the bright end (its brightest 1% stops at
## 0.87; the game clipped 4.4% of the frame to white) and lifts the dark (its shade on the
## ground at 0.23 against 0.11), its greys a little warm (the game's a little cyan), its
## colours less saturated. FILM_CURVE takes the game's levels to the film's at 17 points,
## the same on each channel; a 6% warmth fades out over the brightest tones (on the pale sky
## it read pink; fitted, it went to 16% and grey pavers went mauve); then saturation back up
## by FILM_SAT, as the flatter curve takes some out. Only the walks: the game's own look is
## other sessions' (the light, the haze) and drives on.
## (refitted 21 Nov on a bare recording after the deeper light -- fill x0.6, sun x1.12 -- which
## clipped 2.2% of the bare picture and left it more saturated: 0.191 against the film's 0.159;
## again 22 Nov after white plaster's roll-off, neutral paving greys and greener leaves, with
## FILM_WARM 1.0: the graded greys' red/green 1.068 -> 1.048, the film's 1.021; then with
## FILM_WB, the curve refitted and the saturation held at 1.2)
const FILM_CURVE := [0.054, 0.107, 0.194, 0.278, 0.350, 0.414, 0.464, 0.504, 0.535, 0.562, 0.586,
	0.611, 0.638, 0.670, 0.707, 0.781, 0.877]
const FILM_WARM := 1.0   ## (1.06 on the old light; the bare picture's greys are as warm as the film's now)
const FILM_SAT := 1.2   ## (the fit asks 1.47 with FILM_WB on: the film's colour is its content -- fresh
## green, blue sky -- more than its grade, and 1.47 put the pavers' tint straight back)
## the phone's white balance, on every tone: red and blue gains that put the graded greys where
## the film's are (red/green 1.021, blue/green 1.006). Without it a grey paver lit by the warm
## sun read cream, one a shade darker -- more of the violet fill light -- read pink, and the
## grade's saturation doubled both (the passage at 55 s: grey pavers drawn beige and pink)
const FILM_WB := [0.973, 1.037]
## the phone's auto-exposure: [target, strength, least, most] -- the frame's mean brightness
## pulled towards target by (target / mean)^strength, in light, within least..most. The film's
## brightness second to second holds at 0.45 +- 0.055 (its exposure follows the view); the
## replay's swung 0.48 +- 0.12, dark under the arcade (0.28), bright on the sunny forecourt
## (0.64). With this, 0.455 +- 0.070 (fitted, tests/film_look.py; the curve after it).
const FILM_EXPO := [0.45, 0.75, 0.6, 2.0]
func _film_look_layer() -> void:
	var sh := Shader.new()
	sh.code = """shader_type canvas_item;
uniform sampler2D screen_tex : hint_screen_texture, filter_linear_mipmap;
uniform float expo_target = 0.45;
uniform float expo_k = 0.0;
uniform float expo_min = 0.6;
uniform float expo_max = 2.0;
uniform int debug = 0;
const vec3 LUM = vec3(0.2126, 0.7152, 0.0722);
const float CURVE[17] = float[17](%s);
float tone(float v) {
	float x = clamp(v, 0.0, 1.0) * 16.0;
	int i = min(int(floor(x)), 15);
	return mix(CURVE[i], CURVE[i + 1], x - float(i));
}
// the phone's meter: the frame's mean brightness, from the screen shrunk 128 times (its mipmaps)
float meter() {
	float m = 0.0;
	for (int i = 0; i < 4; i++) {
		for (int j = 0; j < 4; j++) {
			m += dot(textureLod(screen_tex, vec2((float(i) + 0.5) / 4.0, (float(j) + 0.5) / 4.0), 7.0).rgb, LUM);
		}
	}
	return m / 16.0;
}
void fragment() {
	vec3 c = textureLod(screen_tex, SCREEN_UV, 0.0).rgb;
	float m = meter();
	if (debug == 1) {
		COLOR = vec4(SCREEN_UV.x < 0.1 && SCREEN_UV.y < 0.1 ? vec3(m) : c, 1.0);
	} else {
		// exposure, in light (not in the picture's code values), as the phone sets it
		float gain = clamp(pow(expo_target / max(m, 0.02), expo_k), expo_min, expo_max);
		c = pow(pow(c, vec3(2.2)) * gain, vec3(1.0 / 2.2));
		float l0 = dot(c, LUM);
		c *= vec3(%f, 1.0, %f) * mix(vec3(1.0), vec3(%f, 1.0, 1.0), 1.0 - smoothstep(0.6, 0.9, l0));
		c = vec3(tone(c.r), tone(c.g), tone(c.b));
		float l = dot(c, LUM);
		COLOR = vec4(clamp(vec3(l) + (c - vec3(l)) * %f, 0.0, 1.0), 1.0);
	}
}
""" % [", ".join(FILM_CURVE.map(func(v: float) -> String: return "%.3f" % v)), FILM_WB[0], FILM_WB[1], FILM_WARM, FILM_SAT]
	var mat := ShaderMaterial.new()
	mat.shader = sh
	mat.set_shader_parameter("expo_target", FILM_EXPO[0])
	mat.set_shader_parameter("expo_k", FILM_EXPO[1])
	mat.set_shader_parameter("expo_min", FILM_EXPO[2])
	mat.set_shader_parameter("expo_max", FILM_EXPO[3])
	mat.set_shader_parameter("debug", 1 if OS.get_environment("STREETS_FILM_LOOK") == "meter" else 0)
	var layer := CanvasLayer.new()
	layer.layer = 1   # (over the world, under the shell's buttons: Flow's layer is 10)
	var r := ColorRect.new()
	r.set_anchors_preset(Control.PRESET_FULL_RECT)
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	r.material = mat
	layer.add_child(r)
	add_child(layer)

func _film_tick(dt: float) -> void:
	_film_t += dt
	_walk_bar_tick()
	if not _film_base.is_empty() and _film_t >= _film_dodged:
		_film_dodged = _film_t + 2.0
		_film_dodge(_film_t + 4.0, _film_t + 40.0)   # (the squares ahead have built since)
	var p := _film_at(_film_t)
	var moved := p.distance_to(_pos)
	_film_step += moved
	_v = moved / maxf(dt, 0.001)
	_pos = p
	_y = _decks.surf(p, _y)
	var ahead := _film_at(_film_t + 1.6)
	if ahead.distance_to(p) > 0.3:
		_yaw = lerp_angle(_yaw, (ahead - p).angle(), 1.0 - exp(-dt * 2.2))
	# the head: into a bend before the feet (where the walk is 3.4 s on, against 1.6 s), and
	# off to the side for each glance, easing in and out over half a second
	var turn := 0.0
	var far := _film_at(_film_t + 3.4)
	if ahead.distance_to(p) > 0.3 and far.distance_to(p) > 0.6:
		turn = clampf(angle_difference((ahead - p).angle(), (far - p).angle()) * 0.7, -0.6, 0.6)
	var tip := 0.0
	var head: bool = _film_head.size() > 1 and _film_t >= _film_head[0].x and _film_t <= _film_head[_film_head.size() - 1].x
	if head:
		var j := 0
		while j < _film_head.size() - 2 and _film_head[j + 1].x <= _film_t:
			j += 1
		var h0: Vector2 = _film_head[j]
		var h1: Vector2 = _film_head[j + 1]
		turn = lerpf(h0.y, h1.y, clampf((_film_t - h0.x) / maxf(h1.x - h0.x, 0.001), 0.0, 1.0))
	for l: Vector4 in _film_looks:
		if _film_t > l.x and _film_t < l.y:
			var k := smoothstep(l.x, l.x + 0.5, _film_t) * (1.0 - smoothstep(l.y - 0.5, l.y, _film_t))
			if not head:
				turn += l.z * k
			tip += l.w * k
	# a car going by: the head goes with it for a moment (_film_glance), over the walk's own turns
	var told := false   # (a look or a facing the walk sets: the film's own head, known -- no glance starts)
	for l: Vector4 in _film_looks:
		told = told or (_film_t > l.x - 0.5 and _film_t < l.y + 0.5)
	for fc: Vector3 in _film_faces:
		told = told or (_film_t > fc.x - 0.5 and _film_t < fc.y + 0.5)
	var gl := _film_glance(dt, not told)
	if gl.x > 0.001:
		turn += angle_difference(turn, gl.y) * gl.x
	# `face`: the camera held on a way round the map between two seconds, whatever the body does
	# (where a film's head is known by what its frames show, not by how its head turned)
	for fc: Vector3 in _film_faces:
		if _film_t > fc.x and _film_t < fc.y:
			var k := smoothstep(fc.x, fc.x + 0.5, _film_t) * (1.0 - smoothstep(fc.y - 0.5, fc.y, _film_t))
			turn += angle_difference(turn, angle_difference(_yaw, fc.z)) * k
	_film_look = lerp_angle(_film_look, turn, 1.0 - exp(-dt * 6.0))
	_film_tilt = lerpf(_film_tilt, tip, 1.0 - exp(-dt * 6.0))
	for fp: Array in _film_people:
		var A: Vector2 = fp[1]
		var B: Vector2 = fp[2]
		if A == B:
			var base: float = fp[7]
			if base < INF:
				var turn_to := base + 0.26 * sin(_film_t * 1.3 + base * 3.0) + 0.14 * sin(_film_t * 2.9 + base)
				(fp[0] as Actor3D).face(Vector3(cos(turn_to), 0, sin(turn_to)))
			continue
		var f: float = (_film_t - float(fp[3])) / maxf(float(fp[4]) - float(fp[3]), 0.01)
		var who: Actor3D = fp[0]
		who.visible = f >= 0.0 and (f <= 1.0 or fp[5])   # (a walker that stays stands where it got to)
		if who.visible:
			var q := A.lerp(B, clampf(f, 0.0, 1.0))
			who.position = Vector3(q.x, _walk_y(q), q.y)
			if f > 1.0 and not fp[6]:
				fp[6] = true
				who.play("Idle", true, 1.0)
	# a passer-by keeping pace just ahead on the walk's line: a stranger's back for a minute
	# and more (one led the whole of Sirkin), which no film has. After a few seconds of it they
	# step out briskly and draw away.
	var hd := Vector2(cos(_yaw), sin(_yaw))
	for w: Dictionary in _walkers:
		var line: PackedVector2Array = w["line"]
		var wa: Actor3D = w["actor"]
		if line.size() < 2 or not wa.visible:
			continue
		var cum: PackedFloat32Array = w["cum"]
		var ws: float = w["s"]
		var go := _along(line, cum, clampf(ws + float(w["dir"]) * 0.5, 0.0, cum[cum.size() - 1])) - _along(line, cum, ws)
		var rel := Vector2(wa.position.x, wa.position.z) - p
		if rel.length() < 14.0 and rel.dot(hd) > 2.0 and go != Vector2.ZERO and go.normalized().dot(hd) > 0.7:
			w["film_ahead"] = float(w.get("film_ahead", 0.0)) + dt
			if float(w["film_ahead"]) > 4.0 and float(w["speed"]) < 1.9:
				w["speed"] = 1.9
				wa.anim.speed_scale = 1.9 / _walk_clip_v()
		else:
			w["film_ahead"] = 0.0
	while _film_sent < _film_cars.size() and _film_t >= float(_film_cars[_film_sent][0]):
		var fc: Array = _film_cars[_film_sent]
		_film_sent += 1
		if _traffic != null and not _traffic.send(fc[1], fc[2], fc[3]):
			Probe.note("film: no street to send a car down at %s" % fc[1])
	var anim := "Idle" if _v < 0.15 else "Walk"
	if anim != _me_anim:
		_me_anim = anim
		_me.play(anim, true, 1.0 if anim == "Idle" else maxf(_v / 2.1, 0.5))   # (as before WALK went up to a jog)
	if _film_t >= _film[_film.size() - 1].z and not _film_done:
		_film_done = true
		Probe.event("film_end", {"at": Vector2i(p)})

## the crossings the walk is waiting at or on, in with the people on zebras (tagged, so the
## last tick's go: the list is only rebuilt where a town has people crossing)
func _film_on_zebras() -> void:
	_zebras_on = _zebras_on.filter(func(z: Array) -> bool: return not (z.size() == 4 and typeof(z[3]) == TYPE_STRING))
	for z: Array in _film_zebras:
		if _film_t >= float(z[0]) and _film_t <= float(z[1]):
			var a: Vector2 = z[2]
			var b: Vector2 = z[3]
			_zebras_on.append([(a + b) * 0.5, a.distance_to(b) * 0.5 - 0.1, (b - a).normalized(), "film"])

## A walk nobody filmed (data_tools/make_walks.py, `dodge`) is laid along a street's pavement
## by its map alone and knows nothing of what stands on it -- the city's trees, poles, bins,
## and whatever other sessions put on pavements later. So the game steps it round them: the
## walk resampled every quarter second (and at each of its own points, so its waits keep their
## times), and each sample pushed sideways off any post within reach, toward the side that
## is clear of walls, the push spread over DODGE_SPREAD m either way so it bends round, not
## jumps. Squares build as the walk goes, so it is done again for the stretch ahead every 2 s.
const DODGE_CLEAR := 0.55        ## from a post's edge to the walker's middle
const DODGE_SPREAD := 2.5        ## metres along the walk a push fades over
var _film_base: Array = []       ## the samples as laid: Vector3(x, z, t)
var _film_side: Array = []       ## each sample's right (Vector2), across the way it walks
var _film_arc: PackedFloat32Array = PackedFloat32Array()   ## metres along the walk at each sample
var _film_dodged := 0.0          ## the walk's second the stretch ahead is next looked over

func _film_dodge_begin() -> void:
	var end: float = _film[_film.size() - 1].z
	var ts := {}
	for q: Vector3 in _film:
		ts[snappedf(q.z, 0.01)] = true
	var t := 0.0
	while t < end:
		ts[snappedf(t, 0.01)] = true
		t += 0.25   # (0.5 let a post between two samples through, at a crossing's railings)
	var keys := ts.keys()
	keys.sort()
	var base: Array = []
	for k: float in keys:
		var p := _film_at(k)
		base.append(Vector3(p.x, p.y, k))
	_film_base = base
	_film_side = []
	_film_arc = PackedFloat32Array()
	var arc := 0.0
	var last := Vector2.RIGHT
	for i in range(base.size()):
		if i > 0:
			arc += Vector2(base[i].x, base[i].y).distance_to(Vector2(base[i - 1].x, base[i - 1].y))
		_film_arc.append(arc)
		var a := _film_at(base[i].z - 0.4)
		var b := _film_at(base[i].z + 0.4)
		if b.distance_to(a) > 0.05:
			last = (b - a).normalized()
		_film_side.append(Vector2(-last.y, last.x))
	_film = base.duplicate()
	_film_dodge(0.0, end + 1.0)

## how far round a post a walk keeps: its own radius, but a tree's crown where the tree is
## not by a road (only those are pruned up: a boulevard's middle, a park's path keep theirs low,
## and with the eye at 1.75 Rothschild's walk went through one)
var _reach_memo := {}
func _post_reach(j: int) -> float:
	if not is_equal_approx(_post_r[j], 0.3):
		return _post_r[j]
	if not _reach_memo.has(j):
		var rh: Dictionary = _nearest_seg(_posts[j], 6.0, true)
		_reach_memo[j] = 0.3 if (not rh.is_empty() and float(rh["edge"]) < 3.0) else 1.9
	return _reach_memo[j]

func _film_dodge(t0: float, t1: float) -> void:
	var n := _film_base.size()
	var need := PackedFloat32Array()
	need.resize(n)
	var lo := n
	var hi := -1
	for i in range(n):
		var b: Vector3 = _film_base[i]
		if b.z < t0 - 3.0 or b.z > t1 + 3.0:
			continue
		lo = mini(lo, i)
		hi = maxi(hi, i)
		var p := Vector2(b.x, b.y)
		var sd: Vector2 = _film_side[i]
		var near: Array = []
		for j: int in _near(_post_hash, p, 3.5, BLD_CELL):
			if p.distance_to(_posts[j]) < _post_reach(j) + DODGE_CLEAR + 1.6:
				near.append(j)
		# off a crossing, the walk keeps off the asphalt too (a footway OSM maps beside a
		# carriageway can lie inside the game's fitted one: Rothschild's)
		var kerbside := true
		for z: Array in _film_zebras:
			kerbside = kerbside and not (b.z >= float(z[0]) - 0.6 and b.z <= float(z[1]) + 0.6)
		if near.is_empty() and _push_out(p, 0.25, false, false) == Vector2.ZERO and (not kerbside or _off_road(p, 0.15)):
			need[i] = 0.0
			continue   # (nothing near, not in a wall, not on a road: a garden wall's corner sat on one walk's line)
		# the step sideways (up to 3 m either way, in 10 cm) nearest the last sample's that is
		# clear of all of them at once and of the walls; if none is, the one with the most room.
		# (Nearest the last, not the least: the least flipped sides between a shelter's panel and
		# a bin at the kerb, and the curve between went through the panel.)
		var prev: float = need[i - 1] if i > lo else 0.0
		var cands: Array = []
		for k in range(-30, 31):
			cands.append(0.1 * float(k))
		cands.sort_custom(func(x, y): return absf(x - prev) < absf(y - prev))
		var best := 0.0
		var room := -INF
		var found := false
		# first a step clear of the trunks and the low crowns too, then one clear of what is
		# solid alone (a crown is to keep out of where there is room, not to walk into a wall for)
		for soft: bool in [true, false]:
			for off: float in cands:
				var q := p + sd * off
				if _push_out(q, 0.25, false, false) != Vector2.ZERO or (kerbside and not _off_road(q, 0.15)):
					continue
				var m := INF
				for j: int in near:
					m = minf(m, q.distance_to(_posts[j]) - (_post_reach(j) if soft else _post_r[j]))
				if m >= DODGE_CLEAR:
					best = off
					found = true
					break
				if not soft and m > room:
					room = m
					best = off
			if found:
				break
		need[i] = best
	if hi < 0:
		return
	for i in range(lo, hi + 1):
		var b: Vector3 = _film_base[i]
		if b.z < t0 or b.z > t1:
			continue
		var off := 0.0
		var j := i
		while j >= 0 and _film_arc[i] - _film_arc[j] < DODGE_SPREAD:
			var w := 0.5 + 0.5 * cos(PI * (_film_arc[i] - _film_arc[j]) / DODGE_SPREAD)
			if absf(need[j]) * w > absf(off):
				off = need[j] * w
			j -= 1
		j = i + 1
		while j < n and _film_arc[j] - _film_arc[i] < DODGE_SPREAD:
			var w := 0.5 + 0.5 * cos(PI * (_film_arc[j] - _film_arc[i]) / DODGE_SPREAD)
			if absf(need[j]) * w > absf(off):
				off = need[j] * w
			j += 1
		var q := Vector2(b.x, b.y) + (_film_side[i] as Vector2) * off
		_film[i] = Vector3(q.x, q.y, b.z)

## A person on foot turns their head to a car going by -- the film's walker did now and then and
## its head turns rarely show it (the user, 22 Nov: "sometimes not turning with my head on traffic
## passes, lets add that, even if it doesnt match the video 1:1"). So on every walk: a moving car
## within GLANCE_M, off to the side or coming, is followed by the head for up to GLANCE_S
## seconds (as far as GLANCE_MAX round from the body, with GLANCE_K of the turn), then let go;
## GLANCE_REST seconds before the next, so a busy street is not watched car by car. None starts
## inside a walk's own `looks` or `face` (where the film's head is known: walk 1 at its zebra
## turned to a car while its film looked across the median, 9-11 s scoring 6-12 worse).
const GLANCE_M := 14.0
const GLANCE_S := 2.2
const GLANCE_REST := 3.5
const GLANCE_MAX := 1.2          ## radians (~70 degrees) from the way the body faces
const GLANCE_K := 0.8
var _glance_car = null           ## the car being looked at (traffic.gd's), or null
var _glance_for := 0.0           ## seconds it has been looked at
var _glance_rest := 0.0          ## seconds before the next may be picked
var _glance_w := 0.0             ## how much the head is with it, eased
var _glances := 0                ## how many so far (tests)
var _glance_a := 0.0             ## the head's last turn toward it (the head eases back from there)

## Vector2(weight 0..1, the head's turn from the body toward the car)
func _film_glance(dt: float, may := true) -> Vector2:
	_glance_rest = maxf(0.0, _glance_rest - dt)
	if _traffic == null:
		return Vector2.ZERO
	var c = _glance_car
	if c != null:
		_glance_for += dt
		if not c.alive or c.pos.distance_to(_pos) > GLANCE_M + 6.0 or _glance_for > GLANCE_S 				or absf(angle_difference(_yaw, (c.pos - _pos).angle())) > GLANCE_MAX + 0.5:
			_glance_car = null
			_glance_rest = GLANCE_REST
			c = null
	if c == null and _glance_rest <= 0.0 and may:
		var best := GLANCE_M
		for car in _traffic.cars:
			if not car.alive or car.v < 2.5:
				continue
			var rel: Vector2 = car.pos - _pos
			var d := rel.length()
			if d >= best or d < 2.0:
				continue
			# coming toward the walker, or about to cross its view: not one already going away
			if Vector2(sin(car.yaw), cos(car.yaw)).dot(rel) > 0.3 and d > 6.0:
				continue   # (going away)
			if absf(angle_difference(_yaw, rel.angle())) > GLANCE_MAX:
				continue
			best = d
			c = car
		if c != null:
			_glance_car = c
			_glance_for = 0.0
			_glances += 1
	var on := c != null
	_glance_w = lerpf(_glance_w, GLANCE_K if on else 0.0, 1.0 - exp(-dt * 4.0))
	if on:
		_glance_a = clampf(angle_difference(_yaw, (c.pos - _pos).angle()), -GLANCE_MAX, GLANCE_MAX)
	return Vector2(_glance_w, _glance_a) if _glance_w > 0.01 else Vector2.ZERO

## A walk's progress along the foot of the screen: a thin bar and the time ("1:23 / 3:20"), and a
## speed button beside it -- 1x, 2x, 4x round, the whole world sped up together (the engine's
## time scale, as STREETS_SIM_SPEED: more game time a tick, not more ticks, so a phone's frame
## costs the same). The user, 22 Nov: "a progress bar to the walks so we know how much we
## passed, and maybe a speedup".
const WALK_SPEEDS := [1.0, 2.0, 4.0]
var _walk_speed := 1.0
var _walk_ui: Control
var _walk_fill: ColorRect
var _walk_time: Label
var _walk_btn: Button
var _walk_shown := -1

