## lights, plates and the four wheels on a sedan body
func _sedan_rest(root: Node3D, paint: String) -> Node3D:
	# lights and plates
	# head and tail lights laid on the body's rounded corners, like the traffic's (_lamp)
	var low := PackedVector2Array(CAR_SHAPES["sedan"][0])
	var heads := CarMesh.new()
	var tails := CarMesh.new()
	for sx: float in [-1.0, 1.0]:
		_lamp(heads, low, 0.9, sx * 0.6, 0.68, 0.36, 0.12, true, Color.WHITE)
		_lamp(tails, low, 0.9, sx * 0.63, 0.82, 0.32, 0.14, false, Color.WHITE)
	for pair: Array in [[heads, mat("ink", 1.2)], [tails, mat("hazard", 1.0)]]:
		var lm := MeshInstance3D.new()
		lm.mesh = (pair[0] as CarMesh).mesh(pair[1])
		root.add_child(lm)
	var plate := "warn" if String(_place.get("look", "")) == "med" else "ink"   # Israeli plates are yellow
	root.add_child(_part(BoxMesh, Vector3(0, 0.45, 2.28), Vector3(0.52, 0.12, 0.02), mat(plate, 0.1)))
	root.add_child(_part(BoxMesh, Vector3(0, 0.6, -2.3), Vector3(0.52, 0.12, 0.02), mat(plate, 0.1)))
	# their faces in the car shader (vertex alpha 0.65: a plate), its digits and strip with the
	# traffic's -- the boxes alone were blank yellow
	var pb := Buf.new()
	var pc := Color(Palette.col(plate), 0.65)
	for f: Array in [[0.45, 2.28 + 0.012, 1.0], [0.6, -2.3 - 0.012, -1.0]]:
		var py: float = f[0]
		var pz: float = f[1]
		var sg: float = f[2]
		var A := Vector3(-0.26 * sg, py - 0.06, pz)
		var B := Vector3(0.26 * sg, py - 0.06, pz)
		var D := Vector3(0.26 * sg, py + 0.06, pz)
		var E := Vector3(-0.26 * sg, py + 0.06, pz)
		pb.tri(A, B, D, Vector3(0, 0, sg), pc, Vector2(0, 1), Vector2(1, 1), Vector2(1, 0))
		pb.tri(A, D, E, Vector3(0, 0, sg), pc, Vector2(0, 1), Vector2(1, 0), Vector2(0, 0))
	var pam := ArrayMesh.new()
	pam.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, pb.arrays())
	pam.surface_set_material(0, _player_car_mat)
	var pmi := MeshInstance3D.new()
	pmi.mesh = pam
	pmi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	root.add_child(pmi)
	# wheels: a pivot each (front ones steer), a tyre and a rim that roll inside it
	_wheels.clear()
	_spinners.clear()
	for wz: float in [1.38, -1.38]:
		for sx: float in [-1.0, 1.0]:
			var pivot := Node3D.new()
			pivot.position = Vector3(sx * 0.8, 0.33, wz)
			root.add_child(pivot)
			var spin := Node3D.new()
			pivot.add_child(spin)
			# the same tyre and five-spoke rim as the traffic's, in the player's car shader:
			# the spokes are in the rim's own coordinates, so they turn with it
			var wm := CarMesh.new()
			_wheel(wm, Vector3.ZERO, 0.33, sx, Color(_tone["tyre"], 0.3), Color(_tone["rim"], 0.4))
			var wheel := MeshInstance3D.new()
			wheel.mesh = wm.mesh(_player_car_mat)
			spin.add_child(wheel)
			_spinners.append(spin)
			if wz > 0.0:
				_wheels.append([pivot, 0.0])
	return root

func _car_mat(k: String, paint: String) -> StandardMaterial3D:
	var key := "car_%s_%s" % [k, paint]
	if _smat.has(key):
		return _smat[key]
	var m := _surface({"paint": paint, "glass": "carglass", "trim": "cartrim", "tyre": "tyre", "rim": "rim"}[k])
	m = m.duplicate()
	match k:
		"paint":
			m.metallic = 0.45
			m.roughness = 0.28
		"glass":
			m.metallic = 0.6
			m.roughness = 0.08
		"rim":
			m.metallic = 0.7
			m.roughness = 0.3
	m.set_meta("tone", {"paint": paint, "glass": "carglass", "trim": "cartrim", "tyre": "tyre", "rim": "rim"}[k])
	_smat[key] = m
	return m

## a primitive part: BoxMesh with `size`, or CylinderMesh with (radius, height)
func _part(kind: Variant, at: Vector3, size: Vector3, m: Material) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	if kind == BoxMesh:
		var bm := BoxMesh.new()
		bm.size = size
		mi.mesh = bm
	else:
		var cm := CylinderMesh.new()
		cm.top_radius = size.x
		cm.bottom_radius = size.x
		cm.height = size.y
		cm.radial_segments = 14
		cm.rings = 1
		mi.mesh = cm
	mi.material_override = m
	mi.position = at
	return mi

## a convex polygon (in order around it), facing `out`
func _poly(buf: Buf, pts: Array, out: Vector3) -> void:
	var n: Vector3 = ((pts[1] as Vector3) - pts[0]).cross((pts[2] as Vector3) - pts[0]).normalized()
	if n.dot(out) < 0.0:
		n = -n
	for i in range(1, pts.size() - 1):
		buf.tri(pts[0], pts[i], pts[i + 1], n, Color.WHITE)

## an axis-aligned box centred at c
func _box(buf: Buf, c: Vector3, size: Vector3) -> void:
	var h := size * 0.5
	for ax in range(3):
		for sg: float in [-1.0, 1.0]:
			var n := Vector3.ZERO
			n[ax] = sg
			var u := Vector3.ZERO
			u[(ax + 1) % 3] = h[(ax + 1) % 3]
			var w := Vector3.ZERO
			w[(ax + 2) % 3] = h[(ax + 2) % 3]
			var f := c + n * h[ax]
			_poly(buf, [f - u - w, f + u - w, f + u + w, f - u + w], n)

## start at the place's `start` corner, else on a through road near the middle of town; always in
## the right-hand lane, facing the way traffic goes
func _place_start() -> void:
	_find_start()
	_cam_yaw = _yaw
	_y = 1.0e6   # (the top of whatever is there: the street, not a tunnel under it)
	_snap_pose()

## where the car starts (_pos, _yaw): the level's corner, else a main road near the middle
func _find_start() -> void:
	# a drive of the route set starts at its address (set down properly once built: _route_begin)
	if not _route.is_empty():
		_pos = Vector2(float(_route["from_at"][0]), float(_route["from_at"][1]))
		return
	# a filmed walk starts where its film does: the squares round there are built first, or
	# its first seconds walked over bare grass while the town built round somewhere else
	if _place.has("walk") and _details != null:
		var pts: Array = ((_details.data.get("walks", {}) as Dictionary).get(String(_place["walk"]), {}) as Dictionary).get("points", [])
		if pts.size() >= 2:
			_pos = Vector2(float(pts[0][1]), float(pts[0][2]))
			_yaw = (Vector2(float(pts[1][1]), float(pts[1][2])) - _pos).angle()
			return
	var spot: Array = _place.get("start", []) if _place.get("city") == _city_id else []
	if spot.size() == 2 and _start_on(spot[0], spot[1]):
		return
	var mid := _bounds.get_center()
	if not _boundary.is_empty():
		var box := Rect2((_boundary[0] as PackedVector2Array)[0], Vector2.ZERO)
		for ring: PackedVector2Array in _boundary:
			for p in ring:
				box = box.expand(p)
		mid = box.get_center()
	var best := INF
	var at := mid
	var dir := Vector2.RIGHT
	for r: Dictionary in _roads:
		if not r["drive"] or not (r["k"] in ["primary", "secondary", "tertiary"]):
			continue
		var pts: PackedVector2Array = r["pts"]
		for j in range(pts.size() - 1):
			var L := pts[j].distance_to(pts[j + 1])
			if L < 25.0:
				continue
			var c := (pts[j] + pts[j + 1]) * 0.5
			var d := c.distance_to(mid)
			if d < best:
				best = d
				dir = (pts[j + 1] - pts[j]).normalized()
				if r["o"] == -1:
					dir = -dir
				var lane := _lane_off(r)
				at = c + Vector2(-dir.y, dir.x) * lane
	_pos = at
	_yaw = dir.angle()

## put the car on `street` a few metres past where it meets `cross`; false if they never meet
func _start_on(street: String, cross: String) -> bool:
	for i in range(_nodes.size()):
		var on_street: Array = []
		var on_cross := false
		for e: Vector2i in _node_roads[i]:
			var r: Dictionary = _roads[e.x]
			if not r["drive"]:
				continue
			if r["name"] == street:
				on_street.append(e)
			elif r["name"] == cross:
				on_cross = true
		if not on_cross:
			continue
		for e: Vector2i in on_street:
			var r: Dictionary = _roads[e.x]
			var pts: PackedVector2Array = r["pts"]
			for d2: int in [1, -1]:
				var nxt := e.y + d2
				if nxt < 0 or nxt >= pts.size() or (r["o"] != 0 and r["o"] != d2):
					continue
				var dir := (pts[nxt] - pts[e.y]).normalized()
				var lane := _lane_off(r)
				var into := minf(_node_r[i] + 6.0, pts[e.y].distance_to(pts[nxt]) * 0.6)
				_pos = pts[e.y] + dir * into + Vector2(-dir.y, dir.x) * lane
				_yaw = dir.angle()
				return true
	Probe.note("start corner: %s never meets %s in %s" % [street, cross, _city_id])
	return false

## STREETS_SIM_SPEED=n (tests only; tests/run.sh sets it from SIM_SPEED): the game runs n
## times as much game time a tick. Held here every tick because the shell puts the engine's
## time scale back to 1 when a game starts and after every hit-stop (a --time-scale on the
## command line was undone before the first tick). Unset in play: nothing happens.
var _sim_speed := float(OS.get_environment("STREETS_SIM_SPEED")) if OS.get_environment("STREETS_SIM_SPEED") != "" else 0.0

func _physics_process(dt: float) -> void:
	if _sim_speed > 0.0 and Engine.time_scale != _sim_speed:
		Engine.time_scale = _sim_speed
	elif _sim_speed <= 0.0 and not _film.is_empty() and Engine.time_scale != _walk_speed:
		Engine.time_scale = _walk_speed   # (a walk's speed button: more game time a tick, not more ticks)
	_prev_pos = _pos   # where the car was at the last tick, for _frame() to blend from
	_prev_yaw = _yaw
	_prev_y = _y
	if not _loaded or finished or _picker != null:
		return   # the address picker is open: the world waits
	if _paused:   # paused (or looking from above): everything holds; the engine falls quiet
		_engine_tick(dt)
		return
	_prof_ticks += 1
	_p0()
	_signals_tick(dt)
	if _wave != null:
		_wave.tick(dt)
	if _racer != null:
		_racer.tick(dt)
	if _rails != null:
		_rails.tick(dt)
	_crash_cool = maxf(0.0, _crash_cool - dt)
	_smash_cool = maxf(0.0, _smash_cool - dt)
	_touch_t = maxf(0.0, _touch_t - dt)
	_p("lights")
	var split := dt <= WORLD_SPLIT_DT and _world_split_on
	_world_n += 1
	var every := (4 if _slow_frames else 2) if split else 1   # (a slow device: each a quarter of the ticks, _slow_watch)
	var traffic_now := _world_n % every == 0
	var people_now := _world_n % every == every / 2
	var wdt := dt * every
	_traffic_age = 0.0 if traffic_now else _traffic_age + dt
	_traffic_dt = wdt if traffic_now else _traffic_dt
	if _traffic != null:
		_traffic.ticks_per = every
	if _walking:
		if traffic_now:
			_traffic.tick(wdt)
		_p("traffic")
		if not _film.is_empty():
			_film_tick(dt)
		else:
			_walk(dt)
			_controls_tick(dt)
		_p("walk")
		_names_tick(dt)
		_p("names")
		_engine_tick(dt)
		_p("sound")
		if people_now:
			_people_tick(wdt)
		_knock_tick(dt)
		_p("people")
		if people_now:
			_crossers_tick(wdt)
		if not _film.is_empty():
			_film_on_zebras()
		_p("crossers")
		_explore(dt)
		_p("explore")
		_log.tick(self, dt)
		return
	if _watching():
		pass   # (autodrive is the scenario's or the route's to switch)
	elif PInput.just_pressed("action_a") and not _auto:
		_set_auto(true)
	elif PInput.just_pressed("action_b") and _auto:
		_set_auto(false)
	if traffic_now:
		_traffic.tick(wdt)
	_p("traffic")
	var ctl: Array = _autodrive(dt) if _auto else (_manual(dt) if not _watching() else [0.0, 1.0, 0.0])   # (watched: held on the brake)
	if _auto:
		var turn := _ap_turn_ahead()
		if turn != 0 and _blink != turn:
			_set_blink(turn)
	_p("autodrive")
	_controls_tick(dt)
	_drive(dt, ctl[0], ctl[1], ctl[2])
	_p("car")
	_through_lights()
	_drop_crumb()
	_check_stop_signs()
	_p("rules")
	_names_tick(dt)
	_p("names")
	_engine_tick(dt)
	_p("sound")
	if people_now:
		_people_tick(wdt)
	_knock_tick(dt)
	_p("people")
	if people_now:
		_crossers_tick(wdt)
	_p("crossers")
	_check_arrival(dt)
	_explore(dt)
	_p("explore")
	_log.tick(self, dt)
	_p("log")

## ---- traffic and people, taking turns ---------------------------------------------------
## The car is ticked 60 times a second; the traffic and the people each every other tick, with
## twice the time, on alternate ticks -- so no tick pays for both. Their thinking was most of
## the script's frame on a PC in a browser (Tel Aviv: traffic 3.6 + 1.0 following, people 3.4
## of a 34 ms frame, two ticks a frame). Only at the real rate: a test run faster
## (STREETS_SIM_SPEED, its ticks already longer than WORLD_SPLIT_DT) ticks them every tick as
## before. The traffic is drawn between its own last two ticks (`_traffic_f`), a tick behind
## the car rather than guessed ahead; the people are placed as they tick.
const WORLD_SPLIT_DT := 1.0 / 40.0
## STREETS_WORLD_SPLIT=0 (tests): every tick for both, as before, to set the two side by side
var _world_split_on := OS.get_environment("STREETS_WORLD_SPLIT") != "0"

## A device whose frames stay slow (a phone in a browser: 60-90 ms, 4-5 physics ticks a frame,
## each paying for traffic and people -- PERF.md "A phone") ticks traffic and people every
## 4th tick with four times the time instead of every 2nd, and builds the squares round the
## car at half the hurry (CATCH_UP_US / 2: the catch-up was 16-21 ms of every phone frame).
## On when the frame time, smoothed, passes SLOW_ON; off again under SLOW_OFF. The car, the
## camera and autodrive still tick every tick. STREETS_SLOW=1/0 forces it (tests).
const SLOW_ON := 0.040
const SLOW_OFF := 0.028
var _slow_frames := OS.get_environment("STREETS_SLOW") == "1"
var _slow_ema := 1.0 / 60.0

func _slow_watch(dt: float) -> void:
	var forced := OS.get_environment("STREETS_SLOW")
	if forced != "":
		return
	_slow_ema = lerpf(_slow_ema, minf(dt, 0.25), 0.03)   # (~half a second to follow; one freeze barely moves it)
	if not _slow_frames and _slow_ema > SLOW_ON:
		_slow_frames = true
		print("[streets] slow frames (%.0f ms): traffic and people every 4th tick" % (_slow_ema * 1000.0))
		Probe.event("slow_frames", {"on": true, "ms": int(_slow_ema * 1000.0)})
	elif _slow_frames and _slow_ema < SLOW_OFF:
		_slow_frames = false
		Probe.event("slow_frames", {"on": false, "ms": int(_slow_ema * 1000.0)})
var _world_n := 0
var _traffic_age := 0.0              ## s since the traffic last ticked (0 or one tick)
var _traffic_dt := 1.0 / 60.0        ## the time its last tick covered

## where between its last two ticks to draw the traffic, for this frame's blend f between the
## car's last two ticks
func _traffic_f(f: float) -> float:
	var dt := 1.0 / float(Engine.physics_ticks_per_second)
	return clampf((f * dt + _traffic_age) / maxf(_traffic_dt, 0.001), 0.0, 1.0)

## ---- every drawn frame -------------------------------------------------------------------
## The car moves in fixed physics ticks (60 a second). Drawn as it was at the last tick,
## a screen that draws 75 or 144 times a second, or a browser that misses some, shows it
## (and the camera tied to it) stepping unevenly: choppy even at a good frame rate. So the
## car and camera are drawn where the car is BETWEEN the last two ticks, every frame.

var _prev_pos := Vector2.ZERO
var _prev_yaw := 0.0
var _view_pos := Vector2.ZERO        ## where the car is drawn this frame (the minimap too)
var _view_yaw := 0.0

func _frame() -> void:
	_prof_frame()
	if not _loaded or _car == null or _picker != null:
		return
	_p0()
	var dt := get_process_delta_time()
	if _bg_wait:   # the city still building round you: its few milliseconds (_pause)
		_bg_wait = false
		_build_us = (CATCH_UP_US / 2 if _slow_frames else CATCH_UP_US) if _catch_up else (BUILD_US if dt < 0.022 else BUILD_US / 2)
		if not _catch_up and not _paused and _zoom_v <= 0.0 and _all_seen_built():
			_build_us = BUILD_FAR_US
		_build_tick.emit()
		_p("building")
	_slow_watch(dt)
	_watch_fps(dt)
	_reach_update()
	_hold_tick(dt)
	if _standins != null:
		_standins.show(_zoomed())
	if _opening != null and _opening.on:
		_opening.tick(dt)
	if _scenario != null:
		_scenario.tick(dt)
	if _ppl != null:   # (where you are, for people to glance at: your head walking, the car's windows driving)
		_ppl.me_at(Vector3(_pos.x, _h(_pos) + (1.55 if _walking else 1.15), _pos.y))
	if _blades != null:
		_turbines_tick()
	var f := Engine.get_physics_interpolation_fraction()
	_view_pos = _prev_pos.lerp(_pos, f)
	_view_yaw = lerp_angle(_prev_yaw, _yaw, f)
	_view_y = lerpf(_prev_y, _y, f)
	if _walking:
		_pose_car(_car_at, _car_yaw_at, _car_y_at)
		_me.position = Vector3(_view_pos.x, _view_y, _view_pos.y)
		_me.face(Vector3(cos(_view_yaw), 0, sin(_view_yaw)))
		_traffic.draw(1.0 if _paused else _traffic_f(f))
		_p("traffic draw")
		_foot_camera(dt)
		_zoom_camera(dt)
		_sky_follow()
		_tick_hud()
		_p("camera, hud")
		return
	_pose_car(_view_pos, _view_yaw, _view_y)
	_traffic.draw(1.0 if _paused else _traffic_f(f))   # (held: where the cars stand, not between two ticks)
	_p("traffic draw")
	_head_tick(dt)
	_camera(dt, _view_pos, _view_yaw)
	_zoom_camera(dt)
	_sky_follow()
	_tick_hud()
	_p("camera, hud")

## ---- render quality: the web build watches its own frame rate and steps down ---------------
## Per level: edge smoothing (MSAA), how far shadows reach, the 3D resolution.
## Every level keeps the sun's shadows, the lowest only near the car: switching them off made
## the browser compile every material's shader again (with the sun's shadows on or off they are
## different shaders), a freeze of seconds on each step between levels 1 and 0 -- and the
## ladder steps back up when the frame rate recovers, and down again. A user saw 3.2 s.
## The last two: how far things are drawn (every draw range of REACH_FROM m or more, scaled) and
## how thick the haze is (so the town ends in it, not at an edge) -- see "a weak machine's
## levels" below. Levels 2 and 3 draw everything as built.
const QUALITY := [
	[Viewport.MSAA_DISABLED, 25.0, 0.7, REACH_0, 1.0 / REACH_0],
	[Viewport.MSAA_DISABLED, 45.0, 0.85, REACH_1, 1.0 / REACH_1],
	[Viewport.MSAA_2X, 60.0, 1.0, 1.0, 1.0],
	[Viewport.MSAA_4X, 75.0, 1.0, 1.0, 1.0],
]
const QUALITY_WEB := 2               ## where a browser starts
## A step down: two 2-second spells in a row under FPS_LOW, or with more than STUTTER of their
## frames slower than 33 ms. A step back up: STEP_UP_S seconds at the display's own rate
## (FPS_FULL) -- unless that level failed lately: then not before its wait is up, a wait
## that doubles each time it fails again. Hitches (frames over HITCH_S: loading, a shader
## compiling) are left out of the reckoning: one half-second stall in a spell made a
## smooth 50 fps read as 38, and a PC stepped itself down to nothing and stayed there.
## Each step down is measured over its first two spells, and where the stepping ends (the
## rate good again, or the bottom) the ladder settles on the best-looking level it passed whose
## rate was within STEP_GAIN of the best: when the steps bought nothing, what holds the frame
## back is not what the levels change (the script on a phone's one thread, the triangles), so
## back up -- the better look at the same rate -- and no step below that level for FLOOR_S.
## A user's PC in Tel Aviv (a browser) sat at quality 0 (plain walls, a blurred picture) at 25-27 fps,
## waiting in traffic as much as driving, and never came back up.
const STEP_GAIN := 1.12
const FLOOR_S := 300.0
const FPS_LOW := 45.0
const FPS_FULL := 56.0
## (Unused since 22 Nov, "same rule for all": a walk had a gentler ladder -- a step down only
## under 28 fps, back up at 40 -- for "the highest possible quality in the view of the walk".)
const FPS_LOW_WALK := 28.0
const FPS_FULL_WALK := 40.0
const STUTTER := 0.1
const HITCH_S := 0.25
const STEP_UP_S := 8.0
var _quality := 3
var _shadow_web := false
var _fps_t := 0.0
var _fps_frames := 0
var _fps_long := 0                   ## frames over 33 ms in this spell: stutter, not just slow
var _fps_low := 0
var _fps_good := 0.0                 ## seconds at the full rate at this level
var _fps_wait := 6.0                 ## the first seconds compile shaders and stutter anyway
var _q_retry_at := {}                ## level -> when it may be tried again (s), after it failed
var _q_fails := {}                   ## level -> how often it has failed
var _q_clock := 0.0
var _q_descent := {}                 ## level -> its frame rate, while stepping down (and the level it began at)
var _q_trial: Array = []             ## the frame rates since the last step down, while it is measured
var _q_on_trial := false
var _q_floor := 0                    ## no step below this level ...
var _q_floor_until := 0.0            ## ... until then (s, _q_clock): lower bought nothing

## "--quality-walk=S" among the user args (tests/web_shaders.js QWALK=S): the ladder held off,
## and every S seconds after the warm-up the quality set to the next of QWALK_LEVELS, each
## step printed -- to count what a step costs a browser (the programs it compiles). A work
## laptop's first drive with the ladder working froze 13.7 s once, 107 programs compiled after
## the car (22 Nov): a step that changes every material's shader would do that.
const QWALK_LEVELS := [1, 0, 1, 2, 3, 2]
var _qwalk := float(_user_arg("--quality-walk=")) if _user_arg("--quality-walk=") != "" else 0.0

static func _user_arg(prefix: String) -> String:
	for a: String in OS.get_cmdline_user_args():
		if a.begins_with(prefix):
			return a.substr(prefix.length())
	return ""

func _quality_walk() -> void:
	# (by the clock, not a game timer: a frame advances game time at most 8 ticks, 0.13 s, and
	# the container's software renderer takes ~2.5 s a frame -- 25 s of timer was 8 minutes)
	for q: int in QWALK_LEVELS:
		var at := Time.get_ticks_msec() + int(_qwalk * 1000.0)
		while Time.get_ticks_msec() < at:
			await get_tree().process_frame
			if not is_inside_tree():
				return
		print("[streets] quality walk: to %d" % q)
		_set_quality(q)

func _set_quality(q: int) -> void:
	if OS.has_feature("web") and not _shadow_web:
		# a 2048 map is plenty over 60 m, and a cheap filter: the 4096 default and its soft
		# filter cost a laptop's graphics chip more than the shadows are worth
		_shadow_web = true
		RenderingServer.directional_shadow_atlas_set_size(2048, true)
		RenderingServer.directional_soft_shadow_filter_set_quality(RenderingServer.SHADOW_QUALITY_SOFT_VERY_LOW)
	_quality = clampi(q, 0, QUALITY.size() - 1)
	var row: Array = QUALITY[_quality]
	view.msaa_3d = row[0]
	_set_textured(_quality > 0)
	_tree_quality()
	sun.shadow_enabled = float(row[1]) > 0.0
	sun.directional_shadow_max_distance = maxf(float(row[1]), 1.0) if not _night else 1.0   # (the moon's: none to speak of, _set_night)
	view.scaling_3d_scale = row[2]
	_reach_set(float(row[3]))
	_fog_k = float(row[4])
	if env != null and _zoom_v <= 0.0:
		env.fog_density = _fog_night() if _night else _fog_day()
	_set_blobs(not sun.shadow_enabled)
	_far_update()
	_grass_quality()

## ---- a weak machine's levels: less of the town drawn ----------------------------------------
## A browser pays CPU for every draw call and every object in view -- WebGL's checks, ANGLE's
## Direct3D on Windows, Godot's own work in wasm: a work laptop paid ~0.1 ms a draw, 70-120 ms
## of 600-820 draws a frame (22 Nov 2026), and the levels then changed only pixels and shadow
## reach, which bought it nothing. Levels 1 and 0 also scale every draw range of REACH_FROM m or
## more (where a thing stops being drawn, and where a far version takes over, alike), with the
## haze thickened by as much so the town fades out where it ends. Ranges and a haze number
## only -- never a material's feature, so a step compiles no shader (tests/web_shaders.js
## QWALK). People, signs and posts (ranges under REACH_FROM) are left as they are.
## Nothing is gathered until a level below 2 is first asked for; from then on what the
## background build adds is caught by world's child count, as _zoom_far does.
const REACH_FROM := 150.0
const REACH_1 := 0.75
const REACH_0 := 0.5
var _reach := 1.0
var _reach_on := false               ## the ranges gathered (a level below 2 was asked for)
var _reach_list: Array = []          ## GeometryInstance3D with a range of REACH_FROM or more (own ranges in meta)
var _reach_n := 0                    ## world's children looked at

func _reach_set(k: float) -> void:
	if k == _reach and (_reach_on or k == 1.0):
		return
	_reach = k
	if not _reach_on:
		_reach_on = true
		_reach_n = 0
	_reach_update()
	_reach_apply()

## everything gathered, at this level's reach (a full pass: a step, or landing from above)
func _reach_apply() -> void:
	if not _reach_on or _zoom_ranges_n >= 0:
		return
	for gi: GeometryInstance3D in _reach_list:
		if is_instance_valid(gi):
			_reach_one(gi)

func _reach_one(gi: GeometryInstance3D) -> void:
	var e0: float = gi.get_meta("r_end")
	gi.visibility_range_end = e0 * _reach if e0 >= REACH_FROM else e0
	var b0: float = gi.get_meta("r_begin")
	gi.visibility_range_begin = b0 * _reach if b0 >= REACH_FROM else b0

## what world gained since the last look: each thing's own ranges kept, and this level's given
func _reach_update() -> void:
	if not _reach_on or _zoom_ranges_n >= 0 or world == null:
		return   # (from above, _zoom_far has the ranges; landing calls _reach_apply)
	var n := world.get_child_count()
	if n == _reach_n:
		return
	if n < _reach_n:   # something taken out: look through it all again (ranges kept in meta)
		_reach_n = 0
		_reach_list = _reach_list.filter(func(x): return is_instance_valid(x))
	for i in range(_reach_n, n):
		var c := world.get_child(i)
		var list: Array = c.find_children("*", "GeometryInstance3D", true, false)
		list.append(c)
		for gi in list:
			if not (gi is GeometryInstance3D) or (gi as Node).has_meta("r_end"):
				continue
			var g3 := gi as GeometryInstance3D
			g3.set_meta("r_end", g3.visibility_range_end)
			g3.set_meta("r_begin", g3.visibility_range_begin)
			if g3.visibility_range_end >= REACH_FROM or g3.visibility_range_begin >= REACH_FROM:
				_reach_list.append(g3)
				if _reach != 1.0:
					_reach_one(g3)
	_reach_n = n

## Only on the web: a desktop build has a real GPU, and test runs on a software renderer
## would step themselves down to nothing.
var _ladder_native := false           ## tests: the ladder on a native build too (tests/quality_ladder.gd)
func _watch_fps(dt: float) -> void:
	if not OS.has_feature("web") and not _ladder_native:
		return
	if (_bg_build and _catch_up) or _zoom_v > 0.0:   # the squares round you still going up (their
		# CATCH_UP_US a frame), or the whole city in view from above, is not this machine being
		# slow. The rest of the background build is a few ms a frame (BUILD_US) and was left out
		# too -- but it goes on for minutes, and on a slow machine for most of an hour: a work
		# laptop (Intel graphics, a browser, 22 Nov) stood at "building the city 8%" five minutes
		# in, at 7 fps, still at quality 2 -- the ladder had never been asked.
		_fps_t = 0.0
		_fps_frames = 0
		_fps_long = 0
		return
	_judge_fps(dt)

func _judge_fps(dt: float) -> void:
	if _qwalk > 0.0:
		return   # (a quality walk sets the levels itself)
	_q_clock += dt
	if _fps_wait > 0.0:
		_fps_wait -= dt
		return
	if dt > HITCH_S:
		return   # a hitch: not the frame rate
	_fps_t += dt
	_fps_frames += 1
	var walk := false   # (a walk once had its own, gentler ladder, FPS_LOW_WALK; now the same rule for all)
	if dt > (0.05 if walk else 0.033):
		_fps_long += 1
	if _fps_t < 2.0:
		return
	var fps := _fps_frames / _fps_t
	var stutter := float(_fps_long) / maxf(_fps_frames, 1)
	_fps_t = 0.0
	_fps_frames = 0
	_fps_long = 0
	var low := fps < (FPS_LOW_WALK if walk else FPS_LOW) or stutter > STUTTER
	var floor := _q_floor if _q_clock < _q_floor_until else 0
	if _q_on_trial:   # the last step down, measured
		_q_trial.append(fps)
		if _q_trial.size() >= 2:
			_q_on_trial = false
			_q_descent[_quality] = (float(_q_trial[0]) + float(_q_trial[1])) / 2.0
			if not (low and _fps_low + 1 >= 2 and _quality > floor) and _settle():
				return   # (the stepping ends here, and a higher level does as well)
	if low:
		_fps_good = 0.0
		_fps_low += 1
		if _fps_low >= 2 and _quality > floor:
			_fps_low = 0
			var failed := _quality
			_q_fails[failed] = int(_q_fails.get(failed, 0)) + 1
			_q_retry_at[failed] = _q_clock + minf(30.0 * pow(2.0, float(_q_fails[failed]) - 1.0), 300.0)
			if not _q_descent.has(failed):
				_q_descent[failed] = fps
			_q_trial = []
			_q_on_trial = true
			_set_quality(_quality - 1)
			_q_note("%d to %d at %.1f fps" % [failed, _quality, fps])
			_fps_wait = 3.0   # (new shaders compile)
			Probe.event("quality", {"level": _quality, "fps": int(fps), "down": true})
		_log.event("quality", _quality)
		return
	_fps_low = 0
	if fps < (FPS_FULL_WALK if walk else FPS_FULL) or stutter > 0.03:
		_fps_good = 0.0
		return
	_fps_good += 2.0
	var up := _quality + 1
	if up < QUALITY.size() and _fps_good >= STEP_UP_S and _q_clock >= float(_q_retry_at.get(up, 0.0)):
		_fps_good = 0.0
		_q_descent = {}
		_set_quality(up)
		_q_note("up to %d at %.1f fps" % [_quality, fps])
		_fps_wait = 3.0
		Probe.event("quality", {"level": _quality, "fps": int(fps), "down": false})

## what the ladder did lately, for the perf view: one screenshot tells whether the levels help
## this machine (a work laptop's two, 22 Nov: one at 0, one back at 2 -- and no saying why)
var _q_log: Array = []

func _q_note(what: String) -> void:
	_q_log.push_back("%d s %s" % [Time.get_ticks_msec() / 1000, what])
	if _q_log.size() > 4:
		_q_log.pop_front()

## The stepping down has ended (the rate good again, or the bottom): of the levels it passed,
## the best-looking one whose rate was within STEP_GAIN of the best. Back up to it, and no step
## below it for FLOOR_S, when that is not where the stepping ended. True if it moved.
func _settle() -> bool:
	var best := 0.0
	for l: int in _q_descent:
		best = maxf(best, float(_q_descent[l]))
	var pick := _quality
	for l: int in _q_descent:
		if l > pick and float(_q_descent[l]) * STEP_GAIN >= best:
			pick = l
	var seen := _q_descent
	_q_descent = {}
	if pick == _quality:
		return false
	_q_floor = pick
	_q_floor_until = _q_clock + FLOOR_S
	_q_fails.erase(pick)
	_q_retry_at.erase(pick)
	var was := _quality
	_set_quality(pick)
	var rates: Array = []
	for l: int in [3, 2, 1, 0]:
		if seen.has(l):
			rates.append("%d: %.1f" % [l, float(seen[l])])
	_q_note("back to %d, lower bought nothing (fps %s)" % [pick, ", ".join(rates)])
	_fps_low = 0
	_fps_good = 0.0
	_fps_wait = 3.0
	print("[streets] quality: lower levels bought nothing (%s fps by level), back from %d to %d" % [
		str(seen), was, pick])
	Probe.event("quality", {"level": _quality, "fps": int(seen[pick]), "down": false, "back": true})
	_log.event("quality", _quality)
	return true

## ---- where a frame's time goes ------------------------------------------------------------
## Every part of a physics tick and of a drawn frame is timed (the script's own work, in
## microseconds). The time from one drawn frame to the next that no part accounts for is
## the engine's: drawing the 3D, the shadows, the browser. A frame much slower than the ones
## round it is a hitch: the parts that took its time are kept (the perf view, P or a tap on
## the fps text, shows them with a graph of the last frames) and reported as a "hitch" event
## and a [hitch] line, so a playtest names what chokes.
const PERF_FRAMES := 150
const PERF_RECT := Rect2(486, 74, 146, 20)   ## the fps text: tap it for the perf view
const PERF_GRAPH := Rect2(8, 96, 150, 30)    ## the perf view's frame times, as bars
var _prof := {}                      ## part -> microseconds since the last drawn frame began
var _prof_t := 0
var _frame_at := 0
var _frame_ms := PackedFloat32Array()   ## the last frames' times, ms, oldest overwritten first
var _frame_i := 0
var _hitches: Array = []             ## newest first, a few: "12.3 s  95 ms  people 61 · rest 30"
var _hitch_n := 0
var _prof_sum := {}                  ## part -> microseconds over the current 2 s spell
var _prof_n := 0                     ## frames in it
var _prof_wall := 0.0                ## their total time, ms
var _prof_spell := 0
var _prof_avg := ""                  ## the last spell's average frame, part by part
var _prof_ticks := 0                 ## physics ticks in the current spell (a slow frame runs several)
var _perf_view := false
## "--perf-log" among the command line's user args (a test in a browser): each 2 s spell's frame
## rate and its average frame, part by part, printed
var _perf_log := OS.get_cmdline_user_args().has("--perf-log")
var _perf_lbl: Label

func _p0() -> void:
	_prof_t = Time.get_ticks_usec()

## the part that just finished: its time goes to `part`, and the next part starts now
func _p(part: String) -> void:
	var t := Time.get_ticks_usec()
	_prof[part] = int(_prof.get(part, 0)) + (t - _prof_t)
	_prof_t = t

## at the start of every drawn frame: the one before is done (its drawing, then this frame's
## physics ticks), so its time and its parts are complete
func _prof_frame() -> void:
	var now := Time.get_ticks_usec()
	if _frame_at == 0:
		_frame_at = now
		_prof = {}
		return
	var ms := (now - _frame_at) / 1000.0
	_frame_at = now
	if _frame_ms.size() < PERF_FRAMES:
		_frame_ms.append(ms)
	else:
		_frame_ms[_frame_i] = ms
		_frame_i = (_frame_i + 1) % PERF_FRAMES
	if ms > 25.0 and _frame_ms.size() > 30:
		var sorted := _frame_ms.duplicate()
		sorted.sort()
		var typical := sorted[sorted.size() / 2]
		if ms > maxf(25.0, typical * 2.0 + 8.0):
			_hitch(ms, typical)
	# the average frame over a 2 s spell, part by part: what it costs all the time, not in spikes
	for k: String in _prof:
		_prof_sum[k] = int(_prof_sum.get(k, 0)) + int(_prof[k])
	_prof_n += 1
	_prof_wall += ms
	if now - _prof_spell > 2000000 and _prof_n > 0:
		var parts: Array = []
		var script_ms := 0.0
		for k: String in _prof_sum:
			var pm := float(_prof_sum[k]) / 1000.0 / _prof_n
			if not ":" in k:
				script_ms += pm
			parts.append([pm, k])
		parts.sort_custom(func(a: Array, b: Array) -> bool: return a[0] > b[0])
		var words: Array = []
		for i in range(mini(5, parts.size())):
			words.append("%s %.1f" % [parts[i][1], float(parts[i][0])])
		_prof_avg = "average %.1f ms: drawing and engine %.1f · script %.1f in %.1f ticks (%s)" % [_prof_wall / _prof_n,
			_prof_wall / _prof_n - script_ms, script_ms, float(_prof_ticks) / _prof_n, ", ".join(words)]
		_prof_ticks = 0
		if _perf_log:
			print("[perf] quality %d, %.1f fps%s; %s; %s" % [_quality, 1000.0 * _prof_n / maxf(_prof_wall, 1.0),
				" (the city still building)" if _bg_build else "", _prof_avg, _gpu_line()])
		_prof_sum = {}
		_prof_n = 0
		_prof_wall = 0.0
		_prof_spell = now
	_prof = {}

func _hitch(ms: float, typical: float) -> void:
	var parts: Array = []
	var script_ms := 0.0
	for k: String in _prof:
		var pm := float(_prof[k]) / 1000.0
		if not ":" in k:   # "traffic: route" is already inside "traffic"
			script_ms += pm
		parts.append([pm, k])
	parts.sort_custom(func(a: Array, b: Array) -> bool: return a[0] > b[0])
	var words: Array = []
	for i in range(mini(5, parts.size())):
		if float(parts[i][0]) >= 1.0:
			var part: String = parts[i][1]
			if part == "building" and _bstep_slow != "":   # which step of a square ran long (_pause)
				part = "building (%s)" % _bstep_slow
			words.append("%s %d" % [part, int(round(float(parts[i][0])))])
	words.append("rest %d" % int(round(ms - script_ms)))
	_bstep_slow = ""
	_bstep_slow_us = 0
	var line := "%.1f s  %d ms (usual %d)  %s" % [Time.get_ticks_msec() / 1000.0, int(ms), int(typical), " · ".join(words)]
	_hitches.push_front(line)
	if _hitches.size() > 4:
		_hitches.pop_back()
	_hitch_n += 1
	print("[hitch] ", line)
	if _hitch_n <= 40:
		Probe.event("hitch", {"ms": int(ms), "usual": int(typical), "parts": " · ".join(words),
			"nodes": int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT))})

## the slowest of the last frames (ms)
func _worst_ms() -> float:
	var w := 0.0
	for v in _frame_ms:
		w = maxf(w, v)
	return w

## after a jump (the start, "back on the road"): no blending from where it was, camera
## straight behind
func _snap_pose() -> void:
	_air = false
	_y = _decks.surf(_pos, _y)
	_vy = 0.0
	_spin = 0.0
	_ground_was = _y
	_prev_y = _y
	_view_y = _y
	_prev_pos = _pos
	_prev_yaw = _yaw
	_view_pos = _pos
	_view_yaw = _yaw
	_cam_yaw = _yaw
	_place_car(0.016)
	_camera(1.0, _pos, _yaw)

## keys and touch -> [throttle, brake, wheel angle]. Down brakes, and once stopped, holding
## it selects reverse; then down drives backwards and up brakes, like a real automatic.
func _manual(dt: float) -> Array:
	var steer_t := PInput.axis("move_left", "move_right")
	var up := 1.0 if PInput.pressed("move_up") else 0.0
	var down := 1.0 if PInput.pressed("move_down") else 0.0
	if _stick_id >= 0:
		# the touch stick is analog: a little off centre is a little gas or a little lock,
		# and steering is eased near the middle so small corrections stay small
		var k := _stick
		up = maxf(up, _dead(-k.y))
		down = maxf(down, _dead(k.y))
		var sx := _dead(absf(k.x))
		_steer_in = signf(k.x) * pow(sx, 1.4)
	else:
		var rate := STEER_RATE if absf(steer_t) > 0.0 and signf(steer_t) == signf(_steer_in) else STEER_RATE * 1.8
		_steer_in = move_toward(_steer_in, steer_t, rate * dt)
	var lock := MAX_STEER / (1.0 + pow(absf(_v) / STEER_V, 2.0))
	var steer := _steer_in * lock
	if _assist and _v > 1.5:
		steer += _assist_steer() * clampf(1.0 - absf(_steer_in) / ASSIST_FADE, 0.0, 1.0)
	var throttle := 0.0
	var brake := 0.0
	if _gear > 0:
		throttle = up
		brake = down
		if down > 0.0 and up == 0.0 and _v < 0.4:
			_rev_hold += dt
			# nose against something: straight into reverse, no waiting
			if _rev_hold > (0.06 if _touch_t > 0.0 else 0.3):
				_gear = -1
				Probe.event("reverse")
		else:
			_rev_hold = 0.0
	else:
		throttle = down
		brake = up
		if up > 0.0 and down == 0.0 and _v > -0.4:
			_gear = 1
	if _assist and _gear > 0 and _v > 2.0 and _blocked_ahead():
		throttle = 0.0
		brake = maxf(brake, clampf((_v - 1.0) / 7.0, 0.35, 1.0))
	# stuck: a pedal down against something and the car getting nowhere -- nose in a
	# corner, wedged on a tree, rocking between two parked cars. With or without the assist:
	# nobody wants to sit there.
	# Not a jump back to the road at once (it was, after 1.2 s: the car popped out of where
	# you had driven it, which broke the drive): the way out is the way in, in reverse. Only
	# wedged both ways -- pushed forward and backward and gone nowhere -- is it lifted out.
	if up + down > 0.5 and _touch_t > 0.0:
		_pinned_t += dt
		if down > up:
			_pinned_back += dt
		if _pos.distance_to(_pin_at) > 1.2:   # backing out (or sliding off) is working
			_pin_at = _pos
			_pinned_t = 0.0
			_pinned_back = 0.0
		elif _pinned_t > RESCUE_AFTER and _pinned_back < 1.0 and not _pin_hinted:
			_pin_hinted = true
			_show_banner("stuck -- back up to get out" if not _touch_seen else "stuck -- pull the stick down to back out", 2.5)
		elif _pinned_back > 2.5 and _pinned_t > 5.0:
			_rescue()
			_pinned_back = 0.0
	else:
		_pinned_t = 0.0
		_pinned_back = 0.0
		_pin_hinted = false
		_pin_at = _pos
	return [throttle, brake, steer]

## the assist's nudge: toward the street's direction and the middle of its lane, while
## the car is roughly following the street (not crossing it or turning off it)
func _assist_steer() -> float:
	var hit := _nearest_seg(_pos, 12.0, true, true, _y)
	if hit.is_empty():
		return 0.0
	var r: Dictionary = _roads[hit["road"]]
	var pts: PackedVector2Array = r["pts"]
	var sj: int = hit["seg"]
	var d := (pts[sj + 1] - pts[sj]).normalized()
	var fwd := _fwd()
	if d.dot(fwd) < 0.0:
		d = -d
	var err := fwd.angle_to(d)
	if absf(err) > 0.6:
		return 0.0
	var right := Vector2(-d.y, d.x)
	var lat := (_pos - (hit["q"] as Vector2)).dot(right)
	var off := lat - _nearest_lane(r, lat)   # (the lane it is in, of several)
	return clampf(err * ASSIST_ALIGN - off * ASSIST_LANE, -ASSIST_MAX, ASSIST_MAX)

## something solid where the car will be in about half a second
func _blocked_ahead() -> bool:
	var fwd := _fwd()
	for k: float in [0.6, 1.0]:
		var p := _pos + fwd * (CAR_LEN * 0.5 + 0.8 + _v * 0.45 * k) + Vector2(-fwd.y, fwd.x) * _steer * 3.0 * k
		if _push_out(p, 0.6, true, true, _y) != Vector2.ZERO and not _light_thing(_last_hit):
			return true
		if _steep_push(p, 0.6, _y) != Vector2.ZERO:
			return true
	return false

## back into the nearest lane, facing along the street the way the car was facing
func _rescue() -> void:
	_pinned_t = 0.0
	if _land_on_road(_pos, 80.0, _fwd()):
		_show_banner("back on the road", 1.4)
		Probe.event("rescue")

## put the car down, stopped, in the right-hand lane of the street nearest `near` (within
## `reach`), clear of parked cars and trees; facing `prefer` where the street allows,
## else (prefer = zero) the way that has `near` on the kerb side. False if no street.
func _land_on_road(near: Vector2, reach: float, prefer: Vector2) -> bool:
	# at the car's own height only near the car (on a bridge, the road on it, not the one under
	# it); elsewhere the ground's there. A route's start up the test town's hill went by the car's
	# height in the valley: the street 32 m from the address was skipped for one 107 m off.
	var hit := _nearest_seg(near, reach, true, true, _y) if near.distance_to(_pos) < 40.0 else {}
	if hit.is_empty():
		hit = _nearest_seg(near, reach, true, true)
	if hit.is_empty():
		return false
	var r: Dictionary = _roads[hit["road"]]
	var pts: PackedVector2Array = r["pts"]
	var sj: int = hit["seg"]
	var d := (pts[sj + 1] - pts[sj]).normalized()
	if r["o"] != 0:
		d *= float(r["o"])
	elif prefer != Vector2.ZERO:
		if d.dot(prefer) < 0.0:
			d = -d
	elif (near - (hit["q"] as Vector2)).dot(Vector2(-d.y, d.x)) < 0.0:
		d = -d   # the address on the right, the kerb side
	var lane := _lane_off(r)
	var at := (hit["q"] as Vector2) + Vector2(-d.y, d.x) * lane
	# not on top of a parked car or a tree: a little along the street until both ends of
	# the car are clear
	for s: float in [0.0, 5.0, -5.0, 10.0, -10.0, 15.0, -15.0, 20.0]:
		var p := at + d * s
		var py := _decks.deck_y(int(hit["road"]), p) if r.has("ys") else _h(p)
		if _push_out(p + d * CAR_OFF, CAR_R, true, true, py) == Vector2.ZERO \
				and _push_out(p - d * CAR_OFF, CAR_R, true, true, py) == Vector2.ZERO:
			at = p
			break
	_pos = at
	_yaw = d.angle()
	_v = 0.0
	_v_lat = 0.0
	_yaw_rate = 0.0
	_gear = 1
	_steer_in = 0.0
	_pin_at = _pos
	_y = _decks.deck_y(int(hit["road"]), at) if r.has("ys") else _h(at)
	# somewhere new: no junction with lights just driven through (kept for 120 m driven, it
	# made a car put down by the one it had last crossed drive through its red, uncounted --
	# tests/amber.gd going round the same light again)
	_light_site = -1
	_light_odo = -1000.0
	_trail = PackedVector2Array()
	_snap_pose()
	return true

## 0 inside the dead zone, then 0..1 to the rim
func _dead(v: float) -> float:
	return clampf((v - STICK_DEAD) / (1.0 - STICK_DEAD), 0.0, 1.0)

func _drive(dt: float, throttle: float, brake: float, steer: float) -> void:
	_steer = steer
	_throttle_in = throttle
	var v := _v
	var f := 0.0
	if _air:
		throttle = 0.0   # wheels in the air: the engine just revs
		brake = 0.0
	if _gear > 0:
		f = throttle * minf(ENGINE_F, POWER / maxf(absf(v), 0.1))
	elif v > -REVERSE_MAX:
		f = -throttle * REVERSE_F
	var resist := DRAG * v * absf(v) + ROLL * signf(v)
	if throttle <= 0.01:
		resist += ENGINE_BRAKE * signf(v)
	if _hnx > 0 and not _air:   # gravity along the road: uphill slows you, downhill pulls
		var fwd0 := _fwd()
		_slope = atan2(_decks.surf(_pos + fwd0 * 1.4, _y) - _decks.surf(_pos - fwd0 * 1.4, _y), 2.8)
		resist += MASS * 9.81 * sin(_slope)
	var nv := v + (f - resist) / MASS * dt
	if v != 0.0 and signf(nv) != signf(v) and throttle <= 0.01:
		nv = 0.0   # resistance stops you; it never pushes you backwards
	if throttle <= 0.01 and absf(nv) < 0.3 and absf(_slope) < 0.14:
		nv = 0.0   # stopped on a gentle slope: the car holds (an automatic on the brake)
	nv = move_toward(nv, 0.0, brake * BRAKE_F / MASS * dt)
	_a_long = (nv - v) / dt
	_v = nv
	_odo += absf(_v) * dt
	# bicycle model turning about the rear axle, capped by what the tyres can hold
	var want := _v * tan(_steer) / WHEELBASE
	var cap := GRIP / maxf(absf(_v), 1.0)
	want = clampf(want, -cap, cap)
	if not _air:   # no steering in the air: it keeps the turn it took off with
		_yaw_rate = lerpf(_yaw_rate, want, 1.0 - exp(-dt * 10.0))
	_spin *= exp(-dt * 2.2)
	_yaw = wrapf(_yaw + (_yaw_rate + _spin) * dt, -PI, PI)
	_v_lat *= exp(-dt * 5.0)
	var fwd := _fwd()
	var right := Vector2(-fwd.y, fwd.x)
	_pos += (fwd * _v + right * (_v_lat + _yaw_rate * WHEELBASE * 0.5)) * dt
	_collide()
	_keep_inside(CAR_R, true)
	_fly(dt)
	_median_tick(dt)
	_cover_tick()
	_place_car(dt)

## The edge of the map: a striped barrier EDGE metres in from the baked area's rim, with a
## glowing curtain over it that shows as you come near (it used to be an invisible wall the
## car stopped dead against). The car's circles (or a walker, r 0.3) are kept off it.
const EDGE := 6.0
const EDGE_BAND := 1.1                ## the barrier's height
const EDGE_CURTAIN := 7.0             ## the curtain's top
var _edge_mats: Array = []
var _edge_warned := 0.0

func _keep_inside(r: float, car: bool) -> void:
	var inside := _bounds.grow(-EDGE - r)
	var push := Vector2.ZERO
	var circles: Array = [_pos + _fwd() * CAR_OFF, _pos - _fwd() * CAR_OFF] if car else [_pos]
	for q: Vector2 in circles:
		var d := q.clamp(inside.position, inside.end) - q
		if absf(d.x) > absf(push.x):
			push.x = d.x
		if absf(d.y) > absf(push.y):
			push.y = d.y
	if push == Vector2.ZERO:
		return
	_pos += push
	if car:
		var into := -push.normalized().dot(_fwd() * signf(_v)) * absf(_v)
		_v *= 0.4
		if into > 0.5:
			_last_hit = "edge"
			_crash(into)
	if Time.get_ticks_msec() * 0.001 > _edge_warned:
		_edge_warned = Time.get_ticks_msec() * 0.001 + 6.0
		_show_banner("the edge of the map", 1.4)
		Probe.event("map_edge", {"at": Vector2i(_pos)})

## the barrier and curtain along the four sides, following the ground, a few metres a piece
func _build_edge() -> void:
	_edge_mats = []
	var sh := Shader.new()   # (one for the barrier and the curtain: the barrier's alpha 1)
	sh.code = EDGE_SHADER
	for curtain: bool in [false, true]:
		var m := ShaderMaterial.new()
		m.shader = sh
		m.set_shader_parameter("curtain", curtain)
		m.set_shader_parameter("band", EDGE_BAND)
		m.set_shader_parameter("top", EDGE_CURTAIN)
		m.render_priority = 1 if curtain else 0
		_edge_mats.append(m)
	_retint_edge()
	var rim := _bounds.grow(-EDGE)
	var corners := [rim.position, Vector2(rim.end.x, rim.position.y), rim.end, Vector2(rim.position.x, rim.end.y)]
	for side in range(4):
		var a: Vector2 = corners[side]
		var b: Vector2 = corners[(side + 1) % 4]
		var L := a.distance_to(b)
		var n := maxi(1, ceili(L / 4.0))
		for curtain: bool in [false, true]:
			var st := SurfaceTool.new()
			st.begin(Mesh.PRIMITIVE_TRIANGLES)
			for k in range(n):
				var p0 := a.lerp(b, float(k) / n)
				var p1 := a.lerp(b, float(k + 1) / n)
				var g0 := _h(p0)
				var g1 := _h(p1)
				var lo0 := g0 + (EDGE_BAND if curtain else -0.4)
				var lo1 := g1 + (EDGE_BAND if curtain else -0.4)
				var hi0 := g0 + (EDGE_CURTAIN if curtain else EDGE_BAND)
				var hi1 := g1 + (EDGE_CURTAIN if curtain else EDGE_BAND)
				var s0 := L * float(k) / n
				var s1 := L * float(k + 1) / n
				var v: Array = [Vector3(p0.x, lo0, p0.y), Vector3(p1.x, lo1, p1.y), Vector3(p1.x, hi1, p1.y), Vector3(p0.x, hi0, p0.y)]
				var uv: Array = [Vector2(s0, lo0 - g0), Vector2(s1, lo1 - g1), Vector2(s1, hi1 - g1), Vector2(s0, hi0 - g0)]
				for i: int in [0, 1, 2, 0, 2, 3]:
					st.set_uv(uv[i])
					st.add_vertex(v[i])
			var mi := MeshInstance3D.new()
			mi.mesh = st.commit()
			mi.material_override = _edge_mats[1 if curtain else 0]
			mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			world.add_child(mi)

func _retint_edge() -> void:
	for m: ShaderMaterial in _edge_mats:
		m.set_shader_parameter("stripe", Palette.col("hazard"))
		m.set_shader_parameter("ink", Palette.col("ink"))

const EDGE_SHADER := """
shader_type spatial;
render_mode unshaded, cull_disabled, shadows_disabled;
uniform float band = 1.1;
uniform float top = 7.0;
uniform vec3 stripe : source_color = vec3(1.0, 0.2, 0.4);
uniform vec3 ink : source_color = vec3(1.0);
uniform bool curtain = false;   // (one shader for both: two were two sets of programs to compile)
varying float dist;
void vertex() {
	dist = length((MODELVIEW_MATRIX * vec4(VERTEX, 1.0)).xyz);
}
void fragment() {
	if (!curtain) {
		// chevrons on the barrier: the hazard colour and white, a bright line along its top
		float s = fract((UV.x + UV.y) / 1.6);
		vec3 c = s < 0.5 ? stripe : ink;
		c = mix(c, ink, smoothstep(band - 0.12, band - 0.04, UV.y));
		ALBEDO = c;
		ALPHA = 1.0;
	} else {
		// the curtain: glowing at the barrier, fading up, with faint upright lines; only when
		// near (a ring of light round the town on the horizon is no help)
		float h = clamp((UV.y - band) / (top - band), 0.0, 1.0);
		float lines = 0.75 + 0.25 * step(0.85, fract(UV.x / 3.0));
		float near = 1.0 - smoothstep(60.0, 180.0, dist);
		ALBEDO = mix(stripe, ink, 0.25);
		ALPHA = (1.0 - h) * (1.0 - h) * 0.55 * lines * near;
	}
}
"""

## up and down: on the ground the car rides it; over a crest the ground can fall away
## faster than the car comes down, and then it flies, with a little lift for the fun of it,
## and lands with a thump (and a bounce if it came down hard)
func _fly(dt: float) -> void:
	var ground: float = _decks.surf(_pos, _y)   # (a bridge's deck, a tunnel's road: whatever is under it)
	# What the springs feel is the ground along the way the car came, smoothed over half a
	# wheelbase of travel: a deck's profile is points 6 m apart with a kink at each, and taken
	# as it came a kink was a jolt in one frame -- at a ramp's top at 50 km/h enough to throw
	# the car up (Tel Aviv's ramps, Ashdod's underpass) -- and so was a seam of a few
	# centimetres between two decks. A real drop still throws it. (Not the heights under the
	# axles: an axle's point by a tunnel's wall found the ground over the tunnel.)
	var ride := lerpf(_ground_was, ground, clampf(dt * maxf(absf(_v), 2.0) / (WHEELBASE * 0.5), 0.0, 1.0))
	var gv := (ride - _ground_was) / maxf(dt, 0.001)   # the ground's own rise or fall, under the car
	_ground_was = ride
	# A rise faster than any slope gives at this speed is a step -- the seam where two decks
	# overlap, up at a junction in the air, a few tenths of a metre apart -- climbed, not a
	# ramp: taken as the car's own climb, 0.3 m in a frame was 17 m/s up, and on the flat
	# beyond it the car flew 3 m over the bridge.
	if gv > absf(_v) * STEP_GRADE + 0.5:
		gv = 0.0
	if _air:
		_vy -= AIR_G * dt
		_y += _vy * dt
		if _y <= ground:
			var hit := gv - _vy   # how fast it met the ground
			_y = ground
			if hit > 5.0:
				_vy = gv + hit * 0.3   # a hard landing bounces
				_crash(hit * 0.8)
				_pitch = clampf(_pitch + 0.08, -0.15, 0.15)
			else:
				_air = false
				_vy = gv
				if hit > 2.0:
					shake3d(hit * 0.5)
					Audio.play("impact_soft", 0.1, -4.0)
					Probe.event("landed", {"kmh": int(_v * 3.6), "hit": snappedf(hit, 0.1)})
				_pitch = clampf(_pitch + hit * 0.012, -0.1, 0.1)   # the nose dips onto its springs
		return
	if _vy - gv > LIFTOFF and absf(_v) > 7.0:
		_air = true
		_vy = _vy * 1.1 + 0.6
		_y = ground
		Probe.event("airborne", {"kmh": int(_v * 3.6)})
		return
	_y = ground
	_vy = lerpf(_vy, gv, 0.5)

## knocked off the ground (a hard hit): up it goes, a little
func _hop(up: float) -> void:
	if not _air:
		_air = true
		_y = _decks.surf(_pos, _y)
	_vy = maxf(_vy, up)

func _place_car(dt: float) -> void:
	_pose_car(_pos, _yaw, _y)
	var k := 1.0 - exp(-dt * 6.0)
	_roll = lerpf(_roll, clampf(-_v * _yaw_rate * 0.006, -0.07, 0.07), k)
	_pitch = lerpf(_pitch, clampf(-_a_long * 0.005, -0.05, 0.05), k)
	_body.rotation = Vector3(_pitch, 0.0, _roll)
	for w: Array in _wheels:
		(w[0] as Node3D).rotation.y = float(w[1]) - _steer
	for sp: Node3D in _spinners:
		sp.rotation.x += _v * dt / 0.33

## the car's body where the map says, sitting on the slope: nose up a hill, leaning across
## a camber
func _pose_car(p: Vector2, yaw: float, y := NAN) -> void:
	var at := _y if is_nan(y) else y   # (the level it is at: under a bridge, on it, in a tunnel)
	var g0: float = _decks.surf(p, at)
	_car.position = Vector3(p.x, (g0 if is_nan(y) else maxf(y, g0)) + road_top(), p.y)
	_car.rotation.y = PI * 0.5 - yaw
	if _air:   # in the air the nose follows the flight
		_car.rotation.x = lerp_angle(_car.rotation.x, -atan2(_vy, maxf(absf(_v), 3.0)) * 0.8, 0.15)
		return
	if _hnx > 0:
		var fwd := Vector2(cos(yaw), sin(yaw))
		var side := Vector2(-fwd.y, fwd.x)
		var pitch := atan2(_decks.surf(p + fwd * 1.4, at) - _decks.surf(p - fwd * 1.4, at), 2.8)
		var roll := atan2(_decks.surf(p - side * 0.8, at) - _decks.surf(p + side * 0.8, at), 1.6)
		_car.rotation.x = -pitch
		_car.rotation.z = roll

## ---- the sounds of driving -----------------------------------------------------------------
## Loops made by sounds/make_sounds.py (it says why each is what it is), played at a pitch
## and a volume set here every frame: the engine at the revs a simple automatic gearbox gives
## (the loop is the engine at 1200 rpm), louder and brighter under load; the tyres' roar and
## the wind with the speed; the nearest car going by as its tyres' whoosh, its pitch falling as
## it passes; the city far off, always. A looping clip with its pitch changed is cheap and
## smooth in a browser, where pushing generated audio every frame stutters whenever a frame
## is late. (The engine used to be made here at load: a buzz of sharp pulses almost all
## below 200 Hz, the only sound there was, and a laptop's speaker turned it into a rough
## flutter that players switched off.)

const SND_DIR := "res://game/streets/sounds/"
const IDLE_RPM := 800.0
const GEAR_RPM := [420.0, 240.0, 165.0, 122.0, 96.0]   ## rpm per m/s, first to fifth
const SND_LOOPS := ["engine", "engine_load", "road", "wind", "road", "city"]
var _engine: Array = []              ## players: SND_LOOPS, the second "road" the car going by
var _rpm := IDLE_RPM
var _gear_n := 1
var _load := 0.0
var _by_id := 0                      ## the car going by, and how fast it closes on you
var _by_d := INF
var _by_closing := 0.0

func _build_engine() -> void:
	for name: String in SND_LOOPS:
		var p := AudioStreamPlayer.new()
		p.stream = load(SND_DIR + name + ".wav")
		p.volume_db = -80.0
		add_child(p)
		_engine.append(p)

func _engine_tick(dt: float) -> void:
	if _engine.is_empty():
		return
	var off := Audio.muted() or finished or _paused
	_street_snd_tick(dt, off)
	if _rails != null:
		_rails.sound(off)
	for i in range(_engine.size()):
		var p: AudioStreamPlayer = _engine[i]
		if off and p.playing:
			p.stop()
		elif not off and not p.playing:
			p.play(1.5 if i == 4 else 0.0)   # (the car going by: its own stretch of road)
	if off:
		return
	# the gearbox: up a gear sooner on a light foot, later with it down; down below 1250
	var v := 0.0 if _walking else absf(_v)   # on foot: the car idles where it was left
	if _gear > 0:
		var up_at := 2000.0 + 1700.0 * _throttle_in
		if v * float(GEAR_RPM[_gear_n - 1]) > up_at and _gear_n < GEAR_RPM.size():
			_gear_n += 1
		elif v * float(GEAR_RPM[_gear_n - 1]) < 1250.0 and _gear_n > 1:
			_gear_n -= 1
	else:
		_gear_n = 1
	var want := maxf(IDLE_RPM, v * float(GEAR_RPM[_gear_n - 1]))
	if v < 1.5:   # pulling away: the clutch lets the revs rise with the pedal
		want = maxf(want, IDLE_RPM + 1500.0 * _throttle_in)
	_rpm = lerpf(_rpm, want, 1.0 - exp(-dt * 7.0))
	_load = lerpf(_load, _throttle_in, 1.0 - exp(-dt * 6.0))
	var base := linear_to_db(maxf(0.0001, float(SaveData.data.get("volume_sfx", 0.8))))
	var pitch := clampf(_rpm / 1200.0, 0.3, 4.0)
	var rev := clampf((_rpm - IDLE_RPM) / 3500.0, 0.0, 1.0)
	var eng: AudioStreamPlayer = _engine[0]
	var load: AudioStreamPlayer = _engine[1]
	var road: AudioStreamPlayer = _engine[2]
	var wind: AudioStreamPlayer = _engine[3]
	var by: AudioStreamPlayer = _engine[4]
	var city: AudioStreamPlayer = _engine[5]
	eng.pitch_scale = pitch
	load.pitch_scale = pitch
	eng.volume_db = base - 17.0 + 7.0 * rev
	load.volume_db = base - 38.0 + 26.0 * sqrt(_load)
	# the tyres' roar and the wind: what speed sounds like (+8 dB a doubling, and brighter;
	# the wind only at speed, +12 dB a doubling)
	var sp := clampf(v / 14.0, 0.02, 3.0)
	road.pitch_scale = 0.8 + 0.3 * clampf(v / 20.0, 0.0, 1.5)
	road.volume_db = base - 8.0 + 26.0 * log(sp) / log(10.0) if v > 0.2 else -80.0
	wind.volume_db = base - 23.0 + 40.0 * log(maxf(sp, 0.05)) / log(10.0) if v > 2.0 else -80.0
	if _wet_k > 0.01 and v > 0.5:   # on a wet road the tyres hiss: brighter, and the spray's shh
		road.pitch_scale *= 1.0 + 0.25 * _wet_k
		road.volume_db += 2.0 * _wet_k
		wind.volume_db = maxf(wind.volume_db, base - 15.0 + 20.0 * log(sp * _wet_k) / log(10.0))
	city.volume_db = base - (16.0 if _walking else 19.0)
	if _walking:   # idling behind you, quieter the further you walk
		eng.volume_db -= 4.0 + _pos.distance_to(_car_at) * 0.9
		load.volume_db = -80.0
	# the nearest car going by: its tyres, louder as it nears, the pitch falling as it passes
	# (how fast it closes on you, from its distance a frame ago)
	var near := INF
	var nv := 0.0
	var nid := 0
	if _traffic != null:
		for c in _traffic.cars:
			if c.alive and c.v > 1.0:
				var d: float = c.pos.distance_to(_pos)
				if d < near:
					near = d
					nv = c.v
					nid = c.get_instance_id() if c is Object else hash(c)
	if nid == _by_id and dt > 0.0 and near < INF and _by_d < INF:
		_by_closing = lerpf(_by_closing, (_by_d - near) / dt, 1.0 - exp(-dt * 8.0))
	elif nid != _by_id:
		_by_closing = 0.0
	_by_id = nid
	_by_d = near
	if near < 60.0:
		by.pitch_scale = clampf((0.85 + nv / 40.0) / (1.0 - clampf(_by_closing, -60.0, 60.0) / 343.0), 0.5, 2.5)
		by.volume_db = base - 7.0 - 24.0 * log(maxf(near, 3.0) / 3.0) / log(10.0)
	else:
		by.volume_db = -80.0

## ---- the sounds of the street ----------------------------------------------------------------
## What a walk down a Givatayim street sounds like besides the traffic, made by
## sounds/make_sounds.py: birds in the trees by day, crickets in the gardens at night,
## people talking at the cafe, shop or school you are passing, a dog barking a street or two
## away now and then. Worked out twice a second from where you are -- how many trees round
## you (a 40 m grid of the trees, counted as they are planted), the nearest place people talk -- and
## the hour; each eases to its level. In the car they are quieter (the glass, the engine),
## the more so the faster; on foot they are what you hear. The voices and the dog are where
## they come from (3D players: they pan as you turn); the birds and crickets are all round.
const SND_CELL := 40.0
const TALKY := ["restaurant", "cafe", "fast_food", "bar", "pub", "ice_cream", "school", "kindergarten", "community_centre"]
var _amb: Array = []                 ## the birds' and the crickets' loops
var _voices: AudioStreamPlayer3D     ## at the nearest cafe, shop or school
var _dog: AudioStreamPlayer3D        ## a street or two away, now and then
var _snd_trees := {}                 ## 40 m cell -> trees in it (counted as each square plants them)
var _snd_talky := {}                 ## 40 m cell -> places people talk at
var _amb_t := 0.0
var _amb_db := [-80.0, -80.0, -80.0] ## where the birds, crickets and voices are easing to (dB)
var _dog_t := 30.0
var _amb_rng := RandomNumberGenerator.new()

func _build_street_sounds() -> void:
	for name: String in ["birds", "crickets"]:
		var p := AudioStreamPlayer.new()
		p.stream = load(SND_DIR + name + ".wav")
		p.volume_db = -80.0
		add_child(p)
		_amb.append(p)
	_voices = AudioStreamPlayer3D.new()
	_voices.stream = load(SND_DIR + "voices.wav")
	_voices.volume_db = -80.0
	_voices.unit_size = 8.0
	_voices.max_distance = 80.0
	world.add_child(_voices)
	_dog = AudioStreamPlayer3D.new()
	_dog.stream = load(SND_DIR + "dog.wav")
	_dog.unit_size = 25.0
	_dog.max_distance = 220.0
	world.add_child(_dog)
	_amb_rng.seed = hash(_city_name) + 11
	var k := 1.0 / float(_city_data.get("scale", 10))
	for poi: Array in _city_data.get("pois", []):
		var kind := String(poi[2])
		if kind in TALKY or kind.begins_with("shop:"):
			var at := Vector2(poi[0], poi[1]) * k
			var c := _cell(at, SND_CELL)
			if not _snd_talky.has(c):
				_snd_talky[c] = []
			(_snd_talky[c] as Array).append(at)

func _street_snd_tick(dt: float, off: bool) -> void:
	if _amb.is_empty():
		return
	for p: AudioStreamPlayer in _amb:
		if off and p.playing:
			p.stop()
		elif not off and not p.playing:
			p.play(_amb_rng.randf_range(0.0, 3.0))
	if off:
		if _voices.playing:
			_voices.stop()
		if _dog.playing:
			_dog.stop()
		return
	if not _voices.playing:
		_voices.play()
	_amb_t -= dt
	if _amb_t <= 0.0:
		_amb_t = 0.5
		var base := linear_to_db(maxf(0.0001, float(SaveData.data.get("volume_sfx", 0.8))))
		var v := 0.0 if _walking else absf(_v)
		var hush := 0.0 if _walking else 7.0 + 9.0 * clampf(v / 14.0, 0.0, 1.0)   # (in the car: the glass, the engine)
		var c := _cell(_pos, SND_CELL)
		var trees := 0
		var near := INF
		var talk := Vector2.INF
		for dx in range(-1, 2):
			for dz in range(-1, 2):
				var cc := c + Vector2i(dx, dz)
				trees += int(_snd_trees.get(cc, 0))
				for q: Vector2 in _snd_talky.get(cc, []):
					if q.distance_to(_pos) < near:
						near = q.distance_to(_pos)
						talk = q
		var green := clampf(float(trees) / 30.0, 0.0, 1.0)
		# birds by day where there are trees (a dawn-and-dusk chorus: louder in the evening)
		_amb_db[0] = (base - 25.0 + 9.0 * green + (2.0 if _evening else 0.0) - hush) if (not _night and trees > 0) else -80.0
		# crickets at night in the gardens, a few starting in the evening
		_amb_db[1] = (base - 26.0 + 6.0 * green - hush) if _night else ((base - 34.0 - hush) if _evening else -80.0)
		# people talking at the nearest place they would (fewer at night)
		if talk != Vector2.INF and near < 70.0:
			_voices.position = Vector3(talk.x, _h(talk) + 1.4, talk.y)
			_amb_db[2] = base - 9.0 - hush * 0.8 - (5.0 if _night else 0.0)
		else:
			_amb_db[2] = -80.0
		# a dog, a street or two away, now and then where people live
		_dog_t -= 0.5
		if _dog_t <= 0.0:
			_dog_t = _amb_rng.randf_range(35.0, 100.0)
			if _liveliness(_pos) > 0.15 and not _dog.playing:
				var d := Vector2.from_angle(_amb_rng.randf() * TAU) * _amb_rng.randf_range(45.0, 120.0)
				var at := _pos + d
				_dog.position = Vector3(at.x, _h(at) + 0.6, at.y)
				_dog.pitch_scale = _amb_rng.randf_range(0.85, 1.2)
				_dog.volume_db = base - 4.0 - hush
				_dog.play()
	for i in range(2):
		var p: AudioStreamPlayer = _amb[i]
		p.volume_db = move_toward(p.volume_db, _amb_db[i], dt * 10.0)
	_voices.volume_db = move_toward(_voices.volume_db, _amb_db[2], dt * 10.0)

## ---- people ----------------------------------------------------------------------------------

func _spawn_people() -> void:
	_build_life()
	_people_rng.seed = hash(_city_name) + 7
	for i in range(WALKERS):
		var a := Actor3D.new()
		world.add_child(a)
		a.set_character(PEOPLE[i % PEOPLE.size()], _people_rng.randf_range(ADULT_LO, ADULT_HI))
		_humanize(a, hash(a.get_instance_id()))
		_people_lod(a)
		var w := {"actor": a, "line": PackedVector2Array(), "cum": PackedFloat32Array(), "s": 0.0,
			"dir": 1.0, "speed": _people_rng.randf_range(1.1, 1.6), "dodge": 0.0,
			"carry": _people_rng.randf() < 0.22}
		# (a box for one carrier in three; the others walk with a bag instead: the carrying
		# walk round nothing looked like arms out for a hug)
		if i % 9 == 2:   # someone walking a dog (slower: it stops to sniff)
			w["dog"] = true
			w["speed"] = _people_rng.randf_range(0.9, 1.2)
			w["carry"] = false
		elif i % 9 == 6:   # a parent pushing a pushchair (arms forward: the carrying walk)
			w["pram"] = true
			w["carry"] = true
			w["speed"] = _people_rng.randf_range(1.0, 1.3)
		if a.has_meta("old"):   # (people.gd: an older person walks slower)
			w["speed"] = float(w["speed"]) * 0.72
		var cs := hash(_city_name) * 31 + i
		if w["carry"] and not w.has("pram") and posmod(cs, 3) != 0:
			w["carry"] = false
			_carry(a, "bag", cs)
		elif not w.has("pram") and not w.has("dog"):
			var wc := _what_carried(cs, w["carry"])
			_carry(a, wc, cs)
			if wc == "" and posmod(cs * 7, 100) < 14 and _people_maker().on():
				_ppl.phone(a)   # (one walker in seven with nothing in their hands: on their phone)
		# two walking together, side by side (about four in ten people on a street are with
		# someone): the second keeps to the first's line, pace and turns (_walk_beside)
		var lead_i := i - 1
		if i % 4 == 1 and not w.has("dog") and not w.has("pram") and not (_walkers[lead_i] as Dictionary).has("dog") \
				and not (_walkers[lead_i] as Dictionary).has("pram"):
			var lw: Dictionary = _walkers[lead_i]
			if _people_maker().on() and posmod(hash(_city_name) + i, 3) == 0:
				# one pair in three a grown-up and a child (made again, smaller: people.gd)
				a.height = 1.05 + 0.3 * float(posmod(hash(_city_name) + i * 7, 100)) / 100.0
				a.set_meta("child", true)
				_humanize(a, hash(a.get_instance_id()) + 5)
				_people_lod(a)
			w["with"] = lead_i
			w["side"] = 1.0 if _people_rng.randf() < 0.5 else -1.0
			w["speed"] = lw["speed"]
			lw["mate"] = a.get_instance_id()
			_walkers.append(w)
			a.visible = false
			continue
		_walkers.append(w)
		_place_walker(w, true, "start")
	for i in range(CHATTERS):
		var a := Actor3D.new()
		world.add_child(a)
		a.set_character(PEOPLE[(i + 2) % PEOPLE.size()], _people_rng.randf_range(ADULT_LO, ADULT_HI))
		_humanize(a, hash(a.get_instance_id()))
		_people_lod(a)
		_talker(a, hash(_city_name) * 13 + i)   # (before the clip starts: it may change the clips)
		a.play("Idle", true, _people_rng.randf_range(0.8, 1.1))
		_carry(a, _what_carried(hash(_city_name) * 13 + i, false), hash(_city_name) * 13 + i)
		a.visible = false
		_chatters.append({"actor": a, "spot": Vector2.INF})
	_seat_chatters()
	for i in range(SITTERS + WAITERS + KEEPERS):
		var a := Actor3D.new()
		world.add_child(a)
		a.set_character(PEOPLE[(i + 1) % PEOPLE.size()], _people_rng.randf_range(ADULT_LO, ADULT_HI))
		_humanize(a, hash(a.get_instance_id()))
		_people_lod(a)
		a.visible = false
		if i < SITTERS:
			_sitters.append({"actor": a, "spot": Vector2.INF})
		elif i < SITTERS + WAITERS:
			a.play("Idle", true, _people_rng.randf_range(0.7, 1.0))
			var wk := _what_carried(hash(_city_name) * 17 + i, false)
			_carry(a, wk, hash(_city_name) * 17 + i)
			if wk == "" and posmod(hash(_city_name) * 17 + i * 3, 100) < 40 and _people_maker().on():
				_ppl.phone(a)   # (waiting for the bus: many on their phones)
			_waiters.append({"actor": a, "spot": Vector2.INF})
		else:
			a.play("Idle", true, _people_rng.randf_range(0.6, 0.9))
			_keepers.append({"actor": a, "spot": Vector2.INF})
	_build_companions()

## A person is about eight meshes (body, head, hair, clothes...), each its own draw call
## and its own skinning every frame: thirty-six of them were three hundred draws, more
## than the whole city. Past PEOPLE_SEEN they are a few pixels tall, so there they are
## not drawn (the renderer drops them by range) and do not animate (_people_tick).
func _people_lod(a: Actor3D) -> void:
	for mi: MeshInstance3D in a.find_children("*", "MeshInstance3D", true, false):
		mi.visibility_range_end = PEOPLE_SEEN
		mi.visibility_range_end_margin = 5.0
		var pm := mi.get_surface_override_material(0) as ShaderMaterial
		if pm != null and pm.has_meta("piece"):   # (one piece: _one_piece)
			pm.set_shader_parameter("fade_from", PEOPLE_SEEN)
			pm.set_shader_parameter("fade_to", PEOPLE_SEEN - 15.0)
			continue
		# dissolving in over the last 15 m (a dither, no sorting), not there in one frame
		for si in range(mi.mesh.get_surface_count() if mi.mesh != null else 0):
			var m := mi.get_active_material(si) as BaseMaterial3D
			if m != null and m.distance_fade_mode == BaseMaterial3D.DISTANCE_FADE_DISABLED:
				m.distance_fade_mode = BaseMaterial3D.DISTANCE_FADE_OBJECT_DITHER
				m.distance_fade_min_distance = PEOPLE_SEEN   # (min past max: gone at min)
				m.distance_fade_max_distance = PEOPLE_SEEN - 15.0

func _people_awake(a: Actor3D, p: Vector2) -> void:
	var near := p.distance_to(_pos) < PEOPLE_SEEN + 8.0
	if a.anim != null and a.anim.active != near:
		a.anim.active = near

## How lived-in a place is, 0..1, from what is within 60 m of it: buildings (homes,
## offices) and places (shops, cafes, schools count for more). A busy town street is 1; a
## verge out by the motorway is next to nothing, and people turn up there accordingly.
var _life := {}                       ## 60 m cell -> score
const LIFE_CELL := 60.0

func _build_life() -> void:
	_life = {}
	for box: Rect2 in _bld_box:
		var k := _cell(box.get_center(), LIFE_CELL)
		_life[k] = float(_life.get(k, 0.0)) + 1.0
	for poi: Array in _pois:
		var k := _cell(poi[0], LIFE_CELL)
		_life[k] = float(_life.get(k, 0.0)) + 4.0

func _liveliness(p: Vector2) -> float:
	var c := _cell(p, LIFE_CELL)
	var sum := 0.0
	for dx in range(-1, 2):
		for dz in range(-1, 2):
			sum += float(_life.get(c + Vector2i(dx, dz), 0.0))
	return clampf(sum / 40.0, 0.04, 1.0)

## a walker onto a pavement near the car (ahead of it rather than behind when it moves)
func _place_walker(w: Dictionary, anywhere: bool, why := "") -> void:
	var a: Actor3D = w["actor"]
	# a few tries a call, not a dozen: each walks a whole street's pavement, and a walker that
	# found nothing is simply tried again on a later tick (one walker a tick, _people_tick)
	for _try in range(12 if anywhere else 4):
		var ang := _people_rng.randf() * TAU
		if not anywhere and absf(_v) > 2.0:
			ang = _yaw + _people_rng.randf_range(-0.9, 0.9)
		# (anywhere out of view: past where people are drawn, behind you, or behind a block --
		# from 98 m only, the street round you stayed empty until people walked the whole way in)
		var d := _people_rng.randf_range(25.0 if anywhere else 22.0, PEOPLE_SEEN + 6.0)
		var hit := _nearest_seg(_pos + Vector2(cos(ang), sin(ang)) * d, 40.0, true, true)
		if hit.is_empty():
			continue
		var r: Dictionary = _roads[hit["road"]]
		if not _kerbed(r) or r.has("ys"):
			continue   # no pavement: a motorway, a slip road, a service lane, a private way, a bridge
		# as many people as the place has life: by its homes, shops and cafes
		if _people_rng.randf() > _liveliness(hit["q"]):
			continue
		var runs := _street_runs(r)
		if runs.is_empty():
			continue
		var run: PackedVector2Array = runs[_people_rng.randi() % runs.size()]
		# a divided road's pavement is on its outer side: the inner one is the median, and
		# a step past it the other carriageway
		var side := float(r["o"]) if r.has("median") else (1.0 if _people_rng.randf() < 0.5 else -1.0)
		# the back half of the pavement: the parked cars stand on the front of it
		var pave := _people_rng.randf_range(1.85, 2.2)
		var line := _offset_line(run, (float(r["w"]) * 0.5 + pave) * side)
		line = _pavement_piece(line)
		if line.size() < 2:
			continue
		var cum := PackedFloat32Array([0.0])
		for i in range(1, line.size()):
			cum.append(cum[i - 1] + line[i - 1].distance_to(line[i]))
		if cum[cum.size() - 1] < 8.0:
			continue
		var s0 := _people_rng.randf() * cum[cum.size() - 1]
		if not anywhere:
			# never appear in view: first a spot just past where people are drawn, when this
			# pavement reaches that far (they walk in, fading in from 90 m); only then one hidden
			# behind a building, with a margin. Hidden spots alone let one in 90 s show (people_pops,
			# 21 Nov: put down 39 m off, just round a building's corner, and in view a frame later,
			# where the person stood beside the line's point and the eye had moved on).
			var far: Array = []
			var sk := 0.0
			while sk <= cum[cum.size() - 1]:
				var dq := _along(line, cum, sk).distance_to(_pos)
				if dq > PEOPLE_SEEN + 5.0 and dq < PEOPLE_SEEN + 11.0:
					far.append(sk)
				sk += 2.0
			if not far.is_empty():
				s0 = far[_people_rng.randi() % far.size()]
			else:
				var found := false
				for _k in range(4):
					if _hidden_well(line, cum, s0):
						found = true
						break
					s0 = _people_rng.randf() * cum[cum.size() - 1]
				if not found:
					continue
		w["line"] = line
		w["cum"] = cum
		w["s"] = s0
		w["pave"] = pave
		w["placed"] = why   # (for tests: which call put them here -- people_pops prints it)
		w["cross"] = 0.0
		w.erase("yaw")
		# a new life: nothing of where they stood across the old pavement (its `lat`, up to
		# 0.9 m, put them beside the spot found out of sight, round the building's corner
		# into view), nor of what they were stepping round there
		for k: String in ["lat", "lane", "plan_t", "me_side", "held", "hold_me", "at"]:
			w.erase(k)
		w["dodge"] = 0.0
		w["dir"] = 1.0 if _people_rng.randf() < 0.5 else -1.0
		a.play("Walk_Carry" if w["carry"] else "Walk", true, float(w["speed"]) / _walk_clip_v())
		a.visible = true
		return
	a.visible = false

## Somewhere to walk along a pavement line: the longest-but-random stretch of it that keeps
## off every road's asphalt and out of the buildings. A driveway's mouth, a few metres, is
## walked over; a service lane or a car park's lane running alongside, the other half of a
## divided road, the next street where two meet at an angle are not -- people walked down
## all of those. [] when nothing is left 8 m long.
func _pavement_piece(line: PackedVector2Array) -> PackedVector2Array:
	var pieces := _pavement_pieces(line)
	if pieces.is_empty():
		return PackedVector2Array()
	return pieces[_people_rng.randi() % pieces.size()]

## every such stretch of a pavement line, 8 m or more
func _pavement_pieces(line: PackedVector2Array) -> Array:
	var pts := PackedVector2Array()
	for i in range(line.size() - 1):
		var n := maxi(1, ceili(line[i].distance_to(line[i + 1]) / 1.5))
		for k in range(n):
			pts.append(line[i].lerp(line[i + 1], float(k) / n))
	pts.append(line[line.size() - 1])
	var n := pts.size()
	var bad := PackedByteArray()   # 0 clear, 1 asphalt, 2 a building, 3 a street's asphalt
	bad.resize(n)
	for i in range(n):
		if _push_out(pts[i], 0.35, false) != Vector2.ZERO:
			bad[i] = 2
		elif not _off_road(pts[i], 0.3):
			bad[i] = 3 if _on_street(pts[i]) else 1
	# forgive short stretches of asphalt between clear ground (a driveway, an alley's mouth) --
	# not a street's: up to 6 m of it was forgiven, a narrow side street's whole mouth, and
	# people walked across it ("people crossing the road in random locations")
	var i := 0
	while i < n:
		if bad[i] != 1:
			i += 1
			continue
		var j := i
		while j < n and bad[j] == 1:
			j += 1
		if i > 0 and j < n and bad[i - 1] == 0 and bad[j] == 0 and j - i <= 4:
			for k in range(i, j):
				bad[k] = 0
		i = j
	var pieces: Array = []
	var cur := PackedVector2Array()
	var length := 0.0
	for k in range(n + 1):
		if k < n and bad[k] == 0:
			if not cur.is_empty():
				length += cur[cur.size() - 1].distance_to(pts[k])
			cur.append(pts[k])
			continue
		if length >= 8.0:
			pieces.append(cur)
		cur = PackedVector2Array()
		length = 0.0
	return pieces

## At the end of its stretch of pavement a walker walks on, as people do: over the side
## street's mouth to the same pavement's next block, or round the corner onto the side
## street's. They turned back on the spot at every block's end instead, pacing one block
## for good -- in view, people going nowhere. Looks only at the street runs that begin or
## end near here (a run's whole pavement is checked a metre and a half at a time). False when
## nothing goes on from here.
func _walk_on(w: Dictionary, end: Vector2, fw: Vector2) -> bool:
	var best := PackedVector2Array()
	var best_score := -INF
	var roads := {}
	var side_dir := Vector2(-fw.y, fw.x)
	for probe: Vector2 in [end + fw * 10.0, end + fw * 5.0 + side_dir * 7.0, end + fw * 5.0 - side_dir * 7.0]:
		var hit := _nearest_seg(probe, 12.0, true, true)
		if hit.is_empty() or roads.has(hit["road"]):
			continue
		roads[hit["road"]] = true
		var r: Dictionary = _roads[hit["road"]]
		if not _kerbed(r) or r.has("ys"):
			continue
		for run: PackedVector2Array in _street_runs(r):
			if minf(run[0].distance_to(end), run[run.size() - 1].distance_to(end)) > 30.0:
				continue
			for side: float in ([float(r["o"])] if r.has("median") else [1.0, -1.0]):
				var line := _offset_line(run, (float(r["w"]) * 0.5 + float(w.get("pave", 2.0))) * side)
				for piece: PackedVector2Array in _pavement_pieces(line):
					for back: bool in [false, true]:
						var n := piece.size()
						var a := piece[n - 1] if back else piece[0]
						var b := piece[n - 2] if back else piece[1]
						var gap := a.distance_to(end)
						if gap < 1.0 or gap > 18.0:
							continue   # (its own stretch; or too far to step over to)
						var go := (b - a).normalized()
						var step := (a - end) / gap
						if go.dot(fw) < -0.3 or step.dot(fw) < -0.2:
							continue   # (not back the way they came)
						var score := go.dot(fw) - gap * 0.06 + _people_rng.randf() * 0.7
						if score <= best_score:
							continue
						# the step over: not through a building, nor across a street -- people
						# cross at the zebras (_crossers), not wherever a block ends: up to 18 m
						# of asphalt was stepped over, a side street's mouth, in front of the
						# traffic ("people crossing the road in random locations, bothers the
						# traffic"). A driveway's mouth is walked over.
						var clear := true
						for k in range(1, int(gap * 2.0)):
							var q := end.lerp(a, k / (gap * 2.0))
							if _push_out(q, 0.3, false, false) != Vector2.ZERO or _on_street(q):
								clear = false
								break
						if not clear:
							continue
						best_score = score
						best = PackedVector2Array([end])
						if back:
							for k in range(n - 1, -1, -1):
								best.append(piece[k])
						else:
							best.append_array(piece)
	if best.size() < 3:
		return false
	var cum := PackedFloat32Array([0.0])
	for i in range(1, best.size()):
		cum.append(cum[i - 1] + best[i - 1].distance_to(best[i]))
	w["line"] = best
	w["cum"] = cum
	w["s"] = 0.0
	w["dir"] = 1.0
	w["cross"] = cum[1]   # (the step over: on the asphalt's level, not the pavement's)
	return true

## the sideways place on the pavement a walker keeps (see the walker tick): `cur` if it is
## clear 1, 2 and 3 m ahead, else the clear one nearest it (0.2 m steps, 0.8 m either way)
func _walk_lane(line: PackedVector2Array, cum: PackedFloat32Array, s: float, dir: float, cur: float) -> float:
	var total := cum[cum.size() - 1]
	var probes: Array = []
	for k: float in [1.0, 2.0, 3.0]:
		var at := _along(line, cum, clampf(s + dir * k, 0.0, total))
		var nx := _along(line, cum, clampf(s + dir * (k + 0.5), 0.0, total)) - at
		if nx.length_squared() < 0.0001:
			continue
		var fw := nx.normalized()
		probes.append([at, Vector2(-fw.y, fw.x)])
	var clear := func(off: float) -> bool:
		for pr: Array in probes:
			var q: Vector2 = (pr[0] as Vector2) + (pr[1] as Vector2) * off
			if _push_out(q, 0.32, true, false) != Vector2.ZERO or _car_box_push(q, 0.32) != Vector2.ZERO:
				return false
		return true
	if clear.call(cur):
		return cur
	var best := cur
	var bd := INF
	for i in range(-4, 5):
		var off := float(i) * 0.2
		if absf(off - cur) < bd and clear.call(off):
			bd = absf(off - cur)
			best = off
	return best

## out of anyone else's 0.55 m: half the overlap, as two people brushing past each other do
## (they stepped aside for each other but nothing kept them apart: some walked through)
func _people_apart(p: Vector2, me: int, mate: int, dog := 1) -> Vector2:
	var push := Vector2.ZERO
	for k in range(_people_at.size()):
		var who := _people_who[k]
		if who == me or who == mate or who == 0 or who == dog:
			continue
		var d := p - _people_at[k]
		var l := d.length()
		if l < 0.55 and l > 0.001:
			push += d / l * (0.55 - l) * 0.5
	return push

## A walker's legs as it really goes: walking at the pace it covers the ground, standing when
## it does not (held up letting you by, waiting behind someone, the second of two whose first
## has stopped) -- it walked on the spot, its legs going and its feet still. A short delay
## each way, so a stutter does not flick it between the two.
func _walker_anim(w: Dictionary, a: Actor3D, p: Vector2, dt: float) -> void:
	var was: Vector2 = w.get("anim_p", p)
	w["anim_p"] = p
	var pace := was.distance_to(p) / maxf(dt, 0.001)
	if pace > 3.0:
		pace = float(w["speed"])   # (put down somewhere new: not a pace)
	var v: float = lerpf(float(w.get("anim_v", pace)), pace, 1.0 - exp(-dt * 6.0))
	w["anim_v"] = v
	var walking: bool = w.get("anim_walk", true)
	if walking and v < 0.22:
		walking = false
	elif not walking and v > 0.4:
		walking = true
	var clip := ("Walk_Carry" if w["carry"] else "Walk") if walking else "Idle"
	if clip != String(w.get("anim_clip", "")) or walking:
		a.play(clip, true, clampf(v, 0.6, 1.8) / _walk_clip_v() if walking else 1.0)
		w["anim_clip"] = clip
	w["anim_walk"] = walking

## The second of two walking together: beside the first (`side`: its left or right), at its
## pace on its line, a step behind where there is no room beside them; seen when the first is.
func _walk_beside(w: Dictionary, dt: float) -> void:
	var a: Actor3D = w["actor"]
	var lw: Dictionary = _walkers[int(w["with"])]
	var la: Actor3D = lw["actor"]
	var line: PackedVector2Array = lw["line"]
	if not la.visible or line.size() < 2:
		a.visible = false
		return
	var cum: PackedFloat32Array = lw["cum"]
	var total := cum[cum.size() - 1]
	var dir := float(lw["dir"])
	var s := clampf(float(lw["s"]) - dir * 0.2, 0.0, total)
	var lp := Vector2(la.position.x, la.position.z)
	var p := _along(line, cum, s)
	var ahead := _along(line, cum, clampf(s + dir * 0.5, 0.0, total)) - p
	if ahead.length_squared() < 0.0001:
		ahead = Vector2(cos(float(lw.get("yaw", 0.0))), sin(float(lw.get("yaw", 0.0))))
	var fw := ahead.normalized()
	var right := Vector2(-fw.y, fw.x)
	# beside the first, wherever it stepped to (its lat), or a step behind it
	var q := lp - fw * 0.15 + right * float(w["side"]) * dir * 0.62   # (the same side as they turn back)
	# single file where there is no room beside them, or to pass you on foot (the first makes
	# room for you; the second, beside it, walked into you)
	var you_near := _walking and (_pos - lp).dot(fw) > -1.0 and (_pos - lp).length() < 4.5
	if you_near or _push_out(q, 0.28, true, false) != Vector2.ZERO or _car_box_push(q, 0.28) != Vector2.ZERO:
		q = lp - fw * 0.95
	var was_seen := a.visible
	var at: Vector2 = w.get("at", q) if was_seen else q
	if at.distance_to(q) > 2.5:
		at = q   # (the first put down somewhere new, unseen: with them at once, not sliding there)
	at = at.lerp(q, 1.0 - exp(-dt * 5.0))
	at += _people_apart(at, a.get_instance_id(), la.get_instance_id())
	if _walking and at.distance_to(_pos) < 0.65:   # (never into you: as the first, _people_tick)
		at = _pos + (at - _pos).normalized() * 0.65 if at.distance_to(_pos) > 0.01 else at - fw * 0.65
	for _pass in range(2):
		at += _car_box_push(at, 0.25)
		at += _push_out(at, 0.25, true, false)
	w["at"] = at
	a.position = Vector3(at.x, _walk_y(at) if s < float(lw.get("cross", 0.0)) else _h(at) + _pave_top(), at.y)
	var yaw: float = lw.get("yaw", atan2(fw.y, fw.x))
	a.face(Vector3(cos(yaw), 0, sin(yaw)))
	if not was_seen:
		w.erase("anim_p")
		a.visible = true
	_walker_anim(w, a, at, dt)
	_people_awake(a, at)

## People by the cafe tables near the car, standing about. Re-seated at the nearest tables
## every second and a half, they jumped from table to table in plain view as the car moved;
## now one stays put while it can be seen, and only one out of sight moves -- to a table
## that is also out of sight, so tables ahead are taken before they come into view.
func _seat_chatters() -> void:
	if _table_spots.is_empty():
		return
	var taken := {}
	for c: Dictionary in _chatters:
		if (c["actor"] as Actor3D).visible:
			taken[c["spot"]] = true
	var first := not _chatters_sat   # (the first time, as the city appears: anywhere near)
	_chatters_sat = true
	var free_spots: Array = _table_spots.filter(func(t): return t.distance_to(_pos) < PEOPLE_RANGE and not taken.has(t) and (first or _unseen(t)))
	var fwd := _fwd()
	free_spots.sort_custom(func(a, b): return (a - _pos).dot(fwd) - a.distance_to(_pos) * 0.5 > (b - _pos).dot(fwd) - b.distance_to(_pos) * 0.5)
	for i in range(_chatters.size()):
		var c: Dictionary = _chatters[i]
		var a: Actor3D = c["actor"]
		var at: Vector2 = c["spot"]
		if a.visible and not first and not _unseen(at) and at.distance_to(_pos) < PEOPLE_RANGE:
			continue   # in view: stays
		if free_spots.is_empty():
			if a.visible and at.distance_to(_pos) >= PEOPLE_RANGE:
				a.visible = false
			continue
		var t: Vector2 = free_spots.pop_front()
		c["spot"] = t
		var al: Vector2 = _table_along.get(t, Vector2.ZERO)
		if _people_maker().on() and al != Vector2.ZERO and i % 4 != 3:
			# on one of the table's chairs, facing it, talking (three in four; the rest stand by it)
			var sgn := 1.0 if i % 2 == 0 else -1.0
			var face := -al * sgn
			var sq := t + al * 0.62 * sgn + face * 0.42   # (the sitting pose's hips over the seat: as on a bench)
			a.position = Vector3(sq.x, _h(sq), sq.y)
			a.face(Vector3(face.x, 0, face.y))
			a.play("SitDown", true)
			a.visible = true
			continue
		var off := Vector2(cos(i * 2.4), sin(i * 2.4)) * 0.95
		var q := t + off
		a.position = Vector3(q.x, _walk_y(q), q.y)
		a.face(Vector3(-off.x, 0, -off.y))
		a.play("Idle", true)
		a.visible = true

var _chatters_sat := false
var _table_along := {}               ## a cafe table's spot -> the way its two chairs stand from it

## ---- more kinds of people -----------------------------------------------------------------
## Not only walkers and people at the cafe tables: two in eighteen walkers have a dog on a
## lead, trotting a step ahead on their right (its legs swung in its shader: dog_kit), two
## push a pushchair; a few people sit on the park benches and a few wait at the bus stops.
## The sitters and the waiters are put where nobody sees them appear, the cafe tables' way
## (_unseen), and taken away out of sight. The dogs, the pushchairs and the leads are a
## multimesh each (3 draws in all); the sitters and waiters are people like the rest.
const SITTERS := 3
const WAITERS := 4
const KEEPERS := 3                   ## shopkeepers in their doorways near you, looking out at the street
var _keepers: Array = []             ## {actor, spot}
var _shop_spots: Array = []          ## [a doorway's spot, out to the street] of every open shop
var _sitters: Array = []             ## {actor, spot}: on the park benches near you
var _waiters: Array = []             ## {actor, spot}: at the bus stops near you
var _bench_spots: Array = []         ## [where, facing] of every bench made
var _dogs: MultiMesh
var _prams: MultiMesh
var _leads: MultiMesh

func _build_companions() -> void:
	var nd := 0
	var np := 0
	for w: Dictionary in _walkers:
		if w.has("dog"):
			w["dog_i"] = nd
			w["dog_size"] = [0.95, 0.72, 1.12, 0.82, 1.05][nd % 5]   # (a small dog and a big one, and between)
			nd += 1
		elif w.has("pram"):
			w["pram_i"] = np
			np += 1
	var hide := Transform3D(Basis(), Vector3(0, -500, 0))
	var box := AABB(Vector3(_bounds.position.x - 500.0, -600.0, _bounds.position.y - 500.0), Vector3(_bounds.size.x + 1000.0, 1200.0, _bounds.size.y + 1000.0))
	# black, brown, golden, white, grey, tan: the street's mix of dogs
	var coats: Array = [Palette.col("bg").lerp(Palette.col("bg_alt"), 0.25), _natural(Palette.col("warn").lerp(Palette.col("bg"), 0.55), 0.45),
		_natural(Palette.col("warn").lerp(Palette.col("ink"), 0.35), 0.45), Palette.col("ink").lerp(Palette.col("bg_alt"), 0.1),
		_natural(Palette.col("ink").lerp(Palette.col("bg"), 0.55), 0.1), _natural(Palette.col("warn").lerp(Palette.col("hazard"), 0.2).lerp(Palette.col("bg"), 0.4), 0.45)]
	var made: Array = []
	for spec: Array in [["dog", nd], ["pram", np], ["leash", nd]]:
		var mm := MultiMesh.new()
		mm.transform_format = MultiMesh.TRANSFORM_3D
		mm.use_custom_data = spec[0] == "dog"
		mm.use_colors = spec[0] == "pram"
		mm.mesh = _furn.dog_kit() if spec[0] == "dog" else (_furn.pram_kit() if spec[0] == "pram" else _furn.leash_kit())
		mm.instance_count = int(spec[1])
		mm.custom_aabb = box
		for k in range(int(spec[1])):
			mm.set_instance_transform(k, hide)
			if spec[0] == "dog":
				var cc: Color = (coats[k % coats.size()] as Color).srgb_to_linear()
				mm.set_instance_custom_data(k, Color(0.0, cc.r, cc.g, cc.b))
			elif spec[0] == "pram":
				mm.set_instance_color(k, [Palette.col("player").lerp(Palette.col("bg"), 0.5), Palette.col("bg").lerp(Palette.col("bg_alt"), 0.4),
					_natural(Palette.col("hazard").lerp(Palette.col("bg"), 0.4), 0.5)][k % 3])
		var mi := MultiMeshInstance3D.new()
		mi.multimesh = mm
		# (no visibility range: it is measured to the multimesh's own middle -- the city's --
		# and hid every dog; _companion hides the far ones itself)
		world.add_child(mi)
		made.append(mm)
	_dogs = made[0]
	_prams = made[1]
	_leads = made[2]

## a walker's dog or pushchair, where they are now (and gone with them when they are out of sight)
func _companion(w: Dictionary, p: Vector2) -> void:
	var a: Actor3D = w["actor"]
	var yaw: float = w.get("yaw", 0.0)
	var fw := Vector2(cos(yaw), sin(yaw))
	var right := Vector2(-fw.y, fw.x)
	var show := a.visible and p.distance_to(_pos) < PEOPLE_SEEN
	var turn := Basis(Vector3.UP, atan2(fw.x, fw.y))
	if w.has("dog_i"):
		var k: int = w["dog_i"]
		if not show:
			_dogs.set_instance_transform(k, Transform3D(Basis(), Vector3(0, -500, 0)))
			_leads.set_instance_transform(k, Transform3D(Basis(), Vector3(0, -500, 0)))
			return
		_dog_step(w, p, fw, right, a)
	elif w.has("pram_i"):
		var k: int = w["pram_i"]
		if not show:
			_prams.set_instance_transform(k, Transform3D(Basis(), Vector3(0, -500, 0)))
			return
		var pp := p + fw * 0.42
		pp += _car_box_push(pp, 0.3)
		w["pram_at"] = pp
		_prams.set_instance_transform(k, Transform3D(turn, Vector3(pp.x, _h(pp) + _pave_top(), pp.y)))

## A walker's dog, a tick on: it keeps to a spot by its walker -- ahead on the right, ahead on
## the left, or at heel -- the one it has while that stays clear and on its walker's side of
## any fence (switching only when blocked), and goes there at a dog's pace, turning to face
## where it goes; its legs trot by the ground it covers (custom r: the stride's phase and how
## hard). It was put each tick at the first clear one of those spots: a post or a railing
## coming by flicked it a metre across in a frame, it faced its walker's way whatever it did,
## and its legs ran at one pace standing or walking. Kept off people but its own walker
## (`_people_apart`), and itself among the bodies everyone else keeps off (_people_tick).
const DOG_SPOTS := [Vector2(0.4, 0.95), Vector2(-0.4, 0.95), Vector2(0.3, -0.35)]   ## (right, ahead) by its walker

func _dog_step(w: Dictionary, p: Vector2, fw: Vector2, right: Vector2, a: Actor3D) -> void:
	var k: int = w["dog_i"]
	var dt := get_physics_process_delta_time()
	var sc: float = w.get("dog_size", 1.0)
	var was: Vector2 = w.get("dog_at", Vector2.INF)
	var spot := func(i: int) -> Vector2:
		var o: Vector2 = DOG_SPOTS[i]
		return p + right * o.x * sc + fw * o.y * sc
	var ok := func(q: Vector2) -> bool:
		return _push_out(q, 0.2, true, false) == Vector2.ZERO and _car_box_push(q, 0.2) == Vector2.ZERO and not _wall_between(p, q)
	var slot: int = w.get("dog_slot", 0)
	w["dog_hold"] = float(w.get("dog_hold", 0.0)) - dt
	if not ok.call(spot.call(slot)) and float(w["dog_hold"]) <= 0.0:
		for i in range(DOG_SPOTS.size()):
			if ok.call(spot.call(i)):
				slot = i
				w["dog_slot"] = i
				w["dog_hold"] = 1.0   # (a second before it thinks of moving over again)
				break
	var target: Vector2 = spot.call(slot)
	var dp: Vector2
	if was == Vector2.INF or was.distance_to(p) > 3.0:
		dp = target   # (put down with its walker, unseen)
	else:
		# at a dog's pace (faster than its walker's, to catch up), never through a fence
		var step := target - was
		var most := maxf(float(w["speed"]) * 1.8, 1.6) * dt
		if step.length() > most:
			step = step.normalized() * most
		dp = was + step
		if _wall_between(p, dp):
			dp = spot.call(2)   # (at heel: never the far side of a railing)
	dp += _people_apart(dp, -100 - k, a.get_instance_id()) * 0.8
	dp += _car_box_push(dp, 0.2)
	dp += _push_out(dp, 0.2, true, false)
	var moved := 0.0 if was == Vector2.INF else was.distance_to(dp)
	w["dog_at"] = dp   # (for the tests: a headless run reads a multimesh's copies back as nothing)
	# facing where it goes when it moves, its walker's way when it stands
	var dyaw: float = w.get("dog_yaw", atan2(fw.x, fw.y))
	var go := (dp - was) if moved > 0.002 else Vector2.ZERO
	var want := atan2(go.x, go.y) if go != Vector2.ZERO else atan2(fw.x, fw.y)
	dyaw = lerp_angle(dyaw, want, 1.0 - exp(-dt * 6.0))
	w["dog_yaw"] = dyaw
	# the trot: a stride about 0.55 m (smaller dogs, shorter), its phase from the ground covered
	var ph: float = w.get("dog_phase", 0.0)
	ph = fmod(ph + moved / (0.55 * sc) * TAU, TAU)
	w["dog_phase"] = ph
	var pace := moved / maxf(dt, 0.001)
	var amp: float = w.get("dog_amp", 0.0)
	amp = lerpf(amp, clampf(pace / 1.2, 0.0, 1.0), 1.0 - exp(-dt * 8.0))
	w["dog_amp"] = amp
	var y := _h(dp) + _pave_top()
	_dogs.set_instance_transform(k, Transform3D(Basis(Vector3.UP, dyaw).scaled(Vector3.ONE * sc), Vector3(dp.x, y, dp.y)))
	var cd := _dogs.get_instance_custom_data(k)
	_dogs.set_instance_custom_data(k, Color(floorf(amp * 7.0 + 0.5) * 8.0 + minf(ph, 6.28), cd.g, cd.b, cd.a))
	var dfw := Vector3(sin(dyaw), 0, cos(dyaw))
	var hand := Vector3(p.x, a.position.y + 0.82, p.y) + Vector3(right.x, 0, right.y) * 0.22
	var collar := Vector3(dp.x, y + 0.5 * sc, dp.y) + dfw * 0.26 * sc
	var span := collar - hand
	var lb := Basis.looking_at(-span.normalized(), Vector3.UP) if span.length() > 0.05 else Basis()
	_leads.set_instance_transform(k, Transform3D(lb.scaled_local(Vector3(1, 1, span.length())), hand))

## a fence, railing, hedge or wall between a and b (as the walls are kept: their middle lines)
func _wall_between(a: Vector2, b: Vector2) -> bool:
	for i: int in _near(_wall_hash, (a + b) * 0.5, a.distance_to(b) * 0.5 + 0.3, BLD_CELL):
		if Geometry2D.segment_intersects_segment(a, b, _walls[i * 2], _walls[i * 2 + 1]) != null:
			return true
	return false

## people sitting on the park benches near you, a few, put there unseen
func _place_sitters() -> void:
	_place_still(_sitters, _bench_spots, "sit")

## shopkeepers in the doorways of the open shops near you (a few: they are people like the rest)
func _place_keepers() -> void:
	_place_still(_keepers, _shop_spots, "wait")

## people in the beach chairs near you (beach.gd's): made the first time there are chairs
const BATHERS := 10
var _bathers: Array = []             ## {actor, spot}
var _beach_spots: Array = []         ## [where, facing] of every beach chair made

func _place_bathers() -> void:
	if _beach_spots.is_empty():
		return
	if _bathers.is_empty():
		for i in range(BATHERS):
			var a := Actor3D.new()
			world.add_child(a)
			a.set_character(PEOPLE[(i + 2) % PEOPLE.size()], _people_rng.randf_range(ADULT_LO, ADULT_HI))
			_humanize(a, hash(a.get_instance_id()))
			_people_lod(a)
			a.visible = false
			_bathers.append({"actor": a, "spot": Vector2.INF})
	_place_still(_bathers, _beach_spots, "sit")

## someone getting into a car at the kerb beside its driver (traffic.gd's kerb car): one
## person, standing at the open door, then (walking) stepping in. False when that person is
## still in view somewhere else (they would jump).
var _boarders: Array = []            ## [{actor, spot, walking}]
var _boarder_t := 0.0                ## seconds since traffic last had them there

func boarder_at(at: Vector2, face: Vector2, walking: bool) -> bool:
	if _boarders.is_empty():
		var na := Actor3D.new()
		world.add_child(na)
		na.set_character(PEOPLE[3 % PEOPLE.size()], _people_rng.randf_range(ADULT_LO, ADULT_HI))
		_humanize(na, hash(na.get_instance_id()))
		_people_lod(na)
		na.visible = false
		_boarders.append({"actor": na, "spot": Vector2.INF, "walking": false})
	var w: Dictionary = _boarders[0]
	var a: Actor3D = w["actor"]
	var was: Vector2 = w["spot"]
	if a.visible and was.distance_to(at) > 1.5 and not _unseen(was):
		return false
	if not a.visible or bool(w["walking"]) != walking:
		a.play("Walk" if walking else "Idle", true, 0.75 if walking else 0.9)
		w["walking"] = walking
	a.position = Vector3(at.x, _walk_y(at), at.y)
	a.face(Vector3(face.x, 0, face.y))
	a.visible = true
	w["spot"] = at
	_boarder_t = 0.0
	_people_awake(a, at)
	return true

## (still waiting there: kept)
func boarder_keep() -> void:
	_boarder_t = 0.0

func boarder_gone() -> void:
	for w: Dictionary in _boarders:
		(w["actor"] as Actor3D).visible = false

## people waiting at the bus stops near you, one or two a stop, facing the road
func _place_waiters() -> void:
	var spots: Array = []
	for sp: Vector2 in _stop_spots:
		if sp.distance_to(_pos) < PEOPLE_RANGE:
			var hit := _nearest_seg(sp, 15.0, true, true)
			if not hit.is_empty():
				var to: Vector2 = ((hit["q"] as Vector2) - sp).normalized()
				var along := Vector2(-to.y, to.x)
				spots.append([sp + along * 1.4, to])
				spots.append([sp - along * 1.1 - to * 0.3, to])
	_place_still(_waiters, spots, "wait")

func _place_still(list: Array, spots: Array, how: String) -> void:
	var taken := {}
	for c: Dictionary in list:
		if (c["actor"] as Actor3D).visible:
			taken[c["spot"]] = true
	var free: Array = spots.filter(func(s): return (s[0] as Vector2).distance_to(_pos) < PEOPLE_RANGE and not taken.has(s[0]) and _unseen(s[0]))
	free.sort_custom(func(a, b): return (a[0] as Vector2).distance_to(_pos) < (b[0] as Vector2).distance_to(_pos))
	for c: Dictionary in list:
		var a: Actor3D = c["actor"]
		var at: Vector2 = c["spot"]
		if a.visible and (not _unseen(at) or at.distance_to(_pos) < PEOPLE_RANGE):
			continue   # (where it is: stays while seen, or near)
		if free.is_empty():
			if a.visible and at.distance_to(_pos) >= PEOPLE_RANGE:
				a.visible = false
			continue
		var s: Array = free.pop_front()
		var q: Vector2 = s[0]
		var face: Vector2 = s[1]
		c["spot"] = q
		if how == "wade":   # standing in the sea, its surface at s[2]: knee to waist deep
			a.position = Vector3(q.x, float(s[2]), q.y)
			a.face(Vector3(face.x, 0, face.y))
		elif how == "sit":   # on the seat: the sitting pose's hips over it, a little forward
			var sq := q + face * 0.42   # (the origin is at the feet: the hips sit ~0.4 m behind them)
			a.position = Vector3(sq.x, _h(sq), sq.y)
			a.face(Vector3(face.x, 0, face.y))
			if _people_maker().on():
				a.play("SitDown", true)   # (people.gd's sitting is a loop, not a clip that ends sat)
			else:
				a.play("SitDown", false)
				if a.anim != null:
					a.anim.seek(a.anim.current_animation_length, true)   # (sat already)
		else:
			a.position = Vector3(q.x, _walk_y(q), q.y)
			a.face(Vector3(face.x, 0, face.y))
		a.visible = true

## somewhere a walker can be put down or taken away unseen: _unseen's, or 20 m or more off
## and behind a building from the eye (round a corner, the far side of a block)
func _spawn_ok(p: Vector2) -> bool:
	if _unseen(p):
		return true
	if cam == null or p.distance_to(_pos) < 20.0:
		return false
	# behind a building -- and staying behind it: from where the eye is and where it will be in
	# a second and a half, a metre either side of the sight line. Hidden only from the eye of
	# that moment, people put just round a building's corner came into view a moment later,
	# 50-70 m ahead (people_pops: 3 in 90 s)
	var eye := Vector2(cam.global_position.x, cam.global_position.z)
	var side := (p - eye).normalized().orthogonal()
	for e: Vector2 in [eye, eye + _fwd() * maxf(_v, 0.0) * 1.5]:
		for off: float in [0.0, 1.0, -1.0]:
			if not _behind_building(e, p + side * off):
				return false
	return true

## everyone walking beside walker w (`with` it) is where they can go unseen: they go with it
func _mates_unseen(w: Dictionary) -> bool:
	var me := _walkers.find(w)
	for o: Dictionary in _walkers:
		if int(o.get("with", -1)) == me:
			var oa: Actor3D = o["actor"]
			if oa.visible and not _spawn_ok(Vector2(oa.position.x, oa.position.z)):
				return false
	return true

## a spot on a pavement line out of sight with a margin: _spawn_ok there, a step and a half
## along the line either way, and a metre either side of it (where the person really stands:
## a lane across the pavement, stepping round others)
func _hidden_well(line: PackedVector2Array, cum: PackedFloat32Array, s: float) -> bool:
	var total := cum[cum.size() - 1]
	var q := _along(line, cum, s)
	var t := _along(line, cum, minf(s + 0.5, total)) - _along(line, cum, maxf(s - 0.5, 0.0))
	var across := Vector2(-t.y, t.x).normalized() if t != Vector2.ZERO else Vector2.ZERO
	for p: Vector2 in [q, _along(line, cum, maxf(s - 1.5, 0.0)), _along(line, cum, minf(s + 1.5, total)), q + across, q - across]:
		if not _spawn_ok(p):
			return false
	return true

## a building stands across the sight line from eye to p (sampled every 1.5 m)
func _behind_building(eye: Vector2, p: Vector2) -> bool:
	var d := eye.distance_to(p)
	var k := 2.0
	while k < d - 1.5:
		var q := eye.lerp(p, k / d)
		for i: int in _near(_bld_hash, q, 0.1, BLD_CELL):
			if _bld_solid[i] != 0 and (_bld_box[i] as Rect2).has_point(q) and Geometry2D.is_point_in_polygon(q, _blds[i]):
				return true
		k += 1.5
	return false

## somewhere nobody would see a person appear or go: beyond the distance people are drawn
## at, or well behind the car (and its camera)
## -- behind by the camera's own look as well as the body's: on foot the head turns from the
## way you walk (a filmed walk glances 60-90 degrees aside), and "behind the body" was then in
## plain view -- people appeared on the pavement beside the walk
func _unseen(p: Vector2) -> bool:
	var to := p - _pos
	var d := to.length()
	if d > PEOPLE_SEEN + 4.0:
		return true
	if d <= 18.0 or to.dot(_fwd()) >= -0.35 * d:
		return false
	if cam == null:
		return true
	var cf := -cam.global_transform.basis.z
	var look := Vector2(cf.x, cf.z)
	if look.length() < 0.3:
		return false   # (looking down from high up: the whole ring round you is in view)
	return to.dot(look.normalized()) < -0.35 * d and not cam.is_position_in_frustum(Vector3(p.x, _h(p) + 1.0, p.y))

func _people_tick(dt: float) -> void:
	# where everyone is, for the walkers to keep clear of and for the car and you to bump
	# (everyone placed, wherever they are: a walker 60 m off still has to see the next one)
	_people_at.clear()
	_people_who.clear()
	_boarder_t += dt
	for list: Array in [_walkers, _chatters, _crossers, _sitters, _waiters, _keepers, _bathers, _boarders,
			_crowd.everyone() if _crowd != null else []]:
		for w: Dictionary in list:
			var a: Actor3D = w["actor"]
			if a.visible:
				_people_at.append(Vector2(a.position.x, a.position.z))
				_people_who.append(a.get_instance_id())
	# the dogs too, so people step round them and the car and you bump them (a dog's "who" is
	# -100 less its number: its own walker leaves it out)
	for w: Dictionary in _walkers:
		if w.has("dog_i") and (w["actor"] as Actor3D).visible and w.has("dog_at"):
			_people_at.append(w["dog_at"])
			_people_who.append(-100 - int(w["dog_i"]))
	if _walking:
		_people_at.append(_pos)
		_people_who.append(0)
	_people_t -= dt
	if _people_t <= 0.0:
		_people_t = 1.5
		_seat_chatters()
		_place_sitters()
		_place_waiters()
		_place_keepers()
		_place_bathers()
		for w: Dictionary in _boarders:   # (their car gone elsewhere: they go too, unseen)
			if (w["actor"] as Actor3D).visible and _boarder_t > 4.0 and _unseen(w["spot"]):
				(w["actor"] as Actor3D).visible = false
		for list: Array in [_chatters, _sitters, _waiters, _keepers, _bathers]:
			for c: Dictionary in list:
				var ca: Actor3D = c["actor"]
				_people_awake(ca, Vector2(ca.position.x, ca.position.z))
	# one walker a tick is found a new place (a search along the pavements): several at once
	# when the car had driven on was a stutter
	var placed := false
	for w: Dictionary in _walkers:
		var a: Actor3D = w["actor"]
		if w.has("with"):
			_walk_beside(w, dt)
			continue
		var line: PackedVector2Array = w["line"]
		if line.size() < 2:   # found no place last time: look again now and then
			w["retry"] = float(w.get("retry", 0.0)) - dt
			if float(w["retry"]) <= 0.0 and not placed:
				w["retry"] = 2.0
				placed = true
				_place_walker(w, false, "retry")
			continue
		var cum: PackedFloat32Array = w["cum"]
		var total := cum[cum.size() - 1]
		var s: float = w["s"] + (0.0 if w.get("hold_me", false) else float(w["dir"]) * float(w["speed"]) * dt)
		# waiting for you to pass and you do not: after a few seconds, back the way they came
		w["held"] = float(w.get("held", 0.0)) + dt if w.get("hold_me", false) else 0.0
		var turned := false   # (its line or its way along it changed this tick: see `lat` below)
		if float(w["held"]) > 4.0:
			w["dir"] = -float(w["dir"])
			w["held"] = 0.0
			turned = true
			w.erase("me_side")
		w["hold_me"] = false   # (set again below while you are still in the way)
		if s < 0.0 or s > total:   # the end of the stretch: on over the side street, or round the corner
			var at_end := line[0] if s < 0.0 else line[line.size() - 1]
			var came := at_end - (line[1] if s < 0.0 else line[line.size() - 2])
			if placed:
				s = clampf(s, 0.0, total)   # (one search a tick: a tick's wait at the end)
			elif _walk_on(w, at_end, came.normalized()):
				placed = true
				turned = true
				line = w["line"]
				cum = w["cum"]
				total = cum[cum.size() - 1]
				s = 0.0
			elif _spawn_ok(at_end) and _spawn_ok(Vector2(a.position.x, a.position.z)) and _mates_unseen(w):
				# nowhere on from here, out of sight: in at a door, someone else out of one (out of
				# sight where they stand too: the line's end alone, a metre from them, let one go
				# from in view 88 m off -- people_pops)
				placed = true
				_place_walker(w, false, "end")
				continue
			else:   # in view and nowhere on: back the way they came
				placed = true
				w["dir"] = -float(w["dir"])
				turned = true
				s = clampf(s, 0.0, total)
		# the step over a side street's mouth (or a street): at the kerb, a look first, and a
		# wait while a car comes that could not stop for them -- they walked straight out
		# in front of cars at 50 km/h (route 9 hit two, tests/people_near.gd). Waited long,
		# they go back the way they came.
		var over: float = w.get("cross", 0.0)
		var at_kerb := false
		if over > 2.5 and s != float(w["s"]):
			var old: float = w["s"]
			if (old <= 0.001 and s > old and s < over) or (old >= over and s < over):
				# (and not out into a car's side as it goes by: its middle 4 m off, not 2.5)
				if not _safe_to_cross((line[0] + line[1]) * 0.5, over * 0.5, 4.0):
					s = old
					at_kerb = true
					if not w.has("kerb_t"):
						w["kerb_t"] = 0.0
						a.play("Idle", true, _people_rng.randf_range(0.8, 1.1))
					w["kerb_t"] = float(w["kerb_t"]) + dt
					if float(w["kerb_t"]) > 15.0:
						w["dir"] = -float(w["dir"])
		if not at_kerb and w.has("kerb_t"):
			w.erase("kerb_t")
			a.play("Walk_Carry" if w["carry"] else "Walk", true, float(w["speed"]) / _walk_clip_v())
		w["s"] = s
		var p := _along(line, cum, s)
		var ahead := _along(line, cum, clampf(s + float(w["dir"]) * 0.5, 0.0, total)) - p
		# keeping clear, as people do: round a post, a tree, a bench, a cabinet a step ahead,
		# to the right of anyone coming the other way (or standing in the way), and never
		# into anything -- they used to walk through all of it on their line
		if ahead != Vector2.ZERO:
			var fw := ahead.normalized()
			var right := Vector2(-fw.y, fw.x)
			# their place across the pavement, planned a few steps on: the sideways offset from
			# their line that is clear 1, 2 and 3 m ahead, the nearest to where they walk now,
			# kept while it stays clear (looked at again every 0.4 s). A step round each post as
			# it came 1.3 m ahead and back after it had them weaving round every tree in a row.
			w["plan_t"] = float(w.get("plan_t", 0.0)) - dt
			if float(w["plan_t"]) <= 0.0:
				w["plan_t"] = 0.4
				w["lane"] = _walk_lane(line, cum, s, float(w["dir"]), float(w.get("lane", 0.0)))
			var want: float = w.get("lane", 0.0)
			# someone ahead or alongside within a shoulder's width: a step away from their side
			# until past them (only "ahead" let them drift back as they drew level), the right
			# if they are dead ahead
			var me := a.get_instance_id()
			var mate: int = w.get("mate", -1)
			var my_dog: int = -100 - int(w["dog_i"]) if w.has("dog_i") else 1
			for k in range(_people_at.size()):
				if _people_who[k] == me or _people_who[k] == mate or _people_who[k] == my_dog:
					continue
				var rel := _people_at[k] - p
				var fore := rel.dot(fw)
				var sr := rel.dot(right)
				if _people_who[k] == 0:
					# you on foot: you do not step round them (a filmed walk keeps its line), so
					# they make the room, from a few steps off, as people do with someone
					# walking at them -- at 2.6 m they stepped aside at the last moment, or
					# were walked through. To the nearer side of you if it has room, else
					# the other (a walk along the parked cars: stepping away from you was
					# stepping into a car, pushed back out onto you -- 0.32 m), keeping the
					# side once picked while it stays clear.
					if fore > -2.0 and fore < 7.0 and absf(sr) < 1.15:   # (kept till 2 m past you: back into their place at once, one cut in just in front of you)
						var near_side := sr - 1.15 if sr >= 0.05 else sr + 1.15
						var far_side := sr + 1.15 if sr >= 0.05 else sr - 1.15
						var sides: Array = [near_side, far_side]
						if w.has("me_side") and signf(far_side) == float(w["me_side"]):
							sides = [far_side, near_side]
						# each side as far as it is clear (a full step, or less: a parked car one
						# side, a shop's stool the other), the one leaving the most room
						var pick: float = near_side
						var room := -1.0
						for cand: float in sides:
							var full := clampf(cand, -0.9, 0.9)
							for frac: float in [1.0, 0.7, 0.45, 0.2]:
								var step := full * frac
								if _push_out(p + right * step, 0.3, true, false) == Vector2.ZERO and _car_box_push(p + right * step, 0.3) == Vector2.ZERO:
									if absf(sr - step) > room + 0.05:
										room = absf(sr - step)
										pick = step
									break
						w["me_side"] = signf(pick)
						# (the step out of your way instead of their planned place, not on top of it:
						# a place planned 0.6 m one way took most of a 0.9 m step the other back, and
						# one walked along beside you half a metre off for two seconds)
						want += pick - float(w.get("lane", 0.0))
						# no room to pass at all: they stop and let you by, as people do
						w["hold_me"] = room < 0.6 and fore > 0.3 and fore < 3.5
					elif fore < -2.0 or fore > 9.0:
						w.erase("me_side")
					continue
				if fore > -0.6 and fore < 2.6:
					if absf(sr) < 0.85:
						want += 0.8 if absf(sr) < 0.05 else -signf(sr) * (0.85 - absf(sr))
			var lat: float = w.get("lat", 0.0)
			# turned back, or on to a new stretch: their place across the pavement is measured
			# from the line the other way now (`right` flipped or turned), so the same `lat` put
			# them up to 1.8 m across in one tick, in view (walk_people's 1.6-2.5 m jumps 45-57 m
			# off): carried over as where they stand, then eased to the plan as ever
			if turned and a.visible:
				lat = clampf((Vector2(a.position.x, a.position.z) - p).dot(right), -1.5, 1.5)
			# eased to the plan, at no more than a sidestep's pace: eased alone, a step round a
			# tree went at up to 3 m/s across, people gliding sideways (people_pops: 18-21 of
			# them in 90 s of driving)
			var eased := lerpf(lat, clampf(want, -0.9, 0.9), 1.0 - exp(-dt * 3.0))
			lat += clampf(eased - lat, -SIDESTEP * dt, SIDESTEP * dt)
			# no further aside than there is room -- but for making room for you on foot: then
			# up against the hedge, as people do (held back, they stood in your way)
			var room_at := p + right * lat
			if absf(lat) > 0.05 and not w.has("me_side") and (_push_out(room_at, 0.27, true, false) != Vector2.ZERO or _car_box_push(room_at, 0.27) != Vector2.ZERO):
				for f: float in [0.75, 0.5, 0.25, 0.0]:
					var q := p + right * lat * f
					if f == 0.0 or (_push_out(q, 0.27, true, false) == Vector2.ZERO and _car_box_push(q, 0.27) == Vector2.ZERO):
						lat *= f
						break
			w["lat"] = lat
			p += right * lat
		# a car coming at them on the pavement: step aside, towards the buildings
		# (not you on foot: walking at 1.4 m/s you were "a car" too, and everyone within 6 m
		# jumped a metre aside -- they make room for you as for anyone, above). Only when the
		# car's body is coming at them: within a metre of them now or in half a second. Its
		# middle within 6 m had everyone on the pavement step a metre aside as autodrive drove
		# past on the road beside them ("they jump to the side ... it looks fake").
		var to_car := _pos - p
		var dodge: float = w["dodge"]
		if absf(_v) > 1.0 and not _walking and to_car.length() < 8.0 \
				and minf(_body_gap(p, _pos), _body_gap(p, _pos + _fwd() * _v * 0.5)) < 1.0:
			dodge = minf(dodge + dt * 1.4, 1.1)   # a step aside, not a leap
		else:
			dodge = maxf(dodge - dt * 0.5, 0.0)
		w["dodge"] = dodge
		if dodge > 0.0 and ahead != Vector2.ZERO:
			var side := Vector2(-ahead.y, ahead.x).normalized()
			if side.dot(to_car) > 0.0:
				side = -side
			p += side * dodge
		p += _people_apart(p, a.get_instance_id(), int(w.get("mate", -1)), -100 - int(w["dog_i"]) if w.has("dog_i") else 1)
		# (never into you: a filmed walk does not step aside -- and a metre off its camera, not
		# 0.6: a woman coming the other way on a narrow pavement filled the frame with her hair)
		var keep := 1.0 if _place.has("walk") else 0.6
		if _walking and p.distance_to(_pos) < keep:
			p = _pos + (p - _pos).normalized() * keep if p.distance_to(_pos) > 0.01 else p + Vector2(keep, 0.0)
		for _pass in range(2):   # (out of one parked car's post can be into its other)
			p += _car_box_push(p, 0.25)
			p += _push_out(p, 0.25, true, false)
		# (their line is on the pavement, but for a step over a side street's mouth)
		a.position = Vector3(p.x, _walk_y(p) if s < float(w.get("cross", 0.0)) else _h(p) + _pave_top(), p.y)
		_walker_anim(w, a, p, dt)
		if ahead != Vector2.ZERO:
			# turning as people do, over a moment: at the end of a block they turned back on
			# the spot in one frame, and at every bend of the pavement line they snapped
			var want := atan2(ahead.y, ahead.x)
			var yaw: float = w.get("yaw", want)
			yaw = lerp_angle(yaw, want, 1.0 - exp(-dt * 5.0))
			w["yaw"] = yaw
			a.face(Vector3(cos(yaw), 0, sin(yaw)))
		if w.has("dog") or w.has("pram"):
			_companion(w, p)
		_people_awake(a, p)
		# past where people are drawn: brought back round you, out of sight (out at 150 m only,
		# most of the street's people walked where nobody saw them)
		if p.distance_to(_pos) > PEOPLE_SEEN + 12.0 and not placed:
			placed = true
			_place_walker(w, false, "far")
	if _crowd != null:
		_crowd.tick(dt)

## ---- what people look like ---------------------------------------------------------------------
## The kit's people (Quaternius, CC0) are cartoons: big heads and hands, one skin of dark
## grey with white cartoon eyes, the same clothes. Made more like people: a grown-up's
## proportions scaled on the skeleton (PART_SIZES), the face a deeper shade of the skin, and
## skin, hair, shirt and trousers each picked from a natural range mixed from the palette, so
## no two in a street are dressed alike.

## scales bones after the animation has posed them, every frame (the animation's pose puts
## every bone's scale back, so setting it once does not hold)
class PartSizes extends SkeletonModifier3D:
	var bones := {}   ## bone index -> scale

	func _process_modification_with_delta(_delta: float) -> void:
		var sk := get_skeleton()
		if sk == null:
			return
		for i: int in bones:
			sk.set_bone_pose_scale(i, bones[i])

func _people_looks() -> Dictionary:
	var ink := Palette.col("ink")
	var bg := Palette.col("bg")
	var alt := Palette.col("bg_alt")
	var wn := Palette.col("warn")
	var pl := Palette.col("player")
	var hz := Palette.col("hazard")
	var fr := Palette.col("friend")
	var skin := _natural(ink.lerp(wn, 0.38).lerp(hz, 0.14), 0.7)
	return {
		"skin": [skin, skin.darkened(0.15), skin.darkened(0.32), skin.darkened(0.5), skin.darkened(0.64)],
		# mostly dark and brown, as in any street; a fair one, a red one, a grey one
		"hair": [bg.lerp(alt, 0.25), bg.lerp(alt, 0.45), _natural(wn.lerp(bg, 0.8), 0.5), _natural(wn.lerp(bg, 0.7), 0.5),
			_natural(wn.lerp(bg, 0.58), 0.5), _natural(wn.lerp(bg, 0.3), 0.45), _natural(hz.lerp(wn, 0.4).lerp(bg, 0.55), 0.55),
			_natural(ink.lerp(alt, 0.45), 0.15)],
		"shirt": [ink.lerp(alt, 0.08), _natural(pl.lerp(ink, 0.35), 0.5), _natural(hz.lerp(bg, 0.3), 0.5),
			_natural(fr.lerp(bg, 0.45), 0.5), _natural(wn.lerp(ink, 0.35), 0.45), ink.lerp(alt, 0.5),
			bg.lerp(alt, 0.5), _natural(pl.lerp(bg, 0.6), 0.6), _natural(Palette.col("accent").lerp(ink, 0.3), 0.45)],
		"pants": [_natural(pl.lerp(bg, 0.55), 0.45), bg.lerp(alt, 0.5), ink.lerp(alt, 0.55), _natural(wn.lerp(alt, 0.5), 0.4),
			_natural(pl.lerp(bg, 0.7), 0.5)],
		"belt": [bg.lerp(alt, 0.3), _natural(wn.lerp(bg, 0.65), 0.45)],
	}

## A grown-up's proportions on the kit's chunky figures: a smaller head, hands and feet,
## longer thighs and a longer middle. Scales on the bones, kept by PartSizes after the
## animation has posed them.
const PART_SIZES := {
	"Head": Vector3(0.64, 0.64, 0.64),
	"Fist.L": Vector3(0.7, 0.7, 0.7), "Fist.R": Vector3(0.7, 0.7, 0.7),
	"Foot.L": Vector3(0.85, 0.85, 0.85), "Foot.R": Vector3(0.85, 0.85, 0.85),
	"UpperLeg.L": Vector3(1.0, 1.16, 1.0), "UpperLeg.R": Vector3(1.0, 1.16, 1.0),
	"Abdomen": Vector3(1.0, 1.06, 1.0),
}

var _ppl: RefCounted = null          ## people.gd: the people as they are now (Quaternius' base characters, dressed)

func _people_maker() -> RefCounted:
	if _ppl == null:
		_ppl = load("res://game/streets/people.gd").new(self)
	return _ppl

func _humanize(a: Actor3D, seed: int) -> void:
	if a == null or a.model == null:
		return
	if _people_maker().on():   # (STREETS_OLD_PEOPLE=1: the kit's figures, as before, to compare)
		_ppl.make(a, seed)
		return
	var sks := a.model.find_children("*", "Skeleton3D", true, false)
	if not sks.is_empty():
		var sk: Skeleton3D = sks[0]
		var sizes := PartSizes.new()
		for bone: String in PART_SIZES:
			var i := sk.find_bone(bone)
			if i >= 0:
				sizes.bones[i] = PART_SIZES[bone]
		sk.add_child(sizes)
		a.model.scale *= 1.06   # back to the height asked for: the smaller head took some off
		# builds: slighter or broader, across and front to back (the whole figure: a bone's
		# own scale is passed on to the arms and head, and a rotated child of a squashed bone shears)
		var bd := RandomNumberGenerator.new()
		bd.seed = seed + 77
		var wd := bd.randf_range(0.9, 1.12)
		a.model.scale *= Vector3(wd, 1.0, lerpf(1.0, wd, 0.8))
	var rng := RandomNumberGenerator.new()
	rng.seed = seed
	var looks := _people_looks()
	var pick := {}
	for k: String in looks:
		pick[k] = looks[k][rng.randi() % (looks[k] as Array).size()]
	# the face (the big white eyes) in a deeper shade of the same skin: features, not a cartoon's eyes
	pick["face"] = (pick["skin"] as Color).darkened(0.42)
	for mi: MeshInstance3D in a.model.find_children("*", "MeshInstance3D", true, false):
		for si in range(mi.mesh.get_surface_count()):
			var m := mi.mesh.surface_get_material(si) as StandardMaterial3D
			var role := String(m.resource_name).to_lower() if m != null else ""
			if not pick.has(role):
				continue
			var nm := m.duplicate() as StandardMaterial3D
			nm.albedo_color = pick[role]
			nm.roughness = 0.85
			mi.set_surface_override_material(si, nm)
		_one_piece(mi)

## ---- hands while talking --------------------------------------------------------------------
## People standing and talking move their hands: now and then one forearm comes up from the
## elbow and the hand moves as they make a point, then goes down again; sometimes both. The
## figures have no clip for it (Idle stands with arms hanging), so this bends the arm bones
## on top of the pose the animation gave, every frame. (tests/people_talk.gd)
class Talk extends SkeletonModifier3D:
	var arms := []      ## [upper arm, forearm] bone indices, left then right
	var t := 0.0
	var rate := 1.0     ## how lively: 0.7 slow, 1.3 quick
	## the axis, in each arm bone's own frame, that brings the hand forward and up, left then
	## right (measured: about the bone's x alone the hand also swung out to the side, and about
	## -x behind the back; the same for the upper arm and the forearm)
	var axes := [Vector3(1, 0, -1).normalized(), Vector3(1, 0, 1).normalized()]

	## how far each arm is up, 0..1, at time t: a gesture of a second or two every few
	## seconds, one arm (now this one, now the other), sometimes both
	func _up(side: int) -> float:
		var cyc := t * 0.3 * rate + float(side) * 0.37
		var k := floori(cyc)
		var f := cyc - float(k)
		var h := posmod(k * 7919 + side * 31 + int(rate * 1000.0), 10)
		var on := h < (6 if side == 0 else 4)   # (now and then neither: listening)
		if not on:
			return 0.0
		return smoothstep(0.0, 0.18, f) * (1.0 - smoothstep(0.55, 0.75, f))

	func _process_modification_with_delta(delta: float) -> void:
		var sk := get_skeleton()
		if sk == null:
			return
		t += delta
		for side in range(arms.size()):
			var e := _up(side)
			if e <= 0.001:
				continue
			var ua: int = arms[side][0]
			var fa: int = arms[side][1]
			# the hand moving as the point is made: a small beat on top
			var beat := sin(t * (5.0 + float(side)) * rate) * 0.18 + sin(t * 2.3 * rate + float(side)) * 0.1
			var r1 := Quaternion(axes[side], e * 0.35)
			var r2 := Quaternion(axes[side], e * (1.15 + beat))
			sk.set_bone_pose_rotation(ua, sk.get_bone_pose_rotation(ua) * r1)
			sk.set_bone_pose_rotation(fa, sk.get_bone_pose_rotation(fa) * r2)

## talking hands for someone standing in a group (Talk)
func _talker(a: Actor3D, seed: int) -> void:
	if a == null or a.model == null:
		return
	var sks := a.model.find_children("*", "Skeleton3D", true, false)
	if sks.is_empty():
		return
	var sk: Skeleton3D = sks[0]
	if sk.find_bone("UpperArm.L") < 0 and a.anim != null:
		# people.gd's figures have the library's own talking idle: no bending needed
		a.anim.remove_animation_library("")
		a.anim.add_animation_library("", _people_maker()._lib("talk"))
		return
	var tk := Talk.new()
	for sd: String in ["L", "R"]:
		var u := sk.find_bone("UpperArm." + sd)
		var f := sk.find_bone("LowerArm." + sd)
		if u >= 0 and f >= 0:
			tk.arms.append([u, f])
	if tk.arms.is_empty():
		return
	tk.rate = 0.75 + float(posmod(seed, 50)) / 100.0
	tk.t = float(posmod(seed * 13, 1000)) / 37.0
	sk.add_child(tk)

## ---- what people carry -------------------------------------------------------------------------
## Things in people's hands and on their backs: a shopping bag or a handbag hanging from one
## hand, a backpack, a box held in front (the carrying walk had arms out round nothing). Each
## is a few boxes kept at a bone of the figure's skeleton (Held), so it goes with the hand or
## rides on the back; one mesh (one draw) each, shared, for the few who have one. (tests/people_carry.gd)
## what someone has: "" (nothing), "bag", "handbag", "backpack", or "box" for the carrying walk
func _what_carried(seed: int, carrying: bool) -> String:
	if carrying:
		return "box"
	var r := posmod(seed * 2654435761, 1000) / 1000.0
	return "bag" if r < 0.17 else ("handbag" if r < 0.27 else ("backpack" if r < 0.4 else ""))

var _carry_meshes := {}               ## the boxes' sizes, places and colours -> one mesh, shared
var _carry_mat: StandardMaterial3D = null

## one thing in one mesh (one draw, not one a box), its colours in the vertices: [size,
## position, colour] boxes, made once for each different set and shared
func _carry_mesh(h: Node3D, boxes: Array) -> void:
	var key := str(boxes)
	var mesh: ArrayMesh = _carry_meshes.get(key)
	if mesh == null:
		var st := SurfaceTool.new()
		st.begin(Mesh.PRIMITIVE_TRIANGLES)
		for bx: Array in boxes:
			var bm := BoxMesh.new()
			bm.size = bx[0]
			var arr := bm.get_mesh_arrays()
			var v: PackedVector3Array = arr[Mesh.ARRAY_VERTEX]
			var n: PackedVector3Array = arr[Mesh.ARRAY_NORMAL]
			var c: Color = bx[2]   # (as is: converted to linear, as the batched kit's are, they drew darker)
			for i: int in arr[Mesh.ARRAY_INDEX]:
				st.set_color(c)
				st.set_normal(n[i])
				st.add_vertex(v[i] + (bx[1] as Vector3))
		mesh = st.commit()
		_carry_meshes[key] = mesh
	if _carry_mat == null:
		_carry_mat = StandardMaterial3D.new()
		_carry_mat.vertex_color_use_as_albedo = true
		_carry_mat.roughness = 0.8
	var mi := MeshInstance3D.new()
	mi.mesh = mesh
	mi.material_override = _carry_mat
	h.add_child(mi)

## Things held, moved to their bones every frame after the animation (and PartSizes) has
## posed them. A hand's bag hangs straight down from the hand, whatever the arm's swing (on a
## BoneAttachment3D it tilted with the arm, flat as a sheet of paper); the back's turns with it.
class Held extends SkeletonModifier3D:
	var items := []   ## [bone index, holder (a child of the skeleton, in metres), upright]

	func _process_modification_with_delta(_delta: float) -> void:
		var sk := get_skeleton()
		if sk == null:
			return
		for it: Array in items:
			var pose := sk.get_bone_global_pose(it[0])
			var h: Node3D = it[1]
			var keep := h.scale
			h.transform = Transform3D(Basis() if it[2] else pose.basis.orthonormalized(), pose.origin)
			h.scale = keep

## A holder at a bone, in metres (the figure is fitted, i.e. scaled, and a child of the
## skeleton would take that on); moved there every frame by the skeleton's Held
func _bone_holder(a: Actor3D, bone: String, upright: bool) -> Node3D:
	var sks := a.model.find_children("*", "Skeleton3D", true, false)
	if sks.is_empty():
		return null
	var sk: Skeleton3D = sks[0]
	var bi := sk.find_bone(bone)
	if bi < 0:
		bi = sk.find_bone(_people_maker().bone_for(bone))   # (the same place on people.gd's figures)
	if bi < 0:
		return null
	var held: Held = null
	for m in sk.get_children():
		if m is Held:
			held = m
	if held == null:
		held = Held.new()
		sk.add_child(held)   # (after PartSizes: run after it, so the bones are where they are drawn)
	var s: Vector3 = sk.global_transform.basis.get_scale()
	var h := Node3D.new()
	sk.add_child(h)
	h.scale = Vector3(1.0 / s.x, 1.0 / s.y, 1.0 / s.z)
	held.items.append([bi, h, upright])
	return h

func _carry(a: Actor3D, what: String, seed: int) -> void:
	if what == "" or a == null or a.model == null:
		return
	# people.gd's figures: the backpack upright (their chest bone's own axes are not the body's),
	# the box held by people.gd's Carry
	var newer := not a.model.find_children("*", "Skeleton3D", true, false).is_empty() 		and (a.model.find_children("*", "Skeleton3D", true, false)[0] as Skeleton3D).find_bone("spine_03") >= 0
	var ink := Palette.col("ink")
	var bg := Palette.col("bg")
	var alt := Palette.col("bg_alt")
	var wn := Palette.col("warn")
	var rng := RandomNumberGenerator.new()
	rng.seed = seed + 991
	var dark := [bg.lerp(alt, 0.3), _natural(wn.lerp(bg, 0.7), 0.5), _natural(Palette.col("player").lerp(bg, 0.6), 0.5),
		_natural(Palette.col("hazard").lerp(bg, 0.55), 0.5), ink.lerp(alt, 0.6)]
	match what:
		"bag", "handbag":
			# hanging from the hand (the figure faces +z): flat side to the leg
			var h := _bone_holder(a, "Fist.L" if rng.randf() < 0.5 else "Fist.R", true)
			if h == null:
				return
			if what == "bag":   # a supermarket's thin white plastic, or a shop's paper or cloth bag
				var c: Color = [ink.lerp(alt, 0.12), ink.lerp(alt, 0.12), _natural(wn.lerp(ink, 0.45), 0.4),
					_natural(Palette.col("friend").lerp(bg, 0.4), 0.5)][rng.randi() % 4]
				var tall: float = [0.3, 0.34, 0.38][rng.randi() % 3]
				_carry_mesh(h, [[Vector3(0.11, tall, 0.27), Vector3(0, -0.07 - tall * 0.5, 0), c],
					[Vector3(0.02, 0.07, 0.1), Vector3(0, -0.04, 0), c.darkened(0.1)]])   # (and the handles)
			else:   # a handbag, its strap in the hand
				var c: Color = dark[rng.randi() % dark.size()]
				_carry_mesh(h, [[Vector3(0.1, 0.2, 0.27), Vector3(0, -0.15, 0), c],
					[Vector3(0.015, 0.06, 0.12), Vector3(0, -0.03, 0), c.darkened(0.3)]])
		"backpack":
			var h := _bone_holder(a, "Torso", newer)
			if h == null:
				return
			var c: Color = dark[rng.randi() % dark.size()]
			var z := -0.13 if newer else -0.165
			var y := -0.08 if newer else 0.06
			_carry_mesh(h, [[Vector3(0.3, 0.4, 0.15), Vector3(0, y, z), c],
				[Vector3(0.24, 0.16, 0.06), Vector3(0, y - 0.1, z - 0.095), c.darkened(0.2)]])   # (and its front pocket)
		"box":   # a cardboard box on the forearms, the hands under its front
			if newer:   # (people.gd's: the arms held round it, the box between the hands)
				if not _ppl.box(a, _natural(wn.lerp(bg, 0.35), 0.55)):
					return
				_people_lod(a)
				return
			var h := _bone_holder(a, "Torso", false)
			if h == null:
				return
			_carry_mesh(h, [[Vector3(0.42, 0.28, 0.32), Vector3(0, -0.02, 0.36), _natural(wn.lerp(bg, 0.45), 0.55)]])
	_people_lod(a)

## A person in one piece. The figures are one mesh of six parts (skin, shirt, trousers, belt,
## face, hair), and each part is a surface of its own: a draw call, and another in the
## shadow pass, every frame -- 8 people in view were 48 of the 217 draws. Joined into one
## surface, with each vertex's part in its colour's red, and one material per person whose
## six colours are what the parts were, a person is one draw. The joined mesh is made once
## per figure and shared (a mesh per person would be ~0.7 MB each).
const PIECE_SHADER := """
shader_type spatial;
uniform vec4 parts[6];
uniform float fade_from = 1e6;   // gone past this distance...
uniform float fade_to = 1e6;     // ...dissolving in, a dither, from here
void fragment() {
	int i = clamp(int(COLOR.r * 8.0 + 0.5), 0, 5);
	ALBEDO = parts[i].rgb;
	ROUGHNESS = 0.85;
	float d = length((VIEW_MATRIX * vec4(MODEL_MATRIX[3].xyz, 1.0)).xyz);
	float keep = clamp((fade_from - d) / max(fade_from - fade_to, 0.001), 0.0, 1.0);
	if (keep < 0.999 && keep < fract(52.9829189 * fract(dot(FRAGCOORD.xy, vec2(0.06711056, 0.00583715))))) {
		discard;
	}
}
"""
var _piece_meshes := {}               ## a figure's mesh -> the same in one surface
var _piece_shader: Shader = null

func _one_piece(mi: MeshInstance3D) -> void:
	var src := mi.mesh
	if src == null or src.get_surface_count() < 2 or src.get_surface_count() > 6 or src.get_blend_shape_count() > 0:
		return
	if _piece_shader == null:
		_piece_shader = Shader.new()
		_piece_shader.code = PIECE_SHADER
	var one: ArrayMesh = _piece_meshes.get(src)
	if one == null:
		var verts := PackedVector3Array()
		var nrms := PackedVector3Array()
		var bones := PackedInt32Array()
		var wts := PackedFloat32Array()
		var cols := PackedColorArray()
		var idx := PackedInt32Array()
		for si in range(src.get_surface_count()):
			var arr := src.surface_get_arrays(si)
			var v: PackedVector3Array = arr[Mesh.ARRAY_VERTEX]
			var off := verts.size()
			if arr[Mesh.ARRAY_BONES] == null or (arr[Mesh.ARRAY_BONES] as PackedInt32Array).size() != v.size() * 4:
				return   # (not the 4-bone skinned figures this is for)
			verts.append_array(v)
			nrms.append_array(arr[Mesh.ARRAY_NORMAL])
			bones.append_array(arr[Mesh.ARRAY_BONES])
			wts.append_array(arr[Mesh.ARRAY_WEIGHTS])
			var part := PackedColorArray()
			part.resize(v.size())
			part.fill(Color(float(si) / 8.0, 0.0, 0.0))
			cols.append_array(part)
			var ix: PackedInt32Array = arr[Mesh.ARRAY_INDEX] if arr[Mesh.ARRAY_INDEX] != null else PackedInt32Array(range(v.size()))
			for k in ix:
				idx.append(k + off)
		var arrays := []
		arrays.resize(Mesh.ARRAY_MAX)
		arrays[Mesh.ARRAY_VERTEX] = verts
		arrays[Mesh.ARRAY_NORMAL] = nrms
		arrays[Mesh.ARRAY_BONES] = bones
		arrays[Mesh.ARRAY_WEIGHTS] = wts
		arrays[Mesh.ARRAY_COLOR] = cols
		arrays[Mesh.ARRAY_INDEX] = idx
		one = ArrayMesh.new()
		one.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
		_piece_meshes[src] = one
	var m := ShaderMaterial.new()
	m.shader = _piece_shader
	m.set_meta("piece", true)
	var parts: Array[Vector4] = []
	for si in range(6):
		var c := Color.WHITE
		if si < src.get_surface_count():
			var sm := mi.get_active_material(si) as BaseMaterial3D
			if sm != null:
				c = sm.albedo_color
		c = c.srgb_to_linear()
		parts.append(Vector4(c.r, c.g, c.b, 1.0))
	m.set_shader_parameter("parts", parts)
	for si in range(src.get_surface_count()):
		mi.set_surface_override_material(si, null)
	mi.mesh = one
	mi.set_surface_override_material(0, m)

## ---- people crossing at the zebras -----------------------------------------------------------
## A few people at the zebra crossings near the car. They wait at the kerb, and cross once
## whatever is coming can still stop for them; traffic and autodrive stop for anyone on a
## crossing. Drive at someone crossing and they hurry back to the kerb -- and the game says
## so, the way it does a red light.
const CROSSERS := 5
const CROSS_NEAR := 110.0
var _crossers: Array = []            ## {actor, ni, a, b, s, state, t, speed}
var _zebras_on: Array = []           ## crossings with someone on them now: [middle, half width + 1, across, where, pace across]
var _zebra_t := 0.0
var _zebra_warned := -1              ## the crossing the player was last told off at

func _spawn_crossers() -> void:
	for i in range(CROSSERS):
		var a := Actor3D.new()
		world.add_child(a)
		a.set_character(PEOPLE[(i + 3) % PEOPLE.size()], _people_rng.randf_range(ADULT_LO, ADULT_HI - 0.02))
		_humanize(a, hash(a.get_instance_id()))
		_people_lod(a)
		a.visible = false
		_crossers.append({"actor": a, "ni": -1, "a": Vector2.ZERO, "b": Vector2.ZERO, "s": 0.0,
			"state": "off", "t": 0.0, "speed": _people_rng.randf_range(1.15, 1.5)})

## the zebra at node ni: [middle, across (unit, kerb to kerb), half the road's width, the
## road's way, the road]
func _zebra_geom(ni: int) -> Array:
	var c := _nodes[ni]
	for e: Vector2i in _node_roads[ni]:
		var r: Dictionary = _roads[e.x]
		if not r["drive"] or HIGHWAYS.has(r["k"]):
			continue
		var pts: PackedVector2Array = r["pts"]
		var d := (pts[mini(e.y + 1, pts.size() - 1)] - pts[maxi(e.y - 1, 0)]).normalized()
		return [c, Vector2(-d.y, d.x), float(r["w"]) * 0.5, d, e.x]
	return []

## Where a crossing's people wait and walk to: [one kerb, the other], each a step back on the
## pavement. On a divided road the zebra is painted on each half, but people cross the lot,
## outer kerb to outer kerb (waiting on the median they stood in the other carriageway).
## [] when either end is on another road's asphalt or in a building.
func _zebra_span(z: Array) -> Array:
	var mid: Vector2 = z[0]
	var across: Vector2 = z[1]
	var hw: float = z[2]
	var r: Dictionary = _roads[int(z[4])]
	var a := mid - across * (hw + 1.1)
	var b := mid + across * (hw + 1.1)
	if r.has("median"):
		var pair := _partner(mid, z[3], int(z[4]), hw, int(r["o"]))
		if not pair.is_empty():
			var left: Vector2 = pair[3]
			var far := ((pair[1] as Vector2) - mid).dot(left) + float(_roads[int(pair[0])]["w"]) * 0.5
			a = mid - left * (hw + 1.1)
			b = mid + left * (far + 1.1)
	for q: Vector2 in [a, b]:
		if not _off_road(q, 0.2) or _push_out(q, 0.4, false) != Vector2.ZERO:
			return []
	return [a, b]

## At a crossing by a junction with lights, people go by the walk light (see _build_walk_lights):
## they step out on the green man only, with time enough left on it -- they walked out in front
## of cars that had just got their green, and every car through the junction stopped in the
## middle of it for them. Anywhere else: always.
func _walk_light(cr: Dictionary, need: float) -> bool:
	var n: int = cr.get("sig", -1)
	if n < 0 or not _sig_set.has(n):
		return true
	var grp := _light_group(n, cr["sig_dir"])
	var p0 := _ph_at(n)
	var step: Array = SIGNAL_CYCLE[p0]
	if not (step[grp] == "r" and step[3 - grp] == "g"):
		return false   # the red man
	# the green man, with time enough before the cars across get their green to be over
	# (the red man comes on with the other way's flashing green; the road stays red behind it)
	var left := float(step[0]) - _t_at(n)
	var i := (p0 + 1) % SIGNAL_CYCLE.size()
	while i != p0 and SIGNAL_CYCLE[i][grp] == "r":
		left += float(SIGNAL_CYCLE[i][0])
		i = (i + 1) % SIGNAL_CYCLE.size()
	return left >= minf(need, 14.0) + 1.0

## nothing coming that could not stop before the crossing (middle `mid`, `hw` from it to
## either kerb), and nothing standing on it
## At a crossing with walk lights: a car already in the junction (over its stop line) that
## stands or crawls toward the crossing, waiting to get out over it. On the green man people
## stepped out in front of it one after another, and it stood in the junction 25 s while the
## cars across, on their green, went round it. Not a car waiting at its own red short of the
## line: people cross in front of those.
func _box_waiting(cr: Dictionary, mid: Vector2) -> bool:
	var n: int = cr.get("sig", -1)
	if n < 0 or not _site_of.has(n):
		return false
	var site: int = _site_of[n]
	var movers: Array = []
	if _light_site == site and _odo - _light_odo < SITE_KEEP:
		movers.append([_pos, _fwd() * signf(_v) if _v != 0.0 else _fwd(), absf(_v)])
	for c in _traffic.cars:
		if c.alive and c.last_site == site and c.s - c.last_light < _traffic.SITE_KEEP:
			movers.append([c.pos, Vector2(sin(c.yaw), cos(c.yaw)), c.v])
	for m: Array in movers:
		var to: Vector2 = mid - (m[0] as Vector2)
		if float(m[2]) < 2.5 and to.length() < 22.0 and (m[1] as Vector2).dot(to.normalized()) > 0.4:
			return true
	return false

func _safe_to_cross(mid: Vector2, hw: float, near := 2.5) -> bool:
	var movers: Array = [[_pos, _fwd() * signf(_v), absf(_v)]]
	for c in _traffic.cars:
		if c.alive:
			movers.append([c.pos, Vector2(sin(c.yaw), cos(c.yaw)), c.v])
	for m: Array in movers:
		var p: Vector2 = m[0]
		var to: Vector2 = mid - p
		var d := to.length()
		if d < hw + near:
			return false   # on it, or right at it
		var v: float = m[2]
		if d < 45.0 and v > 0.8 and (m[1] as Vector2).dot(to / d) > 0.5 and v * v / (2.0 * 3.0) + 7.0 > d:
			return false   # coming, and too close to stop
	return true

## a car (or the player's) has stood at this crossing a while, kept there by people stepping
## out one after another: let it go before the next one steps out. A stream of people kept
## a car waiting 20 s and more; at a crossing without lights people let one through.
func _kept_waiting(mid: Vector2, hw: float) -> bool:
	if _me_still > 6.0 and _pos.distance_to(mid) < hw + 14.0 and _fwd().dot((mid - _pos).normalized()) > 0.5:
		return true
	for c in _traffic.cars:
		if c.alive and c.still > 6.0 and c.why == "zebra" and c.pos.distance_to(mid) < hw + 14.0:
			return true
	return false

var _me_still := 0.0                  ## seconds the player's car has stood still

func _crossers_tick(dt: float) -> void:
	_me_still = _me_still + dt if absf(_v) < 0.3 else 0.0
	if _crossers.is_empty() or _crossing_nodes.is_empty():
		return
	_zebra_t -= dt
	if _zebra_t <= 0.0:
		_zebra_t = 1.2
		_send_crossers()
	_zebras_on = []
	for cr: Dictionary in _crossers:
		var a: Actor3D = cr["actor"]
		var state: String = cr["state"]
		if state == "off":
			continue
		var z: Array = _zebra_geom(int(cr["ni"]))
		var from: Vector2 = cr["a"]
		var to: Vector2 = cr["b"]
		var p: Vector2 = from.lerp(to, float(cr["s"]))
		match state:
			"wait":
				cr["t"] = float(cr["t"]) - dt
				if float(cr["t"]) <= 0.0 and _walk_light(cr, from.distance_to(to) / float(cr["speed"])) \
						and _safe_to_cross((from + to) * 0.5, from.distance_to(to) * 0.5 - 1.1) \
						and not _box_waiting(cr, (from + to) * 0.5) \
						and not _kept_waiting((from + to) * 0.5, from.distance_to(to) * 0.5):
					cr["state"] = "cross"
					a.play("Walk", true, float(cr["speed"]) / _walk_clip_v())
			"cross", "back":
				var w := from.distance_to(to)
				var sp: float = cr["speed"] * (2.4 if state == "back" else 1.0)
				cr["s"] = clampf(float(cr["s"]) + (sp if state == "cross" else -sp) * dt / maxf(w, 0.1), 0.0, 1.0)
				p = from.lerp(to, float(cr["s"]))
				# (and where the person is, and their pace across: cars wait only while they are
				# on that car's half of the road, see _zebra_clear)
				_zebras_on.append([(from + to) * 0.5, from.distance_to(to) * 0.5 - 0.1, (to - from).normalized(), p,
					float(cr["speed"]) * (1.0 if state == "cross" else -2.4)])
				# the player bearing down on them: back to the kerb they came from
				if state == "cross" and p.distance_to(_pos) < 5.5 and absf(_v) > 2.0 and (p - _pos).dot(_fwd() * signf(_v)) > 0.0:
					cr["state"] = "back"
					a.play("Run", true, 1.2)
					if _zebra_warned != int(cr["ni"]):
						_zebra_warned = int(cr["ni"])
						_show_banner("stop for people on the crossing", 1.8)
						Probe.event("zebra", {"street": _on_name, "kmh": int(absf(_v) * 3.6), "auto": _auto})
				if state == "cross" and float(cr["s"]) >= 1.0 or state == "back" and float(cr["s"]) <= 0.0:
					# over (or back): off along the pavement, gone once out of the way
					cr["state"] = "away"
					cr["t"] = 12.0
					a.play("Walk", true, float(cr["speed"]) / _walk_clip_v())
					_away_from(cr, z)
			"away":
				cr["t"] = float(cr["t"]) - dt
				var end: Vector2 = to if float(cr["s"]) >= 1.0 else from
				var dir: Vector2 = cr["away"]
				var far: float = cr["away_len"]
				var went := float(cr.get("a_off", 0.0))
				cr["a_off"] = went + float(cr["speed"]) * dt
				if went < far and float(cr["a_off"]) >= far:
					a.play("Idle", true, _people_rng.randf_range(0.8, 1.1))   # as far as the pavement goes
				var off := minf(float(cr["a_off"]), far)
				p = end + (cr["out"] as Vector2) * minf(off, 0.9) + dir * off
				if _unseen(p) and (float(cr["t"]) <= 0.0 or p.distance_to(_pos) > CROSS_NEAR):
					cr["state"] = "off"   # (gone only where nobody sees them go)
					cr["ni"] = -1
					a.visible = false
					continue
		# the kerb's step up or down over a moment, not in one frame
		var fy := _walk_y(p)
		if cr.has("y"):
			fy = lerpf(float(cr["y"]), fy, 1.0 - exp(-dt * 10.0))
		cr["y"] = fy
		a.position = Vector3(p.x, fy, p.y)
		var look: Vector2 = (to - from) if state in ["wait", "cross"] else ((from - to) if state == "back" else cr.get("away", to - from))
		if state == "away" and float(cr["a_off"]) >= float(cr["away_len"]):
			look = cr["out"]
		if look != Vector2.ZERO:
			a.face(Vector3(look.x, 0, look.y))
		_people_awake(a, p)

## Over the road: off along the pavement, a step back from the kerb, whichever way it runs
## further before meeting another road's asphalt or a building (up to 15 m), and there wait.
func _away_from(cr: Dictionary, z: Array) -> void:
	var from: Vector2 = cr["a"]
	var to: Vector2 = cr["b"]
	var end: Vector2 = to if float(cr["s"]) >= 1.0 else from
	var out := (end - (from + to) * 0.5).normalized()
	var way: Vector2 = z[3]
	var best := -1.0
	for sgn: float in ([1.0, -1.0] if _people_rng.randf() < 0.5 else [-1.0, 1.0]):
		var dir := way * sgn
		var go := 0.0
		while go < 15.0:
			var q := end + out * 0.9 + dir * (go + 1.5)
			if not _off_road(q, 0.3) or _push_out(q, 0.35, false) != Vector2.ZERO:
				break
			go += 1.5
		if go > best:
			best = go
			cr["away"] = dir
	cr["away_len"] = best
	cr["out"] = out
	cr["a_off"] = 0.0

## idle crossers to the zebras near the car (ahead of it rather than behind, and where
## there is life about), one each
func _send_crossers() -> void:
	var busy := {}
	for cr: Dictionary in _crossers:
		if cr["state"] != "off":
			busy[int(cr["ni"])] = true
	var look := _fwd()
	var near: Array = []
	for ni: int in _crossing_nodes:
		var to := _nodes[ni] - _pos
		var d := to.length()
		# only where they would not be seen to appear (beyond the distance people are drawn
		# at, or behind): popping up at the kerb in front of the car read as a teleport
		if d <= CROSS_NEAR + 40.0 and _unseen(_nodes[ni]) and not (d > 45.0 and to.dot(look) < 0.0):
			near.append(ni)
	for cr: Dictionary in _crossers:
		if cr["state"] != "off":
			continue
		var pick := -1
		for _try in range(8):
			if near.is_empty():
				break
			var ni: int = near[_people_rng.randi() % near.size()]
			if busy.has(ni) or _people_rng.randf() > _liveliness(_nodes[ni]) + 0.35 or _zebra_geom(ni).is_empty():
				continue
			pick = ni
			break
		if pick < 0:
			return
		busy[pick] = true
		var z := _zebra_geom(pick)
		var along: Vector2 = (z[3] as Vector2) * _people_rng.randf_range(-0.8, 0.8)
		var span := _zebra_span(z)
		if span.is_empty():
			continue   # (next time, another crossing)
		var flip := _people_rng.randf() < 0.5
		if not _unseen((span[1] if flip else span[0]) + along):
			continue   # (the kerb they wait at, not only the crossing's middle, out of sight)
		cr["ni"] = pick
		cr["a"] = (span[1] if flip else span[0]) + along
		cr["b"] = (span[0] if flip else span[1]) + along
		cr["s"] = 0.0
		cr["a_off"] = 0.0
		cr["state"] = "wait"
		cr["t"] = _people_rng.randf_range(1.0, 5.0)
		cr.erase("y")
		# a crossing at a junction with lights: they go with the lights (the same as the walk
		# lights over it, see _zebra_light)
		cr["sig"] = _zebra_light(pick)
		cr["sig_dir"] = z[3]
		var a: Actor3D = cr["actor"]
		a.visible = true
		a.play("Idle", true, _people_rng.randf_range(0.8, 1.1))

## the people (walkers, those at crossings) within r of p
func _people_near(p: Vector2, r: float) -> Array:
	var out: Array = []
	for w: Dictionary in _walkers:
		var a: Actor3D = w["actor"]
		if a.visible and Vector2(a.position.x, a.position.z).distance_to(p) < r:
			out.append(a.position)
	for cr: Dictionary in _crossers:
		var a: Actor3D = cr["actor"]
		if a.visible and Vector2(a.position.x, a.position.z).distance_to(p) < r:
			out.append(a.position)
	return out

## autodrive: anyone on the lane ahead -- crossing, hurrying back, stepping aside off a
## pavement, walking over a side street's mouth -- or about to be: stopped for, whatever the
## crossing rules say (the speed allowed, or INF). Each person is looked for where they are
## and where they will be by the time the car gets to them (their pace over the last ticks,
## up to 2 s on). Looking only at where they stood, a walker stepping over a side street's
## mouth at 1.5 m/s was seen once already in the lane 3-5 m off the nose: route 9 hit people
## at 23 and 32 km/h (tests/people_near.gd: 4 "into the lane too late" over 9 km of Bedford).
var _ap_ppl_at := {}                  ## a person's id -> [where last physics frame, their pace]
var _ap_ppl_frame := -1

func _ap_people_v() -> float:
	if _ap_pts.size() < 2:
		return INF
	var people: Array = []   # [id, where]
	for cr: Dictionary in _crossers:
		if cr["state"] in ["cross", "back"]:
			var a: Actor3D = cr["actor"]
			people.append([a.get_instance_id(), Vector2(a.position.x, a.position.z)])
	for w: Dictionary in _walkers:
		var a: Actor3D = w["actor"]
		if a.visible:
			people.append([a.get_instance_id(), Vector2(a.position.x, a.position.z)])
	# their pace, once a physics frame (tests call this between frames too)
	var frame := Engine.get_physics_frames()
	if frame != _ap_ppl_frame:
		var dt := get_physics_process_delta_time() * (frame - _ap_ppl_frame if _ap_ppl_frame >= 0 else 1)
		_ap_ppl_frame = frame
		var now := {}
		for e: Array in people:
			var was: Array = _ap_ppl_at.get(e[0], [])
			var pace := Vector2.ZERO
			if not was.is_empty() and dt > 0.0:
				var step: Vector2 = ((e[1] as Vector2) - (was[0] as Vector2)) / dt
				# (a walker put down somewhere else jumps: no pace from that)
				pace = (was[1] as Vector2).lerp(step, 0.3) if step.length() < 4.0 else Vector2.ZERO
			now[e[0]] = [e[1], pace]
		_ap_ppl_at = now
	var fwd := _fwd()
	var sp := maxf(absf(_v), 2.0)
	var best := INF
	for e: Array in people:
		var p: Vector2 = e[1]
		if p.distance_squared_to(_pos) > 1600.0 or (p - _pos).dot(fwd) < 0.0:
			continue
		var pace: Vector2 = (_ap_ppl_at.get(e[0], [p, Vector2.ZERO]) as Array)[1]
		var stop := _ap_person_stop(p)
		if pace.length() > 0.3:
			# where they will be when the car is level with them (the car at its own pace;
			# a walker going along the pavement beside the lane stays out of it)
			var t := clampf((p - _pos).dot(fwd) / sp, 0.0, 2.0)
			stop = minf(stop, _ap_person_stop(p + pace * t))
		if stop < INF:
			best = minf(best, sqrt(2.0 * 3.5 * maxf(stop - 0.3, 0.0)))
	return best

## how far the car can go before stopping short of someone at p on its lane (INF: not on it)
func _ap_person_stop(p: Vector2) -> float:
	var base := -_ap_pts[0].distance_to(Geometry2D.get_closest_point_to_segment(_pos, _ap_pts[0], _ap_pts[1]))
	var look := maxf(32.0, absf(_v) * absf(_v) / 7.0 + 12.0)
	for j in range(_ap_pts.size() - 1):
		if base > look:
			break
		var a := _ap_pts[j]
		var b := _ap_pts[j + 1]
		var cp := Geometry2D.get_closest_point_to_segment(p, a, b)
		if cp.distance_to(p) < 1.7:
			return base + a.distance_to(cp) - CAR_OFF - 2.8
		base += a.distance_to(b)
	return INF

const ZEBRA_PAST := 2.8              ## m from a car's lane line along the crossing: past it (half a bus and 1.5 m)...
const ZEBRA_PAST_ME := 6.0           ## ...the player's: past the 5.5 m at which people run back from it to their kerb
                                     ## (going by at 2.8 m, autodrive sent them back across its way: zebra_halves)
var _zebra_past := true              ## (tests turn it off to compare: tests/knot_stops.gd ZEBRA_OLD=1)

## A crossing with someone on it, met by a car's lane at cp: is the person clear of that car's
## half of the road -- over on the far carriageway of a divided road, or not on it yet nor
## about to be? On a divided road people cross the lot, kerb to kerb (18 to 22 m on
## Givatayim's, some 15 s on foot), and a car on one half waited for all of it: it stood
## through most of its green for someone on the other half, then through a whole red -- 41 s
## on the route set's first drive. A road that is not divided is one half: they wait for all
## of it. A filmed walk's crossing (no one person on it): never clear.
func _zebra_clear(z: Array, cp: Vector2, past := ZEBRA_PAST) -> bool:
	if z.size() < 5:
		return false
	var on := _nearest_seg(cp, 6.0, true)
	if on.is_empty():
		return false
	var hw := float((_roads[on["road"]] as Dictionary)["w"]) * 0.5
	var lat := ((z[3] as Vector2) - (on["q"] as Vector2)).dot(z[2])
	var pace: float = z[4]
	# past this car's lane and walking away from it: clear, as a driver goes once the person
	# is by the car's side. Waiting till they reached the far kerb of a two-way street, a car
	# turning in stood in the middle of the junction with the cars behind it ("stops in the
	# middle that cause chaos": tests/knot_stops.gd, 7 cars in 7 minutes at one junction)
	var off := ((z[3] as Vector2) - cp).dot(z[2])
	if _zebra_past and absf(off) > past and off * pace > 0.0:
		return true
	if absf(lat) < hw + 1.0:
		return false   # on my half, or at its edge
	if lat * pace < 0.0 and absf(lat) < hw + 1.0 + absf(pace) * 2.5:
		return false   # coming my way: on it in a moment
	return true

## autodrive: stop short of a crossing with someone on it (the speed allowed now, or INF)
func _ap_zebra_v() -> float:
	if _zebras_on.is_empty() or _ap_pts.size() < 2:
		return INF
	var best := INF
	for z: Array in _zebras_on:
		var mid: Vector2 = z[0]
		if mid.distance_to(_pos) > 70.0:
			continue
		var base := -_ap_pts[0].distance_to(Geometry2D.get_closest_point_to_segment(_pos, _ap_pts[0], _ap_pts[1]))
		for j in range(_ap_pts.size() - 1):
			if base > 70.0:
				break
			var a := _ap_pts[j]
			var b := _ap_pts[j + 1]
			var cp := Geometry2D.get_closest_point_to_segment(mid, a, b)
			if cp.distance_to(mid) < float(z[1]):
				if _zebra_clear(z, cp, ZEBRA_PAST_ME):
					break   # (on the other half, or not there yet)
				var stop := base + a.distance_to(cp) - 4.5 - CAR_OFF
				if stop > -1.5:
					best = minf(best, sqrt(2.0 * 2.6 * maxf(stop - 0.3, 0.0)))
				break
			base += a.distance_to(b)
	return best

## ---- giving way at a junction (autodrive) ------------------------------------------------
## Coming to a junction: the cars that go before it there, and whether the gap ahead of the
## first of them is big enough to go in and clear its way. If not, autodrive stops at the
## junction's edge and waits. Who goes first is traffic.gd's rule (_junction_ahead) from this
## side: a car in the junction already; at lights the green says (with mine green I still let
## one going straight on its green by when I turn across it); without, the bigger road (a
## roundabout's ring above all, a way in with a give-way or stop sign below all), then between
## equals one going straight before one turning, then whoever gets there first. Whether two
## ways meet is read from the two paths themselves: they cross, or end in the same lane.
## Before this autodrive stopped only for a car already on its lane: it pulled out of side
## streets in front of cars on the main road, and they (traffic always lets the player go)
## stood on their brakes for it -- 7.5 m/s^2 in every meeting give_way.gd staged.
const AP_GAP := 1.5                  ## s to spare between clearing a car's way and it getting there
const AP_GIVE_PATIENT := 12.0        ## s standing, after which a smaller gap will do
const AP_KNOT := 18.0                ## junction points closer than this after the first: one junction
var _ap_giving := {}                 ## the nodes of the junction autodrive gives way at (traffic does not wait for it there)
var _ap_give_car := -1               ## the car it waits for (the head turns to it), or -1
var _ap_give_t := 0.0                ## seconds standing, giving way
var _ap_give_us := 0                 ## microseconds spent in _ap_give_v, all told (tests/give_way.gd: its cost a tick)
var _ap_js: Array = []               ## the junctions on the plan ahead: [metres along it, node], nearest first...
var _ap_js_odo := 0.0                ## ...as the odometer stood when they were found (every 0.25 s)
var _ap_js_t := 0.0
var _ap_js_head := Vector2.INF       ## (the plan's first point then: a new plan, found afresh)
var _ap_median_ok := true            ## waits in a divided road's middle where the car fits (tests/median_wait.gd turns it off to compare)
var _median_gaps := {}               ## Vector2i(n1, n2) -> _median_gap's answer, worked out once
var _median_far := {}                ## ...and the far carriageway's half width (where to stop in the middle)
const AP_MEDIAN_SPARE := 1.2         ## m beyond the car's length a median needs to be waited in (both ends and the stop's error)

## traffic car o on my level: both on the ground (a hill between us is not a level -- 50-80 m
## off on Givatayim's slopes the car coming was 3-4 m below and was passed over as if on a
## bridge), else within 2.5 m and a slope's rise over the distance between us
func _same_level(o) -> bool:
	if absf(_y - _h(_pos)) < 1.0 and absf(float(o.y) - _h(o.pos)) < 1.0:
		return true
	return absf(float(o.y) - _y) <= 2.5 + 0.08 * (o.pos as Vector2).distance_to(_pos)

## Room to stand in the middle of a divided road between its junction points n1 and n2 (one
## on each carriageway, joined by a short road of their own across the middle, no lights at
## either): metres between the two carriageways' edges, less a car and a little either end;
## below 0, none. There a driver crosses the near carriageway when it is clear and waits in
## the middle for the far one. Taken as one junction (AP_KNOT), autodrive stood at the kerb
## for a gap in both streams at once. (Most medians where a street crosses are narrower than
## that -- Ashdod's eight first: 2-4.5 m between the edges -- and stay one junction.)
func _median_gap(n1: int, n2: int) -> float:
	var key := Vector2i(n1, n2)
	if _median_gaps.has(key):
		return _median_gaps[key]
	var out := -1.0
	if not _sig_set.has(n1) and not _sig_set.has(n2):
		for e: Vector2i in _node_roads[n1]:
			var r: Dictionary = _roads[e.x]
			var ids: PackedInt32Array = r["ids"]
			if not r["drive"] or r.has("median") or r.get("ring", false) or ids.size() < 2:
				continue
			if not ((ids[0] == n1 and ids[ids.size() - 1] == n2) or (ids[0] == n2 and ids[ids.size() - 1] == n1)):
				continue
			var wa := -1.0
			var wb := -1.0
			var a := -1
			for e1: Vector2i in _node_roads[n1]:
				if (_roads[e1.x] as Dictionary).has("median"):
					a = e1.x
					wa = float(_roads[e1.x]["w"])
			for e2: Vector2i in _node_roads[n2]:
				if (_roads[e2.x] as Dictionary).has("median") and e2.x != a:
					wb = float(_roads[e2.x]["w"])
			if wa < 0.0 or wb < 0.0:
				continue
			var L := 0.0
			var pts: PackedVector2Array = r["pts"]
			for i in range(pts.size() - 1):
				L += pts[i].distance_to(pts[i + 1])
			if L > AP_KNOT + 6.0 or L > _nodes[n1].distance_to(_nodes[n2]) * 1.3:
				continue   # (not straight across: a lane looping round between the two, 252 m long)
			out = L - (wa + wb) * 0.5 - (CAR_LEN + AP_MEDIAN_SPARE)
			_median_far[key] = wb * 0.5
			break
	_median_gaps[key] = out
	return out

func _ap_split(n1: int, n2: int) -> bool:
	return _ap_median_ok and _median_gap(n1, n2) >= 0.0

var _ap_mid := Vector2i(-1, -1)       ## the median on the plan it can wait in: [near point, far point]

## where the car's middle stops for junction j of _ap_give_v's list ([along, node, enter,
## leave]): the nose a metre short of where the plan comes in; in a median, 0.4 m short of the
## far carriageway's edge (where the plan comes into its radius, its tail was still in the
## near carriageway's lanes)
func _ap_edge_of(j: Array) -> float:
	if int(j[1]) == _ap_mid.y:
		return float(j[0]) - float(_median_far.get(_ap_mid, 0.0)) - 0.4 - CAR_LEN * 0.5
	return float(j[2]) + 0.5 - CAR_LEN * 0.5

## the point `along` metres along the plan (cum: the distance to each of its points)
func _ap_at(cum: PackedFloat32Array, along: float) -> Vector2:
	var n := mini(cum.size(), _ap_pts.size())
	if along <= cum[0]:
		return _ap_pts[0]
	for i in range(1, n):
		if cum[i] >= along:
			var f := (along - cum[i - 1]) / maxf(cum[i] - cum[i - 1], 0.001)
			return _ap_pts[i - 1].lerp(_ap_pts[i], f)
	return _ap_pts[n - 1]

func _rank_of(r: Dictionary) -> int:
	return 10 if r.get("ring", false) else int(ROAD_RANK.get(r["k"], 1))

func _ap_give_v(dt: float) -> float:
	_ap_give_car = -1
	var was := _ap_giving   # (holding for these last tick)
	_ap_giving = {}
	if _traffic == null or _ap_pts.size() < 2:
		_ap_give_t = 0.0
		return INF
	# the plan ahead, the distance along it to each point
	var reach := 26.0 + absf(_v) * 1.8
	var cum := PackedFloat32Array()
	var base := -_ap_pts[0].distance_to(Geometry2D.get_closest_point_to_segment(_pos, _ap_pts[0], _ap_pts[1]))
	cum.append(base)
	for i in range(1, _ap_pts.size()):
		base += _ap_pts[i - 1].distance_to(_ap_pts[i])
		cum.append(base)
		if base > reach + 45.0:
			break
	# the junctions on it (graph nodes of three ways or more) and how far along: found afresh
	# every quarter second (or for a new plan), in between moved up by the distance driven.
	# Every road segment by every point of the plan, every tick, was a millisecond or two.
	_ap_js_t -= dt
	if _ap_js_t <= 0.0 or _ap_js_head != _ap_pts[0]:
		_ap_js_t = 0.25
		_ap_js_head = _ap_pts[0]
		_ap_js_odo = _odo
		var seen := {}
		for i in range(cum.size()):
			if cum[i] < -15.0:
				continue
			for code: int in _near(_seg_hash, _ap_pts[i], 3.0, SEG_CELL):
				var ids: PackedInt32Array = (_roads[code / 4096] as Dictionary)["ids"]
				var sj := code % 4096
				for n: int in [ids[sj], ids[sj + 1]]:
					if not seen.has(n) and _nodes[n].distance_squared_to(_ap_pts[i]) < (_node_r[n] + 6.0) * (_node_r[n] + 6.0):
						seen[n] = true
		_ap_js = []
		for n: int in seen:
			if _traffic._ways_out(n) < 3:
				continue
			var bd := INF
			var along := 0.0
			for i in range(cum.size() - 1):
				var q := Geometry2D.get_closest_point_to_segment(_nodes[n], _ap_pts[i], _ap_pts[i + 1])
				var d := q.distance_squared_to(_nodes[n])
				if d < bd:
					bd = d
					along = cum[i] + _ap_pts[i].distance_to(q)
			if bd >= (_node_r[n] + 5.0) * (_node_r[n] + 5.0):
				continue
			# where the plan comes into the junction and leaves it (within its radius and a
			# metre and a half): the way in and out are read there. Read either side of the point
			# nearest the middle, a left turn's way in came out along the road it turns onto --
			# the way the car coming along it goes -- and that car was passed over as following.
			var rr := _node_r[n] + 1.5
			var enter := along
			var leave := along
			var found_in := false
			for i in range(cum.size() - 1):
				var a := _ap_pts[i]
				var b := _ap_pts[i + 1]
				var steps := maxi(1, ceili(a.distance_to(b)))
				for t in range(steps + 1):
					var p := a.lerp(b, float(t) / steps)
					if p.distance_to(_nodes[n]) <= rr:
						var at_c := cum[i] + a.distance_to(p)
						if not found_in:
							enter = at_c
							found_in = true
						leave = at_c
					elif found_in and cum[i] + a.distance_to(p) > along + rr * 2.0:
						break
			_ap_js.append([along, n, enter, leave])
		_ap_js.sort_custom(func(a: Array, b: Array) -> bool: return a[0] < b[0])
	var moved := _odo - _ap_js_odo
	var js: Array = []
	for j: Array in _ap_js:
		js.append([float(j[0]) - moved, j[1], float(j[2]) - moved, float(j[3]) - moved])
	# the first not yet driven into, and the rest of the same junction after it
	# (one it was holding for counts as not yet driven into until its nose is at the middle: the
	# car stops a metre or two past its line, and at -1 it read that as in, and went)
	# a divided road's middle on the way, deep enough to wait in: [near point, far point], kept
	# while the far one is ahead (the near one drops off the list behind the car)
	for k in range(1, js.size()):
		if _ap_split(int(js[k - 1][1]), int(js[k][1])):
			_ap_mid = Vector2i(int(js[k - 1][1]), int(js[k][1]))
			break
	var mid_ahead := false
	for j: Array in js:
		mid_ahead = mid_ahead or int(j[1]) == _ap_mid.y
	if not mid_ahead:
		_ap_mid = Vector2i(-1, -1)
	var first := -1
	for k in range(js.size()):
		var n: int = js[k][1]
		var past := -(_node_r[n] + 1.0) if was.has(n) else -1.0
		if _ap_edge_of(js[k]) >= past:
			first = k
			break
	if first < 0 or float(js[first][0]) > reach + 20.0:
		_ap_give_t = 0.0
		return INF
	if first > 0:
		var pn: int = js[first - 1][1]
		if float(js[first - 1][0]) > -(_node_r[pn] + CAR_LEN * 0.5) and float(js[first][0]) - float(js[first - 1][0]) < AP_KNOT \
				and not _ap_split(pn, int(js[first][1])):
			_ap_give_t = 0.0
			return INF   # in the junction already: through it, not stopping in the middle
	var n0: int = js[first][1]
	var edge := _ap_edge_of(js[first])
	if _v * _v > 2.0 * 5.0 * maxf(edge, 0.0) + 1.0 and not was.has(n0):
		_ap_give_t = 0.0
		return INF   # too late to stop short of it
	var stop := sqrt(2.0 * 2.6 * maxf(edge - 1.2, 0.0))   # (it runs a metre or so past where it aims)
	# the road I come in on, and its rank (a sign on my way in: below everything)
	var in0 := (_ap_at(cum, float(js[first][2])) - _ap_at(cum, float(js[first][2]) - 6.0)).normalized()
	var on := _nearest_seg(_ap_at(cum, float(js[first][2]) - 3.0), 8.0, true, false, _y)
	var my_rank := _rank_of(_roads[on["road"]]) if not on.is_empty() else 1
	# (in a divided road's middle, the far carriageway next: below it, whatever road it came from)
	if not _sign_rule(n0, in0).is_empty() or n0 == _ap_mid.y:
		my_rank = -1
	var gap := AP_GAP if _ap_give_t < AP_GIVE_PATIENT else 0.3
	var hold := false
	var hold_car := -1
	var hold_d := INF
	for k in range(first, js.size()):
		var along: float = js[k][0]
		var enter: float = js[k][2]
		var leave: float = js[k][3]
		var n: int = js[k][1]
		if along - float(js[first][0]) > AP_KNOT or (k > first and _ap_split(int(js[k - 1][1]), n)):
			break   # (the rest is the far carriageway: waited for in the middle)
		var r := _node_r[n]
		var my_in := (_ap_at(cum, enter) - _ap_at(cum, enter - 6.0)).normalized()
		var my_out := (_ap_at(cum, leave + 6.0) - _ap_at(cum, leave)).normalized()
		if my_in == Vector2.ZERO:
			my_in = _fwd()
		if my_out == Vector2.ZERO:
			my_out = my_in   # (the plan ends at it: a choice still to make)
		var my_turn := my_in.dot(my_out) < 0.85
		# the seconds to get there and through it from here: at the plan's own speed through it
		# (a corner's), not pulling away flat out -- reckoned that way it judged it could get in
		# first, then slowed for its turn and the car on the main road stood on its brakes
		var v_in := 13.9
		for i in range(cum.size()):
			if cum[i] > along - r - 2.0 and cum[i] < along + r + 6.0 and i < _ap_v.size() and _ap_v[i] > 0.0:
				v_in = minf(v_in, _ap_v[i])
		v_in = maxf(v_in, 3.0)
		var v0 := maxf(_v, 0.0)
		var my_t := maxf(along, 0.0) / maxf((v0 + v_in) * 0.5, 1.5)   # (there, at that pace)
		var clear_t := my_t + (2.0 * r + CAR_LEN) / v_in
		# my way through it: the plan from a little before it to a little after
		var mine := PackedVector2Array()
		mine.append(_ap_at(cum, maxf(enter - 4.0, cum[0])))
		for i in range(cum.size()):
			if cum[i] > enter - 4.0 and cum[i] < leave + 8.0:
				mine.append(_ap_pts[i])
		mine.append(_ap_at(cum, leave + 8.0))
		var sig := _sig_set.has(n)
		var my_light := _light_at(n, my_in) if sig else ""
		if sig and my_light not in ["g", ""]:
			continue   # (the light holds me: _ap_light_v)
		for oi in range(_traffic.cars.size()):
			var o = _traffic.cars[oi]
			if not o.alive or o.pos.distance_squared_to(_nodes[n]) > 12100.0 or not _same_level(o):
				continue
			# where n comes on its way, up to 110 m ahead (traffic's own look, 55 m, is 4.6 s at
			# 12 m/s: less than the gap wanted, and a car further off was not seen coming)
			var ok := -1
			for q in range(maxi(o.k - 3, 0), o.pts.size()):
				var qd: float = o.cum[q] - o.s
				if qd > 110.0:
					break
				if o.node[q] == n and qd > -(r + 5.0):
					ok = q
					break
			if ok < 0:
				continue
			var od: float = o.cum[ok] - o.s
			var theirs: Array = _traffic._arrival(o, ok, n)
			if (theirs[0] as Vector2).dot(my_in) > 0.85:
				continue   # coming my way: behind me, or ahead on my lane (the car-ahead check's)
			var in_it: bool = od - o.len * 0.5 < r + 1.0
			if o.v < 0.5 and not in_it:
				continue   # standing short of it: waiting for something (a light, a queue, me)
			# their way through it from where they are, on their lane: its two ends put in between
			# their points (a long straight street has few: none within the window, and the car
			# was passed over as having no way through at all)
			var w0: float = maxf(o.s, o.cum[ok] - r - 8.0)
			var w1: float = o.cum[ok] + r + 8.0
			if w1 <= w0:
				continue
			var path := PackedVector2Array([_traffic._at(o, w0)])
			for q in range(maxi(o.k, 0), o.pts.size()):
				var c_at: float = o.cum[q]
				if c_at <= w0:
					continue
				if c_at >= w1:
					break
				path.append(o.pts[q])
			path.append(_traffic._at(o, w1))
			if o.shift != 0.0:   # (in a lane to the left of the line: shift metres)
				for q in range(path.size()):
					var dq := (path[mini(q + 1, path.size() - 1)] - path[maxi(q - 1, 0)]).normalized()
					path[q] += Vector2(dq.y, -dq.x) * o.shift
			var meet := false
			for a in range(mine.size() - 1):
				for b in range(path.size() - 1):
					if Geometry2D.segment_intersects_segment(mine[a], mine[a + 1], path[b], path[b + 1]) != null:
						meet = true
						break
				if meet:
					break
			if not meet:
				# or passing so close the bodies would touch (two turns through the same corner
				# of a junction that miss each other by a metre or two)
				for a in range(mine.size()):
					for b in range(path.size() - 1):
						if Geometry2D.get_closest_point_to_segment(mine[a], path[b], path[b + 1]).distance_squared_to(mine[a]) < 2.4 * 2.4:
							meet = true
							break
					if meet:
						break
			if not meet and (theirs[1] as Vector2).dot(my_out) > 0.85:
				# into the same lane after it: one behind the other, too close
				meet = absf((path[path.size() - 1] - mine[mine.size() - 1]).dot(Vector2(-my_out.y, my_out.x))) < 2.0
			if not meet:
				continue
			var o_eta := maxf(od - r - 1.0 - o.len * 0.5, 0.0) / maxf(o.v, 1.0)
			var theirs_first := in_it
			if not theirs_first:
				var o_turn: bool = (theirs[0] as Vector2).dot(theirs[1]) < 0.85
				if sig:
					var lt := _light_at(n, theirs[0])
					if lt == "g":
						theirs_first = my_turn and not o_turn
					elif o.v > 2.0 and _traffic._in_site(o, n):
						theirs_first = true   # clearing it on the last of its green
				else:
					var o_rank: int = theirs[2]
					if not _sign_rule(n, theirs[0]).is_empty():
						o_rank = -1
					# a car coming to a roundabout along another way in is not on the ring yet: it
					# gives way where it comes in itself, so it is my equal (first come, first
					# served), not the ring. (Ranked by the ring it would be on by the time it got
					# here, autodrive stood 11 s at the ring's edge for a motorbike 78 m off up
					# another arm -- "pretty bad in roundabouts, waiting for a long time",
					# Givatayim's Geisler square; tests/light_line.gd)
					if o_rank == 10 and my_rank < 10:
						var o_on := _nearest_seg(o.pos, 6.0, true, false, _y)
						if not o_on.is_empty() and not bool((_roads[int(o_on["road"])] as Dictionary).get("ring", false)):
							o_rank = my_rank
					if o_rank != my_rank:
						theirs_first = o_rank > my_rank
					elif my_turn != o_turn:
						theirs_first = my_turn
					else:
						# first come, first served -- and to count as first it must be clearly so,
						# reckoned at its pace through the corner: by its speed coming up to it, it
						# was 2 s ahead, slowed for the turn, got there 1.5 s ahead, and the car
						# (turning too) stood on its brakes
						theirs_first = o_eta < my_t + 1.0
			if not theirs_first:
				continue
			if in_it or o_eta < clear_t + gap:
				# waited long (a stream of cars, a few seconds apart: 40 s on Ashdod's HaSachlav):
				# one far enough off to slow down comfortably lets it out, as drivers in a stream
				# do -- traffic waits for it then (it can stop: see traffic's _junction_ahead)
				if not in_it and _ap_give_t > AP_GIVE_PATIENT and od - r - 1.0 - o.len * 0.5 > o.v * o.v / (2.0 * 2.5) + 4.0:
					continue
				hold = true
				if od < hold_d:
					hold_d = od
					hold_car = oi
	if not hold:
		_ap_give_t = 0.0
		# a side street coming out on a bigger road with no lights: up to it at a pace it can
		# stop from, looking (it came out at 30 km/h and only then saw what was coming)
		# (not a slip road merging: that is joined at speed, the gap test is enough)
		var my_kind := String((_roads[on["road"]] as Dictionary)["k"]) if not on.is_empty() else ""
		if not _sig_set.has(n0) and my_rank >= 0 and not my_kind.ends_with("_link"):
			for e: Vector2i in _node_roads[n0]:
				var rr: Dictionary = _roads[e.x]
				if rr["drive"] and _rank_of(rr) > my_rank:
					return sqrt(25.0 + 2.0 * 2.6 * maxf(edge, 0.0))
		return INF
	for k in range(first, js.size()):
		if float(js[k][0]) - float(js[first][0]) > AP_KNOT or (k > first and _ap_split(int(js[k - 1][1]), int(js[k][1]))):
			break
		_ap_giving[int(js[k][1])] = true
	_ap_give_car = hold_car
	if absf(_v) < 0.3:
		_ap_give_t += dt
	return stop

## A lane point for centre-line point p (road direction d): `lane` to the right, or less,
## or the middle, or a little to the left, whichever first leaves the car room (nose, middle
## and tail). OSM rarely says how wide a street is; the guess is 8 m, and in the old narrow
## streets the "right-hand lane" of that guess ran into the buildings and the parked cars.
func _clear_lane(p: Vector2, d: Vector2, lane: float) -> Vector2:
	var right := Vector2(-d.y, d.x)
	for off: float in [lane, lane * 0.6, lane * 0.25, 0.0, -0.7, 0.7]:
		var q := p + right * off
		if _push_out(q, 1.2, true, false, _y) == Vector2.ZERO and _push_out(q + d * 1.4, 1.15, true, false, _y) == Vector2.ZERO \
				and _push_out(q - d * 1.4, 1.15, true, false, _y) == Vector2.ZERO:
			return q
	return p + right * lane

## ---- collisions: the car's two circles against building outlines and posts -------------

func _collide() -> void:
	var fwd := _fwd()
	var total := Vector2.ZERO
	_knock_hit = -1
	var at_front := Vector2.ZERO
	var at_back := Vector2.ZERO
	# a few passes: out of a wall can be into a tree, and one push each left the car
	# jittering between the two, stuck
	# (you driving, or racer: autodrive keeping the rules leans on a kerb railing as before --
	# breaking through one on Moshe Dayan's bend it touched the post behind it, racer.gd's test)
	_smash = absf(_v) > SMASH_V and not _walking and (not _auto or _racing())
	_smashed = ""
	for _pass in range(3):
		var moved := false
		for off: float in [CAR_OFF, -CAR_OFF]:
			var p := _push_out(_pos + fwd * off, CAR_R, true, true, _y)
			if not _walking:
				p += _people_push(_pos + fwd * off + p, CAR_R)
			p += _steep_push(_pos + fwd * off + p, CAR_R, _y)
			p += _deep_push(_pos + fwd * off + p, CAR_R, _y)
			if p != Vector2.ZERO:
				total += p
				_pos += p
				moved = true
				if off > 0.0:
					at_front += p
				else:
					at_back += p
		if not moved:
			break
	_smash = false
	if _smashed != "":
		_smash_through()
	if total == Vector2.ZERO:
		return
	# a bin, a recycling bin or a bollard: knocked over or bent (_knock), not a wall to stop at --
	# whatever else it touched in the same moment (a bin between two parked cars: the last
	# thing touched was a car's bumper, and the bin stopped the car like a wall)
	if _knock_hit >= 0 and absf(_v) > 1.2 and _knockable.has(_knock_hit):
		_pos -= total
		_knock(_knock_hit)
		return
	if _knock_hit >= 0 and absf(_v) > SIGN_BEND_V and _signs_at.has(_knock_hit):
		_pos -= total
		_bend_sign(_knock_hit)
		return
	_touch_t = 0.5
	var n := total.normalized()
	var right := Vector2(-fwd.y, fwd.x)
	# where it touched: the end that was pushed the more, its edge toward what it hit
	var end := _pos + fwd * (CAR_OFF if at_front.length() >= at_back.length() else -CAR_OFF)
	var touch := end - n * CAR_R
	_contact = Vector3(touch.x, _y + 0.45, touch.y)
	_contact_n = n
	var vel := fwd * _v + right * _v_lat
	var vn := vel.dot(n)
	if vn < 0.0:
		var impact := -vn
		# a real knock bounces a little; leaning on a wall at walking pace does not (the
		# bounce back and push in again was a judder that held the car there)
		vel -= n * vn * (1.0 + (BOUNCE if impact > 2.0 and not _soft_hit() else 0.0))
		# a knock off one end turns the car about the other, as a real one does -- a little:
		# it used to spin it like a top and hop it off the ground, more pinball than crash
		if impact > 2.0:
			var lever := (at_front - at_back).dot(right) / maxf(at_front.length() + at_back.length(), 0.001)
			_spin = clampf(_spin + lever * impact * 0.07, -1.4, 1.4)
		# scraping along it: the harder it hit, the more speed the scrape takes, so a
		# glancing touch slides on and a head-on stops. (It used to lose 6% every tick in
		# contact, which glued the car to anything it touched.)
		var along := vel - n * vel.dot(n)
		# scraping along it at speed: sparks off the paint and the metal
		if along.length() > 3.0 and _last_hit != "person":
			_sparks_at(_contact, Vector3(n.x, 0.3, n.y), 0.5)
		vel -= along.limit_length(impact * WALL_GRIP)
		_crash(impact)
		# a real knock stuns the car hit (2.5 s); leaning on it does not. Every touch used
		# to, so a car autodrive pressed against never pulled away, and both stood there
		# (the exam: a hatch "held by the limit" 20 s with autodrive pushing into it)
		if _last_hit.begins_with("car ") and impact > 1.2:
			_traffic.bumped(int(_last_hit.substr(4)))
	_v = vel.dot(fwd)
	_v_lat = clampf(vel.dot(right), -7.0, 7.0)

## through something that gives (see _smash): a little of the speed, and what it was made of
## flying -- leaves from a hedge, sparks and a knock from a railing or a wall. Once a second
## at most for the sound and the shake: a hedge is a long run of wall segments.
var _smash_cool := 0.0
func _smash_through() -> void:
	var i := int(_smashed.substr(5)) if _smashed.begins_with("wall ") else -1
	var hedge := i >= 0 and i < _wall_soft.size() and _wall_soft[i] == 1
	_v *= 0.985 if hedge else 0.97   # (each tick in it: a hedge drags, a railing knocks)
	var at := Vector3(_pos.x, _y + 0.5, _pos.y) + Vector3(_fwd().x, 0.0, _fwd().y) * (CAR_OFF + CAR_R)
	if _smash_cool > 0.0:
		return
	_smash_cool = 0.6
	_knocked_n += 1
	_knocked_what = "through a hedge" if hedge else "through " + _smashed.get_slice(" ", 0)
	if hedge:
		_leaves_at(at, Vector3(_fwd().x, 0.6, _fwd().y), 0.8)
		Audio.play("impact_soft", 0.1, -6.0)
	else:
		_sparks_at(at, Vector3.UP, 0.6)
		shake3d(0.8)
		Audio.play("impact_punch", 0.1, -6.0)
	Probe.event("smash", {"what": _knocked_what, "kmh": int(absf(_v) * 3.6)})

func _crash(speed: float) -> void:
	if speed < 1.2 or _crash_cool > 0.0:
		return
	_crash_cool = 0.4
	if _last_hit == "person":   # the car stops at them, a soft knock: never a bang
		Audio.play("impact_soft", 0.1, -10.0)
		Probe.event("crash", {"kmh": int(speed * 3.6), "hit": _last_hit, "at": Vector2i(_pos)})
		return
	if _auto and (_last_hit.begins_with("building") or _last_hit.begins_with("wall") or _last_hit.begins_with("post")):
		_ap_bonks += 1.0
	if _soft_hit():   # a hedge gives: leaves fly, the car is held, nothing broken
		_leaves_at(_contact, Vector3(_contact_n.x, 0.6, _contact_n.y), clampf(speed / 8.0, 0.4, 1.0))
		_v *= 0.7
		shake3d(minf(1.5, speed * 0.12))
		Audio.play("impact_soft", 0.1, -4.0)
		Probe.event("crash", {"kmh": int(speed * 3.6), "hit": "hedge", "at": Vector2i(_pos), "street": _on_name, "auto": _auto})
		return
	if speed > 2.5 and (_last_hit.begins_with("building") or _last_hit.begins_with("wall")):
		_scrape_at(_contact, _contact_n, speed)
	# what a knock leaves: sparks, a dent where it hit, glass on the road after a hard one
	if speed > 3.0:
		_sparks_at(_contact, Vector3.UP, clampf(speed / 10.0, 0.5, 1.0))
		_dent(_contact, clampf(speed / 14.0, 0.25, 1.0))
	if speed > 7.0:
		_glass_at(Vector2(_contact.x, _contact.z), speed)
	# a jolt of the camera, not a freeze-frame: the car stops dead and the view with it
	if speed > 9.0:
		shake3d(minf(4.0, speed * 0.25))
		Audio.play("impact_metal")
	elif speed > 4.0:
		shake3d(speed * 0.25)
		Audio.play("impact_punch")
	else:
		shake3d(1.0)
		Audio.play("impact_soft", 0.1, -6.0)
	Probe.event("crash", {"kmh": int(speed * 3.6), "hit": _last_hit, "at": Vector2i(_pos),
		"street": _on_name, "auto": _auto})

## ---- what breaks --------------------------------------------------------------------------
## The street's light things are knocked over by the car: a bin or a recycling bin goes flying
## and tumbles (a RigidBody3D, the one place the kit lets physics in: things that fall), a
## bollard is bent over at its foot. Each stays down while you are near and is put back
## once you are out of sight (KNOCK_BACK_S, 70 m) -- the street's furniture is drawn in
## multimeshes of its own for this (furniture._place_knock), so one copy can be hidden or
## bent. A knock on anything solid throws sparks (and so does scraping along it), leaves a
## dent in the car where it hit (CAR_SHADER's `dents`) and, a hard one, glass and bits of
## plastic on the road.
const KNOCK_BACK_S := 30.0
const KNOCKED_MAX := 12
var _knockable := {}                 ## post index -> [multimesh, copy, its transform, mesh, "tumble"/"bend", the post's radius]
var _knocked: Array = []             ## {id, k, body, ground, t}
var _contact := Vector3.ZERO         ## where the car last touched something (_collide)
var _contact_n := Vector2.ZERO       ## ... and the way it was pushed off it (out of what it hit)
var _knock_hit := -1                 ## a knockable post touched in this tick's pushes (_collide), or -1
var _knocked_n := 0                  ## things the car has knocked over or bent so far (no crash: the tests count these)
var _knocked_what := ""              ## ...and the last: "sign oneway", "knocked bin"

func _knock_add(mesh: Mesh, xforms: Array, posts: Array, seen: float, how: String) -> void:
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.mesh = mesh
	mm.instance_count = xforms.size()
	for i in range(xforms.size()):
		mm.set_instance_transform(i, xforms[i])
		var pid := int(posts[i])
		_knockable[pid] = [mm, i, xforms[i], mesh, how, _post_r[pid]]
	var mi := MultiMeshInstance3D.new()
	mi.multimesh = mm
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	mi.visibility_range_end = seen + 200.0   # (the range counts to the middle of its square)
	mi.visibility_range_end_margin = 30.0
	world.add_child(mi)

func _knock(pid: int) -> void:
	var k: Array = _knockable[pid]
	_knockable.erase(pid)
	_knocked_n += 1
	_knocked_what = "post bent" if k[4] == "bend" else "knocked over"
	var mm: MultiMesh = k[0]
	var i: int = k[1]
	var xf: Transform3D = k[2]
	_post_r[pid] = 0.0   # (not solid while it is down)
	var f := _fwd() * signf(_v)
	var way := Vector3(f.x, 0.0, f.y)
	var speed := absf(_v)
	var body: RigidBody3D = null
	var ground: StaticBody3D = null
	if k[4] == "bend":   # bent over away from the car, at its foot
		var axis := Vector3.UP.cross(way).normalized()
		mm.set_instance_transform(i, Transform3D(Basis(axis, deg_to_rad(55.0 + 20.0 * randf())) * xf.basis, xf.origin))
		Audio.play("impact_metal", 0.1, -8.0)
		shake3d(1.4)
		_v *= 0.55
		_sparks_at(xf.origin + Vector3.UP * 0.5, -way + Vector3.UP * 0.4, 0.6)
	else:   # sent flying: the standing copy hidden, a body that tumbles in its place
		mm.set_instance_transform(i, Transform3D(Basis(), Vector3(0, -500, 0)))
		body = RigidBody3D.new()
		body.mass = 15.0
		var mi := MeshInstance3D.new()
		mi.mesh = k[3]
		body.add_child(mi)
		var box := BoxShape3D.new()
		var ab: AABB = (k[3] as Mesh).get_aabb()
		box.size = ab.size.max(Vector3.ONE * 0.1)
		var shape := CollisionShape3D.new()
		shape.shape = box
		shape.position = ab.get_center()
		body.add_child(shape)
		world.add_child(body)
		body.global_transform = xf
		body.linear_velocity = way * speed * 0.9 + Vector3.UP * (1.2 + speed * 0.12)
		body.angular_velocity = Vector3(randf_range(-4, 4), randf_range(-2, 2), randf_range(-4, 4))
		# something to land on (the city has no physics of its own): a slab at the road's height
		ground = StaticBody3D.new()
		var gs := CollisionShape3D.new()
		var gb := BoxShape3D.new()
		gb.size = Vector3(40, 1, 40)
		gs.shape = gb
		ground.add_child(gs)
		world.add_child(ground)
		var g2 := Vector2(xf.origin.x, xf.origin.z)
		ground.global_position = Vector3(g2.x, _h(g2) + Y_ROAD + 0.07 - 0.5, g2.y)
		Audio.play("impact_plate", 0.15, -6.0)
		_v *= 0.88
	_knocked.append({"id": pid, "k": k, "body": body, "ground": ground, "t": 0.0})
	if _knocked.size() > KNOCKED_MAX:
		_knock_back(_knocked.pop_front())
	Probe.event("knocked", {"what": k[4], "kmh": int(speed * 3.6), "at": Vector2i(_pos)})

## A road sign the car hits faster than SIGN_BEND_V is bent over at its foot, away from the
## car, its plate with it. Signs are merged into the street's batches (TONE_SHADER: no draw
## of their own), so the one hit is hidden there -- the shader squashes what stands within
## its plate's reach of its pole between knee height and its top (`gone`, `gone_r`, up to
## 12) -- and a bent copy,
## its pole and its plate, is put in its place: two draws while it is down. Put back as the
## knocked bins are (KNOCK_BACK_S, out of sight 70 m off).
const SIGN_BEND_V := 4.0
const SIGNS_BENT_MAX := 12
var _signs_at := {}                  ## post index -> [kind, the plate's transform, the pole's]
var _bent: Array = []                ## {id, sign, nodes, t}

func _bend_sign(pid: int) -> void:
	var sg: Array = _signs_at[pid]
	_signs_at.erase(pid)
	_knocked_n += 1
	_knocked_what = "sign %s" % str(sg[0])
	var r0: float = _post_r[pid]
	_post_r[pid] = 0.0   # (not solid while it is down)
	var plate_xf: Transform3D = sg[1]
	var pole_xf: Transform3D = sg[2]
	var foot := Vector3(pole_xf.origin.x, pole_xf.origin.y - pole_xf.basis.y.length() * 1.1, pole_xf.origin.z)
	var f := _fwd() * signf(_v)
	var way := Vector3(f.x, 0.0, f.y)
	var axis := Vector3.UP.cross(way).normalized()
	var bend := Basis(axis, deg_to_rad(50.0 + 25.0 * randf())) * Basis(Vector3.UP, randf_range(-0.3, 0.3))
	var round_foot := func(xf: Transform3D) -> Transform3D:
		return Transform3D(bend * xf.basis, foot + bend * (xf.origin - foot))
	var nodes: Array = []
	var pole := CylinderMesh.new()
	pole.top_radius = 0.035
	pole.bottom_radius = 0.035
	pole.height = 2.2
	pole.radial_segments = 6
	pole.rings = 1
	pole.material = _surface("pole")
	for pair: Array in [[pole, pole_xf], [_street_sign_mesh(String(sg[0])), plate_xf]]:
		var mi := MeshInstance3D.new()
		mi.mesh = pair[0]
		world.add_child(mi)
		mi.global_transform = round_foot.call(pair[1])
		nodes.append(mi)
	# (how far the plate reaches from the pole, all of it: a street name's plate is 1.5 m wide,
	# and hidden only to 0.8 m its ends stayed, stretched to the stub in a huge green triangle)
	var ab: AABB = _street_sign_mesh(String(sg[0])).get_aabb()
	var reach := maxf(maxf(absf(ab.position.x), absf(ab.end.x)), maxf(absf(ab.position.z), absf(ab.end.z))) * plate_xf.basis.x.length() + 0.15
	_bent.append({"id": pid, "sign": sg, "nodes": nodes, "t": 0.0, "r": r0, "reach": maxf(reach, 0.3),
		"gone": Vector4(foot.x, foot.z, foot.y + 0.35, plate_xf.origin.y + ab.end.y * plate_xf.basis.y.length() + 0.15)})
	if _bent.size() > SIGNS_BENT_MAX:
		_unbend(_bent.pop_front())
	_gone_signs()
	Audio.play("impact_metal", 0.1, -6.0)
	shake3d(1.6)
	_v *= 0.6
	_sparks_at(foot + Vector3.UP * 0.6, -way + Vector3.UP * 0.4, 0.7)
	Probe.event("knocked", {"what": "sign", "kmh": int(absf(_v) / 0.6 * 3.6), "at": Vector2i(_pos)})

## put a bent sign back as it stood
func _unbend(e: Dictionary) -> void:
	for n: Node in e["nodes"]:
		if is_instance_valid(n):
			n.queue_free()
	_post_r[int(e["id"])] = float(e["r"])
	_signs_at[int(e["id"])] = e["sign"]

## TONE_SHADER's list of the bent signs' places, to hide them in the batches
func _gone_signs() -> void:
	var g4: Array = []
	var gr := PackedFloat32Array()
	for e: Dictionary in _bent:
		g4.append(e["gone"])
		gr.append(float(e["reach"]))
	while g4.size() < SIGNS_BENT_MAX:
		g4.append(Vector4.ZERO)
		gr.append(0.0)
	_tone_mat().set_shader_parameter("gone", g4)
	_tone_mat().set_shader_parameter("gone_r", gr)
	_tone_mat().set_shader_parameter("gone_n", _bent.size())

func _bent_tick(dt: float) -> void:
	if _bent.is_empty():
		return
	var changed := false
	for i in range(_bent.size() - 1, -1, -1):
		var e: Dictionary = _bent[i]
		e["t"] = float(e["t"]) + dt
		var gp: Vector4 = e["gone"]
		if float(e["t"]) > KNOCK_BACK_S and Vector2(gp.x, gp.y).distance_to(_pos) > 70.0:
			_unbend(e)
			_bent.remove_at(i)
			changed = true
	if changed:
		_gone_signs()

## a bin or a recycling bin the car knocks aside (the assist does not brake for one)
func _light_thing(hit: String) -> bool:
	if not hit.begins_with("post "):
		return false
	var pid := int(hit.substr(5))
	return _knockable.has(pid) and (_knockable[pid] as Array)[4] == "tumble"

## put a knocked thing back as it was
func _knock_back(e: Dictionary) -> void:
	var k: Array = e["k"]
	(k[0] as MultiMesh).set_instance_transform(int(k[1]), k[2])
	_post_r[int(e["id"])] = float(k[5])
	_knockable[int(e["id"])] = k
	for n: String in ["body", "ground"]:
		if e[n] != null and is_instance_valid(e[n]):
			(e[n] as Node).queue_free()

func _knock_tick(dt: float) -> void:
	_bent_tick(dt)
	if _knocked.is_empty():
		return
	for i in range(_knocked.size() - 1, -1, -1):
		var e: Dictionary = _knocked[i]
		e["t"] = float(e["t"]) + dt
		var o: Vector3 = (e["k"][2] as Transform3D).origin
		if float(e["t"]) > KNOCK_BACK_S and Vector2(o.x, o.z).distance_to(_pos) > 70.0:
			_knock_back(e)
			_knocked.remove_at(i)

## sparks: a burst of hot bits off the metal at p, flying out along `out`
var _sparks: CPUParticles3D
var _spark_cool := 0.0

func _sparks_at(p: Vector3, out: Vector3, k: float) -> void:
	var now := Time.get_ticks_msec() / 1000.0
	if now < _spark_cool:
		return
	_spark_cool = now + 0.12
	if _sparks == null:
		_sparks = CPUParticles3D.new()
		_sparks.one_shot = true
		_sparks.emitting = false
		_sparks.amount = 32
		_sparks.lifetime = 0.45
		_sparks.explosiveness = 0.95
		_sparks.spread = 65.0
		_sparks.initial_velocity_min = 2.5
		_sparks.initial_velocity_max = 6.5
		_sparks.gravity = Vector3(0, -9.8, 0)
		_sparks.scale_amount_min = 0.5
		_sparks.scale_amount_max = 1.2
		var curve := Curve.new()
		curve.add_point(Vector2(0, 1))
		curve.add_point(Vector2(1, 0))
		_sparks.scale_amount_curve = curve
		var q := QuadMesh.new()
		q.size = Vector2(0.04, 0.04)
		var m := StandardMaterial3D.new()
		m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		m.billboard_mode = BaseMaterial3D.BILLBOARD_PARTICLES
		m.albedo_color = Palette.col("warn").lerp(Palette.col("ink"), 0.3)
		m.emission_enabled = true
		m.emission = Palette.col("warn")
		m.emission_energy_multiplier = 3.0
		q.material = m
		_sparks.mesh = q
		world.add_child(_sparks)
	_sparks.global_position = p
	_sparks.direction = out.normalized()
	_sparks.amount = int(14 + 24 * k)
	_sparks.restart()

## what the car last hit was a hedge
func _soft_hit() -> bool:
	if not _last_hit.begins_with("wall "):
		return false
	var i := int(_last_hit.substr(5))
	return i >= 0 and i < _wall_soft.size() and _wall_soft[i] == 1

## leaves off a hedge the car went into: the sparks' kind of burst (the same material's
## shader: no new one to compile), green, slower, drifting down
var _leaf_burst: CPUParticles3D

func _leaves_at(p: Vector3, out: Vector3, k: float) -> void:
	if _leaf_burst == null:
		_leaf_burst = CPUParticles3D.new()
		_leaf_burst.one_shot = true
		_leaf_burst.emitting = false
		_leaf_burst.amount = 40
		_leaf_burst.lifetime = 1.6
		_leaf_burst.explosiveness = 0.9
		_leaf_burst.spread = 75.0
		_leaf_burst.initial_velocity_min = 1.0
		_leaf_burst.initial_velocity_max = 3.2
		_leaf_burst.gravity = Vector3(0, -2.2, 0)
		_leaf_burst.damping_min = 1.5
		_leaf_burst.damping_max = 3.0
		_leaf_burst.angular_velocity_min = -360.0
		_leaf_burst.angular_velocity_max = 360.0
		_leaf_burst.scale_amount_min = 0.6
		_leaf_burst.scale_amount_max = 1.3
		var q := QuadMesh.new()
		q.size = Vector2(0.07, 0.05)
		var m := StandardMaterial3D.new()
		m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		m.billboard_mode = BaseMaterial3D.BILLBOARD_PARTICLES
		var leaf: Color = _tone.get("hedge", _tone.get("grass", Palette.col("friend")))
		m.albedo_color = leaf.darkened(0.15)
		m.emission_enabled = true
		m.emission = leaf.darkened(0.6)
		m.emission_energy_multiplier = 1.0
		q.material = m
		_leaf_burst.mesh = q
		world.add_child(_leaf_burst)
	_leaf_burst.global_position = p + Vector3.UP * 0.4
	_leaf_burst.direction = out.normalized()
	_leaf_burst.amount = int(18 + 30 * k)
	_leaf_burst.restart()

## Where the car hit a wall or a building: streaks of its rubber and paint on it at bumper
## height, along the way it scraped -- the wall marked, not only the car. A few kept, for a
## few minutes (like the glass).
var _scrapes: Array = []             ## [mesh instance, when]

func _scrape_at(at: Vector3, n: Vector2, speed: float) -> void:
	if n == Vector2.ZERO:
		return
	var b := Buf.new()
	var rng := RandomNumberGenerator.new()
	rng.seed = int(at.x * 17.0 + at.z * 5.0)
	var along := Vector2(-n.y, n.x)
	var face := Vector3(n.x, 0.0, n.y)
	var c := Vector2(at.x, at.z) + n * 0.03   # (just off the wall's face, on the car's side)
	var gy := _h(Vector2(at.x, at.z))
	var dark: Color = _tone["cartrim"].darkened(0.55)
	var paint: Color = Palette.col("bg_alt").lerp(Palette.col("ink"), 0.55)
	var length := clampf(0.5 + speed * 0.12, 0.6, 2.4)
	for i in range(int(clampf(speed * 0.8, 3.0, 9.0))):
		var y := gy + rng.randf_range(0.28, 0.72)
		var l := length * rng.randf_range(0.45, 1.0)
		var o := rng.randf_range(-0.3, 0.3)
		var hgt := rng.randf_range(0.012, 0.05)
		var col := dark if rng.randf() < 0.65 else paint
		var a := c + along * (o - l * 0.5)
		var e := c + along * (o + l * 0.5)
		var A := Vector3(a.x, y, a.y)
		var E := Vector3(e.x, y + rng.randf_range(-0.04, 0.04), e.y)
		var up := Vector3.UP * hgt
		b.tri(A, E, E + up, face, col)
		b.tri(A, E + up, A + up, face, col)
		b.tri(A, E + up, E, -face, col)   # (and the other way round: whichever way it winds)
		b.tri(A, A + up, E + up, -face, col)
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, b.arrays())
	am.surface_set_material(0, _vc_mat())
	var mi := MeshInstance3D.new()
	mi.mesh = am
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	world.add_child(mi)
	_scrapes.append([mi, Time.get_ticks_msec()])
	while _scrapes.size() > 8 or (not _scrapes.is_empty() and Time.get_ticks_msec() - int(_scrapes[0][1]) > 240000):
		(_scrapes.pop_front()[0] as Node).queue_free()

## glass and bits of plastic on the road where a hard knock was, for a minute and a half
var _glass: Array = []               ## [mesh instance, when]

func _glass_at(p: Vector2, speed: float) -> void:
	var b := Buf.new()
	var rng := RandomNumberGenerator.new()
	rng.seed = int(p.x * 13.0 + p.y * 7.0)
	var glass: Color = _tone["carglass"].lerp(Palette.col("ink"), 0.55)
	var plastic: Color = _tone["cartrim"]
	var n := int(clampf(speed * 4.0, 25.0, 70.0))
	for i in range(n):
		var r := 1.6 * sqrt(rng.randf())
		var a := rng.randf() * TAU
		var c := p + Vector2(cos(a), sin(a)) * r
		var s := rng.randf_range(0.02, 0.07)
		var t := rng.randf() * TAU
		var y := _h(c) + Y_MARK + 0.01
		var col := glass if rng.randf() < 0.7 else plastic
		var q0 := Vector3(c.x + cos(t) * s, y, c.y + sin(t) * s)
		var q1 := Vector3(c.x + cos(t + 2.2) * s * 0.8, y, c.y + sin(t + 2.2) * s * 0.8)
		var q2 := Vector3(c.x + cos(t + 4.1) * s * 0.6, y, c.y + sin(t + 4.1) * s * 0.6)
		b.tri(q0, q1, q2, Vector3.UP, col)
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, b.arrays())
	am.surface_set_material(0, _vc_mat())
	var mi := MeshInstance3D.new()
	mi.mesh = am
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	world.add_child(mi)
	_glass.append([mi, Time.get_ticks_msec()])
	while _glass.size() > 6 or (not _glass.is_empty() and Time.get_ticks_msec() - int(_glass[0][1]) > 90000):
		(_glass.pop_front()[0] as Node).queue_free()

## a dent pressed into the player's car where it hit (its own frame), the deepest four kept
var _dents: Array = []               ## Vector4(x, y, z in the body's frame, how deep 0..1)

func _dent(at: Vector3, deep: float) -> void:
	if _player_car_mat == null or _sedan_node == null:
		return
	var mi: Node3D = _sedan_node.get_child(0) if _sedan_node.get_child_count() > 0 else _sedan_node
	var lp := mi.global_transform.affine_inverse() * at
	_dents.append(Vector4(lp.x, clampf(lp.y, 0.35, 1.0), lp.z, deep))
	_dents.sort_custom(func(a: Vector4, b: Vector4) -> bool: return a.w > b.w)
	while _dents.size() > 4:
		_dents.pop_back()
	var arr: Array = []
	for d: Vector4 in _dents:
		arr.append(d)
	while arr.size() < 4:
		arr.append(Vector4.ZERO)
	_player_car_mat.set_shader_parameter("dents", arr)

## Ground too steep to climb is a wall (STEEP): a circle whose uphill edge is on it is moved
## back downhill to where the ground is gentle enough. A road is always drivable, however
## steep. Nothing to do in a city without such ground.
func _steep_push(c: Vector2, r: float, y := NAN) -> Vector2:
	if not _steep or (not is_nan(y) and absf(y - _h(c)) > 2.5):
		return Vector2.ZERO   # (on a bridge, in a tunnel: the slopes round it are not in the way)
	var g := _grade(c)
	if g == Vector2.ZERO:
		return Vector2.ZERO
	var up := g.normalized()
	var edge := c + up * r
	if _grade(edge).length() < STEEP:
		return Vector2.ZERO
	var on := _nearest_seg(edge, 14.0, true)
	if not on.is_empty() and float(on["edge"]) < 0.0:
		return Vector2.ZERO
	var s := 0.0
	while s < 4.0:
		s += 0.25
		if _grade(edge - up * s).length() < STEEP:
			break
	_last_hit = "steep ground"
	return -up * s

## Water held at its own level (a river between weirs, the test town's) is too deep to drive
## or walk into: a circle whose lowest edge would be in it more than DEEP is moved back up the
## bank. Water that lies at its shore's lowest point (every lake and pond OSM maps) is left
## as it was: a road across a lake's inlet runs on ground the water's level is above.
const DEEP := 0.35
var _deep: Array = []                ## [outline, level, box]
var _deep_hash := {}

func _deep_push(c: Vector2, r: float, y: float) -> Vector2:
	if _deep.is_empty() or absf(y - _h(c)) > 2.5:
		return Vector2.ZERO   # (on a bridge over it)
	var gr := _grade(c)
	var up := gr.normalized() if gr != Vector2.ZERO else Vector2.ZERO
	var low := c - up * r
	for i: int in _near(_deep_hash, low, 0.1, BLD_CELL):
		var d: Array = _deep[i]
		if not (d[2] as Rect2).has_point(low) or not Geometry2D.is_point_in_polygon(low, d[0]):
			continue
		var lv: float = d[1]
		if _h(low) > lv - DEEP or up == Vector2.ZERO:
			continue
		var s := 0.0
		while s < 4.0:
			s += 0.25
			if _h(low + up * s) > lv - DEEP:
				break
		_last_hit = "deep water"
		return up * s
	return Vector2.ZERO

## which way and how steeply the ground rises at p (metres up per metre across)
func _grade(p: Vector2) -> Vector2:
	return Vector2(_h(p + Vector2(1, 0)) - _h(p - Vector2(1, 0)), _h(p + Vector2(0, 1)) - _h(p - Vector2(0, 1))) * 0.5

## true when some cell of the height grid is steeper than STEEP
func _any_steep() -> bool:
	var lim := STEEP * _hstep
	for j in range(_hnz - 1):
		for i in range(_hnx - 1):
			var r := j * _hnx + i
			if absf(_hgrid[r + 1] - _hgrid[r]) > lim or absf(_hgrid[r + _hnx] - _hgrid[r]) > lim:
				return true
	return false

## What gives under the car at speed (`_smash`, set by _collide while moving faster than
## SMASH_V, and by racer's way-finding): kerb railings and their thin posts, garden walls
## under SMASH_WALL_H, hedges. _push_out passes through them then and names the last in
## `_smashed`; _collide slows the car a little and throws sparks or leaves. What breaks
## stays drawn where it was (only its hold on the car goes: "some just break and still stuck
## in place").
const SMASH_V := 2.5          ## m/s: slower than this, a railing still stops the car
const SMASH_WALL_H := 0.6     ## m: a garden wall lower than this the car goes over
const SMASH_POST_R := 0.07    ## m: posts this thin (railings' posts) give
var _smash := false
var _smashed := ""

## how far to move a circle so it overlaps nothing solid (its feet at y: a deck's walls are
## solid only at their own heights; without a y, the ground's level)
func _push_out(c: Vector2, r: float, posts: bool, cars := true, y := NAN) -> Vector2:
	var push := Vector2.ZERO
	var ground := true   # at the ground's level (not in a tunnel under it, not on a bridge over it)
	var low := true      # ... and not on a deck's surface off the ground: fences and posts count
	if _decks != null and _decks.any():
		push = _decks.push(c, r, _h(c) if is_nan(y) else y)
		ground = is_nan(y) or absf(y - _h(c)) < 2.5
		if ground and not is_nan(y) and y < _h(c) - 0.5:   # in a tunnel: the houses are over its roof
			var under := _decks.deck_at(c, y, 1.0)
			ground = under < 0 or String(_roads[under]["deck"]) != "tu"
		# on a deck off the ground: the fences and posts are down on the ground under it (an
		# OSM fence across a footbridge's foot stopped you on its first metre up)
		low = not (posts and ground and not is_nan(y) and _decks.off_ground(c, y))
	for i: int in (_near(_bld_hash, c, r, BLD_CELL) if ground else []):
		if _bld_solid[i] == 0:
			continue
		var box: Rect2 = _bld_box[i]
		if not box.grow(r).has_point(c + push):
			continue
		var p := _poly_push(_blds[i], c + push, r)
		if p != Vector2.ZERO:
			push += p
			_last_hit = "building %d" % i
	if posts and ground and low:
		# fences, railings, hedges, garden walls, a shelter's back: thin walls, as segments
		for i: int in _near(_wall_hash, c, r + 0.5, BLD_CELL):
			if _smash and _wall_give[i] == 1:
				var qs := c + push
				var cps := Geometry2D.get_closest_point_to_segment(qs, _walls[i * 2], _walls[i * 2 + 1])
				if qs.distance_to(cps) < r + _wall_r[i]:
					_smashed = "wall %d" % i
				continue
			var q := c + push
			var cp := Geometry2D.get_closest_point_to_segment(q, _walls[i * 2], _walls[i * 2 + 1])
			var d := q - cp
			var need := r + _wall_r[i]
			if d.length_squared() < need * need:
				var nrm := d.normalized() if d.length() > 0.001 else (_walls[i * 2 + 1] - _walls[i * 2]).orthogonal().normalized()
				push += nrm * (need - d.length())
				_last_hit = "wall %d" % i
		for i: int in _near(_post_hash, c, r, BLD_CELL):
			var d := (c + push) - _posts[i]
			var need := r + _post_r[i]
			if _smash and _post_r[i] <= SMASH_POST_R and not _knockable.has(i) and not _signs_at.has(i):
				if d.length() < need:
					_smashed = "post %d" % i   # (a railing's post, a thin stake: through it)
				continue
			if d.length() < need:
				push += d.normalized() * (need - d.length()) if d.length() > 0.001 else Vector2(need, 0)
				_last_hit = "post %d" % i
				if _knockable.has(i) or _signs_at.has(i):
					_knock_hit = i
	if posts and _traffic != null and cars:
		var tp := _traffic.push(c + push, r, y)
		if tp != Vector2.ZERO:
			push += tp
			_last_hit = "car %d" % _traffic.hit_index
	return push

## The people in the street as solid things, for what moves at play -- the car (_collide)
## and you on foot -- and not for _push_out, which also places things as the city builds
## (a passer-by there would have cost a square its bench). They were walked and driven
## through like ghosts.
const PERSON_R := 0.28
var _people_at := PackedVector2Array()   ## where everyone in the street is now (_people_tick)
var _people_who := PackedInt64Array()    ## ... and who (an actor's id; 0 you on foot)

func _people_push(c: Vector2, r: float) -> Vector2:
	var push := Vector2.ZERO
	for k in range(_people_at.size()):
		if k < _people_who.size() and _people_who[k] == 0:
			continue   # (you, on foot, where you were last tick: pushed off that, you ran at 35 m/s)
		var q := _people_at[k]
		var d := (c + push) - q
		var need := r + PERSON_R
		if d.length_squared() < need * need:
			push += d.normalized() * (need - d.length()) if d.length() > 0.001 else Vector2(need, 0)
			_last_hit = "person"
	return push

func _poly_push(poly: PackedVector2Array, c: Vector2, r: float) -> Vector2:
	var best := INF
	var q := c
	var n := poly.size()
	for i in range(n):
		var p := Geometry2D.get_closest_point_to_segment(c, poly[i], poly[(i + 1) % n])
		var d := c.distance_squared_to(p)
		if d < best:
			best = d
			q = p
	best = sqrt(best)
	if Geometry2D.is_point_in_polygon(c, poly):
		var out := q - c
		return out + out.normalized() * r if best > 0.001 else Vector2(r, 0)
	if best < r:
		return (c - q) / maxf(best, 0.001) * (r - best)
	return Vector2.ZERO

## ---- spatial hashes -------------------------------------------------------------------------

func _cell(p: Vector2, size: float) -> Vector2i:
	return Vector2i(floori(p.x / size), floori(p.y / size))

func _hash_add(h: Dictionary, box: Rect2, size: float, item: int) -> void:
	var a := _cell(box.position, size)
	var b := _cell(box.end, size)
	for cx in range(a.x, b.x + 1):
		for cz in range(a.y, b.y + 1):
			var key := Vector2i(cx, cz)
			if h.has(key):
				(h[key] as Array).append(item)
			else:
				h[key] = [item]

## every item whose cells touch the square of radius r round p, once each
func _near(h: Dictionary, p: Vector2, r: float, size: float) -> Array:
	var a := _cell(p - Vector2(r, r), size)
	var b := _cell(p + Vector2(r, r), size)
	if a == b:
		return h.get(a, [])
	var seen := {}
	for cx in range(a.x, b.x + 1):
		for cz in range(a.y, b.y + 1):
			for i: int in h.get(Vector2i(cx, cz), []):
				seen[i] = true
	return seen.keys()

## the closest road segment to p within max_d: {road, seg, q (closest point), edge (metres
## past the asphalt's edge, negative when on it)}; {} when there is none. Only roads at the
## level of y count (within LEVEL_SLACK of it: not the bridge overhead, not the tunnel
## underneath); without a y, the ground's level at p.
const LEVEL_SLACK := 3.0
func _nearest_seg(p: Vector2, max_d: float, drivable: bool, public := false, y := NAN) -> Dictionary:
	var best := {}
	var bd := INF
	var levels := _decks != null and _decks.any()
	for code: int in _near(_seg_hash, p, max_d, SEG_CELL):
		var ri := code / 4096
		var sj := code % 4096
		var r: Dictionary = _roads[ri]
		if drivable and not r["drive"]:
			continue
		if public and r["pv"]:
			continue
		var pts: PackedVector2Array = r["pts"]
		var q := Geometry2D.get_closest_point_to_segment(p, pts[sj], pts[sj + 1])
		if levels and (r.has("ys") or not is_nan(y)):
			var at := _decks.seg_y(ri, sj, q) if r.has("ys") else _h(q)
			if absf(at - (_h(p) if is_nan(y) else y)) > LEVEL_SLACK:
				continue
		var edge := p.distance_to(q) - float(r["w"]) * 0.5
		if edge < bd:
			bd = edge
			best = {"road": ri, "seg": sj, "q": q, "edge": edge}
	return best

func _hash_i(v: Vector2) -> int:
	return absi((int(v.x * 7.0) * 73856093) ^ (int(v.y * 7.0) * 19349663))

func _in_city(p: Vector2) -> bool:
	if _boundary.is_empty():
		return true
	for ring: PackedVector2Array in _boundary:
		if Geometry2D.is_point_in_polygon(p, ring):
			return true
	return false

## ---- camera: a chase cam that swings wide on turns and never sits inside a building -----

## `p` and `yaw`: where the car is drawn this frame
## A camera for looking at the city in screenshots (tools/shots.sh), never in play:
## STREETS_CAM="ahead,left,up,turn,tilt" stands it that many metres ahead of the car, to its
## left and above the ground, turned that many degrees left of the car's heading and tilted
## that many up; a sixth value of 1 makes it night. Unset (always, outside a test) it does
## nothing.
var _dev_cam := PackedFloat32Array()

func _camera(dt: float, p: Vector2, yaw: float) -> void:
	if _dev_cam.size() == 5:
		var fw := Vector2(cos(yaw), sin(yaw))
		var lf := Vector2(sin(yaw), -cos(yaw))
		var at2 := p + fw * _dev_cam[0] + lf * _dev_cam[1]
		var dy := yaw - deg_to_rad(_dev_cam[3])
		var tl := deg_to_rad(_dev_cam[4])
		var eye := Vector3(at2.x, _decks.surf(at2, _view_y) + _dev_cam[2], at2.y)
		look_from(eye, eye + Vector3(cos(dy) * cos(tl), sin(tl), sin(dy) * cos(tl)))
		cam.fov = 70.0
		return
	if _cockpit:
		_seat_camera(dt, yaw)
		return
	_cam_yaw = lerp_angle(_cam_yaw, yaw, 1.0 - exp(-dt * 3.0))
	var back := Vector2(cos(_cam_yaw), sin(_cam_yaw))
	var spd := clampf(absf(_v) / 30.0, 0.0, 1.0)
	var want := lerpf(6.3, 7.8, spd)
	var clear := _clear_behind(p, -back, want)
	_cam_dist = clear if clear < _cam_dist else lerpf(_cam_dist, clear, 1.0 - exp(-dt * 1.5))
	var d := _cam_dist
	var gp: float = _decks.surf(p, _view_y)   # (the deck it is on, the tunnel's road)
	var gy := gp + maxf(_view_y - gp, 0.0) * 0.8   # up with the car when it flies
	var eye2 := p - back * d
	var eye := Vector3(eye2.x, maxf(gy + 2.0 + d * 0.14, _decks.surf(eye2, _view_y) + 1.4), eye2.y)
	eye = _decks.keep_eye(eye, p, _view_y)
	var ahead := p + back.rotated(-_head_yaw * 0.5) * 4.0   # (a little round to where the driver looks)
	var at := Vector3(ahead.x, lerpf(gy, _decks.surf(ahead, _view_y), 0.5) + 1.0, ahead.y)
	look_from(eye, at)
	cam.fov = lerpf(54.0, 62.0, spd)   # (was 64-74: ~96-106 across, the street looked small and far)

## from the driver's seat: with the body as it pitches and leans, the head pushed back a
## little as the car pulls away, the eyes leading into a turn
func _seat_camera(dt: float, yaw: float) -> void:
	_cam_yaw = yaw
	_look_turn = lerpf(_look_turn, clampf(_steer * 0.45, -0.25, 0.25), 1.0 - exp(-dt * 2.0))
	var xf := _body.global_transform
	# (the head turned: the eyes a little to that side and back, the view round with it)
	var head := SEAT + Vector3(sin(_head_yaw * SEAT_HEAD) * 0.06, 0, clampf(-_a_long * 0.004, -0.04, 0.04) - (1.0 - cos(_head_yaw * SEAT_HEAD)) * 0.05)
	var eye := xf * head
	var turn := _look_turn - _head_yaw * SEAT_HEAD
	var ahead := Vector3(-sin(turn), -0.06, cos(turn)) * 12.0   # +X is the car's left
	look_from(eye, xf * (head + ahead))
	cam.fov = lerpf(58.0, 64.0, clampf(absf(_v) / 30.0, 0.0, 1.0))   # (was 72-78: up to 113 across)
	if _wheel_node != null:
		_wheel_node.rotation.z = _steer * 15.0 * 0.5
	# the needles: 0-200 km/h and 0-7000 rpm round 4.4 radians, from the bottom left
	if _dial_speed != null:
		# (the dial's +X is the driver's left: from -2.2, bottom left as the driver sees it,
		# clockwise over the top)
		_dial_speed.basis = Basis(Vector3.RIGHT, 0.32) * Basis(Vector3.BACK, -2.2 + 4.4 * clampf(absf(_v) * 3.6 / 200.0, 0.0, 1.0))
		_dial_rpm.basis = Basis(Vector3.RIGHT, 0.32) * Basis(Vector3.BACK, -2.2 + 4.4 * clampf(_rpm / 7000.0, 0.0, 1.0))

## ---- the driver's head: looking left and right where a driver would ----------------------
## Slowing for a junction, a light, a stop or give-way sign: left, right, left again (traffic
## comes from the left first, driving on the right), once a junction; into a turn as the
## wheel goes over; at people on the crossing ahead; over the right shoulder reversing.
## Autodrive's driver always does; yours while "look" is on. The seat view turns with the
## head, the chase camera swings a little toward it, and the head in the car turns.
const LOOK_BTN := Rect2(566, 176, 66, 22)    ## looking round while you drive yourself (key G: glance); hidden while autodrive drives or you walk
const HEAD_RATE := 3.4                       ## rad/s a head turns at, at most
var _head_yaw := 0.0                         ## where the driver looks: radians left (+) of ahead
var _head_plan: Array = []                   ## a scan still to do: [[yaw, seconds held], ...]
var _head_hold := 0.0
var _head_at := Vector2.INF                  ## where the last scan was (once a junction: its
var _head_at_t := 0.0                        ## points 10-30 m apart are one) and how long ago
var _head_check := 0.0
var _look_on := true                         ## looking round while you drive (autodrive always)

func _head_tick(dt: float) -> void:
	var want := 0.0
	_head_at_t += dt
	if _walking or not (_auto or _look_on):
		_head_plan = []
	else:
		_head_check -= dt
		# the look left and right: standing or all but, at a junction, a light or a sign,
		# once a junction. (Rolling below 23 km/h near any junction, it fired again and again
		# in slow traffic and turned the seat view half round each time.)
		if _head_check <= 0.0 and _head_plan.is_empty() and absf(_v) < 2.5 and _gear > 0:
			_head_check = 0.2
			var j := _junction_ahead_me(16.0)
			# only first in line and about to go: at a light, once it is green (it looked
			# left and right at every red, from behind a queue of cars); with a car in front,
			# not yet -- it looks when it is the one pulling out
			if j >= 0 and _sig_set.has(j) and _light_at(j, _fwd()) not in ["g", ""]:
				j = -1
			if j >= 0 and _car_ahead_me(12.0):
				j = -1
			if j >= 0 and (_nodes[j].distance_to(_head_at) > 45.0 or _head_at_t > 20.0):
				_head_at = _nodes[j]
				_head_at_t = 0.0
				_head_plan = [[0.9, 0.5], [-0.9, 0.55], [0.5, 0.3]]
		if not _head_plan.is_empty():
			if absf(_v) > 6.0:
				_head_plan = []   # (off again before it was done: eyes on the road)
			else:
				want = float(_head_plan[0][0])
				if absf(_head_aim - want) < 0.05:
					_head_hold += dt
					if _head_hold >= float(_head_plan[0][1]):
						_head_hold = 0.0
						_head_plan.pop_front()
		elif _gear < 0 and absf(_v) > 0.2:
			want = -1.2   # over the right shoulder, reversing
		elif _auto and _ap_give_car >= 0 and absf(_v) < 3.0 and _traffic.cars[_ap_give_car].alive:
			# giving way: at the car it waits for, following it by
			want = clampf(-_fwd().angle_to(_traffic.cars[_ap_give_car].pos - _pos), -1.2, 1.2)
		else:
			# standing for people on the crossing ahead: at one of them, held a moment (the
			# nearest, chosen afresh every frame, sent the eyes from one to the next)
			_head_person_t -= dt
			if absf(_v) < 2.0:
				if _head_person_t <= 0.0:
					_head_person = _person_ahead_me(14.0)
					_head_person_t = 1.5
				if _head_person != Vector2.INF:
					want = clampf(-_fwd().angle_to(_head_person - _pos), -1.0, 1.0)
			else:
				_head_person = Vector2.INF
	# eased: the aim moves at a head's pace and the head follows it smoothly. (The steering
	# was in it too, on top of the seat view's own lead into a turn: every small correction
	# autodrive made swung the view.)
	_head_aim = move_toward(_head_aim, want, 2.2 * dt)
	_head_yaw = lerpf(_head_yaw, _head_aim, 1.0 - exp(-dt * 7.0))
	if _player_car_mat != null:
		# the head drawn in the car leans a little into a turn as well (the seat view does
		# that by itself)
		_head_steer = lerpf(_head_steer, clampf(-_steer * 0.8, -0.35, 0.35), 1.0 - exp(-dt * 3.0))
		_player_car_mat.set_shader_parameter("head_turn", _head_yaw + _head_steer)

var _head_aim := 0.0                         ## where the head is heading for (eased toward)
var _head_person := Vector2.INF              ## the person it is looking at, held a moment
var _head_person_t := 0.0
var _head_steer := 0.0                       ## the drawn head's lean into a turn
const SEAT_HEAD := 0.7                       ## how much of the head's turn the seat view takes

func _toggle_look() -> void:
	_look_on = not _look_on
	_show_banner("looking round as you drive: " + ("on" if _look_on else "off"), 1.4)
	Probe.event("look", {"on": _look_on})

## the next junction (3+ ways) or signalled point on the road ahead within `reach`, or -1
func _junction_ahead_me(reach: float) -> int:
	var hit := _nearest_seg(_pos, 12.0, true, true)
	if hit.is_empty():
		return -1
	var r: Dictionary = _roads[hit["road"]]
	var pts: PackedVector2Array = r["pts"]
	var ids: PackedInt32Array = r["ids"]
	var sj: int = hit["seg"]
	var dir := 1 if (pts[sj + 1] - pts[sj]).dot(_fwd()) >= 0.0 else -1
	var k := sj + 1 if dir > 0 else sj
	var d := _pos.distance_to(pts[k])
	while d <= reach:
		var n := ids[k]
		if _node_ways(n) >= 3 or _sig_set.has(n) or _signs.has(n):
			return n
		var nk := k + dir
		if nk < 0 or nk >= pts.size():
			return -1
		d += pts[k].distance_to(pts[nk])
		k = nk
	return -1

## a car in front within `reach` (on autodrive's planned lane, or straight ahead driving yourself)
func _car_ahead_me(reach: float) -> bool:
	var path := _ap_pts if (_auto and _ap_pts.size() >= 2) else PackedVector2Array([_pos, _pos + _fwd() * (reach + 2.0)])
	var lead: Array = _traffic.lead_on(path, _pos, reach, false)
	return float(lead[0]) < reach

## the nearest person in front within `reach` (on a crossing, stepping off the kerb)
func _person_ahead_me(reach: float) -> Vector2:
	var best := Vector2.INF
	var bd := reach
	for q: Vector3 in _people_near(_pos + _fwd() * reach * 0.5, reach * 0.5 + 2.0):
		var p := Vector2(q.x, q.z)
		var d := p.distance_to(_pos)
		if d < bd and (p - _pos).dot(_fwd()) > 2.0:
			bd = d
			best = p
	return best

func _clear_behind(from: Vector2, dir: Vector2, want: float) -> float:
	if absf(_view_y - _h(from)) > 2.5:
		return want   # (in a tunnel, on a bridge: the houses round it are not behind the car)
	var s := 1.0
	while s <= want + 0.6:
		var p := from + dir * s
		for i: int in _near(_bld_hash, p, 0.1, BLD_CELL):
			var box: Rect2 = _bld_box[i]
			if box.has_point(p) and Geometry2D.is_point_in_polygon(p, _blds[i]):
				return maxf(2.2, s - 0.8)
		s += 0.5
	return want

## ---- the view from above: zoom out from where you are, the city paused -------------------
## "zoom" (Z, the mouse wheel down, two fingers pinching) lifts the view off the car -- or off
## you, on foot -- up over the city, centred on where you are, the way you were facing at the
## top of the screen, and pauses the city: the car, traffic, people, lights and the engine
## hold still. Up there: drag (or the arrows) to move over the city, the wheel / a pinch / - and
## = to go higher or lower, Q and E (or two fingers turning) to turn it. Zooming in stops at
## the lowest view (about rooftop height); only a second more of zooming in there comes back
## down to the car (it came down at the first notch too far, and that was too easy to do by
## accident). "back" or Z come down at once, and the city goes on. "pause" (K) holds the city
## with the view where it is; "resume" while up there lets it run on under you, the view
## following the car (the car still drives, the touch stick too). The minimap follows the
## view: centred where you look, turned as the screen is, wide enough to hold what is on
## screen, which it outlines.
## The usual camera is placed first; this blends it toward the view from above (the bottom
## of the zoom, below ZOOM_MIN), so it rises out of whatever view you had. From the driver's
## seat it goes via the chase cam (the car's body is not drawn from the seat) and lands back in
## the seat. The view leans (52 degrees down at most, not 70: from straight above the town read
## as a plan, not a place).
## Draw ranges: whatever is drawn only near the camera (trees, pavements, kerbs, a square's
## little things -- its range counts to the middle of its 400 m square) is drawn at any
## distance while the view is up (_zoom_far): from 150-500 m up those cut-offs swept across the
## screen as the view moved, and whole squares of trees and walls popped in.

const ZOOM_NEAR := 9.0               ## metres from the view's centre at the bottom of the zoom
const ZOOM_FAR := 560.0              ## ... and at the top: about 1.1 km of town across the screen
const ZOOM_MIN := 0.16               ## the lowest the view goes: 17 m off, about rooftop height
const ZOOM_BLEND := 0.12             ## below this the usual camera is blended in (rising, landing)
const ZOOM_UP := 0.72                ## where "zoom" and Z take it: 140 m up
const ZOOM_STEP := 0.1               ## one notch of the wheel, one press of - or =
const ZOOM_PUSH := 1.0               ## seconds of zooming in at the lowest that come down to the car
const ZOOM_FAR_FROM := 380.0         ## draw ranges at least this long are lifted while the view is up...
const ZOOM_FAR_HIGH := 650.0         ## ... and above ZOOM_SMALL, only these: kerbs, garden walls,
const ZOOM_SMALL := 0.8              ## lamps, fences are under a pixel from there, and drawing them
                                     ## across the town tripled the draws (Givatayim at the top: 898
                                     ## all lifted, 337 like this, 296 driving; no visible difference)
const FOG_SCATTER_DAY := 0.01        ## the haze's glow towards the sun by day: a trace, never 0 (_retint_city)
const FOG_DAY := 0.0018              ## the haze's density: by day, at night (see the look)

## the day's haze: half in the made-up town, a valley ringed by mountains with no horizon to
## hide (its mountains were a white wall)
func _fog_day() -> float:
	return FOG_DAY * (0.5 if _mtn_from < 10000.0 else 1.0) * _fog_k

## the night's haze, thickened as the day's on a weak machine's levels
func _fog_night() -> float:
	return FOG_NIGHT * _fog_k
var _fog_k := 1.0                    ## the haze's thickness for the quality level (QUALITY's last column)
const FOG_NIGHT := 0.0026
var _paused := false                 ## the city holds still: the car, traffic, people, lights, sound
var _zoom := 0.0                     ## where the view is going: 0 the usual view .. 1 the highest
var _zoom_v := 0.0                   ## where it is, eased
var _zoom_off := Vector2.ZERO        ## the view's centre from the car (or you), dragged about
var _zoom_yaw := 0.0                 ## the way the top of the screen faces
var _zoom_yaw_to := 0.0              ## ... turning to this (Q / E)
var _zoom_seat := false              ## it rose from the driver's seat: lands back in it
var _zoom_resume := false            ## landing lets the city go on (it was not paused before)
var _drag := false                   ## the mouse (or one finger) is dragging the view about
var _fingers := {}                   ## touch index -> where: fingers down off the stick and buttons
var _pinch := Vector2.ZERO           ## two of them: (distance apart, angle) at the last move
var _pinch0 := 0.0                   ## their distance apart when they came down
var _zoom_push := 0.0                ## seconds of zooming in at the lowest so far
var _zoom_push_ms := 0               ## when the last of it came
var _zoom_lift := 0.0                ## metres the view is raised to clear the roofs under it
var _zoom_ranges: Array = []         ## [node, its draw range] lifted while the view is up
var _zoom_ranges_n := -1             ## world's child count when they were gathered (-1: not lifted)
var _zoom_cut := 0.0                 ## the shortest range lifted now (ZOOM_FAR_FROM or ZOOM_FAR_HIGH)

func _zoomed() -> bool:
	return _zoom > 0.0 or _zoom_v > 0.0

func _zoom_dist(z: float) -> float:
	return ZOOM_NEAR * pow(ZOOM_FAR / ZOOM_NEAR, z)

func _zoom_pitch(z: float) -> float:
	return deg_to_rad(lerpf(22.0, 52.0, smoothstep(0.0, 0.8, z)))

## the view up to `z` (0..1, the lowest ZOOM_MIN), or at 0 back down to the car
func _zoom_set(z: float) -> void:
	z = clampf(z, 0.0, 1.0)
	if z > 0.0:
		z = maxf(z, ZOOM_MIN)
	_zoom_push = 0.0
	if z > 0.0 and not _zoomed():   # rising: from where you are, the way you face; the city holds
		_zoom_off = Vector2.ZERO
		_zoom_yaw = _view_yaw if _cockpit else _cam_yaw
		_zoom_yaw_to = _zoom_yaw
		_zoom_seat = _cockpit
		if _cockpit:
			_set_cockpit(false)
		_zoom_resume = not _paused
		_set_paused(true)
		Probe.event("zoom_out", {"z": z})
	elif z == 0.0 and _zoom > 0.0:
		Probe.event("zoom_in")
	_zoom = z

## zooming bit by bit (the wheel, - and =, a pinch): out lifts the view off the car; in stops
## at the lowest, where a second more of it comes back down
func _zoom_by(dz: float) -> void:
	if dz > 0.0:
		_zoom_set(_zoom + dz)
	elif _zoom > 0.0:
		if _zoom > ZOOM_MIN + 0.001:
			_zoom_set(_zoom + dz)
		else:
			_zoom_in_more()

## zooming in at the lowest: kept up for ZOOM_PUSH seconds (gaps under 0.6 s), back to the car
func _zoom_in_more() -> void:
	var now := Time.get_ticks_msec()
	var gap := float(now - _zoom_push_ms) / 1000.0
	_zoom_push = 0.0 if gap > 0.6 else _zoom_push + gap
	_zoom_push_ms = now
	if _zoom_push >= ZOOM_PUSH:
		_zoom_set(0.0)

## ---- going where you point, from above ------------------------------------------------------
## Up over the city a long press (a finger or the mouse, held HOLD_S without moving more than
## HOLD_SLOP) on the ground sends you there: the destination is the nearest point of a street
## to it, the view comes down to the car, the city goes on, and autodrive drives there as
## "go to" does. A quick press still drags the view; while held, a ring fills under it.
const HOLD_S := 0.55
const HOLD_SLOP := 10.0
var _hold_at := Vector2.INF          ## where the press on the view came down (screen), INF: none
var _hold_t := 0.0                   ## seconds it has been held, counted frame by frame (a slow
                                     ## frame, or a test's slow renderer, is not a long press)

func _hold_move(at: Vector2) -> void:
	if _hold_at != Vector2.INF and at.distance_to(_hold_at) > HOLD_SLOP:
		_hold_at = Vector2.INF   # dragging the view about, not pointing

func _hold_progress() -> float:
	if _hold_at == Vector2.INF or not _zoomed() or _fingers.size() >= 2:
		return 0.0
	return clampf((_hold_t - 0.12) / (HOLD_S - 0.12), 0.0, 1.0)   # (a moment before it shows: a drag)

func _hold_tick(dt: float) -> void:
	if _hold_at == Vector2.INF:
		return
	_hold_t += minf(dt, 0.1)
	if not _zoomed() or _fingers.size() >= 2:
		_hold_at = Vector2.INF
		return
	if _hold_progress() >= 1.0:
		var at := _hold_at
		_hold_at = Vector2.INF
		_drag = false
		_go_where(at)

## the ground under a point of the screen: the flat plane at the view's height, then again at
## the ground's height where that landed (twice: hills)
func _screen_ground(at: Vector2) -> Vector2:
	var y := _h(_view_pos + _zoom_off)
	var p := Vector2.INF
	for _k in range(3):
		var g3 := ground_point(at, y)
		if g3 == Vector3.INF:
			return p
		p = Vector2(g3.x, g3.z)
		y = _h(p)
	return p

func _go_where(at: Vector2) -> void:
	var p := _screen_ground(at)
	if p == Vector2.INF:
		return
	var hit := _nearest_seg(p, 80.0, true, true)
	if hit.is_empty():
		_show_banner("no street near there", 1.5)
		return
	if _walking:
		_show_banner("back in the car to drive there", 2.0)
		return
	var r: Dictionary = _roads[int(hit["road"])]
	var name := String(r["name"]) if String(r["name"]) != "" else "the spot you picked"
	Probe.event("go_where", {"to": name})
	_zoom_resume = true   # (down at the car, the city goes on: it is a drive)
	_zoom_set(0.0)
	_apply_ap_style()   # (a drive of the player's choosing: in their style, _auto_by_hand)
	_set_dest(hit["q"], name)

## how far the push to come down has gone (0..1); 0 once it has stopped a moment
func _zoom_pushing() -> float:
	if _zoom_push <= 0.0 or Time.get_ticks_msec() - _zoom_push_ms > 600:
		return 0.0
	return clampf(_zoom_push / ZOOM_PUSH, 0.0, 1.0)

## the highest roof (walls' height) within `r` metres of `p`; 0 over open ground
func _roof_near(p: Vector2, r: float) -> float:
	var top := 0.0
	for i: int in _near(_bld_hash, p, r, BLD_CELL):
		if i < _bld_top.size() and _bld_top[i] > top and (_bld_box[i] as Rect2).grow(r).has_point(p):
			top = _bld_top[i]
	return top

## while the view is up, everything with a draw range of `cut` or more is drawn at any distance
## (range 0); back as it was when it comes down. What the city builds meanwhile (it builds on
## round the car in the background) is caught as it is added: world's new children.
func _zoom_far(on: bool, cut := ZOOM_FAR_FROM) -> void:
	if not on:
		if _zoom_ranges_n < 0:
			return
		for e: Array in _zoom_ranges:
			if is_instance_valid(e[0]):
				(e[0] as GeometryInstance3D).visibility_range_end = e[1]
		_zoom_ranges.clear()
		_zoom_ranges_n = -1
		_zoom_cut = 0.0
		return
	var n := world.get_child_count()
	if n < _zoom_ranges_n:   # something taken out: start again
		_zoom_far(false)
	if cut != _zoom_cut:   # higher or lower: the small things' ranges back, or lifted too
		_zoom_cut = cut
		for e: Array in _zoom_ranges:
			if is_instance_valid(e[0]):
				(e[0] as GeometryInstance3D).visibility_range_end = 0.0 if float(e[1]) >= cut else float(e[1])
	if n == _zoom_ranges_n:
		return
	for i in range(maxi(_zoom_ranges_n, 0), n):
		var c := world.get_child(i)
		var list: Array = c.find_children("*", "GeometryInstance3D", true, false)
		list.append(c)
		for gi in list:
			var end := (gi as GeometryInstance3D).visibility_range_end if gi is GeometryInstance3D else 0.0
			if end >= ZOOM_FAR_FROM:
				_zoom_ranges.append([gi, end])
				if end >= cut:
					(gi as GeometryInstance3D).visibility_range_end = 0.0
	_zoom_ranges_n = n

func _toggle_pause() -> void:
	_set_paused(not _paused)
	_zoom_resume = false   # paused or resumed by hand: landing leaves it as it is
	if not _paused:
		_show_banner("resumed", 0.8)

## the city holds still: the ticks stop (_physics_process), and so do the people's legs
func _set_paused(on: bool) -> void:
	if on == _paused:
		return
	_paused = on
	var mode := Node.PROCESS_MODE_DISABLED if on else Node.PROCESS_MODE_INHERIT
	for list: Array in [_walkers, _chatters, _crossers]:
		for w: Dictionary in list:
			(w["actor"] as Node).process_mode = mode
	if _me != null:
		_me.process_mode = mode
	Probe.event("pause", {"on": on})

## after the usual camera is placed: blend it toward the view from above
func _zoom_camera(dt: float) -> void:
	if not _zoomed():
		return
	_zoom_v = lerpf(_zoom_v, _zoom, 1.0 - exp(-dt * 3.0))
	if absf(_zoom_v - _zoom) < 0.002:
		_zoom_v = _zoom
	if _zoom_v <= 0.0:   # landed: the usual view, as it was
		_zoom_v = 0.0
		_zoom_off = Vector2.ZERO
		_zoom_lift = 0.0
		_zoom_far(false)
		cam.near = 0.05 if _cockpit else 0.3
		env.fog_density = _fog_night() if _night else _fog_day()
		_reach_apply()   # (the ranges the view from above lifted are back: this level's again)
		if _zoom_seat:
			_set_cockpit(true)
		_zoom_seat = false
		if _zoom_resume:
			_set_paused(false)
		_zoom_resume = false
		return
	var z := _zoom_v
	var dist := _zoom_dist(z)
	var pitch := _zoom_pitch(z)
	var fw := Vector2(cos(_zoom_yaw), sin(_zoom_yaw))
	var lf := Vector2(fw.y, -fw.x)
	if _zoom == 0.0:   # coming down: home to the car, facing the way the usual view does
		_zoom_off = _zoom_off.lerp(Vector2.ZERO, 1.0 - exp(-dt * 3.5))
		_zoom_yaw_to = _cam_yaw
	elif _paused:   # the arrows move the view while the city holds (while it runs they drive)
		var d := PInput.dir()
		if d != Vector2.ZERO:
			_zoom_off += (-lf * d.x - fw * d.y) * dist * 0.8 * dt
			_zoom_keep_in()
	_zoom_yaw = lerp_angle(_zoom_yaw, _zoom_yaw_to, 1.0 - exp(-dt * 6.0))
	var w := smoothstep(0.0, ZOOM_BLEND, z)
	_zoom_far(w > 0.5, ZOOM_FAR_FROM if z < ZOOM_SMALL else ZOOM_FAR_HIGH)
	var c2 := _view_pos + _zoom_off
	var gy := _h(c2)
	var back := dist * cos(pitch)
	var up := dist * sin(pitch)
	if up < 40.0:   # low: not inside the block behind
		back = minf(back, _clear_behind(c2, -fw, back))
	var e2 := c2 - fw * back
	# low over the town: over the roofs round the eye, not in them (up quickly, down gently)
	var need := 0.0
	if up < 150.0:
		need = maxf(0.0, _h(e2) + _roof_near(e2, 8.0) + 4.0 - (gy + up))
	_zoom_lift = lerpf(_zoom_lift, need, 1.0 - exp(-dt * (12.0 if need > _zoom_lift else 2.0)))
	var eye := Vector3(e2.x, maxf(gy + up + _zoom_lift, _h(e2) + 2.0), e2.y)
	var at := Vector3(c2.x, gy + 1.0, c2.y)
	var over := Transform3D(Basis.looking_at(at - eye, Vector3.UP), eye)
	cam.transform = cam.transform.interpolate_with(over, w)
	_cam_base = cam.transform   # (the shell shakes the camera from here)
	cam.fov = lerpf(cam.fov, 58.0, w)
	# up high: nothing is near, so the near plane goes out with the view and the thin layers
	# (paint on asphalt on ground) keep their depth; the haze thins so the town below is clear
	cam.near = lerpf(0.05 if _cockpit else 0.3, maxf(0.3, dist * 0.15), w)
	env.fog_density = (_fog_night() if _night else _fog_day()) * lerpf(1.0, 0.2, smoothstep(0.2, 1.0, z))

## the view's centre kept over the town
func _zoom_keep_in() -> void:
	var c := (_view_pos + _zoom_off).clamp(world_area.position, world_area.end)
	_zoom_off = c - _view_pos

## a drag of `rel` design pixels: the ground under the pointer goes with it
func _zoom_pan(rel: Vector2) -> void:
	var z := _zoom_v
	var mpp := 2.0 * _zoom_dist(z) * tan(deg_to_rad(cam.fov) * 0.5) / play_area.size.y
	var fw := Vector2(cos(_zoom_yaw), sin(_zoom_yaw))
	var lf := Vector2(fw.y, -fw.x)
	_zoom_off += lf * rel.x * mpp + fw * rel.y * mpp / maxf(sin(_zoom_pitch(z)), 0.3)
	_zoom_keep_in()

## Q / E, or two fingers turning: the view turns about its centre
func _zoom_turn(by: float) -> void:
	_zoom_yaw_to += by

## two fingers on the screen moved: apart to zoom in, together to zoom out, round to turn
func _pinch_move() -> void:
	var ps: Array = _fingers.values()
	var a: Vector2 = ps[0]
	var b: Vector2 = ps[1]
	var d := a.distance_to(b)
	var ang := (b - a).angle()
	if d < 8.0:
		return
	if not _zoomed():   # a pinch together lifts the view (on the first good squeeze)
		if _pinch0 > 0.0 and d < _pinch0 * 0.8:
			_zoom_set(ZOOM_MIN)
			_pinch = Vector2(d, ang)
		return
	if _pinch.x > 0.0 and _zoom > 0.0:
		var z := _zoom - log(d / _pinch.x) / log(ZOOM_FAR / ZOOM_NEAR)
		if z < ZOOM_MIN and d > _pinch.x:   # spreading on at the lowest: the push to come down
			_zoom_in_more()
		if _zoom > 0.0:
			_zoom = clampf(z, ZOOM_MIN, 1.0)
			_zoom_v = _zoom   # (under the fingers, no easing)
			_zoom_yaw_to -= wrapf(ang - _pinch.y, -PI, PI)   # the town turns with the fingers
			_zoom_yaw = _zoom_yaw_to
	_pinch = Vector2(d, ang)

## a line of HUD text with the labels' dark outline, readable over a pale town from above
func _hud_text(at: Vector2, text: String, width: float, size: int, col: Color) -> void:
	_hud.draw_string_outline(_font, at, text, HORIZONTAL_ALIGNMENT_CENTER, width, size, 4, Color(Palette.col("bg"), col.a))
	_hud.draw_string(_font, at, text, HORIZONTAL_ALIGNMENT_CENTER, width, size, col)

## where you are, from above: a ring that breathes round you and an arrow the way you face;
## off the screen (dragged away), an arrow at its edge pointing back. On foot, the car too.
func _draw_zoom_marks() -> void:
	if _zoom_v < 0.05:
		return
	var a := smoothstep(0.05, ZOOM_MIN - 0.02, _zoom_v)   # (all there from the lowest view up)
	var col := Palette.col("player")
	var pulse := 0.5 + 0.5 * sin(Time.get_ticks_msec() * 0.006)
	var me3 := Vector3(_view_pos.x, _view_y + 1.0, _view_pos.y)
	var inner := Rect2(14, 44, 556, 262)   # (clear of the buttons on the right and along the bottom)
	if _walking:
		var car3 := Vector3(_car_at.x, _car_y_at + 1.0, _car_at.y)
		if not cam.is_position_behind(car3):
			var cs := to_screen(car3)
			if inner.has_point(cs):
				var ac := Color(Palette.col("accent"), a * 0.9)
				_hud.draw_rect(Rect2(cs - Vector2(5, 5), Vector2(10, 10)), ac, false, 2.0)
				_hud_text(cs + Vector2(-20, 18), "car", 40, 9, ac)
	var behind := cam.is_position_behind(me3)
	var s := to_screen(me3)
	if not behind and inner.has_point(s):
		_hud.draw_arc(s, 9.0 + pulse * 5.0, 0.0, TAU, 32, Color(col, a * (0.95 - pulse * 0.55)), 2.0)
		_hud.draw_circle(s, 4.0, Color(col, a))
		var ahead := to_screen(me3 + Vector3(cos(_view_yaw), 0.0, sin(_view_yaw)) * _zoom_dist(_zoom_v) * 0.05)
		var v := (ahead - s).normalized()
		if v != Vector2.ZERO:
			var n := Vector2(-v.y, v.x)
			_hud.draw_colored_polygon(PackedVector2Array([s + v * 22.0, s + v * 13.0 + n * 5.0, s + v * 13.0 - n * 5.0]), Color(col, a))
		return
	# off the screen: an arrow on its edge, pointing to where you are
	var mid := play_area.get_center()
	var to := (s - mid) * (-1.0 if behind else 1.0)
	if to.length() < 1.0:
		return
	var k := minf(absf((inner.size.x * 0.5) / to.x) if to.x != 0.0 else INF, absf((inner.size.y * 0.5) / to.y) if to.y != 0.0 else INF)
	var at := mid + to * k
	var v := to.normalized()
	var n := Vector2(-v.y, v.x)
	_hud.draw_colored_polygon(PackedVector2Array([at, at - v * 12.0 + n * 7.0, at - v * 12.0 - n * 7.0]), Color(col, a))
	_hud_text(at - v * 26.0 + Vector2(-20, 4), "you", 40, 9, Color(col, a))

## ---- autodrive: follow the road graph in the right-hand lane, preferring new streets ----

## the green wave on or off (wave.gd): the lights the car comes up to turn green its way
func _set_wave(on: bool) -> void:
	if _wave == null:
		return
	_wave.set_on(on)
	_show_banner("green wave: the lights ahead turn green for you" if on else "green wave off", 1.6)
	Probe.event("wave", {"on": on})
	if on and _racer != null and _racer.on:   # (one style at a time: the racer runs the reds anyway)
		_racer.set_on(false)
	_ap_style = "wave" if on else ("racer" if _racer != null and _racer.on else "rules")

## racer mode (racer.gd): autodrive with the rules off. On puts autodrive on; autodrive off
## (taking the wheel, the stick, walking) ends it too
func _racing() -> bool:
	return _racer != null and _racer.on and _auto

func _set_racer(on: bool) -> void:
	if _racer == null:
		return
	_racer.set_on(on)
	if on and _wave != null and _wave.on:
		_wave.set_on(false)
	if on and not _auto:
		_set_auto(true)
	_show_banner("racer: no lights, no signs, no giving way" if on else "racer off: autodrive keeps the rules again", 1.8)
	Probe.event("racer", {"on": on})
	_ap_style = "racer" if on else ("wave" if _wave != null and _wave.on else "rules")

## How autodrive drives when YOU switch it on (its button, "drive to", the style chip, the
## drawer): keeping the rules, with the green wave, or as a racer. Racer is the default (the
## user, 22 Nov: "change the default of the autodrive to racer, without green wave"). Only
## the player's own switches apply it: the bots (space), the test routes and every scene
## test turn autodrive on with _set_auto and so still keep the rules -- what they measure.
## (The wave works while you drive yourself too: it stays on when you take the wheel.)
const AP_STYLES := ["rules", "wave", "racer"]
const AP_STYLE_SAY := {"rules": "keeps rules", "wave": "green wave", "racer": "racer"}
var _ap_style := "racer"

func _apply_ap_style() -> void:
	if _racer != null and _racer.on != (_ap_style == "racer"):
		_racer.set_on(_ap_style == "racer")
	if _wave != null and _wave.on != (_ap_style == "wave"):
		_wave.set_on(_ap_style == "wave")

func _set_ap_style(s: String) -> void:
	_ap_style = s
	_apply_ap_style()
	_show_banner({"rules": "autodrive keeps the rules", "wave": "green wave: the lights ahead turn green for you",
		"racer": "racer: no lights, no signs, no giving way"}[s], 1.8)
	Probe.event("ap_style", {"style": s})

## how autodrive is driving NOW -- the chip shows this, not the setting: a test drive's
## autodrive kept the rules while the chip said "racer" (the user: "the test drives are
## actually driving in racer mode, or its a bug?" -- the chip's, they were not)
func _ap_style_now() -> String:
	return "racer" if _racer != null and _racer.on else ("wave" if _wave != null and _wave.on else "rules")

## autodrive on or off from the player's own hand: on, in the style chosen
func _auto_by_hand(on: bool) -> void:
	if on:
		_apply_ap_style()
	_set_auto(on)

func _set_auto(on: bool) -> void:
	_auto = on
	_cross = {}
	_ap_queue = []
	_ap_pts = PackedVector2Array()
	_ap_v = PackedFloat32Array()
	_ap_lim = PackedFloat32Array()
	_ap_stuck = 0.0
	_ap_back = 0.0
	_ap_turn = 0.0
	_ap_dead = Vector2.INF
	_ap_kt = {}
	if on:
		_gear = 1
	Probe.event("autodrive", {"on": on})
	_show_banner("autodrive" if on else "you drive", 1.2)

## the lower of two speeds, noting what the new one is for when it is the lower
func _held(cur: float, v: float, why: String) -> float:
	if v < cur:
		_ap_why = why
		return v
	return cur

## autodrive behind the car in front: the speed to hold, with `free` m of road to its back
## (beyond the gap kept standing), `room` that less the second or so kept behind at its pace,
## it going `lv` along my way and speeding up `la` (braking: below 0).
## (Each a user's "sudden stops due to other cars", charted -- tests/drive_trace.py: 8 hard
## brakes a drive, 4.6-6.3 m/s^2 into the last metres, none of them needed:
##  - a metre inside the second kept behind a car going its own pace, the speed asked for
##    fell from that car's to nothing at once (`0.0 if room <= 0.0`), so it stood on the
##    brakes behind a car doing 21 km/h, and stopped dead behind a queue pulling away;
##  - behind a car that stopped (traffic brakes up to 7.5 m/s^2), it slowed only as the
##    speed asked for came down, 2 m/s^2 for each m/s over it (see the brake below): it ran
##    1-1.5 m/s over the slope all the way down and braked the last few metres hard.
## Now: inside the second, a little under its pace to open the gap; and once a steady 2 m/s^2
## will not do -- to its standing spot if it keeps braking as now, or to its pace by its back
## -- the speed that brakes as hard as is needed, as `_ap_brake_for` does for a stop line.)
## autodrive: car ci, `along` m ahead on my way, crossing it -- and off it, its back past my
## sides, before my nose can get there? Then it is no car to stop behind.
## (Each car crossing in front was a wall standing in the lane: autodrive slowing to go on
## after giving way to a car at 49 km/h, that car 7 m ahead and gone in a third of a second,
## stood on the brakes 6 m/s^2 for it -- a user: "in some crosses others just drive while
## the autodrive is hesitant".)
func _ap_crossing_clears(ci: int, along: float) -> bool:
	var c = _traffic.cars[ci]
	if c.v < 3.0 or c.acc < -2.0:
		return false   # (crawling, or braking: it may stop there)
	var p := _ap_point_ahead(along)
	var pd := (_ap_point_ahead(along + 2.0) - p).normalized()
	var cdir := Vector2(sin(c.yaw), cos(c.yaw))
	if pd == Vector2.ZERO or absf(cdir.dot(pd)) > 0.5:
		return false   # (going my way, or at me: not across)
	var side := Vector2(-pd.y, pd.x)
	var vs: float = c.v * cdir.dot(side)   # its speed across my way
	if absf(vs) < 2.0:
		return false
	var off: float = (c.pos - p).dot(side) * signf(vs)   # its middle past my line, the way it goes
	var reach: float = c.len * 0.5 * absf(cdir.dot(side)) + 0.9 * absf(cdir.dot(pd))
	var t_clear: float = maxf(reach + 1.4 - off, 0.0) / absf(vs)   # (its back 1.4 m past my line: my side and half a metre)
	var d := maxf(along - CAR_LEN * 0.5 - 1.0, 0.0)
	var v := maxf(_v, 0.0)
	var t_me := (sqrt(v * v + 4.0 * d) - v) / 2.0   # (my nose there speeding up at 2 m/s^2 from now)
	return t_clear + 0.3 < t_me

func _ap_follow_v(free: float, room: float, lv: float, la: float) -> float:
	if free <= 0.0:
		return 0.0
	var v := maxf(_v, 0.0)
	var follow := sqrt(lv * lv + 2.0 * 2.6 * room) if room > 0.0 else maxf(lv + room * 0.5, 0.0)
	var need := 0.0
	if la < -0.5 and lv > 0.3:
		var stop := free + lv * lv / (2.0 * -la)   # where it will stand, braking as now
		follow = minf(follow, sqrt(2.0 * 2.6 * stop))
		need = v * v / (2.0 * maxf(stop, 0.3))
	elif v > lv:
		need = (v - lv) * (v - lv) / (2.0 * maxf(free, 0.3))
	if need > 2.0:
		follow = minf(follow, maxf(v - minf(need * 1.2, 6.0) * 0.5, 0.0))
	return follow

func _autodrive(dt: float) -> Array:
	# into the walls again and again (a few in quick succession): lost, back to the street
	_ap_bonks = maxf(0.0, _ap_bonks - dt / 10.0)
	_ap_backouts = maxf(0.0, _ap_backouts - dt / 30.0)
	if not _ap_rev.is_empty():
		return _ap_reverse(dt)
	if _ap_bonks >= 3.0 and (_ap_backout(40.0) or _ap_rescue()):
		_ap_bonks = 0.0
		_ap_pts = PackedVector2Array()
		if not _ap_rev.is_empty():
			return _ap_reverse(dt)
	if _ap_back > 0.0:     # stuck against something: back off, then plan again
		_ap_back -= dt
		_gear = -1
		# looking over the shoulder: anything behind (a car, a post, a wall, someone) and
		# it stops backing -- it used to reverse its 1.4 s blind, into the car behind
		var tail := _pos - _fwd() * (CAR_OFF + 0.7 + absf(_v) * 0.4)
		var behind := _push_out(tail, CAR_R, true, true, _y) != Vector2.ZERO
		behind = behind or not _people_near(tail, 2.5).is_empty()
		if behind or _ap_back <= 0.0:
			_ap_back = 0.0
			_gear = 1
			_ap_pts = PackedVector2Array()
			return [0.0, 1.0, 0.0]
		return [0.7, 0.0, -signf(_steer) * MAX_STEER * 0.6]
	if _ap_pts.size() < 2 or _ap_off_route() > 25.0:
		_ap_plan()
		if _ap_pts.size() < 2:
			return [0.0, 1.0, 0.0]
	# forget what is behind: we are on whichever of the next stretches is closest. Looking
	# at only the current one lost track after a sharp corner and sent the car back round
	# to a point it had already passed.
	var at := _ap_nearest_seg()
	for _k in range(at):
		_ap_pts.remove_at(0)
		_ap_v.remove_at(0)
		_ap_lim.remove_at(0)
	_cross_tick()
	var legs := 0
	while _ap_len() < 160.0:
		# one leg a tick while there is plenty ahead: planning one is a few milliseconds (more
		# in a browser), and several in the same tick showed as a stutter
		if legs > 0 and _ap_len() > 90.0:
			break
		legs += 1
		if not _ap_next():
			# nowhere further (and no crossing waiting on a choice): stop at the end of the
			# plan instead of running on past it, off the road and into whatever is there
			if _cross.is_empty() and _ap_v.size() > 0:
				_ap_v[_ap_v.size() - 1] = 0.0
			break
	# at a dead end: stopped short of its end, it turns round there in moves forward and back
	if _ap_kt.is_empty() and _ap_dead != Vector2.INF and _ap_at_dead():
		if absf(_v) > 0.3:
			# (on the brake at the stop: crawling up to the plan's last point, it could roll on
			# past it, and the speed allowed grew with its distance from it, behind or not)
			_ap_why = "turning"
			return [0.0, 1.0, 0.0]
		_ap_kt_start()
	if not _ap_kt.is_empty():
		return _ap_kturn(dt)
	# at a one-way dead end's turning point, stopped: on to the lane back, which faces the
	# other way, so it turns round on the spot just below
	while _ap_pts.size() > 2 and _ap_v[1] == 0.0 and absf(_v) < 1.0 and _pos.distance_to(_ap_pts[1]) < 5.0:
		_ap_pts.remove_at(0)
		_ap_v.remove_at(0)
		_ap_lim.remove_at(0)
	# facing well away from the lane it must take (handed over pointing the wrong way up a
	# one-way street, or across it): turn round on the spot first. Steering full lock at
	# it from a standstill put the nose into the kerb and the wall behind it, again and again.
	# (the way the lane goes over its next 5 m, not between its next two points: a road
	# 1.5 m long at a junction pointed back the way the car came, it turned round on the
	# spot, then swung back across the junction into the oncoming lane and a car there)
	var lane_dir := (_ap_point_ahead(5.0) - _ap_point_ahead(0.0)).normalized() if _ap_pts.size() > 1 else _fwd()
	if lane_dir == Vector2.ZERO:
		lane_dir = _fwd()
	if _ap_turn <= 0.0 and absf(_v) >= 2.0 and _fwd().dot(lane_dir) < -0.2:
		# the lane it must take is behind it and it is still rolling (it ran past a dead
		# end's turning point at 18 km/h): brake to a stop in a straight line, then turn.
		# Steering for a lane behind at speed swung it wide, off the end, onto the footpath.
		_ap_why = "turning"
		return [0.0, 1.0, 0.0]
	if _ap_turn <= 0.0 and absf(_v) < 2.0 and _fwd().dot(lane_dir) < -0.2:
		_ap_turn = 3.0
		_show_banner("turning round", 1.2)
	if _ap_turn > 0.0:
		_ap_turn -= dt
		var want := lane_dir.angle()
		var diff := angle_difference(_yaw, want)
		_yaw = wrapf(_yaw + clampf(diff, -1.7 * dt, 1.7 * dt), -PI, PI)
		_yaw_rate = 0.0
		_v = 0.0
		_v_lat = 0.0
		if absf(diff) < 0.12:
			_ap_turn = 0.0
		return [0.0, 1.0, 0.0]
	# pure pursuit on a point ahead of the rear axle
	var fwd := _fwd()
	var rear := _pos - fwd * WHEELBASE * 0.5
	# (the point it steers at: nearer at a corner's pace -- 5.4 m ahead at 14 km/h, it started
	# round a right turn 6 m early, came out with the turn not done and crossed its new lane
	# toward the middle line by a metre; the same as before from ~50 km/h)
	var look := clampf(2.0 + absf(_v) * 0.6, 3.5, 16.0)
	var tgt := _ap_point_ahead(look)
	var to := tgt - rear
	var alpha := fwd.angle_to(to)
	var steer := clampf(atan(2.0 * WHEELBASE * sin(alpha) / maxf(to.length(), 1.0)), -MAX_STEER, MAX_STEER)
	# a safety net: anything solid near where the nose will be in a moment (a parked car's
	# corner, a building on a bend) steers it away, and slows it if it is dead ahead. The
	# planned lane is clear; this catches the car drifting off it.
	var nose := _pos + fwd * (CAR_OFF + 0.5 + absf(_v) * 0.3)
	var shove := _push_out(nose, 1.15, true, false, _y)
	var ahead_blocked := false
	if shove != Vector2.ZERO:
		var side := Vector2(-fwd.y, fwd.x)
		steer = clampf(steer + clampf(shove.dot(side) * 0.45, -0.3, 0.3), -MAX_STEER, MAX_STEER)
		ahead_blocked = shove.normalized().dot(fwd) < -0.6
	# keep the limit, and slow for the corners ahead: at most the speed from which each
	# one can still be braked down to in time
	var racing := _racing()
	var vt: float = _racer.limit(_ap_lim[1]) if racing else _ap_lim[1]
	_ap_why = "limit"
	var dist := 0.0
	var p := _pos
	for i in range(1, _ap_pts.size()):
		dist += p.distance_to(_ap_pts[i])
		p = _ap_pts[i]
		if dist > 90.0:
			break
		# (a stop -- a dead end's turning point -- a metre and a half short, so the car is
		# standing when it gets there rather than rolling past)
		# (and a corner aimed at half a second early: braking by how far over its target it is,
		# 2 m/s^2 a m/s, it ran ~1.3 m/s over the 2.6 m/s^2 slope down to each corner, into it
		# 5-7 km/h faster than planned and out wide -- tests/turn_width.gd)
		var to_go := maxf(dist - absf(_v) * 0.5, 0.0) if _ap_v[i] > 0.0 else maxf(dist - 1.5, 0.0)
		# (racer: the gentle bends faster; a tight turn at its usual pace -- taken faster it swung
		# wide into the corner's posts, 33 km/h into one in Tel Aviv)
		var corner: float = _ap_v[i] * (_racer.CORNER_K if racing and _ap_v[i] >= _racer.CORNER_FROM else 1.0)
		vt = _held(vt, sqrt(corner * corner + 2.0 * (4.0 if racing else 2.6) * to_go), "curve")
	if not racing:   # (racer.gd: no lights, signs, nor giving way)
		vt = _held(vt, _ap_light_v(), "light")
		vt = _held(vt, _ap_sign_v(dt), "sign")
	# (people on a zebra and in the lane: always -- racer once left the zebra out with the
	# rest and hit someone crossing in Tel Aviv at 11 km/h: on the crossing already, they were
	# only in its lane when it was too close to stop)
	vt = _held(vt, _ap_zebra_v(), "zebra")
	vt = _held(vt, _ap_people_v(), "people")
	var tg := Time.get_ticks_usec()
	if not racing:
		vt = _held(vt, _ap_give_v(dt), "junction")
	_prof["autodrive: give way"] = int(_prof.get("autodrive: give way", 0)) + Time.get_ticks_usec() - tg
	_ap_give_us += Time.get_ticks_usec() - tg
	if not _cross.is_empty() and not _cross["chosen"]:
		_ap_why = "choice" if vt >= CROSS_V else _ap_why
	if ahead_blocked:
		vt = _held(vt, 2.5, "blocked")
	# the car in front, kept a couple of metres and a second or so behind; after waiting
	# a while, ignore cars crossing the lane (a standoff in a junction) -- never one ahead
	var reach := clampf(12.0 + _v * 1.2 + _v * _v / 5.2, 18.0, 130.0)
	var lead: Array = _traffic.lead_on(_ap_pts, _pos, reach, _ap_wait > 3.0, _y)
	if racing and float(lead[0]) < 70.0 and _ap_race_by(lead):
		lead = _traffic.lead_on(_ap_pts, _pos, reach, _ap_wait > 3.0, _y)
	if racing and float(lead[0]) < 22.0 and _ap_wait > 1.0 and _ap_mount_by(lead):
		lead = _traffic.lead_on(_ap_pts, _pos, reach, _ap_wait > 3.0, _y)
	if float(lead[0]) < (60.0 if racing else 30.0) and _ap_pass_bus(lead):
		lead = _traffic.lead_on(_ap_pts, _pos, reach, _ap_wait > 3.0, _y)
	elif racing and float(lead[0]) < 40.0 and float(lead[1]) < 1.0 and _ap_mount_by(lead):
		# (coming up to a queue standing in every lane -- a red, every lane full -- onto the
		# pavement while there is still room to swing up: tried only once stood behind it, 6 m
		# from the car in front, the way up ran through that car's back and it stood there for
		# the whole red, the user's "racer waits on red light after a car", tests/racer_queue.gd)
		lead = _traffic.lead_on(_ap_pts, _pos, reach, _ap_wait > 3.0, _y)
	if float(lead[0]) < INF and int(lead[3]) >= 0 and _ap_crossing_clears(int(lead[3]), float(lead[0])):
		lead = _traffic.lead_on(_ap_pts, _pos, reach, _ap_wait > 3.0, _y, int(lead[3]))
	_ap_lead = float(lead[0]) if float(lead[0]) < INF else -1.0
	_ap_lead_i = int(lead[3]) if float(lead[0]) < INF else -1
	if float(lead[0]) < INF:
		var lv: float = lead[1]
		var li := int(lead[3])
		# from my nose to its back (a bus is two and a half cars long: kept a car's length
		# from its middle, autodrive drove into its back), less the gap kept standing
		var free := float(lead[0]) - CAR_LEN * 0.5 - float(lead[2]) - 2.2
		if li >= 0 and _traffic._parked_double(_traffic.cars[li]):
			free -= 4.5   # (a delivery van standing: wait well back, room to pull out round it)
		# how hard it is braking, along my way (over a few ticks; a new car in front, afresh)
		var la := 0.0
		if li >= 0 and _traffic.cars[li].v > 0.1:
			la = _traffic.cars[li].acc * lv / _traffic.cars[li].v
		_ap_lead_a = lerpf(_ap_lead_a, la, minf(dt * 10.0, 1.0)) if li == _ap_lead_was else la
		_ap_lead_was = li
		var follow := _ap_follow_v(free, free - lv * 1.2, lv, _ap_lead_a)
		if follow < vt:
			vt = follow
			_ap_why = "car"
			_ap_wait = _ap_wait + dt if _v < 0.3 else 0.0
		else:
			_ap_wait = 0.0
	else:
		_ap_wait = 0.0
	var err := vt - _v
	var throttle := clampf(err * 0.35, 0.0, 1.0)
	var brake := clampf(-err * 0.25, 0.0, 1.0) if err < -0.3 else 0.0
	if vt < 0.5 and _v < 1.5:
		# waiting at a light or behind a car: foot on the brake -- firmly once all but
		# standing; the last 5 km/h of a stop at ~3.6 m/s^2, as people ease off (0.8 from
		# 1.5 m/s ended every stop with a 6.5 m/s^2 jolt)
		brake = maxf(brake, 0.8 if _v < 0.4 else 0.45)
	if throttle > 0.3 and absf(_v) < 0.4:
		_ap_stuck += dt
		if _ap_stuck > 2.0:
			_ap_stuck = 0.0
			if not _ap_backout(10.0):   # (back the way it came; blind, with no way known)
				_ap_back = 1.4
			# a push that went nowhere counts as a bump (too slow to be one): three in a row
			# and it is lost, back to the street. Forward into a post, back, forward into it
			# again went on for a minute and a half, foot on the gas -- not driving.
			_ap_bonks += 1.0
			Probe.event("autodrive_stuck")
	else:
		_ap_stuck = 0.0
	_ap_watch(dt, vt)
	return [throttle, brake, steer]

## The last resort: autodrive that has got nowhere for 40 s -- not waiting at a light,
## just stuck (a dead end at the edge of the map, a knot of buildings the plan runs into) --
## is lifted onto a street a little way toward the middle of town, and drives on from there.
var _ap_mark := Vector2.INF
var _ap_mark_t := 0.0
const AP_GIVE_UP := 40.0

func _ap_watch(dt: float, vt: float) -> void:
	if _ap_mark == Vector2.INF or _pos.distance_to(_ap_mark) > 12.0 or _ap_light_v() < 0.5 or not _cross.is_empty() \
			or _in_a_queue() or not _ap_giving.is_empty():
		_ap_mark = _pos
		_ap_mark_t = 0.0
		return
	_ap_mark_t += dt
	if _ap_mark_t < AP_GIVE_UP:
		return
	_ap_mark = Vector2.INF
	if _ap_backout(45.0):   # the way it came, first: no jump
		_ap_pts = PackedVector2Array()
		_log.event("backing out")
		return
	var mid := _bounds.get_center()
	var toward := (mid - _pos).normalized()
	for reach: float in [40.0, 80.0, 140.0]:
		if _land_on_road(_pos + toward * reach, 50.0, toward):
			_ap_pts = PackedVector2Array()
			_show_banner("autodrive: unstuck", 1.6)
			Probe.event("autodrive_unstuck")
			_log.event("unstuck")
			return

## behind a car that is waiting its turn (at a light, behind another, for people, at a
## junction) and has not itself been standing for ages: a queue, not stuck. Forty seconds
## in a slow queue at a red read as stuck, and the car was lifted onto another street.
func _in_a_queue() -> bool:
	if _ap_why != "car" or _ap_lead < 0.0:
		return false
	var lead: Array = _traffic.lead_on(_ap_pts, _pos, _ap_lead + 1.0, _ap_wait > 3.0)
	if int(lead[3]) < 0:
		return false
	var c = _traffic.cars[int(lead[3])]
	return c.still < 30.0 or c.why == "light"   # (a light waits a cycle at most; a jam of cars, 30 s)

## the point `dist` metres along the planned lane from point k (negative = back)
func _ap_walk(k: int, dist: float) -> Vector2:
	var step := 1 if dist > 0.0 else -1
	var left := absf(dist)
	var p := _ap_pts[k]
	var j := k + step
	while j >= 0 and j < _ap_pts.size():
		var L := p.distance_to(_ap_pts[j])
		if L >= left:
			return p + (_ap_pts[j] - p) * (left / maxf(L, 0.0001))
		left -= L
		p = _ap_pts[j]
		j += step
	return p

## index of the planned stretch the car is on: the closest of the next three, or of any
## further one that starts within 60 m of the car (not "within 40 m of the point behind":
## a long first stretch then hid the next one, and the car never saw its stop coming)
func _ap_nearest_seg() -> int:
	var best_i := 0
	var best_d := INF
	for i in range(_ap_pts.size() - 1):
		if i >= 3 and _ap_pts[i].distance_to(_pos) > 60.0:
			break
		var d := Geometry2D.get_closest_point_to_segment(_pos, _ap_pts[i], _ap_pts[i + 1]).distance_to(_pos)
		if d < best_d - 0.05:
			best_d = d
			best_i = i
	return best_i

func _ap_off_route() -> float:
	if _ap_pts.size() < 2:
		return INF
	var i := _ap_nearest_seg()
	return Geometry2D.get_closest_point_to_segment(_pos, _ap_pts[i], _ap_pts[i + 1]).distance_to(_pos)

## how much of the plan is still ahead: from the car's place on its first stretch. Measured
## from the stretch's start, a plan of one long straight -- set down on Ashdod's HaMada, 173 m
## to a junction -- read 173 m however far along the car was, never reached the 160 it is
## topped up below, and the car ran on past the junction at 49 km/h into the lane beyond and
## a building (tests/drive_bumps.gd LEVEL=3 STARTS=12 ONLY=11, 22 Nov).
func _ap_len() -> float:
	if _ap_pts.size() < 2:
		return 0.0
	var L := Geometry2D.get_closest_point_to_segment(_pos, _ap_pts[0], _ap_pts[1]).distance_to(_ap_pts[1])
	for i in range(2, _ap_pts.size()):
		L += _ap_pts[i - 1].distance_to(_ap_pts[i])
	return L

func _ap_point_ahead(look: float) -> Vector2:
	var p := Geometry2D.get_closest_point_to_segment(_pos, _ap_pts[0], _ap_pts[1])
	var left := look
	for i in range(1, _ap_pts.size()):
		var nxt := _ap_pts[i]
		var L := p.distance_to(nxt)
		if L >= left:
			return p + (nxt - p) * (left / maxf(L, 0.001))
		left -= L
		p = nxt
	return p

const AP_OFFROAD_V := 4.0             ## m/s, finding its way back to the road
const WAY_CELL := 2.0
const WAY_REACH := 36                 ## cells each way from the car: 72 m

## The way from the car back onto a road it can drive, round whatever buildings are in
## between: a search outward over 2 m squares the car fits through, to the first one well on
## the asphalt, then pulled straight wherever a straight line is clear. [] when there is none
## within reach.
func _way_to_road() -> PackedVector2Array:
	var origin := _pos
	var came := {Vector2i.ZERO: Vector2i.ZERO}
	var wall := {}
	var queue: Array[Vector2i] = [Vector2i.ZERO]
	var head := 0
	var goal := Vector2i.ZERO
	var found := false
	var steps: Array[Vector2i] = [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1),
		Vector2i(1, 1), Vector2i(1, -1), Vector2i(-1, 1), Vector2i(-1, -1)]
	while head < queue.size():
		var c: Vector2i = queue[head]
		head += 1
		if c != Vector2i.ZERO:
			var on := _nearest_seg(origin + Vector2(c) * WAY_CELL, 8.0, true, true, _y)
			if not on.is_empty() and float(on["edge"]) < -1.2:
				goal = c
				found = true
				break
		for st: Vector2i in steps:
			var n: Vector2i = c + st
			if came.has(n) or wall.has(n) or absi(n.x) > WAY_REACH or absi(n.y) > WAY_REACH:
				continue
			if _push_out(origin + Vector2(n) * WAY_CELL, 1.3, true, false, _y) != Vector2.ZERO:
				wall[n] = true
				continue
			came[n] = c
			queue.append(n)
	if not found:
		return PackedVector2Array()
	var cells: Array[Vector2i] = []
	var at := goal
	while at != Vector2i.ZERO:
		cells.append(at)
		at = came[at]
	cells.reverse()
	var out := PackedVector2Array([origin])
	var i := 0
	while i < cells.size():
		var far := i
		for j in range(cells.size() - 1, i, -1):
			if _clear_line(out[out.size() - 1], origin + Vector2(cells[j]) * WAY_CELL):
				far = j
				break
		out.append(origin + Vector2(cells[far]) * WAY_CELL)
		i = far + 1
	return out

## a car's width clear all the way from a to b (from a little way out of a: the car may be
## up against a wall where it stands)
func _clear_line(a: Vector2, b: Vector2) -> bool:
	var L := a.distance_to(b)
	var s := minf(1.5, L)
	while s < L:
		if _push_out(a.lerp(b, s / L), 1.2, true, false, _y) != Vector2.ZERO:
			return false
		s += 1.0
	return true

## ---- backing out the way it came ----------------------------------------------------------
## Where the car is, it drove to: the road it came along is a way back out. A crumb is dropped
## every CRUMB_M driven forward (the last CRUMBS of them); stuck, lost or off the road with no
## way found, autodrive reverses along them -- slowly, steering, looking behind -- until it
## is on a street facing along it, and plans on from there. It used to be lifted onto the
## nearest street, a jump that broke the drive; that is now only for a car with no way back
## (put down in a yard, or the way behind it blocked).
const CRUMB_M := 1.5
const CRUMBS := 70
const AP_REV_V := 2.2                ## reversing speed (m/s)
var _crumbs := PackedVector2Array()
var _ap_rev := PackedVector2Array()  ## the crumbs to back along, the next first
var _ap_rev_m := 0.0                 ## metres backed so far, and at most
var _ap_rev_max := 0.0
var _ap_rev_t := 0.0
var _ap_backouts := 0.0              ## backing out lately (one off every 30 s): the third in a row is a lift

func _drop_crumb() -> void:
	if _walking or not _ap_rev.is_empty():
		return
	if not _crumbs.is_empty() and _crumbs[_crumbs.size() - 1].distance_to(_pos) > 12.0:
		_crumbs = PackedVector2Array()   # (put down somewhere else: an old trail leads nowhere)
	if _v > 0.3 and (_crumbs.is_empty() or _crumbs[_crumbs.size() - 1].distance_to(_pos) >= CRUMB_M):
		_crumbs.append(_pos)
		if _crumbs.size() > CRUMBS:
			_crumbs.remove_at(0)

## start backing out along the crumbs, at most `most` metres; false when there is no trail
func _ap_backout(most: float) -> bool:
	if _ap_backouts >= 2.0:
		return false   # (backed out, drove in, stuck, backed out again: going round in a yard)
	var rev := PackedVector2Array()
	for i in range(_crumbs.size() - 1, -1, -1):
		if _crumbs[i].distance_to(_pos) > 2.0 or not rev.is_empty():
			rev.append(_crumbs[i])
	if rev.size() < 2:
		return false
	_ap_rev = rev
	_ap_backouts += 1.0
	_ap_rev_m = 0.0
	_ap_rev_max = most
	_ap_rev_t = 0.0
	_ap_back = 0.0
	_ap_turn = 0.0
	_cross = {}
	_show_banner("autodrive: backing out", 1.4)
	Probe.event("autodrive_backout", {"m": int(most)})
	return true

## one tick of it: [throttle, brake, steer], the gear in reverse
func _ap_reverse(dt: float) -> Array:
	_ap_rev_t += dt
	_gear = -1
	var fwd := _fwd()
	var rear := _pos - fwd * WHEELBASE * 0.5
	while _ap_rev.size() > 1 and _ap_rev[0].distance_to(rear) < 1.6:
		_ap_rev_m += _ap_rev[0].distance_to(_ap_rev[1])
		_ap_rev.remove_at(0)
	# done: out far enough and on a street, along it -- or the trail ran out, or too long
	var on := _nearest_seg(_pos, 8.0, true, true, _y)
	var on_street := not on.is_empty() and float(on["edge"]) < -0.3 and _ap_rev_m > 5.0
	if on_street:
		var r: Dictionary = _roads[int(on["road"])]
		var rp: PackedVector2Array = r["pts"]
		var sj: int = on["seg"]
		on_street = absf(fwd.dot((rp[sj + 1] - rp[sj]).normalized())) > 0.8
	var behind := _push_out(_pos - fwd * (CAR_OFF + 0.7 + absf(_v) * 0.4), CAR_R, true, true, _y) != Vector2.ZERO \
			or not _people_near(_pos - fwd * (CAR_OFF + 1.0), 2.5).is_empty()
	if on_street or _ap_rev.size() <= 1 or _ap_rev_m >= _ap_rev_max or _ap_rev_t > 25.0 or behind:
		_ap_rev = PackedVector2Array()
		_crumbs = PackedVector2Array()   # (that way is used: a fresh trail from here)
		_gear = 1
		_ap_pts = PackedVector2Array()
		if behind and not on_street:
			_ap_bonks += 1.0   # (blocked behind too: a few of these and it is lifted out)
		return [0.0, 1.0, 0.0]
	# pure pursuit backwards: the rear leads, a point a few metres back along the trail
	var tgt := _ap_rev[_ap_rev.size() - 1]
	var acc := 0.0
	for i in range(_ap_rev.size()):
		if i > 0:
			acc += _ap_rev[i - 1].distance_to(_ap_rev[i])
		if _ap_rev[i].distance_to(rear) >= 3.5 or acc > 5.0:
			tgt = _ap_rev[i]
			break
	var to := tgt - rear
	var alpha := (-fwd).angle_to(to)
	var steer := clampf(-atan(2.0 * WHEELBASE * sin(alpha) / maxf(to.length(), 1.0)), -MAX_STEER, MAX_STEER)
	var sp := absf(_v)
	var throttle := 0.55 if sp < AP_REV_V - 0.3 else 0.0
	var brake := 0.5 if sp > AP_REV_V + 0.6 else 0.0
	_ap_why = "backing"
	return [throttle, brake, steer]

## Lost: no way back found, or into the walls again and again. Back onto the nearest street,
## the way the 40 s unstuck does.
func _ap_rescue() -> bool:
	_ap_bonks = 0.0
	if not _land_on_road(_pos, 80.0, _fwd()):
		return false
	_ap_back = 0.0
	_ap_turn = 0.0
	_show_banner("autodrive: back on the road", 1.6)
	Probe.event("autodrive_rescue")
	_log.event("rescue")
	return true

func _ap_plan() -> void:
	_cross = {}
	_ap_queue = []
	_ap_dead = Vector2.INF
	_ap_kt = {}
	_ap_pts = PackedVector2Array()
	_ap_v = PackedFloat32Array()
	_ap_lim = PackedFloat32Array()
	if _dest_on:
		# off the road (on a footpath, in a yard): first the way back onto it, as below. The
		# trip planned from the nearest street as if the car were on it, and autodrive drove
		# along the footpath beside it into the bollards at its end, for a minute and a half.
		var from := _pos
		var heading := _fwd()
		var way := PackedVector2Array()
		var on := _nearest_seg(_pos, 60.0, true, true, _y)
		if not on.is_empty() and float(on["edge"]) > 1.0:
			way = _way_to_road()
			if way.size() >= 2:
				from = way[way.size() - 1]
				heading = (way[way.size() - 1] - way[way.size() - 2]).normalized()
			elif _ap_backout(45.0):
				return   # (out the way it came; the trip planned once on the street)
			elif _ap_rescue():
				from = _pos
				heading = _fwd()
		if not _route_to(_dest, from, heading):
			_show_banner("can't find a way there from here", 2.0)
			_clear_dest()
			if not _route.is_empty():   # a drive of the route set: back to the list
				get_tree().create_timer(3.0).timeout.connect(func(): Flow.start_game("streets", {"level": _routes_level()}))
			return
		if way.size() >= 2:
			var off_v := PackedFloat32Array()
			off_v.resize(way.size() - 1)
			off_v.fill(AP_OFFROAD_V)
			way.resize(way.size() - 1)   # (the route starts where the way ends)
			way.append_array(_ap_pts)
			_ap_pts = way
			off_v.append_array(_ap_v)
			_ap_v = off_v
			var off_l := PackedFloat32Array()
			off_l.resize(_ap_pts.size() - _ap_lim.size())
			off_l.fill(AP_OFFROAD_V)
			off_l.append_array(_ap_lim)
			_ap_lim = off_l
		return
	var hit := _nearest_seg(_pos, 60.0, true, true, _y)
	if hit.is_empty():
		return
	var heading := _fwd()
	if float(hit["edge"]) > 1.0:
		# off the road (a yard, a car park, between blocks): the way back to it round the
		# buildings. Straight at the nearest bit of road went into the wall in between, backed
		# off, planned the same again, and into the wall again.
		var way := _way_to_road()
		if way.size() < 2:
			if _ap_backout(45.0):
				return   # (out the way it came; planned again once on the street)
			if not _ap_rescue():
				return
			hit = _nearest_seg(_pos, 20.0, true, true, _y)
			if hit.is_empty():
				return
			heading = _fwd()
		else:
			for q: Vector2 in way:
				_ap_pts.append(q)
				_ap_v.append(AP_OFFROAD_V)
				_ap_lim.append(AP_OFFROAD_V)
			heading = (way[way.size() - 1] - way[way.size() - 2]).normalized()
			hit = _nearest_seg(way[way.size() - 1], 12.0, true, true)
			if hit.is_empty():
				return
	# at a junction the nearest road can be the one across it: planned along that, the car
	# turned full lock from a standstill and cut the corner into its post (Givatayim's Eilat
	# by Yitzhak Rabin, HaShalom's crossing: tests/drive_bumps.gd). The road just ahead of the
	# car, if that one runs its way, instead.
	var hp: PackedVector2Array = (_roads[hit["road"]] as Dictionary)["pts"]
	var al := absf((hp[int(hit["seg"]) + 1] - hp[int(hit["seg"])]).normalized().dot(heading))
	if al < 0.7:
		var ahead := _nearest_seg(_pos + heading * 5.0, 8.0, true, true, _y)
		if not ahead.is_empty():
			var ap: PackedVector2Array = (_roads[ahead["road"]] as Dictionary)["pts"]
			if absf((ap[int(ahead["seg"]) + 1] - ap[int(ahead["seg"])]).normalized().dot(heading)) > maxf(al, 0.7):
				hit = ahead
	var ri: int = hit["road"]
	var sj: int = hit["seg"]
	var r: Dictionary = _roads[ri]
	var pts: PackedVector2Array = r["pts"]
	var dir := 1 if (pts[sj + 1] - pts[sj]).dot(heading) >= 0.0 else -1
	if r["o"] != 0:
		dir = r["o"]
		# a divided road's one-way half that only runs off the map: onto its other half, the
		# way back into town, across the median (where a driver would take the last opening in
		# it; the map's edge cut the rest). Not against the one-way, never on this half.
		var mate := int(r.get("mate", -1))
		if mate >= 0 and not _dest_on and _edge_bound(Vector3i(ri, sj + 1 if dir > 0 else sj, dir)):
			var mr: Dictionary = _roads[mate]
			var mp: PackedVector2Array = mr["pts"]
			var best := -1
			var best_d := INF
			for k in range(mp.size() - 1):
				var q := Geometry2D.get_closest_point_to_segment(_pos, mp[k], mp[k + 1])
				if q.distance_to(_pos) < best_d:
					best_d = q.distance_to(_pos)
					best = k
			var mdir := int(mr["o"]) if int(mr["o"]) != 0 else 1
			if best >= 0 and best_d < 40.0 and not _edge_bound(Vector3i(mate, best + 1 if mdir > 0 else best, mdir)):
				_tally("ap_edge_mate", 1)
				Probe.event("edge_mate", {"from": ri, "to": mate})
				hit = {"road": mate, "seg": best, "q": Geometry2D.get_closest_point_to_segment(_pos, mp[best], mp[best + 1]), "edge": 0.0}
				ri = mate
				sj = best
				r = mr
				pts = mp
				dir = mdir
	elif _edge_bound(Vector3i(ri, sj + 1 if dir > 0 else sj, dir)) and not _edge_bound(Vector3i(ri, sj if dir > 0 else sj + 1, -dir)):
		dir = -dir   # that way only runs off the map: the other (it turns round first)
	var d_first := (pts[sj + 1] - pts[sj]).normalized() * float(dir)
	_ap_pts.append((hit["q"] as Vector2) + Vector2(-d_first.y, d_first.x) * _lane_off(r))   # (its lane, see _route_to)
	_ap_v.append(float(r["speed"]))
	_ap_lim.append(float(r["speed"]))
	_ap_leg(ri, sj + 1 if dir > 0 else sj, dir)

## append a road from index `from` to its end in direction `dir`, offset into the lane
func _ap_leg(ri: int, from: int, dir: int) -> void:
	var r: Dictionary = _roads[ri]
	var pts: PackedVector2Array = r["pts"]
	# the right-hand lane: every two-way street has two, however narrow (with traffic
	# about, driving down the middle of one meant meeting cars head on)
	var lane := _lane_off(r)
	var last := pts.size() - 1 if dir > 0 else 0
	if r.get("ring", false):   # a roundabout: plan only to its next exit (see traffic.gd's _ring_stop)
		var ids: PackedInt32Array = r["ids"]
		var k := from
		while k != last:
			if k != from and _node_ways(ids[k]) >= 3:
				last = k
				break
			k += dir
	# a road running off the map stops short of the barrier: a dead end there (see _ap_ways)
	var rim := _bounds.grow(-EDGE - EDGE_ROOM)
	var k2 := from
	while k2 != last:
		if not rim.has_point(pts[k2 + dir]):
			last = k2
			break
		k2 += dir
	var i := from
	_ap_turn_lane(ri, from, dir)
	_ap_turn_into(ri, from, dir, lane)
	var start := maxi(_ap_pts.size() - 6, 0)
	while true:
		var prv := pts[i - dir] if (i - dir >= 0 and i - dir < pts.size()) else pts[i]
		var nxt := pts[i + dir] if (i + dir >= 0 and i + dir < pts.size()) else pts[i]
		var d := (nxt - prv).normalized()
		if d == Vector2.ZERO:
			d = _fwd()
		_ap_pts.append(_clear_lane(pts[i], d, lane))
		_ap_v.append(float(r["speed"]))
		_ap_lim.append(float(r["speed"]))
		if i == last:
			break
		i += dir
	_ap_end = Vector3i(ri, last, dir)
	# corners: the radius through the points 5 m either side of each one, and the speed
	# that keeps the sideways pull comfortable round it. A sharp junction corner and the
	# gentle-looking many-sided ring of a roundabout both come out as the tight turns
	# they are. (Points near the old end are redone now that there is road beyond them.)
	_ap_curves(start - 10)

## Round a bus at its stop: on a road of two lanes or more each way, a bus standing at the
## kerb ahead is passed in the next lane over when that lane is clear from 15 m behind to 25 m
## ahead -- moving out over 8 m before it, back in 12 m past it -- instead of queueing behind
## it for the whole stop (or, as it once did, driving into its back). True when it moved out.
## A delivery van standing in the street (traffic.gd _double_park) the same, and on a street of
## one lane each way over the centre line, when nothing is coming for 45 m past it.
var _ap_passed := -1                 ## the bus last passed (not again)

func _ap_pass_bus(lead: Array) -> bool:
	var bi: int = lead[3]
	if bi < 0:
		return false
	var bus = _traffic.cars[bi]
	var dbl: bool = _traffic._parked_double(bus)
	if bi == _ap_passed:
		# bent round it, and still held by it a couple of seconds on: it stood further out than
		# when the plan was bent (a van pulls in after it stops) -- over a little more, beside
		# it (Katznelson: 32 s behind a van "gone round", its middle 2 m off the bent plan)
		return dbl and _ap_wait > 2.0 and _ap_squeeze_by(bi, float(lead[0]))
	# racer.gd: any car slower than it wants to go, moving or not
	var want: float = _racer.limit(_ap_lim[1]) if _racing() and _ap_lim.size() > 1 else 0.0
	var racing_by: bool = _racing() and _racer.can_pass(float(bus.v), want)
	if (not dbl and not racing_by and (bus.kind != "bus" or bus.v > 0.6 or bus.dwell <= 0.0)) or _ap_pts.size() < 2:
		return false
	var hit := _nearest_seg(_pos, 12.0, true, true, _y)
	if hit.is_empty():
		return false
	var r: Dictionary = _roads[hit["road"]]
	var n := _lanes_each_way(r)
	if n < 2 and not ((dbl or racing_by) and int(r["o"]) == 0):
		return _ap_squeeze_by(bi, float(lead[0])) if dbl and int(r["o"]) != 0 else false
	var w := float(r["w"])
	var lane_w := w / n if int(r["o"]) != 0 else (w * 0.5) / n
	if n < 2:   # (a delivery van in a street of one lane each way: over the centre line)
		lane_w = clampf(2.0 * _lane_off(r), 2.3, 3.4)
	elif int(r["o"]) == 0:
		# a two-way road: over to the inner lane of its own side -- by a whole lane from where
		# autodrive drives (a little in from the right lane's middle) it crossed the centre
		var inner := (w * 0.5) / n * 0.5
		if inner < float(r.get("mid", 0.0)) + 1.15:
			return false
		lane_w = _lane_off(r) - inner
		if lane_w < 1.5:
			return false
	var fwd := _fwd()
	var left := Vector2(fwd.y, -fwd.x)
	var gap: float = lead[0]
	if _ap_turn_ahead() != 0 and not (racing_by and float(bus.v) < 1.0):
		return false   # (a junction just after it: stay in lane -- but racer goes round a car
		               # standing at a red and turns from where it is: refused whenever its plan
		               # turned at that junction, it waited behind the car for the whole red, the
		               # user's "racer waits on red light after a car", tests/racer_queue.gd)
	# a moving car (racer.gd): it goes on meanwhile, so the way out runs as far on as it gets
	# in the time it takes to go by, and the lane over must be clear for that and for what
	# comes along it at a town's pace meanwhile
	var extra := 0.0
	var t_pass := 0.0
	if racing_by and bus.v > 0.6:
		t_pass = (gap + float(bus.len) + 22.0) / maxf(want - float(bus.v), 3.0)
		extra = float(bus.v) * t_pass
		if extra > 140.0:
			return false   # (too long a way out: follow it)
	# the next lane over clear, by every car's middle (the other way's: further, they come at you).
	# Racer (racer.gd) tries the lane on the right too where there are two or more its way,
	# and goes the side that is clear
	var reach := gap + extra + (45.0 + 14.0 * t_pass if n < 2 else 25.0)
	var sides: Array = [1.0, -1.0] if racing_by and n >= 2 else [1.0]
	var sgn := 0.0
	for sd: float in sides:
		var clear := true
		for c in _traffic.cars:
			if not c.alive or c == bus:
				continue
			var rel: Vector2 = c.pos - _pos
			var ahead := rel.dot(fwd)
			var side := rel.dot(left) * sd
			if ahead > -15.0 and ahead < reach and side > lane_w * 0.4 and side < lane_w * 1.6:
				clear = false
				break
		if clear and sd < 0.0 and _off_road(_pos - left * (lane_w + CAR_WIDTH * 0.5), 0.0):
			clear = false   # (no lane there: the kerb)
		if clear:
			sgn = sd
			break
	if sgn == 0.0:
		return false
	# out, past, back in: the points of the plan from just ahead to past the bus -- measured
	# from the car, as the gap is: the plan's first point is the start of the stretch it is
	# on, which on a straight street can be 40 m back (the bend landed behind the car)
	var s0 := _ap_pts[0].distance_to(Geometry2D.get_closest_point_to_segment(_pos, _ap_pts[0], _ap_pts[1]))
	var s := -s0
	var half: float = bus.len * 0.5
	var start_s := maxf(gap - half - 10.0, 2.0)
	var end_s := gap + half + 12.0 + extra
	var keep_pts := _ap_pts.duplicate()
	var keep_v := _ap_v.duplicate()
	var keep_lim := _ap_lim.duplicate()
	_ap_densify(s0 + end_s + 10.0, 2.0)
	var orig := _ap_pts.duplicate()   # (lengths and ways read from the plan as it was: bent in place, each
	                                   # point leaned on the one before, already moved, and the way out hugged the plan)
	for k in range(1, _ap_pts.size()):
		s += orig[k - 1].distance_to(orig[k])
		if s > end_s + 8.0:
			break
		var t := clampf((s - start_s) / 8.0, 0.0, 1.0) * clampf((end_s + 8.0 - s) / 8.0, 0.0, 1.0)
		if t <= 0.0:
			continue
		var kd := (orig[mini(k + 1, orig.size() - 1)] - orig[k - 1]).normalized()
		_ap_pts[k] += Vector2(kd.y, -kd.x) * lane_w * t * sgn
	if true:
		# (the way out checked for what stands there, not cars alone: a post, a tree, a
		# median's end -- undone if anything is. Racer's only, once: autodrive's own pass round
		# a van fell short of its lane width while the bend leant forward (see _ap_mount_by), and
		# once it went the whole way over it touched what stood there, posts at 5 km/h)
		_smash = racing_by   # (racer plans through what gives: see _smash)
		var blocked := false
		for k in range(1, _ap_pts.size()):
			if _ap_pts[k].distance_to(_pos) > end_s + 10.0:
				break
			if _push_out(_ap_pts[k], 1.1, true, false, _y) != Vector2.ZERO:
				blocked = true
				break
		_smash = false
		if blocked:
			_ap_pts = keep_pts
			_ap_v = keep_v
			_ap_lim = keep_lim
			return false
	_ap_passed = bi
	if racing_by:
		_racer.passes += 1
	Probe.event("pass_van" if dbl else "pass_bus", {"lane_w": snappedf(lane_w, 0.1), "side": "left" if sgn > 0.0 else "right"})
	_log.event("pass van" if dbl else "pass bus")
	return true

## Racer (racer.gd): round the car in front by whatever way is open -- the next lane, two
## over, the other side of the road -- not a lane's width from autodrive's line but as far as
## clears that car's body where it actually stands (a car held half across the line took a
## one-lane bend 2.08 m from its middle, inside lead_on's 2.1, and racer stood behind it).
## Each way out is tried on a copy of the plan, nearest first, left before right: kept when
## every point of it is on asphalt (any road's, either way), clear of anything solid, of every
## car now and of anything coming the other way for as long as the pass takes. Tried again on
## the same car once stuck behind it (the first try did not clear it). True when it went.
const RACE_CLEAR := 2.9      ## m from the car's middle to racer's line, going by it
const RACE_OUT := [3.2, 6.4, 9.6, -3.2]   ## ways out tried: left one lane, two, three; right one
var _race_tries := 0                      ## ways out already taken round the same car (a retry starts past them)
func _ap_race_by(lead: Array) -> bool:
	var bi: int = lead[3]
	if bi < 0 or _ap_pts.size() < 2:
		return false
	if bi == _ap_passed and _ap_wait < 1.5:
		return false   # (bent round it already: give it a moment)
	_race_tries = _race_tries + 1 if bi == _ap_passed else 0   # (stuck behind it still: the next way out)
	var car = _traffic.cars[bi]
	var want: float = _racer.limit(_ap_lim[1]) if _ap_lim.size() > 1 else 13.9
	if not _racer.can_pass(float(car.v), want):
		return false
	if _ap_turn_ahead() != 0 and float(lead[0]) > 25.0:
		return false   # (a turn just after it: stay behind until close, then it may still go)
	var gap: float = lead[0]
	var fwd := _fwd()
	var left := Vector2(fwd.y, -fwd.x)
	# where its middle stands across racer's line (left of it: +)
	var lat := 0.0
	var bd := INF
	for j in range(_ap_pts.size() - 1):
		var cp := Geometry2D.get_closest_point_to_segment(car.pos, _ap_pts[j], _ap_pts[j + 1])
		if cp.distance_to(car.pos) < bd:
			bd = cp.distance_to(car.pos)
			var d := (_ap_pts[j + 1] - _ap_pts[j]).normalized()
			lat = (car.pos - cp).dot(Vector2(d.y, -d.x))
		if _ap_pts[j].distance_to(_pos) > gap + 20.0:
			break
	# a moving car goes on meanwhile: the way out as long as it takes to get by
	var t_pass := (gap + float(car.len) + 20.0) / maxf(want - float(car.v), 3.0)
	var extra := float(car.v) * t_pass
	if extra > 160.0:
		return false
	var half := float(car.len) * 0.5
	var start_s := maxf(gap - half - 12.0, 1.0)
	var end_s := gap + half + 10.0 + extra
	var keep_pts := _ap_pts.duplicate()
	var keep_v := _ap_v.duplicate()
	var keep_lim := _ap_lim.duplicate()
	var s0 := _ap_pts[0].distance_to(Geometry2D.get_closest_point_to_segment(_pos, _ap_pts[0], _ap_pts[1]))
	for oi in range(RACE_OUT.size()):
		var out: float = RACE_OUT[(oi + _race_tries) % RACE_OUT.size()]
		# as far over as clears its body: out at least so far past its middle
		var shift := out
		if out > 0.0:
			shift = maxf(out, lat + RACE_CLEAR)
		else:
			shift = minf(out, lat - RACE_CLEAR)
		_ap_densify(s0 + end_s + 10.0, 1.5)
		var orig := _ap_pts.duplicate()   # (lengths and ways read from the plan as it was: bent in place, each
		                                   # point leaned on the one before, already moved, and the way out hugged the plan)
		var s := -s0
		var bent: Array = []
		for k in range(1, _ap_pts.size()):
			s += orig[k - 1].distance_to(orig[k])
			if s > end_s + 8.0:
				break
			var t := clampf((s - start_s) / 7.0, 0.0, 1.0) * clampf((end_s + 8.0 - s) / 8.0, 0.0, 1.0)
			if t <= 0.0:
				continue
			var kd := (orig[mini(k + 1, orig.size() - 1)] - orig[k - 1]).normalized()
			_ap_pts[k] += Vector2(kd.y, -kd.x) * shift * t
			bent.append([_ap_pts[k], maxf(s, 0.0)])
		var ok := not bent.is_empty()
		for bq: Array in bent:
			var q: Vector2 = bq[0]
			# on asphalt (any road: the other way's lanes too), nothing solid there
			if _off_road(q, -0.3) or _push_out(q, 1.15, true, false, _y) != Vector2.ZERO:
				ok = false
				break
			var at_t := float(bq[1]) / maxf(want, 5.0)   # (when racer is there)
			for c in _traffic.cars:
				if not c.alive or c == car:
					continue
				# where it will be then, at its pace along its heading
				var cdir := Vector2(sin(c.yaw), cos(c.yaw))
				var then: Vector2 = c.pos + cdir * float(c.v) * at_t
				if then.distance_squared_to(q) < 3.2 * 3.2 or c.pos.distance_squared_to(q) < 2.6 * 2.6:
					ok = false
					break
			if not ok:
				break
		if ok:
			_ap_passed = bi
			_racer.passes += 1
			Probe.event("racer_pass", {"over": snappedf(shift, 0.1), "moving": float(car.v) > 0.6})
			_log.event("racer round a car")
			return true
		_ap_pts = keep_pts.duplicate()
		_ap_v = keep_v.duplicate()
		_ap_lim = keep_lim.duplicate()
	return false

## Racer (racer.gd), stood behind a queue that does not move: up onto the pavement on the
## right and along it past the queue, back down at its head -- only where nobody is on that
## stretch of pavement (3 m either side of the line), nothing solid stands on it (posts,
## trees, bins, a parked car, a wall) and it is not a junction just ahead. True when it did.
const MOUNT_PAST := 26.0      ## metres of pavement it takes at most past the car in front
func _ap_mount_by(lead: Array) -> bool:
	var bi: int = lead[3]
	if bi < 0 or (bi == _ap_passed and _ap_wait < 2.0) or _ap_pts.size() < 2:
		return false
	var hit := _nearest_seg(_pos, 12.0, true, true, _y)
	if hit.is_empty():
		return false
	var r: Dictionary = _roads[hit["road"]]
	if HIGHWAYS.has(r["k"]):
		return false
	# from the plan's line out to beyond the kerb: the car's middle 1.6 m onto the pavement
	# (from where the car is across the road, not `_lane_off` -- the default lane: in the left
	# lane of three the way up ran 4.7 m right of it, through the car standing in the kerb
	# lane, and it stood behind the queue for the whole red, tests/racer_queue.gd)
	var rp: PackedVector2Array = r["pts"]
	var rsj: int = hit["seg"]
	var rd := (rp[rsj + 1] - rp[rsj]).normalized()
	var my_right: float = (_pos - (hit["q"] as Vector2)).dot(Vector2(-rd.y, rd.x)) * (1.0 if rd.dot(_fwd()) >= 0.0 else -1.0)
	var edge := float(r["w"]) * 0.5 - my_right
	var shift := clampf(edge + 1.6, 2.5, 10.0)
	var gap: float = lead[0]
	var keep_pts := _ap_pts.duplicate()
	var keep_v := _ap_v.duplicate()
	var keep_lim := _ap_lim.duplicate()
	var s0 := _ap_pts[0].distance_to(Geometry2D.get_closest_point_to_segment(_pos, _ap_pts[0], _ap_pts[1]))
	var start_s := maxf(gap - 14.0, 1.0)   # (up 14 m short of the car in front: 8 left no room to clear its corner)
	var end_s := gap + MOUNT_PAST
	_ap_densify(s0 + end_s + 10.0, 1.0)
	# (directions from the plan as it was: bent in place, each point's way read from the one
	# before, already bent, and the one after, not yet -- with points 1 m apart and 6.6 m over,
	# the push leant ~70 degrees forward and the way up stayed 1.9 m short of the kerb)
	var orig := _ap_pts.duplicate()
	var s := -s0
	var bent: Array = []
	for k in range(1, _ap_pts.size()):
		s += (orig[k - 1] as Vector2).distance_to(orig[k])
		if s > end_s + 6.0:
			break
		var t := clampf((s - start_s) / 5.0, 0.0, 1.0) * clampf((end_s + 6.0 - s) / 6.0, 0.0, 1.0)
		if t <= 0.0:
			continue
		var kd := ((orig[mini(k + 1, orig.size() - 1)] as Vector2) - (orig[k - 1] as Vector2)).normalized()
		# (each point to the pavement's middle by where it lies across the road there: the plan
		# moves between lanes on its own, and one shift for all put the way up 1.9 m short of
		# the kerb 37 m on, through the car standing in the kerb lane)
		var kq := Vector2.ZERO
		var kbest := INF
		for j in range(rp.size() - 1):
			var cp := Geometry2D.get_closest_point_to_segment(orig[k], rp[j], rp[j + 1])
			if cp.distance_squared_to(orig[k]) < kbest:
				kbest = cp.distance_squared_to(orig[k])
				kq = cp
		var k_right: float = ((orig[k] as Vector2) - kq).dot(Vector2(-kd.y, kd.x))
		var k_shift := clampf(float(r["w"]) * 0.5 - k_right + 1.6, 2.5, 10.0) if kbest < 400.0 else shift
		_ap_pts[k] -= Vector2(kd.y, -kd.x) * k_shift * t   # (to the right)
		_ap_v[k] = minf(_ap_v[k], 6.0)   # (up and along at a crawl: 20 km/h)
		bent.append(_ap_pts[k])
	var ok := not bent.is_empty()
	var people: Array = []
	for cr: Dictionary in _crossers:
		people.append(Vector2((cr["actor"] as Node3D).position.x, (cr["actor"] as Node3D).position.z))
	for w: Dictionary in _walkers:
		if (w["actor"] as Node3D).visible:
			people.append(Vector2((w["actor"] as Node3D).position.x, (w["actor"] as Node3D).position.z))
	_smash = true   # (through what gives: a railing, a low wall, a hedge -- see _smash)
	for q: Vector2 in bent:
		if _push_out(q, 1.1, true, true, _y) != Vector2.ZERO:
			ok = false
			break
		for pp: Vector2 in people:
			if pp.distance_squared_to(q) < 9.0:
				ok = false
				break
		if not ok:
			break
	_smash = false
	if ok and _ap_turn_ahead() != 0 and float(lead[1]) >= 1.0:
		ok = false   # (turning just after: stay in lane -- unless the queue stands: see _ap_pass_bus)
	if not ok:
		_ap_pts = keep_pts
		_ap_v = keep_v
		_ap_lim = keep_lim
		return false
	_ap_passed = bi
	_racer.mounts += 1
	Probe.event("racer_pavement", {"over": snappedf(shift, 0.1)})
	_log.event("racer onto the pavement")
	return true

## Past a delivery van in a one-way street of one lane: no lane to go round it in, but most
## stand half on the kerb with room beside them, and traffic -- which counts a car in its way
## by its middle -- drove on past while autodrive, counting its body, stood behind it for the
## whole delivery (half a minute, the street empty ahead: tests/auto_stands.gd). Over just
## far enough to clear its body by a hand's breadth (by the points lead_on reads), when the
## car still fits on the asphalt there, nothing solid (a parked car, a post) stands in the
## way and no other car is on the bent stretch. True when it moved over.
const SQUEEZE_MAX := 2.6   ## at most this far over (m)
func _ap_squeeze_by(bi: int, gap: float) -> bool:
	if _ap_turn_ahead() != 0:
		return false   # (a junction just after it: stay in lane)
	var van = _traffic.cars[bi]
	var cdir := Vector2(sin(van.yaw), cos(van.yaw))
	var body: Dictionary = _traffic.BODY
	var offs: Array = (body[van.kind][0] as Array).duplicate() if body.has(van.kind) else [-van.len * 0.33, 0.0, van.len * 0.33]
	offs.append(van.len * 0.5 - 0.3)
	offs.append(-van.len * 0.5 + 0.3)
	var rad: float = float(body[van.kind][1]) if body.has(van.kind) else 0.95
	# which side of the plan it stands, and how near its body comes (left of the way: +)
	var side := 0.0
	var nearest := INF
	for off: float in offs:
		var q: Vector2 = van.pos + cdir * off
		var best := INF
		var lat := 0.0
		for j in range(_ap_pts.size() - 1):
			var cp := Geometry2D.get_closest_point_to_segment(q, _ap_pts[j], _ap_pts[j + 1])
			if cp.distance_to(q) < best:
				best = cp.distance_to(q)
				var d := (_ap_pts[j + 1] - _ap_pts[j]).normalized()
				lat = (q - cp).dot(Vector2(d.y, -d.x))
			if _ap_pts[j].distance_to(_pos) > gap + 20.0:
				break
		if side == 0.0:
			side = signf(lat)
		if signf(lat) != side or absf(lat) < 0.2:
			return false   # (across the plan: no room beside it)
		nearest = minf(nearest, absf(lat))
	var shift := 0.9 + rad + 0.35 - nearest   # (lead_on's reach for a car going my way: 0.9 + its half + 0.25)
	if shift <= 0.0 or shift > SQUEEZE_MAX:
		return false
	# (over a two-way street's centre line after a first bend round it: nothing coming)
	var fwd := _fwd()
	for c in _traffic.cars:
		if c.alive and c != van and Vector2(sin(c.yaw), cos(c.yaw)).dot(fwd) < -0.5:
			var rel: Vector2 = c.pos - _pos
			if rel.dot(fwd) > -5.0 and rel.dot(fwd) < gap + 45.0 and absf(rel.dot(Vector2(fwd.y, -fwd.x))) < 7.0:
				return false
	# the bent stretch: out by the van's tail (over 2-8 m, from where the car stands), back in
	# 6 m past its nose -- tried on a copy, then kept if it is clear
	var tail := gap - float(van.len) * 0.5
	var ramp := clampf(tail - 1.3, 2.0, 8.0)
	var start_s := maxf(tail - 1.0 - ramp, 0.3)
	var end_s := gap + float(van.len) * 0.5 + 4.0
	var keep_pts := _ap_pts.duplicate()
	var keep_v := _ap_v.duplicate()
	var keep_lim := _ap_lim.duplicate()
	var s0 := _ap_pts[0].distance_to(Geometry2D.get_closest_point_to_segment(_pos, _ap_pts[0], _ap_pts[1]))
	_ap_densify(s0 + end_s + 10.0, 1.0)
	var s := -s0
	var bent: Array = []
	for k in range(1, _ap_pts.size()):
		s += _ap_pts[k - 1].distance_to(_ap_pts[k])
		if s > end_s + 6.0:
			break
		var t := clampf((s - start_s) / ramp, 0.0, 1.0) * clampf((end_s + 6.0 - s) / 6.0, 0.0, 1.0)
		if t <= 0.0:
			continue
		var kd := (_ap_pts[mini(k + 1, _ap_pts.size() - 1)] - _ap_pts[k - 1]).normalized()
		var away := Vector2(kd.y, -kd.x) * -side
		_ap_pts[k] += away * shift * t
		bent.append([_ap_pts[k], away])
	var ok := not bent.is_empty()
	for b: Array in bent:
		var q: Vector2 = b[0]
		# the car's outer side on the asphalt, nothing solid where it goes
		if _off_road(q + (b[1] as Vector2) * (CAR_WIDTH * 0.5 + 0.1), 0.0) or _push_out(q, 1.0, true, false, _y) != Vector2.ZERO:
			ok = false
			break
		for c in _traffic.cars:
			if c.alive and c != van and c.pos.distance_squared_to(q) < 2.4 * 2.4:
				ok = false
				break
		if not ok:
			break
	if not ok:
		_ap_pts = keep_pts
		_ap_v = keep_v
		_ap_lim = keep_lim
		return false
	_ap_passed = bi
	Probe.event("squeeze_van", {"over": snappedf(shift, 0.1)})
	_log.event("squeeze past van")
	return true

## A point every `step` metres along the plan for its first `upto` metres. Only points move
## when the plan is bent (round a bus, a delivery van): on a straight street the plan can be
## two points a block apart, and bending "the points from 2 m to 40 m ahead" moved nothing --
## autodrive marked the van passed and stood behind it for half a minute (street_goings).
func _ap_densify(upto: float, step: float) -> void:
	var np := PackedVector2Array([_ap_pts[0]])
	var nv := PackedFloat32Array([_ap_v[0]])
	var nl := PackedFloat32Array([_ap_lim[0]])
	var acc := 0.0
	for k in range(1, _ap_pts.size()):
		var a := _ap_pts[k - 1]
		var b := _ap_pts[k]
		var L := a.distance_to(b)
		if acc < upto and L > step * 1.25:
			var m := int(L / step)
			for q in range(1, m):
				np.append(a.lerp(b, float(q) / m))
				nv.append(maxf(_ap_v[k - 1], _ap_v[k]))   # (a straight stretch: the braking to point k is seen from these too)
				nl.append(_ap_lim[k])
		np.append(b)
		nv.append(_ap_v[k])
		nl.append(_ap_lim[k])
		acc += L
	_ap_pts = np
	_ap_v = nv
	_ap_lim = nl

## Into the turn lane: before a left turn, over the last 45 m, the lane on the left of its
## way -- the leftmost of a one-way road of several, the one beside the centre line of a
## two-way road of several, and toward the centre line on a road of one each way. People turn
## left from the left lane; autodrive turned across the lanes from the right-hand one.
func _ap_turn_lane(ri: int, from: int, dir: int) -> void:
	var m := _ap_pts.size()
	if _ap_end.x < 0 or m < 4:
		return
	var r_in: Dictionary = _roads[_ap_end.x]
	var pts: PackedVector2Array = _roads[ri]["pts"]
	var at := from - dir
	if at < 0 or at >= pts.size() or r_in.get("ring", false):
		return
	var c := pts[at]
	var in_dir := (_ap_pts[m - 1] - _ap_pts[m - 3]).normalized()
	var out_dir := (pts[from] - c).normalized()
	if in_dir == Vector2.ZERO or out_dir == Vector2.ZERO:
		return
	var turn := in_dir.angle_to(out_dir)   # (+ is right)
	var n := _lanes_each_way(r_in)
	var w := float(r_in["w"])
	var target := 0.0
	if turn > 0.6:
		# a right turn off a road of three lanes or more: over to the right-hand lane (the
		# car goes straight on in the second)
		if int(r_in["o"]) == 0 or n < 3:
			return
		target = w * 0.5 - w / n * 0.5
	elif turn > -0.6:
		return   # (straight on)
	elif int(r_in["o"]) != 0:
		if n < 2:
			return
		target = -(w * 0.5 - w / n * 0.5)
	else:
		target = (w * 0.5) / n * 0.5 if n >= 2 else _lane_off(r_in) * 0.55
		target = maxf(target, float(r_in.get("mid", 0.0)) + 1.15)   # (clear of a median)
	var shift := target - _lane_off(r_in)
	if absf(shift) < 0.3:
		return
	var s := 0.0
	for k in range(m - 1, 1, -1):   # (not the points right by the car: no swerve)
		if k < m - 1:
			s += _ap_pts[k].distance_to(_ap_pts[k + 1])
		if s > 45.0:
			break
		var kd := (_ap_pts[mini(k + 1, m - 1)] - _ap_pts[k - 1]).normalized()
		var right := Vector2(-kd.y, kd.x)
		_ap_pts[k] += right * shift * clampf((45.0 - s) / 25.0, 0.0, 1.0)

## Into the next road at a junction: the last road ended on the junction's point, and the
## next road's first point can be 30-100 m down it -- the straight line between them ran
## down the wrong side of the new street (after a left turn the car sat in the oncoming
## lane for a while, after a right one it straddled the middle) and into the cars there.
## Now the turn starts just short of the junction in the lane it is in, curves round, and
## comes out just past it in the right lane of the new road.
func _ap_turn_into(ri: int, from: int, dir: int, lane: float) -> void:
	var r: Dictionary = _roads[ri]
	var pts: PackedVector2Array = r["pts"]
	var ids: PackedInt32Array = r["ids"]
	var at := from - dir
	var n := _ap_pts.size()
	if at < 0 or at >= pts.size() or n < 2:
		return
	var node := ids[at]
	var c := _nodes[node]
	if _node_ways(node) < 3 or _ap_pts[n - 1].distance_to(c) > 6.0:
		return
	var before := _ap_pts[n - 2]
	var in_dir := (c - before).normalized()
	var out_dir := (pts[from] - c).normalized()
	if in_dir == Vector2.ZERO or out_dir == Vector2.ZERO or absf(in_dir.angle_to(out_dir)) < 0.35:
		return
	var rin := Vector2(-in_dir.y, in_dir.x)
	var rout := Vector2(-out_dir.y, out_dir.x)
	var lane_in := (_ap_pts[n - 1] - c).dot(rin)
	# round from the lane it is in to the next street's (an arc no tighter than the car can
	# drive: see _lane_corner), ending short of that street's next point
	var arc := _lane_corner(c, in_dir, out_dir, lane_in, lane, _node_r[node] + 1.0, before, pts[from] + rout * lane)
	if arc.is_empty():
		return
	var v := _ap_v[n - 1]
	var lim := _ap_lim[n - 1]
	_ap_pts[n - 1] = arc[0]
	for i in range(1, arc.size()):
		_ap_pts.append(arc[i])
		_ap_v.append(v)
		_ap_lim.append(minf(lim, float(r["speed"])))

## The way round a corner from one lane into the next at junction point c: an arc that runs
## along the lane it comes in on (lane_in right of din, the way in) and leaves along the lane
## it goes out in (lane_out right of dout), of radius at least AP_TURN_R -- starting no further
## back than the point before it (`after`) and ending short of the point after (`before`).
## The points from where it leaves the lane in to where it is in the lane out; [] when the two
## ways are too near straight on (or straight back) to need one.
## (Laid as a curve from 5 m before the junction to 5 m after through that crossing point, a
## right turn into an 8 m street was 2-3 m round: tighter than the car turns at full lock
## (~4.1 m), and it came out wide, over the middle line of the street it turned into.)
const AP_TURN_R := 5.5

func _lane_corner(c: Vector2, din: Vector2, dout: Vector2, lane_in: float, lane_out: float, reach: float, after: Vector2, before: Vector2) -> PackedVector2Array:
	var out := PackedVector2Array()
	var th := din.angle_to(dout)   # (+ is right)
	if absf(th) < 0.2 or absf(th) > 2.9:
		return out
	var rin := Vector2(-din.y, din.x)
	var rout := Vector2(-dout.y, dout.x)
	var K = Geometry2D.line_intersects_line(c + rin * lane_in, din, c + rout * lane_out, dout)
	if K == null:
		return out
	var k: Vector2 = K
	var tn := tan(absf(th) * 0.5)
	# from `reach` before the junction's point along the lane (as before), or further back
	# if the radius needs it -- the room allowing
	var T := maxf((k - c).dot(din) + reach, AP_TURN_R * tn)
	T = clampf(T, 0.5, maxf(minf((k - after).dot(din) - 0.5, (before - k).dot(dout) - 0.5), 0.5))
	var E := k - din * T
	var R := T / tn
	var O := E + rin * R * signf(th)
	var steps := maxi(2, ceili(R * absf(th) / 1.5))
	for i in range(steps + 1):
		out.append(O + (E - O).rotated(th * float(i) / steps))
	return out

func _ap_curves(from_k: int) -> void:
	for k in range(maxi(1, from_k), _ap_pts.size() - 1):
		if _ap_v[k] == 0.0:
			continue   # a stop to turn round at (a dead end's U-turn): kept
		var a := _ap_walk(k, -5.0)
		var b := _ap_pts[k]
		var c := _ap_walk(k, 5.0)
		var cross := absf((b - a).cross(c - a))
		var radius := INF if cross < 0.001 else a.distance_to(b) * b.distance_to(c) * c.distance_to(a) / (2.0 * cross)
		# (more sideways pull in a tight bend, as people take one: 3.6 m/s^2 from a 15 m radius up,
		# rising to 4.8 at 5 m -- at 3.6 throughout, a roundabout's way on and off, 4-8 m, was
		# 14-18 km/h, and the car eased off for each: "very defensive, somewhat slow")
		var lat := AP_LAT + clampf((15.0 - radius) / 10.0, 0.0, 1.0) * (AP_LAT_TIGHT - AP_LAT)
		_ap_v[k] = minf(_ap_lim[k], maxf(sqrt(lat * radius), 2.5))

## at the end of the planned road pick the next one: ahead rather than a turn, a street
## not driven yet rather than an old one, never against a one-way, U-turn only at a dead end
## the legs still to drive across a junction already chosen at (see _cluster_exits)
var _ap_queue: Array = []
const CLUSTER_M := 35.0              ## legs this short between junction points: one junction

func _ap_next() -> bool:
	if _ap_end.x < 0:
		return false
	var r: Dictionary = _roads[_ap_end.x]
	var node: int = (r["ids"] as PackedInt32Array)[_ap_end.y]
	if not _ap_queue.is_empty():
		var q: Vector3i = _ap_queue.pop_front()
		var rq: Dictionary = _roads[q.x]
		if (rq["ids"] as PackedInt32Array)[q.y - q.z] == node:
			_ap_ring_n = 0
			_ap_leg(q.x, q.y, q.z)
			return true
		_ap_queue = []   # (somewhere else after all: choose afresh)
	var found := _ap_ways(_ap_end.x, _ap_end.y, _ap_end.z)
	var ways: Array = found[0]
	var back: Vector3i = found[1]
	if ways.is_empty():
		if back.x < 0:
			return false
		if int(r["o"]) != 0:
			# a one-way street that just ends (cut by the map's edge, or a mapping slip): the way
			# back is against it, and planned afresh a turned car would be sent back in. So the
			# leg back is planned on, with a stop at the end, turned onto on the spot (_autodrive).
			var apex := _ap_pts.size() - 1
			_ap_leg(back.x, back.y, back.z)
			for k in [apex, apex + 1]:
				if k > 0 and k < _ap_v.size() - 1:
					_ap_v[k] = 0.0
			return true
		# a dead end: stop short of its end and turn round there in moves forward and back (see
		# "turning round at a dead end"). Planned as a lane out and a lane back, the U-turn was a
		# corner a few metres across taken at 2.5 m/s -- autodrive swung wide past the end into
		# the trees and garden walls, or onto the footpath beyond and on along it at 40 km/h.
		_ap_mark_dead_end()
		return false
	# every way on from here only runs off the map (a street the map's edge cut): turn round
	# here, short of this junction, rather than drive on to the barrier -- on a two-way street
	# back along it; on a divided road's one-way half onto its other half (_ap_plan).
	# (A user, 22 Nov: "when the ai chooses to drive around the edges, it has trouble getting
	# back ... it doesn't want to drive against the wrong lane, so it just turns back into
	# nowhere"; tests/autodrive_edge.gd TRACE=1: off Derech Namir it drove along the edge into
	# a dead end 5 m from the barrier and turned round in it for 12 s.)
	if not _dest_on and (int(r["o"]) == 0 or int(r.get("mate", -1)) >= 0):
		var all_edge := true
		for w: Dictionary in ways:
			if not _edge_bound(w["leg"]):
				all_edge = false
				break
		# (only when the way back does lead somewhere: in a pocket where it runs off the map too
		# -- Tel Aviv's HaHilazon, a dead end by the barrier at one end and a junction of ways
		# off the map at the other -- it turned round at each end in turn for good)
		if all_edge and (int(r["o"]) != 0 or (back.x >= 0 and not _edge_bound(back))):
			_tally("ap_edge_turn", 1)
			Probe.event("edge_turn", {"at": _ap_pts[_ap_pts.size() - 1].round() if _ap_pts.size() > 0 else Vector2.ZERO})
			_ap_mark_dead_end()
			return false
	# a real crossing (two or more proper streets on): ask, and plan no further for now --
	# but not round a roundabout, where the exits come too fast to ask at each
	var main: Array = ways.filter(func(w): return not w["service"])
	if not _dest_on and main.size() >= 2 and not r.get("ring", false):
		if _cross.is_empty() or _cross["node"] != node:
			var pts: PackedVector2Array = r["pts"]
			var prev := clampi(_ap_end.y - _ap_end.z, 0, pts.size() - 1)
			var came := (pts[_ap_end.y] - pts[prev]).normalized()
			var exits := _cluster_exits(main, came, 0, {node: true})
			if exits.is_empty():
				exits = main
				for w: Dictionary in exits:
					w["legs"] = [w["leg"]]
			exits.sort_custom(func(a, b): return a["turn"] < b["turn"])
			var pick := 0
			for i in range(exits.size()):
				if exits[i]["score"] > exits[pick]["score"]:
					pick = i
			_cross = {"node": node, "at": _ap_pts[_ap_pts.size() - 1], "ways": exits, "pick": pick, "chosen": false}
			_ap_v[_ap_v.size() - 1] = minf(_ap_v[_ap_v.size() - 1], CROSS_V)
		return false
	var best_i := 0
	for i in range(ways.size()):
		if ways[i]["score"] > ways[best_i]["score"]:
			best_i = i
	var leg: Vector3i = ways[best_i]["leg"]
	_ap_ring_n = _ap_ring_n + 1 if (_roads[leg.x] as Dictionary).get("ring", false) else 0
	_ap_leg(leg.x, leg.y, leg.z)
	return true

## The ways on from point ei of road ri, arrived at going `dir`: [ways, back], ways each
## {leg: Vector3i(road, first index, direction), turn, name, en, service, score}, back the
## leg back the way it came (only from a dead end; Vector3i(-1, ...) when there is none).
## a service lane that ends -- a dead end -- at a solid building, or under one: the way into
## an underground car park or a garage, which the map draws as a lane into the wall. Roaming
## out of the City tunnel, autodrive took one (its only other way on) and hit the wall at
## 9-19 km/h on both of decks.gd's runs (Givatayim (-722, -1078), 21 Nov). Worked out once a road.
var _into_bld := {}
func _into_building(ri: int) -> bool:
	if _into_bld.has(ri):
		return _into_bld[ri]
	var r: Dictionary = _roads[ri]
	var ids: PackedInt32Array = r["ids"]
	var pts: PackedVector2Array = r["pts"]
	var into := false
	for e: int in [0, ids.size() - 1]:
		if _node_ways(ids[e]) != 1:
			continue   # (not a dead end there -- for cars: a footpath on from it does not count)
		var p := pts[e]
		# (8 m: the map often ends a garage's lane short of its door -- Ashdod's off HaMada
		# stops 5 m from the wall, and autodrive went down it at 49 km/h into the building:
		# tests/drive_bumps.gd LEVEL=3 STARTS=12, 22 Nov)
		for i: int in _near(_bld_hash, p, 8.0, BLD_CELL):
			if _bld_solid[i] != 0 and (_bld_box[i] as Rect2).grow(8.0).has_point(p) 					and (Geometry2D.is_point_in_polygon(p, _blds[i]) or _poly_push(_blds[i], p, 8.0) != Vector2.ZERO):
				into = true
	_into_bld[ri] = into
	return into

func _ap_ways(ri: int, ei: int, dir: int) -> Array:
	var r: Dictionary = _roads[ri]
	var pts: PackedVector2Array = r["pts"]
	var node: int = (r["ids"] as PackedInt32Array)[ei]
	var prev := ei - dir
	if prev < 0 or prev >= pts.size():
		prev = ei
	var came := (pts[ei] - pts[prev]).normalized()
	var ways: Array = []
	var back := Vector3i(-1, 0, 0)
	var rim := _bounds.grow(-EDGE - EDGE_ROOM)
	for e: Vector2i in _node_roads[node]:
		var r2: Dictionary = _roads[e.x]
		if not r2["drive"] or r2["pv"]:
			continue   # autodrive stays out of private driveways and car parks
		var p2: PackedVector2Array = r2["pts"]
		for d2: int in [1, -1]:
			var nxt := e.y + d2
			if nxt < 0 or nxt >= p2.size():
				continue
			if e.x == ri and nxt == prev:
				back = Vector3i(e.x, nxt, d2)   # back the way it came: only from a dead end
				continue
			if r2["o"] != 0 and r2["o"] != d2:
				continue
			if not rim.has_point(p2[nxt]):
				continue   # over the map's edge
			var go := (p2[nxt] - p2[e.y]).normalized()
			var c := came.dot(go)
			if c < -0.7:
				continue
			var score := c * 1.2 + randf()
			if r2["name"] != "" and not _visited.has(r2["name"]):
				score += 1.4
			if r2["k"] == "service":
				if _into_building(e.x):
					continue   # a lane that ends at a building's wall: an underground car park's way in
				score -= 6.0   # alleys and car-park lanes: only when there is nothing else
			if not _in_city(p2[nxt]):
				score -= 2.5   # back toward town rather than out past its edge
			if _edge_bound(Vector3i(e.x, nxt, d2)):
				if r2["k"] == "service":
					# a lane that only runs off the map is never the way out: at the cut end of
					# Tel Aviv's one-way Tuval autodrive took one lane after another there, each
					# a dead end by the barrier, and turned round in them for good -- instead of
					# turning on the spot at the cut end and back the way it came (tests/
					# edge_pocket.gd lists such a spot's roads)
					continue
				score -= 8.0   # every way on from it runs off the map: only if nothing else
			elif _trap.has((r2["ids"] as PackedInt32Array)[nxt]) and not _trap.has(node):
				score -= 8.0   # into a pocket, with no way back out (see _find_pockets)
			if r.get("ring", false):
				# on a roundabout: off at one of the next exits, never round and round
				score += (-0.8 - 1.2 * _ap_ring_n) if r2.get("ring", false) else 1.2
			ways.append({"leg": Vector3i(e.x, nxt, d2), "turn": came.angle_to(go), "name": r2["name"],
				"en": r2["en"], "service": r2["k"] == "service", "score": score})
	return [ways, back]

## ---- turning round at a dead end ----
## The way back out of a dead end used to be planned straight on from its end: a U-turn in
## one sweep, which needs ~10 m and a cul-de-sac is 6.5 m across, taken at the 9 km/h the
## plan's corner speed allowed (and more: the car arrived at 45 km/h and braked late). It ran
## into the trees and garden walls at the end at 20-30 km/h. For a while it then stopped at
## the very end and spun round on the spot there, corners over the kerb. Now the plan stops
## AP_DEAD_ROOM short of the end and the car turns round there the way a driver does in a
## narrow street: forward on full lock until the nose nears the far kerb (or anything solid),
## back on the other lock until the tail nears the near one, and so on -- three moves in a
## 6.5 m street -- until it faces out, waiting for any car coming up the street; then the
## way out is planned afresh from where it stands. (A one-way street that just ends still
## stops at its end and turns on the spot.)
## tests/dead_end_turns.gd drives into every cul-de-sac of a city.
const AP_DEAD_ROOM := 7.0           ## metres short of a dead end's end it stops to turn round
const AP_KT_V := 2.2                ## m/s, the crawl of each move (1.3 took 11 s for three moves: walking pace, 22 Nov)
const AP_KT_KERB := 0.6             ## a move ends when a bumper would be this far (m) over the kerb (the wheels are ~0.9 m in from it)
const AP_KT_MOVES := 7              ## more than this, or AP_KT_SECS, and the rest is turned on the spot
const AP_KT_SECS := 30.0
var _ap_dead := Vector2.INF         ## where the plan stops to turn round (INF: no dead end ahead)
var _ap_dead_in := Vector2.ZERO     ## ...the way into the dead end there
var _ap_dead_end := Vector2.ZERO    ## ...and its end
var _ap_kt := {}                    ## turning round: {to, side, gear, n, t, mt, stop, from, idle}; {} when not

## the plan runs into a dead end (its last leg ends there, _ap_end): cut it back to stop
## AP_DEAD_ROOM short of the end (and inside the map's edge), and plan nothing past it
func _ap_mark_dead_end() -> void:
	var r: Dictionary = _roads[_ap_end.x]
	var pts: PackedVector2Array = r["pts"]
	var ei := _ap_end.y
	var prev := clampi(ei - _ap_end.z, 0, pts.size() - 1)
	var into := (pts[ei] - pts[prev]).normalized()
	_ap_dead_end = pts[ei]
	_ap_dead_in = into if into != Vector2.ZERO else _fwd()
	_ap_end = Vector3i(-1, 0, 0)
	var keep := _bounds.grow(-EDGE - CAR_LEN)
	var n := _ap_pts.size()
	var k := n - 1   # the last point far enough short of the end (0 if none is)
	while k > 0 and ((_ap_dead_end - _ap_pts[k]).dot(_ap_dead_in) < AP_DEAD_ROOM or not keep.has_point(_ap_pts[k])):
		k -= 1
	var stop := _ap_pts[k]
	if k < n - 1:
		var sa := (_ap_dead_end - _ap_pts[k]).dot(_ap_dead_in)
		var sb := (_ap_dead_end - _ap_pts[k + 1]).dot(_ap_dead_in)
		if sa > AP_DEAD_ROOM and sa - sb > 0.01:
			stop = _ap_pts[k].lerp(_ap_pts[k + 1], clampf((sa - AP_DEAD_ROOM) / (sa - sb), 0.0, 1.0))
			if not keep.has_point(stop):
				stop = _ap_pts[k]
	var v := _ap_v[k]
	var lim := _ap_lim[k]
	_ap_pts.resize(k + 1)
	_ap_v.resize(k + 1)
	_ap_lim.resize(k + 1)
	if _ap_pts.size() < 2 or stop.distance_to(_ap_pts[k]) > 0.5:   # (a plan is two points at least)
		_ap_pts.append(stop)
		_ap_v.append(v)
		_ap_lim.append(lim)
	_ap_dead = _ap_pts[_ap_pts.size() - 1]

## at the stop where the plan turns round, or past it (handed over nearer the end than that)
func _ap_at_dead() -> bool:
	# (from 2.5 m short: the plan's speeds bring it to a standstill 1.5 m short of a stop)
	return _pos.distance_to(_ap_dead) < AP_DEAD_ROOM + 5.0 and (_pos - _ap_dead).dot(_ap_dead_in) > -2.5

func _ap_kt_start() -> void:
	# to face back the way the street runs where the car stands; round to the left from the
	# right-hand lane (the room is on that side), to the right from the left of the middle
	var to := -_ap_dead_in
	var side := -1
	var hit := _nearest_seg(_pos, 20.0, true, true, _y)
	if not hit.is_empty():
		var pts: PackedVector2Array = (_roads[hit["road"]] as Dictionary)["pts"]
		var d := (pts[int(hit["seg"]) + 1] - pts[int(hit["seg"])]).normalized()
		to = -d if d.dot(_ap_dead_in) > 0.0 else d
		if (_pos - (hit["q"] as Vector2)).dot(Vector2(-to.y, to.x)) > 0.4:
			side = 1   # (right of the middle as it will face: that is the left now)
	_ap_kt = {"to": to, "side": side, "gear": 1, "n": 1, "t": 0.0, "mt": 0.0, "stop": false, "from": _pos, "idle": 0}
	_set_blink(side)
	_show_banner("turning round", 1.2)
	Probe.event("turning_round", {"at": Vector2i(_pos)})
	_log.event("turning round")

## a move's end: the circle at that end of the car, `ahead` metres on, would touch something,
## leave the asphalt (past the kerb, or past the end of the street), or reach the map's edge
func _ap_kt_blocked(p: Vector2) -> bool:
	if _push_out(p, CAR_R, true, true, _y) != Vector2.ZERO:
		return true
	if not _bounds.grow(-EDGE - CAR_R - 0.3).has_point(p):
		return true
	if (p - _ap_dead_end).dot(_ap_dead_in) > -CAR_R:
		return true
	var on := _nearest_seg(p, 15.0, true, false, _y)   # (a driveway's mouth is asphalt too)
	return on.is_empty() or float(on["edge"]) + CAR_R > AP_KT_KERB

func _ap_kturn(dt: float) -> Array:
	_ap_why = "turning"   # (the drive log's word for it)
	_ap_kt["t"] += dt
	_ap_kt["mt"] += dt
	var to: Vector2 = _ap_kt["to"]
	var g: int = _ap_kt["gear"]
	var diff := angle_difference(_yaw, to.angle())
	if absf(diff) < 0.45:
		# facing out, near enough for the lane-following to take it from here: stop, then plan
		# (going forward it drives straight on, as a driver does: stopping and setting off
		# again added a second or two to every turn)
		if absf(_v) > 0.1 and g < 0:
			return [0.0, 1.0, 0.0]
		var spot := int(_ap_kt["n"]) > AP_KT_MOVES or float(_ap_kt["t"]) > AP_KT_SECS
		Probe.event("turned_round", {"moves": mini(int(_ap_kt["n"]), AP_KT_MOVES), "secs": snappedf(float(_ap_kt["t"]), 0.1), "on_the_spot": spot})
		_log.event("turned round", "%d moves" % int(_ap_kt["n"]))
		_ap_kt = {}
		_ap_dead = Vector2.INF
		_gear = 1
		_set_blink(0)   # (it cannot tell a half turn left from one right: off by hand)
		_ap_pts = PackedVector2Array()   # (planned afresh next tick, facing out)
		return [0.0, 1.0, 0.0]
	if int(_ap_kt["n"]) > AP_KT_MOVES or float(_ap_kt["t"]) > AP_KT_SECS:
		# no room for it (a car parked across, a wall at the kerb): the rest on the spot
		_yaw = wrapf(_yaw + clampf(diff, -1.7 * dt, 1.7 * dt), -PI, PI)
		_yaw_rate = 0.0
		_v = 0.0
		_v_lat = 0.0
		return [0.0, 1.0, 0.0]
	_gear = g
	var wheel := float(_ap_kt["side"]) * MAX_STEER * g   # forward toward the turn, back the other lock
	if _ap_kt["stop"]:
		# between moves: stand, into the other gear, the wheel over (below), then go
		# (the wheel goes over to the other lock while it brakes, not only once it stands)
		if absf(_v) > 0.15:
			return [0.0, 1.0, move_toward(_steer, -wheel, 2.5 * dt)]
		_ap_kt["gear"] = -g
		_ap_kt["n"] = int(_ap_kt["n"]) + 1
		_ap_kt["mt"] = 0.0
		_ap_kt["stop"] = false
		_ap_kt["from"] = _pos
		_gear = -g
		return [0.0, 1.0, _steer]
	# a car coming up the street while it is across it: stand and let it stop or go by, as a
	# driver halfway through a turn does (the probes at the car's ends miss one coming at its
	# side). The move's clock stands too.
	for c in _traffic.cars:
		if c.alive and c.v > 0.5 and c.pos.distance_to(_pos) < 9.0 \
				and Vector2(sin(c.yaw), cos(c.yaw)).dot(_pos - c.pos) > 0.0:
			_ap_kt["mt"] = float(_ap_kt["mt"]) - dt
			return [0.0, 1.0, _steer]
	if absf(_steer - wheel) > 0.02 and absf(_v) < 0.3:
		# the wheel turned over standing still, as a driver does, not snapped from lock to lock
		return [0.0, 1.0, move_toward(_steer, wheel, 2.5 * dt)]
	var fwd := _fwd()
	# (ahead by a tick's reaction and the stopping distance on the brake, ~8 m/s^2: a fixed
	# share of the speed stopped the faster crawl ~0.6 m short and took two more moves)
	var end_p := _pos + fwd * float(g) * (CAR_OFF + 0.25 + absf(_v) * 0.2 + _v * _v / 16.0)
	# the move is over: at the kerb or something solid, or crawling nowhere (a lip, a slope)
	if _ap_kt_blocked(end_p) or float(_ap_kt["mt"]) > 6.0 or (float(_ap_kt["mt"]) > 2.0 and absf(_v) < 0.05):
		_ap_kt["stop"] = true
		# two moves running that got nowhere: boxed in both ways (crosswise in a street not
		# much longer than the car), the rest on the spot
		_ap_kt["idle"] = int(_ap_kt["idle"]) + 1 if _pos.distance_to(_ap_kt["from"]) < 0.15 else 0
		if int(_ap_kt["idle"]) >= 2:
			_ap_kt["n"] = AP_KT_MOVES + 1
		return [0.0, 1.0, wheel]
	var err := AP_KT_V - absf(_v)
	# (plus what holds it on the slope: backing up a 17% cul-de-sac on the gentle throttle of
	# the flat it crawled at 0.2 m/s and ran out of time)
	var hill := MASS * 9.81 * sin(_slope) * g / (ENGINE_F if g > 0 else REVERSE_F)
	var throttle := clampf(hill + 0.12 + err * 0.6, 0.0, 1.0) if err > 0.0 else 0.0
	var brake := clampf(-err * 0.5, 0.0, 1.0)
	return [throttle, brake, wheel]

## Autodrive's look ahead at a junction: does this way only lead off the map? True when every
## way on from it within EDGE_LOOK metres runs into the barrier at the map's edge. (An ordinary
## dead end -- a cul-de-sac -- does not count: autodrive explores those and turns.) A street
## running off the map was taken like any other, and the car turned round at the barrier.
const EDGE_LOOK := 300.0
const EDGE_DEAD := 30.0               ## a dead end this close to the barrier (past EDGE_ROOM) is the map's cut, for autodrive
const EDGE_ROOM := 4.0               ## a road's points this close to the barrier are past it, for autodrive
var _edge_memo := {}

func _edge_bound(leg: Vector3i) -> bool:
	if not _edge_memo.has(leg):
		_edge_memo[leg] = not _edge_walk(leg, EDGE_LOOK, 0)
	return _edge_memo[leg]

## can a car going `leg` drive on `budget` metres (or to an ordinary dead end) without
## reaching the edge, by some way?
func _edge_walk(leg: Vector3i, budget: float, depth: int) -> bool:
	var pts: PackedVector2Array = (_roads[leg.x] as Dictionary)["pts"]
	var rim := _bounds.grow(-EDGE - EDGE_ROOM)
	var last := pts.size() - 1 if leg.z > 0 else 0
	var k := leg.y
	var prev := pts[clampi(leg.y - leg.z, 0, pts.size() - 1)]
	var d := 0.0
	while true:
		if not rim.has_point(pts[k]):
			return false
		d += prev.distance_to(pts[k])
		prev = pts[k]
		if d >= budget:
			return true
		if k == last:
			break
		k += leg.z
	if depth >= 10:
		return true
	var ons := _legs_on(leg.x, last, leg.z)
	if ons.is_empty():
		# an ordinary dead end -- unless it ends near the barrier: then it is a street the
		# map's edge cut off, not a cul-de-sac. Taken as ordinary, autodrive drove 100 m along
		# Tel Aviv's edge into one (off Derech Namir, Tuval: 5-13 m from the barrier) and spent
		# 12 s turning round in it, twice (tests/autodrive_edge.gd TRACE=1, 22 Nov)
		var end_p := pts[last]
		var gap := minf(minf(end_p.x - rim.position.x, rim.end.x - end_p.x), minf(end_p.y - rim.position.y, rim.end.y - end_p.y))
		return gap > EDGE_DEAD
	
	for on: Vector3i in ons:
		if _edge_walk(on, budget - d, depth + 1):
			return true
	return false

## the legs autodrive could take on from point ei of road ri arrived at going `dir` (the
## same as _ap_ways, without the scores; no service lanes)
func _legs_on(ri: int, ei: int, dir: int) -> Array:
	var pts: PackedVector2Array = (_roads[ri] as Dictionary)["pts"]
	var node: int = ((_roads[ri] as Dictionary)["ids"] as PackedInt32Array)[ei]
	var prev := clampi(ei - dir, 0, pts.size() - 1)
	var came := (pts[ei] - pts[prev]).normalized()
	var out: Array = []
	for e: Vector2i in _node_roads[node]:
		var r2: Dictionary = _roads[e.x]
		if not r2["drive"] or r2["pv"] or r2["k"] == "service":
			continue
		var p2: PackedVector2Array = r2["pts"]
		for d2: int in [1, -1]:
			var nxt := e.y + d2
			if nxt < 0 or nxt >= p2.size() or (e.x == ri and nxt == prev):
				continue
			if r2["o"] != 0 and r2["o"] != d2:
				continue
			if came.dot((p2[nxt] - p2[e.y]).normalized()) < -0.7:
				continue
			out.append(Vector3i(e.x, nxt, d2))
	return out

## One big junction drawn as several. Where a divided road meets a street, each of its halves
## meets it at a point of its own, 10-30 m apart (four points where two divided roads cross),
## and every one of them asked again which way: right-or-on, then left-or-on, for one left
## turn. The choices are now the ways out of the whole knot -- each with the short legs
## across it that get there, driven without asking -- and how far each turns from the way in.
func _cluster_exits(ways: Array, came: Vector2, depth: int, seen: Dictionary) -> Array:
	var out: Array = []
	for w: Dictionary in ways:
		if w["service"]:
			continue
		var leg: Vector3i = w["leg"]
		var r2: Dictionary = _roads[leg.x]
		var p2: PackedVector2Array = r2["pts"]
		var last := p2.size() - 1 if leg.z > 0 else 0
		var length := 0.0
		var k := leg.y - leg.z
		while k != last:
			length += p2[k].distance_to(p2[k + leg.z])
			k += leg.z
		var end_node: int = (r2["ids"] as PackedInt32Array)[last]
		if depth < 3 and length <= CLUSTER_M and not r2.get("ring", false) and not seen.has(end_node):
			var main2: Array = (_ap_ways(leg.x, last, leg.z)[0] as Array).filter(func(x): return not x["service"])
			if main2.size() >= 2:   # another point of the same junction: on across it
				seen[end_node] = true
				for sub: Dictionary in _cluster_exits(main2, came, depth + 1, seen):
					sub["legs"] = [leg] + (sub["legs"] as Array)
					out.append(sub)
				continue
		# (not one that runs back into the knot: round three sides of it to leave by a road
		# the first point already offered)
		var ids2: PackedInt32Array = r2["ids"]
		var back_in := false
		var run := 0.0
		var j := leg.y
		while run < CLUSTER_M * 1.5:
			run += p2[j - leg.z].distance_to(p2[j])
			if seen.has(ids2[j]):
				back_in = true
				break
			if j == last:
				break
			j += leg.z
		if back_in:
			continue
		# a way out: where it heads 15 m on (a slip road curves), against the way in
		var a := p2[leg.y - leg.z]
		var b := a
		var i := leg.y - leg.z
		while i != last and b.distance_to(a) < 15.0:
			i += leg.z
			b = p2[i]
		var go := (b - a).normalized()
		if go == Vector2.ZERO or came.dot(go) < -0.7:
			continue   # round the knot and back the way it came
		out.append({"leg": leg, "legs": [leg], "turn": came.angle_to(go), "name": w["name"], "en": w["en"],
			"service": false, "score": w["score"]})
	if depth > 0:
		return out
	# a slip road (a short way with no name of its own, cutting a corner) is the turn into the
	# street it joins: named after that street, so it is not offered as a way of its own --
	# "it gave four options, one of them weird"
	for x: Dictionary in out:
		if x["name"] == "":
			var joins := _slip_joins(x["legs"].back())
			if joins >= 0:
				x["name"] = String((_roads[joins] as Dictionary)["name"])
				x["en"] = String((_roads[joins] as Dictionary)["en"])
				x["slip"] = true
	# the same way out reached two ways round (or the same street, the same way, from two
	# of its points): the one across fewer of them -- but turning right, the slip road, the
	# turn from the kerb side (from the junction itself it turned from the middle of the road)
	var keep: Array = []
	for x: Dictionary in out:
		var dup := -1
		for i in range(keep.size()):
			var k2: Dictionary = keep[i]
			var apart := absf(angle_difference(k2["turn"], x["turn"]))
			if (k2["legs"] as Array).back() == (x["legs"] as Array).back() \
					or (x["name"] != "" and k2["name"] == x["name"] and apart < 0.7) \
					or ((x["name"] == "" or k2["name"] == "") and apart < 0.35):
				# (and a way with no name within 20 degrees of another: two buttons a degree
				# apart, one of them "no name" -- a service road beside the junction, a slip)
				dup = i
				break
		if dup < 0:
			keep.append(x)
		else:
			var k3: Dictionary = keep[dup]
			var x_slip: bool = x.get("slip", false) and float(x["turn"]) > 0.3
			var k_slip: bool = k3.get("slip", false) and float(k3["turn"]) > 0.3
			if x_slip and not k_slip or (x_slip == k_slip and k3["name"] == "" and x["name"] != "") \
					or (x_slip == k_slip and (k3["name"] == "") == (x["name"] == "") and (x["legs"] as Array).size() < (k3["legs"] as Array).size()):
				keep[dup] = x
	return keep

## the named street a short unnamed way (a slip road) runs into: its road, or -1
func _slip_joins(leg: Vector3i) -> int:
	var r: Dictionary = _roads[leg.x]
	var pts: PackedVector2Array = r["pts"]
	var last := pts.size() - 1 if leg.z > 0 else 0
	var L := 0.0
	var k := leg.y - leg.z
	while k != last:
		L += pts[k].distance_to(pts[k + leg.z])
		k += leg.z
	if L > 90.0:
		return -1
	var end_node: int = (r["ids"] as PackedInt32Array)[last]
	for e: Vector2i in _node_roads[end_node]:
		var r2: Dictionary = _roads[e.x]
		if e.x != leg.x and r2["drive"] and String(r2["name"]) != "":
			return e.x
	return -1

## the crossing ahead: take your pick (or ours, once it is too late to wait for yours)
func _cross_tick() -> void:
	if _cross.is_empty():
		return
	var ways: Array = _cross["ways"]
	if not _cross["chosen"] and _cross_showing():
		var pick := -1
		if PInput.just_pressed("move_left"):
			pick = 0
		elif PInput.just_pressed("move_right"):
			pick = ways.size() - 1
		elif PInput.just_pressed("move_up"):
			pick = 0
			for i in range(ways.size()):
				if absf(ways[i]["turn"]) < absf(ways[pick]["turn"]):
					pick = i
		if pick >= 0:
			_cross_pick(pick)
	var d := _pos.distance_to(_cross["at"])
	# go on: chosen, or too close to wait -- or crawling with the plan nearly used up (a car
	# handed over beside a crossing, that could not get within 10 m of its point, waited
	# there for ever and drifted into the parked cars)
	# (undecided: ours at 30 m, not at the last moment -- room to get into the lane for it)
	if _cross["chosen"] or d < maxf(30.0, _v * 2.5) or (absf(_v) < 1.5 and d < 26.0):
		var w: Dictionary = ways[_cross["pick"]]
		var legs: Array = w["legs"]
		var leg: Vector3i = legs[0]
		Probe.event("crossing", {"turn": int(rad_to_deg(w["turn"])), "chosen": _cross["chosen"], "legs": legs.size()})
		_log.event("junction", "%+d deg%s" % [int(rad_to_deg(w["turn"])), " (chosen)" if _cross["chosen"] else ""])
		_cross = {}
		_ap_queue = legs.slice(1)
		_ap_leg(leg.x, leg.y, leg.z)

func _cross_pick(i: int) -> void:
	_cross["pick"] = i
	_cross["chosen"] = true
	Audio.play("click", 0.05, -6.0)

## the choices are up from CROSS_SHOW_S seconds (and at least 70 m) out -- early enough to
## move into the lane for the turn once one is picked (at 45 m it turned from the middle)
func _cross_showing() -> bool:
	return not _cross.is_empty() and _pos.distance_to(_cross["at"]) < maxf(70.0, _v * CROSS_SHOW_S)

func _cross_rect(i: int, n: int) -> Rect2:
	var w := 78.0
	return Rect2(320.0 - n * (w + 6.0) * 0.5 + i * (w + 6.0) + 3.0, 44.0, w, 46.0)

## ---- going to an address ------------------------------------------------------------------

## plan the shortest legal way from the car to the kerb nearest `goal` into the autodrive lane
func _route_to(goal: Vector2, from := Vector2.INF, heading := Vector2.ZERO) -> bool:
	if from == Vector2.INF:
		from = _pos
	if heading == Vector2.ZERO:
		heading = _fwd()
	var s := _nearest_seg(from, 40.0, true, true, _y if from.distance_to(_pos) < 30.0 else NAN)
	var g := _nearest_seg(goal, 150.0, true, true)
	if not g.is_empty() and _pocketed(g, _cut_off):
		# in a pocket that can be driven into only from beyond the map's edge: to the nearest
		# street that has a way in (see _find_pockets)
		g = _nearest_seg_out(goal, 400.0, _cut_off)
	if s.is_empty() or g.is_empty():
		return false
	var r: Dictionary = _roads[s["road"]]
	var ids: PackedInt32Array = r["ids"]
	var pts: PackedVector2Array = r["pts"]
	var sj: int = s["seg"]
	var ahead := (pts[sj + 1] - pts[sj]).dot(heading) >= 0.0
	# Either way along the street it stands in (a two-way one), whichever makes the shorter
	# trip -- the way it faces only breaks a near tie (turning round costs ~15 m). It took the
	# way the car faced, and leaving a house facing away from the route it swerved across a
	# narrow street into the wall, then crept to a junction to turn round in it.
	var dirs: Array = [int(r["o"])] if int(r["o"]) != 0 else [1, -1]
	var dir := 0
	var first := -1
	# arrive at either end of the goal's segment, whichever is legal and shorter
	var gr: Dictionary = _roads[g["road"]]
	var gids: PackedInt32Array = gr["ids"]
	var gj: int = g["seg"]
	var best := PackedInt64Array()
	var best_len := INF
	var best_dir := 0
	for d0: int in dirs:
		var f0 := ids[sj + 1] if d0 > 0 else ids[sj]
		var lead_in := (s["q"] as Vector2).distance_to(_nodes[f0]) + (0.0 if (d0 > 0) == ahead else 15.0)
		for end: Array in [[gids[gj], 1], [gids[gj + 1], -1]]:
			if gr["o"] != 0 and gr["o"] != end[1]:
				continue   # would mean driving the last bit against a one-way
			if not _astar.has_point(f0) or not _astar.has_point(end[0]):
				continue
			var path := _astar.get_id_path(f0, end[0])
			if path.is_empty():
				continue
			if path.size() >= 2 and path[1] == (ids[sj] if d0 > 0 else ids[sj + 1]):
				continue   # on to the end of its street and straight back (a dead end): the
				           # other way round is the same trip without the U-turn. It took this
				           # one from a house at a dead end, swung round in the closed end and
				           # into the fence there.
			var other := gids[gj + 1] if end[1] == 1 else gids[gj]
			if path.size() >= 2 and path[path.size() - 2] == other:
				continue   # it drives past the address to the far end, then U-turns back: no
			var L := lead_in
			for i in range(1, path.size()):
				L += _nodes[path[i - 1]].distance_to(_nodes[path[i]])
			if L < best_len:
				best_len = L
				best = path
				best_dir = end[1]
				dir = d0
				first = f0
	if best.is_empty():
		return false
	# from its own lane, not the middle of the street: from the middle, the line to the next
	# point down the street ran diagonally across it, and the car drove left of the centre
	# line for the length of the street (turned round out of a dead end, all of it)
	var d_first := (pts[sj + 1] - pts[sj]).normalized() * float(dir)
	_ap_pts = PackedVector2Array([(s["q"] as Vector2) + Vector2(-d_first.y, d_first.x) * _lane_off(r)])
	_ap_lim = PackedFloat32Array([float(r["speed"])])
	# The path's points, with the lane of the road coming into each; of two closer than 3 m one
	# kept -- the junction's (a junction drawn as two points 0.9 m apart was two corners, the
	# second's curve starting behind the first: the plan doubled back on itself; and keeping the
	# first of two, a slip road's point 3 m short of the street it joins, laid the corner off
	# that street's line: the car came out 4.7 m from the middle of an 8 m street, into a post)
	var cl: Array = []   # [point, lane in, speed in, node]
	for i in range(best.size()):
		var n := int(best[i])
		var e: Vector3i = _edge_of.get(Vector2i(int(best[i - 1]), n), Vector3i(s["road"], 0, 1)) if i > 0 else Vector3i(s["road"], 0, dir)
		var road: Dictionary = _roads[e.x]
		var prev_at: Vector2 = (cl[cl.size() - 1][0] as Vector2) if not cl.is_empty() else (s["q"] as Vector2)
		if not cl.is_empty() and _nodes[n].distance_to(prev_at) < 3.0 and i + 1 < best.size():
			if _node_ways(n) >= 3 and _node_ways(int(cl[cl.size() - 1][3])) < 3:
				cl[cl.size() - 1] = [_nodes[n], cl[cl.size() - 1][1], cl[cl.size() - 1][2], n]   # (the junction's point, the lane in as before)
			continue
		cl.append([_nodes[n], _lane_off(road), float(road["speed"]), n])
	var plain := true   # (the last point laid is a lane point, not the end of a corner)
	var arc_end := Vector2.INF   # (the last corner's end, and its way out: lane points it has passed are left out)
	var arc_out := Vector2.ZERO
	for i in range(cl.size()):
		var c: Vector2 = cl[i][0]
		var lane: float = cl[i][1]
		var spd: float = cl[i][2]
		var prv := _ap_pts[_ap_pts.size() - 1]
		var before_c: Vector2 = (cl[i - 1][0] as Vector2) if i > 0 else (s["q"] as Vector2)
		var nxt: Vector2 = (cl[i + 1][0] as Vector2) if i + 1 < cl.size() else (g["q"] as Vector2)
		var din := (c - before_c).normalized()
		var dout := (nxt - c).normalized()
		# Along a roundabout's ring (in on it and out on it): no corner. Its points are a circle
		# drawn as a polygon, and an arc laid at each -- squeezed by the next point a metre or a
		# few on -- drove it as short straights and 4-5 m bends: 15 km/h round a 17 m ring, and
		# the bends on and off it were squeezed the same way (a user: "pauses before roundabout
		# exits... very defensive, somewhat slow"). Its lane points make a smooth enough circle.
		var on_ring := i > 0 and i + 1 < cl.size() and _ring_node(int(cl[i - 1][3])) and _ring_node(int(cl[i][3])) and _ring_node(int(cl[i + 1][3]))
		# (the first point too, when the car is not on it already: a side street that is one
		# stretch up to the junction has the junction as its first point, and it was a corner
		# of one point, taken wide)
		if not on_ring and (i > 0 or c.distance_to(before_c) > 3.0) and din != Vector2.ZERO and dout != Vector2.ZERO and absf(din.angle_to(dout)) >= 0.35:
			# A corner: in along its lane, round, and out in the next street's lane, as free
			# autodrive turns (see _lane_corner). One point at the corner, put into the lane
			# square to the way to the next point (the next street's way), sat on the middle
			# line of the street it was leaving: a right turn swung out left over the last
			# 10 m, came round at full lock from there and out over the next street's middle
			# line, into the oncoming lane (tests/turn_width.gd: 4 of 4 in Givatayim).
			var lane2: float = cl[i + 1][1] if i + 1 < cl.size() else _lane_off(gr)
			var spd2: float = cl[i + 1][2] if i + 1 < cl.size() else float(gr["speed"])
			var from_pt := prv
			if plain and _ap_pts.size() > 1:
				from_pt = _ap_pts[_ap_pts.size() - 2]   # (the last lane point lies on the way in: the curve may start behind it)
			# (out as far as the next point if that is no corner itself, else under half way to it)
			var upto := c + (nxt - c) * 0.45
			if i + 2 < cl.size() and (absf(dout.angle_to(((cl[i + 2][0] as Vector2) - nxt).normalized())) < 0.35 \
					or (_ring_node(int(cl[i][3])) and _ring_node(int(cl[i + 1][3])) and _ring_node(int(cl[i + 2][3])))):
				upto = nxt   # (or the ring's next point: no corner of its own, see on_ring)
			var arc := _lane_corner(c, din, dout, lane, lane2, _node_r[int(cl[i][3])] + 1.0, from_pt, upto)
			if not arc.is_empty():
				if plain and _ap_pts.size() > 1 and (arc[0] - prv).dot(din) < 0.3:
					_ap_pts.remove_at(_ap_pts.size() - 1)   # (it starts behind that lane point)
					_ap_lim.remove_at(_ap_lim.size() - 1)
				for q: Vector2 in arc:
					_ap_pts.append(q)
					_ap_lim.append(minf(spd, spd2))
				plain = false
				arc_end = arc[arc.size() - 1]
				arc_out = dout
				continue
		var d := (nxt - before_c).normalized()
		var lp := c + Vector2(-d.y, d.x) * lane
		if arc_end != Vector2.INF and (lp - arc_end).dot(arc_out) < 0.5:
			continue   # (the last corner's curve ran past it)
		_ap_pts.append(lp)
		_ap_lim.append(spd)
		plain = true
	# the last stretch along the goal's segment, to the kerb in front of the address
	var last_dir := (gr["pts"] as PackedVector2Array)[gj + 1] - (gr["pts"] as PackedVector2Array)[gj]
	last_dir = last_dir.normalized() * float(best_dir)
	var glane := _lane_off(gr)
	_dest_stop = (g["q"] as Vector2) + Vector2(-last_dir.y, last_dir.x) * glane
	_ap_pts.append(_dest_stop)
	_ap_lim.append(float(gr["speed"]))
	_ap_v = _ap_lim.duplicate()
	_ap_curves(1)
	_ap_v[_ap_v.size() - 1] = 0.0   # and stop there
	_ap_end = Vector3i(-1, 0, 0)    # nothing after the destination
	Probe.event("route", {"to": _dest_name, "m": int(best_len), "points": _ap_pts.size()})
	return true

## is point n on a roundabout's ring?
func _ring_node(n: int) -> bool:
	for e: Vector2i in _node_roads[n]:
		if (_roads[e.x] as Dictionary).get("ring", false):
			return true
	return false

func _set_dest(at: Vector2, label: String) -> void:
	_dest_on = true
	_dest = at
	_dest_stop = at
	_dest_name = label
	_dest_t = 0.0
	if _beacon == null:
		_beacon = MeshInstance3D.new()
		var cm := CylinderMesh.new()
		cm.top_radius = 1.4
		cm.bottom_radius = 1.4
		cm.height = 70.0
		cm.radial_segments = 16
		cm.cap_top = false
		var m := _surface("beacon")
		m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		m.cull_mode = BaseMaterial3D.CULL_DISABLED
		cm.material = m
		_beacon.mesh = cm
		_beacon.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		world.add_child(_beacon)
	_beacon.position = Vector3(at.x, _h(at) + 35.0, at.y)
	_beacon.visible = true
	Probe.event("destination", {"to": label})
	_set_auto(true)
	_show_banner("→ " + label, 2.0)

func _clear_dest() -> void:
	_dest_on = false
	if _beacon != null:
		_beacon.visible = false

func _check_arrival(dt: float) -> void:
	if not _dest_on:
		return
	_dest_t += dt
	var near_stop := _pos.distance_to(_dest_stop)
	var last_leg := _auto and _ap_pts.size() <= 3
	if near_stop < 9.0 and absf(_v) < 1.5 or last_leg and near_stop < 15.0 and absf(_v) < 3.0 \
			or (not _auto and _pos.distance_to(_dest) < 16.0 and absf(_v) < 2.5):
		_auto = false
		_ap_pts = PackedVector2Array()
		_clear_dest()
		Audio.play("coin", 0.05, -8.0)
		_show_banner("arrived: " + _dest_name, 3.0)
		Probe.event("arrived", {"to": _dest_name, "secs": int(_dest_t)})
		if not _route.is_empty():   # a drive of the route set: back to the list in a moment
			_show_banner("route %d arrived in %d:%02d -- back to the list" % [int(_route["id"]), int(_dest_t) / 60, int(_dest_t) % 60], 4.0)
			var page := "mine" if _route.get("mine", false) else "set"
			get_tree().create_timer(4.5).timeout.connect(func(): Flow.start_game("streets", {"level": _routes_level(), "page": page}))

## ---- the address picker: streets, then house numbers ---------------------------------------
## Built for thumbs: no scrolling list (a phone's finger lands on a button, not the list)
## and no typing box (web builds get no reliable on-screen keyboard). Letter chips narrow
## the streets to an initial, pages flip with big arrows. The buttons are only drawn: the
## shell's UI layer sits over every game and would swallow real clicks, so _input() hit-
## tests them and calls the Callable each one carries in its "cb" meta (see _pick_tap).

const PICK_COLS := 2
const PICK_ROWS := 7
const NUM_COLS := 6

func _open_picker() -> void:
	if _picker != null:
		return
	if _walking:
		_show_banner("get back in the car first", 1.2)
		return
	if _streets_list.is_empty():
		_build_street_list()
	_picker = Control.new()
	_picker.size = Vector2(640, 360)
	_picker.z_index = 90
	add_child(_picker)
	var dim := ColorRect.new()
	dim.color = Color(Palette.col("bg"), 0.93)
	dim.size = Vector2(640, 360)
	dim.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_picker.add_child(dim)
	var title := UIKit.label("", 16, "player")
	title.position = Vector2(170, 2)
	title.size = Vector2(300, 22)
	_picker.add_child(title)
	_pick_title = title
	# jump there (you are put down on that street) or drive there (autodrive takes you): two
	# choices side by side, the one in force filled in. (One button that said the other
	# mode -- "⇄ drive there" -- did not read as a choice; the user asked for both, jump first.)
	_pick_jump_btn = _bar_button("jump to", Vector2(24, 4), 72, func():   # (clear of the shell's score)
		_pick_jump = true
		_show_pick_mode())
	_pick_drive_btn = _bar_button("drive to", Vector2(100, 4), 72, func():
		_pick_jump = false
		_show_pick_mode())
	_show_pick_mode()
	_pick_letters = Control.new()
	_pick_letters.position = Vector2(0, 34)   # clear of the shell's sound/menu buttons
	_picker.add_child(_pick_letters)
	_pick_body = Control.new()
	_pick_body.position = Vector2(20, 90)
	_picker.add_child(_pick_body)
	_pick_prev = _bar_button("◀", Vector2(20, 331), 90, func(): _turn(-1))
	_pick_next = _bar_button("▶", Vector2(410, 331), 90, func(): _turn(1))
	_bar_button("close", Vector2(530, 331), 90, _cancel_picker)
	_pick_page_lbl = UIKit.label("", 12, "ink")
	_pick_page_lbl.add_theme_font_override("font", _font)
	_pick_page_lbl.text_direction = Control.TEXT_DIRECTION_LTR
	_pick_page_lbl.position = Vector2(110, 334)
	_pick_page_lbl.size = Vector2(300, 18)
	_picker.add_child(_pick_page_lbl)
	_pick_mode = "streets"
	_pick_page = 0
	_build_letters()
	_refresh_pick()
	Probe.event("picker")

func _show_pick_mode() -> void:
	for b: Button in [_pick_jump_btn, _pick_drive_btn]:
		var on := (b == _pick_jump_btn) == _pick_jump
		var sb := (b.get_theme_stylebox("normal") as StyleBoxFlat).duplicate() as StyleBoxFlat
		sb.bg_color = Palette.col("player").darkened(0.35) if on else Palette.col("bg")
		sb.border_color = Palette.col("player") if on else Palette.col("accent").darkened(0.45)
		b.add_theme_stylebox_override("normal", sb)
		b.add_theme_stylebox_override("hover", sb)
		b.add_theme_stylebox_override("focus", sb)
		b.add_theme_color_override("font_color", Palette.col("bg") if on else Palette.col("ink").darkened(0.35))
		b.add_theme_color_override("font_hover_color", Palette.col("bg") if on else Palette.col("ink"))
	_pick_title.text = "jump to where?" if _pick_jump else "drive to where?"
	if _making != "":
		# making a route of your own: from, then to (no jumping or driving yet)
		_pick_jump_btn.visible = false
		_pick_drive_btn.visible = false
		_pick_title.text = "your route: from where?" if _making == "from" else "your route: to where?"
		_pick_title.position.x = 24.0

func _close_picker() -> void:
	if _picker != null:
		_picker.queue_free()
		_picker = null

## ---- the route set: ten drives to pick from and watch ---------------------------------------
## (routes.json, picked by tests/pick_routes.py; tests/run_routes.sh drives them headless and
## keeps their results.) The "Test routes" level opens the list with no city behind it; a
## pick starts that route's own city with {"route": id}: the car set down at its "from", "go
## to" its "to" on autodrive, and once there, back to the list.
const ROUTES_FILE := "res://game/streets/routes.json"
const CITY_NAMES := {"givatayim": "Givatayim", "ashdod": "Ashdod", "tel_aviv": "Tel Aviv", "bedford": "Bedford", "dimyon": "test town", "delft": "Delft"}
var _route := {}                       ## the drive of the route set being watched, or {}
var _route_ui: Control                 ## the list of them, while it is up

func _routes() -> Array:
	var f := FileAccess.open(ROUTES_FILE, FileAccess.READ)
	if f == null:
		return []
	var data = JSON.parse_string(f.get_as_text())
	return (data as Dictionary).get("routes", []) if data is Dictionary else []

## Routes of your own: made from the list ("+ a new one", a city, then from and to with the
## address picker), kept in this browser or device only (user://, never in the game's files:
## the web build is public, and a route from home names home). Up to MY_ROUTES_MAX, newest
## first; their ids from MY_ROUTE_ID0 up, apart from the set's.
const MY_ROUTES_FILE := "user://my_routes.json"
const MY_ROUTES_MAX := 9
const MY_ROUTE_ID0 := 1001
var _route_page := "set"              ## the list's page: "set" (the ten) or "mine"
var _making := ""                     ## making a route of your own: "from", "to", or ""
var _making_from: Array = []          ## [label, where] picked for its "from"

func _my_routes() -> Array:
	var f := FileAccess.open(MY_ROUTES_FILE, FileAccess.READ)
	if f == null:
		return []
	var data = JSON.parse_string(f.get_as_text())
	return (data as Dictionary).get("routes", []) if data is Dictionary else []

func _save_my_routes(routes: Array) -> void:
	var f := FileAccess.open(MY_ROUTES_FILE, FileAccess.WRITE)
	if f != null:
		f.store_string(JSON.stringify({"routes": routes}))

func _route_by_id(id: int) -> Dictionary:
	for r: Dictionary in _routes() + _my_routes():
		if int(r["id"]) == id:
			return r
	return {}

func _routes_level() -> int:
	for i in range(LEVELS.size()):
		if (LEVELS[i] as Dictionary).get("routes", false):
			return i + 1
	return 1

## the level that drives a city (not a filmed walk in it, not this list)
func _city_level(cid: String) -> int:
	for i in range(LEVELS.size()):
		var lv: Dictionary = LEVELS[i]
		if lv.get("city", "") == cid and not lv.has("walk") and not _is_list(lv):
			return i + 1
	return 1

## the picker's pick while making a route: its "from", then its "to" -- saved, and driven
func _made_pick(label: String, at: Vector2) -> void:
	if _making == "from":
		_making_from = [label, at]
		_making = "to"
		_open_picker()
		return
	_making = ""
	var from: Vector2 = _making_from[1]
	var mine := _my_routes()
	var id := MY_ROUTE_ID0
	for r: Dictionary in mine:
		id = maxi(id, int(r["id"]) + 1)
	var lvl := _city_level(_city_id)
	var r := {"id": id, "level": lvl, "city": _city_id, "from": _making_from[0], "from_at": [snappedf(from.x, 0.1), snappedf(from.y, 0.1)],
		"to": label, "to_at": [snappedf(at.x, 0.1), snappedf(at.y, 0.1)], "crow_m": int(from.distance_to(at)), "mine": true}
	mine.push_front(r)
	_save_my_routes(mine.slice(0, MY_ROUTES_MAX))
	Probe.event("route_made", {"id": id, "m": int(from.distance_to(at))})
	_route = r
	_route_begin()

## the picker's "close": while making a route, back to the list (it came from there)
func _cancel_picker() -> void:
	_close_picker()
	if _making != "":
		_making = ""
		Flow.start_game("streets", {"level": _routes_level(), "page": "mine"})

func _route_list_open() -> void:
	if _route_ui != null:
		_route_ui.queue_free()
	_route_ui = Control.new()
	_route_ui.size = Vector2(640, 360)
	_route_ui.z_index = 90
	add_child(_route_ui)
	var dim := ColorRect.new()
	dim.color = Color(Palette.col("bg"), 0.96)
	dim.size = Vector2(640, 360)
	dim.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_route_ui.add_child(dim)
	var title := UIKit.label("test routes: pick one and watch autodrive drive it", 13, "player")
	title.add_theme_font_override("font", _font)
	title.position = Vector2(20, 30)
	title.size = Vector2(600, 20)
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_route_ui.add_child(title)
	# two pages: the set's ten, and yours
	var mine := _my_routes()
	for k in range(2):
		var page: String = ["set", "mine"][k]
		var tab := _tap_button(["the set", "yours (%d)" % mine.size()][k], func(): _route_page = page; _route_list_open())
		tab.add_theme_font_override("font", _font)
		tab.add_theme_font_size_override("font_size", 11)
		tab.modulate = Color(1, 1, 1, 1.0 if page == _route_page else 0.5)
		_route_ui.add_child(tab)
		# (sized once in the tree, _put: sized before, they kept the kit's 180x34 minimum and
		# overlapped -- a tap on "test town" started Bedford)
		_put(tab, Vector2(124 + k * 102, 52), Vector2(96, 22))   # (left, by "back": the settings row takes the right)
	var routes := _routes() if _route_page == "set" else mine
	if _route_page == "mine":
		_route_new_row(routes.size())
	elif routes.is_empty():
		var none := UIKit.label("no routes.json", 13, "ink")
		none.position = Vector2(20, 84)
		_route_ui.add_child(none)
	for i in range(routes.size()):
		var r: Dictionary = routes[i]
		# ("from" and "to" between the two addresses, not an arrow: a Hebrew address, an arrow
		# and another came out as one right-to-left run, the arrow pointing from end to start)
		var text := "%s:   from  %s   to  %s" % [CITY_NAMES.get(r["city"], r["city"]), r["from"], r["to"]]
		if not r.get("mine", false):
			text = "%d   %s" % [int(r["id"]), text]
		var w := 612.0 if not r.get("mine", false) else 572.0
		var b := _tap_button(text, func(): Flow.start_game("streets", {"level": int(r["level"]), "route": int(r["id"]),
			"style": _routes_style, "time": _list_time}))
		b.add_theme_font_override("font", _font)
		b.add_theme_font_size_override("font_size", 10)
		b.clip_text = true
		# (eleven fit: 25 apart from 78; tighter, a row's button kept the kit's least height over
		# the next and a tap on route 10 started route 9)
		var many := routes.size() + (1 if _route_page == "mine" else 0) > 10
		var pitch := 25.0 if many else 27.0
		var y := (78.0 if many else 80.0) + (i + (1 if _route_page == "mine" else 0)) * pitch
		_route_ui.add_child(b)
		_put(b, Vector2(14, y), Vector2(w, 24.0 if many else 25.0))
		if r.get("mine", false):
			var id := int(r["id"])
			var x := _tap_button("✕", func(): _save_my_routes(_my_routes().filter(func(q): return int(q["id"]) != id)); _route_list_open())
			x.add_theme_font_override("font", _font)
			x.add_theme_font_size_override("font_size", 11)
			_route_ui.add_child(x)
			_put(x, Vector2(590, y), Vector2(36, 25))
	_back_button(Vector2(14, 52))   # (top left, beside the tabs: ten routes reach the foot)
	_list_settings(Vector2(336, 52), "routes", _route_list_open)   # (right of the tabs, same reason)

## "+ a new one": the cities to make it in, one button each (the city loads, then the picker
## asks from where and to where)
func _route_new_row(have: int) -> void:
	var lbl := UIKit.label("+ a new one, in" if have < MY_ROUTES_MAX else "+ a new one (the oldest goes), in", 11, "ink")
	lbl.add_theme_font_override("font", _font)
	lbl.position = Vector2(14, 83)
	lbl.size = Vector2(170, 20)
	_route_ui.add_child(lbl)
	var cities: Array = CITY_NAMES.keys()
	var cw := 436.0 / cities.size()
	for k in range(cities.size()):
		var cid: String = cities[k]
		var b := _tap_button(CITY_NAMES[cid], func(): Flow.start_game("streets", {"level": _city_level(cid), "make_route": true,
			"style": _routes_style, "time": _list_time}))
		b.add_theme_font_override("font", _font)
		b.add_theme_font_size_override("font_size", 10)
		_route_ui.add_child(b)
		_put(b, Vector2(190 + k * cw, 80), Vector2(cw - 4.0, 25))

## a place in LEVELS that is one of the start screen's lists, not a city to drive
static func _is_list(lv: Dictionary) -> bool:
	return lv.get("routes", false) or lv.get("walks", false) or lv.get("cities", false) or lv.get("scenarios", false)

## The start screen's lists of places, one button each, a "back" at the foot (in the list's
## frame, _route_ui, so _input's taps reach them as the routes' do). "walks": every place in
## LEVELS with a "walk", the filmed ones first; "cities": every city to drive, by "sort".
func _walk_list_open(kind := "walks") -> void:
	if _route_ui != null:
		_route_ui.queue_free()
	_route_ui = Control.new()
	_route_ui.size = Vector2(640, 360)
	_route_ui.z_index = 90
	add_child(_route_ui)
	var dim := ColorRect.new()
	dim.color = Color(Palette.col("bg"), 0.96)
	dim.size = Vector2(640, 360)
	dim.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_route_ui.add_child(dim)
	var title := UIKit.label({"walks": "walks: pick one and watch it, in first person", "cities": "cities: pick one to drive",
		"scenarios": "scenarios: a tour of a town, or a story played out in it"}.get(kind, ""), 13, "player")
	title.add_theme_font_override("font", _font)
	title.position = Vector2(20, 30)
	title.size = Vector2(600, 20)
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_route_ui.add_child(title)
	var rows: Array = []
	if kind == "scenarios":
		for i in range(LEVELS.size()):
			if (LEVELS[i] as Dictionary).has("scenario"):
				rows.append([i + 1, String(LEVELS[i]["name"])])
	elif kind == "walks":
		for filmed: bool in [true, false]:
			for i in range(LEVELS.size()):
				var lv: Dictionary = LEVELS[i]
				if lv.has("walk") and bool(lv.get("filmed", false)) == filmed:
					rows.append([i + 1, String(lv["name"])])
	else:
		var keyed: Array = []
		for i in range(LEVELS.size()):
			var lv: Dictionary = LEVELS[i]
			if lv.has("city") and not lv.has("walk") and not lv.has("scenario") and not _is_list(lv):
				keyed.append([float(lv.get("sort", i)), i + 1, String(lv["name"])])
		keyed.sort_custom(func(a, b): return a[0] < b[0])
		for kk: Array in keyed:
			rows.append([kk[1], kk[2]])
	# two columns past seven, so a dozen fit
	var two := rows.size() > 7
	for k in range(rows.size()):
		var lvl: int = rows[k][0]
		var cfg := {"level": lvl, "time": _list_time}
		if kind != "walks":
			cfg["style"] = _cities_style
		var b := _tap_button(String(rows[k][1]), func(): Flow.start_game("streets", cfg))
		b.add_theme_font_override("font", _font)
		b.add_theme_font_size_override("font_size", 11)
		b.clip_text = true
		_route_ui.add_child(b)
		if two:
			_put(b, Vector2(30 + (k % 2) * 295, 64 + (k / 2) * 31.0), Vector2(285, 27))
		else:
			_put(b, Vector2(120, 64 + k * 31.0), Vector2(400, 27))
	_back_button()
	_list_settings(Vector2(24, 322), kind, func(): _walk_list_open(kind), 1.3, Vector2(392, 322))   # (at the foot, by "back")

## The lists' settings, chosen before a drive or walk starts and carried in its config ("style",
## "time"; start() reads them): autodrive "normal" (the rules) or "racer" -- test drives and
## cities, not walks, which have no autodrive -- and the time of day. The user, 22 Nov: "lets add
## settings like racer/normal day/evening/night to both test drives and the walk (it wont have
## the racer option)". Kept while the app runs (static), apart for test drives (normal at first:
## they are there to test autodrive) and cities (racer at first, as the HUD's own default).
static var _list_time := "day"
static var _routes_style := "rules"
static var _cities_style := "racer"
var _start_time := "day"             ## the time of day to switch to once the city is up (config "time")

## the row: [normal][racer]  [day][evening][night] from `at` (walks: the times only) -- or,
## with `style_at`, the times from `at` and normal/racer from there (at a list's foot, either
## side of "back"). A tap sets it and `again` builds the list anew to show it (the chosen one
## full, the rest dimmed, as the routes' tabs). `k` scales them (the foot has the room).
func _list_settings(at: Vector2, kind: String, again: Callable, k := 1.0, style_at := Vector2.INF) -> void:
	var styles: Array = []   # [text, width, chosen, what it sets]
	if kind != "walks":
		var cur := _routes_style if kind == "routes" else _cities_style
		for st: Array in [["normal", "rules"], ["racer", "racer"]]:
			styles.append([st[0], {"normal": 48.0, "racer": 40.0}[st[0]] * k, cur == st[1], func():
				if kind == "routes":
					_routes_style = st[1]
				else:
					_cities_style = st[1]
				again.call()])
	var times: Array = []
	for tm: String in ["day", "evening", "night"]:
		times.append([tm, {"day": 34.0, "evening": 52.0, "night": 42.0}[tm] * k, _list_time == tm, func():
			_list_time = tm
			again.call()])
	var x := at.x
	if style_at != Vector2.INF:
		_list_row(times, at, k)
		_list_row(styles, style_at, k)
	else:
		x = _list_row(styles, at, k)
		_list_row(times, Vector2(x + (6.0 if not styles.is_empty() else 0.0), at.y), k)

## one run of _list_settings' buttons from `at`; where it ended
func _list_row(items: Array, at: Vector2, k: float) -> float:
	var x := at.x
	for it: Array in items:
		var b := _tap_button(String(it[0]), it[3])
		b.add_theme_font_override("font", _font)
		b.add_theme_font_size_override("font_size", int(round(10 * k)))
		b.modulate = Color(1, 1, 1, 1.0 if it[2] else 0.45)
		b.set_meta("setting", true)   # (not a place: the menu tests skip these when counting rows)
		_route_ui.add_child(b)
		_put(b, Vector2(x, at.y), Vector2(float(it[1]), 22.0 * minf(k, 1.18)))
		x += float(it[1]) + 3.0
	return x

## "back" at the foot of a list: the start screen again (the shell's own, as "levels" does)
func _back_button(at := Vector2(270, 322)) -> void:
	var b := _tap_button("back", func(): Flow.pick_level())
	b.add_theme_font_override("font", _font)
	b.add_theme_font_size_override("font_size", 12)
	_route_ui.add_child(b)
	_put(b, at, Vector2(100, 26))

## a drive of the route set: down at its start address, "go to" its end, autodrive on
func _route_begin() -> void:
	var from := Vector2(float(_route["from_at"][0]), float(_route["from_at"][1]))
	var to := Vector2(float(_route["to_at"][0]), float(_route["to_at"][1]))
	# (the nearest street within 150 m, as "jump to" lands: an address the picker offers can be
	# up a lane or a path well off any public street, and at 60 m the car was left where it was)
	_land_on_road(from, 150.0, Vector2.ZERO)
	var on := _nearest_seg(_pos, 10.0, true, true, _y)
	if not on.is_empty() and _pocketed(on, _trap):
		# a pocket with no way out but against a one-way (its way out is off the map): from the
		# nearest street that has one
		var out := _nearest_seg_out(from, 400.0, _trap)
		if not out.is_empty():
			_land_on_road(out["q"], 5.0, Vector2.ZERO)
			_show_banner("no way out of there: from the nearest street that has one", 3.0)
	_set_dest(to, String(_route["to"]))
	_apply_ap_style()   # (the list's "normal" or "racer": _list_settings)
	_set_auto(true)
	_show_banner("route %d: %s → %s" % [int(_route["id"]), _route["from"], _route["to"]], 4.0)
	Probe.event("route", {"id": int(_route["id"])})

## Walks, test drives and the scenarios that play themselves are watched, not driven (the user,
## 22 Nov: "About walks and test drives lets not give the user control. Just simulation" -- and
## the tours as well). No wheel, no pedals, no buttons of the game's own; the shell's pause and
## exit, and a walk's speed. Not the getaway: that one is yours to drive.
func _watching() -> bool:
	if not _film.is_empty() or not _route.is_empty():
		return true
	return _scenario != null and String(_place.get("scenario", "")) != "getaway"

## a drawn button that _pick_tap() can press
func _tap_button(text: String, cb: Callable) -> Button:
	var b := UIKit.button(text, func(): pass)
	b.mouse_filter = Control.MOUSE_FILTER_IGNORE
	b.focus_mode = Control.FOCUS_NONE
	b.set_meta("cb", cb)
	return b

## a click or tap while the picker is open: whichever of its buttons is under it
func _pick_tap(at: Vector2) -> void:
	for b: Button in _picker.find_children("*", "Button", true, false):
		if b.is_queued_for_deletion() or b.disabled or not b.is_visible_in_tree():
			continue
		if b.get_global_rect().has_point(at):
			Audio.play("click", 0.05, -8.0)
			(b.get_meta("cb") as Callable).call()
			return

func _bar_button(text: String, at: Vector2, w: float, cb: Callable) -> Button:
	var b := _tap_button(text, cb)
	b.add_theme_font_override("font", _font)
	b.add_theme_font_size_override("font_size", 13)
	_picker.add_child(b)
	_put(b, at, Vector2(w, 26))
	return b

## size a button once it is in the tree: set before, Godot keeps the kit's 180x34 minimum
## on record and the "small" buttons came out 180 wide, overlapping their neighbours
func _put(b: Control, at: Vector2, sz: Vector2) -> void:
	b.custom_minimum_size = sz
	b.position = at
	b.size = sz

## every named street, as the roads and the addresses spell it
func _build_street_list() -> void:
	var en := {}
	for r: Dictionary in _roads:
		if r["drive"] and not r["pv"] and r["name"] != "" and not String(r["name"]).is_valid_int():
			en[r["name"]] = r["en"]
	for st: String in _addr:
		if not en.has(st) and not st.is_valid_int():
			en[st] = ""
	for nm: String in en:
		var e: String = en[nm]
		var count := (_addr.get(nm, []) as Array).size()
		var label: String = nm if e == "" or e == nm else "%s · %s" % [e, nm]
		# U+200E (left-to-right mark) after the Hebrew keeps the count at the end, not in it
		_streets_list.append({"name": nm, "en": e, "label": label + ("\u200e  (%d)" % count if count > 0 else "")})
	_streets_list.sort_custom(func(a, b): return _sort_key(a).naturalnocasecmp_to(_sort_key(b)) < 0)

func _sort_key(st: Dictionary) -> String:
	return String(st["en"]) if st["en"] != "" else String(st["name"])

## the initials a street can be found under: of its English name and of its own name
func _initials(st: Dictionary) -> Array:
	var out: Array = []
	for nm: String in [st["en"], st["name"]]:
		if nm != "":
			var c := nm.substr(0, 1).to_upper()
			if not out.has(c):
				out.append(c)
	return out

func _build_letters() -> void:
	for c in _pick_letters.get_children():
		c.queue_free()
	var latin: Array = []
	var other: Array = []
	for st: Dictionary in _streets_list:
		for c: String in _initials(st):
			var bucket: Array = latin if c.unicode_at(0) < 0x0250 else other
			if not bucket.has(c):
				bucket.append(c)
	latin.sort()
	other.sort()
	var rows: Array = [["all"] + latin, other] if not other.is_empty() else [["all"] + latin]
	for r in range(rows.size()):
		var row: Array = rows[r]
		var w := minf(24.0, 560.0 / maxf(1.0, row.size()))
		var total := 0.0
		for c: String in row:
			total += 42.0 if c == "all" else w
		var x := 320.0 - total * 0.5
		for i in range(row.size()):
			var c: String = row[i]
			var key := "" if c == "all" else c
			var b := _tap_button(c, func(): _pick_letter = key; _pick_page = 0; _pick_mode = "streets"; _refresh_pick())
			b.add_theme_font_override("font", _font)
			b.add_theme_font_size_override("font_size", 11)
			b.set_meta("key", key)
			_pick_letters.add_child(b)
			var cw := 42.0 if c == "all" else w
			_put(b, Vector2(x, r * 25), Vector2(cw - 2.0, 22))
			x += cw

func _turn(by: int) -> void:
	_pick_page += by
	_refresh_pick()

## lay out the current page: streets (two columns) or one street's numbers (six columns)
func _refresh_pick() -> void:
	for c in _pick_body.get_children():
		c.queue_free()
	for b in _pick_letters.get_children():
		(b as Control).modulate = Color(1, 1, 1, 1.0 if b.get_meta("key") == _pick_letter else 0.55)
	var items: Array = []   ## [text, callable]
	var cols := PICK_COLS
	if _pick_mode == "streets":
		for st: Dictionary in _streets_list:
			if _pick_letter == "" or _initials(st).has(_pick_letter):
				items.append([st["label"], _pick_numbers.bind(st["name"])])
	else:
		cols = NUM_COLS
		items.append(["← streets", func(): _pick_mode = "streets"; _pick_page = _pick_back_page; _refresh_pick()])
		items.append(["anywhere", _go.bind(_pick_street, -1)])
		var nums: Array = _addr.get(_pick_street, []).duplicate()
		nums.sort_custom(func(a, b): return String(a[0]).naturalnocasecmp_to(String(b[0])) < 0)
		for n: Array in nums:
			items.append([String(n[0]), _go_to.bind(_pick_street + " " + String(n[0]), n[1])])
	var per := cols * PICK_ROWS
	var pages := maxi(1, ceili(float(items.size()) / per))
	_pick_page = clampi(_pick_page, 0, pages - 1)
	var w := 600.0 / cols
	for i in range(_pick_page * per, mini(items.size(), (_pick_page + 1) * per)):
		var k := i - _pick_page * per
		var b := _tap_button(items[i][0], items[i][1])
		b.add_theme_font_override("font", _font)
		b.add_theme_font_size_override("font_size", 13)
		b.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
		b.clip_text = true
		_pick_body.add_child(b)
		_put(b, Vector2((k % cols) * w, (k / cols) * 33), Vector2(w - 8.0, 28))
	_pick_prev.disabled = _pick_page == 0
	_pick_next.disabled = _pick_page >= pages - 1
	var what := _pick_street if _pick_mode == "numbers" else ("streets" if _pick_letter == "" else "streets · " + _pick_letter)
	_pick_page_lbl.text = "%s\u200e   %d / %d" % [what, _pick_page + 1, pages]

var _pick_back_page := 0

func _pick_numbers(street: String) -> void:
	_pick_back_page = _pick_page
	_pick_street = street
	_pick_mode = "numbers"
	_pick_page = 0
	_refresh_pick()

## a street with no particular number: its nearest point to the car
func _go(street: String, _i: int) -> void:
	var best := INF
	var at := _pos
	for r: Dictionary in _roads:
		if r["name"] != street or not r["drive"]:
			continue
		var pts: PackedVector2Array = r["pts"]
		for j in range(pts.size() - 1):
			var q := Geometry2D.get_closest_point_to_segment(_pos, pts[j], pts[j + 1])
			if q.distance_to(_pos) < best:
				best = q.distance_to(_pos)
				at = q
	if best == INF and _addr.has(street):
		at = (_addr[street] as Array)[0][1]
	_go_to(street, at)

func _go_to(label: String, at: Vector2) -> void:
	_close_picker()
	if _making != "":
		_made_pick(label, at)
		return
	if _pick_jump:
		_jump_to(at, label)
	else:
		_apply_ap_style()   # (driven there in the style chosen: _auto_by_hand)
		_set_dest(at, label)

## "jump there": the car is put down on the street at `at`, in its lane, stopped, facing
## the way that has the address on the kerb side
func _jump_to(at: Vector2, label: String) -> void:
	_clear_dest()
	if _auto:
		_set_auto(false)
	if not _land_on_road(at, 120.0, Vector2.ZERO):
		_show_banner("no street to land on there", 2.0)
		return
	_pin_at = _pos
	_show_banner(label, 2.5)
	Probe.event("jump", {"to": label, "at": Vector2i(_pos)})

## ---- exploring: a point for every street of the city you drive down -----------------------

func _explore(dt: float) -> void:
	_on_m += absf(_v) * dt
	_scan_t -= dt
	if _scan_t > 0.0:
		return
	_scan_t = 0.15
	var hit := _nearest_seg(_pos, 14.0, true, false, _y)
	var nm := ""
	var en := ""
	if not hit.is_empty() and float(hit["edge"]) < 1.5:
		var r: Dictionary = _roads[hit["road"]]
		nm = r["name"]
		en = r["en"]
	if nm != _on_name:
		_on_name = nm
		_on_m = 0.0
		_street_lbl.text = nm
		_street_en_lbl.text = en if en != nm else ""
	if nm != "" and _on_m >= NEW_STREET_M and _streets.has(nm) and not _visited.has(nm):
		_visited[nm] = true
		add_score(1)
		Audio.play("coin", 0.05, -14.0)   # (a hint, not a jingle: it came every block or so)
		Probe.event("new_street", {"n": _visited.size()})
		_show_banner("+ " + nm, 1.6)
		_count_lbl.text = "streets %d / %d" % [_visited.size(), _streets.size()]
	_inside_t -= 0.15
	if _inside_t <= 0.0 and not _boundary.is_empty():
		_inside_t = 0.6
		var now := _in_city(_pos)
		if now != _inside:
			_inside = now
			_show_banner(("welcome to " if now else "leaving ") + _city_name, 2.2)
			Probe.event("city_limits", {"inside": now})

